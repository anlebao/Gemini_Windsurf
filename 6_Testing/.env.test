# VanAn Ecosystem Testing Configuration
# This file controls which test tiers are enabled

# Test Tier Controls
SMOKE_TEST_ENABLED=true
ENABLE_E2E=true
ENABLE_LOAD_TEST=false
ENABLE_CHAOS=false

# Environment
TEST_ENVIRONMENT=development

# Service URLs
COREHUB_URL=http://localhost:5010
GATEWAY_URL=http://localhost:5001
KHACHLINK_URL=http://localhost:5002
SHOPERP_URL=http://localhost:5003

# Omnichannel E2E Configuration
# Set to production URL for production testing, or localhost for local development
OMNICHANNEL_URL=http://localhost:5002
GATEWAY_PUBLIC_URL=http://localhost:5001

# E2E Test Configuration
E2E_TEST_PARALLEL=false

# Test Data
TEST_TENANT_ID=00000000-0000-0000-0000-000000000001

# Test Credentials (for dev login endpoint)
TEST_EMAIL=admin@vanan.vn
TEST_PASSWORD=dev123

# Omnichannel Test Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
KITCHEN_USERNAME=kitchen
KITCHEN_PASSWORD=kitchen123

# HTTP Basic Auth (if staging site is protected)
# STAGING_USERNAME=
# STAGING_PASSWORD=

# Timeouts (seconds)
SMOKE_TEST_TIMEOUT=300
E2E_TEST_TIMEOUT=600
LOAD_TEST_DURATION=120
CHAOS_TEST_DURATION=180
