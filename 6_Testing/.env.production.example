# VanAn Ecosystem Testing Configuration - Production Environment
# Copy this file to .env.test and update values for production testing

# Domain (single source of truth — all service URLs derive from this)
VANAN_DOMAIN=khachvip.online

# Test Tier Controls
SMOKE_TEST_ENABLED=true
ENABLE_E2E=true
ENABLE_LOAD_TEST=false
ENABLE_CHAOS=false

# Service URLs - Production (derived from VANAN_DOMAIN)
COREHUB_URL=https://api.${VANAN_DOMAIN}
GATEWAY_URL=https://api.${VANAN_DOMAIN}
KHACHLINK_URL=https://${VANAN_DOMAIN}
SHOPERP_URL=https://app.${VANAN_DOMAIN}

# Omnichannel E2E Configuration - Production
OMNICHANNEL_URL=https://${VANAN_DOMAIN}
GATEWAY_PUBLIC_URL=https://api.${VANAN_DOMAIN}

# E2E Test Configuration
E2E_TEST_PARALLEL=false

# Test Data
TEST_TENANT_ID=00000000-0000-0000-0000-000000000001

# Test Credentials (for production - use real credentials)
TEST_EMAIL=admin@${VANAN_DOMAIN}
TEST_PASSWORD=production_password_here

# Omnichannel Test Credentials (production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=production_password_here
KITCHEN_USERNAME=kitchen
KITCHEN_PASSWORD=production_password_here

# HTTP Basic Auth (if production site is protected)
STAGING_USERNAME=
STAGING_PASSWORD=

# Timeouts (seconds)
SMOKE_TEST_TIMEOUT=30
E2E_TEST_TIMEOUT=120
LOAD_TEST_DURATION=120
CHAOS_TEST_DURATION=180
