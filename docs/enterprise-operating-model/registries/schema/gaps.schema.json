{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gap & Improvement Registry",
  "idPrefix": "GAP",
  "required": [
    "id",
    "title",
    "gapClass",
    "status",
    "confidence",
    "evidence"
  ],
  "enums": {
    "gapClass": [
      "MISSING_PROCESS",
      "MISSING_FEATURE",
      "MANUAL_AUTOMATABLE",
      "MISSING_INTEGRATION",
      "DUPLICATE_FUNCTIONALITY",
      "INCONSISTENT_RULE",
      "MISSING_AUDIT_APPROVAL",
      "DATA_INCONSISTENCY",
      "SECURITY_PERMISSION",
      "AI_BOUNDARY",
      "UNKNOWN"
    ],
    "priority": [
      "LOW",
      "MEDIUM",
      "HIGH",
      "CRITICAL"
    ],
    "status": [
      "ACTIVE",
      "PROPOSED",
      "RETIRED",
      "APPROVED"
    ],
    "confidence": [
      "VERIFIED",
      "INFERRED",
      "ASSUMED"
    ]
  },
  "idPattern": "^GAP-\\d{3,}$",
  "references": {
    "activityRef": "ACTV"
  },
  "evidencePattern": "^(.+@([0-9a-fA-F]{7,40}|HEAD)|.+#L\\d+(-\\d+)?|none:.+)$"
}