{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "API & Integration Registry",
  "idPrefix": "API",
  "required": [
    "id",
    "name",
    "type",
    "status",
    "confidence",
    "evidence"
  ],
  "enums": {
    "type": [
      "REST",
      "EVENT",
      "INTERNAL",
      "EXTERNAL"
    ],
    "status": [
      "ACTIVE",
      "PROPOSED",
      "RETIRED",
      "APPROVED"
    ],
    "confidence": [
      "VERIFIED",
      "INFERRED",
      "ASSUMED"
    ]
  },
  "idPattern": "^API-\\d{3,}$",
  "references": {
    "providerRef": "SYS",
    "consumerRefs": "SYS"
  },
  "evidencePattern": "^(.+@([0-9a-fA-F]{7,40}|HEAD)|.+#L\\d+(-\\d+)?|none:.+)$"
}