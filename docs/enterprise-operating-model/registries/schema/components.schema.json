{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Software Component Registry",
  "idPrefix": "SYS",
  "required": [
    "id",
    "name",
    "purpose",
    "deploymentBoundary",
    "implStatus",
    "status",
    "confidence",
    "evidence"
  ],
  "enums": {
    "deploymentBoundary": [
      "IN_PROCESS",
      "HOSTED",
      "STANDALONE_VPS",
      "EXTERNAL"
    ],
    "implStatus": [
      "IMPLEMENTED",
      "PARTIAL",
      "PLANNED"
    ],
    "status": [
      "ACTIVE",
      "PROPOSED",
      "RETIRED",
      "APPROVED"
    ],
    "confidence": [
      "VERIFIED",
      "INFERRED",
      "ASSUMED"
    ]
  },
  "idPattern": "^SYS-\\d{3,}$",
  "references": {
    "capabilityRefs": "CAP",
    "apiRefs": "API",
    "dataRefs": "DATA",
    "workflowRefs": "PROC"
  },
  "evidencePattern": "^(.+@([0-9a-fA-F]{7,40}|HEAD)|.+#L\\d+(-\\d+)?|none:.+)$"
}