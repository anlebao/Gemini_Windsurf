{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Business Rule Registry",
  "idPrefix": "RULE",
  "required": [
    "id",
    "name",
    "description",
    "enforcement",
    "status",
    "confidence",
    "evidence"
  ],
  "enums": {
    "enforcement": [
      "MANUAL",
      "AUTOMATED",
      "HYBRID"
    ],
    "status": [
      "ACTIVE",
      "PROPOSED",
      "RETIRED",
      "APPROVED"
    ],
    "confidence": [
      "VERIFIED",
      "INFERRED",
      "ASSUMED"
    ]
  },
  "idPattern": "^RULE-\\d{3,}$",
  "references": {
    "activityRefs": "ACTV",
    "componentRef": "SYS"
  },
  "evidencePattern": "^(.+@([0-9a-fA-F]{7,40}|HEAD)|.+#L\\d+(-\\d+)?|none:.+)$"
}