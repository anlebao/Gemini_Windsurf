{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Organization Registry",
  "idPrefix": "ORG",
  "required": [
    "id",
    "name",
    "type",
    "status",
    "confidence",
    "evidence"
  ],
  "enums": {
    "type": [
      "LEGAL",
      "COOPERATIVE",
      "PLATFORM_OPERATOR",
      "TECH_PROVIDER",
      "EXTERNAL"
    ],
    "status": [
      "ACTIVE",
      "PROPOSED",
      "RETIRED",
      "APPROVED"
    ],
    "confidence": [
      "VERIFIED",
      "INFERRED",
      "ASSUMED"
    ]
  },
  "idPattern": "^ORG-\\d{3,}$",
  "references": {
    "parentOrgRef": "ORG"
  },
  "evidencePattern": "^(.+@([0-9a-fA-F]{7,40}|HEAD)|.+#L\\d+(-\\d+)?|none:.+)$"
}