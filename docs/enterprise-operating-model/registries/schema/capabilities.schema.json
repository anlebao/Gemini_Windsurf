{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Business Capability Registry",
  "idPrefix": "CAP",
  "required": [
    "id",
    "name",
    "status",
    "confidence",
    "evidence"
  ],
  "enums": {
    "status": [
      "ACTIVE",
      "PROPOSED",
      "RETIRED",
      "APPROVED"
    ],
    "confidence": [
      "VERIFIED",
      "INFERRED",
      "ASSUMED"
    ]
  },
  "idPattern": "^CAP-\\d{3,}$",
  "references": {
    "actorRefs": "ACTR",
    "componentRefs": "SYS",
    "processRefs": "PROC"
  },
  "evidencePattern": "^(.+@([0-9a-fA-F]{7,40}|HEAD)|.+#L\\d+(-\\d+)?|none:.+)$"
}