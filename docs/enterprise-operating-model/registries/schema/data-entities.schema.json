{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Data Entity Registry",
  "idPrefix": "DATA",
  "required": [
    "id",
    "name",
    "store",
    "systemOfRecord",
    "status",
    "confidence",
    "evidence"
  ],
  "enums": {
    "store": [
      "PG_GATEWAY",
      "SQLITE_TENANT",
      "PG_METERING",
      "PG_TENANTAI",
      "OTHER"
    ],
    "status": [
      "ACTIVE",
      "PROPOSED",
      "RETIRED",
      "APPROVED"
    ],
    "confidence": [
      "VERIFIED",
      "INFERRED",
      "ASSUMED"
    ]
  },
  "idPattern": "^DATA-\\d{3,}$",
  "references": {
    "ownerRef": "ORG"
  },
  "evidencePattern": "^(.+@([0-9a-fA-F]{7,40}|HEAD)|.+#L\\d+(-\\d+)?|none:.+)$"
}