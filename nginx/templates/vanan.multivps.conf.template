# ============================================================
# Multi-VPS nginx config — ${VANAN_DOMAIN}
# Generated from template by docker-entrypoint.sh (envsubst)
# ShopERP runs on REMOTE VPS (${SHOPERP_REMOTE_HOST}) — proxied via VPC internal IP.
# KhachLink runs on REMOTE VPS (${KHACHLINK_REMOTE_HOST}) — proxied via VPC internal IP.
# Gateway runs locally on this (gateway) VPS.
# ============================================================

# ============================================================
# Default HTTP server — VPC internal traffic (API proxy)
# ShopERP/KhachLink call Gateway via VPC IP:80 → proxy directly to
# gateway container (bypass HTTPS redirect for internal API traffic).
# Without this, internal HttpClient calls get 301→HTTPS→wrong server block→404.
# Fixes #109, #110, #111 (shop-instances/tenants/commerce-mode 404).
# ============================================================
server {
    listen 80 default_server;
    server_name _;

    # Let's Encrypt ACME challenge (must work before SSL cert exists)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # API requests → proxy directly to Gateway container (no HTTPS redirect)
    location /api/ {
        proxy_pass         http://gateway:80;
        proxy_http_version 1.1;
        proxy_set_header   Host api2.${VANAN_DOMAIN};
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # SignalR hubs → proxy to Gateway with WebSocket upgrade
    location ~ ^/(orderHub|kitchenhub|hubs/) {
        proxy_pass         http://gateway:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host api2.${VANAN_DOMAIN};
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 3600s;
    }

    # Health check endpoint → proxy to Gateway
    location = /health {
        proxy_pass         http://gateway:80/health;
        proxy_set_header   Host api2.${VANAN_DOMAIN};
    }

    # Everything else → HTTPS redirect (preserves browser traffic behavior)
    location / {
        return 301 https://$host$request_uri;
    }
}

# ============================================================
# ${VANAN_DOMAIN} / www2.${VANAN_DOMAIN} — ShopERP (Blazor) on REMOTE VPS
# ============================================================
server {
    listen 80;
    server_name ${VANAN_DOMAIN} www2.${VANAN_DOMAIN};

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${VANAN_DOMAIN} www2.${VANAN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/www2.${VANAN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www2.${VANAN_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # ── Blazor Server protection strategy (5 layers) ──────────────────────
    #
    # Root cause of 503 on fast navigation (fix iter 4, 2026-08-09):
    #   Previously /api/ calls from Blazor pages shared rate limit quota with
    #   page loads (location /). Fast navigation = page + 3-5 API calls → burst
    #   exhausted → 503. Fix: separate /api/ and /Login into own locations with
    #   independent quotas.
    #
    # 1. Static assets (JS, CSS, images) — exempt from rate limit (no .NET cost).
    # 2. API calls (/api/*) — zone=api, high burst (authenticated, cheap).
    # 3. Login form (/Login) — zone=auth, strict (brute-force protection).
    # 4. WebSocket /_blazor — limit_conn only (no limit_req).
    # 5. Page loads (/) — zone=web, safety-net rate limit + limit_conn.

    # Layer 1: Static assets — no rate limit (fast initial load)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|map)$ {
        proxy_pass         http://${SHOPERP_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Layer 2: API calls — separate quota from page loads
    # API endpoints are JWT-authenticated (ShopERP controllers check claims).
    # High burst=200: Blazor page load can fire 5-10 API calls in parallel.
    # limit_conn 20: API calls can be concurrent (unlike page loads).
    location /api/ {
        limit_req zone=api burst=200 nodelay;
        limit_conn perip_conn 20;
        proxy_pass         http://${SHOPERP_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Layer 3: Login form — strict rate limit (brute-force protection)
    # 5r/m + burst=5: max 5 login attempts per minute per IP.
    location = /Login {
        limit_req zone=auth burst=5 nodelay;
        limit_conn perip_conn 3;
        proxy_pass         http://${SHOPERP_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Layer 4: Blazor SignalR WebSocket — limit_conn only (not limit_req)
    location /_blazor {
        limit_conn perip_conn 10;
        proxy_pass         http://${SHOPERP_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Layer 5: Page loads — safety-net rate limit + connection limit
    # burst=200: allows 10+ navigations in burst. 429 status set in nginx.conf.
    location / {
        limit_req zone=web burst=200 nodelay;
        limit_conn perip_conn 10;
        proxy_pass         http://${SHOPERP_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# ============================================================
# diemthuong2.${VANAN_DOMAIN} — KhachLink (customer PWA) — REMOTE VPS
# ============================================================
server {
    listen 80;
    server_name diemthuong2.${VANAN_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name diemthuong2.${VANAN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/www2.${VANAN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www2.${VANAN_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Blazor WASM immutable assets — exempt from rate limit (no server RAM cost)
    location /_framework/ {
        proxy_pass         http://${KHACHLINK_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Static assets — exempt from rate limit
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|map)$ {
        proxy_pass         http://${KHACHLINK_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Blazor SignalR WebSocket — limit_conn only (not limit_req)
    location /_blazor {
        limit_conn perip_conn 10;
        proxy_pass         http://${KHACHLINK_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # API calls — separate quota from page loads (same fix as www2)
    location /api/ {
        limit_req zone=api burst=200 nodelay;
        limit_conn perip_conn 20;
        proxy_pass         http://${KHACHLINK_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Dynamic pages — rate limit + connection limit
    # burst=200: Blazor WASM initial load can spike 40-60 requests.
    location / {
        limit_req zone=web burst=200 nodelay;
        limit_conn perip_conn 10;
        proxy_pass         http://${KHACHLINK_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

