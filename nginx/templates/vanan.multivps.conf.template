}

# ============================================================
# KhachLink Multi-Profile R1 — wildcard domain support
# All *.${VANAN_DOMAIN} (except api2/app2/www2/diemthuong2 which have
# explicit server blocks above) → KhachLink container.
# KhachLink runtime resolves instance config by Host header via Gateway API.
# nginx matches most specific server_name first, so explicit blocks above
# always take precedence over this wildcard.
# ============================================================
server {
    listen 80;
    # Match any subdomain EXCEPT the 4 explicit ones (negative lookahead)
    server_name ~^(?!api2\.|app2\.|www2\.|diemthuong2\.).+\.${VANAN_DOMAIN}$;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ~^(?!api2\.|app2\.|www2\.|diemthuong2\.).+\.${VANAN_DOMAIN}$;

    # Reuse the same wildcard cert (SAN includes all subdomains via --expand)
    ssl_certificate     /etc/letsencrypt/live/www2.${VANAN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www2.${VANAN_DOMAIN}/privkey.pem;
