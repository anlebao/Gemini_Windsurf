# ============================================================
# Multi-VPS nginx config (HTTP-only) — ${VANAN_DOMAIN}
# Used when SSL cert not yet provisioned (first deploy).
# All traffic on port 80 — no HTTPS redirect.
# ============================================================

# ${VANAN_DOMAIN} / www2.${VANAN_DOMAIN} — ShopERP (Blazor) on REMOTE VPS
server {
    listen 80;
    server_name ${VANAN_DOMAIN} www2.${VANAN_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass         http://${SHOPERP_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /_blazor {
        proxy_pass         http://${SHOPERP_REMOTE_HOST}:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# diemthuong2.${VANAN_DOMAIN} — KhachLink (customer PWA) — REMOTE VPS
