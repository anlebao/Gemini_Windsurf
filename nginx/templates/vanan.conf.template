# ============================================================
# ${VANAN_DOMAIN} — Sitemap / ShopERP (Blazor)
# Generated from template by docker-entrypoint.sh (envsubst)
# ============================================================
server {
    listen 80;
    server_name ${VANAN_DOMAIN} www.${VANAN_DOMAIN};

    # Let's Encrypt ACME challenge (must work before SSL exists)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${VANAN_DOMAIN} www.${VANAN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${VANAN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${VANAN_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    limit_req zone=web burst=20 nodelay;

    location / {
        proxy_pass         http://vanan-shoperp:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Blazor SignalR
    location /_blazor {
        proxy_pass         http://vanan-shoperp:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# ============================================================
# diemthuong.${VANAN_DOMAIN} — KhachLink (customer PWA)
# ============================================================
server {
    listen 80;
    server_name diemthuong.${VANAN_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name diemthuong.${VANAN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${VANAN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${VANAN_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Blazor WASM immutable assets (hashed filenames) — exempt from rate limit.
    # SW install event fetches ~80 _framework/* concurrently; rate limiter would 503 them.
    # proxy_buffering off + longer timeout: large DLL/wasm on slow mobile must not be
    # cut off by the default 60s read timeout or temp-file buffering limits.
    location /_framework/ {
        proxy_pass         http://vanan-khachlink:80;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        limit_req zone=web burst=20 nodelay;
        proxy_pass         http://vanan-khachlink:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Blazor Server circuit (SignalR WebSocket)
    location /_blazor {
        limit_req zone=web burst=20 nodelay;
        proxy_pass         http://vanan-khachlink:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

