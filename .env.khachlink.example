# Multi-VPS Deployment — KhachLink VPS Environment Variables
# Copy to .env.khachlink and fill in real values.
# MUST match Gateway .env.gateway for: JWT_SECRET_KEY, VANAN_DOMAIN, GOOGLE_CLIENT_ID/SECRET, VAPID_PRIVATE_KEY

# === Domain ===
VANAN_DOMAIN=khachvip.online

# === VPC Routing (internal IPs) ===
# Gateway VPS internal IP (for KhachLink → Gateway API calls + Seq sink from Gateway)
GATEWAY_REMOTE_HOST=10.148.0.2

# === Seq (logging) ===
SEQ_ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# === Google OAuth (MUST match Gateway) ===
GOOGLE_CLIENT_ID=CHANGE_THIS
GOOGLE_CLIENT_SECRET=CHANGE_THIS

# === VAPID (Web Push, MUST match Gateway) ===
VAPID_PRIVATE_KEY=CHANGE_THIS

# === Image registry ===
IMAGE_PREFIX=ghcr.io/anlebao
IMAGE_TAG=latest
