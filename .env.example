# Environment Variables Configuration Example
# Copy this file to .env and fill in the actual values
# IMPORTANT: .env file is in .gitignore and should NEVER be committed to source control

# ========================================
# KhachLink Push Notification Configuration (Wave 9)
# ========================================
# VAPID keys for Web Push notifications
# Generate keys using: npm install -g web-push && web-push generate-vapid-keys
# See: docs/AI/VAPID_KEY_GENERATION_GUIDE.md for detailed instructions

# Public key (can be in source code - not sensitive)
VAPID_PUBLIC_KEY=BJIeg2XokT35UrNdXV26uTiMa0CxwbRI5Fmb9j4djeSdXO74U1wS6BD15MlnvYppLtDx2Rbm01TSkcVcf7p58RE

# Private key (ENVIRONMENT VARIABLE ONLY - NEVER in source code)
# Replace with your actual private key from VAPID generation
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE

# VAPID subject (contact email for push notifications)
VAPID_SUBJECT=mailto:admin@vanan.com

