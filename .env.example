# Environment Variables Configuration Example
# Copy this file to .env and fill in the actual values
# IMPORTANT: .env file is in .gitignore and should NEVER be committed to source control

# ========================================
# Database Configuration (REQUIRED)
# ========================================
# These variables are required by validate-env-vars.ps1
# For production: Use strong passwords and rotate regularly
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_PASSWORD
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_256BIT_KEY
SEQ_ADMIN_PASSWORD=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_PASSWORD

# ========================================
# Accounting PostgreSQL Connection (Optional Override)
# ========================================
# WAVE 2 (2026-07-10): ADR-001 — accounting always online on PostgreSQL
# By default, docker-compose sets ConnectionStrings__AccountingConnection from POSTGRES_* vars.
# Set this to override the accounting connection string entirely (e.g., separate DB or remote server).
# ACCOUNTING_CONNECTION_STRING=Host=postgres;Port=5432;Database=vanan_accounting;Username=vanan_admin;Password=...

# ========================================
# KhachLink Push Notification Configuration (Wave 9)
# ========================================
# VAPID keys for Web Push notifications
# Generate keys using: npm install -g web-push && web-push generate-vapid-keys
# See: docs/AI/VAPID_KEY_GENERATION_GUIDE.md for detailed instructions

# Public key (can be in source code - not sensitive)
VAPID_PUBLIC_KEY=BJIeg2XokT35UrNdXV26uTiMa0CxwbRI5Fmb9j4djeSdXO74U1wS6BD15MlnvYppLtDx2Rbm01TSkcVcf7p58RE

# Private key (ENVIRONMENT VARIABLE ONLY - NEVER in source code)
# Replace with your actual private key from VAPID generation
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE

# VAPID subject (contact email for push notifications)
VAPID_SUBJECT=mailto:admin@vanan.com

# ========================================
# Local Docker Compose Settings (Optional)
# ========================================
# Override default ports if needed (defaults shown)
# Convention: 5001=gateway, 5002=khachlink, 5003=shoperp
# GATEWAY_PORT=5001
# SHOPERP_PORT=5003
# KHACHLINK_PORT=5002

# pgAdmin credentials (local dev only)
PGADMIN_DEFAULT_EMAIL=admin@vanan.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_PASSWORD

# ========================================
# ShopERP Seed Data (Optional)
# ========================================
SHOPERP_OWNER_USERNAME=adminvanan1
SHOPERP_OWNER_PASSWORD=2026@vanan
SHOPERP_TENANT_ID=00000000-0000-0000-0000-000000000001