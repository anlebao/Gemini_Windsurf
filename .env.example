# VanAn Ecosystem - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ========================================
# PostgreSQL
# ========================================
POSTGRES_DB=VanAnCoreHub
POSTGRES_USER=vanan_admin
POSTGRES_PASSWORD=change_me_strong_password

# ========================================
# pgAdmin
# ========================================
PGADMIN_DEFAULT_EMAIL=admin@vanan.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# ========================================
# Seq (Structured Logging)
# ========================================
SEQ_ADMIN_PASSWORD=change_me_seq_password

# ========================================
# JWT Authentication
# ========================================
JWT_SECRET_KEY=change_me_min_32_chars_secret_key_here

# ========================================
# App Ports (optional overrides)
# ========================================
GATEWAY_PORT=5000
COREHUB_PORT=5001
SHOPERP_PORT=5002
KHACHLINK_PORT=5003
