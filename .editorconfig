root = true

[*]
dotnet_analyzer_diagnostic.severity = warning
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1848.severity = none

[*.cs]
# FORCE LOW RISK SUPPRESSION
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1069.severity = none
dotnet_diagnostic.CA1008.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1848.severity = none

# MINOR WARNING SUPPRESSION (DTO/interface design patterns - not actionable)
dotnet_diagnostic.CA1002.severity = none    # List<T> vs Collection<T> - DTOs use List<T> by convention
dotnet_diagnostic.CA2227.severity = none    # Collection setter read-only - DTO pattern requires setters
dotnet_diagnostic.CA1062.severity = none    # Validate null param - analyzer pattern, guarded by Roslyn
dotnet_diagnostic.CA1711.severity = none    # Type name ending in 'Queue' - domain naming convention
dotnet_diagnostic.CA1720.severity = none    # Identifier contains type name - domain naming convention
dotnet_diagnostic.CA1016.severity = none    # Mark assembly with version - analyzer project
dotnet_diagnostic.CA1822.severity = none    # Member can be static - analyzer pattern
dotnet_diagnostic.CA1869.severity = none    # Cache JsonSerializerOptions - fixed in code, suppress remaining
dotnet_diagnostic.CS0628.severity = none    # Sealed protected constructor - EF Core proxy pattern
dotnet_diagnostic.CS1998.severity = none    # Async method lacks await - interface contract
dotnet_diagnostic.CS8632.severity = none    # Nullable annotation context - analyzer project netstandard2.0
dotnet_diagnostic.RS2003.severity = none    # Analyzer release tracking - internal tooling

# MEDIUM RISK
dotnet_diagnostic.CA2007.severity = suggestion

# Disable collection expression rewrite - causes CS0173 on Linux CI (netstandard2.0)
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0028.severity = none
dotnet_diagnostic.IDE0305.severity = none
csharp_style_prefer_collection_expression = false:none