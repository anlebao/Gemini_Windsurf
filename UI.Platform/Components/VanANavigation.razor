@* VanANavigation Component - Phase 2.5.3: UI Platform Navigation *@
@* 2026-09-19: P2 — NavLink (SPA navigation, no full page reload) + P3 — stable group state (auto-expand active group, user toggles persist across navigation) *@
@using Microsoft.AspNetCore.Components.Routing
@using VanAn.UI.Platform.Models
@inherits VanAn.UI.Platform.Components.Base.VanAnComponentBase

<nav class="vanan-navigation @GetNavClass()" @attributes="AdditionalAttributes">
    <ul class="vanan-navigation__list">
        @if (MenuItems != null)
        {
            @foreach (var item in MenuItems)
            {
                @if (item.Children.Any())
                {
                    <li class="vanan-navigation__item vanan-navigation__item--group">
                        <details class="vanan-navigation__details" open="@IsGroupOpen(item)">
                            <summary class="vanan-navigation__summary" @onclick="() => ToggleGroup(item)" @onclick:preventDefault="true">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    <i class="bi bi-@item.Icon vanan-navigation__icon" aria-hidden="true"></i>
                                }
                                <span class="vanan-navigation__text">@item.Title</span>
                                <i class="bi bi-chevron-down vanan-navigation__chevron" aria-hidden="true"></i>
                            </summary>
                            <ul class="vanan-navigation__submenu">
                                @foreach (var child in item.Children)
                                {
                                    <li class="vanan-navigation__subitem">
                                        <NavLink href="@child.Url" class="vanan-navigation__sublink" Match="NavLinkMatch.Prefix">
                                            @if (!string.IsNullOrEmpty(child.Icon))
                                            {
                                                <i class="bi bi-@child.Icon vanan-navigation__subicon" aria-hidden="true"></i>
                                            }
                                            @child.Title
                                        </NavLink>
                                    </li>
                                }
                            </ul>
                        </details>
                    </li>
                }
                else
                {
                    <li class="vanan-navigation__item @(item.IsActive ? "vanan-navigation__item--active" : "")">
                        <NavLink href="@item.Url" class="vanan-navigation__link" Match="NavLinkMatch.All">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <i class="bi bi-@item.Icon vanan-navigation__icon" aria-hidden="true"></i>
                            }
                            <span class="vanan-navigation__text">@item.Title</span>
                        </NavLink>
                    </li>
                }
            }
        }
    </ul>
</nav>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    [Parameter]
    public List<NavigationItem>? MenuItems { get; set; }

    [Parameter]
    public string Orientation { get; set; } = "vertical"; // vertical, horizontal

    [Parameter]
    public bool Collapsed { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// User-chosen open/closed state per group title. Survives SPA navigation because the
    /// layout component instance persists while the circuit lives (no full page reload).
    /// On a full reload the state resets and groups re-open based on the current URL.
    /// </summary>
    private readonly Dictionary<string, bool> _explicitGroupState = new(StringComparer.OrdinalIgnoreCase);

    private string _currentPath = "/";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var queryIndex = path.IndexOf('?');
        if (queryIndex >= 0)
        {
            path = path[..queryIndex];
        }
        _currentPath = "/" + path.TrimStart('/');
    }

    private string GetNavClass()
    {
        var classes = new List<string>();

        classes.Add(Orientation.ToLower() switch
        {
            "horizontal" => "vanan-navigation--horizontal",
            _ => "vanan-navigation--vertical"
        });

        if (Collapsed) classes.Add("vanan-navigation--collapsed");

        return string.Join(" ", classes);
    }

    /// <summary>
    /// A group is open when it contains the current URL (unless the user explicitly collapsed it),
    /// or when the user explicitly opened it. Default: only the group(s) containing the active page are open.
    /// </summary>
    private bool IsGroupOpen(NavigationItem group)
    {
        if (_explicitGroupState.TryGetValue(group.Title, out var open))
        {
            return open;
        }
        return GroupContainsUrl(group, _currentPath);
    }

    private void ToggleGroup(NavigationItem group)
    {
        _explicitGroupState[group.Title] = !IsGroupOpen(group);
    }

    private static bool GroupContainsUrl(NavigationItem group, string currentPath)
    {
        return group.Children.Any(child => UrlMatches(child.Url, currentPath));
    }

    /// <summary>
    /// Segment-based prefix match so /accounting/hkd-books/ABC matches /accounting/hkd-books
    /// while /admin/customers-global never matches /admin/customers.
    /// </summary>
    private static bool UrlMatches(string linkUrl, string currentPath)
    {
        if (string.IsNullOrEmpty(linkUrl))
        {
            return false;
        }
        var linkSegments = linkUrl.TrimStart('/').TrimEnd('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        var currentSegments = currentPath.TrimStart('/').TrimEnd('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (linkSegments.Length == 0 || currentSegments.Length < linkSegments.Length)
        {
            return false;
        }
        for (var i = 0; i < linkSegments.Length; i++)
        {
            if (!string.Equals(linkSegments[i], currentSegments[i], StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }
        return true;
    }
}
