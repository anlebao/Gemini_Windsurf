@* VanAForm Component - Wave 5: lightweight form wrapper for UI Platform *@
@inherits VanAn.UI.Platform.Components.Base.VanAnComponentBase
@using Microsoft.AspNetCore.Components.Web

<form class="vanan-form @AdditionalClasses" 
      @onsubmit="HandleSubmit" 
      @attributes="AdditionalAttributes">
    @ChildContent
</form>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public string AdditionalClasses { get; set; } = string.Empty;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleSubmit()
    {
        if (OnValidSubmit.HasDelegate)
        {
            await OnValidSubmit.InvokeAsync();
        }
    }
}
