@* R2-0b: PaymentMethodSelector â€” shared radio group for cash/transfer payment method.
   Replaces inline radio buttons in KhachLink/Checkout.razor and ShopERP POS Payment.
   Two-way bindable via @bind-Value. *@
@inherits VanAn.UI.Platform.Components.Base.VanAnComponentBase
@using Microsoft.AspNetCore.Components.Web

<div class="vanan-payment-selector" @attributes="AdditionalAttributes">
    <label class="vanan-payment-selector__label">@Label</label>
    <div class="vanan-payment-selector__options">
        @foreach (var option in Options)
        {
            <div class="vanan-payment-selector__option">
                <input type="radio"
                       name="@GroupName"
                       value="@option.Value"
                       class="vanan-payment-selector__input"
                       checked="@(Value == option.Value)"
                       @onchange="@(() => ValueChanged.InvokeAsync(option.Value))"
                       data-testid="@($"payment-option-{option.Value}")" />
                <label class="vanan-payment-selector__option-label">@option.Label</label>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Currently selected payment method value (e.g. "cash", "transfer").
    /// </summary>
    [Parameter]
    public string Value { get; set; } = "cash";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Label for the selector group.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "HÃ¬nh thá»©c thanh toÃ¡n";

    /// <summary>
    /// Radio group name (must be unique per form to avoid conflicts).
    /// </summary>
    [Parameter]
    public string GroupName { get; set; } = "paymentMethod";

    /// <summary>
    /// Available payment options. Defaults to cash + transfer (VietQR).
    /// </summary>
    [Parameter]
    public List<PaymentOption> Options { get; set; } = new()
    {
        new() { Value = "cash", Label = "ðŸ’µ Tiá»n máº·t" },
        new() { Value = "transfer", Label = "ðŸ¦ Chuyá»ƒn khoáº£n (VietQR)" }
    };

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public sealed class PaymentOption
    {
        public string Value { get; init; } = string.Empty;
        public string Label { get; init; } = string.Empty;
    }
}
