@* Task AI-P4 / SRS v1.1 §6.1 — storefront AI chat widget (floating bubble + panel).
   HTTP REST via IAiChatClient (no SignalR — AI answers are request/response).
   Renders NOTHING unless GET widget-config returns aiEnabled=true (feature flag
   off / service down → hidden; NFR-3: AI down ≠ storefront down).
   Product cards "Thêm vào giỏ" → OnAddToCart callback (host wires its own cart —
   AI never creates orders; Option C snapshot: name + price from the card). *@
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Tokens
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject IAiChatClient AiClient

@if (ShowWidget)
{
    <div class="vanan-ai-widget">
        @if (_open)
        {
            <VanAnCard Shadow="true" CssClass="vanan-ai-panel p-0 overflow-hidden">
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom vanan-ai-header">
                    <div class="d-flex align-items-center gap-2">
                        @if (_mode == WidgetMode.Human)
                        {
                            <i class="bi bi-person-fill"></i>
                            <h6 class="mb-0">Chủ quán</h6>
                        }
                        else
                        {
                            <i class="bi bi-robot"></i>
                            <h6 class="mb-0">@(_aiName)</h6>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (_mode == WidgetMode.Ai && HumanHandoffAvailable)
                        {
                            <VanAnButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                         OnClick="SwitchToHuman" CssClass="vanan-ai-human-btn"
                                         aria-label="Chat với chủ quán">
                                <i class="bi bi-chat-dots"></i> Chat với chủ quán
                            </VanAnButton>
                        }
                        else if (_mode == WidgetMode.Human && _config?.AiEnabled == true)
                        {
                            <VanAnButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                         OnClick="SwitchToAi" CssClass="vanan-ai-back-btn"
                                         aria-label="Quay lại trợ lý AI">
                                <i class="bi bi-arrow-left"></i> Trợ lý AI
                            </VanAnButton>
                        }
                        <VanAnButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                     OnClick="ToggleOpen" aria-label="Đóng trợ lý AI">
                            <i class="bi bi-chevron-down"></i>
                        </VanAnButton>
                    </div>
                </div>

                @if (_mode == WidgetMode.Human)
                {
                    @* Task AI-P8: human handoff — host-provided panel (lazy mount: SignalR
                       connects only when the customer switches to human mode). *@
                    <div class="ai-widget-human">
                        @HumanContent
                    </div>
                }
                else
                {
                <div id="@ScrollContainerId" class="vanan-ai-messages">
                    @if (_loadingHistory)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(_config?.Greeting) && _messages.Count == 0)
                        {
                            <div class="vanan-ai-msg vanan-ai-msg-assistant">
                                <div class="vanan-ai-bubble">@_config.Greeting</div>
                            </div>
                        }
                        string? lastUserText = null;
                        @foreach (var msg in _messages)
                        {
                            var isUser = msg.Role == "user";
                            if (isUser) lastUserText = msg.Content;
                            var turnDraft = lastUserText;
                            <div class="vanan-ai-msg @(isUser ? "vanan-ai-msg-user" : "vanan-ai-msg-assistant")">
                                <div class="vanan-ai-bubble">@msg.Content</div>
                                @if (!isUser && msg.Refused && HumanHandoffAvailable)
                                {
                                    <button type="button" class="vanan-ai-chip vanan-ai-escalate"
                                            @onclick="() => EscalateAsync(turnDraft)">
                                        <i class="bi bi-person"></i> Hỏi chủ quán trực tiếp
                                    </button>
                                }
                                @if (!isUser && msg.Products.Count > 0)
                                {
                                    <div class="vanan-ai-products">
                                        @foreach (var p in msg.Products)
                                        {
                                            <div class="vanan-ai-product-card">
                                                @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                                                {
                                                    <img src="@p.ImageUrl" alt="@p.Name" class="vanan-ai-product-img" />
                                                }
                                                <div class="vanan-ai-product-info">
                                                    <div class="vanan-ai-product-name">@p.Name</div>
                                                    <div class="vanan-ai-product-price">@p.Price.ToString("N0", CultureVi)₫</div>
                                                </div>
                                                <VanAnButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small"
                                                             OnClick="() => AddToCartAsync(msg, p)"
                                                             aria-label="@($"Thêm {p.Name} vào giỏ")">
                                                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                                </VanAnButton>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (_sending)
                        {
                            <div class="vanan-ai-msg vanan-ai-msg-assistant">
                                <div class="vanan-ai-bubble vanan-ai-typing">
                                    <span class="vanan-ai-dot"></span><span class="vanan-ai-dot"></span><span class="vanan-ai-dot"></span>
                                </div>
                            </div>
                        }
                        @if (_config?.Suggestions?.Count > 0 && _messages.Count == 0 && !_sending)
                        {
                            <div class="vanan-ai-suggestions">
                                @foreach (var s in _config.Suggestions)
                                {
                                    <button type="button" class="vanan-ai-chip" @onclick="() => SuggestAsync(s)">@s</button>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="p-2 border-top">
                    @if (_addedNotice is not null)
                    {
                        <div class="small text-success mb-1"><i class="bi bi-check-circle"></i> @_addedNotice</div>
                    }
                    <div class="d-flex gap-2 align-items-center">
                        <VanAInput AdditionalClasses="vanan-ai-input" Placeholder="Hỏi trợ lý về quán..."
                                   @bind-Value="_input" OnKeyPress="OnKeyPress" maxlength="2000" Disabled="_sending" />
                        <VanAnButton Variant="ButtonVariant.Primary" OnClick="SendAsync" Disabled="_sending"
                                     CssClass="vanan-ai-send" aria-label="Gửi tin nhắn">
                            <i class="bi bi-send"></i>
                        </VanAnButton>
                    </div>
                </div>
                }
            </VanAnCard>
        }
        else
        {
            <button type="button" class="vanan-ai-bubble-btn" @onclick="ToggleOpen" aria-label="Mở trợ lý AI">
                <i class="bi bi-robot"></i>
            </button>
        }
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo CultureVi = new("vi-VN");

    /// <summary>Tenant whose storefront the widget is mounted on (server re-validates — T6).</summary>
    [Parameter] public Guid TenantId { get; set; }
    /// <summary>Optional BCP-47 locale forwarded to the AI service.</summary>
    [Parameter] public string? Locale { get; set; }
    /// <summary>Product card "Thêm vào giỏ" — host maps the snapshot to its own cart service.</summary>
    [Parameter] public EventCallback<AiProductCardItem> OnAddToCart { get; set; }
    [Parameter] public string ScrollContainerId { get; set; } = "vanan-ai-scroll";
    /// <summary>localStorage key for the anonymous chat session (vanan_ai_session per task card).</summary>
    [Parameter] public string SessionStorageKey { get; set; } = "vanan_ai_session";

    /// <summary>Task AI-P8: host-provided human chat surface (mounted lazily in Human mode).</summary>
    [Parameter] public RenderFragment? HumanContent { get; set; }
    /// <summary>Task AI-P8: false → pure AI bubble (backward compatible with existing mounts).</summary>
    [Parameter] public bool HumanChatAvailable { get; set; }
    /// <summary>Task AI-P8: fired on refuse-escalation; payload = the refused user question (≤500 chars).</summary>
    [Parameter] public EventCallback<string?> OnDraftRequest { get; set; }

    private enum WidgetMode { Ai, Human }
    private const int MaxDraftChars = 500;

    private AiWidgetConfig? _config;
    private string _aiName = "Trợ lý AI";
    private string? _sessionId;
    private string _input = string.Empty;
    private string? _addedNotice;
    private bool _open;
    private bool _sending;
    private bool _loadingHistory;
    private bool _historyLoaded;
    private bool _configResolved;
    private WidgetMode _mode = WidgetMode.Ai;

    /// <summary>Human handoff needs both the host opt-in and a mounted fragment.</summary>
    private bool HumanHandoffAvailable => HumanChatAvailable && HumanContent is not null;

    /// <summary>
    /// Task AI-P8: visible when AI is enabled OR when only the human channel remains
    /// (aiEnabled=false / service down + handoff available → bubble opens straight to Human).
    /// Before config resolves the widget renders nothing (same as P4 behavior).
    /// </summary>
    private bool ShowWidget =>
        _configResolved && (_config?.AiEnabled == true || HumanHandoffAvailable);
    private readonly List<AiSessionMessage> _messages = new();
    /// <summary>Client-side dedupe — retried messageIds never append twice (server dedupes too [G8]).</summary>
    private readonly HashSet<string> _seenMessageIds = new();

    protected override async Task OnInitializedAsync()
    {
        _config = await AiClient.GetWidgetConfigAsync(TenantId);
        if (_config?.AiEnabled == true && !string.IsNullOrWhiteSpace(_config.AiName))
            _aiName = _config.AiName;
        // Task AI-P8: aiEnabled=false + human handoff → the bubble lands in Human mode.
        if (_config?.AiEnabled != true && HumanHandoffAvailable)
            _mode = WidgetMode.Human;
        _configResolved = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // firstRender may fire BEFORE OnInitializedAsync completes (WASM renders the
        // initial frame while the config fetch is still in-flight) — create the
        // session on the first render where aiEnabled is known, not just firstRender.
        if (_sessionId is null && _config?.AiEnabled == true)
            _sessionId = await GetOrCreateSessionIdAsync();
    }

    private async Task ToggleOpen()
    {
        _open = !_open;
        if (_open && !_historyLoaded && _sessionId is not null)
        {
            _loadingHistory = true;
            var history = await AiClient.GetSessionMessagesAsync(TenantId, _sessionId);
            _loadingHistory = false;
            if (history is not null)
            {
                _messages.AddRange(history);
                foreach (var m in history) _seenMessageIds.Add(m.CreatedAtUtc.ToString("o"));
            }
            _historyLoaded = true;
        }
    }

    /// <summary>localStorage-backed anonymous session (same pattern as customer_device_id).</summary>
    private async Task<string> GetOrCreateSessionIdAsync()
    {
        try
        {
            var existing = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", SessionStorageKey);
            if (!string.IsNullOrWhiteSpace(existing)) return existing;
            var created = Guid.NewGuid().ToString("N");
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", SessionStorageKey, created);
            return created;
        }
        catch (InvalidOperationException)
        {
            // JS not available yet (prerender) — fall back to a volatile session id.
            return _sessionId ?? Guid.NewGuid().ToString("N");
        }
    }

    private async Task SuggestAsync(string text)
    {
        _input = text;
        await SendAsync();
    }

    private async Task SendAsync()
    {
        var text = _input.Trim();
        if (text.Length == 0 || _sending || _sessionId is null) return;

        var messageId = Guid.NewGuid().ToString("N");
        _input = string.Empty;
        _addedNotice = null;
        _sending = true;
        _messages.Add(new AiSessionMessage("user", text, [], DateTime.UtcNow));
        await ScrollToBottomAsync();

        AiChatResult? result = null;
        try
        {
            result = await AiClient.SendChatAsync(TenantId, _sessionId, messageId, text, Locale);
        }
        catch { /* handled below — fallback message */ }
        _sending = false;

        if (result is null)
        {
            // Transport failure is a dead-end like a refusal — offer the human channel (P8).
            _messages.Add(new AiSessionMessage("assistant",
                "Trợ lý AI tạm nghỉ, bạn thử lại sau nhé.", [], DateTime.UtcNow, Refused: true));
        }
        else if (_seenMessageIds.Add(messageId))
        {
            _messages.Add(new AiSessionMessage("assistant", result.Answer, result.Products,
                DateTime.UtcNow, result.Refused));
        }
        await ScrollToBottomAsync();
    }

    /// <summary>Task AI-P8: switch to the host's human chat surface (lazy mount).</summary>
    private void SwitchToHuman() => _mode = WidgetMode.Human;

    /// <summary>Task AI-P8: back to AI — the AI message list is kept intact.</summary>
    private void SwitchToAi() => _mode = WidgetMode.Ai;

    /// <summary>Task AI-P8: refuse CTA — hand the refused question to the host for prefill.</summary>
    private async Task EscalateAsync(string? draft)
    {
        if (OnDraftRequest.HasDelegate)
            await OnDraftRequest.InvokeAsync(
                draft is { Length: > MaxDraftChars } ? draft[..MaxDraftChars] : draft);
        _mode = WidgetMode.Human;
    }

    private async Task AddToCartAsync(AiSessionMessage msg, AiProductCardItem product)
    {
        if (OnAddToCart.HasDelegate)
        {
            await OnAddToCart.InvokeAsync(product);
            _addedNotice = $"Đã thêm \"{product.Name}\" vào giỏ.";
        }
    }

    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_input))
            await SendAsync();
    }

    private async Task ScrollToBottomAsync()
    {
        await InvokeAsync(StateHasChanged);
        try
        {
            await JSRuntime.InvokeVoidAsync("vananRealtime.scrollToBottom", ScrollContainerId);
        }
        catch { /* JS interop not available during prerender */ }
    }
}
