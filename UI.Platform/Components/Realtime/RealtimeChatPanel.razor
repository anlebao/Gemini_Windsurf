@* Realtime Platform P4 (UI-6): subject-agnostic chat panel — ported from
   KhachLink/Components/ChatPanel.razor (CC-S3 UC-07).
   Differences from the original:
     - SubjectType/SubjectId replace the OrderId-only surface (Order, Shop, Ticket, ...).
     - HTTP goes through IRealtimeChatClient → Gateway /api/realtime/conversations/* (generic).
     - SignalR goes through IRealtimeEndpointProvider → /hubs/messaging (group msg_{type}_{id}).
     - DeriveGatewayUrl removed (C8) — the endpoint provider owns URL derivation (F4).
     - F11: VanAInput instead of a raw <input class="form-control">; no inline <style>. *@
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Core.Interfaces
@using VanAn.UI.Platform.Realtime
@using VanAn.UI.Platform.Tokens
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject IRealtimeChatClient ChatClient
@inject IRealtimeEndpointProvider Endpoints
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="chat-panel">
    <VanAnCard Shadow="true" CssClass="p-0 overflow-hidden">
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
            <h6 class="mb-0"><i class="bi bi-chat-dots text-primary"></i> @(HeaderTitle ?? "Chat với khách hàng")</h6>
            <div class="d-flex align-items-center gap-2">
                @* VOICE SERVICE S4 (2026-11-12): icon gọi nổi bật ngay chat header —
                   chỉ enable khi hub Connected + đã đăng nhập + đang idle (S3/S5). *@
                @if (VoiceCallEnabled)
                {
                    <VanAnButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                 OnClick="StartVoiceCallAsync" Disabled="!VoiceCallReady"
                                 title="@VoiceCallTitle" aria-label="Gọi thoại"
                                 CssClass="@VoiceCallButtonClass"
                                 data-testid="voice-call-header-btn">
                        <i class="bi @VoiceCallButtonIcon"></i>
                    </VanAnButton>
                }
                @* P6 manual-test: nút làm mới nội dung chat thủ công.
                   Dùng param Disabled (PascalCase) — lowercase `disabled` qua unmatched
                   attributes va chạm với disabled nội bộ của VanAnButton → render crash. *@
                <VanAnButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                             OnClick="LoadHistoryAsync" Disabled="_loadingHistory"
                             aria-label="Làm mới tin nhắn">
                    <i class="bi bi-arrow-clockwise"></i>
                </VanAnButton>
                @if (_isConnected)
                {
                    <span class="badge bg-success">Đã kết nối</span>
                }
                else if (_connecting)
                {
                    <span class="badge bg-warning text-dark">Đang kết nối...</span>
                }
                else
                {
                    <span class="badge bg-secondary">Offline (HTTP only)</span>
                }
            </div>
        </div>

        <!-- Message list -->
        <div id="@ScrollContainerId" style="max-height: 400px; overflow-y: auto; padding: 12px;" class="bg-light">
            @if (_loadingHistory)
            {
                <div class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                </div>
            }
            else if (_error != null)
            {
                @* Error takes precedence over empty state — don't show "Chưa có tin nhắn" when LoadHistoryAsync failed *@
            }
            else if (_accessDenied)
            {
                <div class="text-center text-muted py-3">
                    <i class="bi bi-chat-slash" style="font-size: 2rem;"></i>
                    <div class="small mt-2">Chat không khả dụng cho đơn hàng này.</div>
                </div>
            }
            else if (_messages.Count == 0)
            {
                <div class="text-center text-muted py-3">
                    <i class="bi bi-chat" style="font-size: 2rem;"></i>
                    <div class="small mt-2">Chưa có tin nhắn. Hãy gửi tin nhắn đầu tiên!</div>
                </div>
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    var isOwn = msg.SenderId == CurrentUserId;
                    <div class="d-flex @(isOwn ? "justify-content-end" : "justify-content-start") mb-2">
                        <div style="max-width: 75%;">
                            <div class="px-3 py-2 rounded @(isOwn ? "bg-primary text-white" : "bg-white border")">
                                @msg.Content
                            </div>
                            <div class="small text-muted mt-1 @(isOwn ? "text-end" : "text-start")">
                                @msg.SentAt.ToString("HH:mm")
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Input row -->
        <div class="p-3 border-top">
            @if (_error != null)
            {
                <div class="alert alert-danger py-2 small mb-2">
                    @_error
                    @if (_tokenExpired)
                    {
                        <br />
                        <a href="/login" class="text-decoration-underline fw-bold">Đăng nhập lại</a>
                    }
                </div>
            }
            @if (_signalrWarning != null)
            {
                <div class="alert alert-warning py-2 small mb-2">
                    <i class="bi bi-exclamation-triangle"></i> @_signalrWarning
                </div>
            }
            @* P6 manual-test: mobile — nút Gửi xuống dòng riêng (không tràn màn hình);
               desktop (≥576px) — input + nút cùng hàng. Xem RealtimeChatPanel.razor.css. *@
            @if (_voiceError is not null)
            {
                <div class="alert alert-danger py-2 small mb-2">
                    <i class="bi bi-mic-mute"></i> @_voiceError
                </div>
            }
            <div class="chat-input-row">
                @* F11: UI Platform VanAInput instead of a raw input.form-control.
                   Enter-to-send qua param OnKeyPress (unmatched @onkeypress KHÔNG bind — render literal). *@
                <VanAInput AdditionalClasses="vanan-input-field"
                           Placeholder="@(_listening ? "Đang nghe..." : "Nhập tin nhắn...")"
                           @bind-Value="_messageInput"
                           OnKeyPress="OnKeyPress"
                           maxlength="2000"
                           Disabled="(_tokenExpired || _accessDenied)" />
                @* SF-W3 (2026-11-08): voice input — nói thay vì gõ. Chỉ hiện khi host bật
                   VoiceEnabled + trình duyệt hỗ trợ SpeechRecognition (vananVoiceInput). *@
                @if (VoiceEnabled && _speechSupported)
                {
                    <VanAnButton Variant="ButtonVariant.Outline" OnClick="ToggleVoiceAsync"
                                 Disabled="(_tokenExpired || _accessDenied)"
                                 CssClass="@("chat-mic-btn" + (_listening ? " listening" : ""))"
                                 aria-label="@(_listening ? "Dừng nói" : "Nói thay vì gõ")">
                        <i class="bi @(_listening ? "bi-mic-fill" : "bi-mic")"></i>
                    </VanAnButton>
                }
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="SendMessage" Disabled="(_tokenExpired || _accessDenied)"
                             CssClass="chat-send-btn">
                    <i class="bi bi-send"></i> Gửi
                </VanAnButton>
            </div>
        </div>
        @* VOICE SERVICE P4: one-to-one call inside the chat (customer ↔ merchant) — host opt-in. *@
        @if (VoiceCallEnabled)
        {
            <VoiceCallPanel @ref="_voicePanel" Enabled="true"
                            SubjectType="@SubjectType"
                            SubjectId="SubjectId"
                            CurrentUserId="CurrentUserId"
                            Token="@(IsStaff ? StaffToken : CustomerToken)"
                            VoiceHubUrl="@VoiceHubUrl"
                            VoiceServiceUrl="@VoiceServiceUrl"
                            ShowWalletLink="IsStaff"
                            HubStateChanged="OnVoiceHubStateChanged"
                            CallStateChanged="OnVoiceCallStateChanged" />
        }
    </VanAnCard>
</div>

@code {
    /// <summary>Subject discriminator — "Order", "Shop", ... (matches server RealtimeSubjectType names).</summary>
    [Parameter] public string SubjectType { get; set; } = "Order";
    [Parameter] public Guid SubjectId { get; set; }
    /// <summary>The caller's own participant id (customer id or guest device id) — used to align bubbles.</summary>
    [Parameter] public Guid CurrentUserId { get; set; }
    [Parameter] public string? CustomerToken { get; set; }
    /// <summary>D6 (2026-09-17): guest identity (localStorage "customer_device_id"). Guests chat over HTTP.</summary>
    [Parameter] public Guid? CustomerDeviceId { get; set; }
    /// <summary>
    /// P5 (2026-09-18): staff Bearer JWT (ShopERP minted, tenant_id claim) — the shop side of a
    /// Shop conversation. Takes precedence over the customer credentials; sent as
    /// Authorization: Bearer on HTTP and ?access_token= on the SignalR handshake.
    /// </summary>
    [Parameter] public string? StaffToken { get; set; }
    [Parameter] public string ScrollContainerId { get; set; } = "chat-scroll-container";
    /// <summary>
    /// Task AI-P8: optional draft prefill (AI→human escalation). Applied exactly once on
    /// first render — never overwrites what the user is already typing on re-render.
    /// Null/empty → behavior unchanged.
    /// </summary>
    [Parameter] public string? InitialDraft { get; set; }
    /// <summary>Task AI-P8: header title override (default "Chat với khách hàng" unchanged).</summary>
    [Parameter] public string? HeaderTitle { get; set; }
    /// <summary>SF-W3 (2026-11-08): voice toggle (host resolves Voice_Note_Enabled); false → mic hidden.</summary>
    [Parameter] public bool VoiceEnabled { get; set; }
    /// <summary>VOICE SERVICE P4 (2026-11-11): enable the voice call button inside the chat
    /// (host resolves the Voice_Call_Enabled tenant flag). False → no voice call UI.</summary>
    [Parameter] public bool VoiceCallEnabled { get; set; }
    /// <summary>VOICE SERVICE P4: voice SignalR hub URL (same-origin default; hosts override).</summary>
    [Parameter] public string VoiceHubUrl { get; set; } = "/hubs/voice";
    /// <summary>VOICE SERVICE P4: voice service HTTP base URL (TURN credentials + missed calls).</summary>
    [Parameter] public string VoiceServiceUrl { get; set; } = "";

    private List<RealtimeChatMessage> _messages = new();
    private string _messageInput = string.Empty;
    private bool _loadingHistory = true;
    private bool _connecting = false;
    private bool _isConnected = false;
    private bool _tokenExpired = false;
    private bool _accessDenied = false;
    private string? _error;
    private string? _signalrWarning;
    private HubConnection? _hubConnection;
    // D6: guests (and any client whose SignalR failed) fall back to polling the history endpoint.
    private System.Threading.CancellationTokenSource? _pollCts;
    // Task AI-P8: InitialDraft is a one-shot prefill — re-renders must not clobber typing.
    private bool _draftApplied;
    // SF-W3: voice input state (vananVoiceInput JS singleton — one active mic page-wide).
    private bool _speechSupported;
    private bool _supportChecked;
    private bool _listening;
    private string? _voiceError;
    private DotNetObjectReference<RealtimeChatPanel>? _voiceRef;
    // VOICE SERVICE S3/S4 (2026-11-12): header call button mirrors the panel's hub/call state.
    private VoiceCallPanel? _voicePanel;
    private string _voiceHubState = "connecting";
    private string _voiceCallState = "idle";

    // Guests (device id only, no customer token / staff JWT) cannot call — S5 Option 1.
    private bool VoiceCallIdentity => IsStaff || !string.IsNullOrEmpty(CustomerToken);

    // Terminal call states are retryable (SDK resets to idle on retry) — mirror
    // VoiceCallPanel._idleLike so the header button doesn't stay dead after a failed call.
    private static bool VoiceCallIdleLike(string state) =>
        state is "idle" or "ended" or "rejected" or "cancelled" or "missed"
            or "busy" or "offline" or "collision" or "failed";

    private bool VoiceCallReady => VoiceCallEnabled && VoiceCallIdentity
        && _voiceHubState == "connected" && VoiceCallIdleLike(_voiceCallState);

    // UX refresh (2026-11-13): header icon phản ánh trạng thái cuộc gọi —
    // incoming/ringing pulse đỏ, đang gọi pulse xanh, idle thường.
    private string VoiceCallButtonClass => _voiceCallState switch
    {
        "ringing" => "voice-hdr-btn voice-hdr-btn--ringing",
        "calling" or "accepted" or "negotiating" or "connected" or "reconnecting"
            => "voice-hdr-btn voice-hdr-btn--active",
        _ => "voice-hdr-btn"
    };

    private string VoiceCallButtonIcon => _voiceCallState switch
    {
        "calling" => "bi-telephone-outbound",
        "ringing" => "bi-telephone-inbound",
        _ => "bi-telephone"
    };

    private string VoiceCallTitle =>
        !VoiceCallIdentity ? "Đăng nhập để gọi thoại"
        : _voiceHubState == "connecting" ? "Đang kết nối máy chủ cuộc gọi..."
        : _voiceHubState != "connected" ? "Không kết nối được máy chủ cuộc gọi"
        : !VoiceCallIdleLike(_voiceCallState) ? "Đang trong cuộc gọi"
        : "Gọi thoại";

    private void OnVoiceHubStateChanged(string state) => _voiceHubState = state;
    private void OnVoiceCallStateChanged(string state) => _voiceCallState = state;

    private async Task StartVoiceCallAsync()
    {
        if (_voicePanel is not null) await _voicePanel.StartCallAsync();
    }

    private string GroupName => $"msg_{SubjectType}_{SubjectId}";

    private bool HasGuestIdentity => CustomerDeviceId.HasValue && CustomerDeviceId.Value != Guid.Empty;

    /// <summary>P5: staff mode — the Bearer JWT is the only credential.</summary>
    private bool IsStaff => !string.IsNullOrEmpty(StaffToken);

    private bool HasAnyIdentity => IsStaff || !string.IsNullOrEmpty(CustomerToken) || HasGuestIdentity;

    protected override void OnParametersSet()
    {
        if (!_draftApplied && !string.IsNullOrWhiteSpace(InitialDraft))
        {
            _messageInput = InitialDraft;
            _draftApplied = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!HasAnyIdentity)
        {
            _error = "Chưa đăng nhập.";
            _loadingHistory = false;
            return;
        }

        await LoadHistoryAsync();
        await ConnectSignalRAsync();
        StartHistoryPolling();
    }

    /// <summary>
    /// Refresh the message list every 4s when SignalR is not connected (guest sessions or a failed
    /// hub connection) — P6 manual-test: interval 8s → 4s. Real-time is skipped — the HTTP history
    /// endpoint is the fallback; a manual refresh button is in the panel header.
    /// </summary>
    private void StartHistoryPolling()
    {
        _pollCts?.Cancel();
        _pollCts = new System.Threading.CancellationTokenSource();
        var token = _pollCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(4), token);
                    if (_isConnected) continue; // SignalR pushes messages — no polling needed
                    await LoadHistoryAsync();
                }
                catch (TaskCanceledException) { break; }
                catch { /* keep polling */ }
            }
        }, token);
    }

    private async Task LoadHistoryAsync()
    {
        _loadingHistory = true;
        var result = await ChatClient.GetHistoryAsync(SubjectType, SubjectId, CustomerToken, CustomerDeviceId, 100, StaffToken);
        if (result.Success)
        {
            _messages = result.Messages;
        }
        else
        {
            // 401 = token expired/invalid — show re-login guidance
            if (result.ErrorCode == 401)
            {
                _error = "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại để sử dụng chat.";
                _tokenExpired = true;
            }
            // 404 = subject has no conversation yet — friendly empty state, not an error
            else if (result.ErrorCode == 404)
                _error = null;
            // 403 = caller is not a party of this conversation (order belongs to another
            // customer/device). Access won't appear mid-mount → friendly empty state and
            // STOP polling (was: banner + 403 spam every 4s — reported 2026-11-08).
            else if (result.ErrorCode == 403)
            {
                _error = null;
                _accessDenied = true;
                _pollCts?.Cancel();
            }
            else
                _error = result.ErrorMessage;
        }
        _loadingHistory = false;
        await InvokeAsync(StateHasChanged);
        await ScrollToBottomAsync();
    }

    private async Task ConnectSignalRAsync()
    {
        if (!HasAnyIdentity) return;

        try
        {
            _connecting = true;
            // F4: hub URL comes from the endpoint provider (no manual derivation in the component).
            // P5: staff uses the SignalR access_token convention (WebSocket handshakes cannot set
            // headers); customers keep the customerToken query, guests the customerDeviceId query.
            string hubUrl;
            if (IsStaff)
                hubUrl = $"{Endpoints.GetMessagingHubUrl()}?access_token={Uri.EscapeDataString(StaffToken!)}";
            else if (!string.IsNullOrEmpty(CustomerToken))
            {
                // 2026-11-08 (edge case): send device id alongside the token so the Gateway
                // can match guest orders placed on this device before login.
                hubUrl = $"{Endpoints.GetMessagingHubUrl()}?customerToken={Uri.EscapeDataString(CustomerToken)}";
                if (HasGuestIdentity)
                    hubUrl += $"&customerDeviceId={CustomerDeviceId}";
            }
            else
                hubUrl = $"{Endpoints.GetMessagingHubUrl()}?customerDeviceId={CustomerDeviceId}";

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<string, string, string, string>("ReceiveMessage", (messageId, senderId, content, sentAt) =>
            {
                var msg = new RealtimeChatMessage
                {
                    Id = Guid.Parse(messageId),
                    SenderId = Guid.Parse(senderId),
                    Content = content,
                    SentAt = DateTime.Parse(sentAt),
                    IsRead = false
                };
                _messages.Add(msg);
                _ = InvokeAsync(async () =>
                {
                    StateHasChanged();
                    await ScrollToBottomAsync();
                });
            });

            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("JoinConversation", SubjectType, SubjectId.ToString());
            _isConnected = true;
        }
        catch (Exception ex)
        {
            // Graceful degradation: HTTP still works for sending/receiving messages.
            _signalrWarning = "Không thể kết nối chat real-time. Tin nhắn vẫn gửi được (không tức thời).";
            System.Diagnostics.Debug.WriteLine($"RealtimeChatPanel SignalR connection failed: {ex.Message}");
        }
        finally
        {
            _connecting = false;
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageInput) || !HasAnyIdentity)
            return;

        var content = _messageInput.Trim();
        _messageInput = string.Empty;
        _error = null;

        var result = await ChatClient.SendMessageAsync(SubjectType, SubjectId, content, CustomerToken, CustomerDeviceId, StaffToken);
        if (!result.Success)
        {
            if (result.ErrorCode == 403)
            {
                // Same as history path — permanent denial, not a transient failure.
                _error = null;
                _accessDenied = true;
                _pollCts?.Cancel();
            }
            else
            {
                _error = result.ErrorMessage;
                // Restore message input on failure
                _messageInput = content;
            }
        }
        else if (!_isConnected)
        {
            // SignalR not connected — optimistically append locally so sender sees their message.
            _messages.Add(new RealtimeChatMessage
            {
                Id = result.MessageId,
                SenderId = CurrentUserId,
                Content = content,
                SentAt = result.SentAt,
                IsRead = false
            });
            _ = InvokeAsync(async () =>
            {
                StateHasChanged();
                await ScrollToBottomAsync();
            });
        }
        // If SignalR connected, ReceiveMessage handler will append the message — no need to add manually.
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnKeyPress(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_messageInput))
        {
            await SendMessage();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // SF-W3: the flag can arrive after first render (host flag fetch) — probe
        // speech support the first time VoiceEnabled is seen, not only firstRender.
        if (VoiceEnabled && !_supportChecked)
        {
            _supportChecked = true;
            try
            {
                _speechSupported = await JSRuntime.InvokeAsync<bool>("vananVoiceInput.isSupported");
            }
            catch
            {
                _speechSupported = false; // script not loaded / prerender — mic stays hidden
            }
            if (_speechSupported) StateHasChanged();
        }
    }

    private async Task ToggleVoiceAsync()
    {
        _voiceError = null;
        try
        {
            if (_listening)
            {
                _listening = false; // JS onend → OnVoiceEnd re-confirms
                await JSRuntime.InvokeVoidAsync("vananVoiceInput.stop");
            }
            else
            {
                _voiceRef ??= DotNetObjectReference.Create(this);
                _listening = await JSRuntime.InvokeAsync<bool>("vananVoiceInput.start", _voiceRef);
            }
        }
        catch
        {
            _listening = false;
        }
    }

    /// <summary>SF-W3: live transcript while speaking — fills the input in real time.</summary>
    [JSInvokable]
    public void OnVoiceInterim(string text)
    {
        _messageInput = text;
        StateHasChanged();
    }

    /// <summary>SF-W3: silence/manual stop → final transcript → auto-send the message.</summary>
    [JSInvokable]
    public async Task OnVoiceFinal(string text)
    {
        _messageInput = text;
        _listening = false;
        await SendMessage();
    }

    [JSInvokable]
    public void OnVoiceError(string message)
    {
        _listening = false;
        _voiceError = message;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceEnd()
    {
        _listening = false;
        StateHasChanged();
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("vananRealtime.scrollToBottom", ScrollContainerId);
        }
        catch { /* JS interop not available during prerender */ }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_listening) await JSRuntime.InvokeVoidAsync("vananVoiceInput.stop");
        }
        catch { /* JS gone during teardown */ }
        _voiceRef?.Dispose();

        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;

        if (_hubConnection != null)
        {
            try
            {
                await _hubConnection.InvokeAsync("LeaveConversation", SubjectType, SubjectId.ToString());
                await _hubConnection.DisposeAsync();
            }
            catch { }
        }
    }
}
