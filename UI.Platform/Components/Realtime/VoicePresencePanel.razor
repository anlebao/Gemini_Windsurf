@* VOICE PRESENCE (2026-11-21, task voice_presence): presence-only voice connection
   mount ở layout (staff toggle / customer auto). KHÔNG render call button — chỉ
   giữ SignalR /hubs/voice connection sống để nhận IncomingCall ở mọi trang.

   Global call UI: incoming overlay + in-call mini bar — CHỈ hiện khi chat
   surface không active (VoiceCallPanel trong chat tự handle khi đang mở). *@
@using Microsoft.JSInterop
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Tokens

@if (Coordinator is not null && ShowGlobalCallUi)
{
    var c = Coordinator;
    @if (c.IncomingActive)
    {
        <div class="voice-presence-incoming" data-testid="voice-presence-incoming">
            <span class="voice-presence-avatar voice-presence-avatar--ringing">
                <i class="bi bi-telephone-inbound"></i>
            </span>
            <div class="voice-presence-info">
                <div class="voice-presence-title">@(c.IncomingCallerName ?? "Cuộc gọi đến")</div>
                @if (!string.IsNullOrWhiteSpace(c.IncomingContextLabel))
                {
                    <div class="voice-presence-sub">@c.IncomingContextLabel</div>
                }
            </div>
            <div class="voice-presence-actions">
                <VanAnButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small"
                             OnClick="AcceptCallAsync" CssClass="voice-presence-btn voice-presence-btn--accept"
                             data-testid="voice-presence-accept" aria-label="Nghe">
                    <i class="bi bi-telephone"></i>
                </VanAnButton>
                <VanAnButton Variant="ButtonVariant.Error" Size="ButtonSize.Small"
                             OnClick="RejectCallAsync" CssClass="voice-presence-btn voice-presence-btn--reject"
                             data-testid="voice-presence-reject" aria-label="Từ chối">
                    <i class="bi bi-telephone-x"></i>
                </VanAnButton>
            </div>
        </div>
    }
    else if (CallActive(c.CallState))
    {
        @* VIDEO MVP (2026-11-22): video overlay toàn cục khi chat surface không handle.
           Host ids giống chat panel — 2 UI loại trừ nhau qua ChatSurfaceActive. *@
        @if (c.CallType == "video" || c.VideoRemoteOn || c.VideoLocalOn)
        {
            <div class="voice-presence-video" data-testid="voice-presence-video">
                <div class="voice-presence-video-remote">
                    <div id="voice-remote-video-host" class="voice-presence-video-remote-host" data-testid="voice-presence-video-remote"></div>
                    @if (!c.VideoRemoteOn)
                    {
                        <div class="voice-presence-video-placeholder">
                            <i class="bi bi-camera-video-off"></i>
                        </div>
                    }
                </div>
                <div id="voice-local-video-host" class="voice-presence-video-local @(c.VideoSelfHidden ? "voice-presence-video-local--hidden" : "")" data-testid="voice-presence-video-local"></div>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="ToggleSelfView"
                             CssClass="voice-selfview-toggle"
                             data-testid="voice-presence-selfview-toggle"
                             aria-label="@(c.VideoSelfHidden ? "Hiện khung camera của mình" : "Ẩn khung camera của mình")"
                             title="@(c.VideoSelfHidden ? "Hiện camera của mình" : "Ẩn camera của mình")">
                    <i class="bi @(c.VideoSelfHidden ? "bi-eye-slash" : "bi-eye")"></i>
                </VanAnButton>
            </div>
        }
        <div class="voice-presence-callbar" data-testid="voice-presence-callbar">
            <i class="bi @(c.CallType == "video" ? "bi-camera-video" : "bi-telephone")"></i>
            <span class="voice-presence-callbar-state">@CallBarLabel(c.CallState)</span>
            <span class="voice-presence-callbar-timer">@CallDurationText</span>
            <VanAnButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                         OnClick="ToggleCameraAsync" CssClass="voice-presence-icon-btn"
                         data-testid="voice-presence-camera" aria-label="@(c.VideoLocalOn ? "Tắt camera" : "Bật camera")">
                <i class="bi @(c.VideoLocalOn ? "bi-camera-video" : "bi-camera-video-off")"></i>
            </VanAnButton>
            @if (c.VideoLocalOn)
            {
                <VanAnButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                             OnClick="SwitchCameraAsync" CssClass="voice-presence-icon-btn"
                             data-testid="voice-presence-camera-switch" aria-label="Đổi camera trước/sau">
                    <i class="bi bi-camera-reverse"></i>
                </VanAnButton>
            }
            <VanAnButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                         OnClick="ToggleMuteAsync" CssClass="voice-presence-icon-btn"
                         data-testid="voice-presence-mute" aria-label="@(_muted ? "Bật mic" : "Tắt mic")">
                <i class="bi @(_muted ? "bi-mic-mute" : "bi-mic")"></i>
            </VanAnButton>
            <VanAnButton Variant="ButtonVariant.Error" Size="ButtonSize.Small"
                         OnClick="EndCallAsync" CssClass="voice-presence-icon-btn voice-presence-icon-btn--end"
                         data-testid="voice-presence-end" aria-label="Kết thúc cuộc gọi">
                <i class="bi bi-telephone-x"></i>
            </VanAnButton>
        </div>
    }
}
