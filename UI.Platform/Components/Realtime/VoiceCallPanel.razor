@* VOICE SERVICE P4 (2026-11-11): voice call inside the chat conversation (SRS §9.2 — chat-first).
   Embed in RealtimeChatPanel (or any host) with Enabled=true. Attachable by contract —
   talks to window.vananVoice through the voice-chat.js bridge; no host internals. *@
@using Microsoft.JSInterop
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Tokens

@* UX refresh (2026-11-13): panel KHÔNG còn render nút "Gọi thoại" ở idle —
   điểm vào gọi duy nhất là icon điện thoại trên chat header (RealtimeChatPanel).
   Panel chỉ xuất hiện khi có cuộc gọi đang diễn ra (incoming/ringing/active)
   hoặc cần báo lỗi/trạng thái (missed, offline, metering deny). *@
@if (Enabled && (!_idleLike || _missed || !string.IsNullOrEmpty(_error)))
{
    <div class="voice-call-panel" data-testid="voice-call-panel">
        @if (!_idleLike)
        {
            <div class="voice-call-card" data-testid="voice-call-card">
                <span class="voice-call-avatar @( _state == "ringing" ? "voice-call-avatar--ringing" : "")">
                    <i class="bi @(_state == "ringing" ? "bi-telephone-inbound" : "bi-telephone")"></i>
                </span>
                <div class="voice-call-info">
                    <div class="voice-call-title">
                        @(_state == "ringing" ? "Cuộc gọi đến..." : _state == "calling" ? "Đang gọi..." : "Cuộc gọi")
                    </div>
                    <div class="voice-call-sub">@_displayState</div>
                </div>
                <div class="voice-call-actions">
                    @if (_state == "ringing")
                    {
                        <VanAnButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small"
                                     OnClick="AcceptCallAsync" CssClass="voice-call-btn voice-call-btn--accept"
                                     data-testid="voice-accept" aria-label="Nghe">
                            <i class="bi bi-telephone"></i>
                        </VanAnButton>
                        <VanAnButton Variant="ButtonVariant.Error" Size="ButtonSize.Small"
                                     OnClick="RejectCallAsync" CssClass="voice-call-btn voice-call-btn--reject"
                                     data-testid="voice-reject" aria-label="Từ chối">
                            <i class="bi bi-telephone-x"></i>
                        </VanAnButton>
                    }
                    else if (_state == "calling")
                    {
                        <VanAnButton Variant="ButtonVariant.Error" Size="ButtonSize.Small"
                                     OnClick="CancelCallAsync" CssClass="voice-call-btn voice-call-btn--reject"
                                     data-testid="voice-cancel" aria-label="Hủy cuộc gọi">
                            <i class="bi bi-x-lg"></i>
                        </VanAnButton>
                    }
                    else
                    {
                        <VanAnButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                     OnClick="ToggleMuteAsync" CssClass="@MuteButtonClass"
                                     data-testid="voice-mute" aria-label="@(_muted ? "Bật mic" : "Tắt mic")">
                            <i class="bi @(_muted ? "bi-mic-mute" : "bi-mic")"></i>
                        </VanAnButton>
                        <VanAnButton Variant="ButtonVariant.Error" Size="ButtonSize.Small"
                                     OnClick="EndCallAsync" CssClass="voice-call-btn voice-call-btn--reject"
                                     data-testid="voice-end" aria-label="Kết thúc cuộc gọi">
                            <i class="bi bi-telephone-x"></i>
                        </VanAnButton>
                    }
                </div>
            </div>
        }

        @if (_missed)
        {
            <div class="voice-missed" data-testid="voice-missed">
                <i class="bi bi-telephone-x"></i> Bạn có cuộc gọi nhỡ.
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="voice-error" data-testid="voice-error">
                @_error
                @if (_errorIsMeteringDenied && ShowWalletLink)
                {
                    <a href="/wallet/phi-nen-tang" class="voice-error__link" data-testid="voice-topup-link">
                        <i class="bi bi-wallet2"></i> Nạp phí nền tảng
                    </a>
                }
            </div>
        }
    </div>
}