@* VOICE SERVICE P4 (2026-11-11): voice call inside the chat conversation (SRS §9.2 — chat-first).
   Embed in RealtimeChatPanel (or any host) with Enabled=true. Attachable by contract —
   talks to window.vananVoice through the voice-chat.js bridge; no host internals. *@
@using Microsoft.JSInterop
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Tokens

@* UX refresh (2026-11-13): panel KHÔNG còn render nút "Gọi thoại" ở idle —
   điểm vào gọi duy nhất là icon điện thoại trên chat header (RealtimeChatPanel).
   Panel chỉ xuất hiện khi có cuộc gọi đang diễn ra (incoming/ringing/active)
   hoặc cần báo lỗi/trạng thái (missed, offline, metering deny). *@
@if (Enabled && (!_idleLike || _missed || !string.IsNullOrEmpty(_error)))
{
    <div class="voice-call-panel" data-testid="voice-call-panel">
        @if (!_idleLike)
        {
            @* VIDEO MVP (2026-11-22): remote tile + local PiP. Host divs phải tồn tại
               trong DOM trước khi SDK attach — JS tạo/sở hữu <video> elements bên trong
               (#voice-remote-video-host / #voice-local-video-host). *@
            @if (_showVideo)
            {
                <div class="voice-video-area" data-testid="voice-video-area">
                    <div class="voice-video-remote">
                        <div id="voice-remote-video-host" class="voice-video-remote-host" data-testid="voice-video-remote"></div>
                        @if (!_remoteVideoOn)
                        {
                            <div class="voice-video-placeholder">
                                <i class="bi bi-camera-video-off"></i>
                                <span>Đang chờ video...</span>
                            </div>
                        }
                    </div>
                    <div id="voice-local-video-host" class="voice-video-local @(_selfViewHidden ? "voice-video-local--hidden" : "")" data-testid="voice-video-local"></div>
                    @* Ẩn/hiện khung self-view PiP — chỉ ẩn hiển thị, camera vẫn gửi bình thường.
                       VanAnButton bắt buộc — raw <button @onclick> không dispatch trong island. *@
                    <VanAnButton Variant="ButtonVariant.Outline" OnClick="ToggleSelfView"
                                 CssClass="voice-selfview-toggle"
                                 data-testid="voice-selfview-toggle"
                                 aria-label="@(_selfViewHidden ? "Hiện khung camera của mình" : "Ẩn khung camera của mình")"
                                 title="@(_selfViewHidden ? "Hiện camera của mình" : "Ẩn camera của mình")">
                        <i class="bi @(_selfViewHidden ? "bi-eye-slash" : "bi-eye")"></i>
                    </VanAnButton>
                </div>
            }
            <div class="voice-call-card @(_state == "ringing" ? "voice-call-card--ringing" : "") @(_active ? "voice-call-card--active" : "")" data-testid="voice-call-card">
                <span class="voice-call-avatar @( _state == "ringing" ? "voice-call-avatar--ringing" : "") @(_active ? "voice-call-avatar--active" : "")">
                    <i class="bi @(_state == "ringing" ? (_callType == "video" ? "bi-camera-video" : "bi-telephone-inbound") : (_callType == "video" ? "bi-camera-video" : "bi-telephone"))"></i>
                </span>
                <div class="voice-call-info">
                    <div class="voice-call-title">
                        @(_state == "ringing" ? (_callType == "video" ? "Cuộc gọi video đến..." : "Cuộc gọi đến...") : _state == "calling" ? "Đang gọi..." : (_callType == "video" ? "Cuộc gọi video" : "Cuộc gọi"))
                    </div>
                    <div class="voice-call-sub">@_displayState</div>
                </div>
                <div class="voice-call-actions">
                    @if (_state == "ringing")
                    {
                        <VanAnButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small"
                                     OnClick="AcceptCallAsync" CssClass="voice-call-btn voice-call-btn--accept"
                                     data-testid="voice-accept" aria-label="Nghe">
                            <i class="bi bi-telephone"></i>
                        </VanAnButton>
                        <VanAnButton Variant="ButtonVariant.Error" Size="ButtonSize.Small"
                                     OnClick="RejectCallAsync" CssClass="voice-call-btn voice-call-btn--reject"
                                     data-testid="voice-reject" aria-label="Từ chối">
                            <i class="bi bi-telephone-x"></i>
                        </VanAnButton>
                    }
                    else if (_state == "calling")
                    {
                        <VanAnButton Variant="ButtonVariant.Error" Size="ButtonSize.Small"
                                     OnClick="CancelCallAsync" CssClass="voice-call-btn voice-call-btn--reject"
                                     data-testid="voice-cancel" aria-label="Hủy cuộc gọi">
                            <i class="bi bi-x-lg"></i>
                        </VanAnButton>
                    }
                    else
                    {
                        <VanAnButton Variant="ButtonVariant.Outline"
                                     OnClick="ToggleCameraAsync" CssClass="@CameraButtonClass"
                                     data-testid="voice-camera" aria-label="@(_cameraOn ? "Tắt camera" : "Bật camera")">
                            <i class="bi @(_cameraOn ? "bi-camera-video" : "bi-camera-video-off")"></i>
                        </VanAnButton>
                        @if (_cameraOn)
                        {
                            <VanAnButton Variant="ButtonVariant.Outline"
                                         OnClick="SwitchCameraAsync" CssClass="voice-call-btn"
                                         data-testid="voice-camera-switch" aria-label="Đổi camera trước/sau">
                                <i class="bi bi-camera-reverse"></i>
                            </VanAnButton>
                        }
                        <VanAnButton Variant="ButtonVariant.Outline"
                                     OnClick="ToggleMuteAsync" CssClass="@MuteButtonClass"
                                     data-testid="voice-mute" aria-label="@(_muted ? "Bật mic" : "Tắt mic")">
                            <i class="bi @(_muted ? "bi-mic-mute" : "bi-mic")"></i>
                        </VanAnButton>
                        <VanAnButton Variant="ButtonVariant.Error"
                                     OnClick="EndCallAsync" CssClass="voice-call-btn voice-call-btn--reject"
                                     data-testid="voice-end" aria-label="Kết thúc cuộc gọi">
                            <i class="bi bi-telephone-x"></i>
                        </VanAnButton>
                    }
                </div>
            </div>
        }

        @if (_missed)
        {
            <div class="voice-missed" data-testid="voice-missed">
                <i class="bi bi-telephone-x"></i> Bạn có cuộc gọi nhỡ.
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="voice-error" data-testid="voice-error">
                @_error
                @if (_errorIsMeteringDenied && ShowWalletLink)
                {
                    <a href="/wallet/phi-nen-tang" class="voice-error__link" data-testid="voice-topup-link">
                        <i class="bi bi-wallet2"></i> Nạp phí nền tảng
                    </a>
                }
            </div>
        }
    </div>
}