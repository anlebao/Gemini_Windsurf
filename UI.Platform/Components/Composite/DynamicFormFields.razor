@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using VanAn.UI.Platform.Components.Base
@using VanAn.UI.Platform.Core.Interfaces
@using VanAn.UI.Platform.Adapters
@using VanAn.UI.Platform.Tokens
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Models
@using Microsoft.JSInterop
@inherits BaseComponent

@inject ICssAdapter CssAdapter
@inject ILogger<DynamicFormFields> Logger
@inject Microsoft.JSInterop.IJSRuntime JSRuntime

@if (Fields != null)
{
    @Fields
}
else if (FieldDefinitions != null && FieldDefinitions.Any())
{
    @foreach (var field in FieldDefinitions)
    {
        <div class="mb-3">
            <label for="@field.Id" class="form-label">
                @field.Label
                @if (field.Required)
                {
                    <span class="text-danger">*</span>
                }
            </label>
            
            @if (field.Type == FieldType.Text)
            {
                <input type="text" 
                       class="form-control @(GetFieldValidationClass(field.Id))" 
                       id="@field.Id" 
                       @bind="field.Value"
                       @bind:event="oninput"
                       @bind:after="@(() => NotifyChanged(field))"
                       placeholder="@field.Placeholder"
                       disabled="@State.IsDisabled"
                       required="@field.Required" />
            }
            else if (field.Type == FieldType.Select)
            {
                <select class="form-select @(GetFieldValidationClass(field.Id))" 
                        id="@field.Id" 
                        disabled="@State.IsDisabled"
                        @bind="field.Value"
                        @bind:event="onchange"
                        @bind:after="@(() => NotifyChanged(field))"
                        required="@field.Required">
                    @if (!string.IsNullOrEmpty(field.Placeholder))
                    {
                        <option value="">@field.Placeholder</option>
                    }
                    @foreach (var option in field.Options ?? Enumerable.Empty<FieldOption>())
                    {
                        <option value="@option.Value" selected="@(option.Value == field.Value)">
                            @option.Label
                        </option>
                    }
                </select>
            }
            else if (field.Type == FieldType.Checkbox)
            {
                <div class="form-check">
                    <input type="checkbox"
                           class="form-check-input"
                           id="@field.Id"
                           @bind="field.Value"
                           @bind:after="@(() => NotifyChanged(field))"
                           disabled="@State.IsDisabled" />
                    <label class="form-check-label" for="@field.Id">@field.Label</label>
                </div>
            }
            else if (field.Type == FieldType.Date)
            {
                <input type="date"
                       class="form-control @(GetFieldValidationClass(field.Id))"
                       id="@field.Id"
                       @bind="field.Value"
                       @bind:event="oninput"
                       @bind:after="@(() => NotifyChanged(field))"
                       disabled="@State.IsDisabled"
                       required="@field.Required" />
            }
            else if (field.Type == FieldType.Currency)
            {
                <input type="text"
                       class="form-control @(GetFieldValidationClass(field.Id))"
                       id="@field.Id"
                       value="@field.Value"
                       @oninput="@((ChangeEventArgs e) => HandleCurrencyInput(field, e))"
                       inputmode="numeric"
                       placeholder="@(field.Placeholder ?? "0")"
                       disabled="@State.IsDisabled"
                       required="@field.Required" />
            }
            else if (field.Type == FieldType.TextArea)
            {
                <textarea class="form-control @(GetFieldValidationClass(field.Id))"
                          id="@field.Id"
                          rows="3"
                          placeholder="@field.Placeholder"
                          disabled="@State.IsDisabled"
                          @bind="field.Value"
                          @bind:event="oninput"
                          @bind:after="@(() => NotifyChanged(field))"
                          required="@field.Required"></textarea>
            }
            else if (field.Type == FieldType.Number)
            {
                <input type="number"
                       class="form-control"
                       id="@field.Id"
                       @bind="field.Value"
                       @bind:event="oninput"
                       @bind:after="@(() => NotifyChanged(field))"
                       placeholder="@field.Placeholder"
                       disabled="@State.IsDisabled" />
            }
            else if (field.Type == FieldType.Email)
            {
                <input type="email"
                       class="form-control"
                       id="@field.Id"
                       @bind="field.Value"
                       @bind:event="oninput"
                       @bind:after="@(() => NotifyChanged(field))"
                       placeholder="@field.Placeholder"
                       disabled="@State.IsDisabled" />
            }
            else if (field.Type == FieldType.Password)
            {
                <input type="password"
                       class="form-control"
                       id="@field.Id"
                       @bind="field.Value"
                       @bind:event="oninput"
                       @bind:after="@(() => NotifyChanged(field))"
                       placeholder="@field.Placeholder"
                       disabled="@State.IsDisabled" />
            }

            @if (!string.IsNullOrEmpty(field.HelpText))
            {
                <small class="form-text text-muted">@field.HelpText</small>
            }
            
            @if (GetFieldError(field.Id) != null)
            {
                <small class="text-danger field-error">@GetFieldError(field.Id)</small>
            }
        </div>
    }
}

@code {
    /// <summary>
    /// Custom fields content
    /// </summary>
    [Parameter]
    public RenderFragment? Fields { get; set; }

    /// <summary>
    /// Field definitions for dynamic form
    /// </summary>
    [Parameter]
    public List<FormField>? FieldDefinitions { get; set; }

    /// <summary>
    /// Raised whenever a field value changes, allowing the parent host to react
    /// </summary>
    [Parameter]
    public EventCallback<FormField> OnFieldChanged { get; set; }

    /// <summary>
    /// After render, attach client-side currency formatter to all Currency inputs.
    /// The JS listener formats the DOM value instantly (no Blazor Server round-trip),
    /// then the Blazor @oninput handler sends the formatted value to the server.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FieldDefinitions != null)
        {
            foreach (var field in FieldDefinitions.Where(f => f.Type == FieldType.Currency))
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("vananAttachCurrencyFormatter", field.Id);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "JS interop attach currency formatter failed for field {FieldId}", field.Id);
                }
            }
        }
    }

    /// <summary>
    /// Validation errors for fields
    /// </summary>
    private Dictionary<string, string> FieldErrors { get; set; } = new();

    /// <summary>
    /// Notifies the parent host that the shared FormField reference was mutated by @bind
    /// </summary>
    private async Task NotifyChanged(FormField field)
    {
        // Clear error when field changes
        if (FieldErrors.ContainsKey(field.Id))
        {
            FieldErrors.Remove(field.Id);
        }

        if (OnFieldChanged.HasDelegate)
        {
            await OnFieldChanged.InvokeAsync(field);
        }
    }

    /// <summary>
    /// Handles currency input from Blazor @oninput: strips non-digits from the
    /// ChangeEventArgs value (which is the DOM value AFTER the client-side JS
    /// formatter has already formatted it, e.g. "55.000"), stores the formatted
    /// string in field.Value so validation/submission can strip separators.
    /// </summary>
    private async Task HandleCurrencyInput(FormField field, ChangeEventArgs e)
    {
        field.Value = e.Value?.ToString() ?? "";
        await NotifyChanged(field);
    }

    /// <summary>
    /// Format currency field: strip non-digits, reformat with thousands separator.
    /// Called after @bind sets field.Value. Uses JS interop to update DOM input directly
    /// because Blazor @bind + @bind:after does not reliably push the post-format value
    /// back to the input element (the DOM keeps the raw user-typed value).
    /// Stores FORMATTED value (e.g. "55.000") in field.Value so validation/submission
    /// can strip separators before parsing.
    /// </summary>
    private async Task FormatCurrencyField(FormField field)
    {
        var current = field.Value?.ToString() ?? "";
        // Strip all non-digit characters
        var raw = new string(current.Where(char.IsDigit).ToArray());
        if (string.IsNullOrEmpty(raw))
        {
            field.Value = "";
        }
        else
        {
            // Format with vi-VN thousands separator (".")
            if (long.TryParse(raw, out var num))
            {
                field.Value = num.ToString("#,##0", new System.Globalization.CultureInfo("vi-VN"));
            }
            else
            {
                field.Value = raw;
            }
        }

        // Push formatted value to DOM input directly — @bind:after does not reliably
        // re-render the input value attribute after we mutate field.Value here.
        // This is the same class of bug as the vananReadElementValue workaround
        // in RevenueEntry/ExpenseEntry (Blazor @bind drops DOM sync across component
        // boundaries during fast input).
        try
        {
            await JSRuntime.InvokeVoidAsync("vananFormatCurrencyInput", field.Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "JS interop format currency failed for field {FieldId}", field.Id);
        }

        await NotifyChanged(field);
    }

    /// <summary>
    /// Gets validation CSS class for a field
    /// </summary>
    private string GetFieldValidationClass(string fieldId)
    {
        return FieldErrors.ContainsKey(fieldId) ? "is-invalid" : "";
    }

    /// <summary>
    /// Gets error message for a field
    /// </summary>
    private string? GetFieldError(string fieldId)
    {
        return FieldErrors.GetValueOrDefault(fieldId);
    }

    /// <summary>
    /// Sets error message for a field
    /// </summary>
    public void SetFieldError(string fieldId, string errorMessage)
    {
        FieldErrors[fieldId] = errorMessage;
        StateHasChanged();
    }

    /// <summary>
    /// Clears all field errors
    /// </summary>
    public void ClearFieldErrors()
    {
        FieldErrors.Clear();
        StateHasChanged();
    }
}
