# Multi-VPS ShopERP VPS — Environment Variables
# Copy to .env.shoperp and fill in actual values.
# Deploy on: vanan-shop-a VPS (34.177.89.248, internal 10.148.0.3)
# IMPORTANT: .env.shoperp is gitignored — NEVER commit real secrets.

# ========================================
# Domain Configuration (REQUIRED — must match Gateway)
# ========================================
VANAN_DOMAIN=khachvip.online

# ========================================
# Multi-VPS Routing (REQUIRED)
# ========================================
# VPC internal IP of the Gateway VPS (vanan-gateway)
# ShopERP connects to NATS + PostgreSQL on this IP
NATS_REMOTE_HOST=10.148.0.2
GATEWAY_REMOTE_HOST=10.148.0.2

# ========================================
# ShopInstance ID (REQUIRED — UNIQUE per VPS)
# ========================================
# This VPS's unique ShopInstance Guid. MUST match the record in Gateway PG.
# Generate a NEW Guid for each ShopERP VPS — NEVER reuse.
# This one was generated for vanan-shop-a: 2026-08-06
SHOP_INSTANCE_ID=9e94f876-27bd-4a16-a85b-b5f42620bc6e

# ========================================
# Database — connect to Gateway VPS PostgreSQL via VPC
# ========================================
POSTGRES_DB=VanAnCoreHub
POSTGRES_USER=vanan_admin
POSTGRES_PASSWORD=CHANGE_THIS_MUST_MATCH_GATEWAY_POSTGRES_PASSWORD

# ========================================
# Auth (REQUIRED — must match Gateway)
# ========================================
JWT_SECRET_KEY=CHANGE_THIS_MUST_MATCH_GATEWAY_JWT_SECRET_KEY

# ========================================
# Docker Images (optional — defaults shown)
# ========================================
# IMAGE_PREFIX=ghcr.io/anlebao
# IMAGE_TAG=latest

# ========================================
# Internal API Key (must match Gateway)
# ========================================
INTERNAL_LOYALTY_API_KEY=vanan-internal-loyalty-prod-2026

# ========================================
# Web Push VAPID (must match Gateway)
# ========================================
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE

# ========================================
# Google OAuth (must match Gateway)
# ========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ========================================
# ShopERP Seed Data (optional — defaults shown)
# ========================================
SHOPERP_OWNER_USERNAME=adminvanan1
SHOPERP_OWNER_PASSWORD=2026@vanan
SHOPERP_TENANT_ID=00000000-0000-0000-0000-000000000001
SHOPERP_SYSADMIN_PASSWORD=2026@vanan
