# Multi-VPS Gateway VPS — Environment Variables
# Copy to .env.gateway and fill in actual values.
# Deploy on: vanan-gateway VPS (136.85.94.119, internal 10.148.0.2)
# IMPORTANT: .env.gateway is gitignored — NEVER commit real secrets.

# ========================================
# Domain Configuration (REQUIRED)
# ========================================
VANAN_DOMAIN=khachvip.online

# ========================================
# Multi-VPS Routing (REQUIRED)
# ========================================
# VPC internal IP of the ShopERP VPS (vanan-shop-a)
# nginx on this VPS proxies app.* + www.* traffic to this IP
SHOPERP_REMOTE_HOST=10.148.0.3

# ========================================
# Database (REQUIRED)
# ========================================
POSTGRES_DB=VanAnCoreHub
POSTGRES_USER=vanan_admin
POSTGRES_PASSWORD=CHANGE_THIS_USE_32CHAR_STRONG_PASSWORD

# ========================================
# Auth (REQUIRED)
# ========================================
JWT_SECRET_KEY=CHANGE_THIS_USE_256BIT_RANDOM_KEY

# ========================================
# Logging (REQUIRED)
# ========================================
SEQ_ADMIN_PASSWORD=CHANGE_THIS_USE_STRONG_PASSWORD

# ========================================
# Docker Images (optional — defaults shown)
# ========================================
# IMAGE_PREFIX=ghcr.io/anlebao
# IMAGE_TAG=latest

# ========================================
# Internal API Key (service-to-service)
# ========================================
INTERNAL_LOYALTY_API_KEY=vanan-internal-loyalty-prod-2026

# ========================================
# Web Push VAPID (for KhachLink notifications)
# ========================================
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE

# ========================================
# Google OAuth (for KhachLink login)
# ========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ========================================
# KhachLink Multi-Profile R1 (optional — default OFF)
# ========================================
# Set to true to enable multi-domain routing + profile-based NavFlags.
# OFF = no-op (existing KhachLink behavior unchanged — all nav flags = true FullCommerce default)
# ON  = KhachLink runtime fetches instance config by Host header via Gateway API
KHACHLINK_MULTIPROFILE_ENABLED=false
