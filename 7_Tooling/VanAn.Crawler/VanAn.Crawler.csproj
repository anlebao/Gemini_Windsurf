<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VanAn.Crawler</RootNamespace>
    <AssemblyName>VanAn.Crawler</AssemblyName>
    <!-- Standalone worker — NO ProjectReference to 1_Shared, 3_CoreHub, or any Gateway/ShopERP project.
         Talks to Gateway via HTTP only. Layer boundary enforced by ArchitectureRulesTests. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\crawler-sources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
