@page
@using VanAn.Shared.Domain
@model VanAn.ShopERP.Pages.LoginModel
@{
    ViewData["Title"] = "Đăng nhập - ShopERP";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        .login-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 420px;
            width: 100%;
            padding: 2.5rem;
        }
        .login-logo {
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            font-size: 2rem;
            color: #fff;
        }
        .login-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a202c;
            text-align: center;
            margin-bottom: 0.25rem;
        }
        .login-subtitle {
            font-size: 0.875rem;
            color: #718096;
            text-align: center;
            margin-bottom: 2rem;
        }
        .form-control-lg-custom {
            height: 48px;
            border-radius: 8px;
            border: 2px solid #e2e8f0;
            font-size: 1rem;
            transition: border-color 0.2s;
        }
        .form-control-lg-custom:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.15);
        }
        .input-group-text {
            border: 2px solid #e2e8f0;
            border-right: none;
            border-radius: 8px 0 0 8px;
            background: #f7fafc;
            color: #a0aec0;
        }
        .input-group .form-control-lg-custom {
            border-left: none;
            border-radius: 0 8px 8px 0;
        }
        .btn-login {
            height: 48px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border: none;
            transition: transform 0.1s, box-shadow 0.2s;
        }
        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(102,126,234,0.4);
        }
        .btn-login:active {
            transform: translateY(0);
        }
        .remember-me {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            user-select: none;
        }
        .remember-me input {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #667eea;
        }
        .alert-error {
            border-radius: 8px;
            border: none;
            background: #fed7d7;
            color: #c53030;
            font-size: 0.875rem;
        }
        .demo-hint {
            background: #ebf8ff;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-size: 0.8rem;
            color: #2c5282;
            margin-top: 1.5rem;
        }
        .demo-hint code {
            background: #bfdbfe;
            padding: 1px 6px;
            border-radius: 4px;
            font-size: 0.75rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <i class="bi bi-shop"></i>
        </div>
        <h1 class="login-title">Vạn An ShopERP</h1>
        <p class="login-subtitle">Hệ thống quản lý cửa hàng Vạn An</p>

        <form method="post" aria-label="Đăng nhập ShopERP">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="username" class="form-label fw-semibold">Tên đăng nhập</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input id="username" name="username" type="text" required
                           aria-label="Tên đăng nhập"
                           class="form-control form-control-lg-custom"
                           placeholder="Nhập tên đăng nhập"
                           value="@Model?.Username"
                           autofocus>
                </div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label fw-semibold">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input id="password" name="password" type="password" required
                           aria-label="Mật khẩu"
                           class="form-control form-control-lg-custom"
                           placeholder="Nhập mật khẩu">
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="remember-me">
                    <input type="checkbox" name="rememberMe" value="true">
                    <span>Ghi nhớ đăng nhập</span>
                </label>
            </div>

            <button type="submit"
                    aria-label="Đăng nhập"
                    class="btn btn-primary btn-login w-100">
                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
            </button>

            @if (!ModelState.IsValid)
            {
                <div class="alert alert-error mt-3" role="alert">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="mb-0">@error.ErrorMessage</p>
                    }
                </div>
            }
        </form>

        <div class="demo-hint">
            <i class="bi bi-info-circle me-1"></i>
            <strong>Tài khoản demo:</strong><br />
            Owner: <code>adminvanan1</code> / Staff: <code>staff@vanan.vn</code><br />
            Masterchef: <code>bep@vanan.vn</code> / Guard: <code>baove@vanan.vn</code>
        </div>
    </div>
</body>
</html>
