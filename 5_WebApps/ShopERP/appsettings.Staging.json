{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "${STAGING_DB_CONNECTION_STRING}"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET_MIN_32_CHARS}",
    "Issuer": "VanAnShopERP",
    "Audience": "VanAnApi"
  },
  "ViettelConfig": {
    "BaseUrl": "${VIETTEL_EINVOICE_STAGING_URL}",
    "Username": "${VIETTEL_EINVOICE_STAGING_USER}",
    "Password": "${VIETTEL_EINVOICE_STAGING_PASS}",
    "TaxCode": "${VIETTEL_EINVOICE_TAX_CODE}",
    "TemplateCode": "${VIETTEL_EINVOICE_TEMPLATE_CODE}",
    "SerialNumber": "${VIETTEL_EINVOICE_SERIAL_NUMBER}"
  },
  "MisaConfig": {
    "BaseUrl": "${MISA_EINVOICE_STAGING_URL}",
    "AppId": "${MISA_EINVOICE_APP_ID}",
    "ApiKey": "${MISA_EINVOICE_API_KEY}",
    "CompanyCode": "${MISA_EINVOICE_COMPANY_CODE}",
    "Username": "${MISA_EINVOICE_STAGING_USER}",
    "Password": "${MISA_EINVOICE_STAGING_PASS}",
    "InvoiceSeries": "${MISA_EINVOICE_INVOICE_SERIES}"
  }
}
