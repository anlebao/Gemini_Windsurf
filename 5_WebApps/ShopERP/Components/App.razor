<body>
    <Routes />
    <!-- Phase 1 Scaling: Blazor circuit reconnect UI — toast for reconnecting/failed, modal for rejected.
         Was full-screen modal for all states → che hết UI, gây phiền user trên trang không-realtime.
         Now: toast nhỏ góc phải dưới cho "reconnecting"/"failed", modal to chỉ cho "rejected" (phiên hết hạn). -->
    <div id="components-reconnect-modal" class="reconnect-toast">
        <div class="reconnect-toast-content">
            <span class="reconnect-icon">&#x21BB;</span>
            <span class="reconnect-status components-reconnect-show">Đang kết nối lại…</span>
            <span class="reconnect-status components-reconnect-failed">Không thể kết nối lại. <button onclick="location.reload()" class="vanan-button vanan-button--primary vanan-button--small">Tải lại</button></span>
            <span class="reconnect-status components-reconnect-rejected">Phiên đã hết hạn. <button onclick="location.reload()" class="vanan-button vanan-button--primary vanan-button--small">Tải lại</button></span>
        </div>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <!-- Phase 2 Scaling: Circuit keepalive ping 10s — giữ circuit sống qua proxy idle timeout -->
    <script src="js/circuit-keepalive.js"></script>
    <!-- Admin Mobile PWA: SW registration + update toast (SRI-deadlock fix — port KhachLink pwa.js) -->
    <script src="js/pwa.js"></script>
    <script>
        if (window.vananPWA && typeof window.vananPWA.registerServiceWorker === 'function') {
            window.vananPWA.registerServiceWorker();
        }
    </script>
    <script>
        // Reads current DOM values for the given element ids. Used as a robust
        // fallback for collecting form data at submit time, independent of binding timing.
        window.vananReadElementValue = function (id) {
            var el = document.getElementById(id);
            if (!el) return '';
            if (el.type === 'checkbox') return el.checked ? 'true' : 'false';
            return el.value ?? '';
        };
        // Currency auto-format: strips non-digits, formats with vi-VN thousands separator ("."),
        // preserves cursor position at end (user always types at end for amount entry).
        // Called from DynamicFormFields FormatCurrencyField via JS interop to bypass
        // Blazor @@bind + @@bind:after DOM-push limitation.
        window.vananFormatCurrencyInput = function (id) {
            var el = document.getElementById(id);
            if (!el) return '';
            var raw = (el.value || '').replace(/\D/g, '');
            if (raw === '') {
                el.value = '';
                return '';
            }
            // Format with vi-VN thousands separator (".")
            var formatted = parseInt(raw, 10).toLocaleString('vi-VN');
            el.value = formatted;
            // Move cursor to end — amount entry is always append-at-end
            el.setSelectionRange(formatted.length, formatted.length);
            return formatted;
        };
        // Attach a client-side input event listener that formats the currency value
        // instantly on the client (no Blazor Server round-trip delay). The Blazor
        // @@oninput handler still fires server-side to update field.Value, but the DOM
        // formatting happens here first.
        window.vananAttachCurrencyFormatter = function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (el.dataset.vananCurrencyAttached) return; // idempotent
            el.dataset.vananCurrencyAttached = 'true';
            el.addEventListener('input', function () {
                var raw = (el.value || '').replace(/\D/g, '');
                if (raw === '') {
                    el.value = '';
                    return;
                }
                var formatted = parseInt(raw, 10).toLocaleString('vi-VN');
                el.value = formatted;
                // Move cursor to end
                el.setSelectionRange(formatted.length, formatted.length);
            });
        };
        // Task G2 (fix "Áp vào form"): ghi giá trị từ server vào DOM cho field DynamicFormFields —
        // Blazor drop DOM sync qua component boundary (bug class đã ghi trong DynamicFormFields).
        // Format currency vi-VN nếu field đã attach formatter (amount hiển thị "2.000.000").
        window.vananSetElementValue = function (id, value) {
            var el = document.getElementById(id);
            if (!el) return;
            el.value = (value == null ? '' : String(value));
            if (el.dataset.vananCurrencyAttached) {
                window.vananFormatCurrencyInput(id);
            }
        };
        // Task G2 (chống click rớt Blazor Server): đánh dấu container đã interactive —
        // các nút SmartEntryBar disabled tới khi circuit sẵn sàng (pattern data-blazor-interactive).
        window.vananMarkInteractive = function (id) {
            var el = document.getElementById(id);
            if (el) el.setAttribute('data-blazor-interactive', 'true');
        };
        // Task G3: gộp nhiều field vào 1 interop call (rút ngắn cửa sổ circuit busy của Blazor Server)
        // — set từng field + format currency. Nhận diện currency bằng inputmode="numeric" HOẶC
        // dataset flag (flag bị Blazor re-render xoá flicker — không tin cậy được).
        window.vananSetFormValues = function (fields) {
            if (!fields) return;
            for (var id in fields) {
                if (!Object.prototype.hasOwnProperty.call(fields, id)) continue;
                var el = document.getElementById(id);
                if (!el) continue;
                el.value = (fields[id] == null ? '' : String(fields[id]));
                if (el.dataset.vananCurrencyAttached || el.getAttribute('inputmode') === 'numeric') {
                    window.vananFormatCurrencyInput(id);
                }
            }
        };
        // G4f: session multi qua FULL PAGE RELOAD (menu/href = circuit mới → scoped mất).
        // sessionStorage sống qua reload cùng tab → page đích đọc lại câu gốc và re-parse.
        // PH3: lưu kèm multi JSON + processed indices — khôi phục DETERMINISTIC (không re-parse LLM).
        window.vananSaveSmartText = function (t, multiJson, processed) {
            try {
                sessionStorage.setItem('vanan.smartEntryText', t || '');
                if (multiJson) { sessionStorage.setItem('vanan.smartEntryMulti', multiJson); }
                else { sessionStorage.removeItem('vanan.smartEntryMulti'); }
                if (processed && Array.isArray(processed)) { sessionStorage.setItem('vanan.smartEntryProcessed', JSON.stringify(processed)); }
                else { sessionStorage.removeItem('vanan.smartEntryProcessed'); }
            } catch (e) { }
        };
        window.vananLoadSmartText = function () { try { return sessionStorage.getItem('vanan.smartEntryText') || ''; } catch (e) { return ''; } };
        window.vananLoadSmartMulti = function () { try { return sessionStorage.getItem('vanan.smartEntryMulti') || ''; } catch (e) { return ''; } };
        window.vananLoadSmartProcessed = function () {
            try {
                var raw = sessionStorage.getItem('vanan.smartEntryProcessed');
                if (!raw) return [];
                var arr = JSON.parse(raw);
                return Array.isArray(arr) ? arr.filter(function (x) { return Number.isInteger(x); }) : [];
            } catch (e) { return []; }
        };
        window.vananClearSmartText = function () {
            try {
                sessionStorage.removeItem('vanan.smartEntryText');
                sessionStorage.removeItem('vanan.smartEntryMulti');
                sessionStorage.removeItem('vanan.smartEntryProcessed');
            } catch (e) { }
        };
        // Wave 8: Download a base64-encoded file (DOCX/XLSX export from HKD book page).
        window.vanAn = window.vanAn || {};
        window.vanAn.downloadFile = function (base64, mimeType, fileName) {
            var byteChars = atob(base64);
            var byteNumbers = new Array(byteChars.length);
            for (var i = 0; i < byteChars.length; i++) {
                byteNumbers[i] = byteChars.charCodeAt(i);
            }
            var byteArray = new Uint8Array(byteNumbers);
            var blob = new Blob([byteArray], { type: mimeType });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };
        // #115: Print bill — triggers browser print dialog. "Save as PDF" option
        // appears if no physical printer is connected.
        window.vananPrintBill = function () {
            window.print();
        };
    </script>
    <!-- W3-T5: TTS reader for kitchen voice note playback -->
    <script src="js/tts-reader.js"></script>
    <!-- Tenant edit modal: Leaflet map picker for lat/lng (2026-07-21) -->
    <script src="js/tenant-map.js"></script>
    <!-- QR scanner for voucher fulfillment (RedemptionHistory.razor) -->
    <script src="js/qr-scanner.js"></script>
    <!-- #114 r2: POS voice note — Speech Recognition API (vi-VN) for staff dictation -->
    <script src="js/pos-voice-note.js"></script>
    <!-- #126: Guard Scanner camera + photo capture + QR generation interop -->
    <script src="js/guard-camera.js"></script>
    <!-- OCR Hub S2: OCR abstraction layer (configurable engine — Tesseract or PaddleOCR) -->
    <script src="js/ocr-hub.js"></script>
    <!-- OCR Onboarding S1/S4 (2026-10-25): document OCR (GPKD/biển hiệu/menu) + wizard interop -->
    <script src="js/onboarding-ocr.js"></script>
    <script src="js/onboarding-wizard.js"></script>
    <!-- Task PG: Smart Entry AI — mic input Web Speech API (vi-VN), fallback ẩn nút -->
    <script src="js/voucher-speech.js"></script>
    <!-- Realtime Platform P5: Leaflet (VanAnMap) + realtime.js (chat scroll + GPS) from the RCL -->
    <script src="_content/VanAn.UI.Platform/lib/leaflet/leaflet.js"></script>
    <script src="_content/VanAn.UI.Platform/js/realtime.js"></script>
    <style>
        /* Phase 1 Scaling: Blazor circuit reconnect UI — toast (small) for reconnecting/failed,
           modal (full-screen) only for rejected (session expired, must reload).
           Was full-screen modal for all states → che hết UI, gây phiền user trên trang không-realtime. */

        /* Toast: góc phải dưới, nhỏ gọn, không che UI */
        .reconnect-toast { display: none; position: fixed; bottom: 1rem; right: 1rem; z-index: 9999; }
        .reconnect-toast-content { background: #fef3c7; border: 1px solid #f59e0b; border-radius: 8px; padding: 0.75rem 1rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); display: flex; align-items: center; gap: 0.5rem; max-width: 360px; }
        .reconnect-icon { font-size: 1.25rem; color: #f59e0b; animation: spin 1s linear infinite; }
        @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .reconnect-status { display: none; color: #6b7280; font-size: 0.875rem; }
        .components-reconnect-show .reconnect-status.components-reconnect-show,
        .components-reconnect-failed .reconnect-status.components-reconnect-failed { display: inline; }

        /* Toast hiển thị cho show + failed (không che UI) */
        #components-reconnect-modal.components-reconnect-show,
        #components-reconnect-modal.components-reconnect-failed { display: block; }

        /* Rejected: chuyển sang modal full-screen (phiên hết hạn — cần reload, che UI OK) */
        #components-reconnect-modal.components-reconnect-rejected {
            display: flex !important;
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6); z-index: 9999;
            justify-content: center; align-items: center;
        }
        #components-reconnect-modal.components-reconnect-rejected .reconnect-toast-content {
            background: white; border-radius: 12px; padding: 2rem; text-align: center;
            max-width: 400px; box-shadow: 0 4px 24px rgba(0,0,0,0.2);
            flex-direction: column; gap: 1rem;
        }
        #components-reconnect-modal.components-reconnect-rejected .reconnect-icon { display: none; }
        #components-reconnect-modal.components-reconnect-rejected .reconnect-status.components-reconnect-rejected {
            display: block; font-size: 1rem; color: #1f2937;
        }
    </style>
</body>

</html>
