<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/pages.css" />
    <link rel="stylesheet" href="VanAn.ShopERP.styles.css" />
    <link rel="stylesheet" href="_content/VanAn.UI.Platform/VanAn.UI.Platform.bundle.scp.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <div id="components-reconnect-modal" class="reconnect-modal">
        <div class="reconnect-modal-content">
            <p class="reconnect-title">Kết nối bị gián đoạn</p>
            <p class="reconnect-status components-reconnect-show">Đang kết nối lại…</p>
            <p class="reconnect-status components-reconnect-failed">Không thể kết nối lại. <button onclick="location.reload()" class="vanan-button vanan-button--primary">Tải lại trang</button></p>
            <p class="reconnect-status components-reconnect-rejected">Phiên đã hết hạn. <button onclick="location.reload()" class="vanan-button vanan-button--primary">Tải lại trang</button></p>
        </div>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Reads current DOM values for the given element ids. Used as a robust
        // fallback for collecting form data at submit time, independent of binding timing.
        window.vananReadElementValue = function (id) {
            var el = document.getElementById(id);
            if (!el) return '';
            if (el.type === 'checkbox') return el.checked ? 'true' : 'false';
            return el.value ?? '';
        };
        // Wave 8: Download a base64-encoded file (DOCX/XLSX export from HKD book page).
        window.vanAn = window.vanAn || {};
        window.vanAn.downloadFile = function (base64, mimeType, fileName) {
            var byteChars = atob(base64);
            var byteNumbers = new Array(byteChars.length);
            for (var i = 0; i < byteChars.length; i++) {
                byteNumbers[i] = byteChars.charCodeAt(i);
            }
            var byteArray = new Uint8Array(byteNumbers);
            var blob = new Blob([byteArray], { type: mimeType });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };
        // #115: Print bill — triggers browser print dialog. "Save as PDF" option
        // appears if no physical printer is connected.
        window.vananPrintBill = function () {
            window.print();
        };
    </script>
    <!-- W3-T5: TTS reader for kitchen voice note playback -->
    <script src="js/tts-reader.js"></script>
    <!-- Tenant edit modal: Leaflet map picker for lat/lng (2026-07-21) -->
    <script src="js/tenant-map.js"></script>
    <!-- QR scanner for voucher fulfillment (RedemptionHistory.razor) -->
    <script src="js/qr-scanner.js"></script>
    <!-- #114 r2: POS voice note — Speech Recognition API (vi-VN) for staff dictation -->
    <script src="js/pos-voice-note.js"></script>
    <!-- #126: Guard Scanner camera + photo capture + QR generation interop -->
    <script src="js/guard-camera.js"></script>
    <!-- OCR Hub S2: OCR abstraction layer (configurable engine — Tesseract or PaddleOCR) -->
    <script src="js/ocr-hub.js"></script>
    <style>
        /* #130: Blazor circuit reconnect UI — shows when SignalR connection drops */
        .reconnect-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 9999; justify-content: center; align-items: center; }
        .reconnect-modal-content { background: white; border-radius: 12px; padding: 2rem; text-align: center; max-width: 400px; box-shadow: 0 4px 24px rgba(0,0,0,0.2); }
        .reconnect-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; color: #1f2937; }
        .reconnect-status { display: none; color: #6b7280; margin: 0.5rem 0; }
        .components-reconnect-show .reconnect-status.components-reconnect-show,
        .components-reconnect-failed .reconnect-status.components-reconnect-failed,
        .components-reconnect-rejected .reconnect-status.components-reconnect-rejected { display: block; }
        #components-reconnect-modal.components-reconnect-show,
        #components-reconnect-modal.components-reconnect-failed,
        #components-reconnect-modal.components-reconnect-rejected { display: flex; }
    </style>
</body>

</html>
