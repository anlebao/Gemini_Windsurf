@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager

<CascadingAuthenticationState>
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <AuthorizeView>
                    <Authorized>
                        <span class="text-muted me-3">
                            <i class="bi bi-person-circle"></i>
                            @context.User.Identity?.Name
                        </span>
                        <a href="/Logout" class="btn btn-outline-danger btn-sm" title="Đăng xuất">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/Login" class="btn btn-primary btn-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <AuthorizeView>
                <Authorized>
                    @if (context.User.FindFirst("impersonating")?.Value == "true")
                    {
                        var tenantName = context.User.FindFirst("impersonated_tenant_name")?.Value ?? "unknown";
                        <div class="impersonation-banner" data-testid="impersonation-banner">
                            <span>
                                <i class="bi bi-person-badge"></i>
                                Đang truy cập với tư cách tenant: <strong>@tenantName</strong>
                            </span>
                            <a href="/ExitImpersonate" class="btn btn-warning btn-sm ms-2" data-testid="btn-exit-impersonation">
                                <i class="bi bi-box-arrow-left"></i> Thoát impersonation
                            </a>
                        </div>
                    }
                </Authorized>
            </AuthorizeView>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
</CascadingAuthenticationState>
