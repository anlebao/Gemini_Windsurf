@using Microsoft.AspNetCore.Components.Authorization
@using VanAn.Shared.Domain

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">VanAn.ShopERP</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        @* Home: Masterchef -> /kitchen, all others -> /sitemap (main hub) *@
        <AuthorizeView Roles="Masterchef">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="kitchen" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Staff,StoreKeeper,Owner,Guard,Admin,SystemAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="sitemap" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* == Vận hành == Staff, StoreKeeper, Owner *@
        <AuthorizeView Roles="Staff,StoreKeeper,Owner">
            <Authorized>
                <div class="nav-section-label px-3 mt-2 mb-1 text-uppercase fw-bold small text-muted">Vận hành</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="pos">
                        <span class="bi bi-bag-fill-nav-menu" aria-hidden="true"></span> POS
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="kitchen">
                        <span class="bi bi-fire-nav-menu" aria-hidden="true"></span> Bếp
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="orders">
                        <span class="bi bi-list-check-nav-menu" aria-hidden="true"></span> Đơn hàng
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Masterchef: Kitchen ONLY *@
        <AuthorizeView Roles="Masterchef">
            <Authorized>
                <div class="nav-section-label px-3 mt-2 mb-1 text-uppercase fw-bold small text-muted">Bếp</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="kitchen">
                        <span class="bi bi-fire-nav-menu" aria-hidden="true"></span> Bếp
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* == Sản phẩm & Kế Toán == Owner only *@
        <AuthorizeView Roles="Owner">
            <Authorized>
                <div class="nav-section-label px-3 mt-2 mb-1 text-uppercase fw-bold small text-muted">Sản phẩm</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="products">
                        <span class="bi bi-box-seam-nav-menu" aria-hidden="true"></span> Sản phẩm
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/featured-products">
                        <span class="bi bi-star-nav-menu" aria-hidden="true"></span> Sản phẩm nổi bật
                    </NavLink>
                </div>

                <div class="nav-section-label px-3 mt-2 mb-1 text-uppercase fw-bold small text-muted">Kế Toán</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting">
                        <span class="bi bi-journal-text-nav-menu" aria-hidden="true"></span> Kế Toán
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/history">
                        <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Lịch Sử Giao Dịch
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/balance">
                        <span class="bi bi-currency-exchange-nav-menu" aria-hidden="true"></span> Số Dư Tài Khoản
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/period-closing">
                        <span class="bi bi-lock-fill-nav-menu" aria-hidden="true"></span> Đóng Kỳ Kế Toán
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* == Hóa Đơn Điện Tử == Owner, StoreKeeper, SystemAdmin *@
        <AuthorizeView Roles="Owner,StoreKeeper,SystemAdmin">
            <Authorized>
                <div class="nav-section-label px-3 mt-2 mb-1 text-uppercase fw-bold small text-muted">Hóa Đơn Điện Tử</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice">
                        <span class="bi bi-file-earmark-text-nav-menu" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice/invoices">
                        <span class="bi bi-receipt-nav-menu" aria-hidden="true"></span> Quản Lý Hóa Đơn
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice/alerts">
                        <span class="bi bi-bell-nav-menu" aria-hidden="true"></span> Quản Lý Cảnh Báo
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice/health">
                        <span class="bi bi-heart-pulse-nav-menu" aria-hidden="true"></span> Health Monitoring
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* E-Invoice Provider Config: Owner + SystemAdmin *@
        <AuthorizeView Roles="Owner,SystemAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice/providers">
                        <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Quản Lý Provider
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice/configuration">
                        <span class="bi bi-sliders-nav-menu" aria-hidden="true"></span> Cấu Hình Provider
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* == CRM & Loyalty == Owner only (per-tenant) *@
        <AuthorizeView Roles="Owner">
            <Authorized>
                <div class="nav-section-label px-3 mt-2 mb-1 text-uppercase fw-bold small text-muted">CRM &amp; Loyalty</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/customers">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Khách hàng (CRM)
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/promo-campaigns">
                        <span class="bi bi-megaphone-fill-nav-menu" aria-hidden="true"></span> Chiến dịch khuyến mãi
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/missions">
                        <span class="bi bi-trophy-fill-nav-menu" aria-hidden="true"></span> Quản lý Nhiệm vụ
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/redemption-catalog">
                        <span class="bi bi-gift-fill-nav-menu" aria-hidden="true"></span> Đổi điểm (Catalog)
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/redemption-history">
                        <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Lịch sử đổi điểm
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* == Loyalty Dashboard == Owner + SystemAdmin *@
        <AuthorizeView Roles="Owner,SystemAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="loyalty/dashboard">
                        <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span> Thống kê điểm thưởng
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* == Quản trị == Owner only (HR) *@
        <AuthorizeView Roles="Owner">
            <Authorized>
                <div class="nav-section-label px-3 mt-2 mb-1 text-uppercase fw-bold small text-muted">Quản trị</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/users">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Quản lý người dùng
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/permission-groups">
                        <span class="bi bi-person-lock-nav-menu" aria-hidden="true"></span> Nhóm quyền
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* == Quản trị Hệ thống == SystemAdmin only *@
        <AuthorizeView Roles="SystemAdmin">
            <Authorized>
                <div class="nav-section-label px-3 mt-2 mb-1 text-uppercase fw-bold small text-muted">Hệ thống</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/tenants">
                        <span class="bi bi-building-nav-menu" aria-hidden="true"></span> Quản lý Tenant
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/shop-instances">
                        <span class="bi bi-hdd-network-nav-menu" aria-hidden="true"></span> ShopERP Instances
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/users">
                        <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Quản lý Người Dùng
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/permission-groups">
                        <span class="bi bi-person-lock-nav-menu" aria-hidden="true"></span> Nhóm quyền
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/audit-trail">
                        <span class="bi bi-shield-check-nav-menu" aria-hidden="true"></span> Nhật Ký Audit
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/featured-products">
                        <span class="bi bi-star-nav-menu" aria-hidden="true"></span> Sản phẩm nổi bật
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/community/admin-panel">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Quản lý cộng tác viên
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/community/fraud-flags">
                        <span class="bi bi-shield-exclamation-nav-menu" aria-hidden="true"></span> Fraud Review
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/community/fraud-stats">
                        <span class="bi bi-graph-up-arrow-nav-menu" aria-hidden="true"></span> Fraud Stats
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/product-referral-configs">
                        <span class="bi bi-diagram-3-nav-menu" aria-hidden="true"></span> Referral Configs
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/commerce-mode">
                        <span class="bi bi-toggle2-on-nav-menu" aria-hidden="true"></span> Commerce Mode
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/valcn-features">
                        <span class="bi bi-toggles-nav-menu" aria-hidden="true"></span> VALCN v2.0 Features
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/community-fund">
                        <span class="bi bi-piggy-bank-nav-menu" aria-hidden="true"></span> Quỹ Cộng Đồng
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/product-cost-prices">
                        <span class="bi bi-tag-nav-menu" aria-hidden="true"></span> Giá Vốn SP
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/collaborator-verification">
                        <span class="bi bi-phone-nav-menu" aria-hidden="true"></span> SMS OTP Toggle
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/khachlink-home-settings">
                        <span class="bi bi-sliders2-vertical-nav-menu" aria-hidden="true"></span> Cấu hình KhachLink
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* == CRM & Loyalty (Cross-tenant) == SystemAdmin only *@
        <AuthorizeView Roles="SystemAdmin">
            <Authorized>
                <div class="nav-section-label px-3 mt-2 mb-1 text-uppercase fw-bold small text-muted">CRM &amp; Loyalty</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/customers-global">
                        <span class="bi bi-globe-nav-menu" aria-hidden="true"></span> Cross-Tenant Overview
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/customers">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Khách hàng (CRM)
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/promo-campaigns">
                        <span class="bi bi-megaphone-fill-nav-menu" aria-hidden="true"></span> Chiến dịch khuyến mãi
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/push-campaigns">
                        <span class="bi bi-bell-fill-nav-menu" aria-hidden="true"></span> Push Campaigns
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/campaigns">
                        <span class="bi bi-megaphone-nav-menu" aria-hidden="true"></span> Khuyến mãi (Social)
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/missions">
                        <span class="bi bi-trophy-fill-nav-menu" aria-hidden="true"></span> Quản lý Nhiệm vụ
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/redemption-catalog">
                        <span class="bi bi-gift-nav-menu" aria-hidden="true"></span> Đổi điểm (Catalog)
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/redemption-history">
                        <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Lịch sử đổi điểm
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/loyalty-config">
                        <span class="bi bi-award-fill-nav-menu" aria-hidden="true"></span> Loyalty Alliance Config
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* == Loyalty Dashboard (mobile) == Owner + SystemAdmin *@
        <AuthorizeView Roles="Owner,SystemAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="loyalty/dashboard">
                        <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span> Thống kê điểm thưởng
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Guard section: Guard role only *@
        <AuthorizeView Roles="Guard">
            <Authorized>
                <div class="nav-section-label px-3 mt-2 mb-1 text-uppercase fw-bold small text-muted">Guard</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="guard/scan">
                        <span class="bi bi-qr-code-scan-nav-menu" aria-hidden="true"></span> Quét QR Guard
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Logout: visible to all authenticated users *@
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-auto border-top pt-2">
                    <a class="nav-link text-danger" href="/Logout" title="Đăng xuất">
                        <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Đăng xuất
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>