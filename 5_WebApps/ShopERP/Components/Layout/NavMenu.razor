@using Microsoft.AspNetCore.Components.Authorization
@using VanAn.Shared.Domain

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">VanAn.ShopERP</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        @* Home: Masterchef → /kitchen, all others → /sitemap (main hub) *@
        <AuthorizeView Roles="Masterchef">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="kitchen" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Staff,StoreKeeper,Owner,Guard,Admin,SystemAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="sitemap" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* T14: POS + Kitchen + Orders — Staff, StoreKeeper, Owner (NOT Masterchef — kitchen-only role) *@
        <AuthorizeView Roles="Staff,StoreKeeper,Owner">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="pos">
                        <span class="bi bi-bag-fill-nav-menu" aria-hidden="true"></span> POS
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="kitchen">
                        <span class="bi bi-fire-nav-menu" aria-hidden="true"></span> Bếp
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="orders">
                        <span class="bi bi-list-check-nav-menu" aria-hidden="true"></span> Đơn hàng
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Masterchef: Kitchen ONLY — no POS, no Orders, no other pages *@
        <AuthorizeView Roles="Masterchef">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="kitchen">
                        <span class="bi bi-fire-nav-menu" aria-hidden="true"></span> Bếp
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Accounting: Owner only *@
        <AuthorizeView Roles="Owner">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="products">
                        <span class="bi bi-box-seam-nav-menu" aria-hidden="true"></span> Sản phẩm
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting">
                        <span class="bi bi-journal-text-nav-menu" aria-hidden="true"></span> Kế Toán
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/history">
                        <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Lịch Sử Giao Dịch
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/balance">
                        <span class="bi bi-currency-exchange-nav-menu" aria-hidden="true"></span> Số Dư Tài Khoản
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/period-closing">
                        <span class="bi bi-lock-fill-nav-menu" aria-hidden="true"></span> Đóng Kỳ Kế Toán
                    </NavLink>
                </div>
                @* Wave 6: User & RBAC Management — Owner only *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/users">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Quản lý người dùng
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/permission-groups">
                        <span class="bi bi-person-lock-nav-menu" aria-hidden="true"></span> Nhóm quyền
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* E-Invoice: Owner + StoreKeeper + SystemAdmin (cross-tenant view) *@
        <AuthorizeView Roles="Owner,StoreKeeper,SystemAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice">
                        <span class="bi bi-file-earmark-text-nav-menu" aria-hidden="true"></span> Hóa Đơn Điện Tử
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice/invoices">
                        <span class="bi bi-receipt-nav-menu" aria-hidden="true"></span> Quản Lý Hóa Đơn
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice/alerts">
                        <span class="bi bi-bell-nav-menu" aria-hidden="true"></span> Quản Lý Cảnh Báo
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice/health">
                        <span class="bi bi-heart-pulse-nav-menu" aria-hidden="true"></span> Health Monitoring
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* E-Invoice Provider Config: Owner + SystemAdmin *@
        <AuthorizeView Roles="Owner,SystemAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice/providers">
                        <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Quản Lý Provider
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="einvoice/configuration">
                        <span class="bi bi-sliders-nav-menu" aria-hidden="true"></span> Cấu Hình Provider
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Admin / Audit: Admin + SystemAdmin role *@
        <AuthorizeView Roles="Admin,SystemAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/audit-trail">
                        <span class="bi bi-shield-check-nav-menu" aria-hidden="true"></span> Nhật Ký Audit
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Wave 5: Tenant Management — SystemAdmin only (platform-level admin) *@
        <AuthorizeView Roles="SystemAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/tenants">
                        <span class="bi bi-building-nav-menu" aria-hidden="true"></span> Quản lý Tenant
                    </NavLink>
                </div>
                @* Phase 6: ShopERP Instances management (SystemAdmin only) *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/shop-instances">
                        <span class="bi bi-hdd-network-nav-menu" aria-hidden="true"></span> ShopERP Instances
                    </NavLink>
                </div>
                @* Phase 6: Featured Products management (SystemAdmin only) *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/featured-products">
                        <span class="bi bi-star-nav-menu" aria-hidden="true"></span> Sản phẩm nổi bật
                    </NavLink>
                </div>
                @* Campaigns management (SystemAdmin only) — KhachLink Home personalization + CRUD *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/campaigns">
                        <span class="bi bi-megaphone-nav-menu" aria-hidden="true"></span> Khuyến mãi
                    </NavLink>
                </div>
                @* Loyalty-B: Redemption system (SystemAdmin only) — catalog + history *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/redemption-catalog">
                        <span class="bi bi-gift-nav-menu" aria-hidden="true"></span> Đổi điểm (Catalog)
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/redemption-history">
                        <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Lịch sử đổi điểm
                    </NavLink>
                </div>
                @* Shops admin removed 2026-07-21 — Shop entity deleted, Tenant is single identity. *@
                @* User Management — SystemAdmin can manage all users across tenants *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/users">
                        <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Quản lý Người Dùng
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Guard section: Guard role only *@
        <AuthorizeView Roles="Guard">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="guard/scan">
                        <span class="bi bi-qr-code-scan-nav-menu" aria-hidden="true"></span> Quét QR Guard
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Logout: visible to all authenticated users *@
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-auto border-top pt-2">
                    <a class="nav-link text-danger" href="/Logout" title="Đăng xuất">
                        <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Đăng xuất
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>
