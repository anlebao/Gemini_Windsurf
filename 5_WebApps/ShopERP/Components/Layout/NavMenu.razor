@using Microsoft.AspNetCore.Components.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.ShopERP.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IShopErpMenuService MenuService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">VanAn.ShopERP</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <VanANavigation MenuItems="@_menuItems" />
</div>

@code {
    private List<VanAn.UI.Platform.Models.NavigationItem> _menuItems = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        // SSOT menu: same definition per role as AdminLayout/AccountingLayout/EInvoiceLayout.
        _menuItems = await MenuService.BuildAsync(authState.User);
    }
}
