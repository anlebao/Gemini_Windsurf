@* UserHeader Component — hiển thị tenant name + username + role + logout trong layout header *@
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using VanAn.CoreHub.Services
@using VanAn.Shared.Domain.Common
@using VanAn.ShopERP.Services
@implements IDisposable

<div class="user-header">
    @if (!string.IsNullOrEmpty(_tenantName))
    {
        <div class="user-header__tenant">
            <i class="bi bi-shop"></i>
            <span class="user-header__tenant-name">@_tenantName</span>
        </div>
    }
    @if (_hasTenant)
    {
        <a href="/notifications" class="user-header__bell" aria-label="Thông báo" title="Thông báo">
            <i class="bi bi-bell"></i>
            @if (_unreadCount > 0)
            {
                <span class="user-header__bell-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
            }
        </a>
    }
    <div class="user-header__info">
        <i class="bi bi-person-circle user-header__icon"></i>
        <span class="user-header__name">@_displayName</span>
        @if (!string.IsNullOrEmpty(_role))
        {
            <span class="user-header__role-badge">@_role</span>
        }
    </div>
    <a href="/Logout" class="user-header__logout" aria-label="Đăng xuất">
        <i class="bi bi-box-arrow-right"></i>
        <span>Đăng xuất</span>
    </a>
</div>

<style>
    .user-header {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
        padding: 0.5rem 1rem;
        height: 100%;
    }
    .user-header__tenant {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        padding: 4px 10px;
        background: rgba(0, 123, 255, 0.1);
        border-radius: 6px;
        font-size: 0.85rem;
        color: var(--vanan-primary, #007bff);
        font-weight: 600;
    }
    .user-header__tenant-name {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .user-header__info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .user-header__icon {
        font-size: 1.25rem;
        color: var(--vanan-primary, #007bff);
    }
    .user-header__name {
        font-weight: 600;
        font-size: 0.95rem;
    }
    .user-header__role-badge {
        background: var(--vanan-primary, #007bff);
        color: white;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .user-header__bell {
        position: relative;
        display: flex;
        align-items: center;
        color: var(--vanan-primary, #007bff);
        font-size: 1.15rem;
        text-decoration: none;
        padding: 4px 6px;
        border-radius: 4px;
        transition: background 0.2s;
    }
    .user-header__bell:hover {
        background: rgba(0, 123, 255, 0.1);
    }
    .user-header__bell-badge {
        position: absolute;
        top: -2px;
        right: -4px;
        background: var(--vanan-danger, #dc3545);
        color: white;
        font-size: 0.68rem;
        font-weight: 700;
        min-width: 17px;
        height: 17px;
        line-height: 17px;
        text-align: center;
        border-radius: 10px;
        padding: 0 4px;
    }
    .user-header__logout {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--vanan-danger, #dc3545);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        padding: 4px 8px;
        border-radius: 4px;
        transition: background 0.2s;
    }
    .user-header__logout:hover {
        background: rgba(220, 53, 69, 0.1);
    }
    @@media (max-width: 768px) {
        .user-header__tenant-name {
            max-width: 120px;
        }
        .user-header__name {
            font-size: 0.85rem;
        }
    }
</style>

@code {
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private VanAn.CoreHub.Infrastructure.VanAnDbContext PgDbContext { get; set; } = null!;
    [Inject] private NotificationApiClient NotificationApi { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    private string _displayName = string.Empty;
    private string _role = string.Empty;
    private string _tenantName = string.Empty;
    private Guid _tenantId = Guid.Empty;
    private bool _hasTenant;
    private int _unreadCount;
    private bool _isDisposed;
    private System.Threading.Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _displayName = user.FindFirst(ClaimTypes.Name)?.Value
                ?? user.Identity?.Name
                ?? "Unknown";

            _role = user.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;

            // Resolve tenant name from JWT claim (tenant_id or TenantId).
            // Fix 2026-10-09 (root cause: TenantManagementService nhận IVanAnDbContext = SQLite mirror 5 tenant cũ)
            // → đọc TRỰC TIẾP từ PG (source of truth). Không xác định đúng TenantId → giữ chuỗi gốc.
            var tenantClaim = user.FindFirst("tenant_id")?.Value
                ?? user.FindFirst("TenantId")?.Value;
            if (Guid.TryParse(tenantClaim, out var tenantId) && tenantId != Guid.Empty)
            {
                _tenantId = tenantId;
                _hasTenant = true;
                try
                {
                    var tenant = await PgDbContext.Tenants
                        .IgnoreQueryFilters()
                        .AsNoTracking()
                        .FirstOrDefaultAsync(t => t.Id == new TenantId(tenantId));
                    _tenantName = tenant?.Name ?? string.Empty;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error resolving tenant name: {ex.Message}");
                }
            }
        }

        if (_hasTenant)
        {
            await RefreshUnreadAsync();
            // Poll fallback — badge luôn cập nhật kể cả khi miss realtime event.
            _pollTimer = new System.Threading.Timer(async _ => await RefreshUnreadAsync(), null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
            // Refresh khi chuyển trang (sau khi mark-read trên /notifications).
            NavigationManager.LocationChanged += OnLocationChanged;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(RefreshUnreadAsync);
    }

    private async Task RefreshUnreadAsync()
    {
        if (_isDisposed || !_hasTenant) return;
        try
        {
            int count = await NotificationApi.GetUnreadCountAsync();
            if (_unreadCount != count)
            {
                _unreadCount = count;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Gateway không truy cập được — giữ badge cũ (không làm hỏng header).
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
        _pollTimer?.Dispose();
    }
}
