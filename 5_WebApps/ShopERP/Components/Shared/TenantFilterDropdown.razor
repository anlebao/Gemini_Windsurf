@* TenantFilterDropdown — SystemAdmin tenant selector for cross-tenant admin pages.
   3 states:
   1. "---Lọc dữ liệu---" (EMPTY) — default, page shows no data
   2. Specific tenant — page shows data for that tenant only
   3. "Tất cả" (ALL) — last option, page shows all data across tenants
   For non-SystemAdmin users, this component is hidden (they see their own tenant). *@
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@using VanAn.Shared.Domain.Common
@using VanAn.ShopERP.Services
@inject TenantApiClient TenantApi
@inject ITenantProvider TenantProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<TenantFilterDropdown> Logger

@if (_isVisible)
{
    <div class="tenant-filter-dropdown" data-testid="tenant-filter">
        <label class="tenant-filter-label">
            <i class="bi bi-building"></i> Tenant:
        </label>
        <select class="tenant-filter-select" @bind="_selectedValue" @bind:after="OnTenantChanged">
            <option value="EMPTY">---Lọc dữ liệu---</option>
            @foreach (var t in _tenants)
            {
                <option value="@t.Id.ToString()">@t.Name</option>
            }
            <option value="ALL">Tất cả</option>
        </select>
    </div>
}

@code {
    private List<TenantApiDto> _tenants = new();
    private string _selectedValue = "EMPTY";
    private bool _isVisible;

    /// <summary>
    /// Notifies parent page when filter changes.
    /// Value is one of: "EMPTY" (no data), "ALL" (all tenants), or tenant Guid string.
    /// </summary>
    [Parameter]
    public EventCallback<string> FilterChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isVisible = authState.User.IsInRole("SystemAdmin");
            if (!_isVisible)
            {
                // Non-SystemAdmin: no dropdown needed, use their own tenant
                return;
            }

            _tenants = await TenantApi.ListAllAsync();
            // Default = EMPTY — do NOT auto-select tenant, do NOT invoke FilterChanged.
            // Page starts with empty list until user picks a filter.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load tenants for filter dropdown");
        }
    }

    private async Task OnTenantChanged()
    {
        if (_selectedValue == "EMPTY")
        {
            // Empty state — clear tenant override, notify page to show nothing
            await FilterChanged.InvokeAsync("EMPTY");
        }
        else if (_selectedValue == "ALL")
        {
            // All tenants — clear any tenant override, notify page to load all
            await FilterChanged.InvokeAsync("ALL");
        }
        else if (Guid.TryParse(_selectedValue, out Guid tenantId))
        {
            // Specific tenant — override TenantProvider + notify page
            TenantProvider.SetTenant(tenantId);
            await FilterChanged.InvokeAsync(_selectedValue);
        }
    }
}
