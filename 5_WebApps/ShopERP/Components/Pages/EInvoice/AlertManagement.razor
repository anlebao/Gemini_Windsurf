@page "/einvoice/alerts"
@rendermode InteractiveServer
@layout EInvoiceLayout
@attribute [Authorize(Policy = "StoreManagement")]
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain.Common
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject ILogger<AlertManagement> Logger

<div class="alert-management-page @ThemeProvider.CurrentTheme" data-testid="alert-management">
    <TenantFilterDropdown TenantChanged="OnTenantFilterChanged" />
    <header class="page-header">
        <h1>Quản Lý Cảnh Báo</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="LoadAlerts" data-testid="btn-refresh-alerts">
                Làm Mới
            </VanAButton>
            @if (Alerts.Any(a => !a.IsAcknowledged))
            {
                <VanAButton Variant="primary" Size="small" OnClick="AcknowledgeAll" data-testid="btn-acknowledge-all">
                    Xác Nhận Tất Cả
                </VanAButton>
            }
        </div>
    </header>

    @if (!TenantProvider.HasTenant)
    {
        <VanAAlert Variant="warning" Message="Không tìm thấy thông tin tenant. Vui lòng đăng nhập lại." />
    }
    else
    {
        <section class="alert-summary-section">
            <div class="metrics-grid" data-testid="alert-metrics">
                <VanAMetricsCard Title="Cảnh Báo Mới"
                    Value="@Alerts.Count(a => !a.IsAcknowledged).ToString()"
                    Icon="bell" Trend="+0%" Color="danger" />
                <VanAMetricsCard Title="Lỗi Nghiêm Trọng"
                    Value="@Alerts.Count(a => a.Severity == "Critical").ToString()"
                    Icon="alert-octagon" Trend="+0%" Color="danger" />
                <VanAMetricsCard Title="Cảnh Báo"
                    Value="@Alerts.Count(a => a.Severity == "Warning").ToString()"
                    Icon="alert-triangle" Trend="+0%" Color="warning" />
                <VanAMetricsCard Title="Thông Tin"
                    Value="@Alerts.Count(a => a.Severity == "Info").ToString()"
                    Icon="info" Trend="+0%" Color="info" />
            </div>
        </section>

        <section class="alert-list-section">
            <VanACard Header="Danh Sách Cảnh Báo" data-testid="alert-list-card">
                @if (isLoading)
                {
                    <p>Đang tải cảnh báo...</p>
                }
                else if (Alerts.Count == 0)
                {
                    <p class="empty-state" data-testid="no-alerts-message">Không có cảnh báo nào.</p>
                }
                else
                {
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Thời Gian</th>
                                <th>Mức Độ</th>
                                <th>Nhà Cung Cấp</th>
                                <th>Thông Báo</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in Alerts)
                            {
                                <tr>
                                    <td>@alert.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge @GetSeverityClass(alert.Severity)" data-testid="alert-severity">
                                            @GetSeverityLabel(alert.Severity)
                                        </span>
                                    </td>
                                    <td>@(alert.Provider ?? "—")</td>
                                    <td><span data-testid="alert-message">@alert.Message</span></td>
                                    <td>
                                        @if (alert.IsAcknowledged)
                                        {
                                            <span class="badge badge-success">Đã Xác Nhận</span>
                                        }
                                        else
                                        {
                                            <VanAButton Variant="secondary" Size="small"
                                                OnClick="() => AcknowledgeAlert(alert.Id)"
                                                data-testid="btn-acknowledge">
                                                Xác Nhận
                                            </VanAButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </VanACard>
        </section>
    }
</div>

@code {
    private sealed record AlertItem(
        Guid Id, string? Provider, string Severity,
        string Message, bool IsAcknowledged, DateTime CreatedAt);

    private bool isLoading = false;
    private List<AlertItem> Alerts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!TenantProvider.HasTenant)
            {
                Logger.LogWarning("AlertManagement: no tenant context — skipping load");
                return;
            }
            await LoadAlerts();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing AlertManagement");
        }
    }

    private async Task LoadAlerts()
    {
        isLoading = true;
        try
        {
            // Placeholder: will be wired to alert service when ready
            Alerts = new List<AlertItem>
            {
                new(Guid.NewGuid(), "Viettel", "Info", "Kết nối Viettel ổn định.", false, DateTime.Now.AddMinutes(-5)),
                new(Guid.NewGuid(), "MISA", "Warning", "MISA chưa được cấu hình.", false, DateTime.Now.AddMinutes(-30))
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading alerts");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnTenantFilterChanged(Guid tenantId)
    {
        await LoadAlerts();
        StateHasChanged();
    }

    private void AcknowledgeAlert(Guid alertId)
    {
        Alerts = Alerts.Select(a => a.Id == alertId ? a with { IsAcknowledged = true } : a).ToList();
        Logger.LogInformation("Alert {AlertId} acknowledged", alertId);
    }

    private void AcknowledgeAll()
    {
        Alerts = Alerts.Select(a => a with { IsAcknowledged = true }).ToList();
        Logger.LogInformation("All alerts acknowledged for tenant {TenantId}", TenantProvider.TenantId);
    }

    private static string GetSeverityClass(string severity) => severity switch
    {
        "Critical" => "badge-danger",
        "Warning" => "badge-warning",
        "Info" => "badge-info",
        _ => "badge-secondary"
    };

    private static string GetSeverityLabel(string severity) => severity switch
    {
        "Critical" => "Nghiêm Trọng",
        "Warning" => "Cảnh Báo",
        "Info" => "Thông Tin",
        _ => severity
    };
}
