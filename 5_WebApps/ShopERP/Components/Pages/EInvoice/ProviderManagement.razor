@page "/einvoice/providers"
@rendermode InteractiveServer
@layout EInvoiceLayout
@attribute [Authorize(Policy = "OwnerOnly")]
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain.Common
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject ILogger<ProviderManagement> Logger
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<div class="provider-management-page @ThemeProvider.CurrentTheme" data-testid="provider-management">
    <TenantFilterDropdown FilterChanged="OnFilterChanged" />
    <header class="page-header">
        <h1>Quản Lý Nhà Cung Cấp</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="RefreshProviders" data-testid="btn-refresh">
                Làm Mới
            </VanAButton>
        </div>
    </header>

    @if (!TenantProvider.HasTenant)
    {
        <VanAAlert Variant="warning" Message="Không tìm thấy thông tin tenant. Vui lòng đăng nhập lại." />
    }
    else if (isLoading)
    {
        <p>Đang tải nhà cung cấp...</p>
    }
    else
    {
        <section class="providers-section" data-testid="einvoice-providers-section">
            <VanACard Header="Nhà Cung Cấp Hóa Đơn Điện Tử">
                @if (EInvoiceProviders.Count == 0)
                {
                    <p class="empty-state">Chưa có nhà cung cấp hóa đơn điện tử nào được cấu hình.</p>
                }
                else
                {
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Nhà Cung Cấp</th>
                                <th>Trạng Thái</th>
                                <th>Hóa Đơn Hôm Nay</th>
                                <th>Tỷ Lệ Thành Công</th>
                                <th>Lần Gửi Cuối</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in EInvoiceProviders)
                            {
                                <tr>
                                    <td><strong data-testid="provider-name">@p.Name</strong></td>
                                    <td>
                                        <span class="badge @GetStatusClass(p.Status)" data-testid="provider-status">
                                            @GetStatusLabel(p.Status)
                                        </span>
                                    </td>
                                    <td>@p.TodayCount</td>
                                    <td>@($"{p.SuccessRate:F1}%")</td>
                                    <td>@(p.LastSubmit.HasValue ? p.LastSubmit.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
                                    <td>
                                        <VanAButton Variant="secondary" Size="small"
                                            OnClick="() => ConfigureProvider(p.Id)"
                                            data-testid="btn-configure">
                                            Cấu Hình
                                        </VanAButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </VanACard>
        </section>
    }
</div>

@code {
    private bool isLoading = true;

    private sealed record ProviderItem(
        string Id, string Name, string Status,
        int TodayCount, decimal SuccessRate, DateTime? LastSubmit);

    private List<ProviderItem> EInvoiceProviders = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            bool isSysAdmin = authState.User.IsInRole("SystemAdmin");
            if (isSysAdmin)
            {
                // Default EMPTY — no data loaded until filter selected
                isLoading = false;
                return;
            }
            if (!TenantProvider.HasTenant)
            {
                Logger.LogWarning("ProviderManagement: no tenant context — skipping load");
                isLoading = false;
                return;
            }
            await LoadProviders();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing ProviderManagement");
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task LoadProviders()
    {
        // Placeholder: will be wired to IProviderManager when ready
        EInvoiceProviders = new List<ProviderItem>
        {
            new("viettel", "Viettel", "Connected", 156, 99.2m, DateTime.Now.AddMinutes(-5)),
            new("misa", "MISA", "Pending", 0, 0m, null)
        };
        return Task.CompletedTask;
    }

    private async Task RefreshProviders()
    {
        isLoading = true;
        await LoadProviders();
        isLoading = false;
    }

    private async Task OnFilterChanged(string filterValue)
    {
        if (filterValue == "EMPTY")
        {
            EInvoiceProviders = new List<ProviderItem>();
            StateHasChanged();
            return;
        }
        await LoadProviders();
        StateHasChanged();
    }

    private void ConfigureProvider(string providerId) =>
        NavigationManager.NavigateTo($"/einvoice/configuration?provider={providerId}");

    private static string GetStatusClass(string status) => status switch
    {
        "Connected" => "badge-success",
        "Slow" => "badge-warning",
        "Error" => "badge-danger",
        _ => "badge-secondary"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "Connected" => "Đang kết nối",
        "Slow" => "Chậm",
        "Error" => "Lỗi",
        _ => "Chờ kết nối"
    };
}
