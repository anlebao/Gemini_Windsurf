@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.ShopERP.Components.Shared
@using VanAn.ShopERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<VanALayout>
    <Sidebar>
        <VanANavigation MenuItems="@EInvoiceMenuItems" />
    </Sidebar>
    <Header>
        <UserHeader />
    </Header>
    <ChildContent>
        @Body
    </ChildContent>
</VanALayout>

@code {
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private IShopErpMenuService MenuService { get; set; } = null!;

    private List<VanAn.UI.Platform.Models.NavigationItem> EInvoiceMenuItems = new();

    protected override async Task OnInitializedAsync()
    {
        // SSOT menu: same role-based menu as the other layouts (Hóa Đơn Điện Tử group included).
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        EInvoiceMenuItems = await MenuService.BuildAsync(authState.User);
    }
}
