@page "/pos/payment/{OrderId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "StaffOrAbove")]
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Models
@using VanAn.UI.Platform.Tokens
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.Shared.DTOs
@using VanAn.CoreHub.Services
@inject IOrderWorkflowService OrderWorkflowService
@inject IOrderService OrderService
@inject ITenantProvider TenantProvider
@inject ILogger<Payment> Logger
@inject NavigationManager NavigationManager
@inject IThemeProvider ThemeProvider

<div class="pos-payment-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Thanh toán đơn hàng</h1>
        <VanAButton Variant="secondary" Size="small" OnClick="@(() => NavigationManager.NavigateTo("/pos"))">
            ← Tạo đơn mới
        </VanAButton>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }

    @if (loading)
    {
        <VanACard Header="Đang tải">
            <p>Đang tải thông tin đơn hàng...</p>
        </VanACard>
    }
    else if (order == null)
    {
        <VanACard Header="Không tìm thấy">
            <p>Đơn hàng không tồn tại.</p>
        </VanACard>
    }
    else
    {
        <div class="pos-payment-layout">
            <div class="pos-payment-summary">
                <VanACard Header="📋 Chi tiết đơn hàng">
                    <div class="order-info-grid">
                        <div><strong>Mã đơn:</strong> @(order.TrackingCode ?? order.Id.ToString()[..8])</div>
                        <div><strong>Trạng thái:</strong> <OrderStatusBadge Status="@order.Status?.Value" /></div>
                        <div><strong>Tổng tiền:</strong> @order.TotalAmount.ToString("N0") đ</div>
                    </div>
                    <hr />
                    @if (order.Items != null && order.Items.Count > 0)
                    {
                        @foreach (var item in order.Items)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@item.ProductName x @item.Quantity</span>
                                <span>@item.TotalAmount.ToString("N0") đ</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between">
                            <h5>Tổng cộng:</h5>
                            <h5 class="text-danger">@order.TotalAmount.ToString("N0") đ</h5>
                        </div>
                    }
                </VanACard>
            </div>

            <div class="pos-payment-method">
                <VanACard Header="💳 Chọn phương thức thanh toán">
                    <PaymentMethodSelector @bind-Value="selectedPaymentMethod" Label="Hình thức thanh toán" GroupName="pos-payment" />

                    <hr />

                    @if (selectedPaymentMethod == "cash")
                    {
                        <VanAAlert Type="info" Message="Khách thanh toán bằng tiền mặt. Nhấn xác nhận để hoàn tất." Dismissible="false" />
                        <div class="mt-3">
                            <VanAButton Variant="success" FullWidth="true" OnClick="ConfirmCashPayment" disabled="@isProcessing" data-testid="pos-btn-cash-confirm">
                                @(isProcessing ? "Đang xử lý..." : "✓ Xác nhận thanh toán tiền mặt")
                            </VanAButton>
                        </div>
                    }
                    else if (selectedPaymentMethod == "transfer")
                    {
                        <VanAAlert Type="warning" Message="QR thanh toán cần kết nối internet. Nếu offline, dùng tiền mặt." Dismissible="false" />

                        <div class="mt-3">
                            @* Bank account info form — owner enters receiving bank account *@
                            @if (string.IsNullOrEmpty(qrImageUrl))
                            {
                                <h6>Thông tin tài khoản nhận thanh toán</h6>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label small">Tên ngân hàng <span class="text-danger">*</span></label>
                                        <input class="form-control" @bind="_bankName" placeholder="VD: Vietcombank, Techcombank, MBBank..." />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small">Số tài khoản <span class="text-danger">*</span></label>
                                        <input class="form-control" @bind="_bankAccountNo" placeholder="VD: 0123456789" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small">Tên chủ tài khoản</label>
                                        <input class="form-control" @bind="_accountName" placeholder="VD: NGUYEN VAN A" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small">Nội dung chuyển khoản</label>
                                        <input class="form-control" @bind="_transferNote" placeholder="VD: DONHANG 01234567" />
                                    </div>
                                </div>
                                <VanAButton Variant="primary" FullWidth="true" OnClick="GenerateQrCode" disabled="@(isProcessing || string.IsNullOrWhiteSpace(_bankName) || string.IsNullOrWhiteSpace(_bankAccountNo))" data-testid="pos-btn-generate-qr">
                                    <i class="bi bi-qr-code me-1"></i> Tạo mã QR thanh toán
                                </VanAButton>
                            }

                            @if (!string.IsNullOrEmpty(qrImageUrl))
                            {
                                <div class="text-center mt-3">
                                    <img src="@qrImageUrl" alt="VietQR Code" class="img-fluid border rounded" style="max-width: 280px;" />
                                    <p class="mt-2 mb-1">Quét mã để thanh toán</p>
                                    <p class="fw-bold text-danger mb-2">@order.TotalAmount.ToString("N0") đ</p>
                                    @if (!string.IsNullOrEmpty(_accountName))
                                    {
                                        <p class="small text-muted mb-0">TK: @_accountName</p>
                                    }
                                    <p class="small text-muted mb-2">@_bankName - @_bankAccountNo</p>
                                    <div class="d-flex gap-2 justify-content-center">
                                        <VanAButton Variant="secondary" Size="small" OnClick="ResetQrCode">
                                            <i class="bi bi-arrow-left me-1"></i> Sửa thông tin
                                        </VanAButton>
                                        <VanAButton Variant="success" OnClick="ConfirmTransferPayment" disabled="@isProcessing" data-testid="pos-btn-transfer-confirm">
                                            ✓ Đã nhận chuyển khoản
                                        </VanAButton>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </VanACard>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid OrderId { get; set; }

    private OrderDetailDto? order;
    private bool loading = true;
    private bool isProcessing = false;
    private string? errorMessage;
    private string selectedPaymentMethod = "cash";
    private string? qrImageUrl;
    // Bank account info for transfer QR generation
    private string _bankName = string.Empty;
    private string _bankAccountNo = string.Empty;
    private string _accountName = string.Empty;
    private string _transferNote = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrder();
    }

    private async Task LoadOrder()
    {
        loading = true;
        try
        {
            Order? domainOrder = await OrderWorkflowService.GetOrderAsync(OrderId);
            if (domainOrder == null)
            {
                order = null;
            }
            else
            {
                order = MapToDto(domainOrder);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading order {OrderId}", OrderId);
            errorMessage = $"Không thể tải đơn hàng: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    // T10: Cash payment — confirm order status to "confirmed" (skip payment gateway).
    // Edge offline-first: cash is instant, no internet needed.
    private async Task ConfirmCashPayment()
    {
        await ConfirmPayment("cash");
    }

    // T10: Transfer payment — staff manually confirms receipt of bank transfer.
    private async Task ConfirmTransferPayment()
    {
        await ConfirmPayment("transfer");
    }

    /// <summary>
    /// Generate VietQR code URL from bank account info + order amount.
    /// Uses VietQR.io public API: https://img.vietqr.io/image/{bank}-{accountNo}-compact.png?amount={amount}&addInfo={note}
    /// No API key required — free public service.
    /// </summary>
    private Task GenerateQrCode()
    {
        if (order == null || string.IsNullOrWhiteSpace(_bankName) || string.IsNullOrWhiteSpace(_bankAccountNo))
        {
            errorMessage = "Vui lòng nhập tên ngân hàng và số tài khoản.";
            return Task.CompletedTask;
        }

        try
        {
            // Normalize bank name for VietQR.io (lowercase, no spaces for some banks)
            string bank = _bankName.Trim().ToLowerInvariant().Replace(" ", "");
            string accountNo = _bankAccountNo.Trim().Replace(" ", "");
            long amount = (long)Math.Round(order.TotalAmount);
            string note = string.IsNullOrWhiteSpace(_transferNote)
                ? $"DH {order.TrackingCode ?? order.Id.ToString()[..8]}"
                : Uri.EscapeDataString(_transferNote.Trim());

            // VietQR.io compact format — works without bank BIN lookup
            qrImageUrl = $"https://img.vietqr.io/image/{bank}-{accountNo}-compact.png?amount={amount}&addInfo={note}";
            Logger.LogInformation("Generated VietQR for order {OrderId}: bank={Bank}, account={Account}, amount={Amount}",
                OrderId, bank, accountNo, amount);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating QR code for order {OrderId}", OrderId);
            errorMessage = $"Không thể tạo mã QR: {ex.Message}";
        }

        return Task.CompletedTask;
    }

    /// <summary>Clear QR + form → back to bank info input.</summary>
    private void ResetQrCode()
    {
        qrImageUrl = null;
    }

    private async Task ConfirmPayment(string method)
    {
        isProcessing = true;
        errorMessage = null;
        try
        {
            Guid tenantId = TenantProvider.TenantId;

            // Confirm payment via IOrderService (generates accounting entries).
            string transactionId = $"POS_{method.ToUpper()}_{OrderId}_{DateTime.UtcNow:yyyyMMddHHmmss}";
            await OrderService.ConfirmPaymentAsync(OrderId, tenantId, transactionId);

            // FIX: Transition to "preparing" (not "confirmed") — Kitchen ON flow is
            // pending→preparing→ready→completed. "confirmed" only exists in Kitchen OFF bypass.
            // POS orders are auto-accepted (staff already confirmed payment) → go to "preparing".
            _ = await OrderWorkflowService.TransitionStatusAsync(
                OrderId,
                new OrderStatusId("preparing"),
                reason: $"POS {method} payment confirmed");

            Logger.LogInformation("POS payment confirmed for order {OrderId} via {Method}", OrderId, method);

            // Redirect to kitchen display
            NavigationManager.NavigateTo("/kitchen");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error confirming POS payment for order {OrderId}", OrderId);
            errorMessage = $"Lỗi thanh toán: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private OrderDetailDto MapToDto(Order domainOrder)
    {
        return new OrderDetailDto
        {
            Id = domainOrder.Id,
            TrackingCode = domainOrder.TrackingCode,
            OrderDate = domainOrder.OrderDate,
            Status = new OrderStatusDto { Value = domainOrder.Status?.Value ?? "" },
            PaymentStatus = domainOrder.PaymentStatus,
            PaymentMethod = domainOrder.PaymentMethod,
            TotalAmount = domainOrder.TotalAmount,
            Items = domainOrder.Items?.Select(i => new OrderItemDto
            {
                ProductName = i.ProductName,
                Quantity = i.Quantity,
                UnitPrice = i.UnitPrice,
                TotalAmount = i.TotalAmount
            }).ToList() ?? new()
        };
    }

    private class OrderDetailDto
    {
        public Guid Id { get; set; }
        public string? TrackingCode { get; set; }
        public DateTime OrderDate { get; set; }
        public OrderStatusDto? Status { get; set; }
        public string? PaymentStatus { get; set; }
        public string? PaymentMethod { get; set; }
        public decimal TotalAmount { get; set; }
        public List<OrderItemDto> Items { get; set; } = new();
    }

    private class OrderStatusDto
    {
        public string Value { get; set; } = "";
    }

    private class OrderItemDto
    {
        public string ProductName { get; set; } = "";
        public int Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TotalAmount { get; set; }
    }
}
