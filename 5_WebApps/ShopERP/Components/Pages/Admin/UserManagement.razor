@page "/admin/users"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.CoreHub.Services
@using VanAn.Shared.Domain.Aggregates.UserAggregate
@using DemoUser = VanAn.Shared.Domain.Aggregates.UserAggregate.DemoUser
@using UserRole = VanAn.Shared.Domain.Aggregates.UserAggregate.UserRole
@inject IUserManagementService UserService
@inject IRoleAssignmentService RoleService
@inject ITenantProvider TenantProvider
@inject IThemeProvider ThemeProvider
@inject ILogger<UserManagement> Logger
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject VanAn.CoreHub.Infrastructure.IVanAnDbContext DbContext

@attribute [Authorize(Policy = "OwnerOnly")]

<div class="user-management-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Quản lý người dùng</h1>
        <div class="header-actions">
            <VanAButton Variant="primary" Size="small" OnClick="OpenCreateModal" Text="+ Tạo người dùng" />
            <VanAButton Variant="secondary" Size="small" OnClick="LoadUsers" Text="Làm mới" />
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Type="@_alertType" Message="@_alertMessage" Dismissible="true" OnDismiss="() => _alertMessage = string.Empty" />
    }

    @if (_isLoading)
    {
        <VanACard>
            <div class="loading-state">
                <p>Đang tải danh sách người dùng...</p>
            </div>
        </VanACard>
    }
    else if (_users.Count == 0)
    {
        <VanACard>
            <div class="empty-state">
                <p>Chưa có người dùng nào. Nhấn "+ Tạo người dùng" để bắt đầu.</p>
            </div>
        </VanACard>
    }
    else
    {
        <VanACard Header="@($"Danh sách người dùng ({_users.Count})")">
            <VanAnDataGrid TItem="DemoUser" Items="@_users" EmptyMessage="Không có người dùng nào">
                <Columns>
                    <VanAnColumn TItem="DemoUser" Title="Tên hiển thị" Width="3">
                        <Template Context="u">
                            <strong>@u.DisplayName</strong>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="DemoUser" Title="Email" Width="2">
                        <Template Context="u">@u.Username</Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="DemoUser" Title="Tenant" Width="2">
                        <Template Context="u">
                            <span class="badge bg-info">@(_tenantNames.GetValueOrDefault(u.TenantId.Value, "N/A"))</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="DemoUser" Title="Vai trò" Width="1">
                        <Template Context="u">@u.Role</Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="DemoUser" Title="Trạng thái" Width="1">
                        <Template Context="u">
                            <span class="status-badge status-@(u.IsActive ? "active" : "inactive")">
                                @(u.IsActive ? "Hoạt động" : "Ngừng hoạt động")
                            </span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="DemoUser" Title="Hành động" Width="2">
                        <Template Context="u">
                            @if (u.IsActive)
                            {
                                <VanAButton Variant="outline" Size="small" OnClick="() => OpenDeactivateModal(u)" Text="Vô hiệu hoá" />
                            }
                            else
                            {
                                <VanAButton Variant="secondary" Size="small" OnClick="() => ReactivateUser(u)" Text="Kích hoạt" />
                            }
                            <VanAButton Variant="outline" Size="small" OnClick="() => OpenRoleModal(u)" Text="Vai trò" />
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>
    }

    @if (_showCreateModal)
    {
        <VanAModal Title="Tạo người dùng mới" IsVisible="true" OnClose="CloseCreateModal">
            <Body>
                <form @onsubmit="HandleCreateSubmit" aria-label="Tạo người dùng mới">
                    @if (_isSystemAdmin && _allTenants.Any())
                    {
                        <div class="form-group">
                            <label for="user-tenant">Thuộc tenant *</label>
                            <select id="user-tenant" class="vanan-select" @bind="_createForm.TenantId" aria-label="Tenant" required>
                                @foreach (var t in _allTenants)
                                {
                                    <option value="@t.Id.Value">@t.Name</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label>Thuộc tenant</label>
                            <input class="vanan-input" value="@(_tenantNames.GetValueOrDefault(GetTenantId().Value, "Current tenant"))" disabled />
                        </div>
                    }
                    <div class="form-group">
                        <label for="user-username">Email đăng nhập *</label>
                        <input id="user-username" class="vanan-input" type="email" @bind="_createForm.Username" placeholder="user@vanan.vn" aria-label="Email đăng nhập" required />
                    </div>
                    <div class="form-group">
                        <label for="user-password">Mật khẩu *</label>
                        <input id="user-password" class="vanan-input" type="password" @bind="_createForm.Password" placeholder="Nhập mật khẩu..." aria-label="Mật khẩu" required />
                    </div>
                    <div class="form-group">
                        <label for="user-displayname">Tên hiển thị *</label>
                        <input id="user-displayname" class="vanan-input" @bind="_createForm.DisplayName" placeholder="Nguyễn Văn A" aria-label="Tên hiển thị" required />
                    </div>
                    <div class="form-group">
                        <label for="user-role">Vai trò *</label>
                        <select id="user-role" class="vanan-select" @bind="_createForm.Role" aria-label="Vai trò" required>
                            @foreach (var role in UserRoleHelper.GetAssignableRoles(_isSystemAdmin))
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        @if (!_isSystemAdmin)
                        {
                            <small class="text-muted">Owner chỉ được tạo user với role Staff, Masterchef, Guard, StoreKeeper.</small>
                        }
                    </div>
                </form>
            </Body>
            <Footer>
                <VanAButton Variant="primary" Loading="@_isSaving" OnClick="HandleCreateSubmit" Text="Tạo" />
                <VanAButton Variant="outline" OnClick="CloseCreateModal" Text="Huỷ" />
            </Footer>
        </VanAModal>
    }

    @if (_showDeactivateModal && _selectedUser is not null)
    {
        <VanAModal Title="Vô hiệu hoá người dùng" IsVisible="true" OnClose="CloseDeactivateModal">
            <Body>
                <VanAAlert Type="warning" Message="Thao tác này có thể được hoàn tác bằng cách kích hoạt lại." Dismissible="false" />
                <p>Vô hiệu hoá người dùng: <strong>@_selectedUser.DisplayName</strong></p>
            </Body>
            <Footer>
                <VanAButton Variant="danger" OnClick="ConfirmDeactivate" Loading="@_isSaving" Text="Xác nhận" />
                <VanAButton Variant="outline" OnClick="CloseDeactivateModal" Text="Huỷ" />
            </Footer>
        </VanAModal>
    }

    @if (_showRoleModal && _selectedUser is not null)
    {
        <VanAModal Title="Gán vai trò" IsVisible="true" OnClose="CloseRoleModal">
            <Body>
                <p>Gán vai trò cho: <strong>@_selectedUser.DisplayName</strong></p>
                <div class="form-group">
                    <label>Vai trò</label>
                    <select class="vanan-select" @bind="_roleToAssign">
                        @foreach (var role in UserRoleHelper.GetAssignableRoles(_isSystemAdmin))
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </div>
            </Body>
            <Footer>
                <VanAButton Variant="primary" OnClick="ConfirmAssignRole" Loading="@_isSaving" Text="Gán" />
                <VanAButton Variant="outline" OnClick="CloseRoleModal" Text="Huỷ" />
            </Footer>
        </VanAModal>
    }
</div>
