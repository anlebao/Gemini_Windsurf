@page "/admin/tenant-ai/knowledge"
@rendermode InteractiveServer
@layout AdminLayout
@attribute [Authorize(Policy = "StaffOrAbove")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using VanAn.UI.Platform.Components
@using VanAn.Shared.Domain.Common
@using VanAn.Shared.Services
@using VanAn.ShopERP.Services
@inject ITenantAiClient AiClient
@inject IMenuOcrService MenuOcr
@inject IWebContentExtractor WebExtractor
@inject IShopFeatureSettingsService FeatureSettings
@inject ITenantProvider TenantProvider
@inject ILogger<TenantAiKnowledge> Logger

@* Task AI-P10 — tri thức AI (SRS §3.1-P2 [G14] approval gate): upload doc →
   pending_review → duyệt/từ chối; public chỉ đọc docs "approved". *@
<PageTitle>Tri thức trợ lý AI</PageTitle>

<div class="tenant-ai-knowledge" data-testid="tenant-ai-knowledge">
    <header class="page-header">
        <h1>
            <a href="/admin/tenant-ai" class="text-decoration-none text-muted me-2"><i class="bi bi-arrow-left"></i></a>
            Tri thức trợ lý AI
        </h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="ReloadAsync" Loading="@_loading">
                Làm mới
            </VanAButton>
        </div>
    </header>

    @if (_flagChecked && !_flagOn)
    {
        <VanAAlert Variant="info" Message="Tenant AI chưa bật — bật tại Cấu hình tính năng Shop." />
        <a href="/settings/shop-features" class="btn btn-outline-primary btn-sm">Mở cấu hình tính năng</a>
    }
    else if (_flagOn)
    {
        @if (!string.IsNullOrEmpty(_alert))
        {
            <VanAAlert Variant="@_alertVariant" Message="@_alert" Dismissible="true" OnDismiss="() => _alert = null" />
        }

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button type="button" class="nav-link @(_tab == "pending" ? "active" : "")"
                        @onclick='() => SwitchTab("pending")' data-testid="tab-pending">
                    <i class="bi bi-hourglass-split"></i> Chờ duyệt
                    @if (_pendingCount > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1">@_pendingCount</span>
                    }
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(_tab == "docs" ? "active" : "")"
                        @onclick='() => SwitchTab("docs")' data-testid="tab-docs">
                    <i class="bi bi-journal-text"></i> Tài liệu
                </button>
            </li>
        </ul>

        @if (_tab == "pending")
        {
            <VanACard Header="Tài liệu chờ duyệt" data-testid="card-pending">
                <p class="text-muted small">
                    AI chỉ dùng tài liệu đã duyệt để trả lời khách. Đọc kỹ nội dung trước khi duyệt.
                </p>
                @if (_loading)
                {
                    <div class="loading-state"><VanASpinner /><p>Đang tải...</p></div>
                }
                else if (_pending.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-check2-circle" style="font-size: 2.5rem; color: #198754;"></i>
                        <p class="mt-2">Không có tài liệu nào chờ duyệt.</p>
                    </div>
                }
                else
                {
                    @foreach (var d in _pending)
                    {
                        <div class="border rounded p-3 mb-3" data-testid="pending-doc">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <strong>@d.Title</strong>
                                    <span class="badge bg-secondary ms-2">@d.Type</span>
                                    <span class="badge bg-light text-dark ms-1">@d.Classification</span>
                                    <div class="small text-muted mt-1">@d.CreatedAtUtc.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</div>
                                </div>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    @* AI-P11: owner chọn classification lúc duyệt (chat-suggest docs
                                       vào với internal placeholder). Không có Restricted — fail closed. *@
                                    <select class="form-select form-select-sm" style="max-width: 170px;"
                                            @bind="_approveClasses[d.Id]" data-testid="select-approve-class"
                                            title="Phân loại khi duyệt — Public = AI trả lời khách trên storefront">
                                        <option value="public">Public — AI trả lời khách</option>
                                        <option value="internal">Internal — chỉ lưu trữ</option>
                                        <option value="confidential">Confidential — chỉ lưu trữ</option>
                                    </select>
                                    <VanAButton Variant="success" Size="small" OnClick="() => ApproveAsync(d)"
                                                Disabled="@_busy" data-testid="btn-approve-doc">
                                        <i class="bi bi-check-lg me-1"></i> Duyệt
                                    </VanAButton>
                                </div>
                            </div>
                            <pre class="bg-light border rounded p-2 mt-2 mb-0 small doc-content">@d.Content</pre>
                            @if (d.Sanitized)
                            {
                                <small class="text-warning d-block mt-1">
                                    <i class="bi bi-exclamation-triangle"></i> Hệ thống đã lọc một số dòng giống câu lệnh — xem kỹ trước khi duyệt.
                                </small>
                            }
                            <div class="input-group mt-2" style="max-width: 520px;">
                                <input class="form-control form-control-sm" placeholder="Lý do từ chối (bắt buộc)"
                                       @bind="_rejectReasons[d.Id]" data-testid="input-reject-reason" />
                                <VanAButton Variant="error" Size="small" OnClick="() => RejectAsync(d)"
                                            Disabled="@_busy" data-testid="btn-reject-doc">
                                    <i class="bi bi-x-lg me-1"></i> Từ chối
                                </VanAButton>
                            </div>
                        </div>
                    }
                }
            </VanACard>
        }
        else
        {
            @* W3a Auto-Builder: dán text thô (menu/bảng giá/FAQ copy từ Zalo/web)
               → AI trích xuất candidates → owner xem/sửa → đẩy vào hàng chờ duyệt.
               Không auto-publish: vẫn qua approval gate như upload thường. *@
            <VanACard Header="Trích xuất tự động từ văn bản" data-testid="card-extract">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="extract-input">Văn bản nguồn <span class="text-danger">*</span></label>
                        <textarea id="extract-input" class="form-control" rows="5" @bind="_extractInput"
                                  placeholder="Dán menu, bảng giá, FAQ, chính sách… copy từ Zalo/web/menu giấy chụp lại."
                                  data-testid="input-extract-source" maxlength="20000"></textarea>
                        <small class="text-muted">Tối đa 20.000 ký tự. AI chỉ trích xuất — bạn duyệt trước khi dùng.</small>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Hoặc tải ảnh menu (tuỳ chọn)</label>
                        <InputFile OnChange="OnMenuImageSelected" accept="image/*"
                                  class="form-control" style="max-width: 420px;"
                                  data-testid="input-menu-image" />
                        @if (_menuOcrBusy)
                        {
                            <span class="text-muted small ms-2">⏳ Đang đọc ảnh menu…</span>
                        }
                        <div><small class="text-muted">Ảnh chụp menu/bảng giá rõ nét, tối đa ~6MB. Kết quả đổ vào ô văn bản phía trên để bạn kiểm tra.</small></div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="extract-url">Hoặc URL website của quán</label>
                        <div class="input-group" style="max-width: 560px;">
                            <input id="extract-url" class="form-control" @bind="_websiteUrl"
                                   placeholder="https://shopcuatoi.com" data-testid="input-extract-url" />
                            <VanAButton Variant="outline" OnClick="FetchWebsiteAsync" Loading="@_webFetching"
                                        Disabled="@(_webFetching || string.IsNullOrWhiteSpace(_websiteUrl))"
                                        data-testid="btn-fetch-website">
                                <i class="bi bi-globe me-1"></i> Lấy nội dung
                            </VanAButton>
                        </div>
                        <div><small class="text-muted">Tải text từ website (tối đa ~20.000 ký tự) đổ vào ô văn bản để kiểm tra. Site render bằng JavaScript có thể không đọc được — khi đó copy text thủ công.</small></div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" for="extract-hint">Gợi ý thêm (tuỳ chọn)</label>
                        <input id="extract-hint" class="form-control" @bind="_extractHint"
                               placeholder="VD: đây là menu spa, chú ý phần giá" data-testid="input-extract-hint" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <VanAButton Variant="outline" OnClick="ExtractAsync" Loading="@_extracting"
                                    Disabled="@(_extracting || string.IsNullOrWhiteSpace(_extractInput))"
                                    data-testid="btn-extract">
                            <i class="bi bi-magic me-1"></i> Trích xuất
                        </VanAButton>
                    </div>
                </div>

                @if (_extractResult is not null)
                {
                    <div class="mt-3">
                        @if (_extractResult.Items.Count == 0)
                        {
                            <VanAAlert Variant="warning"
                                       Message="@($"Không trích xuất được mục nào. {_extractResult.Summary}")" />
                        }
                        else
                        {
                            <p class="mb-2"><strong>@_extractResult.Items.Count mục</strong> — @_extractResult.Summary</p>
                            <div class="extract-preview mb-2" style="max-height: 220px; overflow-y: auto;">
                                @foreach (var item in _extractResult.Items)
                                {
                                    <div class="border rounded p-2 mb-1 small">
                                        <span class="badge bg-secondary me-1">@KindLabel(item.Kind)</span>
                                        <strong>@item.Title</strong>
                                        <div class="text-muted">@item.Content</div>
                                    </div>
                                }
                            </div>

                            <label class="form-label">Nội dung sẽ đưa vào knowledge (có thể sửa)</label>
                            <textarea class="form-control font-monospace" rows="6" @bind="_extractDocContent"
                                      data-testid="input-extract-content"></textarea>
                            <div class="d-flex gap-2 mt-2 align-items-center flex-wrap">
                                <select class="form-select" style="max-width: 200px;" @bind="_extractDocType" data-testid="select-extract-type">
                                    <option value="menu-note">Menu/dịch vụ</option>
                                    <option value="faq">FAQ — hỏi đáp</option>
                                    <option value="policy">Chính sách</option>
                                </select>
                                <VanAButton Variant="primary" Size="small" OnClick="ConfirmExtractAsync" Loading="@_busy"
                                            Disabled="@(_busy || string.IsNullOrWhiteSpace(_extractDocContent))"
                                            data-testid="btn-confirm-extract">
                                    <i class="bi bi-check2 me-1"></i> Đưa vào hàng chờ duyệt
                                </VanAButton>
                            </div>
                        }
                    </div>
                }
            </VanACard>

            <VanACard Header="Upload tài liệu" data-testid="card-upload">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label" for="doc-type">Loại</label>
                        <select id="doc-type" class="form-select" @bind="_uploadType" data-testid="select-doc-type">
                            <option value="faq">FAQ — hỏi đáp</option>
                            <option value="story">Câu chuyện quán</option>
                            <option value="policy">Chính sách (đổi trả, giờ giấc…)</option>
                            <option value="menu-note">Ghi chú menu/dịch vụ</option>
                            <option value="recipe">Công thức/quy trình</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="doc-title">Tiêu đề <span class="text-danger">*</span></label>
                        <input id="doc-title" class="form-control" maxlength="200" @bind="_uploadTitle"
                               placeholder="VD: Giờ mở cửa & chính sách đổi lịch" data-testid="input-doc-title" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="doc-class">Phân loại</label>
                        <select id="doc-class" class="form-select" @bind="_uploadClassification" data-testid="select-doc-class">
                            <option value="public">Public — AI dùng cho khách</option>
                            <option value="internal">Internal — chỉ lưu trữ nội bộ</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="doc-content">Nội dung <span class="text-danger">*</span></label>
                        <textarea id="doc-content" class="form-control" rows="5" @bind="_uploadContent"
                                  placeholder="Nội dung AI sẽ học — viết rõ ràng, mỗi ý 1 dòng."
                                  data-testid="input-doc-content"></textarea>
                    </div>
                </div>
                <div class="mt-2">
                    <VanAButton Variant="primary" OnClick="UploadAsync" Loading="@_busy"
                                Disabled="@(_busy || string.IsNullOrWhiteSpace(_uploadTitle) || string.IsNullOrWhiteSpace(_uploadContent))"
                                data-testid="btn-upload-doc">
                        <i class="bi bi-upload me-1"></i> Gửi vào hàng chờ duyệt
                    </VanAButton>
                    <small class="text-muted ms-2">Tài liệu mới vào tab "Chờ duyệt" — AI chỉ dùng sau khi duyệt.</small>
                </div>
            </VanACard>

            <VanACard Header="Danh sách tài liệu" CssClass="mt-3" data-testid="card-docs">
                <div class="d-flex gap-2 align-items-center mb-3 flex-wrap">
                    <select class="form-select" style="max-width: 220px;" @bind="_filterStatus"
                            @bind:after="ReloadDocsAsync" data-testid="select-status-filter">
                        <option value="">Tất cả trạng thái</option>
                        <option value="pending_review">Chờ duyệt</option>
                        <option value="approved">Đã duyệt</option>
                        <option value="rejected">Đã từ chối</option>
                    </select>
                    <span class="text-muted small">@_totalDocs tài liệu</span>
                </div>

                @if (_loading)
                {
                    <div class="loading-state"><VanASpinner /><p>Đang tải...</p></div>
                }
                else if (_docs.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-journal-x" style="font-size: 2.5rem; color: #6c757d;"></i>
                        <p class="mt-2">Chưa có tài liệu nào.</p>
                    </div>
                }
                else
                {
                    @foreach (var d in _docs)
                    {
                        <div class="border rounded p-3 mb-2" data-testid="doc-item">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <strong>@d.Title</strong>
                                    <span class="badge bg-secondary ms-2">@d.Type</span>
                                    <span class="badge bg-light text-dark ms-1">@d.Classification</span>
                                    @switch (d.ApprovalStatus)
                                    {
                                        case "pending_review":
                                            <span class="badge bg-warning text-dark ms-1">chờ duyệt</span>
                                            break;
                                        case "approved":
                                            <span class="badge bg-success ms-1">đã duyệt</span>
                                            break;
                                        case "rejected":
                                            <span class="badge bg-danger ms-1">từ chối</span>
                                            break;
                                    }
                                    <div class="small text-muted mt-1">
                                        @d.CreatedAtUtc.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
                                        @if (!string.IsNullOrEmpty(d.ApprovedBy))
                                        {
                                            @: · duyệt bởi @d.ApprovedBy
                                        }
                                        @if (!string.IsNullOrEmpty(d.RejectionReason))
                                        {
                                            @: · lý do: @d.RejectionReason
                                        }
                                    </div>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => ToggleExpand(d.Id)" data-testid="btn-expand-doc">
                                        @(_expanded.Contains(d.Id) ? "Ẩn nội dung" : "Xem nội dung")
                                    </button>
                                    @if (_confirmDeleteId == d.Id)
                                    {
                                        <VanAButton Variant="error" Size="small" OnClick="() => DeleteAsync(d)"
                                                    Disabled="@_busy" data-testid="btn-confirm-delete">
                                            Xác nhận xóa?
                                        </VanAButton>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm"
                                                @onclick="() => _confirmDeleteId = d.Id" data-testid="btn-delete-doc">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (_expanded.Contains(d.Id))
                            {
                                <pre class="bg-light border rounded p-2 mt-2 mb-0 small doc-content">@d.Content</pre>
                            }
                        </div>
                    }
                    @if (_docs.Count < _totalDocs)
                    {
                        <div class="text-center mt-2">
                            <VanAButton Variant="secondary" Size="small" OnClick="LoadMoreDocsAsync" Disabled="@_loading">
                                @(_loading ? "Đang tải..." : $"Xem thêm ({_totalDocs - _docs.Count})")
                            </VanAButton>
                        </div>
                    }
                }
            </VanACard>
        }
    }
</div>

@code {
    private bool _flagChecked;
    private bool _flagOn;
    private bool _loading;
    private bool _busy;
    private string _tab = "pending";
    private string? _alert;
    private string _alertVariant = "info";

    private readonly List<TenantAiDocItem> _pending = new();
    private int _pendingCount;
    private readonly Dictionary<Guid, string> _rejectReasons = new();
    /// <summary>AI-P11: classification chọn lúc approve, seed = classification hiện tại của doc.</summary>
    private readonly Dictionary<Guid, string> _approveClasses = new();

    private readonly List<TenantAiDocItem> _docs = new();
    private readonly HashSet<Guid> _expanded = new();
    private Guid? _confirmDeleteId;
    private string _filterStatus = string.Empty;
    private int _totalDocs;
    private int _page = 1;
    private const int PageSize = 20;

    private string _uploadType = "faq";
    private string _uploadTitle = string.Empty;
    private string _uploadContent = string.Empty;
    private string _uploadClassification = "public";

    // W3a Auto-Builder state
    private string _extractInput = string.Empty;
    private string? _extractHint;
    private bool _extracting;
    private TenantAiExtractResponse? _extractResult;
    private string _extractDocType = "menu-note";
    private string _extractDocContent = string.Empty;
    private bool _menuOcrBusy;
    private string _websiteUrl = string.Empty;
    private bool _webFetching;

    private static string KindLabel(string kind) => kind switch
    {
        "product" => "Sản phẩm",
        "service" => "Dịch vụ",
        "faq" => "Hỏi đáp",
        "policy" => "Chính sách",
        "hours" => "Giờ giấc",
        _ => "Khác",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _flagOn = TenantProvider.HasTenant
                && await FeatureSettings.IsEnabledAsync(TenantProvider.TenantId, TenantAiKnowledgeSyncService.FlagName);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "TenantAiKnowledge: flag check failed — treating as disabled");
            _flagOn = false;
        }
        _flagChecked = true;
        if (_flagOn) await ReloadAsync();
    }

    private async Task SwitchTab(string tab)
    {
        _tab = tab;
        if (tab == "docs" && _docs.Count == 0) await ReloadDocsAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var pending = await AiClient.GetDocumentsAsync(TenantProvider.TenantId, "pending_review", 1, 100);
            _pending.Clear();
            _pendingCount = pending?.Total ?? 0;
            if (pending != null) _pending.AddRange(pending.Items);
            // @bind="_rejectReasons[d.Id]" đọc indexer khi render → seed key trước,
            // nếu không mỗi pending doc ném KeyNotFoundException (crash render/500).
            foreach (var d in _pending)
            {
                _rejectReasons.TryAdd(d.Id, string.Empty);
                // Doc lạ (restricted…) → fallback internal, không bao giờ gửi giá trị lạ lên server.
                _approveClasses[d.Id] = d.Classification is "public" or "internal" or "confidential"
                    ? d.Classification : "internal";
            }
            if (pending == null) SetAlert("Không kết nối được dịch vụ AI — thử Làm mới.", "warning");
            if (_tab == "docs") await LoadDocsPageAsync(reset: true);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadDocsAsync() => await LoadDocsPageAsync(reset: true);

    private async Task LoadDocsPageAsync(bool reset)
    {
        if (reset)
        {
            _page = 1;
            _docs.Clear();
            _expanded.Clear();
            _confirmDeleteId = null;
        }
        _loading = true;
        try
        {
            var list = await AiClient.GetDocumentsAsync(TenantProvider.TenantId,
                string.IsNullOrEmpty(_filterStatus) ? null : _filterStatus, _page, PageSize);
            if (list != null)
            {
                _totalDocs = list.Total;
                _docs.AddRange(list.Items);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMoreDocsAsync()
    {
        _page++;
        await LoadDocsPageAsync(reset: false);
    }

    private void ToggleExpand(Guid id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    // ---------- W3a Auto-Builder ----------

    /// <summary>W3b — ảnh menu → OCR (Gateway ocr-assist kind=menu) → text lines
    /// đổ vào _extractInput để owner kiểm tra rồi chạy Trích xuất như thường.</summary>
    private async Task OnMenuImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || file.Size == 0) return;
        if (file.Size > 6 * 1024 * 1024)
        {
            SetAlert("Ảnh quá lớn — tối đa ~6MB.", "warning");
            return;
        }

        _menuOcrBusy = true;
        try
        {
            await using var stream = file.OpenReadStream(8 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var result = await MenuOcr.ExtractMenuAsync(
                Convert.ToBase64String(ms.ToArray()), file.ContentType);

            if (result is null || result.Items.Count == 0)
            {
                SetAlert("Không đọc được món nào từ ảnh — thử ảnh rõ hơn hoặc nhập tay.", "warning");
                return;
            }

            var lines = string.Join('\n', result.Items.Select(i =>
                i.Price.HasValue ? $"{i.Name} — {i.Price.Value:N0}đ" : i.Name));
            _extractInput = string.IsNullOrWhiteSpace(_extractInput)
                ? lines
                : _extractInput.TrimEnd() + "\n" + lines;
            SetAlert($"Đã đọc {result.Items.Count} món từ ảnh — kiểm tra rồi bấm Trích xuất.", "success");
        }
        finally
        {
            _menuOcrBusy = false;
        }
    }

    /// <summary>W3c — URL website → fetch text (SSRF-guarded) → đổ vào
    /// _extractInput để owner kiểm tra rồi chạy Trích xuất như thường.</summary>
    private async Task FetchWebsiteAsync()
    {
        _webFetching = true;
        try
        {
            var result = await WebExtractor.ExtractAsync(_websiteUrl.Trim());
            if (result is null || string.IsNullOrWhiteSpace(result.Text))
            {
                SetAlert(result?.Warning ?? "Không tải được nội dung — kiểm tra URL hoặc copy text thủ công.", "warning");
                return;
            }
            _extractInput = string.IsNullOrWhiteSpace(_extractInput)
                ? result.Text
                : _extractInput.TrimEnd() + "\n\n" + result.Text;
            SetAlert($"Đã lấy {result.Text.Length:N0} ký tự từ website — kiểm tra rồi bấm Trích xuất."
                + (result.Warning is not null ? $" ⚠️ {result.Warning}" : string.Empty),
                result.Warning is not null ? "warning" : "success");
        }
        finally
        {
            _webFetching = false;
        }
    }

    private async Task ExtractAsync()
    {
        _extracting = true;
        try
        {
            var result = await AiClient.ExtractKnowledgeAsync(
                TenantProvider.TenantId, _extractInput.Trim(), _extractHint);
            if (result is null)
            {
                SetAlert("Trích xuất thất bại — dịch vụ AI đang tạm nghỉ, thử lại sau.", "error");
                _extractResult = null;
                return;
            }
            _extractResult = result;
            _extractDocContent = BuildExtractDocContent(result);
        }
        finally
        {
            _extracting = false;
        }
    }

    private static string BuildExtractDocContent(TenantAiExtractResponse r)
    {
        var sb = new System.Text.StringBuilder();
        if (!string.IsNullOrWhiteSpace(r.Summary)) sb.AppendLine(r.Summary).AppendLine();
        foreach (var i in r.Items)
            sb.AppendLine($"[{KindLabel(i.Kind)}] {i.Title}: {i.Content}");
        return sb.ToString().Trim();
    }

    private async Task ConfirmExtractAsync()
    {
        if (_extractResult is null) return;
        _busy = true;
        try
        {
            var title = $"Trích xuất tự động — {DateTime.Now:dd/MM/yyyy HH:mm}";
            var ok = await AiClient.IngestDocumentAsync(TenantProvider.TenantId,
                _extractDocType, title, _extractDocContent.Trim(), "public",
                sourceRef: $"extract:{Guid.NewGuid():N}");
            if (!ok)
            {
                SetAlert("Đưa vào hàng chờ thất bại — thử lại sau.", "error");
                return;
            }
            SetAlert($"Đã đưa tài liệu trích xuất ({_extractResult.Items.Count} mục) vào hàng chờ duyệt.", "success");
            _extractResult = null;
            _extractInput = string.Empty;
            _extractDocContent = string.Empty;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UploadAsync()
    {
        _busy = true;
        try
        {
            var ok = await AiClient.IngestDocumentAsync(TenantProvider.TenantId,
                _uploadType, _uploadTitle.Trim(), _uploadContent.Trim(), _uploadClassification);
            if (!ok)
            {
                SetAlert("Gửi tài liệu thất bại — kiểm tra loại/nội dung hoặc dịch vụ AI đang tạm nghỉ.", "error");
                return;
            }
            SetAlert($"Đã gửi \"{_uploadTitle.Trim()}\" vào hàng chờ duyệt.", "success");
            _uploadTitle = string.Empty;
            _uploadContent = string.Empty;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApproveAsync(TenantAiDocItem doc)
    {
        _busy = true;
        try
        {
            var cls = _approveClasses.TryGetValue(doc.Id, out var c) ? c : null;
            var ok = await AiClient.ApproveDocumentAsync(TenantProvider.TenantId, doc.Id, cls);
            SetAlert(ok
                ? $"Đã duyệt \"{doc.Title}\" — AI có thể dùng nội dung này trả lời khách."
                : "Duyệt thất bại — tài liệu có thể đã được xử lý hoặc dịch vụ AI tạm nghỉ.",
                ok ? "success" : "error");
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejectAsync(TenantAiDocItem doc)
    {
        var reason = _rejectReasons.TryGetValue(doc.Id, out var r) ? r.Trim() : string.Empty;
        if (reason.Length == 0)
        {
            SetAlert("Nhập lý do từ chối trước khi bấm Từ chối.", "warning");
            return;
        }
        _busy = true;
        try
        {
            var ok = await AiClient.RejectDocumentAsync(TenantProvider.TenantId, doc.Id, reason);
            SetAlert(ok ? $"Đã từ chối \"{doc.Title}\"." : "Từ chối thất bại — thử lại sau.",
                ok ? "success" : "error");
            if (ok) _rejectReasons.Remove(doc.Id);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(TenantAiDocItem doc)
    {
        _confirmDeleteId = null;
        _busy = true;
        try
        {
            var ok = await AiClient.DeleteDocumentAsync(TenantProvider.TenantId, doc.Id);
            SetAlert(ok ? $"Đã xóa \"{doc.Title}\"." : "Xóa thất bại — thử lại sau.",
                ok ? "success" : "error");
            await ReloadDocsAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetAlert(string message, string variant)
    {
        _alert = message;
        _alertVariant = variant;
    }
}
