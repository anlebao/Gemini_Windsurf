@page "/admin/shops"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Web
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Authorization
@using VanAn.CoreHub.Services
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.ShopERP.Infrastructure
@using Microsoft.EntityFrameworkCore
@inject ShopERPDbContext DbContext
@inject ITenantManagementService TenantService
@inject IThemeProvider ThemeProvider
@inject ILogger<ShopsAdmin> Logger

@attribute [Authorize(Policy = "SystemAdmin")]

<div class="shops-admin-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Quản lý Cửa Hàng</h1>
        <div class="header-actions">
            <VanAButton Variant="primary" Size="small" OnClick="OpenCreateModal">
                + Thêm cửa hàng
            </VanAButton>
            <VanAButton Variant="secondary" Size="small" OnClick="LoadData">
                Làm mới
            </VanAButton>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Type="@_alertType" Message="@_alertMessage" OnClose="() => _alertMessage = string.Empty" />
    }

    @if (_isLoading)
    {
        <VanACard>
            <div class="loading-state">
                <VanASpinner Size="large" />
                <p>Đang tải danh sách cửa hàng...</p>
            </div>
        </VanACard>
    }
    else if (_items.Count == 0)
    {
        <VanACard>
            <div class="empty-state">
                <p>Chưa có cửa hàng nào. Nhấn "+ Thêm cửa hàng" để bắt đầu.</p>
            </div>
        </VanACard>
    }
    else
    {
        <VanACard Header="@($"Danh sách Cửa Hàng ({_items.Count})")">
            <table class="vanan-table">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Tenant</th>
                        <th>Địa chỉ</th>
                        <th>Điện thoại</th>
                        <th>Tọa độ</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td>@GetTenantName(item.TenantId.Value)</td>
                            <td>@(item.Address ?? "-")</td>
                            <td>@(item.Phone ?? "-")</td>
                            <td>
                                @if (item.Latitude.HasValue && item.Longitude.HasValue)
                                {
                                    <small>@item.Latitude.Value.ToString("F4"), @item.Longitude.Value.ToString("F4")</small>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có</span>
                                }
                            </td>
                            <td>
                                <span class="status-badge status-@(item.IsActive ? "active" : "inactive")">
                                    @(item.IsActive ? "Hoạt động" : "Tạm dừng")
                                </span>
                            </td>
                            <td class="action-cell">
                                <VanAButton Variant="info" Size="small" OnClick="() => OpenEditModal(item)">
                                    Sửa
                                </VanAButton>
                                <VanAButton Variant="danger" Size="small" OnClick="() => DeleteShop(item)">
                                    Xoá
                                </VanAButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </VanACard>
    }
</div>

@if (_showModal)
{
    <VanAModal Title="@(_isEdit ? "Sửa Cửa Hàng" : "Thêm Cửa Hàng")"
               IsVisible="true" OnClose="CloseModal" Size="medium">
        <Body>
            <VanAForm OnValidSubmit="HandleSubmit">
                <div class="form-group">
                    <label>Tenant *</label>
                    <select class="vanan-input" @bind="_form.TenantId" disabled="@_isEdit">
                        <option value="@Guid.Empty">-- Chọn Tenant --</option>
                        @foreach (var t in _tenants)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <VanAInput Id="shop-name" Label="Tên cửa hàng *"
                               Value="@_form.Name"
                               ValueChanged="v => _form.Name = v"
                               Placeholder="Vạn An Cafe Q.1" Required="true" />
                </div>
                <div class="form-group">
                    <VanAInput Id="shop-address" Label="Địa chỉ"
                               Value="@_form.Address"
                               ValueChanged="v => _form.Address = v"
                               Placeholder="123 Lê Lợi, Q.1, TP.HCM" />
                </div>
                <div class="form-group">
                    <VanAInput Id="shop-phone" Label="Điện thoại"
                               Value="@_form.Phone"
                               ValueChanged="v => _form.Phone = v"
                               Placeholder="0901234567" />
                </div>
                <div class="form-group">
                    <VanAInput Id="shop-email" Label="Email"
                               Value="@_form.Email"
                               ValueChanged="v => _form.Email = v"
                               Placeholder="contact@vanan.vn" />
                </div>
                <div class="form-group">
                    <VanAInput Id="shop-lat" Label="Vĩ độ (Latitude)"
                               Value="@(_form.Latitude?.ToString() ?? "")"
                               ValueChanged="v => _form.Latitude = double.TryParse(v, out var lat) ? lat : null"
                               Placeholder="10.7769" Type="number" Step="0.0001" />
                </div>
                <div class="form-group">
                    <VanAInput Id="shop-lng" Label="Kinh độ (Longitude)"
                               Value="@(_form.Longitude?.ToString() ?? "")"
                               ValueChanged="v => _form.Longitude = double.TryParse(v, out var lng) ? lng : null"
                               Placeholder="106.7009" Type="number" Step="0.0001" />
                </div>
                <div class="form-group">
                    <label>Hoạt động</label>
                    <input type="checkbox" @bind="_form.IsActive" />
                </div>
                <div class="form-actions">
                    <VanAButton Variant="primary" OnClick="HandleSubmit">Lưu</VanAButton>
                    <VanAButton Variant="outline" OnClick="CloseModal">Huỷ</VanAButton>
                </div>
            </VanAForm>
        </Body>
    </VanAModal>
}

@code {
    private List<Shop> _items = new();
    private List<TenantInfo> _tenants = new();
    private bool _isLoading = true;
    private bool _showModal;
    private bool _isEdit;
    private string _alertMessage = string.Empty;
    private string _alertType = "info";
    private Guid? _editId;

    private ShopForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            // SystemAdmin sees all shops (IgnoreQueryFilters — SystemAdmin JWT has tenant_id=Empty
            // which would filter out all shops via global query filter)
            _items = await DbContext.Shops
                .IgnoreQueryFilters()
                .ToListAsync();

            _tenants = (await TenantService.ListTenantsAsync())
                .Select(t => new TenantInfo { Id = t.Id, Name = t.Name })
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load shops");
            _alertMessage = $"Lỗi tải dữ liệu: {ex.Message}";
            _alertType = "danger";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetTenantName(Guid tenantId)
    {
        var t = _tenants.FirstOrDefault(x => x.Id == tenantId);
        return t?.Name ?? tenantId.ToString()[..8];
    }

    private void OpenCreateModal()
    {
        _isEdit = false;
        _editId = null;
        _form = new ShopForm { IsActive = true };
        _showModal = true;
    }

    private void OpenEditModal(Shop item)
    {
        _isEdit = true;
        _editId = item.Id;
        _form = new ShopForm
        {
            TenantId = item.TenantId.Value,
            Name = item.Name,
            Address = item.Address,
            Phone = item.Phone,
            Email = item.Email,
            Latitude = item.Latitude,
            Longitude = item.Longitude,
            IsActive = item.IsActive
        };
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task HandleSubmit()
    {
        try
        {
            if (_form.TenantId == Guid.Empty)
            {
                _alertMessage = "Vui lòng chọn Tenant";
                _alertType = "danger";
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.Name))
            {
                _alertMessage = "Vui lòng nhập tên cửa hàng";
                _alertType = "danger";
                return;
            }

            if (_isEdit && _editId.HasValue)
            {
                var existing = await DbContext.Shops
                    .IgnoreQueryFilters()
                    .FirstOrDefaultAsync(s => s.Id == _editId.Value);
                if (existing == null)
                {
                    _alertMessage = "Không tìm thấy cửa hàng để sửa";
                    _alertType = "danger";
                    return;
                }

                existing.UpdateShopDetails(_form.Name, _form.Address, _form.Phone, _form.Email, _form.IsActive);
                if (_form.Latitude.HasValue && _form.Longitude.HasValue)
                {
                    existing.SetCoordinates(_form.Latitude.Value, _form.Longitude.Value);
                }
                await DbContext.SaveChangesAsync();
                _alertMessage = "Đã cập nhật cửa hàng.";
            }
            else
            {
                var shop = new Shop(
                    new TenantId(_form.TenantId),
                    _form.Name,
                    _form.Address ?? string.Empty,
                    _form.Phone ?? string.Empty,
                    _form.Email ?? string.Empty);

                if (_form.Latitude.HasValue && _form.Longitude.HasValue)
                {
                    shop.SetCoordinates(_form.Latitude.Value, _form.Longitude.Value);
                }

                DbContext.Shops.Add(shop);
                await DbContext.SaveChangesAsync();
                _alertMessage = "Đã tạo cửa hàng mới.";
            }
            _alertType = "success";
            _showModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save shop");
            _alertMessage = $"Lỗi: {ex.Message}";
            _alertType = "danger";
        }
    }

    private async Task DeleteShop(Shop item)
    {
        try
        {
            var existing = await DbContext.Shops
                .IgnoreQueryFilters()
                .FirstOrDefaultAsync(s => s.Id == item.Id);
            if (existing != null)
            {
                DbContext.Shops.Remove(existing);
                await DbContext.SaveChangesAsync();
            }
            _alertMessage = $"Đã xoá cửa hàng '{item.Name}'.";
            _alertType = "success";
            await LoadData();
        }
        catch (Exception ex)
        {
            _alertMessage = $"Lỗi xoá: {ex.Message}";
            _alertType = "danger";
        }
    }

    private class ShopForm
    {
        public Guid TenantId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private class TenantInfo
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
