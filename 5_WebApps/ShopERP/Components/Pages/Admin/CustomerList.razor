@page "/admin/customers"
@rendermode InteractiveServer
@layout AdminLayout
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Authorization
@using VanAn.Shared.Domain
@using VanAn.CoreHub.Services
@using VanAn.CoreHub.Domain.Repositories
@using VanAn.Shared.Services
@inject IPromoCampaignService PromoCampaignService
@inject ICustomerSegmentationService CustomerSegmentationService
@inject ICustomerRepository CustomerRepository
@inject ILoyaltyRewardsService LoyaltyRewardsService
@inject IPushSubscriptionRepository PushSubscriptionRepository
@inject ILogger<CustomerList> Logger

@attribute [Authorize(Policy = "OwnerOnly")]

<div class="customer-list-admin-page">
    <header class="page-header">
        <h1><i class="bi bi-people-fill"></i> Khách hàng (CRM)</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" OnClick="LoadCustomers">Làm mới</VanAButton>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Type="@_alertType" Message="@_alertMessage" OnClose="() => _alertMessage = string.Empty" />
    }

    @* === Filter Bar === *@
    <VanACard Title="Bộ lọc khách hàng">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Điểm thưởng từ</label>
                <input type="number" class="form-control" @bind="_filterMinPoints" placeholder="0" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Điểm thưởng đến</label>
                <input type="number" class="form-control" @bind="_filterMaxPoints" placeholder="∞" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Lần mua gần nhất (trong N ngày)</label>
                <input type="number" class="form-control" @bind="_filterLastOrderDays" placeholder="vd: 30" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Sinh nhật trong tháng</label>
                <select class="form-select" @bind="_filterBirthdayMonth">
                    <option value="0">— Tất cả —</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">Tháng @m</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Doanh số từ (VND)</label>
                <input type="number" class="form-control" @bind="_filterMinSpent" placeholder="0" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Doanh số đến (VND)</label>
                <input type="number" class="form-control" @bind="_filterMaxSpent" placeholder="∞" />
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <VanAButton Variant="primary" OnClick="ApplyFilter">Lọc</VanAButton>
                <VanAButton Variant="secondary" OnClick="ClearFilter">Xóa lọc</VanAButton>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2 flex-wrap">
                <VanAButton Variant="primary" OnClick="OpenPromoModalFromFilter" Disabled="@(_filteredCustomers.Count == 0)">
                    <i class="bi bi-megaphone"></i> Gửi theo lọc (@_filteredCustomers.Count)
                </VanAButton>
                <VanAButton Variant="primary" OnClick="OpenPromoModalFromSelection" Disabled="@(_selectedCustomerIds.Count == 0)">
                    <i class="bi bi-send"></i> Gửi cho @_selectedCustomerIds.Count đã chọn
                </VanAButton>
            </div>
        </div>
    </VanACard>

    @* === Results Table === *@
    <VanACard Title="Danh sách khách hàng">
        @if (_loading)
        {
            <div class="text-center py-4"><div class="spinner-border"></div></div>
        }
        else if (_displayCustomers.Count == 0)
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox" style="font-size:2rem;"></i>
                <p class="mt-2">Không có khách hàng nào thỏa bộ lọc.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th style="width:40px;">
                                <input type="checkbox" class="form-check-input"
                                       checked="@IsAllOnPageSelected()"
                                       @onchange="ToggleSelectAllOnPage" />
                            </th>
                            <th>Họ tên</th>
                            <th>Điện thoại</th>
                            <th>Hạng</th>
                            <th class="text-end">Điểm</th>
                            <th class="text-end">Tổng chi</th>
                            <th>Lần mua cuối</th>
                            <th>Sinh nhật</th>
                            <th>Định danh</th>
                            <th class="text-center">Push</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _displayCustomers)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input"
                                           checked="@_selectedCustomerIds.Contains(c.Id)"
                                       @onchange="@(e => ToggleRowSelection(c.Id, e.Value))" />
                                </td>
                                <td>@c.FullName</td>
                                <td>@(c.PhoneNumber ?? "—")</td>
                                <td><span class="badge bg-info text-dark">@(string.IsNullOrEmpty(c.CustomerTier) ? "—" : c.CustomerTier)</span></td>
                                <td class="text-end">@c.PointBalance.ToString("N0")</td>
                                <td class="text-end">@c.TotalSpent.ToString("N0")</td>
                                <td>@(c.LastOrderDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>@(c.Birthday?.ToString("dd/MM") ?? "—")</td>
                                <td>@c.IdentityLevel</td>
                                <td class="text-center">
                                    @if (c.HasPushSubscription)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Đã đăng ký push"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle text-muted" title="Chưa đăng ký push"></i>
                                    }
                                </td>
                                <td class="text-center">
                                    <VanAButton Variant="secondary" OnClick="@(() => OpenPromoModalForSingle(c))">
                                        <i class="bi bi-send"></i> Gửi
                                    </VanAButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="text-muted small">
                    Hiển thị @_displayCustomers.Count / @_filteredCustomers.Count khách
                    @if (_selectedCustomerIds.Count > 0)
                    {
                        <text> · Đã chọn @_selectedCustomerIds.Count</text>
                    }
                </span>
                <div class="btn-group">
                    <VanAButton Variant="secondary" OnClick="PrevPage" Disabled="@(_page <= 1)">‹ Trước</VanAButton>
                    <VanAButton Variant="secondary" OnClick="NextPage" Disabled="@(_page >= _totalPages)">Sau ›</VanAButton>
                </div>
            </div>
        }
    </VanACard>

    @* === Promo Push Composer Modal (AF-P3-T1: extracted to PromoPushComposer.razor) === *@
    <PromoPushComposer
        Show="@_showPromoModal"
        RecipientCount="@_promoSelectionCount"
        IsSubmitting="@_promoSubmitting"
        ErrorMessage="@_promoError"
        OnSubmit="SubmitPromoAsync"
        OnClose="ClosePromoModal" />
</div>

@code {
    private bool _loading = true;
    private string _alertMessage = string.Empty;
    private string _alertType = "info";
    private List<CustomerRow> _filteredCustomers = new();
    private List<CustomerRow> _displayCustomers = new();
    private int _page = 1;
    private const int PageSize = 20;
    private int _totalPages = 1;

    // Filter state
    private int? _filterMinPoints;
    private int? _filterMaxPoints;
    private int? _filterLastOrderDays;
    private int _filterBirthdayMonth;
    private decimal? _filterMinSpent;
    private decimal? _filterMaxSpent;

    // AF-P2-T2: selection state (across all pages — survives pagination)
    private HashSet<Guid> _selectedCustomerIds = new();

    // Promo modal state (AF-P3-T1: form fields moved to PromoPushComposer; parent owns visibility/submitting/error)
    private bool _showPromoModal;
    private PromoMode _promoMode = PromoMode.Filter;
    private int _promoSelectionCount;
    private List<Guid>? _promoSelectionIds;
    private string? _promoError;
    private bool _promoSubmitting;

    private enum PromoMode { Filter, Selection }

    protected override async Task OnInitializedAsync()
    {
        _filterBirthdayMonth = DateTime.UtcNow.Month; // Default = current month
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _loading = true;
        try
        {
            bool hasFilter = _filterMinPoints.HasValue || _filterMaxPoints.HasValue ||
                             _filterLastOrderDays.HasValue || _filterBirthdayMonth > 0 ||
                             _filterMinSpent.HasValue || _filterMaxSpent.HasValue;

            var criteria = new CustomerSegmentCriteria(
                MinPointBalance: _filterMinPoints,
                MaxPointBalance: _filterMaxPoints,
                LastOrderWithinDays: _filterLastOrderDays,
                BirthdayMonth: _filterBirthdayMonth > 0 ? _filterBirthdayMonth : null,
                MinTotalSpent: _filterMinSpent,
                MaxTotalSpent: _filterMaxSpent);

            IReadOnlyList<Customer> customers = hasFilter
                ? await CustomerSegmentationService.GetCustomersBySegmentAsync(criteria)
                : await CustomerRepository.GetAllActiveAsync();

            // AF-P2-T5: batch-load push subscription CustomerIds once per load
            var pushSubs = await PushSubscriptionRepository.GetAllActiveAsync();
            var pushCustomerIds = new HashSet<Guid>(pushSubs.Count);
            foreach (var ps in pushSubs)
            {
                if (ps.IsActive && !ps.IsDeleted) pushCustomerIds.Add(ps.CustomerId);
            }

            // Enrich with loyalty point balance + push subscription flag
            _filteredCustomers = new List<CustomerRow>(customers.Count);
            foreach (var c in customers)
            {
                var rewards = await LoyaltyRewardsService.GetCustomerRewardsAsync(c.Id);
                _filteredCustomers.Add(new CustomerRow
                {
                    Id = c.Id,
                    FullName = c.FullName,
                    PhoneNumber = c.PhoneNumber,
                    CustomerTier = c.CustomerTier,
                    PointBalance = rewards?.PointBalance ?? 0,
                    TotalSpent = c.TotalSpent,
                    LastOrderDate = c.LastOrderDate,
                    Birthday = c.Birthday,
                    IdentityLevel = c.IdentityLevel.ToString(),
                    IsActive = c.IsActive,
                    HasPushSubscription = pushCustomerIds.Contains(c.Id)
                });
            }

            // Prune selection for customers no longer in the filtered set
            _selectedCustomerIds.RemoveWhere(id => !_filteredCustomers.Exists(c => c.Id == id));

            ApplyPagination();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load customers");
            _alertMessage = $"Lỗi: {ex.Message}";
            _alertType = "danger";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyPagination()
    {
        _totalPages = Math.Max(1, (int)Math.Ceiling((double)_filteredCustomers.Count / PageSize));
        _displayCustomers = _filteredCustomers
            .Skip((_page - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private async Task ApplyFilter()
    {
        _page = 1;
        await LoadCustomers();
    }

    private async Task ClearFilter()
    {
        _filterMinPoints = null;
        _filterMaxPoints = null;
        _filterLastOrderDays = null;
        _filterBirthdayMonth = DateTime.UtcNow.Month;
        _filterMinSpent = null;
        _filterMaxSpent = null;
        _page = 1;
        await LoadCustomers();
    }

    private void PrevPage()
    {
        if (_page > 1) { _page--; ApplyPagination(); }
    }

    private void NextPage()
    {
        if (_page < _totalPages) { _page++; ApplyPagination(); }
    }

    // === AF-P2-T2: selection helpers ===

    private bool IsAllOnPageSelected() =>
        _displayCustomers.Count > 0 && _displayCustomers.All(c => _selectedCustomerIds.Contains(c.Id));

    private void ToggleSelectAllOnPage(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        bool checkedNow = (bool)e.Value;
        foreach (var c in _displayCustomers)
        {
            if (checkedNow) _selectedCustomerIds.Add(c.Id);
            else _selectedCustomerIds.Remove(c.Id);
        }
    }

    private void ToggleRowSelection(Guid id, object? value)
    {
        bool checkedNow = value is bool b && b;
        if (checkedNow) _selectedCustomerIds.Add(id);
        else _selectedCustomerIds.Remove(id);
    }

    // === AF-P2-T1/T2: promo modal openers (AF-P3-T1: form state owned by PromoPushComposer) ===

    private void OpenPromoModalFromFilter()
    {
        _promoMode = PromoMode.Filter;
        _promoSelectionIds = null;
        _promoSelectionCount = _filteredCustomers.Count;
        _promoError = null;
        _showPromoModal = true;
    }

    private void OpenPromoModalFromSelection()
    {
        if (_selectedCustomerIds.Count == 0) return;
        _promoMode = PromoMode.Selection;
        _promoSelectionIds = _selectedCustomerIds.ToList();
        _promoSelectionCount = _promoSelectionIds.Count;
        _promoError = null;
        _showPromoModal = true;
    }

    private void OpenPromoModalForSingle(CustomerRow c)
    {
        _promoMode = PromoMode.Selection;
        _promoSelectionIds = new List<Guid> { c.Id };
        _promoSelectionCount = 1;
        _promoError = null;
        _showPromoModal = true;
    }

    private void ClosePromoModal()
    {
        _showPromoModal = false;
        _promoError = null;
    }

    // AF-P3-T1: receives composed payload from PromoPushComposer. Validation runs here so the
    // composer stays free of business rules; error string flows back via ErrorMessage parameter.
    private async Task SubmitPromoAsync(PromoPushComposer.PromoPushPayload payload)
    {
        _promoError = null;
        if (string.IsNullOrWhiteSpace(payload.Title))
        {
            _promoError = "Vui lòng nhập tiêu đề.";
            return;
        }
        if (string.IsNullOrWhiteSpace(payload.Message))
        {
            _promoError = "Vui lòng nhập nội dung thông báo.";
            return;
        }

        _promoSubmitting = true;
        try
        {
            PromoCampaign campaign;
            if (_promoMode == PromoMode.Selection && _promoSelectionIds is { Count: > 0 })
            {
                // AF-P2-T1/T2: explicit recipient list
                campaign = await PromoCampaignService.CreateCampaignAsync(
                    payload.Title, payload.Message,
                    string.IsNullOrWhiteSpace(payload.Url) ? null : payload.Url,
                    _promoSelectionIds);
            }
            else
            {
                // Existing filter-segment flow
                var criteria = new CustomerSegmentCriteria(
                    MinPointBalance: _filterMinPoints,
                    MaxPointBalance: _filterMaxPoints,
                    LastOrderWithinDays: _filterLastOrderDays,
                    BirthdayMonth: _filterBirthdayMonth > 0 ? _filterBirthdayMonth : null,
                    MinTotalSpent: _filterMinSpent,
                    MaxTotalSpent: _filterMaxSpent);

                campaign = await PromoCampaignService.CreateCampaignAsync(
                    payload.Title, payload.Message,
                    string.IsNullOrWhiteSpace(payload.Url) ? null : payload.Url,
                    criteria);
            }

            _showPromoModal = false;
            _alertMessage = $"Đã tạo chiến dịch '{payload.Title}' với {campaign.TotalRecipients} người nhận. Đang xử lý — xem tiến độ tại /admin/promo-campaigns.";
            _alertType = "success";
        }
        catch (InvalidOperationException ex)
        {
            _promoError = ex.Message;
        }
        catch (Exception ex)
        {
            _promoError = $"Lỗi: {ex.Message}";
        }
        finally
        {
            _promoSubmitting = false;
        }
    }

    private class CustomerRow
    {
        public Guid Id { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string? PhoneNumber { get; set; }
        public string CustomerTier { get; set; } = string.Empty;
        public int PointBalance { get; set; }
        public decimal TotalSpent { get; set; }
        public DateTime? LastOrderDate { get; set; }
        public DateTime? Birthday { get; set; }
        public string IdentityLevel { get; set; } = string.Empty;
        public bool IsActive { get; set; }
        public bool HasPushSubscription { get; set; }
    }
}
