@page "/admin/reconcile"
@rendermode InteractiveServer
@layout AdminLayout
@attribute [Authorize(Policy = "SystemAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.CoreHub.Services.Reconcile
@using VanAn.CoreHub.Infrastructure.Entities
@using VanAn.Shared.Domain
@using VanAn.ShopERP.Services
@inject ReconcileAdminApiClient ReconcileApi
@inject TenantApiClient TenantApi
@inject IReconciliationItemService ReconItemService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Reconcile> Logger

<div class="reconcile-page">
    <header class="page-header">
        <h1><i class="bi bi-clipboard2-check"></i> Tra soát số liệu kế toán</h1>
        <div class="header-actions">
            @if (_result is not null)
            {
                <VanAButton Variant="secondary" Size="small" OnClick="RunAsync" IsLoading="@_isRunning" data-testid="btn-rerun-reconcile">
                    Chạy lại
                </VanAButton>
            }
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Variant="@_alertType" Message="@_alertMessage" Dismissible="true" OnDismiss="() => _alertMessage = string.Empty" />
    }

    @* Form chọn tenant + kỳ *@
    <VanACard>
        <ChildContent>
            <div class="row">
                <div class="col-md-5 form-group">
                    <label for="rc-tenant">Tenant</label>
                    <select id="rc-tenant" class="vanan-select" @bind="_tenantId" data-testid="rc-tenant">
                        <option value="">— chọn tenant —</option>
                        @foreach (var t in _tenants)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 form-group">
                    <VanAInput Id="rc-period" Label="Kỳ (YYYY-MM)" Value="@_period" ValueChanged="v => _period = v" />
                </div>
                <div class="col-md-4 form-group d-flex align-items-end">
                    <VanAButton Variant="primary" OnClick="RunAsync" IsLoading="@_isRunning" data-testid="btn-run-reconcile">
                        Tra soát
                    </VanAButton>
                </div>
            </div>
        </ChildContent>
    </VanACard>

    @if (_isRunning)
    {
        <VanACard>
            <ChildContent>
                <div class="loading-state"><VanASpinner Size="large" /><p>Đang chạy tra soát R1-R12...</p></div>
            </ChildContent>
        </VanACard>
    }
    else if (_result is not null)
    {
        @* Summary 4 thẻ *@
        <div class="row mb-3" data-testid="rc-summary">
            <div class="col-md-3"><VanAMetricsCard Title="Tổng check" Value="@_result.Summary.Total.ToString()" Icon="list-check" Color="primary" /></div>
            <div class="col-md-3"><VanAMetricsCard Title="Pass" Value="@_result.Summary.Pass.ToString()" Icon="check-circle" Color="success" /></div>
            <div class="col-md-3"><VanAMetricsCard Title="Warning" Value="@_result.Summary.Warning.ToString()" Icon="exclamation-triangle" Color="warning" /></div>
            <div class="col-md-3"><VanAMetricsCard Title="Error" Value="@_result.Summary.Error.ToString()" Icon="x-octagon" Color="error" /></div>
        </div>
        <p class="text-muted" data-testid="rc-meta">
            Kỳ @_result.Period · @_result.TenantName · chạy lúc @_result.RanAt.ToString("yyyy-MM-dd HH:mm:ss") UTC
        </p>

        @* Checks table *@
        <VanACard Header="Kết quả kiểm tra (R1-R12)">
            <ChildContent>
                <table class="vanan-table" data-testid="rc-checks-table">
                    <thead>
                        <tr><th>Mã</th><th>Check</th><th>Mức</th><th>Số liệu</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _result.Checks)
                        {
                            <tr data-testid="rc-check-row">
                                <td><code>@c.Code</code></td>
                                <td>@c.Name</td>
                                <td><span class="rc-badge rc-badge-@c.Level.ToString().ToLowerInvariant()" data-testid="rc-level-@c.Level.ToString().ToLowerInvariant()">@c.Level</span></td>
                                <td>@c.Summary</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(c.Details))
                                    {
                                        <details><summary>Chi tiết</summary><pre class="rc-details">@c.Details</pre></details>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </ChildContent>
        </VanACard>

        @if (_result.Suggestions.Count > 0)
        {
            <VanACard Header="Gợi ý khắc phục">
                <ChildContent>
                    <ul class="rc-suggestions" data-testid="rc-suggestions">
                        @foreach (var s in _result.Suggestions)
                        {
                            <li>@s</li>
                        }
                    </ul>
                </ChildContent>
            </VanACard>
        }
    }

    @* W5/F (FR-RECNC-005): ReconciliationItems — chênh lệch phát sinh từ tra soát
       cần workflow xử lý (assign → resolve/dismiss; check pass lần sau → auto-resolve). *@
    @if (Guid.TryParse(_tenantId, out _))
    {
        <VanACard Header="Chênh lệch cần xử lý (Reconciliation Items)">
            <ChildContent>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label class="mb-0">Trạng thái:</label>
                    <select class="vanan-select" style="max-width: 200px" @bind="_itemStatusFilter"
                            data-testid="rc-items-status-filter">
                        <option value="">Tất cả</option>
                        <option value="Open">Open</option>
                        <option value="Investigating">Investigating</option>
                        <option value="Resolved">Resolved</option>
                        <option value="Dismissed">Dismissed</option>
                    </select>
                    <VanAButton Variant="secondary" Size="small" OnClick="LoadItemsAsync"
                                IsLoading="@_itemsLoading" data-testid="rc-items-refresh">
                        Làm mới
                    </VanAButton>
                </div>
                @if (_itemsLoading)
                {
                    <p class="text-muted">Đang tải...</p>
                }
                else if (_items.Count == 0)
                {
                    <p class="text-muted" data-testid="rc-items-empty">Không có chênh lệch nào.</p>
                }
                else
                {
                    <table class="vanan-table" data-testid="rc-items-table">
                        <thead>
                            <tr>
                                <th>Check</th><th>Kỳ</th><th>Mức</th><th>Nội dung</th>
                                <th>Trạng thái</th><th>Phụ trách</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr data-testid="rc-item-row">
                                    <td><code>@item.CheckCode</code></td>
                                    <td>@($"{item.PeriodYear}-{item.PeriodMonth:D2}")</td>
                                    <td><span class="rc-badge rc-badge-@item.Severity">@item.Severity</span></td>
                                    <td>
                                        @item.Description
                                        @if (!string.IsNullOrEmpty(item.ResolutionNote))
                                        {
                                            <div class="text-muted small">Ghi chú: @item.ResolutionNote</div>
                                        }
                                    </td>
                                    <td><span class="badge text-bg-@(item.Status is "Resolved" ? "success" : item.Status is "Dismissed" ? "secondary" : item.Status is "Investigating" ? "info" : "warning")">@item.Status</span></td>
                                    <td>@(item.AssignedTo ?? "—")@(item.ResolvedBy is not null ? $" · {item.ResolvedBy}" : "")</td>
                                    <td>
                                        @if (item.Status is "Open" or "Investigating")
                                        {
                                            <div class="d-flex gap-1">
                                                <input class="form-control form-control-sm" style="width: 130px"
                                                       placeholder="Người xử lý"
                                                       @bind="_assignNames[item.Id]"
                                                       data-testid="rc-item-assign-input" />
                                                <VanAButton Variant="secondary" Size="small"
                                                            OnClick="() => AssignItemAsync(item.Id)"
                                                            data-testid="rc-item-assign">
                                                    Giao
                                                </VanAButton>
                                                <VanAButton Variant="primary" Size="small"
                                                            OnClick="() => OpenResolveModal(item)"
                                                            data-testid="rc-item-resolve">
                                                    Xong
                                                </VanAButton>
                                                <VanAButton Variant="secondary" Size="small"
                                                            OnClick="() => OpenDismissModal(item)"
                                                            data-testid="rc-item-dismiss">
                                                    Bỏ qua
                                                </VanAButton>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </ChildContent>
        </VanACard>
    }

    @* Modal ghi chú resolve/dismiss *@
    <VanAModal Title="@(_itemModalMode == "resolve" ? "Đánh dấu đã xử lý" : "Bỏ qua chênh lệch")"
               IsVisible="@_showItemModal" Size="small"
               OnClose="CloseItemModal">
        <Body>
            <div class="form-group">
                <label>Ghi chú xử lý</label>
                <input type="text" class="form-control" @bind="_itemNote"
                       placeholder="Mô tả cách xử lý / lý do bỏ qua..." data-testid="rc-item-note" />
            </div>
        </Body>
        <Footer>
            <VanAButton Variant="secondary" OnClick="CloseItemModal">Huỷ</VanAButton>
            <VanAButton Variant="primary" IsLoading="@_itemActionBusy" OnClick="ConfirmItemActionAsync"
                        data-testid="rc-item-confirm">
                Xác nhận
            </VanAButton>
        </Footer>
    </VanAModal>
</div>

@code {
    private string _tenantId = string.Empty;
    private string _period = $"{DateTime.UtcNow:yyyy-MM}";
    private List<TenantApiDto> _tenants = new();
    private ReconcileResult? _result;
    private bool _isRunning;
    private string _alertMessage = string.Empty;
    private string _alertType = "info";

    // W5/F (FR-RECNC-005): ReconciliationItems workflow state.
    private List<ReconciliationItemEntity> _items = new();
    private Dictionary<Guid, string> _assignNames = new();
    private string _itemStatusFilter = string.Empty;
    private bool _itemsLoading;
    private bool _showItemModal;
    private bool _itemActionBusy;
    private string _itemModalMode = "resolve"; // "resolve" | "dismiss"
    private ReconciliationItemEntity? _modalItem;
    private string _itemNote = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tenants = await TenantApi.ListAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load tenants for reconcile page");
        }
    }

    private async Task RunAsync()
    {
        if (_isRunning) return;
        if (string.IsNullOrWhiteSpace(_tenantId) || !Guid.TryParse(_tenantId, out Guid tid))
        {
            _alertType = "warning";
            _alertMessage = "Chọn tenant trước khi tra soát.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_period) || !System.Text.RegularExpressions.Regex.IsMatch(_period.Trim(), @"^\d{4}-\d{2}$"))
        {
            _alertType = "warning";
            _alertMessage = "Nhập kỳ dạng YYYY-MM (vd: 2026-10).";
            return;
        }

        _isRunning = true;
        _alertMessage = string.Empty;
        try
        {
            _result = await ReconcileApi.RunAsync(tid, _period.Trim());
            // W5/F: run emit ReconciliationItems phía server — reload danh sách.
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reconcile run failed");
            _alertType = "error";
            _alertMessage = $"Chạy tra soát thất bại: {ex.Message}";
        }
        finally
        {
            _isRunning = false;
        }
    }

    // ── W5/F (FR-RECNC-005): ReconciliationItems workflow ────────────────────

    private async Task LoadItemsAsync()
    {
        if (!Guid.TryParse(_tenantId, out Guid tid)) return;
        _itemsLoading = true;
        try
        {
            _items = (await ReconItemService.ListAsync(new TenantId(tid),
                string.IsNullOrWhiteSpace(_itemStatusFilter) ? null : _itemStatusFilter)).ToList();
            foreach (var item in _items)
            {
                _assignNames[item.Id] = item.AssignedTo ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Load reconciliation items failed");
            _alertType = "error";
            _alertMessage = $"Không tải được danh sách chênh lệch: {ex.Message}";
        }
        finally
        {
            _itemsLoading = false;
        }
    }

    private async Task AssignItemAsync(Guid itemId)
    {
        string assignTo = _assignNames.TryGetValue(itemId, out string? name) ? name.Trim() : string.Empty;
        if (string.IsNullOrEmpty(assignTo))
        {
            _alertType = "warning";
            _alertMessage = "Nhập người phụ trách trước khi giao.";
            return;
        }
        try
        {
            await ReconItemService.AssignAsync(itemId, assignTo);
            _alertType = "info";
            _alertMessage = $"Đã giao chênh lệch cho {assignTo}.";
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Assign reconciliation item {ItemId} failed", itemId);
            _alertType = "error";
            _alertMessage = $"Giao việc thất bại: {ex.Message}";
        }
    }

    private void OpenResolveModal(ReconciliationItemEntity item) => OpenItemModal(item, "resolve");
    private void OpenDismissModal(ReconciliationItemEntity item) => OpenItemModal(item, "dismiss");

    private void OpenItemModal(ReconciliationItemEntity item, string mode)
    {
        _modalItem = item;
        _itemModalMode = mode;
        _itemNote = string.Empty;
        _showItemModal = true;
    }

    private void CloseItemModal()
    {
        _showItemModal = false;
        _modalItem = null;
        _itemNote = string.Empty;
    }

    private async Task ConfirmItemActionAsync()
    {
        if (_modalItem is null) return;
        _itemActionBusy = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            string resolvedBy = authState.User.Identity?.Name ?? "systemadmin";
            string? note = string.IsNullOrWhiteSpace(_itemNote) ? null : _itemNote.Trim();
            if (_itemModalMode == "resolve")
            {
                await ReconItemService.ResolveAsync(_modalItem.Id, resolvedBy, note);
            }
            else
            {
                await ReconItemService.DismissAsync(_modalItem.Id, resolvedBy, note);
            }
            _alertType = "info";
            _alertMessage = _itemModalMode == "resolve" ? "Đã đánh dấu chênh lệch đã xử lý." : "Đã bỏ qua chênh lệch.";
            CloseItemModal();
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reconciliation item action failed");
            _alertType = "error";
            _alertMessage = $"Xử lý thất bại: {ex.Message}";
        }
        finally
        {
            _itemActionBusy = false;
        }
    }
}
