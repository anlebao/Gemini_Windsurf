@page "/admin/business-profile"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Authorization
@using VanAn.ShopERP.Services
@using VanAn.CoreHub.Services.FinancialIntelligence.Dtos
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Aggregates.TenantAggregate
@inject FinancialIntelligenceHttpService FiClient
@inject TenantApiClient TenantApi
@inject AuthenticationStateProvider AuthStateProvider
@inject IThemeProvider ThemeProvider
@inject ILogger<BusinessProfile> Logger

@attribute [Authorize(Policy = "FinancialAccess")]

<div class="tenant-management-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Hồ sơ doanh nghiệp</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="LoadAsync">
                Làm mới
            </VanAButton>
        </div>
    </header>

    <VanAAlert Type="info" Dismissible="false">
        <span>
            Khai báo chi phí cố định hàng tháng + sức chứa + mô hình giá của doanh nghiệp.
            Dùng cho phân tích điểm hòa vốn &amp; kinh tế đơn vị.
            Cập nhật bất cứ lúc nào — mỗi lần lưu tăng phiên bản mô hình (BR-006).
        </span>
    </VanAAlert>

    @* 2026-10-03 (Option B): SystemAdmin chọn tenant — hồ sơ doanh nghiệp gắn tenant cụ thể *@
    @if (_isSystemAdmin)
    {
        <div class="mt-3 mb-3">
            <VanACard Header="Chọn tenant để xem hồ sơ (SystemAdmin)">
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <input class="vanan-input" placeholder="Tìm tenant (tên/MST)..." @bind="_tenantSearch" @bind:event="oninput" style="min-width:240px;" aria-label="Tìm tenant" />
                    <select class="vanan-select" style="min-width:340px;" @bind="_selectedTenantIdStr" @bind:after="OnTenantSelected" aria-label="Chọn tenant">
                        <option value="">-- Chọn tenant (Active) --</option>
                        @foreach (var t in FilteredTenants)
                        {
                            <option value="@t.Id">@t.Name @(!string.IsNullOrEmpty(t.TaxCode) ? $"({t.TaxCode})" : "")</option>
                        }
                    </select>
                    <VanAButton Variant="secondary" Size="small" OnClick="LoadTenantsAsync">
                        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                    </VanAButton>
                </div>
                @if (!FilteredTenants.Any())
                {
                    <p class="text-muted small mt-2">Không tìm thấy tenant (chỉ hiện tenant đã verify — Active).</p>
                }
            </VanACard>
        </div>
    }

    @if (_loading)
    {
        <p>Đang tải...</p>
    }
    else if (_loadError)
    {
        <VanAAlert Type="error" Dismissible="false">
            <span>Không tải được hồ sơ. Kiểm tra kết nối Gateway.</span>
        </VanAAlert>
    }
    else if (_isSystemAdmin && SelectedTenantId == null)
    {
        <VanAAlert Type="info" Dismissible="false">
            <span>Vui lòng chọn tenant bên trên để xem / khai báo hồ sơ doanh nghiệp của tenant đó.</span>
        </VanAAlert>
    }
    else
    {
        @if (_existing != null)
        {
            <VanAAlert Type="success" Dismissible="false">
                <span>
                    Hồ sơ hiện tại @(_isSystemAdmin ? $"— <strong>{CurrentTenantLabel}</strong>" : "") — phiên bản @(_existing.Version), cập nhật @_existing.UpdatedAt.ToString("yyyy-MM-dd HH:mm").
                    Tổng chi phí cố định: @FormatVnd(_existing.TotalMonthlyFixedCost).
                </span>
            </VanAAlert>
        }
        else
        {
            <VanAAlert Type="warning" Dismissible="false">
                <span>Chưa có hồ sơ. Điền form bên dưới rồi bấm "Lưu hồ sơ" để tạo mới.</span>
            </VanAAlert>
        }

        <div class="business-profile-form">
            <h2>Chi phí cố định hàng tháng (VND)</h2>
            <div class="form-grid">
                <div class="form-field">
                    <label for="rent">Tiền thuê mặt bằng</label>
                    <input id="rent" type="text" inputmode="numeric" @bind="_rentStr" @onblur="@(() => FormatField(nameof(_rentStr)))" class="form-input" placeholder="0" />
                </div>
                <div class="form-field">
                    <label for="payroll">Lương nhân sự</label>
                    <input id="payroll" type="text" inputmode="numeric" @bind="_payrollStr" @onblur="@(() => FormatField(nameof(_payrollStr)))" class="form-input" placeholder="0" />
                </div>
                <div class="form-field">
                    <label for="utilities">Điện nước + tiện ích</label>
                    <input id="utilities" type="text" inputmode="numeric" @bind="_utilitiesStr" @onblur="@(() => FormatField(nameof(_utilitiesStr)))" class="form-input" placeholder="0" />
                </div>
                <div class="form-field">
                    <label for="marketing">Marketing + quảng cáo</label>
                    <input id="marketing" type="text" inputmode="numeric" @bind="_marketingStr" @onblur="@(() => FormatField(nameof(_marketingStr)))" class="form-input" placeholder="0" />
                </div>
                <div class="form-field">
                    <label for="logistics">Vận chuyển + logistics</label>
                    <input id="logistics" type="text" inputmode="numeric" @bind="_logisticsStr" @onblur="@(() => FormatField(nameof(_logisticsStr)))" class="form-input" placeholder="0" />
                </div>
                <div class="form-field">
                    <label for="other">Chi phí vận hành khác</label>
                    <input id="other" type="text" inputmode="numeric" @bind="_otherStr" @onblur="@(() => FormatField(nameof(_otherStr)))" class="form-input" placeholder="0" />
                </div>
                <div class="form-field">
                    <label for="depreciation">Khấu hao tài sản</label>
                    <input id="depreciation" type="text" inputmode="numeric" @bind="_depreciationStr" @onblur="@(() => FormatField(nameof(_depreciationStr)))" class="form-input" placeholder="0" />
                </div>
            </div>

            <h2>Sức chứa &amp; mô hình giá</h2>
            <div class="form-grid">
                <div class="form-field">
                    <label for="capacity">Sản lượng / ngày (đơn vị)</label>
                    <input id="capacity" type="number" min="0" @bind="_capacity" class="form-input" />
                </div>
                <div class="form-field">
                    <label for="days">Ngày hoạt động / tháng (1-31)</label>
                    <input id="days" type="number" min="1" max="31" @bind="_operatingDays" class="form-input" />
                </div>
                <div class="form-field">
                    <label for="pricing">Mô hình giá</label>
                    <select id="pricing" @bind="_pricingModel" class="form-input">
                        <option value="@PricingModel.FixedPrice">Giá cố định</option>
                        <option value="@PricingModel.DynamicPricing">Giá linh hoạt</option>
                        <option value="@PricingModel.Mixed">Kết hợp</option>
                    </select>
                </div>
            </div>

            <h2>Ghi chú</h2>
            <div class="form-field">
                <label for="notes">Ghi chú thêm (tùy chọn)</label>
                <textarea id="notes" @bind="_notes" class="form-input" rows="3"
                          placeholder="Mô tả giả định chi phí cố định, nguồn số liệu..."></textarea>
            </div>

            <div class="form-summary">
                <p><strong>Tổng chi phí cố định (tháng):</strong> @FormatVnd(_rent + _payroll + _utilities + _marketing + _logistics + _other + _depreciation)</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <VanAAlert Type="error" Dismissible="false">
                    <span>@_errorMessage</span>
                </VanAAlert>
            }

            @if (_saved)
            {
                <VanAAlert Type="success" Dismissible="false">
                    <span>Đã lưu hồ sơ. Phiên bản mô hình đã tăng.</span>
                </VanAAlert>
            }

            <div class="form-actions">
                <VanAButton Variant="primary" OnClick="SaveAsync" Disabled="@_saving">
                    @if (_saving) { <span>Đang lưu...</span> } else { <span>Lưu hồ sơ</span> }
                </VanAButton>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _loadError;
    private bool _saving;
    private bool _saved;
    private string _errorMessage = string.Empty;
    private BusinessProfileDto? _existing;

    // ── 2026-10-03 (Option B): SystemAdmin tenant selector ──
    private bool _isSystemAdmin;
    private List<TenantApiDto> _tenants = [];
    private string _tenantSearch = string.Empty;
    private string _selectedTenantIdStr = string.Empty;
    private Guid? SelectedTenantId => Guid.TryParse(_selectedTenantIdStr, out var g) ? g : null;
    private string CurrentTenantLabel
        => _tenants.FirstOrDefault(t => t.Id == SelectedTenantId)?.Name ?? "—";
    private List<TenantApiDto> FilteredTenants =>
        _tenants.Where(t => string.IsNullOrWhiteSpace(_tenantSearch)
            || t.Name.Contains(_tenantSearch, StringComparison.OrdinalIgnoreCase)
            || (t.TaxCode?.Contains(_tenantSearch, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    // Form fields — decimal backing + formatted string for UI
    private decimal _rent;
    private decimal _payroll;
    private decimal _utilities;
    private decimal _marketing;
    private decimal _logistics;
    private decimal _other;
    private decimal _depreciation;
    private int _capacity;
    private int _operatingDays = 26;
    private PricingModel _pricingModel = PricingModel.FixedPrice;
    private string? _notes;

    // String backing fields for formatted money inputs (Bug C fix)
    private string _rentStr = string.Empty;
    private string _payrollStr = string.Empty;
    private string _utilitiesStr = string.Empty;
    private string _marketingStr = string.Empty;
    private string _logisticsStr = string.Empty;
    private string _otherStr = string.Empty;
    private string _depreciationStr = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isSystemAdmin = authState.User.IsInRole("SystemAdmin");
        if (_isSystemAdmin)
        {
            await LoadTenantsAsync();
        }
        await LoadAsync();
    }

    private async Task LoadTenantsAsync()
    {
        try
        {
            var all = await TenantApi.ListAllAsync();
            _tenants = all.Where(t => t.Status == TenantStatus.Active).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load tenants for SystemAdmin selector");
            _tenants = [];
        }
    }

    private async Task OnTenantSelected() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = false;
        _saved = false;
        _errorMessage = string.Empty;
        try
        {
            // SystemAdmin chưa chọn tenant → prompt thay vì gọi Gateway (tránh 401 nuốt lỗi).
            if (_isSystemAdmin && SelectedTenantId == null)
            {
                _existing = null;
                return;
            }
            _existing = await FiClient.GetBusinessProfileAsync(SelectedTenantId);
            if (_existing != null)
            {
                _rent = _existing.MonthlyRent;
                _payroll = _existing.MonthlyPayroll;
                _utilities = _existing.MonthlyUtilities;
                _marketing = _existing.MonthlyMarketing;
                _logistics = _existing.MonthlyLogistics;
                _other = _existing.MonthlyOtherOpEx;
                _depreciation = _existing.MonthlyDepreciation;
                _capacity = _existing.DailyCapacityUnits;
                _operatingDays = _existing.OperatingDaysPerMonth;
                _pricingModel = _existing.PricingModel;
                _notes = _existing.Notes;
                SyncStringFields();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load BusinessProfile");
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saved = false;
        _errorMessage = string.Empty;
        try
        {
            // Parse string fields to decimal before save
            _rent = ParseMoney(_rentStr);
            _payroll = ParseMoney(_payrollStr);
            _utilities = ParseMoney(_utilitiesStr);
            _marketing = ParseMoney(_marketingStr);
            _logistics = ParseMoney(_logisticsStr);
            _other = ParseMoney(_otherStr);
            _depreciation = ParseMoney(_depreciationStr);

            var dto = new UpdateBusinessProfileDto(
                _rent, _payroll, _utilities, _marketing, _logistics, _other, _depreciation,
                _capacity, _operatingDays, _pricingModel, _notes);
            var result = await FiClient.UpdateBusinessProfileAsync(dto, SelectedTenantId);
            if (result == null)
            {
                _errorMessage = "Lưu thất bại. Kiểm tra kết nối Gateway hoặc thử lại.";
            }
            else
            {
                _existing = result;
                _saved = true;
                SyncStringFields();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save BusinessProfile");
            _errorMessage = $"Lỗi: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Format the string field with thousand separators on blur.</summary>
    private void FormatField(string fieldName)
    {
        var (str, val) = fieldName switch
        {
            nameof(_rentStr) => (_rentStr, _rent),
            nameof(_payrollStr) => (_payrollStr, _payroll),
            nameof(_utilitiesStr) => (_utilitiesStr, _utilities),
            nameof(_marketingStr) => (_marketingStr, _marketing),
            nameof(_logisticsStr) => (_logisticsStr, _logistics),
            nameof(_otherStr) => (_otherStr, _other),
            nameof(_depreciationStr) => (_depreciationStr, _depreciation),
            _ => (string.Empty, 0m),
        };
        var parsed = ParseMoney(str);
        var formatted = parsed.ToString("N0");
        switch (fieldName)
        {
            case nameof(_rentStr): _rent = parsed; _rentStr = formatted; break;
            case nameof(_payrollStr): _payroll = parsed; _payrollStr = formatted; break;
            case nameof(_utilitiesStr): _utilities = parsed; _utilitiesStr = formatted; break;
            case nameof(_marketingStr): _marketing = parsed; _marketingStr = formatted; break;
            case nameof(_logisticsStr): _logistics = parsed; _logisticsStr = formatted; break;
            case nameof(_otherStr): _other = parsed; _otherStr = formatted; break;
            case nameof(_depreciationStr): _depreciation = parsed; _depreciationStr = formatted; break;
        }
    }

    /// <summary>Parse money string (handles thousand separators, spaces, "đ" suffix).</summary>
    private static decimal ParseMoney(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return 0m;
        // Remove everything except digits and decimal point
        var clean = s.Replace(",", "").Replace(".", "").Replace(" ", "").Replace("đ", "").Trim();
        return decimal.TryParse(clean, out decimal v) ? v : 0m;
    }

    /// <summary>Sync decimal backing fields → formatted string fields.</summary>
    private void SyncStringFields()
    {
        _rentStr = _rent.ToString("N0");
        _payrollStr = _payroll.ToString("N0");
        _utilitiesStr = _utilities.ToString("N0");
        _marketingStr = _marketing.ToString("N0");
        _logisticsStr = _logistics.ToString("N0");
        _otherStr = _other.ToString("N0");
        _depreciationStr = _depreciation.ToString("N0");
    }

    private static string FormatVnd(decimal value) => value.ToString("N0") + " đ";
}
