@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Models
@using VanAn.ShopERP.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<VanALayout>
    <Sidebar>
        <VanANavigation MenuItems="@AdminMenuItems" />
    </Sidebar>
    <Header>
        <UserHeader />
    </Header>
    <ChildContent>
        @Body
    </ChildContent>
</VanALayout>

@code {
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    private List<NavigationItem> AdminMenuItems = new();
    private bool _isSystemAdmin;
    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isSystemAdmin = authState.User.IsInRole("SystemAdmin");
        AdminMenuItems = _isSystemAdmin ? BuildSystemAdminMenu() : BuildOwnerMenu();
        _initialized = true;
    }

    /// <summary>
    /// SystemAdmin menu — full access, grouped by business domain.
    /// Groups are collapsible via VanANavigation's details/summary rendering.
    /// </summary>
