@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.ShopERP.Components.Shared
@using VanAn.ShopERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<VanALayout>
    <Sidebar>
        <VanANavigation MenuItems="@AdminMenuItems" />
    </Sidebar>
    <Header>
        <UserHeader />
    </Header>
    <ChildContent>
        @Body
    </ChildContent>
</VanALayout>

@code {
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private IShopErpMenuService MenuService { get; set; } = null!;

    private List<VanAn.UI.Platform.Models.NavigationItem> AdminMenuItems = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        // SSOT menu: ShopErpMenuService handles SystemAdmin vs Owner (incl. Issue #103 impersonation).
        AdminMenuItems = await MenuService.BuildAsync(authState.User);
    }
}
