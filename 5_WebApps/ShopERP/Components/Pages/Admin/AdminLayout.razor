                }
            },
            new()
            {
                Title = "Cộng tác viên", Icon = "people-fill",
                Children = new()
                {
                    new() { Title = "Quản lý CTV", Icon = "people-fill", Url = "/admin/community/admin-panel" },
                    new() { Title = "Fraud Review", Icon = "shield-exclamation", Url = "/admin/community/fraud-flags" },
