@page "/admin/network-dashboard"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.CoreHub.Services
@using VanAn.ShopERP.Services
@inject NetworkDashboardHttpService DashboardSvc
@inject IThemeProvider ThemeProvider
@inject ILogger<NetworkDashboard> Logger

@attribute [Authorize(Policy = "SystemAdmin")]

<div class="tenant-management-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Network Dashboard</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="LoadMetrics">
                Làm mới
            </VanAButton>
        </div>
    </header>

    <VanAAlert Type="info" Dismissible="false">
        <span>Cross-tenant aggregate metrics (investor-facing). Cache 10 phút. Point value: 1,000 VND (fallback — INV-009 deferred).</span>
    </VanAAlert>

    <div class="mb-3 d-flex gap-2 align-items-center">
        <label>Từ:</label>
        <input type="date" @bind="_startDate" class="form-control" style="width: auto;" />
        <label>Đến:</label>
        <input type="date" @bind="_endDate" class="form-control" style="width: auto;" />
        <VanAButton Variant="primary" Size="small" OnClick="LoadMetrics">
            Áp dụng
        </VanAButton>
    </div>

    @if (_loading)
    {
        <p>Đang tải...</p>
    }
    else if (_metrics == null)
    {
        <VanAAlert Type="warning" Dismissible="false">
            <span>Không thể tải metrics. Kiểm tra kết nối Gateway.</span>
        </VanAAlert>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <VanAMetricsCard Title="GMV" Value="@FormatVnd(_metrics.Gmv)" Icon="💰" Color="primary" />
            </div>
            <div class="col-md-3">
                <VanAMetricsCard Title="Active Tenants" Value="@_metrics.ActiveTenants.ToString()" Icon="🏪" Color="info" />
            </div>
            <div class="col-md-3">
                <VanAMetricsCard Title="Active Customers" Value="@_metrics.ActiveCustomers.ToString()" Icon="👥" Color="info" />
            </div>
            <div class="col-md-3">
                <VanAMetricsCard Title="Repeat Rate" Value="@FormatPercent(_metrics.RepeatRate)" Icon="🔄" Color="success" />
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <VanAMetricsCard Title="Platform Revenue" Value="@FormatVnd(_metrics.PlatformRevenue)" Icon="🏦" Color="primary" />
            </div>
            <div class="col-md-3">
                <VanAMetricsCard Title="Loyalty Cost" Value="@FormatVnd(_metrics.LoyaltyCost)" Icon="🎁" Color="warning" />
            </div>
            <div class="col-md-3">
                <VanAMetricsCard Title="Loyalty ROI" Value="@FormatRatio(_metrics.LoyaltyRoi)" Icon="📈" Color="success" />
            </div>
            <div class="col-md-3">
                <VanAMetricsCard Title="Contribution Profit" Value="@FormatVnd(_metrics.ContributionProfit)" Icon="✅" Color="success" />
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <VanAAlert Type="danger" Dismissible="true">
            <span>@_errorMessage</span>
        </VanAAlert>
    }
</div>

@code {
    private NetworkDashboardMetrics? _metrics;
    private bool _loading = true;
    private string? _errorMessage;
    private DateTime _startDate = DateTime.UtcNow.AddDays(-30);
    private DateTime _endDate = DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        await LoadMetrics();
    }

    private async Task LoadMetrics()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _metrics = await DashboardSvc.GetMetricsAsync(_startDate, _endDate);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load network dashboard metrics");
            _errorMessage = $"Lỗi tải metrics: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatVnd(decimal value) => value.ToString("N0") + " VND";
    private static string FormatPercent(decimal value) => (value * 100).ToString("F1") + "%";
    private static string FormatRatio(decimal value) => value.ToString("F2") + "x";
}
