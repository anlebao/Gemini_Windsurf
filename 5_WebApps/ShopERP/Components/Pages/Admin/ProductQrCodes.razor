@page "/admin/product-qrcodes"
@inject NavigationManager Navigation

<PageTitle>Product QR Codes - ShopERP</PageTitle>

<h3>Product QR Codes</h3>
<p class="text-muted">Generate and download QR codes for products</p>

<VanAnAlert Variant="AlertVariant.Info" Message="Scan these QR codes to add products directly to KhachLink cart" />

<VanAnCard CssClass="mt-4">
    <div class="card-body">
        <h5>QR Code API</h5>
        <p>Use the following API endpoint to generate QR codes for products:</p>
        
        <div class="bg-light p-3 rounded">
            <code>GET /api/products/{productId}/qrcode?shopId={shopId}</code>
        </div>
        
        <p class="mt-3"><strong>Example:</strong></p>
        <div class="bg-light p-3 rounded">
            <code>GET /api/products/123e4567-e89b-12d3-a456-426614174000/qrcode?shopId=987e6543-e21b-12d3-a456-426614174999</code>
        </div>
        
        <p class="mt-3"><strong>QR URL Format:</strong></p>
        <div class="bg-light p-3 rounded">
            <code>https://diemthuong.vanantech.io.vn/menu?shopId={shopId}&productId={productId}</code>
        </div>
        
        <div class="mt-4">
            <h6>How to use:</h6>
            <ol>
                <li>Call the API endpoint with product ID and shop ID</li>
                <li>The API returns a PNG image of the QR code</li>
                <li>Print the QR code and display it at your location</li>
                <li>Customers can scan with any QR scanner to add the product to their cart</li>
            </ol>
        </div>
        
        <div class="mt-4">
            <VanAnButton Variant="ButtonVariant.Primary" OnClick="@(() => Navigation.NavigateTo("/api/products"))">
                View Products API
            </VanAnButton>
        </div>
    </div>
</VanAnCard>