@page "/admin/tenants"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Web
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using VanAn.CoreHub.Services
@using VanAn.CoreHub.Services.Onboarding
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Aggregates.TenantAggregate
@using VanAn.ShopERP.Services
@using System.Threading.Tasks
@inject ITenantManagementService TenantService
@inject TenantOnboardingApiClient OnboardingApiClient
@inject ShopInstanceApiClient ShopInstanceApi
@inject TenantApiClient TenantApi
@inject IThemeProvider ThemeProvider
@inject ILogger<TenantManagement> Logger
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

@attribute [Authorize(Policy = "SystemAdmin")]

<div class="tenant-management-page @ThemeProvider.CurrentTheme">
    <!-- Header -->
    <header class="page-header">
        <h1>Quản lý Tenant</h1>
        <div class="header-actions">
            <VanAButton Variant="primary" Size="small" OnClick="OpenCreateModal">
                + Tạo tenant mới
            </VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="OpenOnboardingModal">
                + Tạo Tenant + Onboarding
            </VanAButton>
            <VanAButton Variant="secondary" Size="small" OnClick="LoadTenants">
                Làm mới
            </VanAButton>
        </div>
    </header>

    <!-- Impersonation status -->
    @if (_isImpersonating)
    {
        <VanAAlert Type="warning" Dismissible="false">
            <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                <span>Đang truy cập với tư cách tenant: <strong>@_impersonatedTenantName</strong> (ID: @_impersonatedTenantId)</span>
                <VanAButton Variant="danger" Size="small" OnClick="ExitImpersonation" IsLoading="@_isExitingImpersonation">
                    Thoát impersonation
                </VanAButton>
            </div>
        </VanAAlert>
    }

    <!-- Alert -->
    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Type="@_alertType" Message="@_alertMessage" OnClose="() => _alertMessage = string.Empty" />
    }

    <!-- Tenant list -->
    @if (_isLoading)
    {
        <VanACard>
            <div class="loading-state">
                <VanASpinner Size="large" />
                <p>Đang tải danh sách tenant...</p>
            </div>
        </VanACard>
    }
    else if (_tenants.Count == 0)
    {
        <VanACard>
            <div class="empty-state">
                <p>Chưa có tenant nào. Nhấn "+ Tạo tenant mới" để bắt đầu.</p>
            </div>
        </VanACard>
    }
    else
    {
        <VanACard Header="@($"Danh sách Tenant ({_tenants.Count})")">
            <table class="vanan-table">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Loại hình</th>
                        <th>Trạng thái</th>
                        <th>Email liên hệ</th>
                        <th>ShopERP Instance</th>
                        <th>Ngày tạo</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _tenants)
                    {
                        <tr>
                            <td><strong>@t.Name</strong></td>
                            <td>@(t.BusinessType == BusinessType.HouseholdBusiness ? "Hộ kinh doanh" : "Công ty")</td>
                            <td>
                                <span class="status-badge status-@t.Status.ToString().ToLower()">
                                    @StatusLabel(t.Status)
                                </span>
                            </td>
                            <td>@(t.ContactEmail ?? "-")</td>
                            <td>
                                @if (t.ShopInstanceId.HasValue && t.ShopInstanceId.Value != Guid.Empty)
                                {
                                    var inst = _shopInstances.FirstOrDefault(i => i.Id == t.ShopInstanceId.Value);
                                    if (inst != null)
                                    {
                                        <div><strong>@inst.Label</strong></div>
                                        <small class="text-muted"><code>@inst.BaseUrl</code></small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">ID: @t.ShopInstanceId.Value.ToString()[..8]</span>
                                    }
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">Chưa gán</span>
                                }
                            </td>
                            <td>@t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td class="action-cell">
                                <VanAButton Variant="primary" Size="small" OnClick="() => OpenEditModal(t)">
                                    Sửa
                                </VanAButton>
                                <VanAButton Variant="info" Size="small" OnClick="() => NavigateToQuickSetup(t)">
                                    Khởi tạo nhanh
                                </VanAButton>
                                @if (t.Status == TenantStatus.Active)
                                {
                                    <VanAButton Variant="outline" Size="small" OnClick="() => OpenSuspendModal(t)">
                                        Tạm ngưng
                                    </VanAButton>
                                }
                                @if (t.Status == TenantStatus.Suspended)
                                {
                                    <VanAButton Variant="secondary" Size="small" OnClick="() => ReactivateTenant(t)">
                                        Kích hoạt
                                    </VanAButton>
                                }
                                @if (t.Status != TenantStatus.Inactive)
                                {
                                    <VanAButton Variant="danger" Size="small" OnClick="() => OpenDeactivateModal(t)">
                                        Vô hiệu hoá
                                    </VanAButton>
                                }
                                @if (t.Status == TenantStatus.Active)
                                {
                                    <VanAButton Variant="primary" Size="small" OnClick="() => ImpersonateTenant(t)" IsLoading="@(_impersonatingTenantId == t.Id)">
                                        <i class="bi bi-person-badge me-1"></i> Impersonate
                                    </VanAButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </VanACard>
    }

    <!-- Create modal -->
    @if (_showCreateModal)
    {
        <VanAModal Title="Tạo Tenant Mới" IsVisible="true" OnClose="CloseCreateModal">
            <Body>
            <VanAForm OnValidSubmit="HandleCreateSubmit" aria-label="Tạo tenant mới">
                <div class="form-group">
                    <label for="tenant-name">Tên tenant *</label>
                    <input id="tenant-name" class="vanan-input" @bind="_createForm.Name" placeholder="Nhập tên doanh nghiệp..." aria-label="Tên tenant" required />
                </div>
                <div class="form-group">
                    <label for="tenant-businesstype">Loại hình *</label>
                    <select id="tenant-businesstype" class="vanan-select" @bind="_createForm.BusinessTypeStr" aria-label="Loại hình doanh nghiệp">
                        <option value="Company">Công ty</option>
                        <option value="HouseholdBusiness">Hộ kinh doanh</option>
                    </select>
                </div>
                @if (_createForm.BusinessTypeStr == "HouseholdBusiness")
                {
                    <div class="form-group">
                        <label for="tenant-hkdgroup">Nhóm HKD *</label>
                        <select id="tenant-hkdgroup" class="vanan-select" @bind="_createForm.HKDGroupStr" aria-label="Nhóm hộ kinh doanh">
                            <option value="Group1">Nhóm 1</option>
                            <option value="Group2">Nhóm 2</option>
                            <option value="Group3">Nhóm 3</option>
                        </select>
                    </div>
                }
                <div class="form-group">
                    <label for="tenant-email">Email liên hệ</label>
                    <input id="tenant-email" class="vanan-input" type="email" @bind="_createForm.ContactEmail" placeholder="email@example.com" aria-label="Email liên hệ" />
                </div>
                <div class="form-group">
                    <label for="tenant-phone">Số điện thoại</label>
                    <input id="tenant-phone" class="vanan-input" @bind="_createForm.ContactPhone" placeholder="+84..." aria-label="Số điện thoại" />
                </div>
                <div class="form-group">
                    <label for="tenant-address">Địa chỉ</label>
                    <input id="tenant-address" class="vanan-input" @bind="_createForm.Address" aria-label="Địa chỉ" />
                </div>
                <div class="form-group">
                    <label for="tenant-taxcode">Mã số thuế</label>
                    <input id="tenant-taxcode" class="vanan-input" @bind="_createForm.TaxCode" aria-label="Mã số thuế" />
                </div>
                <div class="modal-actions">
                    <VanAButton Variant="primary" OnClick="HandleCreateSubmit" IsLoading="@_isSaving">Tạo</VanAButton>
                    <VanAButton Variant="outline" OnClick="CloseCreateModal">Huỷ</VanAButton>
                </div>
            </VanAForm>
            </Body>
        </VanAModal>
    }

    <!-- Onboarding modal -->
    @if (_showOnboardingModal)
    {
        <VanAModal Title="Tạo Tenant + Onboarding" IsVisible="true" OnClose="CloseOnboardingModal" Size="large">
            <Body>
            @if (_onboardingResult is not null)
            {
                <VanACard Header="Onboarding thành công">
                    <VanAAlert Type="success" Message="Tenant và owner đã được tạo thành công." Dismissible="false" />
                    <div class="onboarding-result">
                        <p><strong>Tenant ID:</strong> @_onboardingResult.TenantId</p>
                        <p><strong>Owner ID:</strong> @_onboardingResult.OwnerUserId</p>
                        <p><strong>Shops:</strong> @_onboardingResult.ShopsCreated</p>
                        <p><strong>Products:</strong> @_onboardingResult.ProductsCreated</p>
                        <p><strong>Ingredients:</strong> @_onboardingResult.IngredientsCreated</p>
                        <p><strong>Recipes:</strong> @_onboardingResult.RecipesCreated</p>
                        <p><strong>Permission groups:</strong> @_onboardingResult.PermissionGroupsCreated</p>
                    </div>
                </VanACard>
                <div class="modal-actions">
                    <VanAButton Variant="primary" OnClick="CloseOnboardingModalAndRefresh">Đóng</VanAButton>
                </div>
            }
            else
            {
                <VanAForm OnValidSubmit="HandleOnboardingSubmit" aria-label="Tạo tenant onboarding">
                    <div class="form-row">
                        <div class="form-group form-group-half">
                            <label for="onboarding-name">Tên tenant *</label>
                            <VanAInput Id="onboarding-name" @bind-Value="_onboardingForm.Name" Placeholder="Nhập tên doanh nghiệp..." AriaLabel="Tên tenant" Required="true" />
                        </div>
                        <div class="form-group form-group-half">
                            <label for="onboarding-businesstype">Loại hình *</label>
                            <VanASelect Id="onboarding-businesstype" @bind-Value="_onboardingForm.BusinessTypeStr" Options="_businessTypeOptions" AriaLabel="Loại hình doanh nghiệp" />
                        </div>
                    </div>
                    @if (_onboardingForm.BusinessTypeStr == "HouseholdBusiness")
                    {
                        <div class="form-group">
                            <label for="onboarding-hkdgroup">Nhóm HKD *</label>
                            <VanASelect Id="onboarding-hkdgroup" @bind-Value="_onboardingForm.HKDGroupStr" Options="_hkdGroupOptions" AriaLabel="Nhóm hộ kinh doanh" />
                        </div>
                    }
                    <div class="form-row">
                        <div class="form-group form-group-half">
                            <label for="onboarding-email">Email liên hệ</label>
                            <VanAInput Id="onboarding-email" Type="email" @bind-Value="_onboardingForm.ContactEmail" Placeholder="email@example.com" AriaLabel="Email liên hệ" />
                        </div>
                        <div class="form-group form-group-half">
                            <label for="onboarding-phone">Số điện thoại</label>
                            <VanAInput Id="onboarding-phone" @bind-Value="_onboardingForm.ContactPhone" Placeholder="+84..." AriaLabel="Số điện thoại" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="onboarding-address">Địa chỉ</label>
                        <VanAInput Id="onboarding-address" @bind-Value="_onboardingForm.Address" AriaLabel="Địa chỉ" />
                    </div>
                    <div class="form-group">
                        <label for="onboarding-taxcode">Mã số thuế</label>
                        <VanAInput Id="onboarding-taxcode" @bind-Value="_onboardingForm.TaxCode" AriaLabel="Mã số thuế" />
                    </div>
                    <div class="form-group">
                        <label for="onboarding-industry">Ngành nghề *</label>
                        <VanASelect Id="onboarding-industry" @bind-Value="_onboardingForm.IndustryCode" Options="_industryOptions" AriaLabel="Ngành nghề" />
                    </div>
                    @* Phase 6: ShopInstance selector (required for multi-VPS routing) *@
                    <div class="form-group">
                        <label for="onboarding-shopinstance">ShopERP Instance *</label>
                        @if (_shopInstances.Any())
                        {
                            <select id="onboarding-shopinstance" class="vanan-select" @bind="_onboardingForm.ShopInstanceId" aria-label="ShopERP Instance" required>
                                <option value="">-- Chọn instance --</option>
                                @foreach (var inst in _shopInstances)
                                {
                                    <option value="@inst.Id">@inst.Label (@inst.BaseUrl)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="text" class="vanan-input" value="Chưa có instance — tạo tại /admin/shop-instances" disabled />
                        }
                    </div>
                    <div class="form-row">
                        <div class="form-group form-group-half">
                            <label for="onboarding-ownerusername">Tên đăng nhập owner *</label>
                            <VanAInput Id="onboarding-ownerusername" @bind-Value="_onboardingForm.OwnerUsername" Placeholder="owner@tenant.vn" AriaLabel="Tên đăng nhập owner" Required="true" />
                        </div>
                        <div class="form-group form-group-half">
                            <label for="onboarding-ownerpassword">Mật khẩu owner *</label>
                            <VanAInput Id="onboarding-ownerpassword" Type="password" @bind-Value="_onboardingForm.OwnerPassword" Placeholder="Tối thiểu 8 ký tự" AriaLabel="Mật khẩu owner" Required="true" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="onboarding-ownerdisplayname">Tên hiển thị owner *</label>
                        <VanAInput Id="onboarding-ownerdisplayname" @bind-Value="_onboardingForm.OwnerDisplayName" Placeholder="Chủ doanh nghiệp" AriaLabel="Tên hiển thị owner" Required="true" />
                    </div>
                    @if (_onboardingValidationErrors.Count > 0)
                    {
                        <VanAAlert Type="error" Message="@string.Join(" ", _onboardingValidationErrors)" Dismissible="false" />
                    }
                    <div class="modal-actions">
                        <VanAButton Variant="primary" OnClick="HandleOnboardingSubmit" IsLoading="@_isOnboardingSaving">Tạo + Onboarding</VanAButton>
                        <VanAButton Variant="outline" OnClick="CloseOnboardingModal">Huỷ</VanAButton>
                    </div>
                </VanAForm>
                @if (_isOnboardingSaving)
                {
                    <div class="onboarding-loading">
                        <VanASpinner Size="medium" Label="Đang tạo tenant..." />
                    </div>
                }
            }
            </Body>
        </VanAModal>
    }

    <!-- Suspend modal -->
    @if (_showSuspendModal && _selectedTenant is not null)
    {
        <VanAModal Title="Tạm ngưng Tenant" IsVisible="true" OnClose="CloseSuspendModal">
            <Body>
            <p>Tạm ngưng tenant: <strong>@_selectedTenant.Name</strong></p>
            <div class="form-group">
                <label>Lý do *</label>
                <input class="vanan-input" @bind="_reasonInput" placeholder="Nhập lý do tạm ngưng..." />
            </div>
            <div class="modal-actions">
                <VanAButton Variant="warning" OnClick="ConfirmSuspend" IsLoading="@_isSaving">Xác nhận tạm ngưng</VanAButton>
                <VanAButton Variant="outline" OnClick="CloseSuspendModal">Huỷ</VanAButton>
            </div>
            </Body>
        </VanAModal>
    }

    <!-- Deactivate modal -->
    @if (_showDeactivateModal && _selectedTenant is not null)
    {
        <VanAModal Title="Vô hiệu hoá Tenant" IsVisible="true" OnClose="CloseDeactivateModal">
            <Body>
            <VanAAlert Type="error" Message="Thao tác này không thể hoàn tác! Tenant sẽ bị vô hiệu hoá vĩnh viễn." />
            <p>Vô hiệu hoá tenant: <strong>@_selectedTenant.Name</strong></p>
            <div class="form-group">
                <label>Lý do *</label>
                <input class="vanan-input" @bind="_reasonInput" placeholder="Nhập lý do vô hiệu hoá..." />
            </div>
            <div class="modal-actions">
                <VanAButton Variant="danger" OnClick="ConfirmDeactivate" IsLoading="@_isSaving">Xác nhận vô hiệu hoá</VanAButton>
                <VanAButton Variant="outline" OnClick="CloseDeactivateModal">Huỷ</VanAButton>
            </div>
            </Body>
        </VanAModal>
    }

    <!-- Edit modal (assign ShopInstance + update profile) -->
    @if (_showEditModal && _selectedTenant is not null)
    {
        <VanAModal Title="Sửa Tenant" IsVisible="true" OnClose="CloseEditModal" Size="medium">
            <Body>
            <VanAForm OnValidSubmit="HandleEditSubmit" aria-label="Sửa tenant">
                <div class="form-group">
                    <label for="edit-name">Tên tenant *</label>
                    <input id="edit-name" class="vanan-input" @bind="_editForm.Name" placeholder="Tên doanh nghiệp..." required />
                </div>
                <div class="form-group">
                    <label for="edit-email">Email liên hệ</label>
                    <input id="edit-email" class="vanan-input" type="email" @bind="_editForm.ContactEmail" placeholder="email@example.com" />
                </div>
                <div class="form-group">
                    <label for="edit-phone">Số điện thoại</label>
                    <input id="edit-phone" class="vanan-input" @bind="_editForm.ContactPhone" placeholder="+84..." />
                </div>
                <div class="form-group">
                    <label for="edit-address">Địa chỉ</label>
                    <input id="edit-address" class="vanan-input" @bind="_editForm.Address" />
                </div>
                <div class="form-group">
                    <label for="edit-taxcode">Mã số thuế</label>
                    <input id="edit-taxcode" class="vanan-input" @bind="_editForm.TaxCode" />
                </div>
                <div class="form-group">
                    <label for="edit-slug">URL Slug (trang cửa hàng)</label>
                    <input id="edit-slug" class="vanan-input" @bind="_editForm.Slug"
                           placeholder="vd: trung-nguyen-cafe (để trống = không có trang riêng)" />
                    <small class="text-muted">
                        Trang khách hàng: <code>/store/@(_editForm.Slug ?? "slug")</code> trên KhachLink.
                        Chỉ chữ thường, số, dấu gạch ngang. Tối đa 100 ký tự.
                    </small>
                </div>
                <div class="form-group">
                    <label for="edit-brandstory">Câu chuyện thương hiệu (Brand Story)</label>
                    <textarea id="edit-brandstory" class="vanan-input" rows="3"
                              @bind="_editForm.BrandStory"
                              placeholder="vd: Khởi đầu từ một quán trà nhỏ năm 2010, chúng tôi tự hào mang đến những ly trà sữa tươi ngon..."></textarea>
                    <small class="text-muted">Hiển thị ở hero section trang /store/{slug}. Tối đa 500 ký tự.</small>
                </div>
                <div class="form-group">
                    <label>Mạng xã hội (Social Hub)</label>
                    <input id="edit-socialfb" class="vanan-input mb-2"
                           @bind="_editForm.SocialLinksFb"
                           placeholder="Facebook URL (vd: https://facebook.com/yourshop)" />
                    <input id="edit-socialtiktok" class="vanan-input"
                           @bind="_editForm.SocialLinksTiktok"
                           placeholder="TikTok URL (vd: https://tiktok.com/yourshop)" />
                    <small class="text-muted">Hiển thị ở Social Hub section. Để trống = ẩn section.</small>
                </div>
                <div class="form-group">
                    <label>Vị trí cửa hàng (Google Maps)</label>
                    <small class="text-muted d-block mb-2">
                        Kéo con trỏ trên bản đồ để chọn vị trí, hoặc nhập tay vĩ độ/kinh độ.
                        Dùng cho Store Finder "Tìm cửa hàng gần bạn" trên KhachLink.
                    </small>
                    <div id="tenant-edit-map" style="height: 300px; border-radius: 8px; overflow: hidden; margin-bottom: 8px; border: 1px solid #dee2e6;"></div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label for="edit-latitude" class="small">Vĩ độ (Latitude)</label>
                            <input id="edit-latitude" class="vanan-input" type="number"
                                   step="any" @bind="_editForm.Latitude"
                                   @oninput="OnLatLonChanged" placeholder="vd: 10.966" />
                        </div>
                        <div class="col-6">
                            <label for="edit-longitude" class="small">Kinh độ (Longitude)</label>
                            <input id="edit-longitude" class="vanan-input" type="number"
                                   step="any" @bind="_editForm.Longitude"
                                   @oninput="OnLatLonChanged" placeholder="vd: 106.594" />
                        </div>
                    </div>
                    <div class="mt-2 d-flex gap-2 flex-wrap">
                        <VanAButton Variant="outline" Size="small" OnClick="UseMyLocation">
                            <i class="bi bi-geo-alt me-1"></i> Dùng vị trí của tôi
                        </VanAButton>
                        <VanAButton Variant="outline" Size="small" OnClick="ClearLocation">
                            <i class="bi bi-x-circle me-1"></i> Xoá vị trí
                        </VanAButton>
                    </div>
                </div>
                <div class="form-group">
                    <label for="edit-theme">Phong cách giao diện (KhachLink)</label>
                    <select id="edit-theme" class="vanan-select" @bind="_editForm.Theme" aria-label="Phong cách giao diện">
                        <option value="Classic">Classic — Cà phê truyền thống (kem nâu)</option>
                        <option value="Modern">Modern — Tối giản hiện đại (trắng)</option>
                        <option value="Teen">Teen — Trẻ trung (gradient hồng-tím)</option>
                        <option value="Lady">Lady — Nữ tính (gradient hồng pastel)</option>
                        <option value="Premium">Premium — Cao cấp (đen + vàng gold)</option>
                    </select>
                    <small class="text-muted">
                        Áp dụng cho trang khách hàng KhachLink của tenant này.
                        Mỗi phong cách đổi background, màu sắc, và vibe chung.
                    </small>
                </div>
                <div class="form-group">
                    <label for="edit-shopinstance">ShopERP Instance *</label>
                    @if (_shopInstances.Any())
                    {
                        <select id="edit-shopinstance" class="vanan-select" @bind="_editForm.ShopInstanceId" aria-label="ShopERP Instance" required>
                            <option value="">-- Chọn instance --</option>
                            @foreach (var inst in _shopInstances)
                            {
                                <option value="@inst.Id">@inst.Label (@inst.BaseUrl)</option>
                            }
                        </select>
                        @if (_editForm.ShopInstanceId.HasValue && _editForm.ShopInstanceId.Value != Guid.Empty)
                        {
                            var currentInst = _shopInstances.FirstOrDefault(i => i.Id == _editForm.ShopInstanceId.Value);
                            @if (currentInst != null && _selectedTenant.ShopInstanceId == _editForm.ShopInstanceId)
                            {
                                <small class="text-muted">Đã gán: @currentInst.Label</small>
                            }
                            else if (currentInst != null)
                            {
                                <small class="text-warning">Sẽ gán mới: @currentInst.Label</small>
                            }
                        }
                    }
                    else
                    {
                        <input type="text" class="vanan-input" value="Chưa có instance — tạo tại /admin/shop-instances" disabled />
                    }
                </div>
                <div class="modal-actions">
                    <VanAButton Variant="primary" OnClick="HandleEditSubmit" IsLoading="@_isSaving">Lưu</VanAButton>
                    <VanAButton Variant="outline" OnClick="CloseEditModal">Huỷ</VanAButton>
                </div>
            </VanAForm>
            </Body>
        </VanAModal>
    }
</div>

@code {
#pragma warning disable CS0618 // Tenant obsolete — using new TenantAggregate.Tenant explicitly below
    // Tenants loaded from Gateway API (PostgreSQL) — NOT local SQLite
    private List<TenantApiDto> _tenants = [];
    // Phase 6: ShopInstance list for dropdown + column display
