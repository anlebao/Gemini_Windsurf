    private async Task ImpersonateTenant(TenantApiDto tenant)
    {
        _impersonatingTenantId = tenant.Id;
        try
        {
            // Issue #103 fix: Navigate to Razor Page instead of HttpClient POST.
            // Razor Page runs in real HTTP context → browser receives Set-Cookie → impersonation works.
            // Old HttpClient approach failed: HttpContext null in Blazor Server event + Set-Cookie never reached browser.
            NavigationManager.NavigateTo($"/Impersonate/{tenant.Id}", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to navigate to impersonate page for tenant {TenantId}", tenant.Id);
            ShowAlert("error", $"Lỗi: {ex.Message}");
        }
        finally { _impersonatingTenantId = Guid.Empty; }
    }

