    private bool _mapInitialized;
    private void OpenEditModal(TenantApiDto t)
    {
        _selectedTenant = t;
        _editForm = new EditForm
        {
            Name = t.Name,
            ContactEmail = t.ContactEmail,
            ContactPhone = t.ContactPhone,
            Address = t.Address,
            TaxCode = t.TaxCode,
            Slug = t.Slug,
            Latitude = t.Latitude,
            Longitude = t.Longitude,
            SocialLinksFb = t.SocialLinksFb,
            SocialLinksTiktok = t.SocialLinksTiktok,
            BrandStory = t.BrandStory,
            Theme = t.Theme,
            LogoUrl = t.LogoUrl,
            NavColor = t.NavColor,
            HeaderColor = t.HeaderColor,
            FooterColor = t.FooterColor,
            ShopInstanceId = t.ShopInstanceId,
            // Bug 1 fix: pre-fill BusinessType from current tenant
            BusinessTypeStr = t.BusinessType == BusinessType.HouseholdBusiness ? "HouseholdBusiness" : "Company",
            HKDGroupStr = "Group1",
            BusinessTypeChangeReason = null
        };
        _showEditModal = true;
        _mapInitialized = false;
        // Map init deferred to OnAfterRenderAsync (DOM must be ready before JS call)
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Init map when edit modal is shown AND not yet initialized
        if (_showEditModal && !_mapInitialized)
        {
            _mapInitialized = true;
            var lat = _editForm.Latitude ?? 10.7769;  // Default: HCM center
            var lng = _editForm.Longitude ?? 106.7009;
            try
            {
                await JSRuntime.InvokeVoidAsync("vananTenantMap.init",
                    "tenant-edit-map", lat, lng, DotNetObjectReference.Create(this));
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to init tenant edit map");
            }
        }
    }

    /// <summary>JS callback: marker dragged or map clicked → update form fields.</summary>
    [JSInvokable]
    public void OnMapMarkerMoved(double lat, double lng)
    {
        _editForm.Latitude = lat;
        _editForm.Longitude = lng;
        // Avoid StateHasChanged during render — schedule for next cycle
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>When user types in lat/lng inputs, move the marker.</summary>
    private async Task OnLatLonChanged()
    {
        if (_editForm.Latitude.HasValue && _editForm.Longitude.HasValue)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("vananTenantMap.setMarker",
                    _editForm.Latitude.Value, _editForm.Longitude.Value);
            }
            catch { /* map not yet ready — ignore */ }
        }
    }

    /// <summary>"Use my location" button — browser geolocation.</summary>
    private async Task UseMyLocation()
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<GeoLocationResult>("vananTenantMap.getCurrentLocation");
            if (result is not null)
            {
                _editForm.Latitude = result.Latitude;
                _editForm.Longitude = result.Longitude;
                await OnLatLonChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Geolocation denied or unavailable");
            ShowAlert("error", "Không lấy được vị trí. Trình duyệt có thể chặn geolocation.");
        }
    }

    /// <summary>"Clear location" button.</summary>
    private async Task ClearLocation()
    {
        _editForm.Latitude = null;
        _editForm.Longitude = null;
        try { await JSRuntime.InvokeVoidAsync("vananTenantMap.clear"); } catch { }
    }

    private sealed class GeoLocationResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }

    private void CloseEditModal()
    {
        _showEditModal = false;
        // Cleanup map instance to avoid leak when modal reopens
        _ = JSRuntime.InvokeVoidAsync("vananTenantMap.destroy");
    }

    private async Task HandleEditSubmit()
    {
        if (_selectedTenant is null) return;
        if (string.IsNullOrWhiteSpace(_editForm.Name))
        {
            ShowAlert("error", "Tên tenant không được để trống.");
            return;
        }
        if (!_editForm.ShopInstanceId.HasValue || _editForm.ShopInstanceId.Value == Guid.Empty)
        {
            ShowAlert("error", "Vui lòng chọn ShopERP Instance.");
            return;
        }

        _isSaving = true;
        try
        {
            // 1. Update profile via Gateway API (PostgreSQL)
            await TenantApi.UpdateProfileAsync(_selectedTenant.Id, new UpdateTenantProfileApiRequest
            {
                Name = _editForm.Name,
                ContactEmail = _editForm.ContactEmail,
                ContactPhone = _editForm.ContactPhone,
                Address = _editForm.Address,
                TaxCode = _editForm.TaxCode,
                Latitude = _editForm.Latitude,
                Longitude = _editForm.Longitude,
                SocialLinksFb = string.IsNullOrWhiteSpace(_editForm.SocialLinksFb) ? null : _editForm.SocialLinksFb,
                SocialLinksTiktok = string.IsNullOrWhiteSpace(_editForm.SocialLinksTiktok) ? null : _editForm.SocialLinksTiktok,
                BrandStory = string.IsNullOrWhiteSpace(_editForm.BrandStory) ? null : _editForm.BrandStory,
                Theme = _editForm.Theme,
                LogoUrl = string.IsNullOrWhiteSpace(_editForm.LogoUrl) ? null : _editForm.LogoUrl,
                NavColor = string.IsNullOrWhiteSpace(_editForm.NavColor) ? null : _editForm.NavColor,
                HeaderColor = string.IsNullOrWhiteSpace(_editForm.HeaderColor) ? null : _editForm.HeaderColor,
                FooterColor = string.IsNullOrWhiteSpace(_editForm.FooterColor) ? null : _editForm.FooterColor
            });

            // 1b. Update slug via Gateway API (separate endpoint — has uniqueness check)
            var normalizedSlug = string.IsNullOrWhiteSpace(_editForm.Slug) ? null : _editForm.Slug.Trim().ToLowerInvariant();
            if (_selectedTenant.Slug != normalizedSlug)
            {
                await TenantApi.UpdateSlugAsync(_selectedTenant.Id, normalizedSlug);
            }

            // 2. Assign ShopInstance via Gateway API (PostgreSQL) — only if changed
            if (_selectedTenant.ShopInstanceId != _editForm.ShopInstanceId)
            {
                await TenantApi.AssignShopInstanceAsync(_selectedTenant.Id, _editForm.ShopInstanceId.Value);
            }

            // 3. Bug 1 fix: Change BusinessType if changed (SystemAdmin correction)
            var newBusinessTypeStr = _editForm.BusinessTypeStr;
            var currentBusinessTypeStr = _selectedTenant.BusinessType == BusinessType.HouseholdBusiness ? "HouseholdBusiness" : "Company";
            if (newBusinessTypeStr != currentBusinessTypeStr)
            {
                if (string.IsNullOrWhiteSpace(_editForm.BusinessTypeChangeReason))
                {
                    ShowAlert("error", "Vui lòng nhập lý do đổi loại hình.");
                    return;
                }
                var newType = newBusinessTypeStr == "HouseholdBusiness" ? BusinessType.HouseholdBusiness : BusinessType.Company;
                HKDGroup? hkdGroup = newType == BusinessType.HouseholdBusiness
                    ? Enum.Parse<HKDGroup>(_editForm.HKDGroupStr)
                    : null;
                await TenantApi.ChangeBusinessTypeAsync(_selectedTenant.Id, newType, hkdGroup, _editForm.BusinessTypeChangeReason);
            }

            _showEditModal = false;
            ShowAlert("success", $"Tenant '{_editForm.Name}' đã được cập nhật.");
            await LoadTenants();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update tenant {TenantId}", _selectedTenant.Id);
            ShowAlert("error", $"Lỗi: {ex.Message}");
        }
        finally { _isSaving = false; }
    }

