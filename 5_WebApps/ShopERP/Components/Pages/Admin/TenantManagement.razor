                        Mỗi phong cách đổi background, màu sắc, và vibe chung.
                    </small>
                </div>
                <div class="form-group">
                    <label for="edit-logo-url">Logo URL (KhachLink header)</label>
                    <input id="edit-logo-url" class="vanan-input" @bind="_editForm.LogoUrl"
                           placeholder="VD: https://example.com/logo.png (để trống = dùng icon mặc định)" />
                    <small class="text-muted">
                        #93 — Hiển thị logo cửa hàng trên header KhachLink. Để trống = dùng icon shop mặc định.
                    </small>
                </div>
                <div class="form-group">
                    <label class="fw-semibold">Tùy chỉnh màu KhachLink (#93)</label>
                    <small class="text-muted d-block mb-2">
                        Override màu nav (sidebar desktop), header (top bar), footer.
                        Để trống = dùng màu mặc định (nav #1a1a2e, header = primary, footer #f5f5f5).
                    </small>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label for="edit-nav-color" class="small">Màu Nav (sidebar)</label>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="color" class="form-control form-control-color p-1"
                                       style="width:48px;height:38px;"
                                       value="@(_editForm.NavColor ?? "#1a1a2e")"
                                       @oninput="@(e => _editForm.NavColor = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())" />
                                <input id="edit-nav-color" class="vanan-input" @bind="_editForm.NavColor"
                                       placeholder="#1a1a2e" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="edit-header-color" class="small">Màu Header (top bar)</label>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="color" class="form-control form-control-color p-1"
                                       style="width:48px;height:38px;"
                                       value="@(_editForm.HeaderColor ?? "#8B4513")"
                                       @oninput="@(e => _editForm.HeaderColor = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())" />
                                <input id="edit-header-color" class="vanan-input" @bind="_editForm.HeaderColor"
                                       placeholder="#8B4513" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="edit-footer-color" class="small">Màu Footer</label>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="color" class="form-control form-control-color p-1"
                                       style="width:48px;height:38px;"
                                       value="@(_editForm.FooterColor ?? "#f5f5f5")"
                                       @oninput="@(e => _editForm.FooterColor = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())" />
                                <input id="edit-footer-color" class="vanan-input" @bind="_editForm.FooterColor"
                                       placeholder="#f5f5f5" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="edit-shopinstance">ShopERP Instance *</label>
                    @if (_shopInstances.Any())
                    {
                        <select id="edit-shopinstance" class="vanan-select" @bind="_editForm.ShopInstanceId" aria-label="ShopERP Instance" required>
                            <option value="">-- Chọn instance --</option>
                            @foreach (var inst in _shopInstances)
                            {
                                <option value="@inst.Id">@inst.Label (@inst.BaseUrl)</option>
                            }
                        </select>
                        @if (_editForm.ShopInstanceId.HasValue && _editForm.ShopInstanceId.Value != Guid.Empty)
                        {
                            var currentInst = _shopInstances.FirstOrDefault(i => i.Id == _editForm.ShopInstanceId.Value);
                            @if (currentInst != null && _selectedTenant.ShopInstanceId == _editForm.ShopInstanceId)
                            {
                                <small class="text-muted">Đã gán: @currentInst.Label</small>
                            }
                            else if (currentInst != null)
                            {
                                <small class="text-warning">Sẽ gán mới: @currentInst.Label</small>
                            }
                        }
                    }
                    else
                    {
                        <input type="text" class="vanan-input" value="Chưa có instance — tạo tại /admin/shop-instances" disabled />
                    }
                </div>
                <div class="modal-actions">
                    <VanAButton Variant="primary" OnClick="HandleEditSubmit" IsLoading="@_isSaving">Lưu</VanAButton>
                    <VanAButton Variant="outline" OnClick="CloseEditModal">Huỷ</VanAButton>
                </div>
            </VanAForm>
            </Body>
        </VanAModal>
    }

    <!-- Crawl-to-Onboard Phase 7: Verify modal (direct verify Pending tenant) -->
    @if (_showVerifyModal && _selectedPending is not null)
    {
        <VanAModal Title="Verify Pending Tenant" IsVisible="true" OnClose="CloseVerifyModal" Size="large">
            <Body>
            <VanAAlert Type="info" Message="@GetVerifyAlertMessage()" Dismissible="false" />
            <VanAForm OnValidSubmit="HandleVerifySubmit" aria-label="Verify pending tenant">
                <div class="form-row">
                    <div class="form-group form-group-half">
                        <label for="verify-username">Tên đăng nhập owner *</label>
                        <input id="verify-username" class="vanan-input" @bind="_verifyForm.OwnerUsername" placeholder="owner@tenant.vn" required />
                    </div>
                    <div class="form-group form-group-half">
                        <label for="verify-password">Mật khẩu owner *</label>
                        <div class="input-group">
                            <input id="verify-password" class="vanan-input" type="@(_showPassword ? "text" : "password")" @bind="_verifyForm.OwnerPassword" placeholder="Tối thiểu 8 ký tự" required />
                            <button type="button" class="btn btn-outline-secondary" @onclick="@(() => _showPassword = !_showPassword)">
                                <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                        <VanAButton Variant="outline" Size="small" OnClick="GeneratePassword" CssClass="mt-1">
                            <i class="bi bi-shuffle me-1"></i> Sinh mật khẩu ngẫu nhiên
                        </VanAButton>
                    </div>
                </div>
                <div class="form-group">
                    <label for="verify-displayname">Tên hiển thị owner *</label>
                    <input id="verify-displayname" class="vanan-input" @bind="_verifyForm.OwnerDisplayName" placeholder="Chủ doanh nghiệp" required />
                </div>
                <div class="form-group">
                    <label for="verify-slug">URL Slug (trang cửa hàng)</label>
                    <input id="verify-slug" class="vanan-input" @bind="_verifyForm.Slug" placeholder="vd: trung-nguyen-cafe (để trống = auto)" />
                    <small class="text-muted">Trang khách hàng: <code>/store/@(_verifyForm.Slug ?? "slug")</code></small>
                </div>
                <div class="form-group">
                    <label for="verify-shopinstance">ShopERP Instance *</label>
                    @if (_shopInstances.Any())
                    {
                        <select id="verify-shopinstance" class="vanan-select" @bind="_verifyForm.ShopInstanceId" required>
                            <option value="">-- Chọn instance --</option>
                            @foreach (var inst in _shopInstances)
                            {
                                <option value="@inst.Id">@inst.Label (@inst.BaseUrl)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" class="vanan-input" value="Chưa có instance — tạo tại /admin/shop-instances" disabled />
                    }
                </div>
                @if (!string.IsNullOrEmpty(_verifyError))
                {
                    <VanAAlert Type="error" Message="@_verifyError" Dismissible="false" />
                }
                @if (_verifyResult is not null)
                {
                    <VanAAlert Type="success" Message="Verify thành công! Sao chép credentials ngay — sẽ không hiển thị lại." Dismissible="false" />
                    <div class="verify-credentials">
                        <p><strong>Tenant ID:</strong> @_verifyResult.TenantId</p>
                        <p><strong>Owner User ID:</strong> @_verifyResult.OwnerUserId</p>
                        <p><strong>Permission groups:</strong> @_verifyResult.PermissionGroupsCreated</p>
                        <p><strong>Published slug:</strong> <code>@_verifyResult.PublishedSlug</code></p>
                        <p><strong>Username:</strong> <code>@_verifyForm.OwnerUsername</code></p>
                        <p><strong>Password:</strong> <code>@_verifyForm.OwnerPassword</code></p>
                    </div>
                }
                <div class="modal-actions">
                    @if (_verifyResult is null)
                    {
                        <VanAButton Variant="success" OnClick="HandleVerifySubmit" IsLoading="@_isVerifying">Verify</VanAButton>
                    }
                    <VanAButton Variant="outline" OnClick="CloseVerifyModal">Đóng</VanAButton>
                </div>
            </VanAForm>
            </Body>
        </VanAModal>
    }

    <!-- Crawl-to-Onboard Phase 7: Resolve duplicate modal -->
    @if (_showResolveDuplicateModal && _selectedDuplicate is not null)
    {
        <VanAModal Title="Giữ tenant này (resolve duplicate)" IsVisible="true" OnClose="CloseResolveDuplicateModal">
            <Body>
            <VanAAlert Type="warning" Message="Tenant còn lại sẽ bị Inactive. Không merge dữ liệu." Dismissible="false" />
            <p>Giữ: <strong>@_selectedDuplicate.TenantName</strong> (MST: @(_selectedDuplicate.TaxCode ?? "N/A"))</p>
            <p class="text-muted">Trùng với: @_selectedDuplicate.CanonicalTenantName</p>
            <div class="form-group">
                <label>Lý do *</label>
                <input class="vanan-input" @bind="_resolveDuplicateReason" placeholder="vd: Tenant này có thông tin mới hơn..." />
            </div>
            <div class="modal-actions">
                <VanAButton Variant="success" OnClick="ConfirmResolveDuplicate" IsLoading="@_isResolving">Xác nhận giữ</VanAButton>
                <VanAButton Variant="outline" OnClick="CloseResolveDuplicateModal">Huỷ</VanAButton>
            </div>
            </Body>
        </VanAModal>
    }
</div>

<style>
    /* Crawl-to-Onboard Phase 7: Tab navigation */
    .tenant-tabs {
        display: flex; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb;
    }
    .tenant-tab {
        padding: 0.6rem 1.2rem; border: none; background: none; cursor: pointer;
        font-weight: 600; color: #6b7280; border-bottom: 2px solid transparent;
        margin-bottom: -2px; transition: all 0.15s;
    }
    .tenant-tab:hover { color: #1f2937; }
    .tenant-tab.active { color: #2563eb; border-bottom-color: #2563eb; }
    .tab-badge {
        display: inline-block; background: #f59e0b; color: white;
        border-radius: 50%; width: 18px; height: 18px; font-size: 0.7rem;
        line-height: 18px; text-align: center; margin-left: 4px;
    }
    .verify-credentials {
        background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px;
        padding: 1rem; margin: 1rem 0;
    }
    .verify-credentials p { margin: 0.25rem 0; }
    .verify-credentials code { background: #dcfce7; padding: 2px 6px; border-radius: 4px; }
</style>

@code {
#pragma warning disable CS0618 // Tenant obsolete — using new TenantAggregate.Tenant explicitly below
    // Tenants loaded from Gateway API (PostgreSQL) — NOT local SQLite
    private List<TenantApiDto> _tenants = [];
    // Phase 6: ShopInstance list for dropdown + column display
    private List<ShopInstanceDto> _shopInstances = [];
    private bool _isLoading;
    private bool _isSaving;
    private string _alertMessage = string.Empty;
    private string _alertType = "info";

    // Create modal
    private bool _showCreateModal;
    private CreateForm _createForm = new();

    // Onboarding modal
    private bool _showOnboardingModal;
    private bool _isOnboardingSaving;
    private OnboardingForm _onboardingForm = new();
    private TenantOnboardingResult? _onboardingResult;
    private List<string> _onboardingValidationErrors = [];

    private readonly List<VanASelect.SelectOption> _businessTypeOptions =
    [
        new("Company", "Công ty"),
        new("HouseholdBusiness", "Hộ kinh doanh")
    ];

    private readonly List<VanASelect.SelectOption> _hkdGroupOptions =
    [
        new("Group1", "Nhóm 1"),
        new("Group2", "Nhóm 2"),
        new("Group3", "Nhóm 3")
    ];

    private readonly List<VanASelect.SelectOption> _industryOptions =
    [
        new("F&B", "F&B - Ăn uống"),
        new("SPA", "SPA - Chưa triển khai"),
        new("HOTEL", "HOTEL - Chưa triển khai"),
        new("BARBER", "BARBER - Chưa triển khai"),
        new("CLOTHES", "CLOTHES - Chưa triển khai"),
        new("HEALTHY", "HEALTHY - Chưa triển khai"),
        new("PETSHOP", "PETSHOP - Chưa triển khai")
    ];

    // Suspend / deactivate modals
    private bool _showSuspendModal;
    private bool _showDeactivateModal;
    private TenantApiDto? _selectedTenant;
    private string _reasonInput = string.Empty;

    // Edit modal (assign ShopInstance + update profile)
    private bool _showEditModal;
    private EditForm _editForm = new();

    // Impersonation state (AM-T7)
    private bool _isImpersonating;
    private bool _isExitingImpersonation;
    private Guid _impersonatedTenantId;
    private string _impersonatedTenantName = string.Empty;
    private Guid _impersonatingTenantId; // tracks which tenant's button is loading

    // Crawl-to-Onboard Phase 7: Tab state + Pending/Duplicates
    private string _activeTab = "all";
    private List<PendingTenantApiDto> _pendingTenants = [];
    private List<DuplicateTenantApiDto> _duplicates = [];
    private bool _isLoadingPending;
    private bool _isLoadingDuplicates;

    // Verify modal (direct verify Pending tenant)
    private bool _showVerifyModal;
    private PendingTenantApiDto? _selectedPending;
    private VerifyForm _verifyForm = new();
    private bool _isVerifying;
    private bool _showPassword;
    private string _verifyError = string.Empty;
    private VerifyResultApiDto? _verifyResult;

    // Resolve duplicate modal
    private bool _showResolveDuplicateModal;
    private DuplicateTenantApiDto? _selectedDuplicate;
    private string _resolveDuplicateReason = string.Empty;
    private bool _isResolving;

    protected override async Task OnInitializedAsync()
    {
        // AM-T7: Check if already impersonating a tenant
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var tenantClaim = authState.User.FindFirst("tenant_id");
        if (tenantClaim != null && Guid.TryParse(tenantClaim.Value, out var tid) && tid != Guid.Empty)
        {
            _isImpersonating = true;
            _impersonatedTenantId = tid;
            _impersonatedTenantName = $"Tenant {tid.ToString("N")[..8]}";
        }
        await LoadTenants();
        await LoadShopInstances();
    }

    private async Task LoadTenants()
    {
        _isLoading = true;
        try
        {
            // Load from Gateway API (PostgreSQL) — NOT local SQLite
            _tenants = await TenantApi.ListAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load tenants from Gateway API");
            ShowAlert("error", "Không thể tải danh sách tenant từ Gateway.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Phase 6: Load ShopInstances for column display + onboarding dropdown
    private async Task LoadShopInstances()
    {
        try
        {
            _shopInstances = await ShopInstanceApi.ListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load ShopInstances — column will show 'Chưa gán'");
            _shopInstances = [];
        }
    }

    // ── Crawl-to-Onboard Phase 7: Tabs + Pending + Duplicates ──────────────

    private string TabClass(string tab) => _activeTab == tab ? "tenant-tab active" : "tenant-tab";

    private async Task SwitchTab(string tab)
    {
        if (_activeTab == tab) return;
        _activeTab = tab;
        if (tab == "pending" && _pendingTenants.Count == 0) await LoadPendingTenants();
        if (tab == "duplicates" && _duplicates.Count == 0) await LoadDuplicates();
    }

    private async Task LoadPendingTenants()
    {
        _isLoadingPending = true;
        try { _pendingTenants = await ClaimApi.ListPendingAsync(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Pending tenants");
            ShowAlert("error", "Không thể tải danh sách Pending tenant.");
        }
        finally { _isLoadingPending = false; }
    }

    private async Task LoadDuplicates()
    {
        _isLoadingDuplicates = true;
        try { _duplicates = await ClaimApi.ListDuplicatesAsync(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load duplicates");
            ShowAlert("error", "Không thể tải danh sách trùng lặp.");
        }
        finally { _isLoadingDuplicates = false; }
    }

    // ── Verify (direct verify Pending tenant) ──────────────────────────────

    private void OpenVerifyModal(PendingTenantApiDto p)
    {
        _selectedPending = p;
        _verifyForm = new VerifyForm
        {
            OwnerDisplayName = p.Name, // default display name = tenant name
            Slug = GenerateSlugFromName(p.Name)
        };
        _verifyResult = null;
        _verifyError = string.Empty;
        _showPassword = false;
        _showVerifyModal = true;
    }

    private string GetVerifyAlertMessage()
        => _selectedPending is null ? string.Empty
            : $"Verify tenant: {_selectedPending.Name} (MST: {_selectedPending.TaxCode ?? "N/A"})";

    private void CloseVerifyModal()
    {
        _showVerifyModal = false;
        _selectedPending = null;
        _verifyResult = null;
        _verifyError = string.Empty;
    }

    private static string GenerateSlugFromName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return string.Empty;
        // Simple slugify: lowercase, replace spaces with dashes, remove non-alphanumeric
        return name.Trim().ToLowerInvariant()
            .Replace(" ", "-")
            .Replace("--", "-")
            .Where(c => char.IsLetterOrDigit(c) || c == '-')
            .Aggregate(new StringBuilder(), (sb, c) => sb.Append(c))
            .ToString()
            .Trim('-');
    }

    private void GeneratePassword()
    {
        // Generate random password: 12 chars, mix of letters/digits/symbols
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@#$%";
        var rng = new Random();
        _verifyForm.OwnerPassword = new string(Enumerable.Range(0, 12)
            .Select(_ => chars[rng.Next(chars.Length)]).ToArray());
        _showPassword = true;
    }

    private async Task HandleVerifySubmit()
    {
        if (_selectedPending is null) return;
        _verifyError = string.Empty;

        if (string.IsNullOrWhiteSpace(_verifyForm.OwnerUsername))
        { _verifyError = "Tên đăng nhập owner là bắt buộc."; return; }
        if (string.IsNullOrWhiteSpace(_verifyForm.OwnerPassword) || _verifyForm.OwnerPassword.Length < 8)
        { _verifyError = "Mật khẩu phải có ít nhất 8 ký tự."; return; }
        if (string.IsNullOrWhiteSpace(_verifyForm.OwnerDisplayName))
        { _verifyError = "Tên hiển thị owner là bắt buộc."; return; }
        if (!_verifyForm.ShopInstanceId.HasValue || _verifyForm.ShopInstanceId.Value == Guid.Empty)
        { _verifyError = "Vui lòng chọn ShopERP Instance."; return; }

        _isVerifying = true;
        try
        {
            var request = new VerifyTenantApiRequest(
                _verifyForm.OwnerUsername.Trim(),
                _verifyForm.OwnerPassword,
                _verifyForm.OwnerDisplayName.Trim(),
                Slug: string.IsNullOrWhiteSpace(_verifyForm.Slug) ? null : _verifyForm.Slug.Trim(),
                ShopInstanceId: _verifyForm.ShopInstanceId);
            _verifyResult = await ClaimApi.DirectVerifyAsync(_selectedPending.Id, request);
            ShowAlert("success", $"Tenant '{_selectedPending.Name}' đã được verify thành công.");
            await LoadPendingTenants(); // refresh list
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Verify failed for tenant {TenantId}", _selectedPending.Id);
            _verifyError = $"Lỗi: {ex.Message}";
        }
        finally { _isVerifying = false; }
    }

