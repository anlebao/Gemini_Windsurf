@page "/admin/tenants"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Web
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using VanAn.CoreHub.Services
@using VanAn.CoreHub.Services.Onboarding
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Aggregates.TenantAggregate
@inject ITenantManagementService TenantService
@inject TenantOnboardingApiClient OnboardingApiClient
@inject IThemeProvider ThemeProvider
@inject ILogger<TenantManagement> Logger
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@inject AuthenticationStateProvider AuthStateProvider

@attribute [Authorize(Policy = "SystemAdmin")]

<div class="tenant-management-page @ThemeProvider.CurrentTheme">
    <!-- DEBUG: Simple test button to isolate interactivity issue -->
    <div style="padding: 10px; background: yellow; z-index: 9999;">
        <button type="button" @onclick="TestSimpleClick" data-testid="simple-test-btn">
            DEBUG: Simple @@onclick Test (clicked: @_testClickCount)
        </button>
    </div>
    <!-- Header -->
    <header class="page-header">
        <h1>Quản lý Tenant</h1>
        <div class="header-actions">
            <VanAButton Variant="primary" Size="small" OnClick="OpenCreateModal">
                + Tạo tenant mới
            </VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="OpenOnboardingModal">
                + Tạo Tenant + Onboarding
            </VanAButton>
            <VanAButton Variant="secondary" Size="small" OnClick="LoadTenants">
                Làm mới
            </VanAButton>
        </div>
    </header>

    <!-- Impersonation status -->
    @if (_isImpersonating)
    {
        <VanAAlert Type="warning" Dismissible="false">
            <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                <span>Đang truy cập với tư cách tenant: <strong>@_impersonatedTenantName</strong> (ID: @_impersonatedTenantId)</span>
                <VanAButton Variant="danger" Size="small" OnClick="ExitImpersonation" IsLoading="@_isExitingImpersonation">
                    Thoát impersonation
                </VanAButton>
            </div>
        </VanAAlert>
    }

    <!-- Alert -->
    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Type="@_alertType" Message="@_alertMessage" OnClose="() => _alertMessage = string.Empty" />
    }

    <!-- Tenant list -->
    @if (_isLoading)
    {
        <VanACard>
            <div class="loading-state">
                <VanASpinner Size="large" />
                <p>Đang tải danh sách tenant...</p>
            </div>
        </VanACard>
    }
    else if (_tenants.Count == 0)
    {
        <VanACard>
            <div class="empty-state">
                <p>Chưa có tenant nào. Nhấn "+ Tạo tenant mới" để bắt đầu.</p>
            </div>
        </VanACard>
    }
    else
    {
        <VanACard Header="@($"Danh sách Tenant ({_tenants.Count})")">
            <table class="vanan-table">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Loại hình</th>
                        <th>Trạng thái</th>
                        <th>Email liên hệ</th>
                        <th>Ngày tạo</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _tenants)
                    {
                        <tr>
                            <td><strong>@t.Name</strong></td>
                            <td>@(t.IsHouseholdBusiness() ? "Hộ kinh doanh" : "Công ty")</td>
                            <td>
                                <span class="status-badge status-@t.Status.ToString().ToLower()">
                                    @StatusLabel(t.Status)
                                </span>
                            </td>
                            <td>@(t.Settings.ContactEmail ?? "-")</td>
                            <td>@t.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td class="action-cell">
                                <VanAButton Variant="info" Size="small" OnClick="() => NavigateToQuickSetup(t)">
                                    Khởi tạo nhanh
                                </VanAButton>
                                @if (t.Status == TenantStatus.Active)
                                {
                                    <VanAButton Variant="outline" Size="small" OnClick="() => OpenSuspendModal(t)">
                                        Tạm ngưng
                                    </VanAButton>
                                }
                                @if (t.Status == TenantStatus.Suspended)
                                {
                                    <VanAButton Variant="secondary" Size="small" OnClick="() => ReactivateTenant(t)">
                                        Kích hoạt
                                    </VanAButton>
                                }
                                @if (t.Status != TenantStatus.Inactive)
                                {
                                    <VanAButton Variant="danger" Size="small" OnClick="() => OpenDeactivateModal(t)">
                                        Vô hiệu hoá
                                    </VanAButton>
                                }
                                @if (t.Status == TenantStatus.Active)
                                {
                                    <VanAButton Variant="primary" Size="small" OnClick="() => ImpersonateTenant(t)" IsLoading="@(_impersonatingTenantId == t.Id.Value)">
                                        Truy cập
                                    </VanAButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </VanACard>
    }

    <!-- Create modal -->
    @if (_showCreateModal)
    {
        <VanAModal Title="Tạo Tenant Mới" OnClose="CloseCreateModal">
            <VanAForm OnValidSubmit="HandleCreateSubmit" aria-label="Tạo tenant mới">
                <div class="form-group">
                    <label for="tenant-name">Tên tenant *</label>
                    <input id="tenant-name" class="vanan-input" @bind="_createForm.Name" placeholder="Nhập tên doanh nghiệp..." aria-label="Tên tenant" required />
                </div>
                <div class="form-group">
                    <label for="tenant-businesstype">Loại hình *</label>
                    <select id="tenant-businesstype" class="vanan-select" @bind="_createForm.BusinessTypeStr" aria-label="Loại hình doanh nghiệp">
                        <option value="Company">Công ty</option>
                        <option value="HouseholdBusiness">Hộ kinh doanh</option>
                    </select>
                </div>
                @if (_createForm.BusinessTypeStr == "HouseholdBusiness")
                {
                    <div class="form-group">
                        <label for="tenant-hkdgroup">Nhóm HKD *</label>
                        <select id="tenant-hkdgroup" class="vanan-select" @bind="_createForm.HKDGroupStr" aria-label="Nhóm hộ kinh doanh">
                            <option value="Group1">Nhóm 1</option>
                            <option value="Group2">Nhóm 2</option>
                            <option value="Group3">Nhóm 3</option>
                        </select>
                    </div>
                }
                <div class="form-group">
                    <label for="tenant-email">Email liên hệ</label>
                    <input id="tenant-email" class="vanan-input" type="email" @bind="_createForm.ContactEmail" placeholder="email@example.com" aria-label="Email liên hệ" />
                </div>
                <div class="form-group">
                    <label for="tenant-phone">Số điện thoại</label>
                    <input id="tenant-phone" class="vanan-input" @bind="_createForm.ContactPhone" placeholder="+84..." aria-label="Số điện thoại" />
                </div>
                <div class="form-group">
                    <label for="tenant-address">Địa chỉ</label>
                    <input id="tenant-address" class="vanan-input" @bind="_createForm.Address" aria-label="Địa chỉ" />
                </div>
                <div class="form-group">
                    <label for="tenant-taxcode">Mã số thuế</label>
                    <input id="tenant-taxcode" class="vanan-input" @bind="_createForm.TaxCode" aria-label="Mã số thuế" />
                </div>
                <div class="modal-actions">
                    <VanAButton Variant="primary" Type="submit" IsLoading="@_isSaving">Tạo</VanAButton>
                    <VanAButton Variant="outline" OnClick="CloseCreateModal">Huỷ</VanAButton>
                </div>
            </VanAForm>
        </VanAModal>
    }

    <!-- Onboarding modal -->
    @if (_showOnboardingModal)
    {
        <VanAModal Title="Tạo Tenant + Onboarding" OnClose="CloseOnboardingModal" Size="large">
            @if (_onboardingResult is not null)
            {
                <VanACard Header="Onboarding thành công">
                    <VanAAlert Type="success" Message="Tenant và owner đã được tạo thành công." Dismissible="false" />
                    <div class="onboarding-result">
                        <p><strong>Tenant ID:</strong> @_onboardingResult.TenantId</p>
                        <p><strong>Owner ID:</strong> @_onboardingResult.OwnerUserId</p>
                        <p><strong>Shops:</strong> @_onboardingResult.ShopsCreated</p>
                        <p><strong>Products:</strong> @_onboardingResult.ProductsCreated</p>
                        <p><strong>Ingredients:</strong> @_onboardingResult.IngredientsCreated</p>
                        <p><strong>Recipes:</strong> @_onboardingResult.RecipesCreated</p>
                        <p><strong>Permission groups:</strong> @_onboardingResult.PermissionGroupsCreated</p>
                    </div>
                </VanACard>
                <div class="modal-actions">
                    <VanAButton Variant="primary" OnClick="CloseOnboardingModalAndRefresh">Đóng</VanAButton>
                </div>
            }
            else
            {
                <VanAForm OnValidSubmit="HandleOnboardingSubmit" aria-label="Tạo tenant onboarding">
                    <div class="form-row">
                        <div class="form-group form-group-half">
                            <label for="onboarding-name">Tên tenant *</label>
                            <VanAInput Id="onboarding-name" @bind-Value="_onboardingForm.Name" Placeholder="Nhập tên doanh nghiệp..." AriaLabel="Tên tenant" Required="true" />
                        </div>
                        <div class="form-group form-group-half">
                            <label for="onboarding-businesstype">Loại hình *</label>
                            <VanASelect Id="onboarding-businesstype" @bind-Value="_onboardingForm.BusinessTypeStr" Options="_businessTypeOptions" AriaLabel="Loại hình doanh nghiệp" />
                        </div>
                    </div>
                    @if (_onboardingForm.BusinessTypeStr == "HouseholdBusiness")
                    {
                        <div class="form-group">
                            <label for="onboarding-hkdgroup">Nhóm HKD *</label>
                            <VanASelect Id="onboarding-hkdgroup" @bind-Value="_onboardingForm.HKDGroupStr" Options="_hkdGroupOptions" AriaLabel="Nhóm hộ kinh doanh" />
                        </div>
                    }
                    <div class="form-row">
                        <div class="form-group form-group-half">
                            <label for="onboarding-email">Email liên hệ</label>
                            <VanAInput Id="onboarding-email" Type="email" @bind-Value="_onboardingForm.ContactEmail" Placeholder="email@example.com" AriaLabel="Email liên hệ" />
                        </div>
                        <div class="form-group form-group-half">
                            <label for="onboarding-phone">Số điện thoại</label>
                            <VanAInput Id="onboarding-phone" @bind-Value="_onboardingForm.ContactPhone" Placeholder="+84..." AriaLabel="Số điện thoại" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="onboarding-address">Địa chỉ</label>
                        <VanAInput Id="onboarding-address" @bind-Value="_onboardingForm.Address" AriaLabel="Địa chỉ" />
                    </div>
                    <div class="form-group">
                        <label for="onboarding-taxcode">Mã số thuế</label>
                        <VanAInput Id="onboarding-taxcode" @bind-Value="_onboardingForm.TaxCode" AriaLabel="Mã số thuế" />
                    </div>
                    <div class="form-group">
                        <label for="onboarding-industry">Ngành nghề *</label>
                        <VanASelect Id="onboarding-industry" @bind-Value="_onboardingForm.IndustryCode" Options="_industryOptions" AriaLabel="Ngành nghề" />
                    </div>
                    <div class="form-row">
                        <div class="form-group form-group-half">
                            <label for="onboarding-ownerusername">Tên đăng nhập owner *</label>
                            <VanAInput Id="onboarding-ownerusername" @bind-Value="_onboardingForm.OwnerUsername" Placeholder="owner@tenant.vn" AriaLabel="Tên đăng nhập owner" Required="true" />
                        </div>
                        <div class="form-group form-group-half">
                            <label for="onboarding-ownerpassword">Mật khẩu owner *</label>
                            <VanAInput Id="onboarding-ownerpassword" Type="password" @bind-Value="_onboardingForm.OwnerPassword" Placeholder="Tối thiểu 8 ký tự" AriaLabel="Mật khẩu owner" Required="true" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="onboarding-ownerdisplayname">Tên hiển thị owner *</label>
                        <VanAInput Id="onboarding-ownerdisplayname" @bind-Value="_onboardingForm.OwnerDisplayName" Placeholder="Chủ doanh nghiệp" AriaLabel="Tên hiển thị owner" Required="true" />
                    </div>
                    @if (_onboardingValidationErrors.Count > 0)
                    {
                        <VanAAlert Type="error" Message="@string.Join(" ", _onboardingValidationErrors)" Dismissible="false" />
                    }
                    <div class="modal-actions">
                        <VanAButton Variant="primary" Type="submit" IsLoading="@_isOnboardingSaving">Tạo + Onboarding</VanAButton>
                        <VanAButton Variant="outline" OnClick="CloseOnboardingModal">Huỷ</VanAButton>
                    </div>
                </VanAForm>
                @if (_isOnboardingSaving)
                {
                    <div class="onboarding-loading">
                        <VanASpinner Size="medium" Label="Đang tạo tenant..." />
                    </div>
                }
            }
        </VanAModal>
    }

    <!-- Suspend modal -->
    @if (_showSuspendModal && _selectedTenant is not null)
    {
        <VanAModal Title="Tạm ngưng Tenant" OnClose="CloseSuspendModal">
            <p>Tạm ngưng tenant: <strong>@_selectedTenant.Name</strong></p>
            <div class="form-group">
                <label>Lý do *</label>
                <input class="vanan-input" @bind="_reasonInput" placeholder="Nhập lý do tạm ngưng..." />
            </div>
            <div class="modal-actions">
                <VanAButton Variant="warning" OnClick="ConfirmSuspend" IsLoading="@_isSaving">Xác nhận tạm ngưng</VanAButton>
                <VanAButton Variant="outline" OnClick="CloseSuspendModal">Huỷ</VanAButton>
            </div>
        </VanAModal>
    }

    <!-- Deactivate modal -->
    @if (_showDeactivateModal && _selectedTenant is not null)
    {
        <VanAModal Title="Vô hiệu hoá Tenant" OnClose="CloseDeactivateModal">
            <VanAAlert Type="error" Message="Thao tác này không thể hoàn tác! Tenant sẽ bị vô hiệu hoá vĩnh viễn." />
            <p>Vô hiệu hoá tenant: <strong>@_selectedTenant.Name</strong></p>
            <div class="form-group">
                <label>Lý do *</label>
                <input class="vanan-input" @bind="_reasonInput" placeholder="Nhập lý do vô hiệu hoá..." />
            </div>
            <div class="modal-actions">
                <VanAButton Variant="danger" OnClick="ConfirmDeactivate" IsLoading="@_isSaving">Xác nhận vô hiệu hoá</VanAButton>
                <VanAButton Variant="outline" OnClick="CloseDeactivateModal">Huỷ</VanAButton>
            </div>
        </VanAModal>
    }
</div>

@code {
#pragma warning disable CS0618 // Tenant obsolete — using new TenantAggregate.Tenant explicitly below
    // Use FQN to disambiguate: both VanAn.Shared.Domain.Tenant and TenantAggregate.Tenant exist
    private List<VanAn.Shared.Domain.Aggregates.TenantAggregate.Tenant> _tenants = [];
    private bool _isLoading;
    private bool _isSaving;
    private string _alertMessage = string.Empty;
    private string _alertType = "info";

    // DEBUG: Simple test click handler
    private int _testClickCount;
    private void TestSimpleClick()
    {
        _testClickCount++;
        Logger.LogInformation("DEBUG: TestSimpleClick called — count: {Count}", _testClickCount);
    }

    // Create modal
    private bool _showCreateModal;
    private CreateForm _createForm = new();

    // Onboarding modal
    private bool _showOnboardingModal;
    private bool _isOnboardingSaving;
    private OnboardingForm _onboardingForm = new();
    private TenantOnboardingResult? _onboardingResult;
    private List<string> _onboardingValidationErrors = [];

    private readonly List<VanASelect.SelectOption> _businessTypeOptions =
    [
        new("Company", "Công ty"),
        new("HouseholdBusiness", "Hộ kinh doanh")
    ];

    private readonly List<VanASelect.SelectOption> _hkdGroupOptions =
    [
        new("Group1", "Nhóm 1"),
        new("Group2", "Nhóm 2"),
        new("Group3", "Nhóm 3")
    ];

    private readonly List<VanASelect.SelectOption> _industryOptions =
    [
        new("F&B", "F&B - Ăn uống"),
        new("SPA", "SPA - Chưa triển khai"),
        new("HOTEL", "HOTEL - Chưa triển khai"),
        new("BARBER", "BARBER - Chưa triển khai"),
        new("CLOTHES", "CLOTHES - Chưa triển khai"),
        new("HEALTHY", "HEALTHY - Chưa triển khai"),
        new("PETSHOP", "PETSHOP - Chưa triển khai")
    ];

    // Suspend / deactivate modals
    private bool _showSuspendModal;
    private bool _showDeactivateModal;
    private VanAn.Shared.Domain.Aggregates.TenantAggregate.Tenant? _selectedTenant;
    private string _reasonInput = string.Empty;

    // Impersonation state (AM-T7)
    private bool _isImpersonating;
    private bool _isExitingImpersonation;
    private Guid _impersonatedTenantId;
    private string _impersonatedTenantName = string.Empty;
    private Guid _impersonatingTenantId; // tracks which tenant's button is loading

    protected override async Task OnInitializedAsync()
    {
        // AM-T7: Check if already impersonating a tenant
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var tenantClaim = authState.User.FindFirst("tenant_id");
        if (tenantClaim != null && Guid.TryParse(tenantClaim.Value, out var tid) && tid != Guid.Empty)
        {
            _isImpersonating = true;
            _impersonatedTenantId = tid;
            _impersonatedTenantName = $"Tenant {tid.ToString("N")[..8]}";
        }
        await LoadTenants();
    }

    private async Task LoadTenants()
    {
        _isLoading = true;
        try
        {
            var list = await TenantService.ListTenantsAsync();
            _tenants = [.. list];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load tenants");
            ShowAlert("error", "Không thể tải danh sách tenant.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ── Create ────────────────────────────────────────────────────────────────
    private void OpenCreateModal() { _createForm = new(); _showCreateModal = true; }
    private void CloseCreateModal() => _showCreateModal = false;

    private async Task HandleCreateSubmit()
    {
        _isSaving = true;
        try
        {
            var businessType = _createForm.BusinessTypeStr == "HouseholdBusiness"
                ? BusinessType.HouseholdBusiness
                : BusinessType.Company;

            HKDGroup? hkdGroup = businessType == BusinessType.HouseholdBusiness
                ? Enum.TryParse<HKDGroup>(_createForm.HKDGroupStr, out var g) ? g : HKDGroup.Group1
                : null;

            var request = new CreateTenantRequest(
                _createForm.Name,
                businessType,
                hkdGroup,
                _createForm.ContactEmail,
                _createForm.ContactPhone,
                _createForm.Address,
                _createForm.TaxCode);

            await TenantService.CreateTenantAsync(request);
            _showCreateModal = false;
            ShowAlert("success", $"Tenant '{_createForm.Name}' đã được tạo thành công.");
            await LoadTenants();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create tenant");
            ShowAlert("error", $"Lỗi: {ex.Message}");
        }
        finally { _isSaving = false; }
    }

    // ── Onboarding ────────────────────────────────────────────────────────────
    private void OpenOnboardingModal() { _onboardingForm = new(); _onboardingResult = null; _onboardingValidationErrors = []; _showOnboardingModal = true; }
    private void CloseOnboardingModal() => _showOnboardingModal = false;

    private void CloseOnboardingModalAndRefresh()
    {
        _showOnboardingModal = false;
        _ = LoadTenants();
    }

    private bool ValidateOnboardingForm()
    {
        _onboardingValidationErrors = [];
        if (string.IsNullOrWhiteSpace(_onboardingForm.Name))
            _onboardingValidationErrors.Add("Tên tenant là bắt buộc.");
        if (string.IsNullOrWhiteSpace(_onboardingForm.OwnerUsername))
            _onboardingValidationErrors.Add("Tên đăng nhập owner là bắt buộc.");
        if (string.IsNullOrWhiteSpace(_onboardingForm.OwnerPassword) || _onboardingForm.OwnerPassword.Length < 8)
            _onboardingValidationErrors.Add("Mật khẩu owner phải có ít nhất 8 ký tự.");
        if (string.IsNullOrWhiteSpace(_onboardingForm.OwnerDisplayName))
            _onboardingValidationErrors.Add("Tên hiển thị owner là bắt buộc.");
        if (!string.IsNullOrWhiteSpace(_onboardingForm.ContactEmail) && !_onboardingForm.ContactEmail.Contains('@'))
            _onboardingValidationErrors.Add("Email liên hệ không hợp lệ.");
        if (_onboardingForm.BusinessTypeStr == "HouseholdBusiness" && string.IsNullOrWhiteSpace(_onboardingForm.HKDGroupStr))
            _onboardingValidationErrors.Add("Nhóm HKD là bắt buộc khi chọn Hộ kinh doanh.");
        return _onboardingValidationErrors.Count == 0;
    }

    private async Task HandleOnboardingSubmit()
    {
        if (!ValidateOnboardingForm())
            return;

        _isOnboardingSaving = true;
        try
        {
            var businessType = _onboardingForm.BusinessTypeStr == "HouseholdBusiness"
                ? BusinessType.HouseholdBusiness
                : BusinessType.Company;

            HKDGroup? hkdGroup = businessType == BusinessType.HouseholdBusiness
                ? Enum.TryParse<HKDGroup>(_onboardingForm.HKDGroupStr, out var g) ? g : HKDGroup.Group1
                : null;

            var request = new OnboardTenantRequest(
                _onboardingForm.Name,
                businessType,
                hkdGroup,
                _onboardingForm.ContactEmail,
                _onboardingForm.ContactPhone,
                _onboardingForm.Address,
                _onboardingForm.TaxCode,
                _onboardingForm.IndustryCode,
                _onboardingForm.OwnerUsername,
                _onboardingForm.OwnerPassword,
                _onboardingForm.OwnerDisplayName);

            _onboardingResult = await OnboardingApiClient.OnboardAsync(request);
            ShowAlert("success", $"Tenant onboarding '{_onboardingForm.Name}' thành công.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create tenant onboarding");
            _onboardingValidationErrors = [ $"Lỗi: {ex.Message}" ];
        }
        finally { _isOnboardingSaving = false; }
    }

    // ── Suspend ───────────────────────────────────────────────────────────────
    private void OpenSuspendModal(VanAn.Shared.Domain.Aggregates.TenantAggregate.Tenant t) { _selectedTenant = t; _reasonInput = string.Empty; _showSuspendModal = true; }
    private void CloseSuspendModal() => _showSuspendModal = false;

    private async Task ConfirmSuspend()
    {
        if (_selectedTenant is null || string.IsNullOrWhiteSpace(_reasonInput)) return;
        _isSaving = true;
        try
        {
            await TenantService.SuspendAsync(_selectedTenant.Id, _reasonInput);
            _showSuspendModal = false;
            ShowAlert("success", $"Tenant '{_selectedTenant.Name}' đã được tạm ngưng.");
            await LoadTenants();
        }
        catch (Exception ex) { ShowAlert("error", ex.Message); }
        finally { _isSaving = false; }
    }

    // ── Reactivate ────────────────────────────────────────────────────────────
    private async Task ReactivateTenant(VanAn.Shared.Domain.Aggregates.TenantAggregate.Tenant t)
    {
        _isSaving = true;
        try
        {
            await TenantService.ReactivateAsync(t.Id);
            ShowAlert("success", $"Tenant '{t.Name}' đã được kích hoạt lại.");
            await LoadTenants();
        }
        catch (Exception ex) { ShowAlert("error", ex.Message); }
        finally { _isSaving = false; }
    }

    // ── Deactivate ────────────────────────────────────────────────────────────
    private void OpenDeactivateModal(VanAn.Shared.Domain.Aggregates.TenantAggregate.Tenant t) { _selectedTenant = t; _reasonInput = string.Empty; _showDeactivateModal = true; }
    private void CloseDeactivateModal() => _showDeactivateModal = false;

    private async Task ConfirmDeactivate()
    {
        if (_selectedTenant is null || string.IsNullOrWhiteSpace(_reasonInput)) return;
        _isSaving = true;
        try
        {
            await TenantService.DeactivateAsync(_selectedTenant.Id, _reasonInput);
            _showDeactivateModal = false;
            ShowAlert("success", $"Tenant '{_selectedTenant.Name}' đã bị vô hiệu hoá.");
            await LoadTenants();
        }
        catch (Exception ex) { ShowAlert("error", ex.Message); }
        finally { _isSaving = false; }
    }

    // ── Impersonation (AM-T7) ─────────────────────────────────────────────────

    private void NavigateToQuickSetup(VanAn.Shared.Domain.Aggregates.TenantAggregate.Tenant tenant)
    {
        NavigationManager.NavigateTo($"/quick-setup?tenantId={tenant.Id.Value}");
    }

    private async Task ImpersonateTenant(VanAn.Shared.Domain.Aggregates.TenantAggregate.Tenant tenant)
    {
        _impersonatingTenantId = tenant.Id.Value;
        try
        {
            var response = await HttpClient.PostAsync($"/api/admin/impersonate/{tenant.Id.Value}", null);
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                ShowAlert("error", $"Không thể truy cập tenant '{tenant.Name}': {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to impersonate tenant {TenantId}", tenant.Id.Value);
            ShowAlert("error", $"Lỗi kết nối: {ex.Message}");
        }
        finally { _impersonatingTenantId = Guid.Empty; }
    }

    private async Task ExitImpersonation()
    {
        _isExitingImpersonation = true;
        try
        {
            var response = await HttpClient.PostAsync("/api/admin/exit-impersonation", null);
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/admin/tenants", forceLoad: true);
            }
            else
            {
                ShowAlert("error", "Không thể thoát impersonation.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to exit impersonation");
            ShowAlert("error", $"Lỗi kết nối: {ex.Message}");
        }
        finally { _isExitingImpersonation = false; }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private void ShowAlert(string type, string message) { _alertType = type; _alertMessage = message; }

    private static string StatusLabel(TenantStatus status) => status switch
    {
        TenantStatus.Active => "Hoạt động",
        TenantStatus.Suspended => "Tạm ngưng",
        TenantStatus.Inactive => "Vô hiệu",
        _ => status.ToString()
    };

