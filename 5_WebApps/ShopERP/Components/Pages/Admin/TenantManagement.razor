    private async Task ConfirmResolveDuplicate()
    {
        if (_selectedDuplicate is null) return;
        if (string.IsNullOrWhiteSpace(_resolveDuplicateReason))
        { ShowAlert("error", "Vui lòng nhập lý do."); return; }
        if (!_selectedDuplicate.PotentialDuplicateOf.HasValue)
        { ShowAlert("error", "Không xác định được tenant canonical để deactivate."); return; }

        _isResolving = true;
        try
        {
            // Keep = selected duplicate, Deactivate = canonical it duplicates of
            await ClaimApi.ResolveDuplicateAsync(
                _selectedDuplicate.TenantId,
                _selectedDuplicate.PotentialDuplicateOf.Value,
                _resolveDuplicateReason);
            ShowAlert("success", $"Đã giữ tenant '{_selectedDuplicate.TenantName}', tenant trùng đã Inactive.");
            _showResolveDuplicateModal = false;
            await LoadDuplicates();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resolve duplicate failed for {TenantId}", _selectedDuplicate.TenantId);
            ShowAlert("error", $"Lỗi: {ex.Message}");
        }
        finally { _isResolving = false; }
    }

