    // ── Create ────────────────────────────────────────────────────────────────
    private void OpenCreateModal() { _createForm = new(); _showCreateModal = true; }
    private void CloseCreateModal() => _showCreateModal = false;

    private async Task HandleCreateSubmit()
    {
        _isSaving = true;
        try
        {
            var businessType = _createForm.BusinessTypeStr == "HouseholdBusiness"
                ? BusinessType.HouseholdBusiness
                : BusinessType.Company;

            HKDGroup? hkdGroup = businessType == BusinessType.HouseholdBusiness
                ? Enum.TryParse<HKDGroup>(_createForm.HKDGroupStr, out var g) ? g : HKDGroup.Group1
                : null;

            var request = new CreateTenantRequest(
                _createForm.Name,
                businessType,
                hkdGroup,
                _createForm.ContactEmail,
                _createForm.ContactPhone,
                _createForm.Address,
                _createForm.TaxCode);

            await TenantService.CreateTenantAsync(request);
            _showCreateModal = false;
            ShowAlert("success", $"Tenant '{_createForm.Name}' đã được tạo thành công.");
            await LoadTenants();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create tenant");
            ShowAlert("error", $"Lỗi: {ex.Message}");
        }
        finally { _isSaving = false; }
    }

    // ── Onboarding ────────────────────────────────────────────────────────────
    private void OpenOnboardingModal() { _onboardingForm = new(); _onboardingResult = null; _onboardingValidationErrors = []; _showOnboardingModal = true; }
    private void CloseOnboardingModal() => _showOnboardingModal = false;

    private void CloseOnboardingModalAndRefresh()
    {
        _showOnboardingModal = false;
        _ = LoadTenants();
    }

    private bool ValidateOnboardingForm()
    {
        _onboardingValidationErrors = [];
        if (string.IsNullOrWhiteSpace(_onboardingForm.Name))
            _onboardingValidationErrors.Add("Tên tenant là bắt buộc.");
        if (string.IsNullOrWhiteSpace(_onboardingForm.OwnerUsername))
            _onboardingValidationErrors.Add("Tên đăng nhập owner là bắt buộc.");
        if (string.IsNullOrWhiteSpace(_onboardingForm.OwnerPassword) || _onboardingForm.OwnerPassword.Length < 8)
            _onboardingValidationErrors.Add("Mật khẩu owner phải có ít nhất 8 ký tự.");
        if (string.IsNullOrWhiteSpace(_onboardingForm.OwnerDisplayName))
            _onboardingValidationErrors.Add("Tên hiển thị owner là bắt buộc.");
        if (!string.IsNullOrWhiteSpace(_onboardingForm.ContactEmail) && !_onboardingForm.ContactEmail.Contains('@'))
            _onboardingValidationErrors.Add("Email liên hệ không hợp lệ.");
        if (_onboardingForm.BusinessTypeStr == "HouseholdBusiness" && string.IsNullOrWhiteSpace(_onboardingForm.HKDGroupStr))
            _onboardingValidationErrors.Add("Nhóm HKD là bắt buộc khi chọn Hộ kinh doanh.");
        // Phase 6: ShopInstance required for multi-VPS routing
        if (!_onboardingForm.ShopInstanceId.HasValue || _onboardingForm.ShopInstanceId.Value == Guid.Empty)
            _onboardingValidationErrors.Add("ShopERP Instance là bắt buộc (tạo tại /admin/shop-instances nếu chưa có).");
        return _onboardingValidationErrors.Count == 0;
    }

    private async Task HandleOnboardingSubmit()
    {
        if (!ValidateOnboardingForm())
            return;

        _isOnboardingSaving = true;
        try
        {
            var businessType = _onboardingForm.BusinessTypeStr == "HouseholdBusiness"
                ? BusinessType.HouseholdBusiness
                : BusinessType.Company;

            HKDGroup? hkdGroup = businessType == BusinessType.HouseholdBusiness
                ? Enum.TryParse<HKDGroup>(_onboardingForm.HKDGroupStr, out var g) ? g : HKDGroup.Group1
                : null;

            var request = new OnboardTenantRequest(
                _onboardingForm.Name,
                businessType,
                hkdGroup,
                _onboardingForm.ContactEmail,
                _onboardingForm.ContactPhone,
                _onboardingForm.Address,
                _onboardingForm.TaxCode,
                _onboardingForm.IndustryCode,
                _onboardingForm.OwnerUsername,
                _onboardingForm.OwnerPassword,
                _onboardingForm.OwnerDisplayName,
                _onboardingForm.ShopInstanceId);

            _onboardingResult = await OnboardingApiClient.OnboardAsync(request);
            ShowAlert("success", $"Tenant onboarding '{_onboardingForm.Name}' thành công.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create tenant onboarding");
            _onboardingValidationErrors = [ $"Lỗi: {ex.Message}" ];
        }
        finally { _isOnboardingSaving = false; }
    }

