    {
        _isSaving = true;
        try
        {
            var businessType = _createForm.BusinessTypeStr == "HouseholdBusiness"
                ? BusinessType.HouseholdBusiness
                : BusinessType.Company;

            HKDGroup? hkdGroup = businessType == BusinessType.HouseholdBusiness
                ? Enum.TryParse<HKDGroup>(_createForm.HKDGroupStr, out var g) ? g : HKDGroup.Group1
                : null;

            // #110 fix: Create tenant via Gateway API (PostgreSQL) — NOT local SQLite.
            // TenantService.CreateTenantAsync writes to IVanAnDbContext → ShopERPDbContext (SQLite),
            // but the tenant list is loaded from Gateway PG → create→list mismatch.
            var request = new CreateTenantApiRequest
            {
                Name = _createForm.Name,
                BusinessType = businessType,
                HkdGroup = hkdGroup,
                ContactEmail = _createForm.ContactEmail,
                ContactPhone = _createForm.ContactPhone,
                Address = _createForm.Address,
                TaxCode = _createForm.TaxCode
            };

            await TenantApi.CreateAsync(request);
            _showCreateModal = false;
            ShowAlert("success", $"Tenant '{_createForm.Name}' đã được tạo thành công.");
            await LoadTenants();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create tenant");
            ShowAlert("error", $"Lỗi: {ex.Message}");
        }
        finally { _isSaving = false; }
