@page "/admin/featured-products"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Authorization
@using VanAn.ShopERP.Services
@using VanAn.ShopERP.Infrastructure
@using VanAn.Shared.Domain
@inject FeaturedProductApiClient FeaturedProductApi
@inject ITenantManagementService TenantService
@inject IThemeProvider ThemeProvider
@inject ILogger<FeaturedProducts> Logger
@inject ShopERPDbContext ShopERPDb

@attribute [Authorize(Roles = "Owner,SystemAdmin")]

<div class="featured-products-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Sản phẩm nổi bật</h1>
        <div class="header-actions">
            <VanAButton Variant="primary" Size="small" OnClick="OpenCreateModalAsync">
                + Thêm sản phẩm nổi bật
            </VanAButton>
            <VanAButton Variant="secondary" Size="small" OnClick="LoadData">
                Làm mới
            </VanAButton>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Type="@_alertType" Message="@_alertMessage" OnClose="() => _alertMessage = string.Empty" />
    }

    @if (_isLoading)
    {
        <VanACard>
            <div class="loading-state">
                <VanASpinner Size="large" />
                <p>Đang tải danh sách...</p>
            </div>
        </VanACard>
    }
    else if (_items.Count == 0)
    {
        <VanACard>
            <div class="empty-state">
                <p>Chưa có sản phẩm nổi bật nào. Nhấn "+ Thêm sản phẩm nổi bật" để bắt đầu.</p>
            </div>
        </VanACard>
    }
    else
    {
        <VanACard Header="@($"Danh sách sản phẩm nổi bật ({_items.Count})")">
          <div class="table-responsive">
            <table class="vanan-table">
                <thead>
                    <tr>
                        <th>Tên hiển thị</th>
                        <th>Tenant</th>
                        <th>Giá hiển thị</th>
                        <th>Thứ tự</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td><strong>@item.DisplayName</strong></td>
                            <td>@TenantLabel(item.TenantId)</td>
                            <td>@item.DisplayPrice.ToString("N0") đ</td>
                            <td>@item.SortOrder</td>
                            <td>
                                <span class="status-badge status-@(item.IsActive ? "active" : "inactive")">
                                    @(item.IsActive ? "Hiển thị" : "Ẩn")
                                </span>
                            </td>
                            <td class="action-cell">
                                <VanAButton Variant="info" Size="small" OnClick="() => OpenEditModal(item)">
                                    Sửa
                                </VanAButton>
                                <VanAButton Variant="outline" Size="small" OnClick="() => ToggleActive(item)">
                                    @(item.IsActive ? "Ẩn" : "Hiện")
                                </VanAButton>
                                <VanAButton Variant="danger" Size="small" OnClick="() => DeleteItem(item)">
                                    Xoá
                                </VanAButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
          </div>
        </VanACard>
    }
</div>

<!-- Create/Edit Modal -->
@if (_showModal)
{
    <VanAModal Title="@(_isEdit ? "Sửa sản phẩm nổi bật" : "Thêm sản phẩm nổi bật")"
               IsVisible="true" OnClose="CloseModal" Size="medium">
        <Body>
            <VanAForm OnValidSubmit="HandleSubmit">
                @if (!_isEdit)
                {
                    <div class="form-group">
                        <label for="fp-tenant">Tenant *</label>
                        <select id="fp-tenant" class="vanan-select" value="@_form.TenantId"
                                @onchange="OnTenantSelectedAsync"
                                aria-label="Tenant" required>
                            @foreach (var t in _tenants)
                            {
                                <option value="@t.Id.Value" selected="@(t.Id.Value == _form.TenantId)">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="fp-product">Sản phẩm *</label>
                        @if (_products.Count == 0)
                        {
                            <small class="text-muted">Chọn Tenant trước để load danh sách sản phẩm.</small>
                        }
                        else
                        {
                            <select id="fp-product" class="vanan-select" value="@_form.ProductId"
                                    @onchange="OnProductSelectedAsync"
                                    aria-label="Sản phẩm" required>
                                <option value="">-- Chọn sản phẩm --</option>
                                @foreach (var p in _products)
                                {
                                    <option value="@p.Id" selected="@(p.Id == _form.ProductId)">@p.Name (@p.Price.ToString("N0") đ)</option>
                                }
                            </select>
                            <small class="text-muted">Chỉ hiển thị sản phẩm active của Tenant đã chọn. ProductId + giá + VAT được snapshot từ Product.</small>
                        }
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <VanAInput Id="fp-productid-readonly" Label="ProductId"
                                   Value="@_form.ProductId.ToString()"
                                   Disabled="true" />
                        <small class="text-muted">ProductId cố định sau khi tạo. Không thể thay đổi.</small>
                    </div>
                    <div class="form-group">
                        <VanAButton Variant="outline" Size="small" OnClick="RefreshFromProductAsync">
                            ↻ Refresh từ Product
                        </VanAButton>
                        <small class="text-muted">Cập nhật lại giá + VAT từ Product hiện tại (khi owner đổi giá). DisplayName/mô tả/ảnh giữ nguyên.</small>
                    </div>
                }
                <div class="form-group">
                    <VanAInput Id="fp-displayname" Label="Tên hiển thị *"
                               Value="@_form.DisplayName"
                               ValueChanged="v => _form = _form with { DisplayName = v }"
                               Placeholder="Tên sản phẩm..." Required="true" />
                    <small class="text-muted">Tên marketing — có thể khác Product.Name.</small>
                </div>
                <div class="form-group">
                    <VanAInput Id="fp-displayprice" Label="Giá hiển thị (VND) *"
                               Type="number" Value="@_form.DisplayPrice.ToString()"
                               Disabled="true" />
                    @if (_form.DisplayPrice > 0)
                    {
                        <small class="text-muted">@_form.DisplayPrice.ToString("N0") đ — snapshot từ Product. Bấm "Refresh từ Product" để cập nhật.</small>
                    }
                </div>
                <div class="form-group">
                    <VanAInput Id="fp-vatrate" Label="VAT (%) *"
                               Type="number" Value="@_form.VatRate.ToString()"
                               Disabled="true" />
                    <small class="text-muted">@( (_form.VatRate * 100).ToString("N0") )% — snapshot từ Product. Bấm "Refresh từ Product" để cập nhật.</small>
                </div>
                <div class="form-group">
                    <VanAInput Id="fp-description" Label="Mô tả"
                               Value="@(_form.DisplayDescription ?? "")"
                               ValueChanged="v => _form = _form with { DisplayDescription = string.IsNullOrEmpty(v) ? null : v }"
                               Placeholder="Mô tả sản phẩm..." />
                </div>
                <div class="form-group">
                    <VanAInput Id="fp-imageurl" Label="URL hình ảnh"
                               Value="@(_form.ImageUrl ?? "")"
                               ValueChanged="v => _form = _form with { ImageUrl = string.IsNullOrEmpty(v) ? null : v }"
                               Placeholder="https://..." />
                    @if (!string.IsNullOrWhiteSpace(_form.ImageUrl))
                    {
                        <div class="image-preview" style="margin-top:0.5rem;">
                            <img src="@_form.ImageUrl" alt="Preview" style="max-width:200px;max-height:150px;border-radius:0.375rem;border:1px solid var(--vanan-border);" @onerror="OnImageError" />
                        </div>
                    }
                </div>
                <div class="form-group">
                    <VanAInput Id="fp-sortorder" Label="Thứ tự sắp xếp"
                               Type="number" Value="@_form.SortOrder.ToString()"
                               ValueChanged="v => _form = _form with { SortOrder = int.TryParse(v, out var s) ? s : 0 }"
                               Step="1" Min="0" />
                </div>
                @if (_isEdit)
                {
                    <div class="form-group">
                        <label for="fp-status">Trạng thái</label>
                        <select id="fp-status" class="vanan-select" @bind="_editIsActive" aria-label="Trạng thái">
                            <option value="true">Hiển thị</option>
                            <option value="false">Ẩn</option>
                        </select>
                    </div>
                }
                <div class="form-actions">
                    <VanAButton Variant="primary" OnClick="HandleSubmit">Lưu</VanAButton>
                    <VanAButton Variant="outline" OnClick="CloseModal">Huỷ</VanAButton>
                </div>
            </VanAForm>
        </Body>
    </VanAModal>
}

@code {
    private List<FeaturedProductDto> _items = new();
    private List<VanAn.Shared.Domain.Aggregates.TenantAggregate.Tenant> _tenants = new();
    // Section A fix (2026-07-23): Product picker — load from ShopERP SQLite, filter by selected tenant.
    private List<Product> _products = new();
    private bool _isLoading = true;
    private bool _showModal;
    private bool _isEdit;
    private string _alertMessage = string.Empty;
    private string _alertType = "info";
    private Guid? _editId;
    private bool _editIsActive = true;

    private CreateFeaturedProductRequest _form = new()
    {
        ProductId = Guid.Empty,
        TenantId = Guid.Empty,
        DisplayName = "",
        DisplayPrice = 0,
        DisplayDescription = null,
        ImageUrl = null,
        SortOrder = 0
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _items = await FeaturedProductApi.ListAsync();
            _tenants = (await TenantService.ListTenantsAsync()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load featured products");
            _alertMessage = $"Lỗi tải dữ liệu: {ex.Message}";
            _alertType = "danger";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string TenantLabel(Guid tenantId)
    {
        var t = _tenants.FirstOrDefault(x => x.Id.Value == tenantId);
        return t?.Name ?? tenantId.ToString()[..8];
    }

    /// <summary>
    /// Section A fix: Load active products for the selected tenant from ShopERP SQLite.
    /// Filter by TenantId so sysadmin can only feature products that actually belong to the tenant.
    /// </summary>
    private async Task LoadProductsForTenantAsync(Guid tenantId)
    {
        if (tenantId == Guid.Empty)
        {
            _products = new();
            return;
        }
        try
        {
            var tenantIdObj = new TenantId(tenantId);
            _products = await ShopERPDb.Products
                .AsNoTracking()
                .Where(p => p.TenantId == tenantIdObj && p.IsActive)
                .OrderBy(p => p.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load products for tenant {TenantId}", tenantId);
            _products = new();
            _alertMessage = $"Lỗi tải sản phẩm: {ex.Message}";
            _alertType = "danger";
        }
    }

    /// <summary>Section A fix: Tenant dropdown change → reload product list for new tenant.</summary>
    private async Task OnTenantSelectedAsync(ChangeEventArgs e)
    {
        Guid tenantId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : Guid.Empty;
        _form = _form with { TenantId = tenantId, ProductId = Guid.Empty, DisplayName = "", DisplayPrice = 0, VatRate = 0.10m };
        await LoadProductsForTenantAsync(tenantId);
    }

    /// <summary>Section A fix: Product dropdown change → auto-fill snapshot (DisplayName, DisplayPrice, VatRate).</summary>
    private async Task OnProductSelectedAsync(ChangeEventArgs e)
    {
        Guid productId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : Guid.Empty;
        var product = _products.FirstOrDefault(p => p.Id == productId);
        if (product != null)
        {
            // Snapshot from Product — DisplayName defaults to Product.Name (user can override after).
            // Price + VatRate are locked (read-only) — only refreshable via "Refresh from Product" button.
            _form = _form with
            {
                ProductId = product.Id,
                DisplayName = product.Name,
                DisplayPrice = product.Price,
                VatRate = product.VatRate
            };
        }
        else
        {
            _form = _form with { ProductId = Guid.Empty, DisplayName = "", DisplayPrice = 0, VatRate = 0.10m };
        }
        await Task.CompletedTask;
    }

    /// <summary>
    /// Section A fix: "Refresh from Product" button (edit mode only).
    /// Re-snapshot DisplayPrice + VatRate from current Product entity in SQLite.
    /// DisplayName/Description/ImageUrl are preserved (marketing content owned by sysadmin).
    /// </summary>
    private async Task RefreshFromProductAsync()
    {
        if (_form.ProductId == Guid.Empty) return;
        try
        {
            var product = await ShopERPDb.Products
                .AsNoTracking()
                .Where(p => p.Id == _form.ProductId)
                .FirstOrDefaultAsync();
            if (product == null)
            {
                _alertMessage = $"Không tìm thấy Product {_form.ProductId} trong SQLite. Có thể product đã bị xoá.";
                _alertType = "danger";
                return;
            }
            _form = _form with
            {
                DisplayPrice = product.Price,
                VatRate = product.VatRate
            };
            _alertMessage = $"Đã refresh giá + VAT từ Product '{product.Name}'.";
            _alertType = "info";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh from product {ProductId}", _form.ProductId);
            _alertMessage = $"Lỗi refresh: {ex.Message}";
            _alertType = "danger";
        }
    }

    private async Task OpenCreateModalAsync()
    {
        _isEdit = false;
        _editId = null;
        Guid defaultTenantId = _tenants.FirstOrDefault()?.Id.Value ?? Guid.Empty;
        _form = new CreateFeaturedProductRequest
        {
            ProductId = Guid.Empty,
            TenantId = defaultTenantId,
            DisplayName = "",
            DisplayPrice = 0,
            VatRate = 0.10m,
            SortOrder = 0
        };
        await LoadProductsForTenantAsync(defaultTenantId);
        _showModal = true;
    }

    private void OpenEditModal(FeaturedProductDto item)
    {
        _isEdit = true;
        _editId = item.Id;
        _editIsActive = item.IsActive;
        _form = new CreateFeaturedProductRequest
        {
            ProductId = item.ProductId,
            TenantId = item.TenantId,
            DisplayName = item.DisplayName,
            DisplayPrice = item.DisplayPrice,
            VatRate = item.VatRate,
            DisplayDescription = item.DisplayDescription,
            ImageUrl = item.ImageUrl,
            SortOrder = item.SortOrder
        };
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private void OnImageError(EventArgs e)
    {
        Logger.LogWarning("Image preview failed to load: {Url}", _form.ImageUrl);
    }

    private async Task HandleSubmit()
    {
        // Client-side validation before API call
        if (string.IsNullOrWhiteSpace(_form.DisplayName))
        {
            _alertMessage = "Lỗi: Tên hiển thị không được để trống.";
            _alertType = "danger";
            return;
        }
        if (_form.DisplayPrice < 0)
        {
            _alertMessage = "Lỗi: Giá hiển thị không được âm.";
            _alertType = "danger";
            return;
        }
        if (!_isEdit && _form.TenantId == Guid.Empty)
        {
            _alertMessage = "Lỗi: Vui lòng chọn Tenant.";
            _alertType = "danger";
            return;
        }

        try
        {
            if (_isEdit && _editId.HasValue)
            {
                await FeaturedProductApi.UpdateAsync(_editId.Value, new UpdateFeaturedProductRequest
                {
                    DisplayName = _form.DisplayName,
                    DisplayPrice = _form.DisplayPrice,
                    VatRate = _form.VatRate,
                    DisplayDescription = _form.DisplayDescription,
                    ImageUrl = _form.ImageUrl,
                    SortOrder = _form.SortOrder,
                    IsActive = _editIsActive
                });
                _alertMessage = "Đã cập nhật sản phẩm nổi bật.";
            }
            else
            {
                await FeaturedProductApi.CreateAsync(_form);
                _alertMessage = "Đã thêm sản phẩm nổi bật.";
            }
            _alertType = "success";
            _showModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save featured product");
            _alertMessage = $"Lỗi: {ex.Message}";
            _alertType = "danger";
        }
    }

    private async Task ToggleActive(FeaturedProductDto item)
    {
        try
        {
            await FeaturedProductApi.UpdateAsync(item.Id, new UpdateFeaturedProductRequest
            {
                DisplayName = item.DisplayName,
                DisplayPrice = item.DisplayPrice,
                VatRate = item.VatRate,
                DisplayDescription = item.DisplayDescription,
                ImageUrl = item.ImageUrl,
                SortOrder = item.SortOrder,
                IsActive = !item.IsActive
            });
            await LoadData();
        }
        catch (Exception ex)
        {
            _alertMessage = $"Lỗi: {ex.Message}";
            _alertType = "danger";
        }
    }

    private async Task DeleteItem(FeaturedProductDto item)
    {
        try
        {
            await FeaturedProductApi.DeleteAsync(item.Id);
            _alertMessage = "Đã xoá sản phẩm nổi bật.";
            _alertType = "success";
            await LoadData();
        }
        catch (Exception ex)
        {
            _alertMessage = $"Lỗi: {ex.Message}";
            _alertType = "danger";
        }
    }
}
