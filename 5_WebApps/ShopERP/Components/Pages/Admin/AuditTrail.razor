@page "/admin/audit-trail"
@rendermode InteractiveServer
@layout AdminLayout
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using VanAn.Shared.Domain.Audit
@using VanAn.CoreHub.Services
@inject IAuditTrailService AuditTrailService
@inject IThemeProvider ThemeProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<AuditTrail> Logger
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "SystemAdmin")]

<div class="audit-trail-page @ThemeProvider.CurrentTheme">
    <!-- Header -->
    <header class="audit-header">
        <h1>📝 Nhật Ký Audit</h1>
        <div class="header-actions">
            <VanAButton
                Variant="secondary"
                Size="small"
                OnClick="RefreshData">
                🔄 Refresh
            </VanAButton>
            <VanAButton
                Variant="primary"
                Size="small"
                OnClick="ExportLogs">
                📤 Export
            </VanAButton>
        </div>
    </header>

    <!-- Sprint 3 P3.4: Summary cards — incident monitoring dashboard -->
    <section class="summary-cards-section">
        <div class="summary-grid">
            <VanACard>
                <div class="summary-card summary-total">
                    <div class="summary-icon">📊</div>
                    <div class="summary-value">@_totalLast24h</div>
                    <div class="summary-label">Sự kiện (24h)</div>
                </div>
            </VanACard>
            <VanACard>
                <div class="summary-card summary-critical">
                    <div class="summary-icon">🔴</div>
                    <div class="summary-value">@_criticalCount</div>
                    <div class="summary-label">Nghiêm trọng</div>
                </div>
            </VanACard>
            <VanACard>
                <div class="summary-card summary-high">
                    <div class="summary-icon">🟠</div>
                    <div class="summary-value">@_highCount</div>
                    <div class="summary-label">Cao</div>
                </div>
            </VanACard>
            <VanACard>
                <div class="summary-card summary-failed-login">
                    <div class="summary-icon">🚫</div>
                    <div class="summary-value">@_failedLoginCount</div>
                    <div class="summary-label">Đăng nhập thất bại</div>
                </div>
            </VanACard>
            <VanACard>
                <div class="summary-card summary-rate-limit">
                    <div class="summary-icon">⚡</div>
                    <div class="summary-value">@_rateLimitCount</div>
                    <div class="summary-label">Rate limit</div>
                </div>
            </VanACard>
        </div>
    </section>

    <!-- Filter Panel -->
    <section class="filter-section">
        <VanACard Header="Bộ Lọc">
            <div class="filter-grid">
                <div class="filter-group">
                    <label>Từ ngày</label>
                    <input type="date" class="vanan-input" @bind="Filter.FromDate" />
                </div>
                <div class="filter-group">
                    <label>Đến ngày</label>
                    <input type="date" class="vanan-input" @bind="Filter.ToDate" />
                </div>
                <div class="filter-group">
                    <label>Loại hành động</label>
                    <select class="vanan-select" @bind="Filter.Action">
                        <option value="">Tất cả</option>
                        <option value="@AuditActionType.Create">Tạo mới</option>
                        <option value="@AuditActionType.Update">Cập nhật</option>
                        <option value="@AuditActionType.Delete">Xóa</option>
                        <option value="@AuditActionType.PeriodClose">Đóng kỳ</option>
                        <option value="@AuditActionType.PeriodReopen">Mở kỳ</option>
                        <option value="@AuditActionType.Correction">Điều chỉnh</option>
                        <option value="@AuditActionType.Reversal">Đảo ngược</option>
                        <option value="@AuditActionType.SecurityAlert">Cảnh báo bảo mật</option>
                        <option value="@AuditActionType.FailedLogin">Đăng nhập thất bại</option>
                        <option value="@AuditActionType.SuspiciousActivity">Hoạt động đáng ngờ</option>
                        <option value="@AuditActionType.RateLimitHit">Rate limit</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Loại entity</label>
                    <select class="vanan-select" @bind="Filter.EntityType">
                        <option value="">Tất cả</option>
                        <option value="@AuditableEntityType.AccountingEntry">Bút toán</option>
                        <option value="@AuditableEntityType.PeriodClosing">Kỳ kế toán</option>
                        <option value="@AuditableEntityType.Customer">Khách hàng</option>
                        <option value="@AuditableEntityType.Order">Đơn hàng</option>
                        <option value="@AuditableEntityType.Product">Sản phẩm</option>
                        <option value="@AuditableEntityType.Shop">Cửa hàng</option>
                        <option value="@AuditableEntityType.KhachLinkInstance">KhachLink Instance</option>
                        <option value="@AuditableEntityType.SecurityEvent">Sự cố bảo mật</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Mức độ</label>
                    <select class="vanan-select" @bind="Filter.Severity">
                        <option value="">Tất cả</option>
                        <option value="Critical">🔴 Nghiêm trọng</option>
                        <option value="High">🟠 Cao</option>
                        <option value="Medium">🟡 Trung bình</option>
                        <option value="Low">🔵 Thấp</option>
                        <option value="Info">ℹ️ Thông tin</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>User ID</label>
                    <input type="text" class="vanan-input" @bind="Filter.UserId" placeholder="User ID..." />
                </div>
                <div class="filter-group">
                    <label>Tìm kiếm</label>
                    <input type="text" class="vanan-input" @bind="Filter.SearchTerm" placeholder="Search..." />
                </div>
            </div>
            <div class="filter-actions">
                <VanAButton
                    Variant="primary"
                    OnClick="ApplyFilter">
                    🔍 Áp dụng
                </VanAButton>
                <VanAButton
                    Variant="outline"
                    OnClick="ClearFilter">
                    ❌ Xóa bộ lọc
                </VanAButton>
            </div>
        </VanACard>
    </section>

    <!-- Results -->
    <section class="results-section">
        @if (IsLoading)
        {
            <VanACard>
                <div class="loading-state">
                    <VanASpinner Size="large" />
                    <p>Đang tải dữ liệu...</p>
                </div>
            </VanACard>
        }
        else if (AuditLogs == null || !AuditLogs.Any())
        {
            <VanACard>
                <div class="empty-state">
                    <div class="empty-icon">📭</div>
                    <p>Không tìm thấy bản ghi audit nào</p>
                </div>
            </VanACard>
        }
        else
        {
            <VanACard Header="Kết quả">
                <div class="audit-table-container table-responsive">
                    <table class="vanan-table audit-table">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Hành động</th>
                                <th>Mức độ</th>
                                <th>Entity</th>
                                <th>User</th>
                                <th>Lý do</th>
                                <th>Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in AuditLogs)
                            {
                                <tr class="audit-row @GetActionClass(log.Action)">
                                    <td class="timestamp">@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="action">
                                        <span class="action-badge @GetActionClass(log.Action)">
                                            @GetActionDisplay(log.Action)
                                        </span>
                                    </td>
                                    <td class="severity">
                                        <span class="severity-badge @GetSeverityClass(GetSeverity(log))">
                                            @GetSeverityDisplay(GetSeverity(log))
                                        </span>
                                    </td>
                                    <td class="entity">
                                        <div class="entity-type">@log.EntityType</div>
                                        <div class="entity-id text-muted">@log.EntityId.ToString()[..Math.Min(8, log.EntityId.ToString().Length)]...</div>
                                    </td>
                                    <td class="user">
                                        <div class="user-name">@(log.UserName ?? log.UserId ?? "System")</div>
                                    </td>
                                    <td class="reason">
                                        @if (!string.IsNullOrEmpty(log.Reason))
                                        {
                                            <span class="reason-text" title="@log.Reason">@Truncate(log.Reason, 30)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="actions">
                                        <VanAButton
                                            Variant="ghost"
                                            Size="small"
                                            OnClick="() => ShowDetails(log)">
                                            👁️ Chi tiết
                                        </VanAButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (TotalPages > 1)
                {
                    <div class="pagination">
                        <VanAButton
                            Variant="outline"
                            Size="small"
                            Disabled="CurrentPage <= 1"
                            OnClick="() => GoToPage(CurrentPage - 1)">
                            ◀ Trước
                        </VanAButton>
                        <span class="page-info">Trang @CurrentPage / @TotalPages</span>
                        <VanAButton
                            Variant="outline"
                            Size="small"
                            Disabled="CurrentPage >= TotalPages"
                            OnClick="() => GoToPage(CurrentPage + 1)">
                            Tiếp ▶
                        </VanAButton>
                    </div>
                }
            </VanACard>
        }
    </section>
</div>

<!-- Detail Modal -->
@if (SelectedLog != null)
{
    <VanAModal Title="Chi tiết Audit Log" IsVisible="true" OnClose="CloseDetails">
        <div class="audit-detail">
            <div class="detail-row">
                <label>ID:</label>
                <span>@SelectedLog.Id</span>
            </div>
            <div class="detail-row">
                <label>Thời gian:</label>
                <span>@SelectedLog.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>
            <div class="detail-row">
                <label>Hành động:</label>
                <span class="action-badge @GetActionClass(SelectedLog.Action)">@GetActionDisplay(SelectedLog.Action)</span>
            </div>
            <div class="detail-row">
                <label>Entity Type:</label>
                <span>@SelectedLog.EntityType</span>
            </div>
            <div class="detail-row">
                <label>Entity ID:</label>
                <span>@SelectedLog.EntityId</span>
            </div>
            <div class="detail-row">
                <label>User:</label>
                <span>@(SelectedLog.UserName ?? SelectedLog.UserId ?? "System")</span>
            </div>
            @if (!string.IsNullOrEmpty(SelectedLog.Reason))
            {
                <div class="detail-row">
                    <label>Lý do:</label>
                    <span>@SelectedLog.Reason</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(SelectedLog.CorrelationId))
            {
                <div class="detail-row">
                    <label>Correlation ID:</label>
                    <span>@SelectedLog.CorrelationId</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(SelectedLog.OldValues))
            {
                <div class="detail-section">
                    <label>Giá trị cũ:</label>
                    <pre class="json-preview">@SelectedLog.OldValues</pre>
                </div>
            }
            @if (!string.IsNullOrEmpty(SelectedLog.NewValues))
            {
                <div class="detail-section">
                    <label>Giá trị mới:</label>
                    <pre class="json-preview">@SelectedLog.NewValues</pre>
                </div>
            }
        </div>
    </VanAModal>
}

@code {
    private List<AuditLog> AuditLogs { get; set; } = new();
    private bool IsLoading { get; set; } = false;
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 50;
    private int TotalCount { get; set; } = 0;
    private int TotalPages => (TotalCount + PageSize - 1) / PageSize;
    private string PaginationInfo => $"Hiển thị {AuditLogs.Count} / {TotalCount} bản ghi";

    private FilterModel Filter { get; set; } = new();
    private AuditLog? SelectedLog { get; set; }

    // Sprint 3 P3.4: Summary cards data
    private List<AuditLog> _recentLogs = new();
    private int _criticalCount;
    private int _highCount;
    private int _failedLoginCount;
    private int _rateLimitCount;
    private int _totalLast24h;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadSummaryCards();
    }

    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            var query = new AuditLogQuery
            {
                FromDate = Filter.FromDate,
                ToDate = Filter.ToDate?.AddDays(1).AddTicks(-1),
                Action = Filter.Action,
                EntityType = Filter.EntityType,
                UserId = Filter.UserId,
                SearchTerm = Filter.SearchTerm,
                PageNumber = CurrentPage,
                PageSize = PageSize
            };

            var result = await AuditTrailService.QueryAsync(query);
            AuditLogs = result.Items.ToList();
            TotalCount = result.TotalCount;

            // Sprint 3 P3.4: Client-side severity filter (computed from Action+EntityType)
            if (!string.IsNullOrEmpty(Filter.Severity))
            {
                var severityFilter = Enum.Parse<IncidentSeverity>(Filter.Severity);
                AuditLogs = AuditLogs.Where(l => GetSeverity(l) == severityFilter).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading audit logs");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        await LoadSummaryCards();
    }

    // Sprint 3 P3.4: Load summary cards data (recent 200 logs for incident monitoring)
    private async Task LoadSummaryCards()
    {
        try
        {
            _recentLogs = (await AuditTrailService.GetRecentAsync(200)).ToList();

            _criticalCount = _recentLogs.Count(l => GetSeverity(l) == IncidentSeverity.Critical);
            _highCount = _recentLogs.Count(l => GetSeverity(l) == IncidentSeverity.High);
            _failedLoginCount = _recentLogs.Count(l => l.Action == AuditActionType.FailedLogin);
            _rateLimitCount = _recentLogs.Count(l => l.Action == AuditActionType.RateLimitHit);

            var cutoff = DateTime.UtcNow.AddHours(-24);
            _totalLast24h = _recentLogs.Count(l => l.Timestamp >= cutoff);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading audit summary cards");
        }
    }

    private async Task ApplyFilter()
    {
        CurrentPage = 1;
        await LoadData();
    }

    private async Task ClearFilter()
    {
        Filter = new FilterModel();
        CurrentPage = 1;
        await LoadData();
    }

    private async Task GoToPage(int page)
    {
        CurrentPage = page;
        await LoadData();
    }

    private void ShowDetails(AuditLog log)
    {
        SelectedLog = log;
        StateHasChanged();
    }

    private void CloseDetails()
    {
        SelectedLog = null;
        StateHasChanged();
    }

    private void ExportLogs()
    {
        // TODO: Implement CSV/Excel export
        Logger.LogInformation("Export audit logs requested");
    }

    private string GetActionDisplay(AuditActionType action) => action switch
    {
        AuditActionType.Create => "Tạo mới",
        AuditActionType.Update => "Cập nhật",
        AuditActionType.Delete => "Xóa",
        AuditActionType.PeriodClose => "Đóng kỳ",
        AuditActionType.PeriodReopen => "Mở kỳ",
        AuditActionType.Correction => "Điều chỉnh",
        AuditActionType.Reversal => "Đảo ngược",
        AuditActionType.Export => "Xuất",
        AuditActionType.Login => "Đăng nhập",
        AuditActionType.Logout => "Đăng xuất",
        AuditActionType.PermissionChange => "Thay đổi quyền",
        AuditActionType.SecurityAlert => "Cảnh báo bảo mật",
        AuditActionType.FailedLogin => "Đăng nhập thất bại",
        AuditActionType.SuspiciousActivity => "Hoạt động đáng ngờ",
        AuditActionType.RateLimitHit => "Rate limit",
        _ => action.ToString()
    };

    private string GetActionClass(AuditActionType action) => action switch
    {
        AuditActionType.Create => "action-create",
        AuditActionType.Update => "action-update",
        AuditActionType.Delete => "action-delete",
        AuditActionType.PeriodClose => "action-period-close",
        AuditActionType.PeriodReopen => "action-period-reopen",
        AuditActionType.Correction => "action-correction",
        AuditActionType.Reversal => "action-reversal",
        _ => "action-default"
    };

    // Sprint 3 P3.4: Incident severity classification — presentation-only, computed from Action + EntityType.
    public enum IncidentSeverity
    {
        Critical,  // Nghiêm trọng — hack, tấn công mạng, gian lận
        High,      // Cao — potential security issue
        Medium,    // Trung — significant business change
        Low,       // Thấp — routine operation
        Info       // Thông tin — login/logout, export
    }

    private static IncidentSeverity GetSeverity(AuditLog log) => (log.Action, log.EntityType) switch
    {
        // Critical: security incidents + financial fraud
        (AuditActionType.SuspiciousActivity, _) => IncidentSeverity.Critical,
        (AuditActionType.Delete, AuditableEntityType.AccountingEntry) => IncidentSeverity.Critical,
        (AuditActionType.Delete, AuditableEntityType.Tenant) => IncidentSeverity.Critical,
        (AuditActionType.RateLimitHit, _) => IncidentSeverity.Critical,
        // High: potential security issues
        (AuditActionType.FailedLogin, _) => IncidentSeverity.High,
        (AuditActionType.SecurityAlert, _) => IncidentSeverity.High,
        (AuditActionType.PermissionChange, _) => IncidentSeverity.High,
        (AuditActionType.Delete, AuditableEntityType.User) => IncidentSeverity.High,
        (AuditActionType.Delete, AuditableEntityType.KhachLinkInstance) => IncidentSeverity.High,
        // Medium: significant business changes
        (AuditActionType.Correction, _) => IncidentSeverity.Medium,
        (AuditActionType.Reversal, _) => IncidentSeverity.Medium,
        (AuditActionType.PeriodClose, _) => IncidentSeverity.Medium,
        (AuditActionType.PeriodReopen, _) => IncidentSeverity.Medium,
        (AuditActionType.Update, AuditableEntityType.AccountingEntry) => IncidentSeverity.Medium,
        (AuditActionType.Update, AuditableEntityType.KhachLinkInstance) => IncidentSeverity.Medium,
        (AuditActionType.Update, AuditableEntityType.Tenant) => IncidentSeverity.Medium,
        (AuditActionType.Create, AuditableEntityType.Tenant) => IncidentSeverity.Medium,
        // Info: routine
        (AuditActionType.Login, _) => IncidentSeverity.Info,
        (AuditActionType.Logout, _) => IncidentSeverity.Info,
        (AuditActionType.Export, _) => IncidentSeverity.Info,
        // Low: default
        _ => IncidentSeverity.Low
    };

    private static string GetSeverityDisplay(IncidentSeverity s) => s switch
    {
        IncidentSeverity.Critical => "🔴 Nghiêm trọng",
        IncidentSeverity.High => "🟠 Cao",
        IncidentSeverity.Medium => "🟡 Trung bình",
        IncidentSeverity.Low => "🔵 Thấp",
        IncidentSeverity.Info => "ℹ️ Thông tin",
        _ => s.ToString()
    };

    private static string GetSeverityClass(IncidentSeverity s) => s switch
    {
        IncidentSeverity.Critical => "severity-critical",
        IncidentSeverity.High => "severity-high",
        IncidentSeverity.Medium => "severity-medium",
        IncidentSeverity.Low => "severity-low",
        IncidentSeverity.Info => "severity-info",
        _ => "severity-low"
    };

    private string Truncate(string value, int maxLength)
    {
        if (string.IsNullOrEmpty(value)) return value;
        return value.Length <= maxLength ? value : value[..maxLength] + "...";
    }

    public class FilterModel
    {
        public DateTime? FromDate { get; set; }
        public DateTime? ToDate { get; set; }
        public AuditActionType? Action { get; set; }
        public AuditableEntityType? EntityType { get; set; }
        public string? Severity { get; set; }  // Sprint 3 P3.4 — client-side filter
        public string? UserId { get; set; }
        public string? SearchTerm { get; set; }
    }
}

