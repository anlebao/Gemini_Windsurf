@page "/admin/push-campaigns"
@rendermode InteractiveServer
@layout AdminLayout
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Authorization
@using VanAn.CoreHub.Services
@using VanAn.CoreHub.Domain.Repositories
@using VanAn.Shared.Domain
@inject PushNotificationService PushService
@inject ICustomerSegmentationService SegmentationService
@inject ILogger<PushCampaignsAdmin> Logger

@attribute [Authorize(Policy = "SystemAdmin")]

<div class="push-campaigns-admin-page">
    <header class="page-header">
        <h1>Push Campaigns</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="LoadJobs">
                Làm mới
            </VanAButton>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Type="@_alertType" Message="@_alertMessage" OnClose="() => _alertMessage = string.Empty" />
    }

    @* ─── Send New Push Campaign ─── *@
    <VanACard Title="Gửi Push Mới">
        <div class="form-group">
            <VanAInput Id="push-title" Label="Tiêu đề *"
                       Value="@_pushForm.Title"
                       ValueChanged="v => _pushForm.Title = v"
                       Placeholder="Khuyến mãi mùa hè 2026" />
        </div>
        <div class="form-group">
            <VanAInput Id="push-body" Label="Nội dung *"
                       Value="@_pushForm.Body"
                       ValueChanged="v => _pushForm.Body = v"
                       Placeholder="Giảm 20% cho tất cả đồ uống..." />
        </div>
        <div class="form-group">
            <VanAInput Id="push-action-url" Label="URL khi bấm"
                       Value="@_pushForm.ActionUrl"
                       ValueChanged="v => _pushForm.ActionUrl = v"
                       Placeholder="/my-loyalty" />
        </div>

        <h6 class="mt-3 mb-2">Tiêu chí chọn khách hàng</h6>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Hạng khách (Tier)</label>
                    <select class="vanan-input" value="@_pushForm.CustomerTier"
                            @onchange="e => _pushForm.CustomerTier = e.Value?.ToString()">
                        <option value="">Tất cả</option>
                        <option value="Bronze">Bronze</option>
                        <option value="Silver">Silver</option>
                        <option value="Gold">Gold</option>
                        <option value="Platinum">Platinum</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Identity Level tối thiểu</label>
                    <select class="vanan-input" value="@_pushForm.MinIdentityLevel"
                            @onchange="e => _pushForm.MinIdentityLevel = e.Value?.ToString()">
                        <option value="">Tất cả</option>
                        <option value="Guest">Guest</option>
                        <option value="Social">Social</option>
                        <option value="Verified">Verified</option>
                        <option value="Full">Full</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <VanAInput Id="push-min-spent" Label="Tổng chi tiêu tối thiểu"
                               Value="@_pushForm.MinTotalSpent"
                               ValueChanged="v => _pushForm.MinTotalSpent = v"
                               Placeholder="0" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <VanAInput Id="push-max-spent" Label="Tổng chi tiêu tối đa"
                               Value="@_pushForm.MaxTotalSpent"
                               ValueChanged="v => _pushForm.MaxTotalSpent = v"
                               Placeholder="999999" />
                </div>
            </div>
        </div>

        <div class="form-actions">
            <VanAButton Variant="primary" OnClick="SendPush">Gửi Push</VanAButton>
        </div>
    </VanACard>

    @* ─── Push Job History ─── *@
    <VanACard Title="Lịch sử Push Jobs" CssClass="mt-4">
        @if (_isLoadingJobs)
        {
            <p>Đang tải...</p>
        }
        else if (_jobs.Count == 0)
        {
            <p class="text-muted">Chưa có push job nào.</p>
        }
        else
        {
            <table class="vanan-table">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th>Đã gửi</th>
                        <th>Thất bại</th>
                        <th>Đã bấm</th>
                        <th>CTR</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in _jobs)
                    {
                        <tr>
                            <td>@job.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(job.Status)">@job.Status</span>
                            </td>
                            <td>@job.SentCount</td>
                            <td>@job.FailedCount</td>
                            <td>@job.ClickedCount</td>
                            <td>@(job.SentCount > 0 ? Math.Round((double)job.ClickedCount / job.SentCount * 100, 1) : 0)%</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </VanACard>
</div>

@code {
    private bool _isLoadingJobs = true;
    private List<CampaignPushJob> _jobs = new();
    private string _alertMessage = string.Empty;
    private string _alertType = "info";
    private PushForm _pushForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadJobs();
    }

    private async Task LoadJobs()
    {
        _isLoadingJobs = true;
        try
        {
            // CampaignPushJobs is PG-only — this will return empty on ShopERP SQLite.
            // For production, this page should query Gateway PG. For now, log + show empty.
            _jobs = new List<CampaignPushJob>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load push jobs");
            _alertMessage = $"Lỗi tải push jobs: {ex.Message}";
            _alertType = "danger";
        }
        finally
        {
            _isLoadingJobs = false;
        }
    }

    private async Task SendPush()
    {
        if (string.IsNullOrWhiteSpace(_pushForm.Title) || string.IsNullOrWhiteSpace(_pushForm.Body))
        {
            _alertMessage = "Tiêu đề và nội dung là bắt buộc.";
            _alertType = "warning";
            return;
        }

        try
        {
            // Build segmentation criteria
            IdentityLevel? minIdentity = null;
            if (Enum.TryParse<IdentityLevel>(_pushForm.MinIdentityLevel, out var level))
                minIdentity = level;

            decimal? minSpent = decimal.TryParse(_pushForm.MinTotalSpent, out var minS) ? minS : null;
            decimal? maxSpent = decimal.TryParse(_pushForm.MaxTotalSpent, out var maxS) ? maxS : null;

            var criteria = new CustomerSegmentCriteria(
                CustomerTier: string.IsNullOrWhiteSpace(_pushForm.CustomerTier) ? null : _pushForm.CustomerTier,
                MinIdentityLevel: minIdentity,
                MinTotalSpent: minSpent,
                MaxTotalSpent: maxSpent,
                HasPushSubscription: true);

            // Get matching customers
            var customers = await SegmentationService.GetCustomersBySegmentAsync(criteria);

            if (customers.Count == 0)
            {
                _alertMessage = "Không có khách hàng phù hợp với tiêu chí.";
                _alertType = "warning";
                return;
            }

            // Send bulk push
            var customerIds = customers.Select(c => c.Id).ToList();
            var (sentCount, failedCount) = await PushService.SendBulkNotificationAsync(
                customerIds,
                _pushForm.Title,
                _pushForm.Body,
                string.IsNullOrWhiteSpace(_pushForm.ActionUrl) ? null : _pushForm.ActionUrl);

            _alertMessage = sentCount > 0
                ? $"Đã gửi push tới {sentCount}/{customers.Count} khách hàng. Thất bại: {failedCount}."
                : $"Gửi push thất bại ({failedCount}/{customers.Count}). Nguyên nhân khả nghi: khách hàng chưa đăng ký push notification trên thiết bị, hoặc subscription đã hết hạn. Hãy kiểm tra logs server để biết chi tiết (WebPushException HTTP status).";
            _alertType = sentCount > 0 ? "success" : "warning";
            _pushForm = new PushForm();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send push");
            _alertMessage = $"Lỗi: {ex.Message}";
            _alertType = "danger";
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Completed" => "bg-success",
        "Failed" => "bg-danger",
        "Sending" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private class PushForm
    {
        public string Title { get; set; } = string.Empty;
        public string Body { get; set; } = string.Empty;
        public string ActionUrl { get; set; } = string.Empty;
        public string? CustomerTier { get; set; }
        public string? MinIdentityLevel { get; set; }
        public string MinTotalSpent { get; set; } = string.Empty;
        public string MaxTotalSpent { get; set; } = string.Empty;
    }
}
