    private void ResetWizard()
    {
        _step = 0;
        _case = null;
        _result = null;
        _importResult = null;
        _importStatus = string.Empty;
        _tenantName = _address = _contactPhone = _contactEmail = string.Empty;
        _gpdkMst = _gpdkName = _gpdkAddress = _gpdkLegalForm = _gpdkOwner = string.Empty;
        _signName = string.Empty;
        _productRows = [];
        _photoUrls = [];   // P3
        _hkdGroupA = null; // P3
        _unregistered = false; // P3
        _lat = _lng = null;
        _accuracy = 0;
        _lastMapLat = _lastMapLng = null;
        _showCameraModal = false;
        _cameraMode = string.Empty;
        _menuShotCount = 0;
        _cameraPendingOpen = false;
        _ = JSRuntime.InvokeVoidAsync("vananOnboardingWizard.closeCamera");
        _ = ClearDraftAsync();   // P3: reset → xóa draft
        _hkdGroup = null;
        _alertMessage = string.Empty;
    }

    private static bool IsValidMst(string mst)
    {
        var digits = mst.Replace("-", "").Trim();
        return (digits.Length == 10 || digits.Length == 13) && digits.All(char.IsDigit);
    }

    private void ShowAlert(string message, string variant)
    {
        _alertMessage = message;
        _alertVariant = variant;
    }

    private RenderFragment ConfidenceBadge(string label, double confidence)
        => builder =>
        {
            if (confidence <= 0) return;
            var css = confidence >= 70 ? "ocr-conf-high" : "ocr-conf-low";
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"ocr-conf {css}");
            builder.AddContent(2, $"{label}: {confidence:F0}%");
            builder.CloseElement();
        };
}