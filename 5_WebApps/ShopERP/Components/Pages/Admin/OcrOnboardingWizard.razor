@page "/admin/onboarding-ocr"
@rendermode InteractiveServer
@layout AdminLayout
@using VanAn.CoreHub.Services.Onboarding
@using VanAn.Shared.Domain
@using VanAn.Shared.DTOs
@using VanAn.UI.Platform.Components
@using Microsoft.AspNetCore.Authorization
@inject OcrOnboardingApiClient OcrOnboardingApi
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpFactory
@inject IConfiguration Configuration
@inject ILogger<OcrOnboardingWizard> Logger

@attribute [Authorize(Policy = "SystemAdmin")]

<!-- 2026-10-26 user directive: tách khỏi /admin/tenants → PAGE RIÊNG /admin/onboarding-ocr -->
<div class="ocr-wizard">
    <!-- Self-Serve Onboarding P2 (2026-11-09): kênh đăng ký toggles + QR mời đăng ký -->
    <OnboardingFlagsCard />
    <QrSignupCard />

    <!-- Stepper -->
    <div class="ocr-wizard-steps">
        <span class="@StepClass(0)">1. Loại hình</span>
        <span class="ocr-step-sep">→</span>
        <span class="@StepClass(1)">2. Giấy tờ</span>
        <span class="ocr-step-sep">→</span>
        <span class="@StepClass(2)">3. Biển hiệu + Menu</span>
        <span class="ocr-step-sep">→</span>
        <span class="@StepClass(3)">4. Vị trí + Xác nhận</span>
        <span class="ocr-step-sep">→</span>
        <span class="@StepClass(4)">5. Kết quả</span>
    </div>

    <!-- P3 (2026-11-09): ảnh provenance đã upload R2 — thumbnail + xóa được -->
    @if (_photoUrls.Count > 0)
    {
        <div class="ocr-photos">
            <span class="ocr-hint">Ảnh đã lưu (@_photoUrls.Count):</span>
            <div class="ocr-photos-strip">
                @foreach (var p in _photoUrls)
                {
                    <span class="ocr-photo-thumb">
                        <img src="@p.Url" alt="@p.Kind" loading="lazy" />
                        <em>@p.Kind</em>
                        <button type="button" class="ocr-photo-remove" title="Xóa ảnh"
                                @onclick="() => RemovePhoto(p)">✕</button>
                    </span>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Variant="@_alertVariant" Message="@_alertMessage" OnClose="CloseAlert" />
    }

    @switch (_step)
    {
        case 0:
            <div class="ocr-case-cards">
                <button type="button" class="ocr-case-card @(_case == OcrOnboardingCase.CompanyWithLicense ? "selected" : "")"
                        @onclick="() => SelectCase(OcrOnboardingCase.CompanyWithLicense)">
                    <div class="ocr-case-title">🏢 Công ty / Hộ kinh doanh</div>
                    <div class="ocr-case-desc">CÓ giấy phép kinh doanh (GPKD) — scan GPKD + biển hiệu + menu để điền thông tin tự động</div>
                </button>
                <button type="button" class="ocr-case-card @(_case == OcrOnboardingCase.SmallShopNoLicense ? "selected" : "")"
                        @onclick="() => SelectCase(OcrOnboardingCase.SmallShopNoLicense)">
                    <div class="ocr-case-title">🏪 Shop nhỏ</div>
                    <div class="ocr-case-desc">KHÔNG có GPKD — chỉ scan biển hiệu + menu, chọn nhóm thuế HKD thủ công</div>
                </button>
            </div>
            <div class="ocr-wizard-actions">
                <VanAButton Variant="primary" OnClick="NextFromCase" Disabled="_case is null">Tiếp theo</VanAButton>
            </div>
            break;

        case 1:
            @if (_case == OcrOnboardingCase.CompanyWithLicense)
            {
                <div class="ocr-section">
                    <h4>📷 Ảnh giấy phép kinh doanh (GPKD)</h4>
                    <div class="ocr-capture-row">
                        <input type="file" accept="image/*" capture="environment" class="ocr-file-input"
                               onchange="vananOnboardingWizard.processFile(this.files[0], 'extractGpdk')" />
                        <VanAButton Variant="secondary" Size="small" OnClick="OpenCameraGpdk">📷 Chụp trực tiếp</VanAButton>
                    </div>
                    <div class="ocr-hint">Chụp thẳng góc, đủ sáng, tránh bóng đổ. Dấu đỏ đè chữ có thể làm sai chữ — kiểm tra kỹ.</div>

                    @if (_isOcrBusy) { <div class="ocr-busy">⏳ Đang đọc ảnh GPKD…</div> }

                    <div class="ocr-form">
                        <label>Mã số thuế <span class="ocr-req">*</span>
                            <input class="vanan-input" @bind="_gpdkMst" placeholder="10 hoặc 13 chữ số" />
                            @ConfidenceBadge("MST", _gpdkMstConf)
                        </label>
                        <label>Tên doanh nghiệp <span class="ocr-req">*</span>
                            <input class="vanan-input" @bind="_gpdkName" />
                            @ConfidenceBadge("Tên", _gpdkNameConf)
                        </label>
                        <label>Địa chỉ
                            <input class="vanan-input" @bind="_gpdkAddress" />
                            @ConfidenceBadge("Địa chỉ", _gpdkAddressConf)
                        </label>
                        <label>Loại hình pháp lý
                            <select class="vanan-select" @bind="_gpdkLegalForm">
                                <option value="">— Chọn —</option>
                                <option value="HKD">Hộ kinh doanh</option>
                                <option value="TNHH">Công ty TNHH</option>
                                <option value="Cổ phần">Công ty cổ phần</option>
                                <option value="DNTN">Doanh nghiệp tư nhân</option>
                                <option value="HTX">Hợp tác xã</option>
                            </select>
                        </label>
                        @if (_gpdkLegalForm == "HKD")
                        {
                            <div class="ocr-hkd-group-box">
                                <HkdGroupHelper @bind-HkdGroup="_hkdGroupA" />
                            </div>
                        }
                        <label>Người đại diện / Chủ hộ
                            <input class="vanan-input" @bind="_gpdkOwner" />
                        </label>
                    </div>
                </div>
            }
            else
            {
                <div class="ocr-section">
                    <h4>🏪 Thông tin shop (không GPKD)</h4>
                    <div class="ocr-form">
                        <label>Tên shop <span class="ocr-req">*</span> <span class="ocr-hint">(sẽ prefill từ biển hiệu ở bước 3)</span>
                            <input class="vanan-input" @bind="_tenantName" placeholder="VD: Cà Phê ABC" />
                        </label>
                        <label>Địa chỉ <span class="ocr-hint">(không bắt buộc nếu kinh doanh lưu động)</span>
                            <input class="vanan-input" @bind="_address" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" />
                        </label>
                        <label class="ocr-check">
                            <input type="checkbox" @bind="_unregistered" @bind:after="OnUnregisteredChanged" />
                            Chủ hộ <strong>CHƯA đăng ký</strong> hộ kinh doanh
                        </label>
                        @if (_unregistered)
                        {
                            <div class="ocr-hint">⚠️ Sẽ tạo HKD <strong>Nhóm 1</strong> + ghi nhận cờ "chưa đăng ký" — sysadmin khuyến nghị đăng ký khi duyệt.</div>
                        }
                        else
                        {
                            <div>
                                <div class="ocr-hint" style="font-weight:600;">Nhóm thuế HKD (quyết định sổ sách kế toán TT152) <span class="ocr-req">*</span></div>
                                <HkdGroupHelper @bind-HkdGroup="_hkdGroup" />
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="ocr-wizard-actions">
                <VanAButton Variant="secondary" OnClick="BackToCaseSelect">← Quay lại</VanAButton>
                <VanAButton Variant="primary" OnClick="NextFromDocs">Tiếp theo</VanAButton>
            </div>
            break;

        case 2:
            <div class="ocr-section">
                <h4>📷 Biển hiệu cửa hàng</h4>
                <div class="ocr-capture-row">
                    <input type="file" accept="image/*" capture="environment" class="ocr-file-input"
                           onchange="vananOnboardingWizard.processFile(this.files[0], 'extractSignName')" />
                    <VanAButton Variant="secondary" Size="small" OnClick="OpenCameraSign">📷 Chụp trực tiếp</VanAButton>
                </div>
                @if (_isOcrBusy) { <div class="ocr-busy">⏳ Đang đọc biển hiệu…</div> }
                <label>Tên hiệu
                    <input class="vanan-input" @bind="_signName" placeholder="Tên trên biển hiệu" />
                    @ConfidenceBadge("Biển hiệu", _signNameConf)
                </label>
                @if (_case == OcrOnboardingCase.CompanyWithLicense)
                {
                    <div class="ocr-hint">Tên hiệu sẽ cross-check với tên GPKD ở bước xác nhận.</div>
                }
            </div>

            <div class="ocr-section">
                <h4>📷 Menu / Danh mục sản phẩm (1..n ảnh)</h4>
                <div class="ocr-capture-row">
                    <input type="file" accept="image/*" capture="environment" multiple class="ocr-file-input"
                           onchange="vananOnboardingWizard.processMenuFiles(this.files)" />
                    <VanAButton Variant="secondary" Size="small" OnClick="OpenCameraMenu">📷 Chụp trực tiếp</VanAButton>
                </div>
                @if (_isMenuBusy) { <div class="ocr-busy">⏳ Đang đọc menu…</div> }

                @if (_productRows.Count > 0)
                {
                    <table class="ocr-product-table">
                        <thead><tr><th>#</th><th>Tên sản phẩm</th><th>Giá (₫)</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < _productRows.Count; i++)
                            {
                                var row = _productRows[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><input class="vanan-input" @bind="row.Name" /></td>
                                    <td><input class="vanan-input ocr-price" type="number" min="0" step="1000" @bind="row.Price" /></td>
                                    <td><button type="button" class="ocr-remove-btn" @onclick="() => RemoveProductRow(i)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <VanAButton Variant="secondary" Size="small" OnClick="AddProductRow">+ Thêm dòng</VanAButton>
                }
            </div>

            <div class="ocr-wizard-actions">
                <VanAButton Variant="secondary" OnClick="BackToDocs">← Quay lại</VanAButton>
                <VanAButton Variant="primary" OnClick="NextFromSignMenu">Tiếp theo</VanAButton>
            </div>
            break;

        case 3:
            <div class="ocr-section">
                <h4>📍 Vị trí cửa hàng</h4>
                <VanAButton Variant="primary" OnClick="GetLocationAsync" Loading="_isGpsBusy">
                    📡 Lấy vị trí hiện tại (GPS)
                </VanAButton>
                <span class="ocr-hint"> — hoặc nhập tọa độ tay / bấm vào bản đồ bên dưới.</span>
                <div class="ocr-form">
                    <label>Vĩ độ (lat) <span class="ocr-req">*</span>
                        <input class="vanan-input" type="number" step="0.000001" min="-90" max="90" @bind="_lat" />
                    </label>
                    <label>Kinh độ (lng) <span class="ocr-req">*</span>
                        <input class="vanan-input" type="number" step="0.000001" min="-180" max="180" @bind="_lng" />
                    </label>
                </div>
                @if (_lat is not null && _lng is not null)
                {
                    <div class="ocr-gps-info">
                        <strong>@_lat.Value.ToString("F6"), @_lng.Value.ToString("F6")</strong>
                        @if (_accuracy > 0) { <span> · chính xác ±@Math.Round(_accuracy)m</span> }
                    </div>
                    <div id="ocrMap" class="ocr-map"></div>
                    <div class="ocr-hint">🗺️ Bấm vào bản đồ để đặt lại vị trí chính xác.</div>
                    <VanAButton Variant="secondary" Size="small" OnClick="GetLocationAsync" Loading="_isGpsBusy">📡 Lấy lại GPS</VanAButton>
                }
            </div>

            <div class="ocr-section">
                <h4>✅ Xác nhận thông tin</h4>
                <div class="ocr-form">
                    <label>Tên tenant <span class="ocr-req">*</span> <input class="vanan-input" @bind="_tenantName" /></label>
                    <label>Địa chỉ
                        @if (_case == OcrOnboardingCase.SmallShopNoLicense) { <span class="ocr-hint">(không bắt buộc nếu kinh doanh lưu động)</span> }
                        <input class="vanan-input" @bind="_address" />
                    </label>
                    @if (_case == OcrOnboardingCase.CompanyWithLicense)
                    {
                        <label>Loại hình
                            <select class="vanan-select" @bind="_businessTypeStr">
                                <option value="Company">Doanh nghiệp</option>
                                <option value="HouseholdBusiness">Hộ kinh doanh</option>
                            </select>
                        </label>
                    }
                    <label>SĐT chủ hộ (liên hệ) <input class="vanan-input" @bind="_contactPhone" placeholder="VD: 0901234567" /></label>
                    <label>Email <input class="vanan-input" @bind="_contactEmail" placeholder="(tùy chọn)" /></label>
                </div>
            </div>

            <div class="ocr-wizard-actions">
                <VanAButton Variant="secondary" OnClick="BackToSignMenu">← Quay lại</VanAButton>
                <VanAButton Variant="success" OnClick="SubmitAsync" Loading="_isSubmitting">
                    🚀 Tạo tenant + kích hoạt
                </VanAButton>
            </div>
            break;

        case 4:
            @if (_result is not null)
            {
                <div class="ocr-result">
                    <h4>✅ Tenant đã tạo và kích hoạt</h4>
                    <p>Slug: <strong>@_result.Slug</strong></p>
                    @if (_result.ExistingDuplicateTenantId is not null)
                    {
                        <VanAAlert Variant="warning" Message="Gợi ý: có thể trùng với tenant đã tồn tại — kiểm tra trước khi bàn giao." />
                    }
                    <div class="ocr-credential-box">
                        <div><strong>Tài khoản chủ shop (chỉ hiện 1 lần):</strong></div>
                        <div>Username: <code>@_result.OwnerUsername</code>
                            <button type="button" class="ocr-copy-btn" @onclick="() => CopyAsync(_result.OwnerUsername)">📋</button>
                        </div>
                        <div>Password: <code>@_result.OwnerPassword</code>
                            <button type="button" class="ocr-copy-btn" @onclick="() => CopyAsync(_result.OwnerPassword)">📋</button>
                        </div>
                        <div class="ocr-hint">Bàn giao credentials cho chủ shop — không hiển thị lại được.</div>
                    </div>

                    <VanAButton Variant="primary" OnClick="ImportProductsAsync" Loading="_isImporting">
                        📦 Import @(_productRows.Count) sản phẩm từ menu
                    </VanAButton>
                    @if (!string.IsNullOrEmpty(_importStatus))
                    {
                        <div class="ocr-import-status">@_importStatus</div>
                    }
                    @if (_importResult is not null)
                    {
                        <div class="ocr-import-status">
                            ✅ Imported: @_importResult.Imported · Bỏ qua: @_importResult.Skipped
                            @if (_importResult.Errors.Count > 0)
                            {
                                <ul>@foreach (var e in _importResult.Errors) { <li>Dòng @e.LineNo (@e.Name): @e.Error</li> }</ul>
                            }
                        </div>
                    }
                    <div style="margin-top: 1rem;">
                        <VanAButton Variant="secondary" OnClick="GoToTenants">
                            Về danh sách tenant
                        </VanAButton>
                        <VanAButton Variant="secondary" OnClick="ResetWizard">+ Tạo tenant khác</VanAButton>
                    </div>
                </div>
            }
            break;
    }

    <!-- Camera scan modal (2026-10-26 user directive — chụp trực tiếp) -->
    @if (_showCameraModal)
    {
        <div class="ocr-camera-overlay">
            <div class="ocr-camera-modal">
                <div class="ocr-camera-header">
                    <strong>@CameraTitle</strong>
                    @if (_cameraMode == "menu")
                    {
                        <span class="ocr-camera-count">Đã chụp: @_menuShotCount</span>
                    }
                    <button type="button" class="ocr-camera-close" @onclick="CloseCameraAsync">✕</button>
                </div>
                <video id="ocrCameraVideo" class="ocr-camera-video" autoplay playsinline muted></video>
                <div class="ocr-camera-actions">
                    @if (_cameraMode == "menu")
                    {
                        <VanAButton Variant="primary" OnClick="CaptureMenuShotAsync">📸 Chụp</VanAButton>
                        <VanAButton Variant="success" OnClick="FinishMenuCaptureAsync">✅ Xong + Nhận diện (@_menuShotCount ảnh)</VanAButton>
                    }
                    else
                    {
                        <VanAButton Variant="primary" OnClick="CaptureAndOcrAsync">📸 Chụp + Nhận diện</VanAButton>
                    }
                    <VanAButton Variant="danger" OnClick="CloseCameraAsync">✕ Đóng</VanAButton>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // ── State ──────────────────────────────────────────────────────────
    private int _step = 0;
    private OcrOnboardingCase? _case;
    private string _alertMessage = string.Empty;
    private string _alertVariant = "info"; // info | success | warning | error

    // GPKD (Case A)
    private string _gpdkMst = string.Empty;
    private string _gpdkName = string.Empty;
    private string _gpdkAddress = string.Empty;
    private string _gpdkLegalForm = string.Empty;
    private string _gpdkOwner = string.Empty;
    private double _gpdkMstConf, _gpdkNameConf, _gpdkAddressConf, _gpdkLegalFormConf;
    private string _signName = string.Empty;
    private double _signNameConf;

    // Chung
    private string _tenantName = string.Empty;
    private string _address = string.Empty;
    private string _businessTypeStr = "Company";
    private string? _hkdGroup;   // Case B: "1"|"2"|"3" (helper)
    private string? _hkdGroupA;  // P3: Case A HKD — helper gợi ý (thay auto-Group2)
    private bool _unregistered;  // P3: Case B — chủ hộ CHƯA đăng ký HKD → force Group1
    private string _contactPhone = string.Empty;
    private string _contactEmail = string.Empty;
    private List<ProductRow> _productRows = [];
    private List<PhotoEntry> _photoUrls = [];   // P3: ảnh provenance đã upload R2
    private double? _lat, _lng;
    private double _accuracy;
    private double? _lastMapLat, _lastMapLng;   // RV fix: guard init map chỉ khi coords đổi
    private bool _uploadConfigured;             // P3: configureUpload gọi 1 lần

    // Busy flags
    private bool _isOcrBusy, _isMenuBusy, _isGpsBusy, _isSubmitting, _isImporting;
    private bool _jsRegistered;
    private bool _showCameraModal;
    private string _cameraMode = string.Empty;   // "gpdk" | "sign" | "menu"
    private int _menuShotCount;
    private bool _cameraPendingOpen;

    private OcrOnboardingResult? _result;
    private ProductImportResult? _importResult;
    private string _importStatus = string.Empty;

    private sealed class ProductRow
    {
        public string Name { get; set; } = string.Empty;
        public decimal? Price { get; set; }
    }

    /// <summary>P3: ảnh đã upload R2 (Cloudinary URL) + loại giấy tờ.</summary>
    private sealed class PhotoEntry
    {
        public string Url { get; set; } = string.Empty;
        public string Kind { get; set; } = string.Empty;
    }

    private sealed record GpdkOcrResult(
        string? Mst, string? Name, string? Address, string? LegalForm, string? Owner,
        Dictionary<string, double>? Confidence, List<string>? Warnings);

    private sealed record SignOcrResult(string? Value, double Confidence);

    private sealed record MenuOcrResult(List<MenuProductLine>? ProductLines, List<string>? Warnings);

    private sealed record MenuProductLine(string? Name, decimal? Price, int LineNo, double Confidence);

    /// <summary>P3: draft autosave — fields text + productRows + photoUrls + step (KHÔNG password/ảnh blob).</summary>
    private sealed class WizardDraft
    {
        public int Step { get; set; }
        public string? Case { get; set; }
        public string GpdkMst { get; set; } = string.Empty;
        public string GpdkName { get; set; } = string.Empty;
        public string GpdkAddress { get; set; } = string.Empty;
        public string GpdkLegalForm { get; set; } = string.Empty;
        public string GpdkOwner { get; set; } = string.Empty;
        public double GpdkMstConf { get; set; }
        public double GpdkNameConf { get; set; }
        public double GpdkAddressConf { get; set; }
        public double GpdkLegalFormConf { get; set; }
        public string SignName { get; set; } = string.Empty;
        public double SignNameConf { get; set; }
        public string TenantName { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string BusinessTypeStr { get; set; } = "Company";
        public string? HkdGroup { get; set; }
        public string? HkdGroupA { get; set; }
        public bool Unregistered { get; set; }
        public string ContactPhone { get; set; } = string.Empty;
        public string ContactEmail { get; set; } = string.Empty;
        public List<ProductRow> ProductRows { get; set; } = [];
        public List<PhotoEntry> PhotoUrls { get; set; } = [];
        public double? Lat { get; set; }
        public double? Lng { get; set; }
        public double Accuracy { get; set; }
    }

    // ── Stepper helpers ────────────────────────────────────────────────
    private string StepClass(int step) => step == _step ? "ocr-step active" : step < _step ? "ocr-step done" : "ocr-step";

    private void SelectCase(OcrOnboardingCase c)
    {
        _case = c;
        if (c == OcrOnboardingCase.SmallShopNoLicense)
        {
            _businessTypeStr = "HouseholdBusiness";
        }
    }

    private void CloseAlert() => _alertMessage = string.Empty;

    private void BackToCaseSelect() => _step = 0;

    private void BackToDocs() => _step = 1;

    private void BackToSignMenu() => _step = 2;

    private void GoToTenants() => NavigationManager.NavigateTo("/admin/tenants");

    private void NextFromCase()
    {
        if (_case is null) { ShowAlert("Chọn loại hình trước.", "warning"); return; }
        _step = 1;
    }

    private void NextFromDocs()
    {
        if (_case == OcrOnboardingCase.CompanyWithLicense)
        {
            if (string.IsNullOrWhiteSpace(_gpdkMst))
            {
                ShowAlert("Mã số thuế bắt buộc — OCR không đọc được thì nhập tay.", "warning");
                return;
            }
            _tenantName = string.IsNullOrWhiteSpace(_tenantName) ? _gpdkName : _tenantName;
            _address = string.IsNullOrWhiteSpace(_address) ? _gpdkAddress : _address;
            if (_gpdkLegalForm == "HKD")
            {
                _businessTypeStr = "HouseholdBusiness";
                // P3: HKD bắt buộc nhóm thuế (domain invariant) — helper gợi ý, KHÔNG auto-Group2.
                if (string.IsNullOrWhiteSpace(_hkdGroupA))
                {
                    ShowAlert("GPKD là Hộ kinh doanh — chọn/gợi ý nhóm thuế HKD (bước Giấy tờ) trước khi tiếp tục.", "warning");
                    return;
                }
            }
            else if (!string.IsNullOrWhiteSpace(_gpdkLegalForm)) _businessTypeStr = "Company";
        }
        else
        {
            // P3: địa chỉ OPTIONAL Case B (kinh doanh lưu động) — chỉ tên + nhóm thuế bắt buộc.
            if (string.IsNullOrWhiteSpace(_tenantName))
            {
                ShowAlert("Tên shop là bắt buộc.", "warning");
                return;
            }
            if (!_unregistered && string.IsNullOrWhiteSpace(_hkdGroup))
            {
                ShowAlert("Chọn nhóm thuế HKD (hoặc tick \"chưa đăng ký\").", "warning");
                return;
            }
        }
        _step = 2;
    }

