    // ── OCR callbacks (JS → Blazor) ────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_jsRegistered)
        {
            _jsRegistered = true;
            await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.register", DotNetObjectReference.Create(this));
            // P3: public Gateway URL cho browser→Gateway image upload (fallback internal — sẽ fail trong browser nếu thiếu config)
            var publicBase = (Configuration["Gateway:PublicBaseUrl"] ?? string.Empty).TrimEnd('/');
            if (string.IsNullOrEmpty(publicBase))
            {
                publicBase = (Configuration["Gateway:BaseUrl"] ?? string.Empty).TrimEnd('/');
                Logger.LogWarning("Gateway:PublicBaseUrl chưa config — photo upload dùng internal URL (có thể fail từ browser)");
            }
            await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.configureUpload", publicBase);
            _uploadConfigured = true;
            await RestoreDraftAsync();
        }
        // P3: draft autosave mỗi render (sessionStorage write rẻ) — bỏ qua sau khi submit xong
        // và bỏ qua state rỗng (tránh prompt "khôi phục" cho draft trắng sau khi user từ chối).
        if (_jsRegistered && _uploadConfigured && _result is null)
        {
            var draft = BuildDraft();
            if (HasDraftContent(draft))
            {
                var draftJson = System.Text.Json.JsonSerializer.Serialize(draft);
                await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.saveDraft", draftJson);
            }
        }
        // RV fix 2026-10-26: chỉ init map khi coords THAY ĐỔI — trước đây gọi mỗi render
        // → L.map lần 2 ném "Map container is already initialized" → circuit chết.
        if (_step == 3 && _lat is not null && _lng is not null
            && (_lat != _lastMapLat || _lng != _lastMapLng))
        {
            _lastMapLat = _lat;
            _lastMapLng = _lng;
            await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.initMap", "ocrMap", _lat.Value, _lng.Value, _accuracy);
        }
        // Camera modal: mở camera sau khi video element đã render
        if (_cameraPendingOpen)
        {
            _cameraPendingOpen = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.openCamera", "ocrCameraVideo");
            }
            catch (Exception ex)
            {
                ShowAlert($"Không mở được camera: {ex.Message}", "error");
                _showCameraModal = false;
            }
        }
    }

    /// <summary>P3: JS gửi kèm photoUrlsJson (JSON array string) sau khi upload R2 song song OCR.</summary>
    [JSInvokable]
    public Task OnOcrResult(string method, string json, string? photoUrlsJson = null)
    {
        try
        {
            CollectPhotoUrls(method, photoUrlsJson);
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            switch (method)
            {
                case "extractGpdk":
                {
                    _isOcrBusy = false;
                    _ = CloseCameraAsync();   // chụp xong → đóng camera
                    var r = System.Text.Json.JsonSerializer.Deserialize<GpdkOcrResult>(json, options);
                    if (r is null) break;
                    _gpdkMst = r.Mst ?? _gpdkMst;
                    _gpdkName = r.Name ?? _gpdkName;
                    _gpdkAddress = r.Address ?? _gpdkAddress;
                    _gpdkLegalForm = r.LegalForm ?? _gpdkLegalForm;
                    _gpdkOwner = r.Owner ?? _gpdkOwner;
                    _gpdkMstConf = r.Confidence?.GetValueOrDefault("mst") ?? 0;
                    _gpdkNameConf = r.Confidence?.GetValueOrDefault("name") ?? 0;
                    _gpdkAddressConf = r.Confidence?.GetValueOrDefault("address") ?? 0;
                    _gpdkLegalFormConf = r.Confidence?.GetValueOrDefault("legalForm") ?? 0;
                    if (r.Warnings is { Count: > 0 }) ShowAlert(string.Join(" · ", r.Warnings), "warning");
                    else ShowAlert("Đã đọc GPKD — kiểm tra lại các trường trước khi tiếp tục.", "success");
                    break;
                }
                case "extractSignName":
                {
                    _isOcrBusy = false;
                    _ = CloseCameraAsync();   // chụp xong → đóng camera
                    var r = System.Text.Json.JsonSerializer.Deserialize<SignOcrResult>(json, options);
                    if (r?.Value is not null)
                    {
                        _signName = r.Value;
                        _signNameConf = r.Confidence;
                    }
                    break;
                }
                case "extractMenu":
                {
                    _isMenuBusy = false;
                    var r = System.Text.Json.JsonSerializer.Deserialize<MenuOcrResult>(json, options);
                    if (r?.ProductLines is not null)
                    {
                        _productRows = r.ProductLines
                            .Where(p => !string.IsNullOrWhiteSpace(p.Name))
                            .Select(p => new ProductRow { Name = p.Name!, Price = p.Price })
                            .ToList();
                        ShowAlert($"Đã đọc {_productRows.Count} sản phẩm từ menu — rà soát giá và tên.", "success");
                    }
                    if (r?.Warnings is { Count: > 0 })
                        ShowAlert(string.Join(" · ", r.Warnings), "warning");
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OCR result parse fail ({Method})", method);
            ShowAlert($"Lỗi xử lý kết quả OCR: {ex.Message}", "error");
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>P3: map click → cập nhật tọa độ (OnAfterRender sẽ re-init map với marker mới).</summary>
    [JSInvokable]
    public Task OnMapClick(double lat, double lng)
    {
        if (lat is >= -90 and <= 90 && lng is >= -180 and <= 180)
        {
            _lat = lat;
            _lng = lng;
            _accuracy = 0;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>P3: gom photo URLs từ JS vào _photoUrls (dedupe theo URL, gán kind theo method OCR).</summary>
    private void CollectPhotoUrls(string method, string? photoUrlsJson)
    {
        if (string.IsNullOrWhiteSpace(photoUrlsJson)) return;
        string kind = method switch
        {
            "extractGpdk" => "GPKD",
            "extractSignName" => "Biển hiệu",
            _ => "Menu"
        };
        try
        {
            var urls = System.Text.Json.JsonSerializer.Deserialize<List<string>>(photoUrlsJson);
            if (urls is null) return;
            foreach (var url in urls.Where(u => !string.IsNullOrWhiteSpace(u)))
            {
                if (_photoUrls.All(p => p.Url != url))
                    _photoUrls.Add(new PhotoEntry { Url = url, Kind = kind });
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Photo URLs parse fail ({Method})", method);
        }
    }

