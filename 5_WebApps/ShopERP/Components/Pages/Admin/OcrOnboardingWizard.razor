    // ── Submit ─────────────────────────────────────────────────────────
    private async Task SubmitAsync()
    {
        // P3: GPS không bắt buộc — nhập tay / map click đều được; chỉ validate range.
        if (_lat is null || _lng is null
            || _lat < -90 || _lat > 90 || _lng < -180 || _lng > 180)
        {
            ShowAlert("Nhập vĩ độ (-90..90) và kinh độ (-180..180) — GPS, tay, hoặc bấm vào bản đồ.", "warning");
            return;
        }
        if (_case == OcrOnboardingCase.CompanyWithLicense && !IsValidMst(_gpdkMst))
        {
            ShowAlert("Mã số thuế phải 10 hoặc 13 chữ số.", "warning");
            return;
        }
        if (_case == OcrOnboardingCase.SmallShopNoLicense && !_unregistered && string.IsNullOrWhiteSpace(_hkdGroup))
        {
            ShowAlert("Chọn nhóm thuế HKD (hoặc tick \"chưa đăng ký\").", "warning");
            return;
        }
        if (_case == OcrOnboardingCase.CompanyWithLicense
            && _businessTypeStr == "HouseholdBusiness"
            && string.IsNullOrWhiteSpace(_hkdGroupA))
        {
            ShowAlert("Hộ kinh doanh (GPKD) cần nhóm thuế HKD — chọn/gợi ý ở bước Giấy tờ.", "warning");
            return;
        }

        _isSubmitting = true;
        ShowAlert(string.Empty, "info");
        try
        {
            var isHkd = _businessTypeStr == "HouseholdBusiness";
            var request = new OcrOnboardingRequest(
                Case: _case!.Value,
                Name: _tenantName.Trim(),
                Address: string.IsNullOrWhiteSpace(_address) ? null : _address.Trim(),
                BusinessType: isHkd ? BusinessType.HouseholdBusiness : BusinessType.Company,
                // Case B: nhóm từ helper (hoặc "1" khi unregistered). Case A HKD: _hkdGroupA.
                // Case A Company: null (domain invariant).
                HkdGroup: isHkd
                    ? (HKDGroup)int.Parse((_case == OcrOnboardingCase.SmallShopNoLicense ? _hkdGroup : _hkdGroupA) ?? "1")
                    : null,
                ProductLines: _productRows
                    .Where(r => !string.IsNullOrWhiteSpace(r.Name))
                    .Select(r => new OcrProductLineDto(r.Name.Trim(), r.Price, 0))
                    .ToList(),
                Latitude: _lat,
                Longitude: _lng,
                GpdkInfo: _case == OcrOnboardingCase.CompanyWithLicense
                    ? new OcrGpdkInfo(_gpdkMst, _gpdkName, _gpdkAddress, _gpdkLegalForm, _gpdkOwner)
                    : null,
                SignName: string.IsNullOrWhiteSpace(_signName) ? null : _signName,
                ShopInstanceId: null,
                ContactPhone: string.IsNullOrWhiteSpace(_contactPhone) ? null : _contactPhone.Trim(),
                ContactEmail: string.IsNullOrWhiteSpace(_contactEmail) ? null : _contactEmail.Trim(),
                PhotoUrls: _photoUrls.Count > 0 ? _photoUrls.Select(p => p.Url).ToList() : null,
                Unregistered: _case == OcrOnboardingCase.SmallShopNoLicense && _unregistered);

            _result = await OcrOnboardingApi.ExecuteAsync(request);
            _importResult = null;
            _importStatus = string.Empty;
            await ClearDraftAsync();   // P3: submit xong → xóa draft
            _step = 4;
        }
        catch (Exception ex)
        {
            ShowAlert($"Không tạo được tenant: {ex.Message}", "error");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ImportProductsAsync()
    {
        if (_result is null) return;
        _isImporting = true;
        _importStatus = string.Empty;
        try
        {
            var token = await OcrOnboardingApi.MintSystemAdminTokenAsync();
            var client = HttpFactory.CreateClient();
            client.BaseAddress = new Uri(NavigationManager.BaseUri);

            var payload = new
            {
                tenantId = _result.TenantId,
                lines = _productRows
                    .Where(r => !string.IsNullOrWhiteSpace(r.Name))
                    .Select(r => new { name = r.Name.Trim(), price = r.Price, lineNo = 0 })
                    .ToList(),
                defaultCategory = "Menu"
            };
            using var message = new HttpRequestMessage(HttpMethod.Post, "api/products/import")
            {
                Content = System.Net.Http.Json.JsonContent.Create(payload, options: new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                })
            };
            message.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            // P3: 409 (tenant chưa NATS-sync sang ShopERP SQLite) → auto-retry 5 lần × 3s
            // trước khi báo chờ — import thành công ngay khi sync xong, không cần bấm lại tay.
            const int maxRetries = 5;
            for (var attempt = 1; attempt <= maxRetries; attempt++)
            {
                var response = await client.SendAsync(message);
                if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    if (attempt < maxRetries)
                    {
                        _importStatus = $"⏳ Tenant đang đồng bộ sang ShopERP — thử lại lần {attempt}/{maxRetries} sau 3s…";
                        StateHasChanged();
                        await Task.Delay(3000);
                        continue;
                    }
                    _importStatus = "⏳ Tenant chưa được đồng bộ sang ShopERP sau 5 lần thử — chờ sync xong rồi bấm lại.";
                }
                else if (response.IsSuccessStatusCode)
                {
                    _importResult = await response.Content.ReadFromJsonAsync<ProductImportResult>();
                    _importStatus = string.Empty;
                }
                else
                {
                    _importStatus = $"❌ Import thất bại ({(int)response.StatusCode}) — {await response.Content.ReadAsStringAsync()}";
                }
                break;
            }
        }
        catch (Exception ex)
        {
            _importStatus = $"❌ Import thất bại: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
        }
    }

    // ── P3: draft autosave ──────────────────────────────────────────────
    private WizardDraft BuildDraft() => new()
    {
        Step = _step,
        Case = _case?.ToString(),
        GpdkMst = _gpdkMst, GpdkName = _gpdkName, GpdkAddress = _gpdkAddress,
        GpdkLegalForm = _gpdkLegalForm, GpdkOwner = _gpdkOwner,
        GpdkMstConf = _gpdkMstConf, GpdkNameConf = _gpdkNameConf,
        GpdkAddressConf = _gpdkAddressConf, GpdkLegalFormConf = _gpdkLegalFormConf,
        SignName = _signName, SignNameConf = _signNameConf,
        TenantName = _tenantName, Address = _address, BusinessTypeStr = _businessTypeStr,
        HkdGroup = _hkdGroup, HkdGroupA = _hkdGroupA, Unregistered = _unregistered,
        ContactPhone = _contactPhone, ContactEmail = _contactEmail,
        ProductRows = [.. _productRows],
        PhotoUrls = [.. _photoUrls],
        Lat = _lat, Lng = _lng, Accuracy = _accuracy
    };

    /// <summary>P3: draft chỉ đáng lưu khi có nội dung — step>0 hoặc bất kỳ field nào khác rỗng.</summary>
    private static bool HasDraftContent(WizardDraft d) =>
        d.Step > 0 || d.Case is not null
        || !string.IsNullOrWhiteSpace(d.TenantName) || !string.IsNullOrWhiteSpace(d.GpdkMst)
        || !string.IsNullOrWhiteSpace(d.SignName) || d.ProductRows.Count > 0
        || d.PhotoUrls.Count > 0 || d.Lat is not null || d.Unregistered || !string.IsNullOrWhiteSpace(d.HkdGroup);

    private async Task RestoreDraftAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("vananOnboardingWizard.loadDraft");
            if (string.IsNullOrWhiteSpace(json)) return;
            var draft = System.Text.Json.JsonSerializer.Deserialize<WizardDraft>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (draft is null) return;
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
                "Tìm thấy bản nháp wizard chưa hoàn thành. Khôi phục?");
            if (!confirmed)
            {
                await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.clearDraft");
                return;
            }
            ApplyDraft(draft);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Wizard draft restore failed — bắt đầu mới");
        }
    }

    private void ApplyDraft(WizardDraft d)
    {
        _step = Math.Clamp(d.Step, 0, 3);   // step 4 = kết quả — không restore
        _case = Enum.TryParse<OcrOnboardingCase>(d.Case, out var c) ? c : null;
        _gpdkMst = d.GpdkMst; _gpdkName = d.GpdkName; _gpdkAddress = d.GpdkAddress;
        _gpdkLegalForm = d.GpdkLegalForm; _gpdkOwner = d.GpdkOwner;
        _gpdkMstConf = d.GpdkMstConf; _gpdkNameConf = d.GpdkNameConf;
        _gpdkAddressConf = d.GpdkAddressConf; _gpdkLegalFormConf = d.GpdkLegalFormConf;
        _signName = d.SignName; _signNameConf = d.SignNameConf;
        _tenantName = d.TenantName; _address = d.Address; _businessTypeStr = d.BusinessTypeStr;
        _hkdGroup = d.HkdGroup; _hkdGroupA = d.HkdGroupA; _unregistered = d.Unregistered;
        _contactPhone = d.ContactPhone; _contactEmail = d.ContactEmail;
        _productRows = d.ProductRows;
        _photoUrls = d.PhotoUrls;
        _lat = d.Lat; _lng = d.Lng; _accuracy = d.Accuracy;
        _lastMapLat = null; _lastMapLng = null;   // coords restore → OnAfterRender init map lại
    }

    private async Task ClearDraftAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.clearDraft"); }
        catch { /* best-effort */ }
    }

