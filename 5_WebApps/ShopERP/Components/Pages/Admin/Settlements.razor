@page "/admin/settlements"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Web
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Authorization
@using VanAn.ShopERP.Services
@inject SettlementApiClient SettlementApi
@inject IThemeProvider ThemeProvider
@inject ILogger<Settlements> Logger

@attribute [Authorize(Policy = "SystemAdmin")]

<div class="settlements-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Lịch sử Settlement</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="LoadData">
                Làm mới
            </VanAButton>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Type="@_alertType" Message="@_alertMessage" OnClose="() => _alertMessage = string.Empty" />
    }

    @* Filters *@
    <VanACard Header="Bộ lọc">
        <div class="form-row">
            <div class="form-group form-group-half">
                <VanAInput Id="filter-from" Type="date" Label="Từ ngày" @bind-Value="_filterFromDateStr" />
            </div>
            <div class="form-group form-group-half">
                <VanAInput Id="filter-to" Type="date" Label="Đến ngày" @bind-Value="_filterToDateStr" />
            </div>
        </div>
        <div class="form-actions">
            <VanAButton Variant="primary" Size="small" OnClick="LoadData">Lọc</VanAButton>
            <VanAButton Variant="outline" Size="small" OnClick="ClearFilters">Xóa lọc</VanAButton>
        </div>
    </VanACard>

    @if (_isLoading)
    {
        <VanACard>
            <div class="loading-state">
                <VanASpinner Size="large" />
                <p>Đang tải...</p>
            </div>
        </VanACard>
    }
    else
    {
        <VanACard Header="@($"Giao dịch Settlement ({_response?.Total ?? 0})")">
            <div class="table-responsive">
                <VanAnDataGrid TItem="SettlementItemDto" Items="_response?.Items" EmptyMessage="Chưa có giao dịch Settlement nào.">
                    <Columns>
                        <VanAnColumn TItem="SettlementItemDto" Title="Ngày">
                            <Template Context="item">
                                @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </Template>
                        </VanAnColumn>
                        <VanAnColumn TItem="SettlementItemDto" Title="Tenant">
                            <Template Context="item">
                                <code>@item.TenantId.ToString()[..8]...</code>
                            </Template>
                        </VanAnColumn>
                        <VanAnColumn TItem="SettlementItemDto" Title="Owner">
                            <Template Context="item">
                                <code>@item.OwnerId.ToString()[..8]...</code>
                            </Template>
                        </VanAnColumn>
                        <VanAnColumn TItem="SettlementItemDto" Title="Số tiền">
                            <Template Context="item">
                                <span class="@(item.Amount < 0 ? "text-danger" : "text-success")">
                                    @item.Amount.ToString("N0") đ
                                </span>
                            </Template>
                        </VanAnColumn>
                        <VanAnColumn TItem="SettlementItemDto" Title="Số dư sau">
                            <Template Context="item">
                                @item.BalanceAfter.ToString("N0") đ
                            </Template>
                        </VanAnColumn>
                        <VanAnColumn TItem="SettlementItemDto" Title="Mô tả">
                            <Template Context="item">
                                @item.Description
                            </Template>
                        </VanAnColumn>
                        <VanAnColumn TItem="SettlementItemDto" Title="Order ID">
                            <Template Context="item">
                                @if (item.RelatedOrderId.HasValue)
                                {
                                    <code>@item.RelatedOrderId.Value.ToString()[..8]...</code>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </Template>
                        </VanAnColumn>
                    </Columns>
                </VanAnDataGrid>
            </div>

            @* Pagination *@
            @if (_response != null && _response.Total > _response.PageSize)
            {
                var totalPages = (int)Math.Ceiling((double)_response.Total / _response.PageSize);
                <div class="pagination">
                    @if (_currentPage > 1)
                    {
                        <VanAButton Variant="outline" Size="small" OnClick="PrevPage">Trước</VanAButton>
                    }
                    <span>Trang @_currentPage / @totalPages</span>
                    @if (_currentPage < totalPages)
                    {
                        <VanAButton Variant="outline" Size="small" OnClick="NextPage">Sau</VanAButton>
                    }
                </div>
            }
        </VanACard>
    }
</div>

@code {
    private bool _isLoading = true;
    private SettlementListResponse? _response;
    private string _alertMessage = string.Empty;
    private string _alertType = "info";
    private int _currentPage = 1;
    private string _filterFromDateStr = string.Empty;
    private string _filterToDateStr = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _response = await SettlementApi.ListAsync(
                fromDate: ParseDate(_filterFromDateStr),
                toDate: ParseDate(_filterToDateStr),
                page: _currentPage,
                pageSize: 20);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load settlement history");
            _alertMessage = $"Lỗi tải dữ liệu: {ex.Message}";
            _alertType = "danger";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static DateTime? ParseDate(string value)
        => DateTime.TryParse(value, out var d) ? d : null;

    private async Task PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (_response != null && _currentPage * _response.PageSize < _response.Total)
        {
            _currentPage++;
            await LoadData();
        }
    }

    private void ClearFilters()
    {
        _filterFromDateStr = string.Empty;
        _filterToDateStr = string.Empty;
        _currentPage = 1;
    }
}
