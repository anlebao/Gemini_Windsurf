@page "/guard/print/{SessionId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Guard")]
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.ShopERP.Services
@using VanAn.CoreHub.Services
@using VanAn.Shared.Domain.Common
@using VanAn.Shared.Domain.Aggregates.TenantAggregate
@inject GuardApiClient GuardApi
@inject ITenantManagementService TenantService
@inject ITenantProvider TenantProvider
@inject ILogger<PrintTicket> Logger
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject VanAn.CoreHub.Services.IQrCodeService QrCodeService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@* #126 Sprint 5: Print-optimized guard ticket — 58mm thermal printer layout.
   Opens in new tab from Guard Scanner "In vé" button (forceLoad: true).
   Auto-triggers window.print() on load. Browser print dialog allows "Save as PDF". *@
<div class="ticket-page">
    @if (loading)
    {
        <p style="text-align:center;padding:2rem;">Đang tải vé...</p>
    }
    else if (session == null)
    {
        <p style="text-align:center;padding:2rem;">Không tìm thấy phiên QR.</p>
        if (!string.IsNullOrEmpty(lastLoadError))
        {
            <p style="text-align:center;padding:0 2rem;color:#991b1b;font-size:0.8rem;">
                Lỗi: @lastLoadError<br />
                Có thể do tải lại trang (fresh circuit) — thử đóng tab và in lại từ trang Guard Scanner.
            </p>
        }
    }
    else
    {
        <div class="ticket-receipt" id="ticket-receipt">
            @* Header — Tenant name + address (dynamic, not hardcoded) *@
            <div class="ticket-header">
                <h1 class="ticket-tenant-name">@(tenantName ?? "VẠN AN")</h1>
                @if (!string.IsNullOrWhiteSpace(tenantAddress))
                {
                    <p class="ticket-address">@tenantAddress</p>
                }
                @if (!string.IsNullOrWhiteSpace(tenantPhone))
                {
                    <p class="ticket-phone">ĐT: @tenantPhone</p>
                }
                <p class="ticket-subtitle">Dịch vụ gửi xe</p>
                <div class="ticket-divider">━━━━━━━━━━━━━━━━━━</div>
            </div>

            @* Ticket meta info *@
            <div class="ticket-meta">
                <div class="ticket-meta-row">
                    <span>Biển số:</span>
                    <strong>@(string.IsNullOrWhiteSpace(session.PlateNumber) ? "(xem ảnh QR)" : session.PlateNumber)</strong>
                </div>
                <div class="ticket-meta-row">
                    <span>Giờ vào:</span>
                    <strong>@session.IssuedAt.ToVietnamTimeString()</strong>
                </div>
                <div class="ticket-meta-row">
                    <span>Ngày:</span>
                    <strong>@session.IssuedAt.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="ticket-meta-row">
                    <span>Mã vé:</span>
                    <strong>@session.ShortCode</strong>
                </div>
            </div>

            <div class="ticket-divider">━━━━━━━━━━━━━━━━━━</div>

            @* QR code — server-side QRCoder (ECC level Q, same quality as product QR) *@
            <div class="ticket-qr-box">
                @if (!string.IsNullOrEmpty(qrImageBase64))
                {
                    <img src="@qrImageBase64" alt="QR" style="width:200px; height:200px;" />
                }
            </div>

            <div class="ticket-divider">━━━━━━━━━━━━━━━━━━</div>

            @* Footer *@
            <div class="ticket-footer">
                <p class="ticket-brand">Vạn An — Guard Scanner</p>
                <p class="ticket-print-info">In lúc: @DateTime.UtcNow.ToVietnamTimeString()</p>
                <p class="ticket-instruction">Đưa vé cho bảo vệ lúc lấy xe</p>
            </div>
        </div>

        <div class="ticket-actions no-print">
            <VanAButton Variant="primary" OnClick="PrintAsync" Text="🖨️ In vé" />
            <VanAButton Variant="secondary" OnClick="GoBack" Text="← Quay lại" />
        </div>
    }
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private SessionDetailResultDto? session;
    private string? tenantName;
    private string? tenantAddress;
    private string? tenantPhone;
    private Guid tenantId;
    private bool loading = true;
    private string qrImageBase64 = string.Empty;
    private string? lastLoadError; // #130-fix2 (Bug 3): diagnostic for fresh-circuit auth race

    protected override async Task OnInitializedAsync()
    {
        // #130-fix2 (2026-08-18, Bug 3): Retry loop to handle fresh-circuit auth state race.
        // PrintTicket opens via NavigationManager.NavigateTo(..., forceLoad: true) → new tab,
        // fresh Blazor circuit. AuthenticationStateProvider may not have hydrated the tenant_id
        // claim yet → GuardApiClient mints JWT with tenant_id=Empty → GetSession 404.
        // Retry up to 3 times with 1.5s delay to give auth state time to hydrate.
        const int maxRetries = 3;
        const int retryDelayMs = 1500;
        for (int attempt = 1; attempt <= maxRetries; attempt++)
        {
            try
            {
                session = await GuardApi.GetSessionAsync(SessionId);
                if (session != null)
                {
                    // Fetch real tenant info (name + address + phone) from PG via TenantManagementService.
                    // Replaces hardcoded "VẠN AN" — ticket now shows the actual tenant's name + address.
                    tenantId = TenantProvider.TenantId;
                    if (tenantId != Guid.Empty)
                    {
                        try
                        {
                            var tenant = await TenantService.GetTenantByIdAsync(new TenantId(tenantId));
                            if (tenant != null)
                            {
                                tenantName = tenant.Name;
                                tenantAddress = tenant.Settings?.Address;
                                tenantPhone = tenant.Settings?.ContactPhone;
                            }
                        }
                        catch (Exception tenantEx)
                        {
                            Logger.LogWarning(tenantEx, "Failed to fetch tenant info for {TenantId}", tenantId);
                        }
                    }
                    break;
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading session {SessionId} for print ticket (attempt {Attempt}/{Max})", SessionId, attempt, maxRetries);
                if (attempt < maxRetries)
                {
                    await Task.Delay(retryDelayMs);
                }
                else
                {
                    // Final attempt failed — keep session=null, UI shows "Không tìm thấy phiên QR."
                    // Common cause: tenant_id claim missing on fresh circuit (see GuardApiClient warning).
                    lastLoadError = ex.Message;
                }
            }
        }
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && session != null)
        {
            // R-GUARD-QR: Generate QR server-side with QRCoder (ECC level Q — same as product QR).
            // Previous client-side qrcode.js used ECC level M (15%) — too low for reliable scanning.
            // Payload: URL format {baseUrl}/qr/claim?data={base64(json)} so external scanners work.
            // QR payload includes tn (tenantId) so KhachLink Wallet can extract it for anonymous users.
            var khachLinkUrl = Configuration.GetValue<string>("ExternalUrls:KhachLink") ?? "https://app2.khachvip.online";
            var qrPayloadJson = $"{{\"sc\":\"{session.ShortCode}\",\"sid\":\"{session.SessionId}\",\"tn\":\"{tenantId}\"}}";
            try
            {
                var qrPngBytes = QrCodeService.GenerateGuardQrCode(qrPayloadJson, khachLinkUrl);
                qrImageBase64 = $"data:image/png;base64,{Convert.ToBase64String(qrPngBytes)}";
            }
            catch (Exception qrEx)
            {
                Logger.LogError(qrEx, "Server-side QR generation failed for print ticket");
            }
            StateHasChanged();
            // Auto-trigger print dialog on page load
            await PrintAsync();
        }
    }

    private async Task PrintAsync()
    {
        await JSRuntime.InvokeVoidAsync("vananPrintBill");
    }

    private void GoBack() => NavigationManager.NavigateTo("/guard/scan", forceLoad: true);
}

<style>
    /* #126 Sprint 5: Guard ticket — 58mm thermal printer width optimized */
    .ticket-page {
        font-family: "Courier New", "Consolas", monospace;
        background: white;
        color: black;
        max-width: 400px;
        margin: 0 auto;
        padding: 1rem;
    }

    .ticket-receipt {
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .ticket-header {
        text-align: center;
        margin-bottom: 0.5rem;
    }

    .ticket-tenant-name {
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: 1px;
    }

    .ticket-subtitle {
        font-size: 0.75rem;
        margin: 0;
        opacity: 0.7;
    }

    .ticket-address {
        font-size: 0.7rem;
        margin: 0.1rem 0 0 0;
        opacity: 0.8;
    }

    .ticket-phone {
        font-size: 0.7rem;
        margin: 0.1rem 0 0 0;
        opacity: 0.8;
    }

    .ticket-divider {
        text-align: center;
        margin: 0.5rem 0;
        font-size: 0.75rem;
        opacity: 0.5;
    }

    .ticket-meta {
        margin: 0.5rem 0;
    }

    .ticket-meta-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        margin: 0.15rem 0;
    }

    .ticket-qr-box {
        text-align: center;
        margin: 0.5rem 0;
    }

    .ticket-qr-box canvas {
        max-width: 200px;
        max-height: 200px;
    }

    .ticket-footer {
        text-align: center;
        margin-top: 0.5rem;
    }

    .ticket-brand {
        font-size: 0.8rem;
        font-weight: 600;
        margin: 0;
    }

    .ticket-print-info {
        font-size: 0.65rem;
        margin: 0.25rem 0 0 0;
        opacity: 0.4;
    }

    .ticket-instruction {
        font-size: 0.7rem;
        margin: 0.25rem 0 0 0;
        opacity: 0.6;
        font-style: italic;
    }

    .ticket-actions {
        text-align: center;
        margin-top: 2rem;
        display: flex;
        gap: 0.5rem;
        justify-content: center;
    }

    /* Print styles — hide everything except ticket receipt */
    @@media print {
        body * { visibility: hidden; }
        .ticket-page, .ticket-page * { visibility: visible; }
        .ticket-page {
            position: absolute;
            left: 0;
            top: 0;
            max-width: 100%;
            padding: 0.5rem;
        }
        .no-print { display: none !important; }
        .ticket-receipt { font-size: 0.8rem; }
        .ticket-qr-box canvas { max-width: 180px; max-height: 180px; }
    }
</style>
