@page "/kitchen"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "KitchenAccess")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using VanAn.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Models
@using VanAn.UI.Platform.Tokens
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.CoreHub.Services
@using VanAn.CoreHub.Hubs
@inject IOrderWorkflowService OrderWorkflowService
@inject IShopFeatureSettingsService FeatureSettings
@inject ITenantProvider TenantProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Display> Logger
@inject NavigationManager NavigationManager
@inject IThemeProvider ThemeProvider
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory
@implements IAsyncDisposable

<div class="kitchen-display-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>🍳 Bếp — Hiển thị đơn hàng</h1>
        <VanAButton Variant="secondary" Size="small" OnClick="RefreshOrders" data-testid="kitchen-btn-refresh">
            🔄 Làm mới
        </VanAButton>
    </header>

    @if (!kitchenEnabled)
    {
        <VanACard Header="Kitchen Display tắt">
            <p>Kitchen Workflow đang tắt. Chuyển về trang đơn hàng.</p>
            <VanAButton Variant="primary" OnClick="@(() => NavigationManager.NavigateTo("/orders"))">
                ← Xem đơn hàng
            </VanAButton>
        </VanACard>
    }
    else
    {
        @if (errorMessage != null)
        {
            <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
        }

        <div class="kitchen-columns">
            @* Column 1: Confirmed — Chờ tiếp nhận *@
            <div class="kitchen-column kitchen-column--confirmed">
                <div class="kitchen-column__header">
                    <h3>🟡 Chờ tiếp nhận (@confirmedOrders.Count)</h3>
                </div>
                <div class="kitchen-column__body">
                    @foreach (var o in confirmedOrders)
                    {
                        <VanACard>
                            <div class="kitchen-card">
                                <div class="kitchen-card__header">
                                    <strong>@(o.TrackingCode ?? o.Id.ToString()[..8])</strong>
                                    <OrderStatusBadge Status="@o.Status" />
                                </div>
                                <div class="kitchen-card__time">
                                    @o.OrderDate.ToVietnamTimeShort() — @GetElapsed(o.OrderDate)
                                </div>
                                <div class="kitchen-card__items">
                                    @foreach (var item in o.Items)
                                    {
                                        <div>@item.ProductName x @item.Quantity</div>
                                    }
                                </div>
                                <div class="kitchen-card__actions">
                                    <VanAButton Variant="primary" Size="small" OnClick="@(() => TransitionTo(o.Id, "preparing"))" data-testid="@($"kitchen-btn-preparing-{o.Id}")">
                                        ⏳ Tiếp nhận
                                    </VanAButton>
                                </div>
                            </div>
                        </VanACard>
                    }
                    @if (confirmedOrders.Count == 0)
                    {
                        <p class="kitchen-empty">Không có đơn chờ.</p>
                    }
                </div>
            </div>

            @* Column 2: Preparing — Đang chế biến *@
            <div class="kitchen-column kitchen-column--preparing">
                <div class="kitchen-column__header">
                    <h3>🟠 Đang chế biến (@preparingOrders.Count)</h3>
                </div>
                <div class="kitchen-column__body">
                    @foreach (var o in preparingOrders)
                    {
                        <VanACard>
                            <div class="kitchen-card">
                                <div class="kitchen-card__header">
                                    <strong>@(o.TrackingCode ?? o.Id.ToString()[..8])</strong>
                                    <OrderStatusBadge Status="@o.Status" />
                                </div>
                                <div class="kitchen-card__time">
                                    @o.OrderDate.ToVietnamTimeShort() — @GetElapsed(o.OrderDate)
                                </div>
                                <div class="kitchen-card__items">
                                    @foreach (var item in o.Items)
                                    {
                                        <div>@item.ProductName x @item.Quantity</div>
                                    }
                                </div>
                                <div class="kitchen-card__actions">
                                    <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionTo(o.Id, "ready"))" data-testid="@($"kitchen-btn-ready-{o.Id}")">
                                        ✅ Hoàn thành
                                    </VanAButton>
                                </div>
                            </div>
                        </VanACard>
                    }
                    @if (preparingOrders.Count == 0)
                    {
                        <p class="kitchen-empty">Không có đơn đang làm.</p>
                    }
                </div>
            </div>

            @* Column 3: Ready — Sẵn sàng *@
            <div class="kitchen-column kitchen-column--ready">
                <div class="kitchen-column__header">
                    <h3>🟢 Sẵn sàng (@readyOrders.Count)</h3>
                </div>
                <div class="kitchen-column__body">
                    @foreach (var o in readyOrders)
                    {
                        <VanACard>
                            <div class="kitchen-card">
                                <div class="kitchen-card__header">
                                    <strong>@(o.TrackingCode ?? o.Id.ToString()[..8])</strong>
                                    <OrderStatusBadge Status="@o.Status" />
                                </div>
                                <div class="kitchen-card__time">
                                    @o.OrderDate.ToVietnamTimeShort() — @GetElapsed(o.OrderDate)
                                </div>
                                <div class="kitchen-card__items">
                                    @foreach (var item in o.Items)
                                    {
                                        <div>@item.ProductName x @item.Quantity</div>
                                    }
                                </div>
                                <div class="kitchen-card__actions">
                                    <VanAButton Variant="primary" Size="small" OnClick="@(() => DeliverOrder(o.Id))" data-testid="@($"kitchen-btn-deliver-{o.Id}")">
                                        📦 Trả đơn cho khách
                                    </VanAButton>
                                </div>
                            </div>
                        </VanACard>
                    }
                    @if (readyOrders.Count == 0)
                    {
                        <p class="kitchen-empty">Không có đơn sẵn sàng.</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool kitchenEnabled = true;
    // P1: Split loading state — initialLoading shows spinner, backgroundRefreshing is silent.
    private bool initialLoading = true;
    private bool backgroundRefreshing;
    private string? errorMessage;
    private System.Threading.Timer? _pollTimer;
    private HubConnection? _hubConnection;

    private List<KitchenOrderDto> confirmedOrders = new();
    private List<KitchenOrderDto> preparingOrders = new();
    private List<KitchenOrderDto> readyOrders = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Resolve tenantId from AuthenticationStateProvider (works in Blazor circuits
            // where HttpContext is null — HttpContextTenantProvider returns Guid.Empty).
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var tenantClaim = authState.User.FindFirst("tenant_id")?.Value
                              ?? authState.User.FindFirst("tenantId")?.Value;
            if (tenantClaim != null && Guid.TryParse(tenantClaim, out Guid tid) && tid != Guid.Empty)
            {
                TenantProvider.SetTenant(tid);
            }

            kitchenEnabled = await FeatureSettings.IsEnabledAsync(
                TenantProvider.TenantId,
                nameof(ShopFeatureSettingsDto.Kitchen_Workflow_Enabled));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load kitchen toggle — defaulting to ON");
            kitchenEnabled = true;
        }

        if (kitchenEnabled)
        {
            await RefreshOrders();

            // P1: SignalR is primary real-time channel (OrderCreated + OrderStatusChanged).
            // Issue 8: Poll timer reduced 30s → 5s — kitchen is real-time critical.
            // 5s poll guarantees auto-refresh even if SignalR fails silently (proxy/WebSocket issues).
            _pollTimer = new System.Threading.Timer(
                async _ => await InvokeAsync(async () => await RefreshOrders(isBackground: true)),
                null,
                TimeSpan.FromSeconds(5),
                TimeSpan.FromSeconds(5));

            await StartSignalRConnection();
        }
    }

    private async Task StartSignalRConnection()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/orderHub"))
                .WithAutomaticReconnect()
                .Build();

            // P1: OrderCreated — new order arrived from KhachLink checkout (via OrderSyncSubscriber broadcast).
            _hubConnection.On<Guid, Guid>("OrderCreated",
                async (orderId, tenantId) =>
                {
                    await InvokeAsync(async () => await RefreshOrders(isBackground: true));
                });

            // P1: OrderStatusChanged — order moved between kitchen columns (pending→confirmed→preparing→ready→completed).
            _hubConnection.On<Guid, Guid, string, string>("OrderStatusChanged",
                async (orderId, tenantId, oldStatus, newStatus) =>
                {
                    await InvokeAsync(async () => await RefreshOrders(isBackground: true));
                });

            // P1: PaymentConfirmed — paid order may transition to "confirmed" → appears in kitchen column 1.
            _hubConnection.On<Guid, Guid, string>("PaymentConfirmed",
                async (orderId, tenantId, transactionId) =>
                {
                    await InvokeAsync(async () => await RefreshOrders(isBackground: true));
                });

            await _hubConnection.StartAsync();
            Logger.LogDebug("Kitchen Display: SignalR connected to /orderHub");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Kitchen Display: SignalR connection failed — 5s poll fallback active. Retrying in 10s...");
            // Issue 8: Auto-retry SignalR connection after 10s — handles transient proxy/WebSocket failures.
            _ = Task.Run(async () =>
            {
                await Task.Delay(10000);
                try { if (_hubConnection is not null) await _hubConnection.StartAsync(); }
                catch (Exception retryEx) { Logger.LogWarning(retryEx, "Kitchen Display: SignalR retry failed"); }
            });
        }
    }

    private async Task RefreshOrders() => await RefreshOrders(isBackground: false);

    private async Task RefreshOrders(bool isBackground)
    {
        if (!kitchenEnabled) return;
        // P1: Silent refresh — only show loading state on initial load, not on poll/SignalR background reloads.
        if (isBackground)
            backgroundRefreshing = true;
        else
            initialLoading = true;
        errorMessage = null;
        // C: Fresh DI scope per refresh — avoids Blazor Server circuit-scoped DbContext stale reads.
        using var scope = ScopeFactory.CreateScope();
        var scopedWorkflowService = scope.ServiceProvider.GetRequiredService<IOrderWorkflowService>();
        try
        {
            // Load orders by status — direct service call (Edge offline-first).
            // Pass tenantId so the repository filters correctly (legacy no-tenant overload uses Guid.Empty → 0 results).
            // Bug 4 fix: Zalo QR / KhachLink orders that have been paid transition to "confirmed" status.
            // Kitchen column 1 "Chờ tiếp nhận" must show BOTH "pending" (unpaid) AND "confirmed" (paid, awaiting prep).
            // Without this, paid orders disappear from Kitchen and kitchen staff never see them.
            Guid tenantId = TenantProvider.TenantId;
            List<Order> pending = await scopedWorkflowService.GetOrdersByStatusAsync(new OrderStatusId("pending"), tenantId);
            List<Order> confirmed = await scopedWorkflowService.GetOrdersByStatusAsync(new OrderStatusId("confirmed"), tenantId);
            List<Order> preparing = await scopedWorkflowService.GetOrdersByStatusAsync(new OrderStatusId("preparing"), tenantId);
            List<Order> ready = await scopedWorkflowService.GetOrdersByStatusAsync(new OrderStatusId("ready"), tenantId);

            // Merge pending + confirmed into column 1 (all orders waiting to be prepared)
            var newConfirmed = pending.Concat(confirmed).Select(MapToDto).ToList();
            var newPreparing = preparing.Select(MapToDto).ToList();
            var newReady = ready.Select(MapToDto).ToList();

            // P1: Diff check — only update lists if content changed (prevents flicker on 30s poll with no changes).
            bool changed = !KitchenListsEqual(confirmedOrders, newConfirmed)
                || !KitchenListsEqual(preparingOrders, newPreparing)
                || !KitchenListsEqual(readyOrders, newReady);
            if (changed)
            {
                confirmedOrders = newConfirmed;
                preparingOrders = newPreparing;
                readyOrders = newReady;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading kitchen orders");
            errorMessage = $"Không thể tải đơn hàng: {ex.Message}";
        }
        finally
        {
            if (isBackground)
                backgroundRefreshing = false;
            else
                initialLoading = false;
        }
    }

    // P1: Lightweight diff for kitchen columns — compares Id + Status + OrderDate + item count.
    private static bool KitchenListsEqual(List<KitchenOrderDto> a, List<KitchenOrderDto> b)
    {
        if (a.Count != b.Count) return false;
        for (int i = 0; i < a.Count; i++)
        {
            if (a[i].Id != b[i].Id) return false;
            if (a[i].Status != b[i].Status) return false;
            if (a[i].OrderDate != b[i].OrderDate) return false;
            if (a[i].Items.Count != b[i].Items.Count) return false;
        }
        return true;
    }

    // T12: Transition via direct IOrderWorkflowService call (no HTTP).
    private async Task TransitionTo(Guid orderId, string newStatus)
    {
        try
        {
            _ = await OrderWorkflowService.TransitionStatusAsync(
                orderId,
                new OrderStatusId(newStatus),
                reason: $"Kitchen display transition to {newStatus}");
            await RefreshOrders(isBackground: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error transitioning order {OrderId} to {Status}", orderId, newStatus);
            errorMessage = $"Lỗi: {ex.Message}";
        }
    }

    // T13: "Trả đơn cho khách" — ready → delivering → completed (2 transitions).
    // completed triggers HandleOrderCompletedAsync → Outbox + accounting (existing logic).
    private async Task DeliverOrder(Guid orderId)
    {
        try
        {
            // Step 1: ready → delivered (customer confirms receipt — matches OrderWorkflowService valid transitions)
            _ = await OrderWorkflowService.TransitionStatusAsync(
                orderId,
                new OrderStatusId("delivered"),
                reason: "Kitchen: trả đơn cho khách");

            // Step 2: delivered → completed (triggers accounting + outbox)
            _ = await OrderWorkflowService.TransitionStatusAsync(
                orderId,
                new OrderStatusId("completed"),
                reason: "Kitchen: đơn đã giao");

            await RefreshOrders(isBackground: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error delivering order {OrderId}", orderId);
            errorMessage = $"Lỗi trả đơn: {ex.Message}";
        }
    }

    private static string GetElapsed(DateTime orderDate)
    {
        TimeSpan elapsed = DateTime.UtcNow - orderDate;
        return elapsed.TotalMinutes < 1 ? "vừa xong" : $"{(int)elapsed.TotalMinutes} phút trước";
    }

    private static KitchenOrderDto MapToDto(Order o)
    {
        return new KitchenOrderDto
        {
            Id = o.Id,
            TrackingCode = o.TrackingCode,
            Status = o.Status?.Value ?? "",
            OrderDate = o.OrderDate,
            Items = o.Items?.Select(i => new KitchenItemDto
            {
                ProductName = i.ProductName,
                Quantity = i.Quantity
            }).ToList() ?? new()
        };
    }

    public async ValueTask DisposeAsync()
    {
        _pollTimer?.Dispose();
        if (_hubConnection is not null)
        {
            try
            {
                await _hubConnection.DisposeAsync();
            }
            catch { /* ignore disposal errors */ }
        }
    }

    private class KitchenOrderDto
    {
        public Guid Id { get; set; }
        public string? TrackingCode { get; set; }
        public string Status { get; set; } = "";
        public DateTime OrderDate { get; set; }
        public List<KitchenItemDto> Items { get; set; } = new();
    }

    private class KitchenItemDto
    {
        public string ProductName { get; set; } = "";
        public int Quantity { get; set; }
    }
}
