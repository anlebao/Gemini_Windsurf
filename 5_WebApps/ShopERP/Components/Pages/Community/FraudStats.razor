@page "/admin/community/fraud-stats"
@rendermode InteractiveServer
@layout VanAn.ShopERP.Components.Pages.Admin.AdminLayout
@using Microsoft.AspNetCore.Components.Web
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Authorization
@using VanAn.ShopERP.Services
@inject CommunityAdminApiClient ApiClient
@inject IThemeProvider ThemeProvider
@inject ILogger<FraudStats> Logger

@attribute [Authorize(Policy = "SystemAdmin")]

<div class="fraud-stats-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Fraud Stats — Bảng điều khiển</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="LoadData">Làm mới</VanAButton>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <VanAAlert Type="error" Message="@_alertMessage" OnClose="() => _alertMessage = string.Empty" />
    }

    @if (_isLoading)
    {
        <VanACard>
            <div class="loading-state">
                <VanASpinner Size="large" />
                <p>Đang tải thống kê...</p>
            </div>
        </VanACard>
    }
    else if (_stats != null)
    {
        <div class="stats-grid">
            <VanACard>
                <h3>Pending</h3>
                <p class="stat-number stat-pending">@_stats.Pending</p>
            </VanACard>
            <VanACard>
                <h3>Confirmed</h3>
                <p class="stat-number stat-confirmed">@_stats.Confirmed</p>
            </VanACard>
            <VanACard>
                <h3>Dismissed</h3>
                <p class="stat-number stat-dismissed">@_stats.Dismissed</p>
            </VanACard>
            <VanACard>
                <h3>Reviewed</h3>
                <p class="stat-number stat-reviewed">@_stats.Reviewed</p>
            </VanACard>
        </div>

        <VanACard>
            <h3>Tổng thiệt hại đã ngăn chặn</h3>
            <p class="loss-prevented">@_stats.TotalLossPrevented.ToString("N0") VND</p>
            <p class="text-muted">Tổng hoa hồng đã confirm fraud (sẽ không được thanh toán).</p>
        </VanACard>

        <VanACard>
            <h3>Top khách hàng bị flag nhiều nhất</h3>
            @if (_stats.TopFlaggedCustomers.Count == 0)
            {
                <p class="text-muted">Chưa có dữ liệu.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Khách hàng</th>
                                <th>Số lượng flag</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _stats.TopFlaggedCustomers)
                            {
                                <tr>
                                    <td>@c.CustomerName</td>
                                    <td>@c.FlagCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </VanACard>
    }
</div>

@code {
    private ShopErpFraudStats? _stats;
    private bool _isLoading = false;
    private string _alertMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _stats = await ApiClient.GetFraudStatsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadData failed");
            _alertMessage = $"Lỗi tải thống kê: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
