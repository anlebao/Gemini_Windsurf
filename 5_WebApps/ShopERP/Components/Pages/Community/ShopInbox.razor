@page "/community/messages"
@rendermode InteractiveServer
@layout VanAn.ShopERP.Components.Pages.Admin.AdminLayout
@using Microsoft.AspNetCore.Components.Web
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Components.Realtime
@using Microsoft.AspNetCore.Authorization
@using VanAn.Shared.Domain.Common
@using VanAn.Shared.Services
@using VanAn.ShopERP.Services
@using VanAn.ShopERP.Components.Shared
@inject ShopInboxApiClient ApiClient
@inject IThemeProvider ThemeProvider
@inject ILogger<ShopInbox> Logger
@inject IConfiguration Config
@* Task AI-P9: owner review of AI conversations (read-only, flag TenantAiEnabled). *@
@* Task AI-P11: "Đề xuất AI" trên tin owner → knowledge doc pending_review (verbatim Q&A). *@
@inject IShopFeatureSettingsService FeatureSettings
@inject ITenantProvider TenantProvider
@inject ITenantAiClient AiClient

@attribute [Authorize(Roles = "Owner")]

@* Realtime Platform P5 (2026-09-18): hộp thư tin nhắn chủ shop — mọi conversation
   Shop/{tenantId} của khách hàng, dùng RealtimeChatPanel (UI Platform) phía chi tiết. *@
<div class="shop-inbox @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Hộp thư tin nhắn
            @if (_totalUnread > 0)
            {
                <span class="inbox-unread-total" title="Tin chưa đọc">@_totalUnread chưa đọc</span>
            }
        </h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="RefreshAsync">Làm mới</VanAButton>
        </div>
    </header>

    @* Task AI-P9 — tab strip chỉ hiện khi flag TenantAiEnabled ON (ops toggle). *@
    @if (_aiTabVisible)
    {
        <ul class="nav nav-tabs mb-3 inbox-tabs">
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "customer" ? "active" : "")"
                        @onclick="SwitchToCustomerTab">
                    <i class="bi bi-chat-dots"></i> Tin nhắn khách
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "ai" ? "active" : "")"
                        @onclick="SwitchToAiTabAsync">
                    <i class="bi bi-robot"></i> AI trả lời khách
                </button>
            </li>
        </ul>
    }

    @if (!string.IsNullOrEmpty(_notice))
    {
        <VanAAlert Variant="@_noticeVariant" Message="@_notice" Dismissible="true" OnDismiss="() => _notice = null" />
    }

    @if (_activeTab == "ai")
    {
        <AiConversationReviewPanel @ref="_aiPanel" />
    }
    else if (_isLoading)
    {
        <VanACard>
            <div class="loading-state">
                <VanASpinner Size="large" />
                <p>Đang tải hộp thư...</p>
            </div>
        </VanACard>
    }
    else if (_error != null)
    {
        <VanACard>
            <div class="empty-state">
                <p class="text-danger">@_error</p>
                <VanAButton Variant="primary" Size="small" OnClick="LoadData">Thử lại</VanAButton>
            </div>
        </VanACard>
    }
    else if (_conversations.Count == 0)
    {
        <VanACard>
            <div class="empty-state">
                <i class="bi bi-chat-dots" style="font-size: 2.5rem; color: #6c757d;"></i>
                <p class="mt-2">Chưa có cuộc trò chuyện nào. Khi khách hàng nhắn tin từ trang cửa hàng, hộp thư sẽ hiển thị tại đây.</p>
            </div>
        </VanACard>
    }
    else
    {
        <div class="row g-3">
            <!-- Conversation list -->
            <div class="col-md-4">
                <VanACard CssClass="conversation-list-card">
                    <div class="list-group list-group-flush">
                        @foreach (var conv in _conversations)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action @(conv.ConversationId == _selectedConversationId ? "active" : "")"
                                    @onclick="() => SelectConversation(conv)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong>@(conv.CustomerName ?? "Khách hàng")</strong>
                                    <span class="d-flex align-items-center gap-2">
                                        @if (conv.UnreadCount > 0)
                                        {
                                            <span class="inbox-conv-badge" title="Tin chưa đọc">@conv.UnreadCount</span>
                                        }
                                        @if (conv.LastMessageAt.HasValue)
                                        {
                                            <small>@conv.LastMessageAt.Value.ToLocalTime().ToString("HH:mm dd/MM")</small>
                                        }
                                    </span>
                                </div>
                                <div class="text-truncate small @(conv.ConversationId == _selectedConversationId ? "" : "text-muted")">
                                    @(conv.LastMessage ?? "Chưa có tin nhắn")
                                </div>
                            </button>
                        }
                    </div>
                </VanACard>
            </div>

            <!-- Chat -->
            <div class="col-md-8">
                @if (_selectedConversationId != Guid.Empty)
                {
                    <RealtimeChatPanel SubjectType="Shop"
                                       SubjectId="_selectedTenantId"
                                       PeerId="_selectedPeerId"
                                       CurrentUserId="_staffUserId"
                                       StaffToken="@_staffToken"
                                       VoiceEnabled="_voiceEnabled"
                                       VoiceCallEnabled="_voiceCallEnabled"
                                       VoiceServiceUrl="@_voiceServiceUrl"
                                       VoiceHubUrl="@_voiceHubUrl"
                                       KnowledgeSuggestEnabled="@_aiTabVisible"
                                       OnKnowledgeSuggest="HandleKnowledgeSuggest"
                                       ScrollContainerId="inbox-chat-scroll" />
                }
                else
                {
                    <VanACard>
                        <div class="empty-state">
                            <i class="bi bi-chat-left-text" style="font-size: 2.5rem; color: #6c757d;"></i>
                            <p class="mt-2">Chọn một cuộc trò chuyện để xem tin nhắn.</p>
                        </div>
                    </VanACard>
                }
            </div>
        </div>
    }

    @* AI-P11: confirm dialog — preview nguyên văn cặp hỏi/đáp trước khi gửi vào
       hàng chờ duyệt tri thức AI (classification chọn sau ở trang TenantAi Knowledge). *@
    @if (_suggestion is not null)
    {
        <div class="ai-suggest-overlay" @onclick="CloseSuggest">
            <div class="ai-suggest-card" @onclick:stopPropagation="true">
                <h6 class="mb-1"><i class="bi bi-robot"></i> Đề xuất vào tri thức AI</h6>
                <p class="small text-muted">
                    Nội dung gửi <strong>nguyên văn</strong> — AI chỉ dùng sau khi bạn duyệt
                    và chọn phân loại trong trang <a href="/admin/tenant-ai/knowledge">Tri thức AI</a>.
                </p>
                <div class="ai-suggest-msg">
                    <span class="badge bg-light text-dark border">Khách hỏi</span>
                    <pre>@_suggestion.Question</pre>
                </div>
                <div class="ai-suggest-msg">
                    <span class="badge bg-primary">Chủ quán đáp</span>
                    <pre>@_suggestion.Answer</pre>
                </div>
                <label class="form-label small mb-1" for="ai-suggest-title">Tiêu đề tài liệu</label>
                <input id="ai-suggest-title" class="form-control form-control-sm mb-3" maxlength="200"
                       @bind="_suggestTitle" data-testid="input-suggest-title" />
                <div class="d-flex gap-2 justify-content-end">
                    <VanAButton Variant="secondary" Size="small" OnClick="CloseSuggest" Disabled="@_suggestBusy">
                        Hủy
                    </VanAButton>
                    <VanAButton Variant="primary" Size="small" OnClick="ConfirmSuggestAsync"
                                Loading="@_suggestBusy"
                                Disabled="@(_suggestBusy || string.IsNullOrWhiteSpace(_suggestTitle))"
                                data-testid="btn-confirm-suggest">
                        Gửi vào hàng chờ duyệt
                    </VanAButton>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .inbox-unread-total {
        display: inline-block; background: var(--vanan-danger, #dc3545); color: white;
        font-size: 0.75rem; font-weight: 700; border-radius: 12px; padding: 2px 10px; margin-left: 0.5rem;
        vertical-align: middle;
    }
    .inbox-conv-badge {
        display: inline-block; background: var(--vanan-danger, #dc3545); color: white;
        font-size: 0.7rem; font-weight: 700; min-width: 18px; height: 18px; line-height: 18px;
        text-align: center; border-radius: 9px; padding: 0 5px;
    }
    .ai-suggest-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1050;
        display: flex; align-items: center; justify-content: center; padding: 1rem;
    }
    .ai-suggest-card {
        background: var(--vanan-surface, #fff); border-radius: .75rem; padding: 1.25rem;
        width: 100%; max-width: 560px; max-height: 85vh; overflow-y: auto;
        box-shadow: 0 10px 40px rgba(0,0,0,.25);
    }
    .ai-suggest-msg { margin-bottom: .75rem; }
    .ai-suggest-msg pre {
        white-space: pre-wrap; word-break: break-word; font-size: .8rem;
        background: #f8f9fa; border: 1px solid #e9ecef; border-radius: .375rem;
        padding: .5rem; margin: .35rem 0 0; max-height: 120px; overflow-y: auto;
    }
</style>

@code {
    private bool _isLoading = true;
    private string? _error;
    private List<ShopInboxConversationItem> _conversations = new();
    private int _totalUnread;

    private Guid _selectedConversationId;
    private Guid _selectedTenantId;
    /// <summary>2026-11-13: customer/guest participant id of the selected thread — shop
    /// conversations are per-customer, the panel needs it to resolve the right one.</summary>
    private Guid _selectedPeerId;
    private Guid _staffUserId;
    private string? _staffToken;

    // ── Task AI-P9/P10: tab "AI trả lời khách" — read-only review, markup/logic trong
    //    AiConversationReviewPanel (shared). Flag-gated; HTTP chỉ chạy khi owner mở tab (lazy mount).
    private string _activeTab = "customer";
    private bool _aiTabVisible;
    private AiConversationReviewPanel? _aiPanel;

    /// <summary>SF-W3 (2026-11-08): mic trong chat panel — flag Voice_Note_Enabled của tenant.</summary>
    private bool _voiceEnabled;

    /// <summary>VOICE SERVICE P4 (2026-11-11): nút Gọi thoại — flag Voice_Call_Enabled của tenant.</summary>
    private bool _voiceCallEnabled;

    /// <summary>VOICE SERVICE C2 (2026-11-11): voice service HTTP base URL (production default, env-overridable).</summary>
    private string _voiceServiceUrl;

    /// <summary>VOICE SERVICE C2 (2026-11-11): voice SignalR hub URL (production default, env-overridable).</summary>
    private string _voiceHubUrl;

    protected override async Task OnInitializedAsync()
    {
        _staffUserId = await ApiClient.GetCurrentUserIdAsync();
        _voiceServiceUrl = Config["Voice:ServiceUrl"] ?? "https://voice.khachvip.online";
        _voiceHubUrl = Config["Voice:HubUrl"] ?? "https://voice.khachvip.online/hubs/voice";
        try
        {
            _aiTabVisible = TenantProvider.HasTenant
                && await FeatureSettings.IsEnabledAsync(TenantProvider.TenantId, TenantAiKnowledgeSyncService.FlagName);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ShopInbox: TenantAi flag check failed — AI tab hidden");
            _aiTabVisible = false;
        }
        try
        {
            _voiceEnabled = TenantProvider.HasTenant
                && await FeatureSettings.IsEnabledAsync(TenantProvider.TenantId, nameof(ShopFeatureSettingsDto.Voice_Note_Enabled));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ShopInbox: Voice_Note flag check failed — mic hidden");
            _voiceEnabled = false;
        }
        try
        {
            _voiceCallEnabled = TenantProvider.HasTenant
                && await FeatureSettings.IsEnabledAsync(TenantProvider.TenantId, nameof(ShopFeatureSettingsDto.Voice_Call_Enabled));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ShopInbox: Voice_Call flag check failed — call button hidden");
            _voiceCallEnabled = false;
        }
        await LoadData();
    }

    private void SwitchToCustomerTab() => _activeTab = "customer";

    /// <summary>Header refresh reloads whichever tab is active.</summary>
    private async Task RefreshAsync()
    {
        if (_activeTab == "ai" && _aiPanel != null)
            await _aiPanel.RefreshAsync();
        else
            await LoadData();
    }

    private void SwitchToAiTabAsync() => _activeTab = "ai";

    private async Task LoadData()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var result = await ApiClient.GetConversationsAsync();
            _conversations = result.Conversations;
            _totalUnread = result.TotalUnread;

            // Keep the selection if the conversation still exists (refreshes the panel token).
            if (_selectedConversationId != Guid.Empty
                && _conversations.All(c => c.ConversationId != _selectedConversationId))
            {
                _selectedConversationId = Guid.Empty;
                _staffToken = null;
            }
        }
        catch (Exception ex)
        {
            _error = "Không tải được hộp thư. Vui lòng thử lại.";
            Logger.LogError(ex, "ShopInbox: load conversations failed");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectConversation(ShopInboxConversationItem conv)
    {
        _selectedConversationId = conv.ConversationId;
        _selectedTenantId = conv.SubjectId;
        _selectedPeerId = conv.CustomerId;
        // Fresh short-lived JWT per conversation — the panel authenticates as the shop side.
        _staffToken = await ApiClient.MintOwnerTokenAsync();

        // Notification Hub (2026-10-15): mở hội thoại → đánh dấu tin của khách đã đọc (fail-safe).
        if (conv.UnreadCount > 0)
        {
            int unread = conv.UnreadCount;
            try
            {
                await ApiClient.MarkConversationReadAsync(conv.ConversationId);
                conv.UnreadCount = 0;
                _totalUnread = Math.Max(0, _totalUnread - unread);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "ShopInbox: mark conversation read failed for {ConvId}", conv.ConversationId);
            }
        }
    }

    // ── AI-P11: "Đề xuất AI" → knowledge doc pending_review ──────────────────
    private RealtimeChatPanel.KnowledgeSuggestion? _suggestion;
    private string _suggestTitle = string.Empty;
    private bool _suggestBusy;
    private string? _notice;
    private string _noticeVariant = "success";

    private void HandleKnowledgeSuggest(RealtimeChatPanel.KnowledgeSuggestion s)
    {
        _suggestion = s;
        _suggestTitle = s.Question.Length <= 80 ? s.Question : s.Question[..80];
        _notice = null;
    }

    private void CloseSuggest()
    {
        if (!_suggestBusy) _suggestion = null;
    }

    private async Task ConfirmSuggestAsync()
    {
        var s = _suggestion;
        if (s is null || string.IsNullOrWhiteSpace(_suggestTitle)) return;
        _suggestBusy = true;
        try
        {
            // Nguyên văn cặp hỏi/đáp — không rewrite. classification="internal" placeholder:
            // owner chọn Public/Internal/Confidential lúc approve ở trang TenantAi Knowledge.
            var content = $"Khách hỏi:\n{s.Question}\n\nChủ quán đáp:\n{s.Answer}";
            var ok = await AiClient.IngestDocumentAsync(TenantProvider.TenantId, "faq",
                _suggestTitle.Trim(), content, "internal",
                sourceRef: $"chat:{s.ConversationId}:{s.MessageId}");
            if (ok)
            {
                _suggestion = null;
                _notice = "Đã gửi vào hàng chờ duyệt tri thức AI — vào trang Tri thức AI để duyệt.";
                _noticeVariant = "success";
            }
            else
            {
                _notice = "Gửi thất bại — dịch vụ AI có thể đang tạm nghỉ, thử lại sau.";
                _noticeVariant = "error";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ShopInbox: knowledge suggest failed");
            _notice = "Gửi thất bại — thử lại sau.";
            _noticeVariant = "error";
        }
        finally
        {
            _suggestBusy = false;
        }
    }
}
