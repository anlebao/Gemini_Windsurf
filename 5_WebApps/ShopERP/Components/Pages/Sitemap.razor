        </AuthorizeView>

    </div>
</div>

@code {
    private string _displayName = string.Empty;
    private string _roleName = string.Empty;
    private string _khachLinkUrl = string.Empty;
    private bool _isCompanyTenant; // VAS BCTC reports only show for Company (DN) tenants, not HKD

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _displayName = user.FindFirst("DisplayName")?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? "Người dùng";

        _roleName = user.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;

        // Masterchef: redirect to /kitchen — kitchen-only role, no sitemap access
        if (user.IsInRole(UserRole.Masterchef.ToString()))
        {
            NavigationManager.NavigateTo("/kitchen", forceLoad: true);
            return;
        }

        // Load KhachLink URL from configuration
        _khachLinkUrl = Configuration["ExternalUrls:KhachLink"] ?? string.Empty;

        // Load tenant BusinessType to decide whether to show VAS BCTC reports card.
        // HKD tenants use TT 152 HKD books (separate card); Company tenants use VAS BCTC reports.
        if (TenantProvider.HasTenant)
        {
            try
            {
                var tenant = await TenantManagementService.GetTenantByIdAsync(new TenantId(TenantProvider.TenantId));
                _isCompanyTenant = tenant?.BusinessType == BusinessType.Company;
            }
            catch (Exception)
            {
                // If tenant lookup fails, default to showing VAS reports (backward compatible)
                _isCompanyTenant = true;
            }
        }
    }

    private void Logout()
{
    // Server-side logout via /Logout endpoint (Pages/Logout.cshtml — SignOutAsync + redirect)
    NavigationManager.NavigateTo("/Logout", forceLoad: true);
}
}
