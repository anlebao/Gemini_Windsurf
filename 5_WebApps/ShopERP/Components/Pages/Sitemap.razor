                                    <span class="sitemap-link-icon">⚙️</span>
                                    <span>Quản Lý Provider</span>
                                </a>
                                <a href="/einvoice/configuration" class="sitemap-link" data-testid="link-einvoice-configuration">
                                    <span class="sitemap-link-icon">🔧</span>
                                    <span>Cấu Hình Provider</span>
                                </a>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </VanACard>
            </Authorized>
        </AuthorizeView>

        @* ── Luồng 4: Cổng Khách Hàng (KhachLink) ── *@
        <AuthorizeView Roles="Owner,StoreKeeper">
            <Authorized>
                <VanACard Header="🛍️ Cổng Khách Hàng" Hoverable="true" data-testid="card-khachlink">
                    <div class="sitemap-links">
                        <a href="@_khachLinkUrl" class="sitemap-link sitemap-link--external" target="_blank" rel="noopener noreferrer" data-testid="link-khachlink">
