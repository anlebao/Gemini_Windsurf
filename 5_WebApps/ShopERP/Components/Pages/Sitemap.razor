@page "/sitemap"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using VanAn.UI.Platform.Components
@using VanAn.CoreHub.Services
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@inject IThemeProvider ThemeProvider
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject ITenantManagementService TenantManagementService
@inject ITenantProvider TenantProvider

<PageTitle>Sitemap - Vạn An Ecosystem</PageTitle>

<div class="sitemap-page @ThemeProvider.CurrentTheme" data-testid="sitemap-page">
    <header class="sitemap-header">
        <h1 data-testid="sitemap-title">Vạn An Ecosystem</h1>
        <p class="sitemap-subtitle">Chào mừng, <strong>@_displayName</strong> (@_roleName)</p>
        <div class="sitemap-header-actions">
            <VanAButton
                Variant="secondary"
                Size="small"
                OnClick="Logout"
                data-testid="btn-logout">
                Đăng xuất
            </VanAButton>
        </div>
    </header>

    <div class="sitemap-grid" data-testid="sitemap-grid">

        @* ── Luồng 1: Quản lý Đơn Hàng ── *@
        <VanACard Header="📦 Quản lý Đơn Hàng" Hoverable="true" data-testid="card-orders">
            <div class="sitemap-links">
                <a href="/" class="sitemap-link" data-testid="link-orders-home">
                    <span class="sitemap-link-icon">🏠</span>
                    <span>Dashboard</span>
                </a>
                <AuthorizeView Roles="Staff,StoreKeeper,Owner,SystemAdmin">
                    <Authorized>
                        <a href="/orders" class="sitemap-link" data-testid="link-orders-list">
                            <span class="sitemap-link-icon">📋</span>
                            <span>Danh sách đơn hàng</span>
                        </a>
                        <a href="/pos" class="sitemap-link" data-testid="link-pos">
                            <span class="sitemap-link-icon">🛒</span>
                            <span>POS — Tạo đơn hàng</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="Staff,StoreKeeper,Owner,Masterchef,SystemAdmin">
                    <Authorized>
                        <a href="/kitchen" class="sitemap-link" data-testid="link-kitchen-display">
                            <span class="sitemap-link-icon">🍳</span>
                            <span>Màn hình bếp</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="Guard">
                    <Authorized>
                        <a href="/guard/scan" class="sitemap-link" data-testid="link-guard-scan">
                            <span class="sitemap-link-icon">📷</span>
                            <span>Quét QR Guard</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </VanACard>

        @* ── Product Management ── *@
        <AuthorizeView Roles="Owner">
            <Authorized>
                <VanACard Header="📦 Sản phẩm" Hoverable="true" data-testid="card-products">
                    <div class="sitemap-links">
                        <a href="/products" class="sitemap-link" data-testid="link-products">
                            <span class="sitemap-link-icon">📦</span>
                            <span>Quản lý sản phẩm</span>
                        </a>
                    </div>
                </VanACard>
            </Authorized>
        </AuthorizeView>

        @* ── Cấu hình & Thiết lập (Owner only) ── *@
        <AuthorizeView Roles="Owner">
            <Authorized>
                <VanACard Header="⚙️ Cấu hình & Thiết lập" Hoverable="true" data-testid="card-settings">
                    <div class="sitemap-links">
                        <a href="/settings/shop-features" class="sitemap-link" data-testid="link-shop-features">
                            <span class="sitemap-link-icon">🛠️</span>
                            <span>Cấu hình tính năng Shop</span>
                        </a>
                    </div>
                </VanACard>
            </Authorized>
        </AuthorizeView>

        @* ── Luồng 2: Kế Toán & Tài Chính ── *@
        <AuthorizeView Roles="Owner">
            <Authorized>
                <VanACard Header="💰 Kế Toán & Tài Chính" Hoverable="true" data-testid="card-accounting">
                    <div class="sitemap-links">
                        <a href="/accounting" class="sitemap-link" data-testid="link-accounting">
                            <span class="sitemap-link-icon">📒</span>
                            <span>Trang Kế Toán</span>
                        </a>
                        <a href="/accounting/expenses" class="sitemap-link" data-testid="link-accounting-expenses">
                            <span class="sitemap-link-icon">�</span>
                            <span>Nhập Chi Phí</span>
                        </a>
                        <a href="/accounting/revenue" class="sitemap-link" data-testid="link-accounting-revenue">
                            <span class="sitemap-link-icon">📈</span>
                            <span>Nhập Doanh Thu</span>
                        </a>
                        <a href="/accounting/history" class="sitemap-link" data-testid="link-accounting-history">
                            <span class="sitemap-link-icon">📜</span>
                            <span>Lịch Sử Giao Dịch</span>
                        </a>
                        <a href="/accounting/balance" class="sitemap-link" data-testid="link-accounting-balance">
                            <span class="sitemap-link-icon">💰</span>
                            <span>Số Dư Tài Khoản</span>
                        </a>
                        <a href="/accounting/period-closing" class="sitemap-link" data-testid="link-period-closing">
                            <span class="sitemap-link-icon">📅</span>
                            <span>Đóng Kỳ Kế Toán</span>
                        </a>
                        <a href="/accounting/hkd-books" class="sitemap-link" data-testid="link-hkd-books">
                            <span class="sitemap-link-icon">📚</span>
                            <span>Sổ HKD (TT 152)</span>
                        </a>
                    </div>
                </VanACard>
            </Authorized>
        </AuthorizeView>

        @* ── Luồng 2b: BCTC VAS (Company tenants only — HKD uses TT 152 HKD books) ── *@
        <AuthorizeView Roles="Owner">
            <Authorized>
                @if (_isCompanyTenant)
                {
                <VanACard Header="📊 Báo Cáo Tài Chính (VAS)" Hoverable="true" data-testid="card-vas-reports">
                    <div class="sitemap-links">
                        <a href="/accounting/financial-reports" class="sitemap-link" data-testid="link-financial-reports">
                            <span class="sitemap-link-icon">📊</span>
                            <span>Tổng Hợp BCTC</span>
                        </a>
                        <a href="/accounting/balance-sheet" class="sitemap-link" data-testid="link-balance-sheet">
                            <span class="sitemap-link-icon">📋</span>
                            <span>Báo Cáo Tình Hình Tài Chính (B 01-DN)</span>
                        </a>
                        <a href="/accounting/income-statement" class="sitemap-link" data-testid="link-income-statement">
                            <span class="sitemap-link-icon">📉</span>
                            <span>Báo Cáo Kết Quả HĐ (B02-DN)</span>
                        </a>
                        <a href="/accounting/cash-flow-statement" class="sitemap-link" data-testid="link-cash-flow">
                            <span class="sitemap-link-icon">💵</span>
                            <span>Báo Cáo Lưu Chuyển Tiền (B03-DN)</span>
                        </a>
                        <a href="/accounting/trial-balance" class="sitemap-link" data-testid="link-trial-balance">
