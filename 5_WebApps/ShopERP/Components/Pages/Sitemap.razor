                        <a href="/admin/customers" class="sitemap-link" data-testid="link-customers-owner">
                            <span class="sitemap-link-icon">👥</span>
                            <span>Danh sách khách hàng + Lọc segment</span>
                        </a>
                        <a href="/admin/promo-campaigns" class="sitemap-link" data-testid="link-promo-campaigns-owner">
                            <span class="sitemap-link-icon">📢</span>
                            <span>Chiến dịch khuyến mãi (Push)</span>
                        </a>
                        <a href="/admin/missions" class="sitemap-link" data-testid="link-missions-owner">
                            <span class="sitemap-link-icon">🏆</span>
                            <span>Quản lý Nhiệm vụ (Gamification)</span>
                        </a>
                        <a href="/admin/redemption-catalog" class="sitemap-link" data-testid="link-redemption-catalog-owner">
                            <span class="sitemap-link-icon">🎁</span>
                            <span>Catalog đổi điểm</span>
                        </a>
                        <a href="/admin/redemption-history" class="sitemap-link" data-testid="link-redemption-history-owner">
                            <span class="sitemap-link-icon">📋</span>
                            <span>Lịch sử đổi điểm + Fulfillment</span>
                        </a>
                    </div>
                </VanACard>
            </Authorized>
        </AuthorizeView>

        @* ── Luồng 3: Hóa Đơn Điện Tử (Owner + StoreKeeper + SystemAdmin) ── *@
