                    </div>
                </VanACard>
                <VanACard Header="� Đổi điểm (Redemption)" Hoverable="true" data-testid="card-redemption">
                    <div class="sitemap-links">
                        <a href="/admin/redemption-catalog" class="sitemap-link" data-testid="link-redemption-catalog">
                            <span class="sitemap-link-icon">🎁</span>
                            <span>Catalog đổi điểm</span>
                        </a>
                        <a href="/admin/redemption-history" class="sitemap-link" data-testid="link-redemption-history">
                            <span class="sitemap-link-icon">📋</span>
                            <span>Lịch sử đổi điểm + Fulfillment</span>
                        </a>
                        <a href="/admin/missions" class="sitemap-link" data-testid="link-missions-admin">
                            <span class="sitemap-link-icon">🏆</span>
                            <span>Quản lý Nhiệm vụ (Gamification)</span>
                        </a>
                    </div>
                </VanACard>
                @* WS-3: CRM + Promo Campaigns card *@
                <VanACard Header="👥 CRM & Khách Hàng" Hoverable="true" data-testid="card-crm">
                    <div class="sitemap-links">
                        <a href="/admin/customers" class="sitemap-link" data-testid="link-customers">
                            <span class="sitemap-link-icon">👥</span>
                            <span>Danh sách khách hàng + Lọc segment</span>
                        </a>
                        <a href="/admin/promo-campaigns" class="sitemap-link" data-testid="link-promo-campaigns">
                            <span class="sitemap-link-icon">📢</span>
                            <span>Chiến dịch khuyến mãi (Push)</span>
