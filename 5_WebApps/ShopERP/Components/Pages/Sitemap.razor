                            <span>Mở KhachLink PWA</span>
                            <span class="sitemap-link-badge">Trang mới</span>
                        </a>
                    </div>
                </VanACard>
            </Authorized>
        </AuthorizeView>

        @* ── Quản trị Hệ Thống (SystemAdmin only) ── *@
        <AuthorizeView Roles="SystemAdmin">
            <Authorized>
                <VanACard Header="⚙️ Quản Trị Hệ Thống" Hoverable="true" data-testid="card-admin">
                    <div class="sitemap-links">
                        <a href="/admin/users" class="sitemap-link" data-testid="link-admin-users">
