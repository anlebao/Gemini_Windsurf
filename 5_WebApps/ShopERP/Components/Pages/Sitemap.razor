                    <div class="sitemap-links">
                        <a href="/einvoice" class="sitemap-link" data-testid="link-einvoice-dashboard">
                            <span class="sitemap-link-icon">📊</span>
                            <span>Dashboard Hóa Đơn</span>
                        </a>
                        <a href="/einvoice/invoices" class="sitemap-link" data-testid="link-einvoice-list">
                            <span class="sitemap-link-icon">🧾</span>
                            <span>Quản Lý Hóa Đơn</span>
                        </a>
                        <a href="/einvoice/alerts" class="sitemap-link" data-testid="link-einvoice-alerts">
                            <span class="sitemap-link-icon">🔔</span>
