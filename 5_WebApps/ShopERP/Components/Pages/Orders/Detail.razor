@page "/orders/{OrderId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<Detail> Logger
@inject NavigationManager NavigationManager
@inject IThemeProvider ThemeProvider

<div class="order-detail-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Chi tiết đơn hàng</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="GoBack">
                ← Quay lại
            </VanAButton>
            <VanAButton Variant="secondary" Size="small" OnClick="ReloadOrder">
                🔄 Refresh
            </VanAButton>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }

    @if (loading)
    {
        <VanACard Header="Đang tải">
            <p>Đang tải thông tin đơn hàng...</p>
        </VanACard>
    }
    else if (order == null)
    {
        <VanACard Header="Không tìm thấy">
            <p>Đơn hàng không tồn tại hoặc bạn không có quyền xem.</p>
        </VanACard>
    }
    else
    {
        <VanACard Header="Thông tin đơn hàng">
            <div class="order-info-grid">
                <div><strong>Mã đơn:</strong> @(order.TrackingCode ?? order.Id.ToString()[..8])</div>
                <div><strong>Thời gian:</strong> @order.OrderDate.ToString("HH:mm dd/MM/yyyy")</div>
                <div><strong>Trạng thái:</strong> <span class="status-badge status-@order.Status?.Value">@TranslateStatus(order.Status?.Value)</span></div>
                <div><strong>Thanh toán:</strong> <span class="payment-badge">@order.PaymentStatus</span></div>
                <div><strong>Tổng tiền:</strong> @order.TotalAmount.ToString("N0") đ</div>
                <div><strong>Phương thức:</strong> @order.PaymentMethod</div>
            </div>

            @if (order.Status?.Value == "pending")
            {
                <div class="action-row">
                    <VanAButton Variant="primary" OnClick="ConfirmOrder" data-testid="btn-confirm-detail">
                        ✓ Xác nhận đơn hàng
                    </VanAButton>
                </div>
            }

            @* W3-T1: Admin "Xác nhận đã nhận tiền" — visible only when PaymentStatus=Pending *@
            @if (order.PaymentStatus == "Pending")
            {
                <div class="action-row">
                    <VanAButton Variant="primary" OnClick="ConfirmPayment" data-testid="btn-confirm-payment">
                        💰 Xác nhận đã nhận tiền
                    </VanAButton>
                </div>
            }
        </VanACard>

        <VanACard Header="Timeline trạng thái">
            <div class="timeline">
                @foreach (var step in statusTimeline)
                {
                    <div class="timeline-step @(step.IsCompleted ? "completed" : "")">
                        <span class="timeline-dot"></span>
                        <span class="timeline-label">@step.DisplayName</span>
                    </div>
                }
            </div>
        </VanACard>

        <VanACard Header="Sản phẩm trong đơn">
            <VanAnDataGrid TItem="OrderItemDto" Items="@order.Items" EmptyMessage="Không có sản phẩm">
                <Columns>
                    <VanAnColumn TItem="OrderItemDto" Title="Sản phẩm" Width="5">
                        <Template Context="i">@i.ProductName</Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderItemDto" Title="SL" Width="1">
                        <Template Context="i">@i.Quantity</Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderItemDto" Title="Đơn giá" Width="2">
                        <Template Context="i">@i.UnitPrice.ToString("N0") đ</Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderItemDto" Title="Thành tiền" Width="2">
                        <Template Context="i">@i.TotalAmount.ToString("N0") đ</Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderItemDto" Title="Bếp" Width="2">
                        <Template Context="i">@i.KitchenStatus</Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>
    }
</div>

@code {
    [Parameter] public Guid OrderId { get; set; }

    private OrderDetailDto? order;
    private bool loading = true;
    private string? errorMessage;
    private HubConnection? _hubConnection;
    private List<TrackingStep> statusTimeline = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadOrder();
        await StartSignalRConnection();
    }

    private void GoBack() => NavigationManager.NavigateTo("/orders");

    private async Task ReloadOrder()
    {
        loading = true;
        errorMessage = null;
        try
        {
            var httpClient = HttpClientFactory.CreateClient("gateway");
            var response = await httpClient.GetAsync($"api/orders/{OrderId}");

            if (response.IsSuccessStatusCode)
            {
                order = await response.Content.ReadFromJsonAsync<OrderDetailDto>();
                BuildStatusTimeline();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                order = null;
            }
            else
            {
                errorMessage = $"Lỗi tải đơn hàng: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading order {OrderId}", OrderId);
            errorMessage = $"Không thể kết nối: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ConfirmOrder()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("gateway");
            var response = await httpClient.PutAsJsonAsync(
                $"api/orders/{OrderId}/status",
                new { Status = "confirmed" });

            if (response.IsSuccessStatusCode)
            {
                await ReloadOrder();
            }
            else
            {
                errorMessage = $"Không thể xác nhận đơn: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error confirming order {OrderId}", OrderId);
            errorMessage = $"Lỗi: {ex.Message}";
        }
    }

    /// <summary>
    /// W3-T1: Admin manually confirms payment received.
    /// Calls POST api/webhooks/payment with auto-generated TransactionId.
    /// After confirm → OrderService.ConfirmPaymentAsync → accounting entries + PaymentConfirmed broadcast.
    /// </summary>
    private async Task ConfirmPayment()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("gateway");
            var request = new
            {
                OrderId = OrderId,
                TenantId = order?.TenantId?.Value ?? Guid.Empty,
                TransactionId = $"MANUAL_{OrderId}_{DateTime.UtcNow:yyyyMMddHHmmss}"
            };

            var response = await httpClient.PostAsJsonAsync("api/webhooks/payment", request);

            if (response.IsSuccessStatusCode)
            {
                await ReloadOrder();
            }
            else
            {
                errorMessage = $"Không thể xác nhận thanh toán: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error confirming payment for order {OrderId}", OrderId);
            errorMessage = $"Lỗi: {ex.Message}";
        }
    }

    private void BuildStatusTimeline()
    {
        if (order?.Status?.Value == null) return;

        var allSteps = new[]
        {
            new { Id = "pending",    DisplayName = "Chờ xác nhận",  Seq = 1 },
            new { Id = "confirmed",  DisplayName = "Đã xác nhận",   Seq = 2 },
            new { Id = "preparing",  DisplayName = "Đang làm",      Seq = 3 },
            new { Id = "ready",      DisplayName = "Sẵn sàng",       Seq = 4 },
            new { Id = "completed",  DisplayName = "Hoàn thành",     Seq = 5 },
        };

        string currentStatus = order.Status.Value;
        int currentSeq = allSteps.FirstOrDefault(s => s.Id == currentStatus)?.Seq ?? 1;

        statusTimeline = allSteps.Select(s => new TrackingStep
        {
            Id = s.Id,
            DisplayName = s.DisplayName,
            IsCompleted = s.Seq <= currentSeq
        }).ToList();
    }

    private async Task StartSignalRConnection()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/orderHub"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<Guid, Guid, string, string>("OrderStatusChanged",
                async (orderId, tenantId, oldStatus, newStatus) =>
                {
                    if (orderId == OrderId)
                    {
                        await InvokeAsync(async () => await ReloadOrder());
                    }
                });

            _hubConnection.On<Guid, Guid, string>("PaymentConfirmed",
                async (orderId, tenantId, transactionId) =>
                {
                    if (orderId == OrderId)
                    {
                        await InvokeAsync(async () => await ReloadOrder());
                    }
                });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SignalR connection failed — detail will not auto-refresh");
        }
    }

    private static string TranslateStatus(string? status) => status switch
    {
        "pending" => "Chờ xác nhận",
        "confirmed" => "Đã xác nhận",
        "preparing" => "Đang làm",
        "ready" => "Sẵn sàng",
        "completed" => "Hoàn thành",
        "cancelled" => "Đã hủy",
        _ => status ?? ""
    };

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private class TrackingStep
    {
        public string Id { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public bool IsCompleted { get; set; }
    }

    // DTOs matching Order API response
    private class OrderDetailDto
    {
        public Guid Id { get; set; }
        public string? TrackingCode { get; set; }
        public DateTime OrderDate { get; set; }
        public OrderStatusDto? Status { get; set; }
        public string? PaymentStatus { get; set; }
        public string? PaymentMethod { get; set; }
        public decimal TotalAmount { get; set; }
        public List<OrderItemDto> Items { get; set; } = new();
        // W3-T1: TenantId needed for payment confirm request
        public TenantIdDto? TenantId { get; set; }
    }

    private class OrderStatusDto
    {
        public string Value { get; set; } = "";
    }

    private class TenantIdDto
    {
        public Guid Value { get; set; }
    }

    private class OrderItemDto
    {
        public Guid Id { get; set; }
        public string ProductName { get; set; } = "";
        public int Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TotalAmount { get; set; }
        public string KitchenStatus { get; set; } = "";
    }
}
