@page "/orders/{OrderId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "StaffOrAbove")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.UI.Platform.Models
@using VanAn.UI.Platform.Tokens
@using VanAn.Shared.Domain
@using VanAn.Shared.Services
@using VanAn.CoreHub.Services
@inject IOrderWorkflowService OrderWorkflowService
@inject IOrderService OrderService
@inject IOrderFlowService FlowResolver
@inject VanAn.CoreHub.Infrastructure.IVanAnDbContext DbContext
@inject ILogger<Detail> Logger
@inject NavigationManager NavigationManager
@inject IThemeProvider ThemeProvider
@inject IShopFeatureSettingsService FeatureSettings
@inject IJSRuntime JSRuntime

<div class="order-detail-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Chi tiết đơn hàng</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="GoBack">
                ← Quay lại
            </VanAButton>
            <VanAButton Variant="secondary" Size="small" OnClick="ReloadOrder">
                🔄 Refresh
            </VanAButton>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Variant="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }

    @if (loading)
    {
        <VanACard Header="Đang tải">
            <p>Đang tải thông tin đơn hàng...</p>
        </VanACard>
    }
    else if (order == null)
    {
        <VanACard Header="Không tìm thấy">
            <p>Đơn hàng không tồn tại hoặc bạn không có quyền xem.</p>
        </VanACard>
    }
    else
    {
        <VanACard Header="Thông tin đơn hàng">
            @* Issue #195 (1.1/1.2): nhóm thông tin theo chủ đề — đơn / khách hàng / thanh toán *@
            <div class="detail-groups">
                <div class="info-group">
                    <div class="info-group__title">Đơn hàng</div>
                    <div class="info-row"><span class="info-label">Mã đơn</span><span>@(order.TrackingCode ?? order.Id.ToString()[..8])</span></div>
                    <div class="info-row"><span class="info-label">Thời gian</span><span>@order.OrderDate.ToVietnamTimeString()</span></div>
                    <div class="info-row"><span class="info-label">Trạng thái</span><span><OrderStatusBadge Status="@order.Status?.Value" /></span></div>
                    <div class="info-row"><span class="info-label">Loại đơn</span><span>@TranslateOrderType(order.OrderType)</span></div>
                    <div class="info-row"><span class="info-label">Nguồn</span><span>@TranslateSourceType(order.SourceType)</span></div>
                </div>
                <div class="info-group">
                    <div class="info-group__title">Khách hàng</div>
                    <div class="info-row"><span class="info-label">Tên</span><span>@(string.IsNullOrWhiteSpace(order.CustomerName) ? "—" : order.CustomerName)</span></div>
                    <div class="info-row"><span class="info-label">SĐT</span><span>@(string.IsNullOrWhiteSpace(order.CustomerPhone) ? "—" : order.CustomerPhone)</span></div>
                    @if (!string.IsNullOrWhiteSpace(order.CustomerNotes))
                    {
                        <div class="info-row"><span class="info-label">Ghi chú</span><span>@order.CustomerNotes</span></div>
                    }
                </div>
                <div class="info-group">
                    <div class="info-group__title">Thanh toán</div>
                    <div class="info-row"><span class="info-label">Tổng tiền</span><span class="amount">@order.TotalAmount.ToString("N0") đ</span></div>
                    @* Issue #195 follow-up (2026-10-29): booking có cọc — hiển thị số còn lại cần thu *@
                    @if (order.SourceType == "booking" && order.DepositPaidAmount > 0)
                    {
                        <div class="info-row"><span class="info-label">Đã thu cọc</span><span>@order.DepositPaidAmount.ToString("N0") đ</span></div>
                        <div class="info-row"><span class="info-label">Còn lại cần thu</span><span class="amount">@((order.TotalAmount - order.DepositPaidAmount).ToString("N0")) đ</span></div>
                    }
                    <div class="info-row"><span class="info-label">Phương thức</span><span>@(order.PaymentMethod ?? "—")</span></div>
                    <div class="info-row"><span class="info-label">Trạng thái</span><span class="payment-badge">@order.PaymentStatus</span></div>
                </div>
            </div>

            @* Issue #195: action buttons driven by resolved flow — trạng thái tiếp theo hợp lệ *@
            @if (actionSteps.Count > 0)
            {
                <div class="action-row" data-testid="flow-actions">
                    @foreach (var step in actionSteps)
                    {
                        <VanAButton Variant="@VariantFor(step.Code)" OnClick="@(() => TransitionOrderStatus(step.Code))" data-testid="@TestIdFor(step.Code)">
                            @IconFor(step.Code) @step.DisplayName
                        </VanAButton>
                    }
                </div>
            }

            @* W3-T1: Admin "Đã thanh toán" — visible only when PaymentStatus=Pending *@
            @if (order.PaymentStatus == "Pending")
            {
                <div class="action-row">
                    <VanAButton Variant="primary" OnClick="ConfirmPayment" data-testid="btn-confirm-payment">
                        💰 Đã thanh toán
                    </VanAButton>
                </div>
            }

            @* W3-T4: TTS "Đọc ghi chú" button — when order has voice note + Voice_Note_Enabled ON *@
            @if (voiceNoteEnabled && !string.IsNullOrEmpty(order.VoiceNoteText) && order.Status?.Value == "confirmed")
            {
                <div class="action-row">
                    <VanAButton Variant="secondary" OnClick="ReadVoiceNote" data-testid="btn-read-note">
                        🔊 Đọc ghi chú
                    </VanAButton>
                </div>
            }
        </VanACard>

        <VanACard Header="@($"Tiến trình đơn hàng{(flowResolution?.Source == "database" ? $" — {flowResolution.ProfileName}" : "")}")">
            @* Issue #195 (1.2): timeline driven by resolved flow + OrderStatusHistory timestamps.
               done = đã đi qua (có history); current = trạng thái hiện tại; next = bước có thể tới. *@
            <div class="timeline" data-testid="status-timeline">
                @foreach (var step in timelineSteps)
                {
                    <div class="timeline-step @step.StateClass" data-testid="timeline-step-@step.Code">
                        <span class="timeline-dot"></span>
                        <span class="timeline-label">@step.DisplayName</span>
                        @if (step.ReachedAt.HasValue)
                        {
                            <span class="timeline-time">@step.ReachedAt.Value.ToVietnamTimeString()</span>
                        }
                        @if (step.IsNext)
                        {
                            <span class="timeline-next-hint">tiếp theo</span>
                        }
                    </div>
                }
            </div>
            @if (nextSteps.Count > 0)
            {
                <div class="next-steps" data-testid="next-statuses">
                    <span class="next-steps__label">Trạng thái tiếp theo:</span>
                    @foreach (var s in nextSteps)
                    {
                        <span class="next-chip">@s.DisplayName</span>
                    }
                </div>
            }
        </VanACard>

        <VanACard Header="Sản phẩm trong đơn">
            <VanAnDataGrid TItem="OrderItemDto" Items="@order.Items" EmptyMessage="Không có sản phẩm">
                <Columns>
                    <VanAnColumn TItem="OrderItemDto" Title="Sản phẩm" Width="5">
                        <Template Context="i">@i.ProductName</Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderItemDto" Title="SL" Width="1">
                        <Template Context="i">@i.Quantity</Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderItemDto" Title="Đơn giá" Width="2">
                        <Template Context="i">@i.UnitPrice.ToString("N0") đ</Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderItemDto" Title="Thành tiền" Width="2">
                        <Template Context="i">@i.TotalAmount.ToString("N0") đ</Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderItemDto" Title="Bếp" Width="2">
                        <Template Context="i">@i.KitchenStatus</Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>
    }
</div>

@code {
    [Parameter] public Guid OrderId { get; set; }

    private OrderDetailDto? order;
    private bool loading = true;
    private string? errorMessage;
    private HubConnection? _hubConnection;
    // Issue #195: resolved flow + status history + derived UI state
    private OrderFlowResolution? flowResolution;
    private List<VanAn.Shared.Domain.OrderStatusHistory> statusHistory = new();
    private List<TimelineStep> timelineSteps = new();
    private List<OrderFlowStepDto> nextSteps = new();
    private List<OrderFlowStepDto> actionSteps = new();
    // W1-T4: Kitchen toggle — controls visibility of kitchen transition buttons
    private bool kitchenEnabled = true;
    // W3-T6: Voice note toggle — sub-toggle for TTS (when voice OFF, TTS also OFF)
    private bool voiceNoteEnabled = false;

    protected override async Task OnInitializedAsync()
    {
        await ReloadOrder();
        // W1-T4: Load kitchen toggle after order is available (need tenantId)
        if (order?.TenantId != null && order.TenantId != Guid.Empty)
        {
            try
            {
                kitchenEnabled = await FeatureSettings.IsEnabledAsync(
                    order.TenantId.Value,
                    nameof(ShopFeatureSettingsDto.Kitchen_Workflow_Enabled));
                // W3-T6: Load voice note toggle (sub-toggle for TTS)
                voiceNoteEnabled = await FeatureSettings.IsEnabledAsync(
                    order.TenantId.Value,
                    nameof(ShopFeatureSettingsDto.Voice_Note_Enabled));
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load kitchen toggle — defaulting to ON");
                kitchenEnabled = true;
            }
        }
        BuildFlowState();
        await StartSignalRConnection();
    }

    private void GoBack() => NavigationManager.NavigateTo("/orders");

    // R2-0e: Refactored from HTTP to direct service injection (D2 fix — Edge offline-first).
    private async Task ReloadOrder()
    {
        loading = true;
        errorMessage = null;
        try
        {
            Order? domainOrder = await OrderWorkflowService.GetOrderAsync(OrderId);
            if (domainOrder == null)
            {
                order = null;
            }
            else
            {
                order = MapToDto(domainOrder);
                await LoadFlowAndHistoryAsync(domainOrder);
                BuildFlowState();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading order {OrderId}", OrderId);
            errorMessage = $"Không thể tải đơn hàng: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>Issue #195: load resolved flow + status history for the loaded order.</summary>
    private async Task LoadFlowAndHistoryAsync(Order domainOrder)
    {
        try
        {
            flowResolution = await FlowResolver.ResolveFlowAsync(domainOrder.TenantId.Value, domainOrder.SourceType);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "OrderFlow resolve failed for order {OrderId} — builtin default", OrderId);
            flowResolution = OrderFlowService.BuildBuiltin(domainOrder.SourceType);
        }

        try
        {
            statusHistory = await DbContext.OrderStatusHistories
                .Where(h => h.OrderId == OrderId)
                .OrderBy(h => h.CreatedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load status history for order {OrderId}", OrderId);
            statusHistory = new();
        }
    }

    /// <summary>
    /// Issue #195 (1.2): build timeline + next/action steps from resolved flow.
    /// Builtin flow cho đơn thường khi kitchen toggle OFF → ẩn bước bếp (giữ semantics W1-T5).
    /// </summary>
    private void BuildFlowState()
    {
        timelineSteps = new();
        nextSteps = new();
        actionSteps = new();
        if (order?.Status?.Value == null || flowResolution == null) return;

        string current = order.Status.Value;
        bool isBooking = order.SourceType == "booking";
        // Kitchen OFF + builtin (không có DB profile) cho đơn thường → ẩn bước bếp khỏi UI.
        bool hideKitchenSteps = !isBooking && !kitchenEnabled && flowResolution.Source == "builtin";

        var nextCodes = flowResolution.NextOf(current).ToList();
        if (hideKitchenSteps)
        {
            nextCodes = nextCodes.Where(c => c is not ("preparing" or "ready")).ToList();
        }

        var reachedAt = statusHistory
            .GroupBy(h => h.ToStatus)
            .ToDictionary(g => g.Key, g => g.Max(h => h.CreatedAt));

        timelineSteps = flowResolution.Steps
            .Where(s => !hideKitchenSteps || s.Code is not ("preparing" or "ready"))
            .OrderBy(s => s.SortOrder)
            .Select(s =>
            {
                bool isCurrent = s.Code == current;
                bool done = reachedAt.ContainsKey(s.Code) && !isCurrent;
                bool isNext = nextCodes.Contains(s.Code);
                return new TimelineStep
                {
                    Code = s.Code,
                    DisplayName = s.DisplayName,
                    IsCurrent = isCurrent,
                    IsNext = isNext,
                    ReachedAt = reachedAt.TryGetValue(s.Code, out DateTime t) ? t : null,
                    StateClass = isCurrent ? "current" : done ? "completed" : isNext ? "next" : ""
                };
            })
            .ToList();

        // Nếu status hiện tại không nằm trong flow (đơn cũ/edge case) — chèn node hiện tại.
        if (timelineSteps.All(s => s.Code != current))
        {
            timelineSteps.Add(new TimelineStep
            {
                Code = current,
                DisplayName = current,
                IsCurrent = true,
                ReachedAt = reachedAt.TryGetValue(current, out DateTime t) ? t : null,
                StateClass = "current"
            });
        }

        nextSteps = nextCodes
            .Select(c => flowResolution.GetStep(c) ?? new OrderFlowStepDto(c, c, 999, false, new()))
            .ToList();
        actionSteps = nextSteps;
    }

    private static string VariantFor(string code) => code switch
    {
        "completed" => "success",
        "cancelled" => "error",
        _ => "primary"
    };

    private static string IconFor(string code) => code switch
    {
        "confirmed" => "✓",
        "preparing" => "⏳",
        "ready" => "✅",
        "delivering" => "🚚",
        "delivered" => "📦",
        "completed" => "✔️",
        "cancelled" => "✕",
        _ => "→"
    };

    // Giữ testid cũ cho các action đã có E2E; code mới → btn-flow-{code}.
    private static string TestIdFor(string code) => code switch
    {
        "confirmed" => "btn-confirm-detail",
        "preparing" => "btn-start-preparing",
        "ready" => "btn-mark-ready",
        "completed" => "btn-complete",
        "cancelled" => "btn-cancel-order",
        _ => $"btn-flow-{code}"
    };

    private static string TranslateSourceType(string? sourceType) => sourceType switch
    {
        "pos" => "POS (tại quầy)",
        "checkout" => "Online (checkout)",
        "booking" => "Đặt lịch",
        _ => "—"
    };

    private static string TranslateOrderType(string? orderType) => orderType switch
    {
        "DINEIN" or "DineIn" => "Tại chỗ",
        "DELIVERY" or "Delivery" => "Giao hàng",
        "TAKEAWAY" or "Takeaway" => "Mang đi",
        null or "" => "—",
        _ => orderType
    };

    /// <summary>
    /// W3-T1: Admin manually confirms payment received.
    /// R2-0e: Refactored from HTTP webhook to direct IOrderService.ConfirmPaymentAsync.
    /// After confirm → accounting entries + PaymentConfirmed broadcast.
    /// </summary>
    private async Task ConfirmPayment()
    {
        try
        {
            Guid tenantId = order?.TenantId ?? Guid.Empty;
            string transactionId = $"MANUAL_{OrderId}_{DateTime.UtcNow:yyyyMMddHHmmss}";
            await OrderService.ConfirmPaymentAsync(OrderId, tenantId, transactionId);
            await ReloadOrder();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error confirming payment for order {OrderId}", OrderId);
            errorMessage = $"Lỗi: {ex.Message}";
        }
    }

    /// <summary>
    /// W3-T4: TTS — read voice note text via Web Speech API (speechSynthesis).
    /// Called when chef clicks "Đọc ghi chú" button. Sub-toggle: only available when Voice_Note_Enabled = ON.
    /// </summary>
    private async Task ReadVoiceNote()
    {
        if (order?.VoiceNoteText == null) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("ttsReader.speak", order.VoiceNoteText, "vi-VN");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "TTS playback failed for order {OrderId}", OrderId);
        }
    }

    /// <summary>
    /// Issue #195: transition theo flow — mọi action button đi qua OrderWorkflowService
    /// (validation theo profile + OrderStatusHistory + Outbox sync).
    /// </summary>
    private async Task TransitionOrderStatus(string newStatus)
    {
        try
        {
            Order? result = await OrderWorkflowService.TransitionStatusAsync(
                OrderId,
                new OrderStatusId(newStatus),
                reason: null);

            if (result == null)
            {
                errorMessage = $"Không thể chuyển trạng thái sang '{newStatus}' — chuyển đổi không hợp lệ hoặc đơn hàng không tồn tại.";
            }
            else
            {
                await ReloadOrder();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error transitioning order {OrderId} to {Status}", OrderId, newStatus);
            errorMessage = $"Lỗi: {ex.Message}";
        }
    }

    // R2-0e: Map domain Order entity to page DTO (replaces HTTP JSON deserialization).
    // Issue #195 (1.1): map CustomerInfo + SourceType + OrderType cho layout mới.
    private OrderDetailDto MapToDto(Order domainOrder)
    {
        return new OrderDetailDto
        {
            Id = domainOrder.Id,
            TrackingCode = domainOrder.TrackingCode,
            OrderDate = domainOrder.OrderDate,
            Status = new OrderStatusDto { Value = domainOrder.Status?.Value ?? "" },
            PaymentStatus = domainOrder.PaymentStatus,
            PaymentMethod = domainOrder.PaymentMethod,
            TotalAmount = domainOrder.TotalAmount,
            TenantId = domainOrder.TenantId?.Value,
            VoiceNoteText = domainOrder.VoiceNoteText,
            CustomerName = domainOrder.CustomerInfo?.FullName,
            CustomerPhone = domainOrder.CustomerInfo?.PhoneNumber,
            CustomerNotes = domainOrder.CustomerNotes,
            SourceType = domainOrder.SourceType,
            DepositPaidAmount = domainOrder.DepositPaidAmount,
            OrderType = domainOrder.OrderType,
            Items = domainOrder.Items?.Select(i => new OrderItemDto
            {
                Id = i.Id,
                ProductName = i.ProductName,
                Quantity = i.Quantity,
                UnitPrice = i.UnitPrice,
                TotalAmount = i.TotalAmount,
                KitchenStatus = i.KitchenStatus.ToString()
            }).ToList() ?? new()
        };
    }

    private async Task StartSignalRConnection()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/orderHub"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<Guid, Guid, string, string>("OrderStatusChanged",
                async (orderId, tenantId, oldStatus, newStatus) =>
                {
                    if (orderId == OrderId)
                    {
                        await InvokeAsync(async () => await ReloadOrder());
                    }
                });

            _hubConnection.On<Guid, Guid, string>("PaymentConfirmed",
                async (orderId, tenantId, transactionId) =>
                {
                    if (orderId == OrderId)
                    {
                        await InvokeAsync(async () => await ReloadOrder());
                    }
                });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SignalR connection failed — retrying with backoff");
            // E15: exponential-backoff retry loop (10s→…→max 120s).
            _ = Task.Run(async () =>
            {
                var delayMs = 10_000;
                while (_hubConnection is { State: HubConnectionState.Disconnected })
                {
                    await Task.Delay(delayMs);
                    try
                    {
                        await _hubConnection.StartAsync();
                        Logger.LogInformation("SignalR reconnected after {Delay}s backoff", delayMs / 1000);
                        break;
                    }
                    catch (ObjectDisposedException) { break; }
                    catch (Exception retryEx)
                    {
                        Logger.LogWarning(retryEx, "SignalR retry failed — next attempt in {Delay}s", delayMs / 1000);
                        delayMs = Math.Min(delayMs * 2, 120_000);
                    }
                }
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    // Issue #195: timeline node — done/current/next + timestamp từ OrderStatusHistory.
    private class TimelineStep
    {
        public string Code { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public bool IsCurrent { get; set; }
        public bool IsNext { get; set; }
        public DateTime? ReachedAt { get; set; }
        public string StateClass { get; set; } = "";
    }

    // R2-0e: DTOs — now populated from domain Order entity via MapToDto (replaces HTTP JSON deserialization).
    private class OrderDetailDto
    {
        public Guid Id { get; set; }
        public string? TrackingCode { get; set; }
        public DateTime OrderDate { get; set; }
        public OrderStatusDto? Status { get; set; }
        public string? PaymentStatus { get; set; }
        public string? PaymentMethod { get; set; }
        public decimal TotalAmount { get; set; }
        public List<OrderItemDto> Items { get; set; } = new();
        // W3-T1: TenantId needed for payment confirm request
        public Guid? TenantId { get; set; }
        // W3-T4: Voice note text for TTS playback at kitchen
        public string? VoiceNoteText { get; set; }
        // Issue #195 (1.1): khách hàng + nguồn đơn
        public string? CustomerName { get; set; }
        public string? CustomerPhone { get; set; }
        public string? CustomerNotes { get; set; }
        public string? SourceType { get; set; }
        public decimal DepositPaidAmount { get; set; }
        public string? OrderType { get; set; }
    }

    private class OrderStatusDto
    {
        public string Value { get; set; } = "";
    }

    private class OrderItemDto
    {
        public Guid Id { get; set; }
        public string ProductName { get; set; } = "";
        public int Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TotalAmount { get; set; }
        public string KitchenStatus { get; set; } = "";
    }
}

<style>
    /* Issue #195 (1.2): grouped info layout + flow timeline styles.
       Note: .timeline/.action-row/.payment-badge had no prior style definitions —
       base styles included here so the timeline renders as an actual step bar. */
    .action-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .payment-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 10px;
        font-size: 0.8rem;
        background: var(--va-color-bg-subtle, #e9ecef);
    }

    .timeline {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 0;
    }

    .timeline-step {
        display: flex;
        align-items: center;
        flex: 1 0 auto;
        min-width: 0;
    }

    .timeline-step:not(:last-child)::after {
        content: "";
        flex: 1 1 24px;
        height: 2px;
        background: var(--va-color-border, #dee2e6);
        margin: 0 8px;
        min-width: 16px;
    }

    .timeline-step.completed:not(:last-child)::after,
    .timeline-step.current:not(:last-child)::after {
        background: var(--va-color-primary, #0d6efd);
    }

    .timeline-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid var(--va-color-border, #adb5bd);
        background: #fff;
        flex-shrink: 0;
    }

    .timeline-step.completed .timeline-dot {
        background: var(--va-color-success, #198754);
        border-color: var(--va-color-success, #198754);
    }

    .timeline-step.current .timeline-dot {
        background: var(--va-color-primary, #0d6efd);
        border-color: var(--va-color-primary, #0d6efd);
