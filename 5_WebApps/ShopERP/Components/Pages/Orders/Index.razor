    private async Task ConfirmOrder(Guid orderId)
    {
        await TransitionOrder(orderId, "confirmed");
    }

    /// <summary>
    /// Inline payment confirmation from list page — same logic as Detail.razor ConfirmPayment.
    /// Calls IOrderService.ConfirmPaymentAsync → accounting entries + PaymentConfirmed broadcast.
    /// </summary>
    private async Task ConfirmPaymentInline(Guid orderId)
    {
        try
        {
            Guid tenantId = TenantProvider.TenantId;
            string transactionId = $"MANUAL_{orderId}_{DateTime.UtcNow:yyyyMMddHHmmss}";
            await OrderService.ConfirmPaymentAsync(orderId, tenantId, transactionId);
            await ReloadOrders();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error confirming payment for order {OrderId} from list", orderId);
            errorMessage = $"Lỗi thanh toán: {ex.Message}";
        }
    }

    /// <summary>
    /// Issue 2: Inline status transition from list page — no need to open detail.
    /// Uses OrderWorkflowService for unified state-machine validation + Outbox event sync.
    /// </summary>
    private async Task TransitionOrder(Guid orderId, string newStatus)
    {
        try
        {
            Order? result = await OrderWorkflowService.TransitionStatusAsync(
                orderId,
                new OrderStatusId(newStatus),
                reason: $"List page transition to {newStatus}");

            if (result != null)
            {
                await ReloadOrders();
            }
            else
            {
                errorMessage = $"Không thể chuyển trạng thái sang '{TranslateStatus(newStatus)}' — chuyển đổi không hợp lệ hoặc đơn hàng không tồn tại.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error transitioning order {OrderId} to {Status}", orderId, newStatus);
            errorMessage = $"Lỗi: {ex.Message}";
        }
    }

    private async Task StartSignalRConnection()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/orderHub"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<Guid, Guid, string, string>("OrderStatusChanged",
                async (orderId, tenantId, oldStatus, newStatus) =>
                {
                    await InvokeAsync(async () => await ReloadOrders(isBackground: true));
                });

            // B: Listen for OrderCreated — broadcast by OrderSyncSubscriber after NATS sync → SQLite insert.
            // Without this, new orders from KhachLink checkout only appear via 30s poll timer or F5.
            _hubConnection.On<Guid, Guid>("OrderCreated",
                async (orderId, tenantId) =>
                {
                    await InvokeAsync(async () => await ReloadOrders(isBackground: true));
                });

            _hubConnection.On<Guid, Guid, string>("PaymentConfirmed",
                async (orderId, tenantId, transactionId) =>
                {
                    await InvokeAsync(async () => await ReloadOrders(isBackground: true));
                });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SignalR connection failed — 5s poll fallback active. Retrying with backoff...");
            // E15: exponential-backoff retry loop (10s→20s→…→max 120s) until connected.
            // Replaces the old 1-shot retry — a long outage no longer kills realtime until F5.
            _ = Task.Run(async () =>
            {
                var delayMs = 10_000;
                while (_hubConnection is { State: HubConnectionState.Disconnected })
                {
                    await Task.Delay(delayMs);
                    try
                    {
                        await _hubConnection.StartAsync();
                        Logger.LogInformation("SignalR reconnected after {Delay}s backoff", delayMs / 1000);
                        break;
                    }
                    catch (ObjectDisposedException) { break; }
                    catch (Exception retryEx)
                    {
                        Logger.LogWarning(retryEx, "SignalR retry failed — next attempt in {Delay}s", delayMs / 1000);
                        delayMs = Math.Min(delayMs * 2, 120_000);
                    }
                }
            });
        }
    }

    // Issue #195: booking đơn dùng label "Chờ thanh toán"/"Đã thanh toán" (flow 0.2).
    private static string TranslateStatus(string status, string? sourceType = null) => (status, sourceType) switch
    {
        ("pending", "booking") => "Chờ thanh toán",
        ("confirmed", "booking") => "Đã thanh toán",
        ("pending", _) => "Chờ xác nhận",
        ("confirmed", _) => "Đã xác nhận",
        ("preparing", _) => "Đang làm",
        ("ready", _) => "Sẵn sàng",
        ("delivering", _) => "Đang giao",
        ("delivered", _) => "Đã giao",
        ("completed", _) => "Hoàn thành",
        ("cancelled", _) => "Đã hủy",
        _ => status
    };

    private OrderListItem MapToListItem(Order o)
    {
        string tenantName = "—";
        if (_isSystemAdmin && _tenantNameMap.TryGetValue(o.TenantId.Value, out string? name))
            tenantName = name;
        return new OrderListItem
        {
            Id = o.Id,
            TrackingCode = o.TrackingCode ?? o.Id.ToString()[..8],
            OrderDate = o.OrderDate,
            Status = o.Status?.Value ?? "pending",
            PaymentStatus = o.PaymentStatus ?? "Pending",
            TotalAmount = o.TotalAmount,
            TenantName = tenantName,
            // Bug 2 fix: surface CustomerNotes so the new "Ghi chú" column can render it.
            CustomerNotes = o.CustomerNotes,
            // Issue #195 (2.3): khách hàng từ CustomerInfo snapshot; (0.2): SourceType cho booking actions.
            CustomerName = o.CustomerInfo?.FullName,
            CustomerPhone = o.CustomerInfo?.PhoneNumber,
            SourceType = o.SourceType
        };
    }

    public async ValueTask DisposeAsync()
    {
        _pollTimer?.Dispose();
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private class OrderListItem
    {
        public Guid Id { get; set; }
        public string TrackingCode { get; set; } = "";
        public DateTime OrderDate { get; set; }
        public string Status { get; set; } = "";
        public string PaymentStatus { get; set; } = "";
        public decimal TotalAmount { get; set; }
        public string TenantName { get; set; } = "";
        // Bug 2 fix: customer notes from checkout (e.g. "ít đá", "giao trước 12h").
        public string? CustomerNotes { get; set; }
        // Issue #195 (2.3): tên + SĐT khách trong một cột.
        public string? CustomerName { get; set; }
        public string? CustomerPhone { get; set; }
        // Issue #195 (0.2): nguồn đơn — booking hiển thị action "Thanh toán/Hoàn tất".
        public string? SourceType { get; set; }
    }
}

