@page "/orders"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "StaffOrAbove")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.CoreHub.Services
@using VanAn.Shared.Services
@using VanAn.ShopERP.Components.Shared
@using VanAn.ShopERP.Services
@inject IOrderService OrderService
@inject IOrderWorkflowService OrderWorkflowService
@inject ITenantProvider TenantProvider
@inject ILogger<Index> Logger
@inject NavigationManager NavigationManager
@inject IThemeProvider ThemeProvider
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject TenantApiClient TenantApi
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory
@inject IJSRuntime JSRuntime

<div class="orders-page @ThemeProvider.CurrentTheme">
    <!-- Tenant Filter (SystemAdmin only) -->
    @if (_isSystemAdmin)
    {
        <div class="tenant-filter-dropdown" data-testid="tenant-filter">
            <label class="tenant-filter-label"><i class="bi bi-building"></i> Tenant:</label>
            <select class="tenant-filter-select" @bind="_selectedTenantFilter" @bind:after="OnTenantFilterChangedAsync">
                <option value="EMPTY">---Lọc dữ liệu---</option>
                @foreach (var t in _tenants)
                {
                    <option value="@t.Id">@t.Name</option>
                }
                <option value="ALL">Tất cả</option>
            </select>
        </div>
    }

    <header class="page-header">
        <h1>Danh sách đơn hàng</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="ReloadOrders">
                🔄 Refresh
            </VanAButton>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Variant="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }
    @if (infoMessage != null)
    {
        <VanAAlert Variant="info" Message="@infoMessage" Dismissible="true" OnDismiss="() => infoMessage = null" />
    }

    <VanACard Header="Bộ lọc">
        <div class="filter-row">
            <label>Trạng thái:</label>
            <select value="@selectedStatus" @onchange="OnStatusChanged" class="filter-select" data-testid="filter-status">
                <option value="EMPTY">===Lọc dữ liệu===</option>
                <option value="pending">Chờ xác nhận</option>
                <option value="confirmed">Đã xác nhận</option>
                <option value="preparing">Đang làm</option>
                <option value="ready">Sẵn sàng</option>
                <option value="delivered">Đã giao</option>
                <option value="completed">Hoàn thành</option>
                <option value="cancelled">Đã hủy</option>
                <option value="ALL">Tất cả</option>
            </select>

            <label>Thời gian:</label>
            <select value="@selectedDateRange" @onchange="OnDateRangeChanged" class="filter-select" data-testid="filter-date">
                <option value="today">Hôm nay</option>
                <option value="7days">7 ngày</option>
                <option value="all">Tất cả</option>
            </select>
        </div>
    </VanACard>

    @if (initialLoading)
    {
        <VanACard Header="Danh sách đơn hàng">
            <p>Đang tải...</p>
        </VanACard>
    }
    else if (orders.Count == 0)
    {
        <VanACard Header="Danh sách đơn hàng">
            <p>Không có đơn hàng nào.</p>
        </VanACard>
    }
    else
    {
        @* Issue #195 (2.2): bulk action bar — chọn nhiều đơn áp dụng 1 hành động *@
        <div class="bulk-bar" data-testid="bulk-bar">
            <label class="bulk-bar__selectall">
                <input type="checkbox" checked="@AllPageSelected" @onchange="ToggleSelectAllOnPage" data-testid="chk-select-all" />
                Chọn trang này
            </label>
            @if (selectedIds.Count > 0)
            {
                <span class="bulk-bar__count" data-testid="bulk-count">Đã chọn @selectedIds.Count đơn</span>
                <select @bind="bulkAction" class="filter-select bulk-bar__action" data-testid="bulk-action-select">
                    <option value="confirmed">✓ Xác nhận</option>
                    <option value="completed">✔️ Hoàn tất</option>
                    <option value="cancelled">✕ Hủy</option>
                </select>
                <VanAButton Variant="primary" Size="small" OnClick="ApplyBulkAction" Disabled="bulkApplying" data-testid="btn-bulk-apply">
                    Áp dụng
                </VanAButton>
                <VanAButton Variant="ghost" Size="small" OnClick="ClearSelection" data-testid="btn-bulk-clear">
                    Bỏ chọn
                </VanAButton>
            }
        </div>

        @* Desktop view: DataGrid table (hidden on mobile, shown on md+) *@
        <div class="d-none d-md-block">
        <VanACard Header="@($"Danh sách đơn hàng ({totalCount})")">
            <VanAnDataGrid TItem="OrderListItem" Items="@orders" EmptyMessage="Không có đơn hàng">
                <Columns>
                    <VanAnColumn TItem="OrderListItem" Title="" Width="1">
                        <Template Context="o">
                            <input type="checkbox" checked="@selectedIds.Contains(o.Id)" @onchange="@(e => ToggleSelect(o.Id, e))" data-testid="chk-order" />
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderListItem" Title="Mã đơn" Width="2">
                        <Template Context="o">
                            <a href="@GetDetailUrl(o.Id)" data-testid="link-order-detail">@o.TrackingCode</a>
                        </Template>
                    </VanAnColumn>
                    @if (_isSystemAdmin)
                    {
                        <VanAnColumn TItem="OrderListItem" Title="Tenant" Width="2">
                            <Template Context="o">
                                <span class="tenant-badge">@o.TenantName</span>
                            </Template>
                        </VanAnColumn>
                    }
                    <VanAnColumn TItem="OrderListItem" Title="Thời gian" Width="2">
                        <Template Context="o">
                            @o.OrderDate.ToVietnamTimeString()
                        </Template>
                    </VanAnColumn>
                    @* Issue #195 (2.3): cột khách hàng — tên + SĐT trong một ô *@
                    <VanAnColumn TItem="OrderListItem" Title="Khách hàng" Width="3">
                        <Template Context="o">
                            @if (!string.IsNullOrWhiteSpace(o.CustomerName) || !string.IsNullOrWhiteSpace(o.CustomerPhone))
                            {
                                <div class="customer-cell">
                                    @if (!string.IsNullOrWhiteSpace(o.CustomerName))
                                    {
                                        <span class="customer-name">@o.CustomerName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(o.CustomerPhone))
                                    {
                                        <span class="customer-phone"><i class="bi bi-telephone"></i> @o.CustomerPhone</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderListItem" Title="Trạng thái" Width="2">
                        <Template Context="o">
                            <span class="status-badge status-@o.Status">@TranslateStatus(o.Status, o.SourceType)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderListItem" Title="Thanh toán" Width="2">
                        <Template Context="o">
                            <span class="payment-badge payment-@o.PaymentStatus.ToLower()">@(o.PaymentStatus)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderListItem" Title="Tổng tiền" Width="2">
                        <Template Context="o">
                            @o.TotalAmount.ToString("N0") đ
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderListItem" Title="Ghi chú" Width="3">
                        <Template Context="o">
                            @if (!string.IsNullOrWhiteSpace(o.CustomerNotes))
                            {
                                <span class="order-notes" title="@o.CustomerNotes">@o.CustomerNotes</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="OrderListItem" Title="Hành động" Width="3">
                        <Template Context="o">
                            <div class="d-flex gap-1 flex-wrap">
                                @* Issue #195 (0.2): đơn booking — chỉ Thanh toán / Hoàn tất / Hủy *@
                                @if (o.SourceType == "booking")
                                {
                                    @if (o.Status == "pending")
                                    {
                                        <VanAButton Variant="primary" Size="small" OnClick="@(() => TransitionOrder(o.Id, "confirmed"))" data-testid="btn-booking-pay-order">
                                            💰 Thanh toán
                                        </VanAButton>
                                    }
                                    else if (o.Status == "confirmed")
                                    {
                                        <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionOrder(o.Id, "completed"))" data-testid="btn-complete-order">
                                            ✔️ Hoàn tất
                                        </VanAButton>
                                    }
                                }
                                else if (o.Status == "pending")
                                {
                                    <VanAButton Variant="primary" Size="small" OnClick="@(() => TransitionOrder(o.Id, "confirmed"))" data-testid="btn-confirm-order">
                                        ✓ Xác nhận
                                    </VanAButton>
                                }
                                else if (o.Status == "confirmed")
                                {
                                    <VanAButton Variant="primary" Size="small" OnClick="@(() => TransitionOrder(o.Id, "preparing"))" data-testid="btn-preparing-order">
                                        ⏳ Làm
                                    </VanAButton>
                                    <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionOrder(o.Id, "completed"))" data-testid="btn-complete-order">
                                        ✔️ Hoàn tất
                                    </VanAButton>
                                }
                                else if (o.Status == "preparing")
                                {
                                    <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionOrder(o.Id, "ready"))" data-testid="btn-ready-order">
                                        ✅ Sẵn sàng
                                    </VanAButton>
                                }
                                else if (o.Status == "ready")
                                {
                                    <VanAButton Variant="primary" Size="small" OnClick="@(() => TransitionOrder(o.Id, "delivered"))" data-testid="btn-deliver-order">
                                        📦 Giao
                                    </VanAButton>
                                    <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionOrder(o.Id, "completed"))" data-testid="btn-complete-order">
                                        ✔️ Hoàn tất
                                    </VanAButton>
                                }
                                else if (o.Status == "delivered")
                                {
                                    <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionOrder(o.Id, "completed"))" data-testid="btn-complete-order">
                                        ✔️ Hoàn tất
                                    </VanAButton>
                                }
                                @if (o.PaymentStatus == "Pending" && o.Status != "cancelled")
                                {
                                    <VanAButton Variant="primary" Size="small" OnClick="@(() => ConfirmPaymentInline(o.Id))" data-testid="btn-confirm-payment-inline">
                                        💰 Đã thanh toán
                                    </VanAButton>
                                }
                                @if (o.Status is "pending" or "confirmed" or "preparing" or "ready")
                                {
                                    <VanAButton Variant="error" Size="small" OnClick="@(() => TransitionOrder(o.Id, "cancelled"))" data-testid="btn-cancel-order">
                                        ✕ Hủy
                                    </VanAButton>
                                }
                                <VanAButton Variant="secondary" Size="small" OnClick="@(() => GoToDetail(o.Id))">
                                    Chi tiết
                                </VanAButton>
                                @if (o.PaymentStatus == "Paid")
                                {
                                    <VanAButton Variant="secondary" Size="small" OnClick="@(() => PrintBill(o.Id))" data-testid="btn-print-bill">
                                        🖨️ In bill
                                    </VanAButton>
                                }
                            </div>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>
        </div>

        @* Mobile view: card list (shown on mobile, hidden on md+) — no horizontal scroll *@
        <div class="d-md-none" data-testid="orders-mobile-list">
            <div class="orders-mobile-header">Danh sách đơn hàng (@totalCount)</div>
            @foreach (var o in orders)
            {
                <div class="order-mobile-card status-@o.Status">
                    <div class="order-mobile-card__top">
                        <label class="order-mobile-card__select">
                            <input type="checkbox" checked="@selectedIds.Contains(o.Id)" @onchange="@(e => ToggleSelect(o.Id, e))" />
                        </label>
                        <a href="@GetDetailUrl(o.Id)" class="order-mobile-card__code">@o.TrackingCode</a>
                        <span class="status-badge status-@o.Status">@TranslateStatus(o.Status, o.SourceType)</span>
                    </div>
                    <div class="order-mobile-card__row">
                        <span class="order-mobile-card__time">@o.OrderDate.ToVietnamTimeString()</span>
                        <span class="payment-badge payment-@o.PaymentStatus.ToLower()">@o.PaymentStatus</span>
                        <span class="order-mobile-card__amount">@o.TotalAmount.ToString("N0") đ</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(o.CustomerName) || !string.IsNullOrWhiteSpace(o.CustomerPhone))
                    {
                        <div class="order-mobile-card__customer">
                            <i class="bi bi-person"></i> @o.CustomerName
                            @if (!string.IsNullOrWhiteSpace(o.CustomerPhone))
                            {
                                <span class="customer-phone"><i class="bi bi-telephone"></i> @o.CustomerPhone</span>
                            }
                        </div>
                    }
                    @if (_isSystemAdmin && !string.IsNullOrWhiteSpace(o.TenantName) && o.TenantName != "—")
                    {
                        <div class="order-mobile-card__tenant"><i class="bi bi-building"></i> @o.TenantName</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(o.CustomerNotes))
                    {
                        <div class="order-mobile-card__notes" title="@o.CustomerNotes">
                            <i class="bi bi-sticky"></i> @o.CustomerNotes
                        </div>
                    }
                    <div class="order-mobile-card__actions">
                        @if (o.SourceType == "booking")
                        {
                            @if (o.Status == "pending")
                            {
                                <VanAButton Variant="primary" Size="small" OnClick="@(() => TransitionOrder(o.Id, "confirmed"))" data-testid="btn-booking-pay-order-m">
                                    💰 Thanh toán
                                </VanAButton>
                            }
                            else if (o.Status == "confirmed")
                            {
                                <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionOrder(o.Id, "completed"))" data-testid="btn-complete-order-m">
                                    ✔️ Hoàn tất
                                </VanAButton>
                            }
                        }
                        else if (o.Status == "pending")
                        {
                            <VanAButton Variant="primary" Size="small" OnClick="@(() => TransitionOrder(o.Id, "confirmed"))" data-testid="btn-confirm-order-m">
                                ✓ Xác nhận
                            </VanAButton>
                        }
                        else if (o.Status == "confirmed")
                        {
                            <VanAButton Variant="primary" Size="small" OnClick="@(() => TransitionOrder(o.Id, "preparing"))" data-testid="btn-preparing-order-m">
                                ⏳ Làm
                            </VanAButton>
                            <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionOrder(o.Id, "completed"))" data-testid="btn-complete-order-m">
                                ✔️ Hoàn tất
                            </VanAButton>
                        }
                        else if (o.Status == "preparing")
                        {
                            <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionOrder(o.Id, "ready"))" data-testid="btn-ready-order-m">
                                ✅ Sẵn sàng
                            </VanAButton>
                        }
                        else if (o.Status == "ready")
                        {
                            <VanAButton Variant="primary" Size="small" OnClick="@(() => TransitionOrder(o.Id, "delivered"))" data-testid="btn-deliver-order-m">
                                📦 Giao
                            </VanAButton>
                            <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionOrder(o.Id, "completed"))" data-testid="btn-complete-order-m">
                                ✔️ Hoàn tất
                            </VanAButton>
                        }
                        else if (o.Status == "delivered")
                        {
                            <VanAButton Variant="success" Size="small" OnClick="@(() => TransitionOrder(o.Id, "completed"))" data-testid="btn-complete-order-m">
                                ✔️ Hoàn tất
                            </VanAButton>
                        }
                        @if (o.PaymentStatus == "Pending" && o.Status != "cancelled")
                        {
                            <VanAButton Variant="primary" Size="small" OnClick="@(() => ConfirmPaymentInline(o.Id))" data-testid="btn-confirm-payment-inline-m">
                                💰 Đã TT
                            </VanAButton>
                        }
                        @if (o.Status is "pending" or "confirmed" or "preparing" or "ready")
                        {
                            <VanAButton Variant="error" Size="small" OnClick="@(() => TransitionOrder(o.Id, "cancelled"))" data-testid="btn-cancel-order-m">
                                ✕ Hủy
                            </VanAButton>
                        }
                        <VanAButton Variant="secondary" Size="small" OnClick="@(() => GoToDetail(o.Id))">
                            Chi tiết
                        </VanAButton>
                        @if (o.PaymentStatus == "Paid")
                        {
                            <VanAButton Variant="secondary" Size="small" OnClick="@(() => PrintBill(o.Id))" data-testid="btn-print-bill-m">
                                🖨️ In
                            </VanAButton>
                        }
                    </div>
                </div>
            }
        </div>

        @* Issue #195 (2.4): server-side pagination *@
        <div class="pager" data-testid="pager">
            <VanAButton Variant="secondary" Size="small" Disabled="@(page <= 1)" OnClick="PrevPage" data-testid="btn-page-prev">
                « Trước
            </VanAButton>
            <span class="pager__info" data-testid="pager-info">Trang @(page) / @totalPages · @totalCount đơn</span>
            <VanAButton Variant="secondary" Size="small" Disabled="@(page >= totalPages)" OnClick="NextPage" data-testid="btn-page-next">
                Sau »
            </VanAButton>
            <select value="@pageSize" @onchange="OnPageSizeChanged" class="filter-select pager__size" data-testid="page-size">
                <option value="10">10 / trang</option>
                <option value="20">20 / trang</option>
                <option value="50">50 / trang</option>
            </select>
        </div>
    }
</div>

@code {
    private List<OrderListItem> orders = new();
    // P1: Split loading state — initialLoading shows "Đang tải...", backgroundRefreshing is silent.
    // Prevents flicker on 30s poll + SignalR-triggered reloads.
    private bool initialLoading = true;
    private bool backgroundRefreshing;
    private string? errorMessage;
    private string? infoMessage;
    // Issue #195 (2.1): default "pending" + "today" — vào trang thấy ngay đơn chờ xác nhận hôm nay.
    private string selectedStatus = "pending";
    private string selectedDateRange = "today";
    // Issue #195 (2.4): server-side pagination state
    private int page = 1;
    private int pageSize = 20;
    private int totalCount;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    // Issue #195 (2.2): bulk selection
    private readonly HashSet<Guid> selectedIds = new();
    private string bulkAction = "confirmed";
    private bool bulkApplying;
    private bool AllPageSelected => orders.Count > 0 && orders.All(o => selectedIds.Contains(o.Id));
    private HubConnection? _hubConnection;
    private System.Threading.Timer? _pollTimer;

    // SystemAdmin cross-tenant filter
    private bool _isSystemAdmin;
    private string _selectedTenantFilter = "EMPTY";
    private List<VanAn.ShopERP.Services.TenantApiDto> _tenants = new();
    private Dictionary<Guid, string> _tenantNameMap = new();

    protected override async Task OnInitializedAsync()
    {
        // Check if current user is SystemAdmin
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isSystemAdmin = authState.User.IsInRole("SystemAdmin");
        }
        catch { _isSystemAdmin = false; }

        // Load tenant list for SystemAdmin filter dropdown
        if (_isSystemAdmin)
        {
            try
            {
                _tenants = await TenantApi.ListAllAsync();
                _tenantNameMap = _tenants.ToDictionary(t => t.Id, t => t.Name);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load tenants for filter dropdown");
            }
            // SystemAdmin: default EMPTY — no data loaded until filter selected
        }
        else
        {
            // Non-SystemAdmin: load own tenant orders immediately
            await ReloadOrders();
        }

        await StartSignalRConnection();

        // Issue 8: Fallback polling timer — ensures auto-refresh even if SignalR fails silently.
        // Reduced 30s → 5s: new orders from KhachLink checkout must appear within seconds, not minutes.
        // SignalR remains primary (instant); poll is safety net for proxy/WebSocket failures.
        _pollTimer = new System.Threading.Timer(
            async _ => await InvokeAsync(async () => await ReloadOrders(isBackground: true)),
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5));
    }

    private async Task OnTenantFilterChangedAsync()
    {
        // EMPTY = no data; ALL = all tenants; specific Guid = that tenant only
        if (_selectedTenantFilter == "EMPTY")
        {
            orders = new List<OrderListItem>();
            totalCount = 0;
            selectedIds.Clear();
            StateHasChanged();
            return;
        }
        // If specific tenant selected, override TenantProvider so detail/confirm works
        if (_selectedTenantFilter != "ALL" && Guid.TryParse(_selectedTenantFilter, out Guid tid))
        {
            TenantProvider.SetTenant(tid);
        }
        page = 1;
        selectedIds.Clear();
        await ReloadOrders();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? "EMPTY";
        page = 1;
        selectedIds.Clear();
        if (selectedStatus == "EMPTY")
        {
            // Empty state — no data, no query
            orders = new List<OrderListItem>();
            totalCount = 0;
            StateHasChanged();
            return;
        }
        await ReloadOrders();
    }

    private async Task OnDateRangeChanged(ChangeEventArgs e)
    {
        selectedDateRange = e.Value?.ToString() ?? "today";
        page = 1;
        selectedIds.Clear();
        await ReloadOrders();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int size) && size > 0)
        {
            pageSize = size;
            page = 1;
            selectedIds.Clear();
            await ReloadOrders();
        }
    }

    private async Task PrevPage()
    {
        if (page <= 1) return;
        page--;
        selectedIds.Clear();
        await ReloadOrders();
    }

    private async Task NextPage()
    {
        if (page >= totalPages) return;
        page++;
        selectedIds.Clear();
        await ReloadOrders();
    }

    private void ToggleSelect(Guid orderId, ChangeEventArgs e)
    {
        bool isChecked = e.Value is bool b && b;
        if (isChecked) selectedIds.Add(orderId);
        else selectedIds.Remove(orderId);
    }

    private void ToggleSelectAllOnPage(ChangeEventArgs e)
    {
        bool isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            foreach (var o in orders) selectedIds.Add(o.Id);
        }
        else
        {
            foreach (var o in orders) selectedIds.Remove(o.Id);
        }
    }

    private void ClearSelection() => selectedIds.Clear();

    /// <summary>
    /// Issue #195 (2.2, approved Q5): bulk action — per-order transaction, KHÔNG all-or-nothing.
    /// Đơn hợp lệ chuyển trạng thái; đơn invalid (status đã đổi/flow không cho phép) báo lỗi riêng.
    /// </summary>
    private async Task ApplyBulkAction()
    {
        if (selectedIds.Count == 0 || bulkApplying) return;
        bulkApplying = true;
        errorMessage = null;
        infoMessage = null;
        int succeeded = 0;
        var failed = new List<string>();
        try
        {
            foreach (Guid id in selectedIds.ToList())
            {
                try
                {
                    Order? result = await OrderWorkflowService.TransitionStatusAsync(
                        id,
                        new OrderStatusId(bulkAction),
                        reason: $"Bulk action → {bulkAction}");
                    if (result != null)
                    {
                        succeeded++;
                        selectedIds.Remove(id);
                    }
                    else
                    {
                        failed.Add(id.ToString()[..8]);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Bulk action {Action} failed for order {OrderId}", bulkAction, id);
                    failed.Add(id.ToString()[..8]);
                }
            }
            infoMessage = failed.Count == 0
                ? $"Đã áp dụng '{TranslateStatus(bulkAction)}' cho {succeeded} đơn."
                : $"Thành công {succeeded} đơn; thất bại {failed.Count} đơn ({string.Join(", ", failed)}) — chuyển đổi không hợp lệ.";
            await ReloadOrders();
        }
        finally
        {
            bulkApplying = false;
        }
    }

    private async Task ReloadOrders() => await ReloadOrders(isBackground: false);

    private async Task ReloadOrders(bool isBackground)
    {
        // P1: Silent refresh — only show "Đang tải..." on initial load (isBackground=false).
        // Background reloads (poll timer, SignalR) update data without flickering the list.
        if (isBackground)
            backgroundRefreshing = true;
        else
            initialLoading = true;
        errorMessage = null;
        // C: Create a fresh DI scope per reload to get a new DbContext (Blazor Server circuit-scoped
        // DbContext anti-pattern fix). Without this, the circuit's long-lived DbContext can return
        // stale data — new orders inserted by OrderSyncSubscriber (separate scope) may not be visible.
        // Guard: test host / app shutdown disposes ServiceProvider — timer callback may fire after
        // dispose, causing ObjectDisposedException. Catch + silently return (component is tearing down).
        IServiceScope scope;
        try
        {
            scope = ScopeFactory.CreateScope();
        }
        catch (ObjectDisposedException)
        {
            return;
        }
        using (scope)
        {
        var scopedOrderService = scope.ServiceProvider.GetRequiredService<IOrderService>();
        try
        {
            // EMPTY = no data (defensive — OnStatusChanged/OnTenantFilterChanged short-circuit before here)
            if (selectedStatus == "EMPTY" || (_isSystemAdmin && _selectedTenantFilter == "EMPTY"))
            {
                orders = new List<OrderListItem>();
                totalCount = 0;
                return;
            }

            // Issue #195 (2.4): server-side paging — status/date filters đẩy xuống DB query.
            string? statusFilter = selectedStatus == "ALL" ? null : selectedStatus;
            (DateTime? from, DateTime? to) = ResolveDateRange();

            List<Order> pageItems;
            int total;
            // SystemAdmin "ALL tenants" mode — query all orders across tenants
            bool allTenants = _isSystemAdmin && _selectedTenantFilter == "ALL";

            if (allTenants)
            {
                (pageItems, total) = await scopedOrderService.GetAllOrdersPageAsync(
                    statusFilter, from, to, page, pageSize);
            }
            else
            {
                Guid tenantId = TenantProvider.TenantId;
                // SystemAdmin chọn 1 tenant cụ thể → query tenant đó (không phụ thuộc TenantProvider).
                if (_isSystemAdmin && Guid.TryParse(_selectedTenantFilter, out Guid selectedTid))
                    tenantId = selectedTid;
                (pageItems, total) = await scopedOrderService.GetOrdersPageAsync(
                    tenantId, statusFilter, from, to, page, pageSize);
            }

            // Clamp page khi filter/data đổi làm totalPages nhỏ lại (VD: poll xóa bớt đơn).
            if (total > 0 && pageItems.Count == 0 && page > 1)
            {
                page = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));
                await ReloadOrders(isBackground);
                return;
            }

            // P1: Diff check — only update + StateHasChanged if data actually changed.
            var newOrders = pageItems.Select(MapToListItem).ToList();
            if (totalCount != total || !OrdersEqual(orders, newOrders))
            {
                orders = newOrders;
                totalCount = total;
                // Bug 5 fix: Explicit StateHasChanged — InvokeAsync auto-calls it, but adding it here
                // ensures the gridview rebuilds immediately after data change, even in edge cases
                // where the render batch is deferred.
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading orders");
            errorMessage = $"Không thể tải đơn hàng: {ex.Message}";
        }
        finally
        {
            if (isBackground)
                backgroundRefreshing = false;
            else
                initialLoading = false;
        }
        } // using (scope)
    }

    /// <summary>Issue #195: map date-range select → [from, to) theo OrderDate UTC.</summary>
    private (DateTime? From, DateTime? To) ResolveDateRange()
    {
        DateTime today = DateTime.UtcNow.Date;
        DateTime tomorrow = today.AddDays(1);
        return selectedDateRange switch
        {
            "7days" => (today.AddDays(-7), tomorrow),
            "all" => (today.AddDays(-365), tomorrow),
            _ => (today, tomorrow)
        };
    }

    // P1: Lightweight diff — compares count + Id + Status + PaymentStatus + CustomerNotes for each order.
    // Avoids full deep equality but catches all UI-relevant changes (new order, status change, payment change, notes change).
    private static bool OrdersEqual(List<OrderListItem> a, List<OrderListItem> b)
    {
        if (a.Count != b.Count) return false;
        for (int i = 0; i < a.Count; i++)
        {
            if (a[i].Id != b[i].Id) return false;
            if (a[i].Status != b[i].Status) return false;
            if (a[i].PaymentStatus != b[i].PaymentStatus) return false;
            if (a[i].CustomerNotes != b[i].CustomerNotes) return false;
            if (a[i].CustomerName != b[i].CustomerName) return false;
            if (a[i].CustomerPhone != b[i].CustomerPhone) return false;
        }
        return true;
    }

