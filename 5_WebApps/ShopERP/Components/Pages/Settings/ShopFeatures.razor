@page "/settings/shop-features"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.Shared.Services
@using VanAn.CoreHub.Services
@using VanAn.Shared.Domain.Common
@using VanAn.ShopERP.Services
@inject IShopFeatureSettingsService SettingsService
@inject ITenantProvider TenantProvider
@inject ILogger<ShopFeatures> Logger
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject TenantApiClient TenantApi

<PageTitle>Cấu hình tính năng Shop</PageTitle>

<div class="shop-features-page" data-testid="shop-features-page">
    <header class="page-header">
        <h1>Cấu hình tính năng Shop</h1>
        @if (_isSystemAdmin && TenantProvider.HasTenant)
        {
            <div class="mt-2">
                <VanAButton Variant="primary" Size="small" OnClick="ImpersonateCurrentTenantAsync" IsLoading="@_impersonating">
                    <i class="bi bi-person-badge me-1"></i> Impersonate tenant này
                </VanAButton>
            </div>
        }
    </header>

    @if (!TenantProvider.HasTenant)
    {
        @if (_isSystemAdmin)
        {
            <VanACard Header="Chọn Tenant để cấu hình" data-testid="tenant-selector-card">
                <div class="features-form">
                    <p class="text-muted small mb-3">
                        SystemAdmin không thuộc tenant cụ thể. Chọn tenant bên dưới để cấu hình trang chủ KhachLink cho tenant đó.
                    </p>
                    @if (_tenantListLoading)
                    {
                        <VanAAlert Variant="info" Message="Đang tải danh sách tenant..." />
                    }
                    else if (_tenantList.Count == 0)
                    {
                        <VanAAlert Variant="warning" Message="Không tải được danh sách tenant. Vui lòng thử lại sau." />
                    }
                    else
                    {
                        <div class="row g-2 align-items-end">
                            <div class="col-md-8">
                                <label class="form-label" for="tenant-select">Tenant</label>
                                <select id="tenant-select" class="form-select" @bind="_selectedTenantId">
                                    <option value="">-- Chọn tenant --</option>
                                    @foreach (var t in _tenantList)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <VanAButton Variant="primary" OnClick="ImpersonateSelectedTenantAsync" IsLoading="@_impersonating" Disabled="@(string.IsNullOrEmpty(_selectedTenantId))">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Chọn & Cấu hình
                                </VanAButton>
                            </div>
                        </div>
                    }
                </div>
            </VanACard>
        }
        else
        {
            <VanAAlert Variant="warning" Message="Không tìm thấy thông tin tenant. Vui lòng đăng nhập lại." />
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <VanAAlert Variant="success" Message="@successMessage" data-testid="alert-success" />
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <VanAAlert Variant="error" Message="@errorMessage" data-testid="alert-error" />
        }

        @if (loading)
        {
            <VanAAlert Variant="info" Message="Đang tải cấu hình..." />
        }
        else
        {
            <VanACard Header="Tính năng nghiệp vụ" data-testid="features-card">
                <div class="features-form">
                    <div class="feature-row" data-testid="toggle-qr-table-number">
                        <div class="feature-info">
                            <strong>Hiển thị số bàn trong QR Code</strong>
                            <p class="text-muted small">Khi bật, QR Code sẽ chứa thêm số thứ tự bàn. Khách quét mã thấy thông tin bàn.</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="qr-table-number" @bind="settings.QR_TableNumber_Enabled" />
                        </div>
                    </div>

                    <div class="feature-row" data-testid="toggle-kitchen-workflow">
                        <div class="feature-info">
                            <strong>Bật luồng nhà bếp / pha chế</strong>
                            <p class="text-muted small">Đơn hàng đi qua: Nhận đơn → Đang chế biến → Sẵn sàng giao. Khi tắt, đơn đi thẳng đến Hoàn tất.</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="kitchen-workflow" @bind="settings.Kitchen_Workflow_Enabled" />
                        </div>
                    </div>

                    <div class="feature-row" data-testid="toggle-voice-note">
                        <div class="feature-info">
                            <strong>Bật ghi chú giọng nói (STT + TTS)</strong>
                            <p class="text-muted small">Khách ghi âm → chuyển thành text. Nhà bếp đọc ghi chú bằng giọng nói khi nhận đơn.</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="voice-note" @bind="settings.Voice_Note_Enabled" />
                        </div>
                    </div>

                    <div class="feature-row" data-testid="toggle-loyalty-program">
                        <div class="feature-info">
                            <strong>Bật chương trình điểm thưởng</strong>
                            <p class="text-muted small">Sau khi hoàn tất đơn: OTP + tích điểm + PWA prompt. Khi tắt, khách chỉ thấy "Cảm ơn".</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="loyalty-program" @bind="settings.Loyalty_Program_Enabled" />
                        </div>
                    </div>

                    <div class="feature-row" data-testid="toggle-loyalty-require-phone">
                        <div class="feature-info">
                            <strong>Yêu cầu xác minh số điện thoại để đổi điểm</strong>
                            <p class="text-muted small">Khi bật: khách phải xác minh OTP số điện thoại mới được đổi điểm thưởng. Khi tắt: khách đăng nhập bằng Google/Facebook (Social OAuth) vẫn đổi được điểm.</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="loyalty-require-phone" @bind="settings.Loyalty_RequirePhoneVerificationForRedeem" />
                        </div>
                    </div>

                    <div class="feature-row" data-testid="toggle-accounting-sync">
                        <div class="feature-info">
                            <strong>Đồng bộ kế toán HKD tự động</strong>
                            <p class="text-muted small">Mọi giao dịch thanh toán tự động đẩy sang hệ thống kế toán. Khi tắt, admin nhập liệu thủ công.</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="accounting-sync" @bind="settings.Accounting_Sync_Enabled" />
                        </div>
                    </div>

                    <div class="feature-row" data-testid="toggle-einvoice-auto-export">
                        <div class="feature-info">
                            <strong>Tự động xuất hóa đơn điện tử</strong>
                            <p class="text-muted small">Tự động xuất HĐĐT khi đơn hàng Hoàn tất. Yêu cầu đã cấu hình nhà cung cấp (Viettel/MISA).</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="einvoice-auto-export" @bind="settings.EInvoice_Auto_Export_Enabled" />
                        </div>
                    </div>

                    <div class="feature-row" data-testid="toggle-vat-display">
                        <div class="feature-info">
                            <strong>Hiển thị VAT trên giao diện khách hàng</strong>
                            <p class="text-muted small">Khi bật, giỏ hàng / thanh toán / theo dõi đơn hiển thị tường minh: Tạm tính (net) / VAT / Tổng cộng (gross). Khi tắt, chỉ hiển thị Tổng cộng. Dành cho HKD nhỏ không xuất hóa đơn VAT. Backend vẫn tách VAT riêng để sẵn sàng chuyển lên Công Ty.</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="vat-display" @bind="settings.VAT_Display_Enabled" />
                        </div>
                    </div>

                    <div class="feature-row" data-testid="toggle-price-validation">
                        <div class="feature-info">
                            <strong>Kiểm tra giá khi thanh toán (Phase 5)</strong>
                            <p class="text-muted small">Khi bật, KhachLink sẽ gọi <code>/api/products/{id}/validate-price</code> trước khi thanh toán để đảm bảo giá trong QR/giỏ hàng khớp với giá hiện tại của sản phẩm. Ngăn mã QR cũ tính sai tiền. Mặc định TẮT (tin tưởng snapshot trong QR).</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="price-validation" @bind="settings.Price_Validation_Enabled" />
                        </div>
                    </div>
                </div>

                <VanACard Header="Hiển thị trang cửa hàng (Tenant Profile Page)" CssClass="mt-4" data-testid="profile-card">
                    <div class="features-form">
                        <p class="text-muted small mb-3">
                            Trang <code>/store/{slug}</code> trên KhachLink hiển thị 4 phần: Khuyến mãi, Showcase sản phẩm, Google Maps, Social Hub.
                            Bật/tắt từng phần theo nhu cầu kinh doanh. Khách hàng truy cập qua nút "Tìm cửa hàng gần bạn nhất".
                        </p>

                        <div class="feature-row" data-testid="toggle-campaign-section">
                            <div class="feature-info">
                                <strong>Hiển thị phần Khuyến mãi (Campaign)</strong>
                                <p class="text-muted small">Hiển thị các chương trình khuyến mãi đang hoạt động. Tắt nếu không có khuyến mãi.</p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="campaign-section" @bind="settings.Campaign_Section_Enabled" />
                            </div>
                        </div>

                        <div class="feature-row" data-testid="toggle-vibeshowcase-section">
                            <div class="feature-info">
                                <strong>Hiển thị Showcase sản phẩm (VibeShowcase)</strong>
                                <p class="text-muted small">Hiển thị sản phẩm nổi bật theo theme (Teen/Lady/Classic/Premium). Tắt nếu muốn trang tối giản.</p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="vibeshowcase-section" @bind="settings.VibeShowcase_Section_Enabled" />
                            </div>
                        </div>

                        <div class="feature-row" data-testid="toggle-googlemap-section">
                            <div class="feature-info">
                                <strong>Hiển thị Google Maps</strong>
                                <p class="text-muted small">Nhúng bản đồ Google Maps với tọa độ cửa hàng. Tắt nếu kinh doanh online (không có cửa hàng vật lý).</p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="googlemap-section" @bind="settings.GoogleMap_Section_Enabled" />
                            </div>
                        </div>

                        <div class="feature-row" data-testid="toggle-socialhub-section">
                            <div class="feature-info">
                                <strong>Hiển thị Social Hub (Facebook/TikTok)</strong>
                                <p class="text-muted small">Nhúng trang Facebook + TikTok của cửa hàng. Tắt nếu chưa có mạng xã hội.</p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="socialhub-section" @bind="settings.SocialHub_Section_Enabled" />
                            </div>
                        </div>

                        <div class="feature-row" data-testid="toggle-aichat">
                            <div class="feature-info">
                                <strong>AI Chatbox (sắp ra mắt)</strong>
                                <p class="text-muted small">Widget chat gợi ý câu trả lời bằng AI cho khách hàng. Owner review trước khi gửi. Khi owner offline, AI tự động trả lời. <em>Hiện đang phát triển — bật sẽ không có tác dụng ngay.</em></p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="aichat" @bind="settings.AIChat_Enabled" disabled />
                            </div>
                        </div>
                    </div>
                </VanACard>

                @* #100: Home section toggles moved to /admin/khachlink-home-settings (global, not per-tenant) *@

                <VanACard Header="�🎁 Công thức điểm thưởng (Loyalty-C)" CssClass="mt-4" data-testid="loyalty-formula-card">
                    <div class="features-form">
                        <p class="text-muted small mb-3">
                            Cấu hình công thức tích điểm cho khách hàng khi mua hàng.
                            Để trống/0 để dùng giá trị mặc định toàn hệ thống (từ <code>appsettings.json</code>).
                            Mỗi cửa hàng có thể cấu hình riêng.
                        </p>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="loyalty-points-rate">Tỉ lệ tích điểm (0-1)</label>
                                <input type="number" class="form-control" id="loyalty-points-rate"
                                       min="0" max="1" step="0.001"
                                       @bind="settings.Loyalty_PointsRate" />
                                <small class="text-muted">Ví dụ: 0.001 = 1 điểm / 1.000đ. 0.1 = 10% giá trị đơn. 0 = dùng mặc định.</small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="loyalty-min-points">Điểm tối thiểu / đơn</label>
                                <input type="number" class="form-control" id="loyalty-min-points"
                                       min="0" step="1"
                                       @bind="settings.Loyalty_MinPointsPerOrder" />
                                <small class="text-muted">0 = mặc định</small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="loyalty-max-points">Điểm tối đa / đơn</label>
                                <input type="number" class="form-control" id="loyalty-max-points"
                                       min="0" step="1"
                                       value="@settings.Loyalty_MaxPointsPerOrder"
                                       @oninput="(e) => settings.Loyalty_MaxPointsPerOrder = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value!.ToString()!)" />
                                <small class="text-muted">Để trống = không giới hạn</small>
                            </div>
                        </div>

                        <div class="feature-row mt-3" data-testid="toggle-loyalty-award-all">
                            <div class="feature-info">
                                <strong>Tích điểm cho mọi đơn hàng</strong>
                                <p class="text-muted small">
                                    Bật: khách mua bất kỳ đơn nào cũng được tích điểm.
                                    Tắt: chỉ tích điểm cho đơn có mã chiến dịch (TrackingCode) — dành cho hệ thống affiliate.
                                </p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="loyalty-award-all" @bind="settings.Loyalty_AwardOnAllOrders" />
                            </div>
                        </div>
                    </div>
                </VanACard>

                <VanACard Header="🔔 Thông báo điểm thưởng (Loyalty-C)" CssClass="mt-4" data-testid="loyalty-notification-card">
                    <div class="features-form">
                        <p class="text-muted small mb-3">
                            Cấu hình khi nào gửi push notification cho khách hàng về sự kiện điểm thưởng.
                            Khách phải đã bật thông báo đẩy trên điện thoại.
                        </p>

                        <div class="feature-row" data-testid="toggle-notify-mission">
                            <div class="feature-info">
                                <strong>Thông báo khi hoàn thành nhiệm vụ</strong>
                                <p class="text-muted small">Push khi khách hoàn thành nhiệm vụ (cài app, OTP, sinh nhật, share MXH).</p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="notify-mission" @bind="settings.Notify_MissionCompleted" />
                            </div>
                        </div>

                        <div class="feature-row" data-testid="toggle-notify-birthday">
                            <div class="feature-info">
                                <strong>Thông báo điểm sinh nhật</strong>
                                <p class="text-muted small">Push +100 điểm tự động vào ngày sinh nhật khách.</p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="notify-birthday" @bind="settings.Notify_BirthdayBonus" />
                            </div>
                        </div>

                        <div class="feature-row" data-testid="toggle-notify-fulfill">
                            <div class="feature-info">
                                <strong>Thông báo khi voucher được xác nhận</strong>
                                <p class="text-muted small">Push khi admin/quán xác nhận voucher đổi điểm.</p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="notify-fulfill" @bind="settings.Notify_RedemptionFulfilled" />
                            </div>
                        </div>

                        <div class="feature-row" data-testid="toggle-notify-cancel">
                            <div class="feature-info">
                                <strong>Thông báo khi đổi điểm bị hủy</strong>
                                <p class="text-muted small">Push khi admin hủy đổi điểm + hoàn điểm cho khách.</p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="notify-cancel" @bind="settings.Notify_RedemptionCancelled" />
                            </div>
                        </div>

                        <div class="feature-row" data-testid="toggle-notify-expiry">
                            <div class="feature-info">
                                <strong>Thông báo voucher sắp hết hạn</strong>
                                <p class="text-muted small">Push nhắc khách dùng voucher trước khi hết hạn.</p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="notify-expiry" @bind="settings.Notify_VoucherExpiringSoon" />
                            </div>
                        </div>

                        <div class="feature-row mt-3 pt-3 border-top" data-testid="setting-voucher-expiry-hours">
                            <div class="feature-info">
                                <strong>Nhắc trước (giờ)</strong>
                                <p class="text-muted small">Số giờ trước khi voucher hết hạn để gửi push nhắc. Mặc định 24h.</p>
                            </div>
                            <div class="form-group" style="width: 120px;">
                                <input type="number" class="form-control" id="voucher-expiry-hours"
                                       min="1" max="168" step="1"
                                       @bind="settings.VoucherExpiryNotifyHours" />
                            </div>
                        </div>
                    </div>
                </VanACard>

                <div class="feature-row mt-4 pt-3 border-top" data-testid="setting-polling-interval">
                    <div class="feature-info">
                        <strong>Thời gian làm mới theo dõi đơn hàng (giây)</strong>
                        <p class="text-muted small">Khoảng thời gian KhachLink tự động cập nhật trạng thái đơn. Nên đặt từ 15s trở lên để giảm tải hệ thống. Cho phép chỉnh từ 5-120 giây.</p>
                    </div>
                    <div class="form-group" style="width: 120px;">
                        <input type="number" class="form-control" id="polling-interval"
                               min="5" max="120" step="1"
                               @bind="settings.PollingIntervalSeconds" />
                    </div>
                </div>

                <div class="form-actions mt-3">
                    <VanAButton Variant="primary" OnClick="SaveSettings" data-testid="btn-save" Loading="@_isSaving" Disabled="@_isSaving" Text="@(_isSaving ? "Đang lưu..." : "Lưu cấu hình")">
                    </VanAButton>
                </div>
            </VanACard>
        }
    }
</div>

@code {
    private ShopFeatureSettingsDto settings = new();
    private bool loading = true;
    private string? successMessage;
    private string? errorMessage;
    private bool _isSaving;
    private bool _isSystemAdmin;
    private bool _impersonating;
    private List<TenantApiDto> _tenantList = [];
    private bool _tenantListLoading;
    private string _selectedTenantId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Role check: SystemAdmin sees impersonate button
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isSystemAdmin = authState.User.IsInRole("SystemAdmin");

            // If SystemAdmin has no tenant, load tenant list for selector
            if (_isSystemAdmin && !TenantProvider.HasTenant)
            {
                _tenantListLoading = true;
                try
                {
                    _tenantList = await TenantApi.ListAllAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to load tenant list for SystemAdmin selector");
                }
                finally
                {
                    _tenantListLoading = false;
                }
                return; // Don't try to load settings without a tenant
            }

            Guid tenantId = TenantProvider.TenantId;
            settings = await SettingsService.GetSettingsAsync(tenantId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading shop feature settings");
            errorMessage = "Không thể tải cấu hình. Vui lòng thử lại.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveSettings()
    {
        _isSaving = true;
        successMessage = null;
        errorMessage = null;
        try
        {
            Guid tenantId = TenantProvider.TenantId;
            settings = await SettingsService.UpdateSettingsAsync(tenantId, settings);
            successMessage = "✅ Đã lưu cấu hình thành công.";
            // Auto-dismiss success after 5s
            _ = DismissSuccessAfterDelayAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving shop feature settings");
            errorMessage = $"❌ Không thể lưu cấu hình: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DismissSuccessAfterDelayAsync()
    {
        await Task.Delay(5000);
        successMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// SystemAdmin impersonates the tenant currently loaded in TenantProvider.
    /// POSTs /api/admin/impersonate/{tenantId} with cookie auth, then force-reloads to home
    /// so the impersonation takes effect on the auth cookie.
    /// </summary>
    private async Task ImpersonateCurrentTenantAsync()
    {
        _impersonating = true;
        try
        {
            Guid tenantId = TenantProvider.TenantId;
            var client = HttpClientFactory.CreateClient("CookieForwarding");
            var response = await client.PostAsync($"/api/admin/impersonate/{tenantId}", null);
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                errorMessage = $"Không thể impersonate tenant: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to impersonate tenant {TenantId}", TenantProvider.TenantId);
            errorMessage = $"Lỗi kết nối: {ex.Message}";
        }
        finally
        {
            _impersonating = false;
        }
    }

    /// <summary>
    /// SystemAdmin selects a tenant from the dropdown and impersonates it.
    /// POSTs /api/admin/impersonate/{tenantId}, then force-reloads to this page
    /// so the impersonation takes effect and settings load for the selected tenant.
    /// </summary>
    private async Task ImpersonateSelectedTenantAsync()
    {
        if (!Guid.TryParse(_selectedTenantId, out var tenantId) || tenantId == Guid.Empty)
        {
            errorMessage = "Vui lòng chọn tenant từ danh sách.";
            return;
        }

        _impersonating = true;
        try
        {
            var client = HttpClientFactory.CreateClient("CookieForwarding");
            var response = await client.PostAsync($"/api/admin/impersonate/{tenantId}", null);
            if (response.IsSuccessStatusCode)
            {
                // Reload to this page so impersonation takes effect + settings load
                NavigationManager.NavigateTo("/settings/shop-features", forceLoad: true);
            }
            else
            {
                errorMessage = $"Không thể impersonate tenant: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to impersonate selected tenant {TenantId}", tenantId);
            errorMessage = $"Lỗi kết nối: {ex.Message}";
        }
        finally
        {
            _impersonating = false;
        }
    }
}
