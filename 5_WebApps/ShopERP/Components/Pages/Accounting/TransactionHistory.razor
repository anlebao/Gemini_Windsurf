@page "/accounting/history"
@rendermode InteractiveServer
@layout AccountingLayout
@attribute [Authorize(Policy = "AccountingFullAccess")]
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.Shared.DTOs
@using CoreAccountingService = VanAn.CoreHub.Services
@using Microsoft.JSInterop
@using VanAn.ShopERP.Services
@using VanAn.ShopERP.Components.Accounting
@inject CoreAccountingService.IAccountingService AccountingService
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject ILogger<TransactionHistory> Logger
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="transaction-history-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Lịch Sử Giao Dịch</h1>
        <div class="header-actions">
            <VanAButton 
                Variant="secondary" 
                Size="small"
                OnClick="ExportToExcel">
                📊 Export Excel
            </VanAButton>
        </div>
    </header>

    <!-- Search & Filter Bar -->
    <VanAnSearchBar 
        Placeholder="Tìm theo diễn giải..."
        ShowFilterButton="true"
        ShowAmountFilter="true"
        OnSearch="HandleSearch"
        OnFilter="HandleFilter"
        AmountMinChanged="HandleAmountMinChanged"
        AmountMaxChanged="HandleAmountMaxChanged" />

    <!-- Period & Account Type Filter -->
    @if (showFilterPanel)
    {
        <VanACard Header="Bộ Lọc">
            <div class="filter-panel">
                <div class="filter-row">
                    <label>Từ ngày:</label>
                    <input type="date" class="form-control" value="@fromDateStr" @onchange="HandleFromDateChange" data-testid="filter-from-date" />
                </div>
                <div class="filter-row">
                    <label>Đến ngày:</label>
                    <input type="date" class="form-control" value="@toDateStr" @onchange="HandleToDateChange" data-testid="filter-to-date" />
                </div>
                <div class="filter-row">
                    <label>Loại tài khoản:</label>
                    <select class="form-select" @onchange="HandleAccountTypeChange">
                        @foreach (var opt in GetAccountTypeOptions())
                        {
                            <option value="@opt.Value" selected="@(selectedAccountType == opt.Value)">@opt.Label</option>
                        }
                    </select>
                </div>
                <div class="filter-actions">
                    <VanAButton Variant="primary" Size="small" OnClick="ApplyFilter">Áp Dụng</VanAButton>
                    <VanAButton Variant="secondary" Size="small" OnClick="ResetFilter">Reset</VanAButton>
                </div>
            </div>
        </VanACard>
    }

    <!-- Transaction DataGrid -->
    <VanACard Header="Danh Sách Giao Dịch">
        <VanAnDataGrid TItem="AccountingEntryDto" Items="@filteredTransactions" EmptyMessage="Không có giao dịch nào">
            <Columns>
                <VanAnColumn TItem="AccountingEntryDto" Title="Ngày" Width="1">
                    <Template Context="item">
                        @item.TransactionDate.ToVietnamTime().ToString("dd/MM/yyyy")
                    </Template>
                </VanAnColumn>
                <VanAnColumn TItem="AccountingEntryDto" Title="Loại" Width="1">
                    <Template Context="item">
                        @item.EntryType.ToString()
                    </Template>
                </VanAnColumn>
                <VanAnColumn TItem="AccountingEntryDto" Title="Tài Khoản" Width="1">
                    <Template Context="item">
                        @item.AccountCode
                    </Template>
                </VanAnColumn>
                <VanAnColumn TItem="AccountingEntryDto" Title="Diễn Giải" Width="3">
                    <Template Context="item">
                        @item.Description
                    </Template>
                </VanAnColumn>
                <VanAnColumn TItem="AccountingEntryDto" Title="Số Tiền" Width="1">
                    <Template Context="item">
                        <span data-testid="datagrid-cell-amount">@item.Amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</span>
                    </Template>
                </VanAnColumn>
                <VanAnColumn TItem="AccountingEntryDto" Title="Thao Tác" Width="1">
                    <Template Context="item">
                        <VanAButton Variant="secondary" Size="small" OnClick="() => ShowDetail(item)">Chi Tiết</VanAButton>
                    </Template>
                </VanAnColumn>
            </Columns>
        </VanAnDataGrid>
    </VanACard>

    <!-- Transaction Detail Modal -->
    @if (showDetailModal)
    {
        <VanAModal
            Title="Chi Tiết Giao Dịch"
            IsVisible="true"
            OnClose="CloseDetailModal">
            <Body>
                <div class="transaction-detail">
                    <div class="detail-row">
                        <label>Ngày:</label>
                        <span>@selectedTransaction?.TransactionDate.ToVietnamTime().ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="detail-row">
                        <label>Loại:</label>
                        <span>@selectedTransaction?.EntryType</span>
                    </div>
                    <div class="detail-row">
                        <label>Tài Khoản:</label>
                        <span>@selectedTransaction?.AccountCode</span>
                    </div>
                    <div class="detail-row">
                        <label>Số Tiền:</label>
                        <span>@selectedTransaction?.Amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</span>
                    </div>
                    <div class="detail-row">
                        <label>Diễn Giải:</label>
                        <span>@selectedTransaction?.Description</span>
                    </div>
                    @* SRS v1.2 W2/C1: số chứng từ tuần tự (ưu tiên) → fallback Reference như cũ *@
                    @if (!string.IsNullOrEmpty(selectedTransaction?.VoucherNumber))
                    {
                        <div class="detail-row">
                            <label>Số Phiếu:</label>
                            <span>@selectedTransaction.VoucherNumber</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(selectedTransaction?.Reference))
                    {
                        <div class="detail-row">
                            <label>Số Chứng Từ:</label>
                            <span>@selectedTransaction.Reference</span>
                        </div>
                    }
                    @* Task card 2026-11-01 (P1c): in lại phiếu thu/chi từ lịch sử —
                       rebuild voucher từ DTO (không có Địa chỉ/Kèm theo → để trống). *@
                    @if (PrintableKind(selectedTransaction) != VoucherPrintKind.None)
                    {
                        <div class="detail-row mt-3">
                            <VanAButton Variant="success" Size="small" OnClick="OpenVoucherPrint" data-testid="print-voucher-btn">
                                🖨️ In phiếu @(PrintableKind(selectedTransaction) == VoucherPrintKind.Receipt01TT ? "(01-TT)" : "(02-TT)")
                            </VanAButton>
                        </div>
                    }
                </div>
            </Body>
        </VanAModal>
    }

    @* Print modal — mẫu 01-TT (phiếu thu) / 02-TT (phiếu chi) *@
    <VanAnModal IsOpen="@_showVoucherModal" Title="@_voucherModalTitle" Closable="true" OnClose="CloseVoucherModal">
        @if (_voucher != null && _printKind == VoucherPrintKind.Receipt01TT)
        {
            <Tt71ReceiptVoucher SoPhieu="@_voucher.SoPhieu" Ngay="@_voucher.Ngay"
                                No="@_voucher.No" Co="@_voucher.Co"
                                NguoiNop="@_voucher.Nguoi" DiaChi=""
                                LyDo="@_voucher.LyDo" SoTien="@_voucher.SoTien"
                                KemTheo="" ChungTuGoc="@_voucher.ChungTuGoc" />
        }
        else if (_voucher != null && _printKind == VoucherPrintKind.Payment02TT)
        {
            <Tt71PaymentVoucher SoPhieu="@_voucher.SoPhieu" Ngay="@_voucher.Ngay"
                                No="@_voucher.No" Co="@_voucher.Co"
                                NguoiNhan="@_voucher.Nguoi" DiaChi=""
                                LyDo="@_voucher.LyDo" SoTien="@_voucher.SoTien"
                                KemTheo="" ChungTuGoc="@_voucher.ChungTuGoc" />
        }
    </VanAnModal>
</div>

@code {
    private List<AccountingEntryDto> transactions = new();
    private List<AccountingEntryDto> filteredTransactions = new();
    private string searchTerm = string.Empty;
    private bool showFilterPanel = false;
    private DateTime? fromDate;
    private DateTime? toDate;
    private string selectedAccountType = string.Empty;
    private decimal? amountMin;
    private decimal? amountMax;
    private bool showDetailModal = false;
    private AccountingEntryDto? selectedTransaction;

    // Task card 2026-11-01 (P1c): in lại phiếu thu 01-TT / chi 02-TT từ detail modal.
    private enum VoucherPrintKind { None, Receipt01TT, Payment02TT }
    private record VoucherData(string SoPhieu, string Ngay, string No, string Co,
        string Nguoi, string LyDo, decimal SoTien, string ChungTuGoc);
    private VoucherData? _voucher;
    private VoucherPrintKind _printKind = VoucherPrintKind.None;
    private bool _showVoucherModal;
    private string _voucherModalTitle = string.Empty;

    private string fromDateStr => fromDate?.ToString("yyyy-MM-dd") ?? "";
    private string toDateStr => toDate?.ToString("yyyy-MM-dd") ?? "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Default: current month range
            var now = DateTime.Now;
            fromDate = new DateTime(now.Year, now.Month, 1);
            toDate = new DateTime(now.Year, now.Month, DateTime.DaysInMonth(now.Year, now.Month));
            await LoadTransactions();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing TransactionHistory");
        }
    }

    private async Task LoadTransactions()
    {
        try
        {
            if (!TenantProvider.HasTenant)
            {
                Logger.LogWarning("TransactionHistory: no tenant context — skipping load");
                return;
            }

            var tenantId = TenantProvider.TenantId;

            // Use date range if both dates are set, otherwise load all for tenant
            IEnumerable<AccountingEntryDto> entries;
            if (fromDate.HasValue && toDate.HasValue)
            {
                // Convert local date to UTC range (start of from-date to end of to-date)
                DateTime startUtc = fromDate.Value.Date;
                DateTime endUtc = toDate.Value.Date.AddDays(1);
                entries = await AccountingService.GetEntriesByDateRangeAsync(tenantId, startUtc, endUtc);
            }
            else
            {
                var tid = new TenantId(tenantId);
                entries = await AccountingService.GetEntriesByTenantAsync(tid);
            }

            transactions = entries.ToList();
            Logger.LogInformation("LoadTransactions: tenant={TenantId}, range={From}..{To}, count={Count}",
                tenantId, fromDate, toDate, transactions.Count);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading transactions for tenant {TenantId}", TenantProvider.TenantId);
        }
    }

    private void HandleSearch(string searchValue)
    {
        searchTerm = searchValue;
        ApplyFilters();
    }

    private void HandleFilter()
    {
        showFilterPanel = !showFilterPanel;
    }

    private void HandleAmountMinChanged(decimal? value)
    {
        amountMin = value;
        ApplyFilters();
    }

    private void HandleAmountMaxChanged(decimal? value)
    {
        amountMax = value;
        ApplyFilters();
    }

    private void HandleFromDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            fromDate = date.Date;
        }
    }

    private void HandleToDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            toDate = date.Date;
        }
    }

    private void HandleAccountTypeChange(ChangeEventArgs e)
    {
        selectedAccountType = e.Value?.ToString() ?? string.Empty;
    }

    private async Task ApplyFilter()
    {
        await LoadTransactions();
    }

    private void ResetFilter()
    {
        var now = DateTime.Now;
        fromDate = new DateTime(now.Year, now.Month, 1);
        toDate = new DateTime(now.Year, now.Month, DateTime.DaysInMonth(now.Year, now.Month));
        selectedAccountType = string.Empty;
        amountMin = null;
        amountMax = null;
        searchTerm = string.Empty;
        showFilterPanel = false;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        filteredTransactions = transactions;

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredTransactions = filteredTransactions
                .Where(t => t.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        if (!string.IsNullOrEmpty(selectedAccountType))
        {
            filteredTransactions = selectedAccountType switch
            {
                "Revenue" => filteredTransactions.Where(t => t.EntryType == AccountingEntryType.Revenue).ToList(),
                "Expense" => filteredTransactions.Where(t => t.EntryType == AccountingEntryType.Expense).ToList(),
                _ => filteredTransactions
            };
        }

        if (amountMin.HasValue)
        {
            filteredTransactions = filteredTransactions.Where(t => t.Amount >= amountMin.Value).ToList();
        }

        if (amountMax.HasValue)
        {
            filteredTransactions = filteredTransactions.Where(t => t.Amount <= amountMax.Value).ToList();
        }
    }

    private List<FieldOption> GetAccountTypeOptions() => new()
    {
        new FieldOption { Value = "", Label = "Tất cả loại" },
        new FieldOption { Value = "Revenue", Label = "Doanh thu (5xx)" },
        new FieldOption { Value = "Expense", Label = "Chi phí (6xx)" }
    };

    private void ShowDetail(AccountingEntryDto transaction)
    {
        selectedTransaction = transaction;
        showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedTransaction = null;
    }

    /// <summary>
    /// Task card 2026-11-01 (P1c): entry nào in được phiếu tiền —
    /// Revenue → 01-TT · Expense → 02-TT · Adjustment âm 131 → 01-TT (thu nợ) ·
    /// Adjustment âm 331 → 02-TT (trả nợ). KHÔNG in: bút toán đảo (ReversalEntryId),
    /// ghi nhận nợ non-cash (Adjustment dương), DepositOffset, VAT-133.
    /// </summary>
    private static VoucherPrintKind PrintableKind(AccountingEntryDto? t)
    {
        if (t is null || t.ReversalEntryId.HasValue)
        {
            return VoucherPrintKind.None;
        }
        return t switch
        {
            { EntryType: AccountingEntryType.Revenue } => VoucherPrintKind.Receipt01TT,
            { EntryType: AccountingEntryType.Expense } => VoucherPrintKind.Payment02TT,
            { EntryType: AccountingEntryType.Adjustment, Amount: < 0, AccountCode: "131" } => VoucherPrintKind.Receipt01TT,
            { EntryType: AccountingEntryType.Adjustment, Amount: < 0, AccountCode: "331" } => VoucherPrintKind.Payment02TT,
            _ => VoucherPrintKind.None
        };
    }

    private void OpenVoucherPrint()
    {
        if (selectedTransaction == null)
        {
            return;
        }
        _printKind = PrintableKind(selectedTransaction);
        if (_printKind == VoucherPrintKind.None)
        {
            return;
        }

        AccountingEntryDto t = selectedTransaction;
        bool isReceipt = _printKind == VoucherPrintKind.Receipt01TT;
        _voucher = new VoucherData(
            SoPhieu: t.VoucherNumber ?? t.Reference ?? string.Empty,
            Ngay: t.TransactionDate.ToVietnamTime().ToString("dd/MM/yyyy"),
            No: isReceipt ? (t.CashAccountCode ?? "111") : t.AccountCode,
            Co: isReceipt ? t.AccountCode : (t.CashAccountCode ?? "111"),
            Nguoi: t.Vendor ?? string.Empty,
            LyDo: t.Description,
            SoTien: Math.Abs(t.Amount),
            ChungTuGoc: t.Reference ?? string.Empty);
        _voucherModalTitle = isReceipt ? "Phiếu Thu (Mẫu số 01 - TT)" : "Phiếu Chi (Mẫu số 02 - TT)";
        _showVoucherModal = true;
    }

    private void CloseVoucherModal()
    {
        _showVoucherModal = false;
    }

    private async Task ExportToExcel()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("Ngay,Loai,Tai khoan,So tien,Dien giai,So chung tu");
            foreach (var t in filteredTransactions)
            {
                var date = t.TransactionDate.ToVietnamTime().ToString("dd/MM/yyyy");
                var type = t.EntryType.ToString();
                var acct = t.AccountCode ?? "";
                var amt = t.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var desc = EscapeCsv(t.Description);
                var refNo = EscapeCsv(t.Reference);
                sb.AppendLine(date + "," + type + "," + acct + "," + amt + "," + desc + "," + refNo);
            }

            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            string base64 = Convert.ToBase64String(bytes);
            string fileName = "transactions_" + (fromDate?.ToString("yyyyMMdd") ?? "all") + "_" + (toDate?.ToString("yyyyMMdd") ?? "all") + ".csv";
            await JSRuntime.InvokeVoidAsync("vanAn.downloadFile", base64, "text/csv", fileName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting transactions to CSV");
        }
    }

    private static string EscapeCsv(string? field)
    {
        if (string.IsNullOrEmpty(field)) return string.Empty;
        bool needsQuote = field.Contains(',') || field.Contains('"') || field.Contains('\n');
        if (!needsQuote) return field;
        string escaped = field.Replace("\"", "\"\"");
        return "\"" + escaped + "\"";
    }
}
