@page "/accounting/bank-book"
@rendermode InteractiveServer
@layout AccountingLayout
@attribute [Authorize(Policy = "AccountingFullAccess")]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.CoreHub.Services
@using VanAn.CoreHub.Services.GeneralLedger
@using VanAn.CoreHub.Services.Reconcile
@using VanAn.CoreHub.Infrastructure.Entities
@inject IGeneralLedgerService GeneralLedgerService
@inject IBankAccountService BankAccountService
@inject IBankStatementService BankStatementService
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject IJSRuntime JSRuntime
@inject ILogger<BankBook> Logger

@* SRS v1.2 W3/D (FR-RPT-004): Sổ tiền gửi ngân hàng — per BankAccount (112x), running balance. *@
<div class="report-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Sổ Tiền Gửi Ngân Hàng (TK 112x)</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="PrintReport" Disabled="@(report == null)">
                🖨️ In báo cáo
            </VanAButton>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }

    <VanACard Header="Kỳ báo cáo & tài khoản ngân hàng">
        <div class="period-picker-row">
            <label>Năm: <input type="number" min="2000" max="2100" @bind="selectedYear" /></label>
            <label>Tháng:
                <select @bind="selectedMonth">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </label>
            <label>Tài khoản:
                <select @bind="selectedAccountCode">
                    @foreach (var acc in bankAccounts)
                    {
                        <option value="@acc.AccountCode">@acc.AccountCode — @acc.DisplayName@(acc.BankName is null ? "" : $" ({acc.BankName})")</option>
                    }
                </select>
            </label>
            <VanAButton Variant="primary" Size="small" OnClick="LoadReport" Disabled="@(bankAccounts.Count == 0)">Áp dụng</VanAButton>
        </div>
        @if (bankAccounts.Count == 0 && !loading)
        {
            <p class="text-muted mt-2 mb-0">Chưa có tài khoản ngân hàng — thêm TK 112x bên dưới để xem sổ TGNH.</p>
        }
    </VanACard>

    @* Quản lý TK tiền: danh sách + thêm TK 112x (quỹ 111 seed sẵn, không cho vô hiệu). *@
    <VanACard Header="Tài khoản tiền của đơn vị">
        <div class="mb-3">
            <VanAButton Variant="secondary" Size="small" OnClick="() => _showAddForm = !_showAddForm" data-testid="bankbook-toggle-add">
                @(_showAddForm ? "− Ẩn form" : "＋ Thêm tài khoản ngân hàng")
            </VanAButton>
        </div>

        @if (_showAddForm)
        {
            <div class="row g-2 mb-3" data-testid="bankbook-add-form">
                <div class="col-md-2">
                    <label class="form-label small">Mã TK <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="_newCode" placeholder="1121" data-testid="bankbook-add-code" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Tên hiển thị <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="_newName" placeholder="TK Vietcombank chính" data-testid="bankbook-add-name" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Ngân hàng</label>
                    <input class="form-control" @bind="_newBank" placeholder="Vietcombank" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Số TK</label>
                    <input class="form-control" @bind="_newNumber" placeholder="0011xxxxxx" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <VanAButton Variant="primary" Size="small" OnClick="CreateAccountAsync"
                                Disabled="@_savingAccount" data-testid="bankbook-add-submit">
                        @(_savingAccount ? "Đang lưu..." : "Lưu")
                    </VanAButton>
                </div>
            </div>
            @if (_accountError != null)
            {
                <VanAAlert Type="error" Message="@_accountError" Dismissible="true" OnDismiss="() => _accountError = null" />
            }
        }

        <VanAnDataGrid TItem="BankAccountEntity" Items="@allAccounts" EmptyMessage="Chưa có tài khoản tiền">
            <Columns>
                <VanAnColumn TItem="BankAccountEntity" Title="Mã TK" Width="2">
                    <Template Context="a"><span><strong>@a.AccountCode</strong></span></Template>
                </VanAnColumn>
                <VanAnColumn TItem="BankAccountEntity" Title="Tên hiển thị" Width="4">
                    <Template Context="a"><span>@a.DisplayName</span></Template>
                </VanAnColumn>
                <VanAnColumn TItem="BankAccountEntity" Title="Ngân hàng" Width="3">
                    <Template Context="a"><span>@(a.BankName ?? "—")</span></Template>
                </VanAnColumn>
                <VanAnColumn TItem="BankAccountEntity" Title="Số TK" Width="2">
                    <Template Context="a"><span>@(a.AccountNumber ?? "—")</span></Template>
                </VanAnColumn>
                <VanAnColumn TItem="BankAccountEntity" Title="Trạng thái" Width="2">
                    <Template Context="a">
                        <span class="badge @(a.IsActive ? "text-bg-success" : "text-bg-secondary")">@(a.IsActive ? "Đang dùng" : "Vô hiệu")</span>
                    </Template>
                </VanAnColumn>
                <VanAnColumn TItem="BankAccountEntity" Title="" Width="2">
                    <Template Context="a">
                        @if (a.IsActive && a.AccountCode != "111")
                        {
                            <VanAButton Variant="secondary" Size="small" OnClick="() => DeactivateAccountAsync(a.Id)">Vô hiệu</VanAButton>
                        }
                    </Template>
                </VanAnColumn>
            </Columns>
        </VanAnDataGrid>
    </VanACard>

    @* W5/F (FR-RECNC-001): đối chiếu sao kê ngân hàng — import CSV + match report
       vs journal lines trên TK 112x. KHÔNG auto-post entry (unmatched xử lý thủ công). *@
    @if (bankAccounts.Count > 0)
    {
        <VanACard Header="Đối chiếu sao kê ngân hàng">
            <p class="small text-muted">
                Import file sao kê CSV định dạng <code>Ngày,Số tiền,Số tham chiếu,Diễn giải</code>
                (ngày dd/MM/yyyy hoặc yyyy-MM-dd; tiền vào dương, tiền ra âm) rồi bấm
                <strong>Đối chiếu</strong> để khớp với sổ TK <strong>@selectedAccountCode</strong>.
            </p>
            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                <InputFile OnChange="OnStatementFileSelected" accept=".csv,text/csv"
                           data-testid="bankstmt-file-input" />
                @if (_stmtFileName != null)
                {
                    <VanAButton Variant="primary" Size="small" OnClick="ImportStatementAsync"
                                Disabled="@_stmtBusy" data-testid="bankstmt-import">
                        @(_stmtBusy ? "Đang import..." : "Import sao kê")
                    </VanAButton>
                }
                <VanAButton Variant="secondary" Size="small" OnClick="ReconcileStatementAsync"
                            Disabled="@_stmtBusy" data-testid="bankstmt-reconcile">
                    @(_stmtBusy ? "Đang đối chiếu..." : "Đối chiếu")
                </VanAButton>
            </div>
            @if (_stmtMessage != null)
            {
                <VanAAlert Type="@(_stmtError ? "error" : "success")" Message="@_stmtMessage"
                           Dismissible="true" OnDismiss="() => _stmtMessage = null" />
            }
            @if (_stmtReport != null)
            {
                <div class="d-flex align-items-center gap-3 mb-2" data-testid="bankstmt-report">
                    <span class="badge text-bg-success">Đã khớp @_stmtReport.MatchedCount/@_stmtReport.TotalStatementLines dòng</span>
                    <span class="badge @(_stmtReport.UnmatchedStatementLines.Count > 0 ? "text-bg-warning" : "text-bg-secondary")">
                        @_stmtReport.UnmatchedStatementLines.Count dòng sao kê chưa khớp
                    </span>
                    <span class="badge @(_stmtReport.UnmatchedJournalLineIds.Count > 0 ? "text-bg-warning" : "text-bg-secondary")">
                        @_stmtReport.UnmatchedJournalLineIds.Count dòng sổ chưa khớp
                    </span>
                </div>
                @if (_stmtReport.UnmatchedStatementLines.Count > 0)
                {
                    <p class="small text-muted mb-1">Dòng sao kê chưa khớp — kiểm tra và tạo phiếu thủ công nếu cần:</p>
                    <table class="table table-sm table-striped" data-testid="bankstmt-unmatched-table">
                        <thead class="table-light">
                            <tr><th>Ngày</th><th class="text-end">Số tiền</th><th>Tham chiếu</th><th>Diễn giải</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _stmtReport.UnmatchedStatementLines)
                            {
                                <tr data-testid="bankstmt-unmatched-row">
                                    <td>@line.TxnDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@line.Amount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</td>
                                    <td>@(line.Reference ?? "—")</td>
                                    <td>@(line.Description ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </VanACard>
    }

    @if (loading)
    {
        <VanACard Header="Đang tải">
            <p>Đang tải Sổ TGNH...</p>
        </VanACard>
    }
    else if (report != null)
    {
        <VanACard Header="@($"Sổ tiền gửi ngân hàng {report.AccountCode} {report.AccountName ?? ""} — tháng {selectedMonth:D2}/{selectedYear}")">
            <div class="totals-row">
                <strong>Dư đầu kỳ:</strong> <span>@report.OpeningBalance.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                <strong>Tổng thu:</strong> <span>@report.PeriodDebitTotal.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                <strong>Tổng chi:</strong> <span>@report.PeriodCreditTotal.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                <strong>Dư cuối kỳ:</strong> <span>@report.ClosingBalance.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
            </div>
            <VanAnDataGrid TItem="SubLedgerRowDto" Items="@report.Rows" EmptyMessage="Không có phát sinh trong kỳ">
                <Columns>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Ngày" Width="2">
                        <Template Context="r">
                            <span>@r.EntryDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Số CT" Width="2">
                        <Template Context="r">
                            <span>@r.JournalNo</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Diễn giải" Width="4">
                        <Template Context="r">
                            <span>@r.Description</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="TK ĐƯ" Width="1">
                        <Template Context="r">
                            <span>@r.CounterpartAccount</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Thu" Width="2">
                        <Template Context="r">
                            <span>@(r.Debit > 0 ? r.Debit.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) : "")</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Chi" Width="2">
                        <Template Context="r">
                            <span>@(r.Credit > 0 ? r.Credit.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) : "")</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Dư" Width="2">
                        <Template Context="r">
                            <span>@r.RunningBalance.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>
    }
</div>

@code {
    private List<BankAccountEntity> bankAccounts = new();
    private List<BankAccountEntity> allAccounts = new();
    private SubLedgerReportDto? report;
    private bool loading = true;
    private string? errorMessage;
    private int selectedYear = DateTime.UtcNow.Year;
    private int selectedMonth = DateTime.UtcNow.Month;
    private string selectedAccountCode = "";

    // Quản lý TK tiền
    private bool _showAddForm;
    private bool _savingAccount;
    private string _newCode = "";
    private string _newName = "";
    private string _newBank = "";
    private string _newNumber = "";
    private string? _accountError;

    // W5/F (FR-RECNC-001): sao kê ngân hàng
    private const long MaxStatementSize = 2 * 1024 * 1024; // 2MB
    private string? _stmtFileName;
    private string? _stmtCsv;
    private bool _stmtBusy;
    private bool _stmtError;
    private string? _stmtMessage;
    private BankReconcileReport? _stmtReport;

    protected override async Task OnInitializedAsync()
    {
        await LoadBankAccounts();
        if (bankAccounts.Count > 0)
        {
            selectedAccountCode = bankAccounts[0].AccountCode;
            await LoadReport();
        }
        else
        {
            loading = false;
        }
    }

    private async Task LoadBankAccounts()
    {
        try
        {
            if (!TenantProvider.HasTenant) return;
            TenantId tenantId = new(TenantProvider.TenantId);
            allAccounts = (await BankAccountService.ListAsync(tenantId, includeInactive: true)).ToList();
            bankAccounts = allAccounts
                .Where(b => b.IsActive && b.AccountCode.StartsWith("112"))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading bank accounts");
            errorMessage = $"Lỗi tải danh sách TK ngân hàng: {ex.Message}";
        }
    }

    private async Task CreateAccountAsync()
    {
        _accountError = null;
        if (!TenantProvider.HasTenant) return;
        _savingAccount = true;
        try
        {
            await BankAccountService.CreateAsync(new TenantId(TenantProvider.TenantId),
                _newCode, _newName,
                string.IsNullOrWhiteSpace(_newBank) ? null : _newBank,
                string.IsNullOrWhiteSpace(_newNumber) ? null : _newNumber);
            _newCode = _newName = _newBank = _newNumber = "";
            _showAddForm = false;
            await LoadBankAccounts();
            if (string.IsNullOrEmpty(selectedAccountCode) && bankAccounts.Count > 0)
            {
                selectedAccountCode = bankAccounts[0].AccountCode;
                await LoadReport();
            }
        }
        catch (Exception ex)
        {
            _accountError = ex.Message;
        }
        finally
        {
            _savingAccount = false;
        }
    }

    private async Task DeactivateAccountAsync(Guid id)
    {
        _accountError = null;
        try
        {
            await BankAccountService.DeactivateAsync(id);
            await LoadBankAccounts();
        }
        catch (Exception ex)
        {
            _accountError = ex.Message;
        }
    }

    private async Task LoadReport()
    {
        if (string.IsNullOrWhiteSpace(selectedAccountCode)) return;
        loading = true;
        errorMessage = null;
        report = null;
        try
        {
            if (!TenantProvider.HasTenant)
            {
                errorMessage = "Không xác định được tenant. Vui lòng đăng nhập lại.";
                return;
            }
            TenantId tenantId = new(TenantProvider.TenantId);
            report = await GeneralLedgerService.GetSubLedgerAsync(
                tenantId, selectedYear, selectedMonth, selectedAccountCode);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading bank book for {Year}-{Month} TK {Account}", selectedYear, selectedMonth, selectedAccountCode);
            errorMessage = $"Lỗi tải Sổ TGNH: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    // ── W5/F (FR-RECNC-001): sao kê ngân hàng — import CSV + đối chiếu ────────

    private BankAccountEntity? SelectedBankAccount =>
        bankAccounts.FirstOrDefault(b => b.AccountCode == selectedAccountCode);

    private async Task OnStatementFileSelected(InputFileChangeEventArgs e)
    {
        _stmtMessage = null;
        _stmtError = false;
        if (e.File == null)
        {
            return;
        }
        if (!e.File.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            _stmtError = true;
            _stmtMessage = "Chỉ nhận file .csv.";
            _stmtFileName = null;
            _stmtCsv = null;
            return;
        }
        try
        {
            await using Stream stream = e.File.OpenReadStream(MaxStatementSize);
            using var reader = new StreamReader(stream);
            _stmtCsv = await reader.ReadToEndAsync();
            _stmtFileName = e.File.Name;
            _stmtMessage = $"Đã đọc file {e.File.Name} — bấm Import sao kê để ghi {_stmtCsv.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length} dòng.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Statement file read failed");
            _stmtError = true;
            _stmtMessage = $"Lỗi đọc file: {ex.Message}";
            _stmtFileName = null;
            _stmtCsv = null;
        }
    }

    private async Task ImportStatementAsync()
    {
        if (!TenantProvider.HasTenant || SelectedBankAccount is not { } account || _stmtCsv is null)
        {
            return;
        }
        _stmtBusy = true;
        _stmtMessage = null;
        _stmtError = false;
        try
        {
            int imported = await BankStatementService.ImportCsvAsync(
                new TenantId(TenantProvider.TenantId), account.Id, _stmtCsv);
            _stmtMessage = $"Đã import {imported} dòng sao kê cho TK {account.AccountCode}.";
            _stmtFileName = null;
            _stmtCsv = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Statement import failed");
            _stmtError = true;
            _stmtMessage = $"Lỗi import sao kê: {ex.Message}";
        }
        finally
        {
            _stmtBusy = false;
        }
    }

    private async Task ReconcileStatementAsync()
    {
        if (!TenantProvider.HasTenant || SelectedBankAccount is not { } account)
        {
            return;
        }
        _stmtBusy = true;
        _stmtMessage = null;
        _stmtError = false;
        try
        {
            _stmtReport = await BankStatementService.ReconcileAsync(
                new TenantId(TenantProvider.TenantId), account.Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Statement reconcile failed");
            _stmtError = true;
            _stmtMessage = $"Lỗi đối chiếu: {ex.Message}";
        }
        finally
        {
            _stmtBusy = false;
        }
    }

    private async Task PrintReport() => await JSRuntime.InvokeVoidAsync("vananPrintBill");
}
