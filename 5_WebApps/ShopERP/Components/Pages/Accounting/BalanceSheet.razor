@page "/accounting/balance-sheet"
@rendermode InteractiveServer
@layout AccountingLayout
@attribute [Authorize(Policy = "AccountingFullAccess")]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.ShopERP.Services.Accounting
@inject VanAn.CoreHub.Services.IBalanceSheetService BalanceSheetService
@inject VanAn.ShopERP.Services.IFinancialReportExportService ExportService
@inject IAccountingStandardSelectionService StandardSelection
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject IJSRuntime JSRuntime
@inject ILogger<BalanceSheet> Logger

<div class="report-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Báo Cáo Tình Hình Tài Chính</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="GenerateReport">
                🔄 Tạo báo cáo
            </VanAButton>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }

    @if (_allowedStandards is { Count: 0 })
    {
        <VanACard Header="Không áp dụng">
            <VanAAlert Type="info" Dismissible="false"
                Message="Hộ kinh doanh áp dụng sổ sách theo TT 152/2025/TT-BTC — hoặc tự nguyện áp dụng TT 58/2026 (Điều 2.2). Báo cáo tài chính doanh nghiệp không áp dụng cho HKD." />
            <a href="/accounting/hkd-books">📚 Mở Sổ HKD (TT 152)</a>
        </VanACard>
    }
    else
    {
    <VanACard Header="Kỳ báo cáo">
        <div class="period-picker-row">
            <label>Năm: <input type="number" min="2000" max="2100" @bind="selectedYear" /></label>
            <label>Tháng:
                <select @bind="selectedMonth">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </label>
            <label>Chuẩn kế toán:
                @if (_allowedStandards is { Count: 1 })
                {
                    <span>@AccountingStandardResolver.DropdownLabel(_allowedStandards[0])</span>
                }
                else
                {
                    <select @bind="selectedStandard">
                        @foreach (var s in _allowedStandards ?? _allStandards)
                        {
                            <option value="@s">@AccountingStandardResolver.DropdownLabel(s)</option>
                        }
                    </select>
                }
                @if (_isVoluntary)
                {
                    <small>(tự nguyện)</small>
                }
            </label>
            <VanAButton Variant="primary" Size="small" OnClick="GenerateReport">Áp dụng</VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="ExportDocx" Disabled="@exporting">📄 Xuất DOCX</VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="ExportXlsx" Disabled="@exporting">📊 Xuất XLSX</VanAButton>
        </div>
    </VanACard>
    }

    @if (loading)
    {
        <VanACard Header="Đang tạo báo cáo">
            <p>Đang tạo Báo Cáo Tình Hình Tài Chính cho kỳ @selectedMonth/@selectedYear...</p>
        </VanACard>
    }
    else if (report != null)
    {
        <!-- TÀI SẢN -->
        <VanACard Header="TÀI SẢN">
            <VanAnDataGrid TItem="FinancialStatementLine" Items="@report.Assets" EmptyMessage="Không có dữ liệu">
                <Columns>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Mã chỉ tiêu" Width="2">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px">@line.ReportItemCode</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Tên chỉ tiêu" Width="6">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px; font-weight:@(line.Level == 1 ? "bold" : "normal")">@line.ReportItemName</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số cuối kỳ" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.EndingAmount, line.IsNormalNegative)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số đầu năm" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.OpeningAmount, line.IsNormalNegative)</span>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
            <div class="totals-row">
                <strong>Tổng cộng tài sản:</strong>
                <span>@FormatAmount(report.TotalAssetsEnding, false)</span>
                <span>@FormatAmount(report.TotalAssetsOpening, false)</span>
            </div>
        </VanACard>

        <!-- NỢ PHẢI TRẢ -->
        <VanACard Header="NỢ PHẢI TRẢ">
            <VanAnDataGrid TItem="FinancialStatementLine" Items="@report.Liabilities" EmptyMessage="Không có dữ liệu">
                <Columns>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Mã chỉ tiêu" Width="2">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px">@line.ReportItemCode</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Tên chỉ tiêu" Width="6">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px; font-weight:@(line.Level == 1 ? "bold" : "normal")">@line.ReportItemName</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số cuối kỳ" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.EndingAmount, line.IsNormalNegative)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số đầu năm" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.OpeningAmount, line.IsNormalNegative)</span>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>

        <!-- VỐN CHỦ SỞ HỮU -->
        <VanACard Header="VỐN CHỦ SỞ HỮU">
            <VanAnDataGrid TItem="FinancialStatementLine" Items="@report.Equity" EmptyMessage="Không có dữ liệu">
                <Columns>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Mã chỉ tiêu" Width="2">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px">@line.ReportItemCode</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Tên chỉ tiêu" Width="6">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px; font-weight:@(line.Level == 1 ? "bold" : "normal")">@line.ReportItemName</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số cuối kỳ" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.EndingAmount, line.IsNormalNegative)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số đầu năm" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.OpeningAmount, line.IsNormalNegative)</span>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
            <div class="totals-row">
                <strong>Tổng cộng Nợ phải trả + Vốn CSH:</strong>
                <span>@FormatAmount(report.TotalLiabilitiesAndEquityEnding, false)</span>
                <span>@FormatAmount(report.TotalLiabilitiesAndEquityOpening, false)</span>
            </div>
        </VanACard>
    }
</div>

@code {
    private VanAn.Shared.Domain.BalanceSheet? report;
    private bool loading = true;
    private bool exporting;
    private string? errorMessage;

    private int selectedYear = DateTime.UtcNow.Year;
    private int selectedMonth = DateTime.UtcNow.Month;
    private AccountingStandard selectedStandard = AccountingStandard.TT133_2016;
    // Regime-lock (2026-10-30): allowed=null → chưa load (fallback đủ 4); Count=0 → BCTC không áp dụng (HKD).
    private IReadOnlyList<AccountingStandard>? _allowedStandards;
    private static readonly AccountingStandard[] _allStandards =
        [AccountingStandard.TT133_2016, AccountingStandard.TT99_2025, AccountingStandard.TT71_2024, AccountingStandard.TT58_2026];
    private bool _isVoluntary;

    protected override async Task OnInitializedAsync()
    {
        if (TenantProvider.HasTenant)
        {
            try
            {
                var sel = await StandardSelection.GetAsync(new TenantId(TenantProvider.TenantId));
                _allowedStandards = sel.Allowed;
                if (sel.Effective is { } eff) selectedStandard = eff;
                _isVoluntary = sel.IsVoluntary;
            }
            catch { /* fallback TT133 + đủ 4 option */ }
        }
        if (_allowedStandards is { Count: 0 })
        {
            loading = false;
            return;
        }
        await GenerateReport();
    }

    private async Task GenerateReport()
    {
        loading = true;
        errorMessage = null;
        try
        {
            if (!TenantProvider.HasTenant)
            {
                errorMessage = "Không xác định được tenant. Vui lòng đăng nhập lại.";
                return;
            }

            if (_allowedStandards is { Count: > 0 } && !_allowedStandards.Contains(selectedStandard))
            {
                selectedStandard = _allowedStandards[0];
            }
            TenantId tenantId = new(TenantProvider.TenantId);
            var period = new AccountingPeriod(selectedYear, selectedMonth);
            report = await BalanceSheetService.GenerateAsync(tenantId, period, selectedStandard, CancellationToken.None);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "BS invariant violated for period {Year}-{Month}", selectedYear, selectedMonth);
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating Balance Sheet for period {Year}-{Month}", selectedYear, selectedMonth);
            errorMessage = "Không thể tạo Báo Cáo Tình Hình Tài Chính. Vui lòng thử lại.";
        }
        finally
        {
            loading = false;
        }
    }

    private static string FormatAmount(decimal amount, bool isNormalNegative)
    {
        var vn = CultureInfo.GetCultureInfo("vi-VN");
        if (isNormalNegative && amount < 0)
            return $"({Math.Abs(amount).ToString("N0", vn)})";
        return amount.ToString("N0", vn);
    }

    private async Task ExportDocx()
    {
        if (report == null) return;
        await DownloadFile(async () =>
        {
            var sections = new List<(string, IReadOnlyList<FinancialStatementLine>)>
            {
                ("TÀI SẢN", report.Assets.ToList()),
                ("NỢ PHẢI TRẢ", report.Liabilities.ToList()),
                ("VỐN CHỦ SỞ HỮU", report.Equity.ToList())
            };
            return await ExportService.ExportStatementToDocxAsync(AccountingFormLabels.ExportTitle(selectedStandard, "BS", "Báo Cáo Tình Hình Tài Chính"), $"Tháng {selectedMonth:D2}/{selectedYear}", sections);
        }, $"BalanceSheet_{selectedYear}_{selectedMonth:D2}.docx");
    }

    private async Task ExportXlsx()
    {
        if (report == null) return;
        await DownloadFile(async () =>
        {
            var sections = new List<(string, IReadOnlyList<FinancialStatementLine>)>
            {
                ("TÀI SẢN", report.Assets.ToList()),
                ("NỢ PHẢI TRẢ", report.Liabilities.ToList()),
                ("VỐN CHỦ SỞ HỮU", report.Equity.ToList())
            };
            return await ExportService.ExportStatementToXlsxAsync(AccountingFormLabels.ExportTitle(selectedStandard, "BS", "Báo Cáo Tình Hình Tài Chính"), $"Tháng {selectedMonth:D2}/{selectedYear}", sections);
        }, $"BalanceSheet_{selectedYear}_{selectedMonth:D2}.xlsx");
    }

    private async Task DownloadFile(Func<Task<byte[]>> produce, string fileName)
    {
        exporting = true;
        try
        {
            byte[] bytes = await produce();
            string base64 = Convert.ToBase64String(bytes);
            string mime = fileName.EndsWith(".docx") ? "application/vnd.openxmlformats-officedocument.wordprocessingml.document" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            await JSRuntime.InvokeVoidAsync("vanAn.downloadFile", base64, mime, fileName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting {FileName}", fileName);
            errorMessage = $"Không thể xuất file: {ex.Message}";
        }
        finally
        {
            exporting = false;
        }
    }
}
