@page "/accounting/revenue"
@rendermode InteractiveServer
@layout AccountingLayout
@attribute [Authorize(Policy = "AccountingAccess")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using VanAn.UI.Platform.Components
@using PlatformComposite = VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using CoreAccountingService = VanAn.CoreHub.Services
@using VanAn.ShopERP.Services.Accounting
@using VanAn.ShopERP.Components.Accounting
@inject CoreAccountingService.IAccountingService AccountingService
@inject VanAn.CoreHub.Services.CongNo.ICongNoService CongNoService
@inject VanAn.CoreHub.Services.IVasFeatureFlagService FeatureFlagService
@inject VanAn.CoreHub.Services.IAccountChartService AccountChartService
@inject VanAn.CoreHub.Services.Journal.IAccountMapResolver AccountMapResolver
@inject VanAn.CoreHub.Services.IBankAccountService BankAccountService
@inject VanAn.Shared.Services.IShopFeatureSettingsService FeatureSettings
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject ILogger<RevenueEntry> Logger
@inject NavigationManager NavigationManager
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject IBusinessInfoApiClient BusinessInfo
@inject CoreAccountingService.IVoucherTextParseService TextParser
@inject VanAn.ShopERP.Components.Accounting.SmartEntrySessionState SmartSession
@inject VanAn.CoreHub.Services.Vouchers.VoucherTypeRegistry VoucherRegistry

<div class="revenue-entry-page @ThemeProvider.CurrentTheme">
    @* Task PG — 2 mode: Manual giữ nguyên; AI = câu mô tả → parse → prefill → user sửa → Lưu.
       Toggle chỉ hiện khi flag SmartEntryEnabled; intent khác trang (transfer/chi) → link route.
       G4: block ĐẶT TRÊN tiêu đề "Nhập Doanh Thu" — trích xuất độc lập với phiếu, giữ nguyên
       khi đổi loại phiếu / chuyển trang (cross-page qua deep-link mang câu gốc). *@
    @if (_smartEnabled)
    {
        <div class="mb-3">
            <div class="btn-group" role="group" data-testid="entry-mode-toggle">
                <button type="button" class="btn btn-sm @(_aiMode ? "btn-outline-primary" : "btn-primary")" @onclick="() => _aiMode = false">Nhập thủ công</button>
                <button type="button" class="btn btn-sm @(_aiMode ? "btn-primary" : "btn-outline-primary")" @onclick="() => _aiMode = true">✨ Nhập bằng mô tả</button>
            </div>
        </div>
        @if (_aiMode)
        {
            <SmartEntryBar @ref="_smartEntryBar" @key="_smartEntryVersion" Placeholder="khách anh Hùng trả nợ 5 triệu bằng chuyển khoản"
                           OnParsed="ApplyParse" />
        }
        @if (_smartRouteUrl != null)
        {
            <VanAAlert Variant="info" Dismissible="true"
                Message="Câu mô tả thuộc nghiệp vụ khác — mở đúng chức năng:" />
            <a href="@_smartRouteUrl" class="btn btn-sm btn-outline-primary mb-3" data-testid="smart-route-link">→ @_smartRouteLabel</a>
        }
        @* PH2: Unknown intent — chặn cứng (không đoán bừa) · Advance — cảnh báo trả trước *@
        @if (_applyError != null)
        {
            <VanAAlert Variant="error" Dismissible="true" OnDismiss="() => _applyError = null"
                Message="@_applyError" data-testid="smart-apply-error" />
        }
        @if (_advanceWarning != null)
        {
            <VanAAlert Variant="warning" Dismissible="true" OnDismiss="() => _advanceWarning = null"
                Message="@_advanceWarning" data-testid="advance-warning" />
        }
    }

    <header class="page-header">
        <h1>Nhập Doanh Thu</h1>
        <VanAButton 
            Variant="secondary" 
            Size="small"
            OnClick="GoBack">
            ← Quay Lại
        </VanAButton>
    </header>

    @if (showSuccess)
    {
        <VanAAlert Type="success" Message="@(_savedDto?.VoucherNumber != null ? $"Đã lưu thành công — Số phiếu: {_savedDto.VoucherNumber}" : "Đã lưu doanh thu thành công!")" Dismissible="true" />
    }

    @if (showError)
    {
        <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" />
    }

    @* In Phiếu thu 01-TT sau khi lưu thành công — mọi tenant (task 2026-11-01 gỡ gate HTX;
       mẫu 01/02-TT là mẫu chung, "Tt71" chỉ là tên file lịch sử). *@
    @if (_lastVoucher != null)
    {
        <div class="mt-3">
            <VanAButton Variant="success" Size="small" OnClick="OpenPrintModal">
                🖨️ In Phiếu thu (01-TT)
            </VanAButton>
        </div>
    }

    <VanAnModal IsOpen="@_showSuccessModal" Title="✅ Đã lưu thành công" Closable="true" OnClose="CloseSuccessModal">
        <div class="text-center py-3" data-testid="success-modal">
            <div class="display-4 text-success mb-2">✓</div>
            <p class="mb-1 fw-bold">@(_savedDto?.VoucherNumber != null ? $"Số phiếu: {_savedDto.VoucherNumber}" : "Đã lưu phiếu thành công!")</p>
            <p class="text-muted small mb-3">Form đã được làm sạch — sẵn sàng nhập phiếu tiếp theo.</p>
            <VanAButton Variant="primary" OnClick="CloseSuccessModal" data-testid="success-modal-continue">Nhập tiếp</VanAButton>
        </div>
    </VanAnModal>

    <VanAnModal IsOpen="@_showPrintModal" Title="Phiếu Thu (Mẫu số 01 - TT)" Closable="true" OnClose="ClosePrintModal">
        @if (_lastVoucher != null)
        {
            <Tt71ReceiptVoucher SoPhieu="@_lastVoucher.SoPhieu" Ngay="@_lastVoucher.Ngay"
                                No="@_lastVoucher.No" Co="@_lastVoucher.Co"
                                NguoiNop="@_lastVoucher.NguoiNop" DiaChi="@_lastVoucher.DiaChi"
                                LyDo="@_lastVoucher.LyDo" SoTien="@_lastVoucher.SoTien"
                                KemTheo="@_lastVoucher.KemTheo" ChungTuGoc="@_lastVoucher.ChungTuGoc" />
        }
    </VanAnModal>

    <VanACard Header="Thông Tin Doanh Thu">
        <EditForm Model="@formData" OnValidSubmit="HandleSubmit">
            @* THU CHI & CÔNG NỢ MVP (P2.1, SRS §5.1 FR-1): Loại phiếu thu 3 lựa chọn — native select
               (trang host quản lý — tránh phụ thuộc @bind của DynamicFormFields) *@
            <div class="mb-3">
                <label for="voucherType" class="form-label">Loại Phiếu Thu <span class="text-danger">*</span></label>
                <select id="voucherType" class="form-select" @bind="_voucherType" @bind:event="onchange" @bind:after="HandleVoucherTypeChanged" data-testid="voucher-type-select">
                    @foreach (var opt in GetVoucherTypeOptions())
                    {
                        <option value="@opt.Value" selected="@(opt.Value == _voucherType)">@opt.Label</option>
                    }
                </select>
                <small class="form-text text-muted">Thu doanh thu (ghi doanh thu) · Ghi nhận phải thu (bán chịu — TK 131) · Thu tiền khách trả nợ (giảm phải thu) · Góp vốn chủ sở hữu (ghi Có 411 — KHÔNG phải doanh thu)</small>
            </div>

            @* FR-2: ô Đối tượng BẮT BUỘC với phiếu công nợ (bán chịu / thu nợ) *@
            @if (IsCongNoType)
            {
                <div class="mb-3">
                    <label for="doiTuong" class="form-label">Đối Tượng (khách hàng) <span class="text-danger">*</span></label>
                    <input id="doiTuong" type="text" class="form-control" @bind="doiTuong" placeholder="Tên khách hàng / công ty" data-testid="doi-tuong-input" />
                    <small class="form-text text-muted">Cùng chuỗi tên = cùng đối tượng [G2] — bắt buộc với phiếu công nợ</small>
                </div>

                @* SRS v1.2 W2/C1 (M7): thu nợ → chọn khoản cụ thể (AllocatedToEntryId) hoặc FIFO tự động *@
                @if (_voucherType == VoucherTypePayment)
                {
                    <div class="mb-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <VanAButton Variant="secondary" Size="small" Disabled="@_isLoadingKhoan" OnClick="LoadOpenKhoanAsync">
                                @(_isLoadingKhoan ? "Đang tải..." : "Tải danh sách khoản nợ")
                            </VanAButton>
                            @if (_khoanLoadError != null)
                            {
                                <span class="text-danger small">@_khoanLoadError</span>
                            }
                        </div>
                        @if (_openKhoan.Count > 0)
                        {
                            <label for="khoanSelect" class="form-label">Áp vào khoản nợ (tùy chọn — mặc định FIFO tự động)</label>
                            <select id="khoanSelect" class="form-select" @bind="_selectedKhoanId" data-testid="khoan-select">
                                <option value="">— Tự động (FIFO: trừ khoản cũ nhất) —</option>
                                @foreach (var k in _openKhoan)
                                {
                                    <option value="@k.EntryId">@k.TransactionDate.ToString("dd/MM/yyyy") — @k.Description — còn @k.ConLai.ToString("N0") ₫</option>
                                }
                            </select>
                        }
                        else if (_khoanLoaded)
                        {
                            <small class="form-text text-muted">Đối tượng này không có khoản nợ còn dư — phiếu sẽ ghi trả trước.</small>
                        }
                    </div>
                }
            }

            @* SRS v1.2 W2/C1 (M7): hình thức thanh toán trên phiếu tay (nullable, default tiền mặt) *@
            <div class="mb-3">
                <label for="paymentMethod" class="form-label">Hình Thức Thanh Toán</label>
                <select id="paymentMethod" class="form-select" @bind="_paymentMethod" @bind:after="RefreshPreviewAsync" data-testid="payment-method-select">
                    <option value="cash">Tiền mặt</option>
                    <option value="bank">Chuyển khoản</option>
                    <option value="qr">QR / Ví điện tử</option>
                    <option value="other">Khác</option>
                </select>
            </div>

            <DynamicFormFields
                FieldDefinitions="@revenueFields"
                OnFieldChanged="HandleFieldChanged"
                @ref="formFieldsRef" />

            @* Issue #198: preview định khoản qua account-map (read-only — cùng resolver của bridge) *@
            @if (_preview != null && (_preview.Lines.Count > 0 || _preview.Note != null))
            {
                <div class="mb-3 p-2 border rounded bg-light" data-testid="journal-preview">
                    <div class="small fw-bold mb-1">Bút toán sẽ ghi:</div>
                    @if (_preview.Note != null)
                    {
                        <div class="small text-muted">@_preview.Note</div>
                    }
                    else
                    {
                        @foreach (var l in _preview.Lines)
                        {
                            <div class="small">
                                @(l.Debit > 0 ? "Nợ" : "Có") @l.AccountCode — @((l.Debit > 0 ? l.Debit : l.Credit).ToString("N0")) ₫
                            </div>
                        }
                        <div class="small text-muted mt-1">Rule: @_preview.Source · sửa tại <a href="/accounting/mapping-rules">Quy tắc định khoản</a></div>
                    }
                </div>
            }

            @* [G11]: ô MST + Tra cứu — native (trang host quản lý) *@
            <div class="mb-3">
                <label for="mst" class="form-label">Mã Số Thuế (MST)</label>
                <input id="mst" type="text" class="form-control" @bind="mstInput"
                       placeholder="VD: 0302839105-001" data-testid="mst-input" />
                <small class="form-text text-muted">@(IsCongNoType ? "Nhập MST đối tượng rồi bấm Tra cứu → tự điền tên công ty vào Đối tượng [G11]" : "Nhập MST khách hàng/đối tác rồi bấm Tra cứu để lấy thông tin doanh nghiệp")</small>
            </div>
            <div class="mt-2 d-flex align-items-center gap-2">
                <VanAButton
                    Variant="secondary"
                    Size="small"
                    Disabled="@_isLookupBusy"
                    OnClick="LookupMstAsync">
                    @(_isLookupBusy ? "Đang tra cứu..." : "Tra cứu MST")
                </VanAButton>
                @if (!string.IsNullOrWhiteSpace(lookupError))
                {
                    <span class="text-danger small">@lookupError</span>
                }
            </div>
            @if (lookupResult is not null)
            {
                <div class="mt-3">
                    <VanACard Header="Thông Tin Doanh Nghiệp">
                        <div class="mb-2 fw-bold">@lookupResult.BusinessName</div>
                        @if (!string.IsNullOrEmpty(lookupResult.Address))
                        {
                            <div class="small mb-1">@lookupResult.Address</div>
                        }
                        <div class="small mb-1">
                            MST: @lookupResult.TaxCode
                            @if (!string.IsNullOrEmpty(lookupResult.ProvinceName))
                            {
                                <span> · @lookupResult.ProvinceName</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(lookupResult.LegalRepName))
                        {
                            <div class="small mb-1">Người đại diện: @lookupResult.LegalRepName</div>
                        }
                        @if (!string.IsNullOrEmpty(lookupResult.IndustryName))
                        {
                            <div class="small mb-1">Ngành: @lookupResult.IndustryName</div>
                        }
                        <div class="small">
                            Trạng thái: <span class="badge @(lookupResult.Status == "active" ? "text-bg-success" : "text-bg-warning")">@StatusLabel(lookupResult.Status)</span>
                            @if (lookupResult.Source == "vanan")
                            {
                                <span class="text-muted">(dữ liệu từ hệ thống VanAn)</span>
                            }
                        </div>
                        @if (lookupResult.Status is "suspended" or "dissolved")
                        {
                            <div class="mt-2">
                                <VanAAlert Variant="warning" Message="Doanh nghiệp đã tạm ngừng hoặc giải thể — kiểm tra kỹ trước khi ghi sổ." Dismissible="false" />
                            </div>
                        }
                    </VanACard>
                </div>
            }
            <div class="mt-3">
                <VanAButton 
                    Variant="primary" 
                    Type="submit">
                    Lưu Doanh Thu
                </VanAButton>
            </div>
        </EditForm>
    </VanACard>
</div>

@code {
    [SupplyParameterFromQuery] public string? desc { get; set; }
    // Task PG: Smart Entry AI — flag + mode + route hint.
    private bool _smartEnabled;
    private bool _aiMode;
    private string? _smartRouteUrl;
    private string? _smartRouteLabel;
    private List<VanAn.UI.Platform.Components.Composite.FormField> revenueFields = new();
    private bool showSuccess = false;
    private bool _showSuccessModal;
    private int _smartEntryVersion;
    private VanAn.ShopERP.Components.Accounting.SmartEntryBar? _smartEntryBar;
    private List<CoreAccountingService.ParsedVoucher>? _pendingMulti;
    private string? _pendingMultiText;
    private List<int>? _pendingSavedIndices;
    private CoreAccountingService.ParsedVoucher? _pendingSingleResult;
    private bool showError = false;
    private string errorMessage = string.Empty;
    // PH2: Unknown chặn cứng + Advance cảnh báo trả trước.
    private string? _applyError;
    private string? _advanceWarning;
    private PlatformComposite.FormData formData = new();
    private DynamicFormFields? formFieldsRef;
    private TenantType? _tenantType;

    // TT 71 Phase 4b: dữ liệu phiếu thu 01-TT của entry vừa lưu (để in)
    private record VoucherData(string SoPhieu, string Ngay, string No, string Co, string NguoiNop,
        string DiaChi, string LyDo, decimal SoTien, string KemTheo, string ChungTuGoc);
    private VoucherData? _lastVoucher;
    private bool _showPrintModal;
    // SRS v1.2 W2/C1: DTO vừa lưu — lấy VoucherNumber cho success message + SoPhieu 01-TT.
    private VanAn.Shared.DTOs.AccountingEntryDto? _savedDto;

    // Issue #198: TK từ effective tenant chart (global + tenant override/custom) + preview.
    private List<PlatformComposite.FieldOption> _coaAccounts = new();
    private JournalPreviewResult? _preview;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantTypeAsync();
        await LoadCoaOptionsAsync();
        InitializeFields();
        if (TenantProvider.HasTenant)
        {
            _smartEnabled = await FeatureSettings.IsEnabledAsync(TenantProvider.TenantId, "SmartEntryEnabled");
            if (_smartEnabled && !string.IsNullOrWhiteSpace(desc))
            {
                _aiMode = true;
                // G4: deep-link mang câu gốc → ParseMultipleAsync để giữ list multi trên page đích
                var list = await TextParser.ParseMultipleAsync(new TenantId(TenantProvider.TenantId), desc);
                if (list.Count > 1) { _smartEntryBar?.ShowMulti(list.ToList(), desc); }
                else if (list.Count == 1) { await ApplyParse(list[0]); }
            }
        }
        await RefreshPreviewAsync();
        // G4: khôi phục multi từ session khi chuyển form (navigation, không qua route link)
        if (string.IsNullOrWhiteSpace(desc) && SmartSession.Multi is { Count: > 1 })
        {
            _pendingMulti = SmartSession.Multi;
            _pendingMultiText = SmartSession.Text;
            _aiMode = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingMulti != null && _smartEntryBar != null)
        {
            _smartEntryBar.ShowMulti(_pendingMulti, _pendingMultiText ?? string.Empty, _pendingSavedIndices);
            _pendingMulti = null;
            _pendingSavedIndices = null;
        }
        else if (_pendingSingleResult != null && _smartEntryBar != null)
        {
            _smartEntryBar.ShowResult(_pendingSingleResult);
            _pendingSingleResult = null;
        }
        else if (firstRender && string.IsNullOrWhiteSpace(desc) && SmartSession.Multi is null
                 && _smartEnabled && TenantProvider.HasTenant)
        {
            // PH3: ưu tiên multi JSON — khôi phục DETERMINISTIC (không re-parse LLM, không mất session)
            var multiJson = await JSRuntime.InvokeAsync<string>("vananLoadSmartMulti");
            if (!string.IsNullOrWhiteSpace(multiJson))
            {
                var multi = SmartEntrySessionCodec.Deserialize(multiJson);
                var processed = await JSRuntime.InvokeAsync<List<int>>("vananLoadSmartProcessed") ?? new List<int>();
                if (multi is { Count: > 1 })
                {
                    _pendingMulti = multi;
                    _pendingSavedIndices = processed;
                    _pendingMultiText = await JSRuntime.InvokeAsync<string>("vananLoadSmartText") ?? string.Empty;
                    _aiMode = true;
                    StateHasChanged();
                    return;
                }
            }
            // Fallback cũ (dữ liệu text-only trước PH3): re-parse — PH3 KHÔNG wipe, single vẫn hiển thị.
            var saved = await JSRuntime.InvokeAsync<string>("vananLoadSmartText");
            if (!string.IsNullOrWhiteSpace(saved))
            {
                _aiMode = true;
                var list = await TextParser.ParseMultipleAsync(new TenantId(TenantProvider.TenantId), saved);
                if (list.Count > 1) { _pendingMulti = list.ToList(); _pendingMultiText = saved; StateHasChanged(); }
                else if (list.Count == 1) { _pendingSingleResult = list[0]; StateHasChanged(); }
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    /// <summary>Task PG + PH2: áp kết quả parse vào form qua REGISTRY (ResolveByIntent — bỏ switch hardcode).
    /// Unknown → chặn cứng (không đoán bừa) · intent khác trang → route link · cùng trang → prefill.</summary>
    private async Task ApplyParse(CoreAccountingService.ParsedVoucher p)
    {
        _smartRouteUrl = null;
        _applyError = null;
        _advanceWarning = null;
        var def = VoucherRegistry.ResolveByIntent(p.Intent);
        if (def == null)
        {
            // Q2: Unknown — không nhận diện được loại phiếu → KHÔNG điền form (tránh định khoản sai).
            _applyError = "Không nhận diện được loại phiếu cho câu này — nhập thủ công hoặc bổ sung từ khóa.";
            StateHasChanged();
            return;
        }
        if (!def.Route.StartsWith("/accounting/revenue", StringComparison.OrdinalIgnoreCase))
        {
            _smartRouteUrl = def.Route + "?desc=" + Uri.EscapeDataString(_smartEntryBar?.CurrentText ?? p.Description);
            _smartRouteLabel = def.Name;
            return;
        }
        _voucherType = def.Code;
        if (!string.IsNullOrWhiteSpace(p.DoiTuong)) doiTuong = p.DoiTuong;
        if (!string.IsNullOrWhiteSpace(p.PaymentMethod)) _paymentMethod = p.PaymentMethod;
        RebuildFields();
        if (p.Amount.HasValue) formData.Values["amount"] = p.Amount.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        formData.Values["date"] = p.Date.ToString("yyyy-MM-dd");
        formData.Values["description"] = p.Description;
        foreach (var f in revenueFields)
        {
            if (formData.Values.TryGetValue(f.Id, out var v)) f.Value = v;
        }
        // Task G2/G3 fix ("Áp vào form"): Blazor drop DOM sync qua component boundary DynamicFormFields
        // → push thẳng DOM qua JS. G3: gộp 1 interop SAU render cuối (preview) — deterministic,
        // rút ngắn cửa sổ circuit busy. LoadOpenKhoanAsync AWAIT (không fire-and-forget) — tránh
        // DbContext concurrency với RefreshPreviewAsync làm circuit chết → click sau đó vô hiệu.
        try
        {
            if (IsCongNoType && !string.IsNullOrWhiteSpace(doiTuong)) await LoadOpenKhoanAsync();
        }
        catch (Exception ex) { Logger.LogWarning(ex, "LoadOpenKhoanAsync failed trong ApplyParse"); }
        await RefreshPreviewAsync();
        await SafeSetFormValues(new Dictionary<string, string>
        {
            ["amount"] = formData.Values.GetValueOrDefault("amount") ?? "",
            ["date"] = formData.Values.GetValueOrDefault("date") ?? "",
            ["description"] = formData.Values.GetValueOrDefault("description") ?? "",
        });
        // Q3: Advance (khách ứng trước/cọc) — giữ mapping "Thu tiền khách trả nợ" + FIFO, cảnh báo rõ.
        if (p.Intent == CoreAccountingService.VoucherIntent.Advance)
        {
            _advanceWarning = "Khách ứng trước/cọc — ghi trả trước (Có 131), không phải doanh thu. Loại phiếu 'Thu tiền khách trả nợ' + FIFO tự động.";
            StateHasChanged();
        }
    }

    private async Task SafeSetFormValues(Dictionary<string, string> fields)
    {
        try { await JSRuntime.InvokeVoidAsync("vananSetFormValues", fields); }
        catch (Exception ex) { Logger.LogWarning(ex, "vananSetFormValues failed"); }
    }

    private async Task LoadCoaOptionsAsync()
    {
        if (!TenantProvider.HasTenant) return;
        _coaAccounts = await EntryFormAccountingHelper.LoadAccountOptionsAsync(
            AccountChartService, new TenantId(TenantProvider.TenantId), _tenantType,
            ["5", "7"], AccountingAccountProvider.GetRevenueAccounts(_tenantType));
    }

    private async Task RefreshPreviewAsync()
    {
        _preview = null;
        if (!TenantProvider.HasTenant) return;
        var accountCode = formData.Values.GetValueOrDefault("account") ?? string.Empty;
        var amountStr = (formData.Values.GetValueOrDefault("amount") ?? "").Replace(".", "").Replace(",", "").Trim();
        _ = decimal.TryParse(amountStr, out var amt);
        string eventCode = _voucherType switch
        {
            VoucherTypeReceivable => VanAn.CoreHub.Services.Journal.AccountMapEventCodes.Receivable,
            VoucherTypePayment => VanAn.CoreHub.Services.Journal.AccountMapEventCodes.ReceivablePayment,
            _ => VanAn.CoreHub.Services.Journal.AccountMapEventCodes.ManualReceipt
        };
        _preview = await EntryFormAccountingHelper.PreviewAsync(
            eventCode, new TenantId(TenantProvider.TenantId), accountCode, _paymentMethod,
            amt, 0m, _tenantType, AccountMapResolver, BankAccountService, FeatureSettings);
    }

    private async Task LoadTenantTypeAsync()
    {
        if (!TenantProvider.HasTenant) return;
        // G2+: retry 1 lần khi DbContext concurrency transient ("A second operation was started")
        // — tránh fallback sai regime DN cho tenant HKD/HTX.
        for (int attempt = 1; attempt <= 2; attempt++)
        {
            try
            {
                _tenantType = await FeatureFlagService.GetTenantTypeAsync(new TenantId(TenantProvider.TenantId));
                return;
            }
            catch (InvalidOperationException) when (attempt == 1)
            {
                Logger.LogWarning("GetTenantTypeAsync concurrency — retry lần 2");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Không lấy được TenantType — dùng options DN mặc định");
                return;
            }
        }
    }

