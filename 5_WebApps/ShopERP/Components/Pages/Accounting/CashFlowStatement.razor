@page "/accounting/cash-flow-statement"
@rendermode InteractiveServer
@layout AccountingLayout
@attribute [Authorize(Policy = "AccountingFullAccess")]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.ShopERP.Services.Accounting
@inject VanAn.CoreHub.Services.ICashFlowStatementService CashFlowService
@inject VanAn.ShopERP.Services.IFinancialReportExportService ExportService
@inject VanAn.CoreHub.Services.IVasFeatureFlagService FeatureFlagService
@inject IAccountingStandardSelectionService StandardSelection
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject IJSRuntime JSRuntime
@inject ILogger<CashFlowStatement> Logger

<div class="report-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Báo Cáo Lưu Chuyển Tiền Tệ</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="GenerateReport">
                🔄 Tạo báo cáo
            </VanAButton>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }

    @if (_allowedStandards is { Count: 0 })
    {
        <VanACard Header="Không áp dụng">
            <VanAAlert Type="info" Dismissible="false"
                Message="Hộ kinh doanh áp dụng sổ sách theo TT 152/2025/TT-BTC — hoặc tự nguyện áp dụng TT 58/2026 (Điều 2.2). Báo cáo tài chính doanh nghiệp không áp dụng cho HKD." />
            <a href="/accounting/hkd-books">📚 Mở Sổ HKD (TT 152)</a>
        </VanACard>
    }
    else
    {
    <VanACard Header="Kỳ báo cáo">
        <div class="period-picker-row">
            <label>Năm: <input type="number" min="2000" max="2100" @bind="selectedYear" /></label>
            <label>Tháng:
                <select @bind="selectedMonth">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </label>
            <label>Chuẩn kế toán:
                @if (_cfOptions.Count > 1)
                {
                    <select @bind="selectedStandard">
                        @foreach (var s in _cfOptions)
                        {
                            <option value="@s">@AccountingStandardResolver.DropdownLabel(s)</option>
                        }
                    </select>
                }
                else if (_cfOptions.Count == 1)
                {
                    <span>@AccountingStandardResolver.DropdownLabel(_cfOptions[0])</span>
                }
                @if (_isVoluntary)
                {
                    <small>(tự nguyện)</small>
                }
            </label>
            <label>Phương pháp:
                <select @bind="selectedMethod">
                    <option value="@CashFlowMethod.Direct">Trực tiếp (@AccountingFormLabels.FormCode(selectedStandard, "CF"))</option>
                    <option value="@CashFlowMethod.Indirect">Gián tiếp (@AccountingFormLabels.FormCode(selectedStandard, "CF"))</option>
                </select>
            </label>
            <VanAButton Variant="primary" Size="small" OnClick="GenerateReport">Áp dụng</VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="ExportDocx" Disabled="@exporting">📄 Xuất DOCX</VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="ExportXlsx" Disabled="@exporting">📊 Xuất XLSX</VanAButton>
        </div>
    </VanACard>
    }

    @if (selectedStandard == AccountingStandard.TT58_2026)
    {
        <VanAAlert Type="info" Message="TT 58/2026 (Chế độ kế toán DN siêu nhỏ) KHÔNG yêu cầu Báo cáo lưu chuyển tiền tệ. BCTC DNSN chỉ gồm B01-DNSN và B02-DNSN." />
    }
    else if (currentTenantType == TenantType.HTX)
    {
        <VanAAlert Type="info" Message="TT 71/2024 (Chế độ kế toán HTX) KHÔNG yêu cầu Báo cáo lưu chuyển tiền tệ (B03). Xem Báo cáo tình hình tài chính (B01-HTX) và Kết quả hoạt động (B02-HTX)." />
    }
    else if (loading)
    {
        <VanACard Header="Đang tạo báo cáo">
            <p>Đang tạo Báo Cáo Lưu Chuyển Tiền Tệ cho kỳ @selectedMonth/@selectedYear...</p>
        </VanACard>
    }
    else if (report != null)
    {
        <!-- Key metrics -->
        <VanACard Header="Chỉ số chính">
            <div class="metrics-row">
                <div class="metric-item">
                    <span class="metric-label">Tiền đầu kỳ:</span>
                    <span class="metric-value">@FormatAmount(report.OpeningCash)</span>
                </div>
                <div class="metric-item">
                    <span class="metric-label">Tiền cuối kỳ:</span>
                    <span class="metric-value">@FormatAmount(report.ClosingCash)</span>
                </div>
                <div class="metric-item">
                    <span class="metric-label">Lưu chuyển tiền thuần:</span>
                    <span class="metric-value">@FormatAmount(report.NetChange)</span>
                </div>
            </div>
        </VanACard>

        <!-- Operating Activities -->
        <VanACard Header="Lưu chuyển tiền từ hoạt động kinh doanh">
            <VanAnDataGrid TItem="FinancialStatementLine" Items="@report.OperatingActivities" EmptyMessage="Không có hoạt động kinh doanh trong kỳ">
                <Columns>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Mã chỉ tiêu" Width="2">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px">@line.ReportItemCode</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Tên chỉ tiêu" Width="6">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px; font-weight:@(line.Level == 1 ? "bold" : "normal")">@line.ReportItemName</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số cuối kỳ" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.EndingAmount)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số đầu năm" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.OpeningAmount)</span>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>

        <!-- Investing Activities -->
        <VanACard Header="Lưu chuyển tiền từ hoạt động đầu tư">
            <VanAnDataGrid TItem="FinancialStatementLine" Items="@report.InvestingActivities" EmptyMessage="Không có hoạt động đầu tư trong kỳ">
                <Columns>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Mã chỉ tiêu" Width="2">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px">@line.ReportItemCode</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Tên chỉ tiêu" Width="6">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px; font-weight:@(line.Level == 1 ? "bold" : "normal")">@line.ReportItemName</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số cuối kỳ" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.EndingAmount)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số đầu năm" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.OpeningAmount)</span>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>

        <!-- Financing Activities -->
        <VanACard Header="Lưu chuyển tiền từ hoạt động tài chính">
            <VanAnDataGrid TItem="FinancialStatementLine" Items="@report.FinancingActivities" EmptyMessage="Không có hoạt động tài chính trong kỳ">
                <Columns>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Mã chỉ tiêu" Width="2">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px">@line.ReportItemCode</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Tên chỉ tiêu" Width="6">
                        <Template Context="line">
                            <span style="padding-left:@(line.Level * 16)px; font-weight:@(line.Level == 1 ? "bold" : "normal")">@line.ReportItemName</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số cuối kỳ" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.EndingAmount)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="FinancialStatementLine" Title="Số đầu năm" Width="2">
                        <Template Context="line">
                            <span>@FormatAmount(line.OpeningAmount)</span>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>
    }
</div>

@code {
    private VanAn.Shared.Domain.CashFlowStatement? report;
    private bool loading = true;
    private bool exporting;
    private string? errorMessage;

    private int selectedYear = DateTime.UtcNow.Year;
    private int selectedMonth = DateTime.UtcNow.Month;
    private AccountingStandard selectedStandard = AccountingStandard.TT133_2016;
    private CashFlowMethod selectedMethod = CashFlowMethod.Direct;
    private TenantType? currentTenantType;
    // Regime-lock (2026-10-30): allowed=null → chưa load; Count=0 → BCTC không áp dụng (HKD).
    private IReadOnlyList<AccountingStandard>? _allowedStandards;
    private static readonly AccountingStandard[] _cfStandards =
        [AccountingStandard.TT133_2016, AccountingStandard.TT99_2025, AccountingStandard.TT58_2026];
    private bool _isVoluntary;
    private List<AccountingStandard> _cfOptions =>
        (_allowedStandards ?? _cfStandards).Intersect(_cfStandards).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (TenantProvider.HasTenant)
        {
            try
            {
                var tenantId = new TenantId(TenantProvider.TenantId);
                currentTenantType = await FeatureFlagService.GetTenantTypeAsync(tenantId);
                var sel = await StandardSelection.GetAsync(tenantId);
                _allowedStandards = sel.Allowed;
                if (sel.Effective is { } eff) selectedStandard = eff;
                _isVoluntary = sel.IsVoluntary;
            }
            catch { /* fallback TT133 + đủ option */ }
        }

        // TT 71 (HTX) KHÔNG yêu cầu B03 — chặn sinh báo cáo, hiển thị thông báo.
        // Regime-lock: HKD (allowed rỗng) → guard card, không sinh báo cáo.
        if (currentTenantType == TenantType.HTX || _allowedStandards is { Count: 0 })
        {
            loading = false;
            return;
        }

        await GenerateReport();
    }

    private async Task GenerateReport()
    {
        loading = true;
        errorMessage = null;
        try
        {
            if (!TenantProvider.HasTenant)
            {
                errorMessage = "Không xác định được tenant. Vui lòng đăng nhập lại.";
                return;
            }

            TenantId tenantId = new(TenantProvider.TenantId);
            var period = new AccountingPeriod(selectedYear, selectedMonth);
            report = selectedMethod == CashFlowMethod.Indirect
                ? await CashFlowService.GenerateIndirectAsync(tenantId, period, selectedStandard, CancellationToken.None)
                : await CashFlowService.GenerateAsync(tenantId, period, selectedStandard, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating Cash Flow Statement for period {Year}-{Month}", selectedYear, selectedMonth);
            errorMessage = "Không thể tạo Báo Cáo Lưu Chuyển Tiền Tệ. Vui lòng thử lại.";
        }
        finally
        {
            loading = false;
        }
    }

    private static string FormatAmount(decimal amount)
    {
        return amount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
    }

    private async Task ExportDocx()
    {
        if (report == null) return;
        await DownloadFile(async () =>
        {
            var sections = new List<(string, IReadOnlyList<FinancialStatementLine>)>
            {
                ("HOẠT ĐỘNG KINH DOANH", report.OperatingActivities.ToList()),
                ("HOẠT ĐỘNG ĐẦU TƯ", report.InvestingActivities.ToList()),
                ("HOẠT ĐỘNG TÀI CHÍNH", report.FinancingActivities.ToList())
            };
            return await ExportService.ExportStatementToDocxAsync(AccountingFormLabels.ExportTitle(selectedStandard, "CF", "Báo Cáo Lưu Chuyển Tiền Tệ"), $"Tháng {selectedMonth:D2}/{selectedYear}", sections);
        }, $"CashFlowStatement_{selectedYear}_{selectedMonth:D2}.docx");
    }

    private async Task ExportXlsx()
    {
        if (report == null) return;
        await DownloadFile(async () =>
        {
            var sections = new List<(string, IReadOnlyList<FinancialStatementLine>)>
            {
                ("HOẠT ĐỘNG KINH DOANH", report.OperatingActivities.ToList()),
                ("HOẠT ĐỘNG ĐẦU TƯ", report.InvestingActivities.ToList()),
                ("HOẠT ĐỘNG TÀI CHÍNH", report.FinancingActivities.ToList())
            };
            return await ExportService.ExportStatementToXlsxAsync(AccountingFormLabels.ExportTitle(selectedStandard, "CF", "Báo Cáo Lưu Chuyển Tiền Tệ"), $"Tháng {selectedMonth:D2}/{selectedYear}", sections);
        }, $"CashFlowStatement_{selectedYear}_{selectedMonth:D2}.xlsx");
    }

    private async Task DownloadFile(Func<Task<byte[]>> produce, string fileName)
    {
        exporting = true;
        try
        {
            byte[] bytes = await produce();
            string base64 = Convert.ToBase64String(bytes);
            string mime = fileName.EndsWith(".docx") ? "application/vnd.openxmlformats-officedocument.wordprocessingml.document" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            await JSRuntime.InvokeVoidAsync("vanAn.downloadFile", base64, mime, fileName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting {FileName}", fileName);
            errorMessage = $"Không thể xuất file: {ex.Message}";
        }
        finally
        {
            exporting = false;
        }
    }
}
