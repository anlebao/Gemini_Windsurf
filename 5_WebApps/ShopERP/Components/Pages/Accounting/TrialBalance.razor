@page "/accounting/trial-balance"
@rendermode InteractiveServer
@layout AccountingLayout
@attribute [Authorize(Policy = "AccountingFullAccess")]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.ShopERP.Services.Accounting
@inject VanAn.CoreHub.Services.ITrialBalanceService TrialBalanceService
@inject VanAn.ShopERP.Services.IFinancialReportExportService ExportService
@inject IAccountingStandardSelectionService StandardSelection
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject IJSRuntime JSRuntime
@inject ILogger<TrialBalance> Logger

<div class="report-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Bảng Cân Đối Số Phát Sinh @(string.IsNullOrEmpty(tbFormCode) ? "" : $"({tbFormCode})")</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="GenerateReport">
                🔄 Tạo báo cáo
            </VanAButton>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }

    @if (_allowedStandards is { Count: 0 })
    {
        <VanACard Header="Không áp dụng">
            <VanAAlert Type="info" Dismissible="false"
                Message="Hộ kinh doanh áp dụng sổ sách theo TT 152/2025/TT-BTC — hoặc tự nguyện áp dụng TT 58/2026 (Điều 2.2). Báo cáo tài chính doanh nghiệp không áp dụng cho HKD." />
            <a href="/accounting/hkd-books">📚 Mở Sổ HKD (TT 152)</a>
        </VanACard>
    }
    else
    {
    <VanACard Header="Kỳ báo cáo">
        <div class="period-picker-row">
            <label>Năm: <input type="number" min="2000" max="2100" @bind="selectedYear" /></label>
            <label>Tháng:
                <select @bind="selectedMonth">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </label>
            <label>Chuẩn kế toán:
                @if (_allowedStandards is { Count: 1 })
                {
                    <span>@AccountingStandardResolver.DropdownLabel(_allowedStandards[0])</span>
                }
                else
                {
                    <select @bind="selectedStandard">
                        @foreach (var s in _allowedStandards ?? _allStandards)
                        {
                            <option value="@s">@AccountingStandardResolver.DropdownLabel(s)</option>
                        }
                    </select>
                }
                @if (_isVoluntary)
                {
                    <small>(tự nguyện)</small>
                }
            </label>
            <VanAButton Variant="primary" Size="small" OnClick="GenerateReport">Áp dụng</VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="ExportDocx" Disabled="@exporting">📄 Xuất DOCX</VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="ExportXlsx" Disabled="@exporting">📊 Xuất XLSX</VanAButton>
        </div>
    </VanACard>
    }

    @if (loading)
    {
        <VanACard Header="Đang tạo báo cáo">
            <p>Đang tạo Bảng Cân Đối Số Phát Sinh cho kỳ @selectedMonth/@selectedYear...</p>
        </VanACard>
    }
    else if (report != null)
    {
        <!-- Balance status indicator -->
        <VanAAlert Type="@BalanceAlertType" Message="@BalanceAlertMessage" />

        <!-- Account details -->
        <VanACard Header="Chi tiết tài khoản">
            <VanAnDataGrid TItem="TrialBalanceAccount" Items="@report.Accounts" EmptyMessage="Không có dữ liệu">
                <Columns>
                    <VanAnColumn TItem="TrialBalanceAccount" Title="Số tài khoản" Width="2">
                        <Template Context="acc">
                            <span>@acc.AccountNumber</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="TrialBalanceAccount" Title="Tên tài khoản" Width="5">
                        <Template Context="acc">
                            <span>@acc.AccountName</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="TrialBalanceAccount" Title="Phát sinh Nợ" Width="2">
                        <Template Context="acc">
                            <span>@FormatAmount(acc.DebitTotal)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="TrialBalanceAccount" Title="Phát sinh Có" Width="2">
                        <Template Context="acc">
                            <span>@FormatAmount(acc.CreditTotal)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="TrialBalanceAccount" Title="Số dư" Width="1">
                        <Template Context="acc">
                            <span>@FormatAmount(acc.Balance)</span>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
            <div class="totals-row">
                <strong>Tổng phát sinh Nợ:</strong>
                <span>@FormatAmount(report.TotalDebit)</span>
                <strong>Tổng phát sinh Có:</strong>
                <span>@FormatAmount(report.TotalCredit)</span>
            </div>
        </VanACard>
    }
</div>

@code {
    private VanAn.Shared.Domain.TrialBalance? report;
    private bool loading = true;
    private bool exporting;
    private string? errorMessage;
    private string tbFormCode => AccountingFormLabels.FormCode(selectedStandard, "TB");

    private int selectedYear = DateTime.UtcNow.Year;
    private int selectedMonth = DateTime.UtcNow.Month;
    private AccountingStandard selectedStandard = AccountingStandard.TT133_2016;
    // Regime-lock (2026-10-30): allowed=null → chưa load (fallback đủ 4); Count=0 → BCTC không áp dụng (HKD).
    private IReadOnlyList<AccountingStandard>? _allowedStandards;
    private static readonly AccountingStandard[] _allStandards =
        [AccountingStandard.TT133_2016, AccountingStandard.TT99_2025, AccountingStandard.TT71_2024, AccountingStandard.TT58_2026];
    private bool _isVoluntary;

    protected override async Task OnInitializedAsync()
    {
        if (TenantProvider.HasTenant)
        {
            try
            {
                var sel = await StandardSelection.GetAsync(new TenantId(TenantProvider.TenantId));
                _allowedStandards = sel.Allowed;
                if (sel.Effective is { } eff) selectedStandard = eff;
                _isVoluntary = sel.IsVoluntary;
            }
            catch { /* fallback TT133 + đủ 4 option */ }
        }
        if (_allowedStandards is { Count: 0 })
        {
            loading = false;
            return;
        }
        await GenerateReport();
    }

    private async Task GenerateReport()
    {
        loading = true;
        errorMessage = null;
        try
        {
            if (!TenantProvider.HasTenant)
            {
                errorMessage = "Không xác định được tenant. Vui lòng đăng nhập lại.";
                return;
            }

            if (_allowedStandards is { Count: > 0 } && !_allowedStandards.Contains(selectedStandard))
            {
                selectedStandard = _allowedStandards[0];
            }
            TenantId tenantId = new(TenantProvider.TenantId);
            var period = new AccountingPeriod(selectedYear, selectedMonth);
            report = await TrialBalanceService.GenerateAsync(tenantId, period, selectedStandard, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating Trial Balance for period {Year}-{Month}", selectedYear, selectedMonth);
            errorMessage = "Không thể tạo Bảng Cân Đối Số Phát Sinh. Vui lòng thử lại.";
        }
        finally
        {
            loading = false;
        }
    }

    private static string FormatAmount(decimal amount)
    {
        return amount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
    }

    private string BalanceAlertType => report?.IsBalanced == true ? "success" : "warning";

    private string BalanceAlertMessage => report?.IsBalanced == true
        ? "Bảng cân đối số phát sinh: Cân bằng"
        : "Bảng cân đối số phát sinh: Không cân bằng — kiểm tra dữ liệu nhập";

    private async Task ExportDocx()
    {
        if (report == null) return;
        await DownloadFile(async () =>
        {
            return await ExportService.ExportTrialBalanceToDocxAsync(
                AccountingFormLabels.ExportTitle(selectedStandard, "TB", "Bảng Cân Đối Số Phát Sinh"),
                $"Tháng {selectedMonth:D2}/{selectedYear}",
                report.Accounts.ToList(),
                report.TotalDebit,
                report.TotalCredit,
                report.IsBalanced);
        }, $"TrialBalance_{selectedYear}_{selectedMonth:D2}.docx");
    }

    private async Task ExportXlsx()
    {
        if (report == null) return;
        await DownloadFile(async () =>
        {
            return await ExportService.ExportTrialBalanceToXlsxAsync(
                AccountingFormLabels.ExportTitle(selectedStandard, "TB", "Bảng Cân Đối Số Phát Sinh"),
                $"Tháng {selectedMonth:D2}/{selectedYear}",
                report.Accounts.ToList(),
                report.TotalDebit,
                report.TotalCredit,
                report.IsBalanced);
        }, $"TrialBalance_{selectedYear}_{selectedMonth:D2}.xlsx");
    }

    private async Task DownloadFile(Func<Task<byte[]>> produce, string fileName)
    {
        exporting = true;
        try
        {
            byte[] bytes = await produce();
            string base64 = Convert.ToBase64String(bytes);
            string mime = fileName.EndsWith(".docx") ? "application/vnd.openxmlformats-officedocument.wordprocessingml.document" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            await JSRuntime.InvokeVoidAsync("vanAn.downloadFile", base64, mime, fileName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting {FileName}", fileName);
            errorMessage = $"Không thể xuất file: {ex.Message}";
        }
        finally
        {
            exporting = false;
        }
    }
}
