    private void HandleFieldChanged(PlatformComposite.FormField field)
    {
        formData.Values[field.Id] = field.Value?.ToString() ?? string.Empty;

        // Clear field error when value changes
        if (formFieldsRef != null)
        {
            formFieldsRef.ClearFieldErrors();
        }

        // Issue #198: user đụng account → không gợi ý nữa; đổi category → gợi ý TK
        // (chỉ khi account chưa bị user sửa); account/amount đổi → refresh preview.
        if (field.Id == "account")
        {
            _accountTouched = true;
            _ = RefreshPreviewAsync();
        }
        else if (field.Id == "amount")
        {
            _ = RefreshPreviewAsync();
        }
        else if (field.Id == "category" && !_accountTouched)
        {
            var accountField = expenseFields.FirstOrDefault(f => f.Id == "account");
            string suggested = EntryFormAccountingHelper.SuggestExpenseAccount(
                formData.Values.GetValueOrDefault("category"), _tenantType);
            if (accountField != null && accountField.Options.Any(o => o.Value == suggested))
            {
                accountField.Value = suggested;
                formData.Values["account"] = suggested;
            }
            _ = RefreshPreviewAsync();
        }
    }

