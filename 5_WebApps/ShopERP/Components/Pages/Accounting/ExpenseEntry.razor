@page "/accounting/expenses"
@rendermode InteractiveServer
@layout AccountingLayout
@attribute [Authorize(Policy = "OwnerOnly")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using VanAn.UI.Platform.Components
@using PlatformComposite = VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using CoreAccountingService = VanAn.CoreHub.Services
@using Microsoft.JSInterop
@using VanAn.ShopERP.Services.Accounting
@using VanAn.ShopERP.Components.Accounting
@inject CoreAccountingService.IAccountingService AccountingService
@inject VanAn.CoreHub.Services.CongNo.ICongNoService CongNoService
@inject VanAn.CoreHub.Services.IVasFeatureFlagService FeatureFlagService
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject ILogger<ExpenseEntry> Logger
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IBusinessInfoApiClient BusinessInfo

<div class="expense-entry-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Nhập Chi Phí</h1>
        <VanAButton 
            Variant="secondary" 
            Size="small"
            OnClick="GoBack">
            ← Quay Lại
        </VanAButton>
    </header>

    @if (showSuccess)
    {
        <VanAAlert data-testid="expense-success-alert" Variant="success" Message="Đã lưu chi phí thành công!" Dismissible="true" />
    }

    @if (showError)
    {
        <VanAAlert data-testid="expense-error-alert" Variant="error" Message="@errorMessage" Dismissible="true" />
    }

    @* TT 71 Phase 4b: in Phiếu chi 02-TT (chỉ tenant HTX) sau khi lưu thành công *@
    @if (_tenantType == TenantType.HTX && _lastVoucher != null)
    {
        <div class="mt-3">
            <VanAButton Variant="success" Size="small" OnClick="OpenPrintModal">
                🖨️ In Phiếu chi (02-TT)
            </VanAButton>
        </div>
    }

    <VanAnModal IsOpen="@_showPrintModal" Title="Phiếu Chi (Mẫu số 02 - TT)" Closable="true" OnClose="ClosePrintModal">
        @if (_lastVoucher != null)
        {
            <Tt71PaymentVoucher SoPhieu="@_lastVoucher.SoPhieu" Ngay="@_lastVoucher.Ngay"
                                No="@_lastVoucher.No" Co="@_lastVoucher.Co"
                                NguoiNhan="@_lastVoucher.NguoiNhan" DiaChi="@_lastVoucher.DiaChi"
                                LyDo="@_lastVoucher.LyDo" SoTien="@_lastVoucher.SoTien"
                                KemTheo="@_lastVoucher.KemTheo" ChungTuGoc="@_lastVoucher.ChungTuGoc" />
        }
    </VanAnModal>

    <VanACard Header="Thông Tin Chi Phí">
        @* HARDENING KIẾN TRÚC: Đưa Form về trang Host quản lý *@
        <EditForm Model="@formData" OnValidSubmit="HandleSubmit">
            @* THU CHI & CÔNG NỢ MVP (P2.2, SRS §5.2 FR-4): Loại phiếu chi 3 lựa chọn — native select
               (trang host quản lý — tránh phụ thuộc @bind của DynamicFormFields) *@
            <div class="mb-3">
                <label for="voucherType" class="form-label">Loại Phiếu Chi <span class="text-danger">*</span></label>
                <select id="voucherType" class="form-select" @bind="_voucherType" @bind:event="onchange" @bind:after="HandleVoucherTypeChanged" data-testid="voucher-type-select">
                    @foreach (var opt in GetVoucherTypeOptions())
                    {
                        <option value="@opt.Value" selected="@(opt.Value == _voucherType)">@opt.Label</option>
                    }
                </select>
                <small class="form-text text-muted">Chi phí (ghi chi phí) · Ghi nhận phải trả (mua chịu — TK 331) · Trả tiền người bán (giảm phải trả)</small>
            </div>

            @* FR-5: ô Đối tượng BẮT BUỘC với phiếu công nợ (mua chịu / trả nợ) *@
            @if (IsCongNoType)
            {
                <div class="mb-3">
                    <label for="doiTuong" class="form-label">Đối Tượng (nhà cung cấp) <span class="text-danger">*</span></label>
                    <input id="doiTuong" type="text" class="form-control" @bind="doiTuong" placeholder="Tên người bán / công ty" data-testid="doi-tuong-input" />
                    <small class="form-text text-muted">Cùng chuỗi tên = cùng đối tượng [G2] — bắt buộc với phiếu công nợ</small>
                </div>
            }

            <DynamicFormFields 
                FieldDefinitions="@expenseFields"
                OnFieldChanged="HandleFieldChanged"
                @ref="formFieldsRef" />

            @* [G11]: ô MST + Tra cứu — native (trang host quản lý) *@
            <div class="mb-3">
                <label for="mst" class="form-label">Mã Số Thuế (MST)</label>
                <input id="mst" type="text" class="form-control" @bind="mstInput"
                       placeholder="VD: 0302839105-001" data-testid="mst-input" />
                <small class="form-text text-muted">@(IsCongNoType ? "Nhập MST đối tượng rồi bấm Tra cứu → tự điền tên công ty vào Đối tượng [G11]" : "Nhập MST nhà cung cấp/khách hàng rồi bấm Tra cứu để lấy thông tin doanh nghiệp")</small>
            </div>
            <div class="mt-2 d-flex align-items-center gap-2">
                <VanAButton
                    Variant="secondary"
                    Size="small"
                    Disabled="@_isLookupBusy"
                    OnClick="LookupMstAsync">
                    @(_isLookupBusy ? "Đang tra cứu..." : "Tra cứu MST")
                </VanAButton>
                @if (!string.IsNullOrWhiteSpace(lookupError))
                {
                    <span class="text-danger small">@lookupError</span>
                }
            </div>
            @if (lookupResult is not null)
            {
                <div class="mt-3">
                    <VanACard Header="Thông Tin Doanh Nghiệp">
                        <div class="mb-2 fw-bold">@lookupResult.BusinessName</div>
                        @if (!string.IsNullOrEmpty(lookupResult.Address))
                        {
                            <div class="small mb-1">@lookupResult.Address</div>
                        }
                        <div class="small mb-1">
                            MST: @lookupResult.TaxCode
                            @if (!string.IsNullOrEmpty(lookupResult.ProvinceName))
                            {
                                <span> · @lookupResult.ProvinceName</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(lookupResult.LegalRepName))
                        {
                            <div class="small mb-1">Người đại diện: @lookupResult.LegalRepName</div>
                        }
                        @if (!string.IsNullOrEmpty(lookupResult.IndustryName))
                        {
                            <div class="small mb-1">Ngành: @lookupResult.IndustryName</div>
                        }
                        <div class="small">
                            Trạng thái: <span class="badge @(lookupResult.Status == "active" ? "text-bg-success" : "text-bg-warning")">@StatusLabel(lookupResult.Status)</span>
                            @if (lookupResult.Source == "vanan")
                            {
                                <span class="text-muted">(dữ liệu từ hệ thống VanAn)</span>
                            }
                        </div>
                        @if (lookupResult.Status is "suspended" or "dissolved")
                        {
                            <div class="mt-2">
                                <VanAAlert Variant="warning" Message="Doanh nghiệp đã tạm ngừng hoặc giải thể — kiểm tra kỹ trước khi ghi sổ." Dismissible="false" />
                            </div>
                        }
                    </VanACard>
                </div>
            }
            <div class="mt-3">
                <button type="submit"
                        disabled="@_isSubmitting"
                        data-testid="expense-submit"
                        class="btn btn-primary">
                    Lưu Chi Phí
                </button>
            </div>
        </EditForm>
    </VanACard>
</div>

@code {
    private List<VanAn.UI.Platform.Components.Composite.FormField> expenseFields = new();
    private bool showSuccess = false;
    private bool showError = false;
    private string errorMessage = string.Empty;
    private bool _isSubmitting = false;
    private PlatformComposite.FormData formData = new();
    private DynamicFormFields? formFieldsRef;
    private TenantType? _tenantType;

    // TT 71 Phase 4b: dữ liệu phiếu chi 02-TT của entry vừa lưu (để in)
    private record VoucherData(string SoPhieu, string Ngay, string No, string Co, string NguoiNhan,
        string DiaChi, string LyDo, decimal SoTien, string KemTheo, string ChungTuGoc);
    private VoucherData? _lastVoucher;
    private bool _showPrintModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantTypeAsync();
        InitializeFields();
    }

    private async Task LoadTenantTypeAsync()
    {
        if (!TenantProvider.HasTenant) return;
        try
        {
            _tenantType = await FeatureFlagService.GetTenantTypeAsync(new TenantId(TenantProvider.TenantId));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Không lấy được TenantType — dùng options DN mặc định");
        }
    }

    private void OpenPrintModal() => _showPrintModal = true;
    private void ClosePrintModal() => _showPrintModal = false;

    private void HandleFieldChanged(PlatformComposite.FormField field)
    {
        formData.Values[field.Id] = field.Value?.ToString() ?? string.Empty;

        // Clear field error when value changes
        if (formFieldsRef != null)
        {
            formFieldsRef.ClearFieldErrors();
        }
    }

    /// <summary>
    /// THU CHI & CÔNG NỢ MVP (P2.2): đổi "Loại phiếu chi" (native select — trang host) →
    /// rebuild fields (ẩn/hiện Đối tượng, whitelist TK 331 vs 6xx) — giữ giá trị đã nhập.
    /// </summary>
    private void HandleVoucherTypeChanged()
    {
        RebuildFields();
    }

    private void ValidateForm()
    {
        if (formFieldsRef == null) return;

        formFieldsRef.ClearFieldErrors();
        bool hasErrors = false;

        // Validate required fields
        var requiredFields = expenseFields.Where(f => f.Required).ToList();
        foreach (var field in requiredFields)
        {
            var value = formData.Values.GetValueOrDefault(field.Id) ?? string.Empty;
            if (string.IsNullOrWhiteSpace(value))
            {
                formFieldsRef.SetFieldError(field.Id, $"{field.Label} là bắt buộc");
                hasErrors = true;
            }
        }

        // Validate amount — strip thousands separators before parsing (consistency with HandleSubmit)
        var amountStr = (formData.Values.GetValueOrDefault("amount") ?? "").Replace(".", "").Replace(",", "").Trim();
        if (!string.IsNullOrEmpty(amountStr))
        {
            if (decimal.TryParse(amountStr, out var amount))
            {
                if (amount <= 0)
                {
                    formFieldsRef.SetFieldError("amount", "Số tiền phải lớn hơn 0");
                    hasErrors = true;
                }
            }
            else
            {
                formFieldsRef.SetFieldError("amount", "Số tiền không hợp lệ");
                hasErrors = true;
            }
        }

        // Validate date
        if (!DateTime.TryParse(formData.Values.GetValueOrDefault("date"), out _))
        {
            formFieldsRef.SetFieldError("date", "Ngày không hợp lệ");
            hasErrors = true;
        }

        // Validate vendor requirement for specific categories
        var category = formData.Values.GetValueOrDefault("category") ?? string.Empty;
        var vendor = formData.Values.GetValueOrDefault("vendor") ?? string.Empty;
        if (VendorRequiredCategories.Contains(category) && string.IsNullOrWhiteSpace(vendor))
        {
            formFieldsRef.SetFieldError("vendor", "Nhà cung cấp bắt buộc khi loại chi phí là Nguyên vật liệu hoặc Bảo trì & Sửa chữa");
            hasErrors = true;
        }

        if (hasErrors)
        {
            showError = true;
            errorMessage = "Vui lòng sửa các lỗi trước khi lưu";
        }
    }

    private void InitializeFields()
    {
        var today = DateTime.Now.ToString("yyyy-MM-dd");
        var isCongNo = IsCongNoType;

        // Loại phiếu (voucherType) + Đối tượng (doiTuong) + MST (mst) là native controls
        // trong trang host (ShopERP — @bind hoạt động); DynamicFormFields chỉ giữ các field
        // còn lại (date/amount/account/description/reference + vendor/category khi chi phí thường).
        expenseFields = new List<PlatformComposite.FormField>
        {
            new PlatformComposite.FormField
            {
                Id = "date",
                Label = "Ngày",
                Type = PlatformComposite.FieldType.Date,
                Value = today,
                Required = true,
                HelpText = "Ngày phát sinh chi phí"
            },
            new PlatformComposite.FormField
            {
                Id = "amount",
                Label = "Số Tiền (VNĐ)",
                Type = PlatformComposite.FieldType.Currency,
                Placeholder = "0.00",
                Required = true,
                HelpText = isCongNo ? "Số tiền ghi nhận công nợ / trả nợ" : "Nhập số tiền chi phí"
            },
            new PlatformComposite.FormField
            {
                Id = "account",
                Label = "Tài Khoản",
                Type = PlatformComposite.FieldType.Select,
                Value = isCongNo ? "331" : "621",
                Options = isCongNo ? GetCongNoPayableAccounts() : GetExpenseAccounts(),
                Required = true,
                HelpText = isCongNo
                    ? "TK 331 - Phải trả người bán (phiếu công nợ — mua chịu không ghi chi phí [G6])"
                    : AccountingAccountProvider.GetAccountHelpText(_tenantType)
            },
            new PlatformComposite.FormField
            {
                Id = "description",
                Label = "Diễn Giải",
                Type = PlatformComposite.FieldType.TextArea,
                Placeholder = isCongNo ? "VD: Mua chịu — {đối tượng} (MST ...)" : "Nhập diễn giải giao dịch",
                Required = true,
                HelpText = "Mô tả chi tiết — để trống sẽ tự gợi ý theo loại phiếu"
            },
            new PlatformComposite.FormField
            {
                Id = "reference",
                Label = "Số Chứng Từ",
                Type = PlatformComposite.FieldType.Text,
                Placeholder = "VD: HĐ-001",
                HelpText = "Số hóa đơn hoặc chứng từ liên quan"
            }
        };

        if (isCongNo)
        {
            // FR-5: ô Đối tượng BẮT BUỘC với phiếu công nợ (mua chịu / trả nợ) — native control
            // (đã render trong trang host)
        }
        else
        {
            // Chi phí thường: giữ vendor + category (hành vi hiện tại)
            expenseFields.Add(new PlatformComposite.FormField
            {
                Id = "vendor",
                Label = "Nhà Cung Cấp",
                Type = PlatformComposite.FieldType.Text,
                Placeholder = "Tên nhà cung cấp",
                HelpText = "Nhà cung cấp hàng hóa/dịch vụ"
            });
            expenseFields.Add(new PlatformComposite.FormField
            {
                Id = "category",
                Label = "Loại Chi Phí",
                Type = PlatformComposite.FieldType.Select,
                Value = "other",
                Options = GetExpenseCategories(),
                Required = true,
                HelpText = "Phân loại chi phí"
            });
        }

        // Initialize formData.Values with default values so validation passes
        // even if the user doesn't interact with every field.
        formData = new PlatformComposite.FormData();
        foreach (var field in expenseFields)
        {
            formData.Values[field.Id] = field.Value ?? string.Empty;
        }

        lookupResult = null;
        lookupError = null;
    }

    /// <summary>
    /// THU CHI & CÔNG NỢ MVP (P2.2): rebuild danh sách field khi đổi loại phiếu —
    /// giữ giá trị đã nhập cho các field vẫn còn (date/amount/description/reference).
    /// </summary>
    private void RebuildFields()
    {
        var preserved = new Dictionary<string, string>(formData.Values);
        InitializeFields();
        foreach (var kv in preserved)
        {
            if (formData.Values.ContainsKey(kv.Key))
            {
                formData.Values[kv.Key] = kv.Value;
                var field = expenseFields.FirstOrDefault(f => f.Id == kv.Key);
                if (field != null)
                {
                    field.Value = kv.Value;
                }
            }
        }
        // Whitelist: chuyển loại công nợ → account = 331; về chi phí → mặc định 621
        var accountField = expenseFields.FirstOrDefault(f => f.Id == "account");
        if (accountField != null)
        {
            var forced = IsCongNoType ? "331" : "621";
            accountField.Value = forced;
            formData.Values["account"] = forced;
        }
        StateHasChanged();
    }

    // Loại phiếu chi (SRS §5.2 FR-4)
    private const string VoucherTypeExpense = "expense";        // Chi phí (hiện tại)
    private const string VoucherTypePayable = "payable";        // Ghi nhận phải trả (mua chịu)
    private const string VoucherTypePayment = "payable-payment"; // Trả tiền người bán

    private string _voucherType = VoucherTypeExpense;

    // Native controls (trang host — @bind hoạt động trong ShopERP)
    private string doiTuong = string.Empty;
    private string mstInput = string.Empty;

    private bool IsCongNoType => _voucherType is VoucherTypePayable or VoucherTypePayment;

    private List<PlatformComposite.FieldOption> GetVoucherTypeOptions()
    {
        return
        [
            new() { Value = VoucherTypeExpense, Label = "Chi phí" },
            new() { Value = VoucherTypePayable, Label = "Ghi nhận phải trả" },
            new() { Value = VoucherTypePayment, Label = "Trả tiền người bán" }
        ];
    }

    private static List<PlatformComposite.FieldOption> GetCongNoPayableAccounts()
    {
        return
        [
            new() { Value = "331", Label = "331 - Phải trả người bán" }
        ];
    }

    private BusinessInfoDto? lookupResult;
    private string? lookupError;
    private bool _isLookupBusy;

    private async Task LookupMstAsync()
    {
        var mst = mstInput.Trim();
        lookupError = null;
        lookupResult = null;
        if (!IsValidTaxCode(mst))
        {
            lookupError = "Mã số thuế không hợp lệ (10 hoặc 13 chữ số).";
            return;
        }

        _isLookupBusy = true;
        StateHasChanged();
        try
        {
            lookupResult = await BusinessInfo.GetByMstAsync(mst);
            if (lookupResult is null)
            {
                lookupError = "Không tìm thấy doanh nghiệp với mã số thuế này.";
                return;
            }

            // Autofill vendor with the looked-up company name (user still can edit)
            if (!string.IsNullOrWhiteSpace(lookupResult.BusinessName))
            {
                if (IsCongNoType)
                {
                    // THU CHI & CÔNG NỢ MVP (P2.2, SRS §5.2 FR-5 [G11]): tra MST → tự điền tên vào Đối tượng
                    doiTuong = lookupResult.BusinessName;

                    // Gợi ý diễn giải kèm MST (nếu đang trống)
                    var descField = expenseFields.FirstOrDefault(f => f.Id == "description");
                    if (descField != null && string.IsNullOrWhiteSpace(descField.Value))
                    {
                        var suggested = _voucherType == VoucherTypePayment
                            ? $"Trả tiền người bán — {lookupResult.BusinessName}"
                            : $"Mua chịu — {lookupResult.BusinessName}";
                        if (!string.IsNullOrWhiteSpace(mst))
                        {
                            suggested += $" (MST {mst})";
                        }
                        descField.Value = suggested;
                        formData.Values["description"] = suggested;
                    }
                }
                else
                {
                    var vendorField = expenseFields.FirstOrDefault(f => f.Id == "vendor");
                    if (vendorField is not null)
                    {
                        vendorField.Value = lookupResult.BusinessName;
                        formData.Values["vendor"] = lookupResult.BusinessName;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "MST lookup failed for {Mst}", mst);
            lookupError = ExtractErrorMessage(ex);
        }
        finally
        {
            _isLookupBusy = false;
            StateHasChanged();
        }
    }

    private static bool IsValidTaxCode(string taxCode)
    {
        if (string.IsNullOrWhiteSpace(taxCode)) return false;
        var digits = taxCode.Replace("-", "").Trim();
        return (digits.Length == 10 || digits.Length == 13) && digits.All(char.IsDigit);
    }

    private static string StatusLabel(string? status) => status switch
    {
        "active" => "Đang hoạt động",
        "suspended" => "Tạm ngừng",
        "dissolved" => "Đã giải thể",
        "pending" => "Chờ kích hoạt",
        "converted" => "Đã chuyển đổi",
        _ => status ?? "Không rõ"
    };

    private static string ExtractErrorMessage(Exception ex)
    {
        // GatewayAdminApiClientBase surfaces the server body as "Gateway API ... failed (400): {...}"
        var msg = ex.Message;
        var bodyStart = msg.IndexOf(": {", StringComparison.Ordinal);
        if (bodyStart >= 0)
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(msg[(bodyStart + 2)..]);
                if (doc.RootElement.TryGetProperty("error", out var errEl))
                    return errEl.GetString() ?? msg;
            }
            catch
            {
                // fall through to raw message
            }
        }
        return msg;
    }

    // TT 71 Phase 4a: options theo chuẩn tenant (HTX → 642/658; DN/HKD giữ nguyên)
    private List<PlatformComposite.FieldOption> GetExpenseAccounts()
    {
        return AccountingAccountProvider.GetExpenseAccounts(_tenantType);
    }

    private List<PlatformComposite.FieldOption> GetExpenseCategories()
    {
        return new List<PlatformComposite.FieldOption>
        {
            new PlatformComposite.FieldOption { Value = "materials", Label = "Nguyên vật liệu" },
            new PlatformComposite.FieldOption { Value = "labor", Label = "Nhân công" },
            new PlatformComposite.FieldOption { Value = "utilities", Label = "Điện nước" },
            new PlatformComposite.FieldOption { Value = "rent", Label = "Tiền thuê mặt bằng" },
            new PlatformComposite.FieldOption { Value = "marketing", Label = "Marketing & Quảng cáo" },
            new PlatformComposite.FieldOption { Value = "maintenance", Label = "Bảo trì & Sửa chữa" },
            new PlatformComposite.FieldOption { Value = "other", Label = "Khác" }
        };
    }

    private record RecentEntry(decimal Amount, DateTime Date, string AccountCode, DateTime SubmittedAt);
    private List<RecentEntry> _recentEntries = new();

    private static readonly HashSet<string> VendorRequiredCategories = new() { "materials", "maintenance" };

    private async Task HandleSubmit()
{
    Logger.LogInformation("ExpenseEntry HandleSubmit ENTERED");
    _isSubmitting = true;
    StateHasChanged();
    try
    {
        showSuccess = false;
        showError = false;
        Logger.LogInformation("Reset flags: showSuccess={showSuccess}, showError={showError}", showSuccess, showError);

        if (!TenantProvider.HasTenant)
        {
            showError = true;
            errorMessage = "Không xác định được tenant. Vui lòng đăng nhập lại.";
            StateHasChanged();
            return;
        }
        Logger.LogInformation("TenantId: {TenantId}", TenantProvider.TenantId);

        // Read DOM values for ALL fields BEFORE validation — Blazor @bind can drop events
        // during fast input, so DOM is source of truth at submit time.
        // Native controls (voucherType/doiTuong/mst) dùng @bind trực tiếp — không cần đọc DOM
        var criticalFields = new HashSet<string> { "amount", "category", "vendor", "description", "account", "date" };
        foreach (var field in expenseFields)
        {
            string value;
            // Always read from DOM for critical fields to handle binding race conditions
            if (criticalFields.Contains(field.Id))
            {
                try
                {
                    value = await JSRuntime.InvokeAsync<string>("vananReadElementValue", field.Id) ?? string.Empty;
                    // If DOM is empty, fall back to model value as safety net
                    if (string.IsNullOrEmpty(value))
                    {
                        value = field.Value?.ToString() ?? string.Empty;
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "JS interop read failed for critical field {FieldId}, using model fallback", field.Id);
                    value = field.Value?.ToString() ?? string.Empty;
                }
            }
            else
            {
                value = field.Value?.ToString() ?? string.Empty;
            }
            formData.Values[field.Id] = value;
            Logger.LogInformation("Field {FieldId}: '{FieldValue}' (source: {Source})", field.Id, value, criticalFields.Contains(field.Id) ? "DOM" : "model");
        }

        // Client-side validation (after DOM values are captured)
        ValidateForm();
        if (showError)
        {
            StateHasChanged();
            return;
        }

        // Validate amount - formData.Values["amount"] stores RAW numeric string (from HandleCurrencyInput)
        Logger.LogInformation("Validating amount: {Amount}", formData.Values["amount"]);
        var amountStr = (formData.Values.GetValueOrDefault("amount") ?? "").Replace(".", "").Replace(",", "").Trim();
        if (!decimal.TryParse(amountStr, out var amount) || amount <= 0)
        {
            Logger.LogWarning("Amount validation failed for: {AmountStr}", amountStr);
            showError = true;
            errorMessage = "Số tiền phải lớn hơn 0";
            if (formFieldsRef != null)
            {
                formFieldsRef.SetFieldError("amount", errorMessage);
            }
            StateHasChanged();
            return;
        }
        Logger.LogInformation("Amount validation passed: {Amount}", amount);

        // Validate date
        Logger.LogInformation("Validating date: {Date}", formData.Values["date"]);
        if (!DateTime.TryParse(formData.Values["date"], out var date))
        {
            Logger.LogWarning("Date validation failed");
            showError = true;
            errorMessage = "Ngày không hợp lệ";
            if (formFieldsRef != null)
            {
                formFieldsRef.SetFieldError("date", errorMessage);
            }
            StateHasChanged();
            return;
        }
        Logger.LogInformation("Date validation passed: {Date}", date);

        // Validate account code format: công nợ → 331; chi phí → 6xx
        var accountCode = formData.Values.GetValueOrDefault("account") ?? string.Empty;
        Logger.LogInformation("Validating account code: {AccountCode}", accountCode);
        if (IsCongNoType)
        {
            if (accountCode != "331")
            {
                Logger.LogWarning("Account code validation failed - cong-no expense must be 331");
                showError = true;
                errorMessage = "Phiếu công nợ phải trả chỉ dùng TK 331 (Phải trả người bán).";
                if (formFieldsRef != null)
                {
                    formFieldsRef.SetFieldError("account", errorMessage);
                }
                StateHasChanged();
                return;
            }
        }
        else if (string.IsNullOrEmpty(accountCode) || !IsValidExpenseAccountCode(accountCode))
        {
            Logger.LogWarning("Account code validation failed");
            showError = true;
            errorMessage = "Mã tài khoản không hợp lệ. Chi phí phải thuộc nhóm 6xx.";
            if (formFieldsRef != null)
            {
                formFieldsRef.SetFieldError("account", errorMessage);
            }
            StateHasChanged();
            return;
        }
        Logger.LogInformation("Account code validation passed");

        // THU CHI & CÔNG NỢ MVP (P2.2): đối tượng BẮT BUỘC với phiếu công nợ (FR-5)
        var doiTuong = this.doiTuong.Trim();
        if (IsCongNoType && string.IsNullOrWhiteSpace(doiTuong))
        {
            Logger.LogWarning("Doi tuong validation failed - required for cong-no");
            showError = true;
            errorMessage = "Đối tượng (nhà cung cấp) là bắt buộc với phiếu công nợ.";
            if (formFieldsRef != null)
            {
                formFieldsRef.SetFieldError("doiTuong", errorMessage);
            }
            StateHasChanged();
            return;
        }

        // Vendor required for material/maintenance categories (chỉ phiếu chi phí thường)
        var category = formData.Values.GetValueOrDefault("category") ?? string.Empty;
        var vendor = formData.Values.GetValueOrDefault("vendor") ?? string.Empty;
        Logger.LogInformation("Validating vendor: Category={Category}, Vendor={Vendor}", category, vendor);
        if (!IsCongNoType && VendorRequiredCategories.Contains(category) && string.IsNullOrWhiteSpace(vendor))
        {
            Logger.LogWarning("Vendor validation failed - vendor required for category {Category}", category);
            showError = true;
            errorMessage = "Nhà cung cấp bắt buộc khi loại chi phí là Nguyên vật liệu hoặc Bảo trì & Sửa chữa.";
            if (formFieldsRef != null)
            {
                formFieldsRef.SetFieldError("vendor", errorMessage);
            }
            StateHasChanged();
            return;
        }
        Logger.LogInformation("Vendor validation passed");

        // Duplicate check: same amount + date + account within 5 minutes
        // (chỉ áp dụng cho phiếu chi phí — phiếu công nợ bỏ qua, P1 decision #2)
        var now = DateTime.Now;
        _recentEntries.RemoveAll(e => (now - e.SubmittedAt).TotalMinutes > 5);
        if (!IsCongNoType)
        {
            var duplicate = _recentEntries.FirstOrDefault(e =>
                e.Amount == amount && e.Date.Date == date.Date && e.AccountCode == accountCode);

            if (duplicate != null)
            {
                Logger.LogWarning("Duplicate entry detected");
                showError = true;
                errorMessage = "Phát hiện bút toán trùng lặp (cùng số tiền, ngày, tài khoản trong 5 phút). Vui lòng kiểm tra lại.";
                StateHasChanged();
                return;
            }
        }
        Logger.LogInformation("Duplicate check passed");

        // Create accounting period
        var period = new AccountingPeriod(date.Year, date.Month);
        var tenantId = new TenantId(TenantProvider.TenantId);
        var description = formData.Values["description"];
        var reference = formData.Values.GetValueOrDefault("reference") ?? string.Empty;
        var mst = mstInput.Trim();

        if (IsCongNoType)
        {
            // Công nợ phải trả: ghi nhận mua chịu (+) hoặc trả tiền người bán (−) — [G9]
            // Diễn giải để trống → service tự gợi ý kèm MST [G11]; nếu nhập tay thì gắn thêm MST để truy vết.
            if (!string.IsNullOrWhiteSpace(mst) && !description.Contains(mst, StringComparison.OrdinalIgnoreCase))
            {
                description = $"{description} (MST {mst})";
            }

            await CongNoService.CreatePayableAsync(
                tenantId,
                amount,
                doiTuong,
                string.IsNullOrWhiteSpace(description) ? null : description,
                date,
                isPayment: _voucherType == VoucherTypePayment,
                mst: string.IsNullOrWhiteSpace(mst) ? null : mst,
                reference: string.IsNullOrWhiteSpace(reference) ? null : reference);
        }
        else
        {
            Logger.LogInformation("Calling AccountingService.CreateExpenseEntryAsync with Period={Period}, Amount={Amount}", period, amount);

            // Create accounting entry using IAccountingService — pass user-entered date as transactionDate
            // so TransactionHistory shows the correct date (not DateTime.UtcNow at creation time).
            await AccountingService.CreateExpenseEntryAsync(
                tenantId,
                period,
                amount,
                description,
                accountCode: accountCode,
                vendor: vendor,
                category: category,
                reference: reference,
                transactionDate: date);

            Logger.LogInformation("AccountingService.CreateExpenseEntryAsync completed successfully");

            // Track for duplicate detection
            _recentEntries.Add(new RecentEntry(amount, date, accountCode, now));
        }

        // TT 71 Phase 4b: capture dữ liệu phiếu chi 02-TT (chỉ tenant HTX) trước khi reset form
        if (!IsCongNoType && _tenantType == TenantType.HTX)
        {
            _lastVoucher = new VoucherData(
                SoPhieu: string.IsNullOrWhiteSpace(reference)
                    ? $"PC-{date:yyyyMMdd}-{_recentEntries.Count}"
                    : reference,
                Ngay: date.ToString("dd/MM/yyyy"),
                No: accountCode,
                Co: "111",
                NguoiNhan: vendor,
                DiaChi: string.Empty,
                LyDo: formData.Values["description"],
                SoTien: amount,
                KemTheo: string.Empty,
                ChungTuGoc: reference);
        }

        showSuccess = true;
        showError = false;
        errorMessage = string.Empty;
        Logger.LogInformation("Setting success state: showSuccess={showSuccess}, showError={showError}", showSuccess, showError);
        StateHasChanged();
        Logger.LogInformation("StateHasChanged called");

        // Reset form
        formData = new PlatformComposite.FormData();
        _voucherType = VoucherTypeExpense;
        doiTuong = string.Empty;
        mstInput = string.Empty;
        InitializeFields();
    }
    catch (Exception ex)
    {
        Logger.LogError(ex, "Error saving expense entry for tenant {TenantId}", TenantProvider.TenantId);
        showError = true;
        errorMessage = $"Lỗi khi lưu: {ex.Message}";
        Logger.LogInformation("Setting error state: showError={showError}, errorMessage={errorMessage}", showError, errorMessage);
        StateHasChanged();
    }
    finally
    {
        _isSubmitting = false;
        StateHasChanged();
    }
    }

    private static bool IsValidExpenseAccountCode(string code)
    {
        if (code.Length != 3) return false;
        return code.StartsWith("6");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/accounting");
    }
}
