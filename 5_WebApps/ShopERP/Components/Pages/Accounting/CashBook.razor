@page "/accounting/cash-book"
@rendermode InteractiveServer
@layout AccountingLayout
@attribute [Authorize(Policy = "AccountingFullAccess")]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.CoreHub.Services.GeneralLedger
@inject IGeneralLedgerService GeneralLedgerService
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject IJSRuntime JSRuntime
@inject ILogger<CashBook> Logger

@* SRS v1.2 W3/D (FR-RPT-003): Sổ quỹ tiền mặt — TK 111, dư đầu + thu − chi = tồn (running balance). *@
<div class="report-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Sổ Quỹ Tiền Mặt (TK 111)</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="PrintReport">
                🖨️ In báo cáo
            </VanAButton>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }

    <VanACard Header="Kỳ báo cáo">
        <div class="period-picker-row">
            <label>Năm: <input type="number" min="2000" max="2100" @bind="selectedYear" /></label>
            <label>Tháng:
                <select @bind="selectedMonth">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </label>
            <VanAButton Variant="primary" Size="small" OnClick="LoadReport">Áp dụng</VanAButton>
        </div>
    </VanACard>

    @if (loading)
    {
        <VanACard Header="Đang tải">
            <p>Đang tải Sổ Quỹ...</p>
        </VanACard>
    }
    else if (report != null)
    {
        <VanACard Header="@($"Sổ quỹ tiền mặt — tháng {selectedMonth:D2}/{selectedYear}")">
            <div class="totals-row">
                <strong>Tồn đầu kỳ:</strong> <span>@report.OpeningBalance.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                <strong>Tổng thu:</strong> <span>@report.PeriodDebitTotal.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                <strong>Tổng chi:</strong> <span>@report.PeriodCreditTotal.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                <strong>Tồn cuối kỳ:</strong> <span>@report.ClosingBalance.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
            </div>
            <VanAnDataGrid TItem="SubLedgerRowDto" Items="@report.Rows" EmptyMessage="Không có phát sinh trong kỳ">
                <Columns>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Ngày" Width="2">
                        <Template Context="r">
                            <span>@r.EntryDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Số CT" Width="2">
                        <Template Context="r">
                            <span>@r.JournalNo</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Diễn giải" Width="4">
                        <Template Context="r">
                            <span>@r.Description</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="TK ĐƯ" Width="1">
                        <Template Context="r">
                            <span>@r.CounterpartAccount</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Thu" Width="2">
                        <Template Context="r">
                            <span>@(r.Debit > 0 ? r.Debit.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) : "")</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Chi" Width="2">
                        <Template Context="r">
                            <span>@(r.Credit > 0 ? r.Credit.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) : "")</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="SubLedgerRowDto" Title="Tồn" Width="2">
                        <Template Context="r">
                            <span>@r.RunningBalance.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>
    }
</div>

@code {
    private const string CashAccountCode = "111";

    private SubLedgerReportDto? report;
    private bool loading = true;
    private string? errorMessage;
    private int selectedYear = DateTime.UtcNow.Year;
    private int selectedMonth = DateTime.UtcNow.Month;

    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
    }

    private async Task LoadReport()
    {
        loading = true;
        errorMessage = null;
        report = null;
        try
        {
            if (!TenantProvider.HasTenant)
            {
                errorMessage = "Không xác định được tenant. Vui lòng đăng nhập lại.";
                return;
            }
            TenantId tenantId = new(TenantProvider.TenantId);
            report = await GeneralLedgerService.GetSubLedgerAsync(
                tenantId, selectedYear, selectedMonth, CashAccountCode);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cash book for {Year}-{Month}", selectedYear, selectedMonth);
            errorMessage = $"Lỗi tải Sổ Quỹ: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task PrintReport() => await JSRuntime.InvokeVoidAsync("vananPrintBill");
}
