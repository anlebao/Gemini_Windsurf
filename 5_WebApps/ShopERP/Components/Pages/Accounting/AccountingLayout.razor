@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Models
@using VanAn.CoreHub.Services
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using Microsoft.AspNetCore.Components.Authorization
@using VanAn.ShopERP.Components.Shared
@inherits LayoutComponentBase

@if (_shouldRedirect)
{
    <div style="text-align:center; padding:60px 20px;">
        <h2>🔒 Cần chọn Tenant</h2>
        <p style="margin:16px 0;">SystemAdmin cần chọn một tenant để truy cập trang kế toán.</p>
        <a href="admin/tenants" class="vanan-button vanan-button--primary">Chọn Tenant</a>
        <script>setTimeout(function(){ window.location.href='admin/tenants'; }, 500);</script>
    </div>
}
else if (!_initialized)
{
    <div class="loading-state">
        <VanASpinner Size="large" />
    </div>
}
else
{
    <VanALayout>
        <Sidebar>
            <VanANavigation MenuItems="@AccountingMenuItems" />
        </Sidebar>
        <Header>
            <UserHeader />
        </Header>
        <ChildContent>
            @Body
        </ChildContent>
    </VanALayout>
}

@code {
    [Inject] private IVasFeatureFlagService FeatureFlagService { get; set; } = null!;
    [Inject] private ITenantProvider TenantProvider { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    private List<NavigationItem> AccountingMenuItems = new();
    private bool _isEnterprise;
    private bool _isHkd;
    private bool _initialized;
    private bool _shouldRedirect;

    protected override async Task OnInitializedAsync()
    {
        // BUG #1 FIX: SystemAdmin without tenant_id (not impersonating) must not access
        // tenant-scoped accounting pages. Show redirect prompt to tenant selection page.
        // Using client-side JS redirect (not NavigationManager) because YARP reverse proxy
        // doesn't forward the original Host header, causing server-side 302 redirects to
        // use the internal Docker hostname (http://shoperp/...) instead of the public URL.
        if (!TenantProvider.HasTenant)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var isSystemAdmin = authState.User.IsInRole("SystemAdmin");
            if (isSystemAdmin)
            {
                _shouldRedirect = true;
                return;
            }
        }

        // Build base menu (shared — HKD + Enterprise)
        // Bug 2A fix: "Sổ HKD" removed from base menu — inserted conditionally below for HKD tenants only
        AccountingMenuItems = new()
        {
            new() { Title = "← Sitemap", Icon = "house-door", Url = "/sitemap" },
            new() { Title = "Dashboard", Icon = "dashboard", Url = "/accounting" },
            new() { Title = "Sản phẩm", Icon = "box-seam", Url = "/products" },
            new() { Title = "Nhập Doanh Thu", Icon = "plus-circle", Url = "/accounting/revenue" },
            new() { Title = "Nhập Chi Phí", Icon = "minus-circle", Url = "/accounting/expenses" },
            new() { Title = "Lịch Sử Giao Dịch", Icon = "history", Url = "/accounting/history" },
            new() { Title = "Số Dư Tài Khoản", Icon = "account-balance", Url = "/accounting/balance" },
            new() { Title = "Đóng Sổ Kỳ", Icon = "lock", Url = "/accounting/period-closing" },
            new() { Title = "Đăng xuất", Icon = "box-arrow-right", Url = "/Logout" }
        };

        // W8 feature flag: only show VAS Financial Reports menu for Enterprise tenants
        // Bug 2A fix: only show "Sổ HKD" menu for HKD tenants (mutually exclusive with VAS)
        if (TenantProvider.HasTenant)
        {
            try
            {
                var tenantId = new TenantId(TenantProvider.TenantId);
                _isEnterprise = await FeatureFlagService.CanAccessVasReportsAsync(tenantId);
                _isHkd = !_isEnterprise;
                if (_isEnterprise)
                {
                    // Insert VAS menu before Đóng Sổ Kỳ
                    AccountingMenuItems.Insert(AccountingMenuItems.Count - 2,
                        new() { Title = "Báo Cáo Tài Chính", Icon = "bar-chart", Url = "/accounting/financial-reports" });
                }
                else if (_isHkd)
                {
                    // Bug 2A fix: Insert "Sổ HKD" before Đóng Sổ Kỳ (same position as VAS for UX consistency)
                    AccountingMenuItems.Insert(AccountingMenuItems.Count - 2,
                        new() { Title = "Sổ HKD (TT 152)", Icon = "book", Url = "/accounting/hkd-books" });
                }
            }
            catch
            {
                // If feature flag check fails, default to HKD menu (safe default — HKD is the common case)
                _isEnterprise = false;
                _isHkd = true;
                AccountingMenuItems.Insert(AccountingMenuItems.Count - 2,
                    new() { Title = "Sổ HKD (TT 152)", Icon = "book", Url = "/accounting/hkd-books" });
            }
        }
        else
        {
            // No tenant context (should not reach here — redirect handled above)
            _isHkd = true;
            AccountingMenuItems.Insert(AccountingMenuItems.Count - 2,
                new() { Title = "Sổ HKD (TT 152)", Icon = "book", Url = "/accounting/hkd-books" });
        }

        _initialized = true;
    }
}
