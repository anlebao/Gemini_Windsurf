@page "/accounting/financial-statement-notes"
@rendermode InteractiveServer
@layout AccountingLayout
@attribute [Authorize(Policy = "AccountingFullAccess")]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.ShopERP.Services.Accounting
@inject VanAn.CoreHub.Services.IFinancialStatementNotesService NotesService
@inject VanAn.ShopERP.Services.IFinancialReportExportService ExportService
@inject IAccountingStandardSelectionService StandardSelection
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject IJSRuntime JSRuntime
@inject ILogger<FinancialStatementNotes> Logger

<div class="report-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Bản Thuyết Minh BCTC (@AccountingFormLabels.FormCode(selectedStandard, "NT"))</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="GenerateReport">🔄 Tạo thuyết minh</VanAButton>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }

    @if (_allowedStandards is { Count: 0 })
    {
        <VanACard Header="Không áp dụng">
            <VanAAlert Type="info" Dismissible="false"
                Message="Hộ kinh doanh áp dụng sổ sách theo TT 152/2025/TT-BTC — hoặc tự nguyện áp dụng TT 58/2026 (Điều 2.2). Báo cáo tài chính doanh nghiệp không áp dụng cho HKD." />
            <a href="/accounting/hkd-books">📚 Mở Sổ HKD (TT 152)</a>
        </VanACard>
    }
    else
    {
    <VanACard Header="Kỳ báo cáo">
        <div class="period-picker-row">
            <label>Năm: <input type="number" min="2000" max="2100" @bind="selectedYear" /></label>
            <label>Tháng:
                <select @bind="selectedMonth">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </label>
            <label>Chuẩn kế toán:
                @if (_ntOptions.Count > 1)
                {
                    <select @bind="selectedStandard">
                        @foreach (var s in _ntOptions)
                        {
                            <option value="@s">@AccountingStandardResolver.DropdownLabel(s)</option>
                        }
                    </select>
                }
                else if (_ntOptions.Count == 1)
                {
                    <span>@AccountingStandardResolver.DropdownLabel(_ntOptions[0])</span>
                }
                @if (_isVoluntary)
                {
                    <small>(tự nguyện)</small>
                }
            </label>
            <VanAButton Variant="primary" Size="small" OnClick="GenerateReport">Áp dụng</VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="ExportDocx" Disabled="@exporting">📄 Xuất DOCX</VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="ExportXlsx" Disabled="@exporting">📊 Xuất XLSX</VanAButton>
        </div>
    </VanACard>
    }

    @if (selectedStandard == AccountingStandard.TT58_2026)
    {
        <VanAAlert Type="info" Message="TT 58/2026 (Chế độ kế toán DN siêu nhỏ) KHÔNG yêu cầu Bản thuyết minh BCTC (B09). BCTC DNSN chỉ gồm B01-DNSN và B02-DNSN." />
    }
    else if (loading)
    {
        <VanACard Header="Đang tạo thuyết minh">
            <p>Đang tạo Bản Thuyết Minh BCTC cho kỳ @selectedMonth/@selectedYear...</p>
        </VanACard>
    }
    else if (report != null)
    {
        @foreach (var noteSection in report.Sections)
        {
            <VanACard Header="@($"{noteSection.SectionCode}. {noteSection.SectionTitle}")">
                @if (!string.IsNullOrEmpty(noteSection.Content))
                {
                    <p>@noteSection.Content</p>
                }
                @if (noteSection.SubSections != null)
                {
                    <ul class="notes-subsections">
                        @foreach (var sub in noteSection.SubSections)
                        {
                            <li><strong>@sub.SectionCode. @sub.SectionTitle:</strong> @sub.Content</li>
                        }
                    </ul>
                }
            </VanACard>
        }
    }
</div>

@code {
    private VanAn.Shared.Domain.FinancialStatementNotes? report;
    private bool loading = true;
    private bool exporting;
    private string? errorMessage;

    private int selectedYear = DateTime.UtcNow.Year;
    private int selectedMonth = DateTime.UtcNow.Month;
    private AccountingStandard selectedStandard = AccountingStandard.TT99_2025;
    // Regime-lock (2026-10-30): allowed=null → chưa load; Count=0 → BCTC không áp dụng (HKD).
    private IReadOnlyList<AccountingStandard>? _allowedStandards;
    private static readonly AccountingStandard[] _ntStandards =
        [AccountingStandard.TT133_2016, AccountingStandard.TT99_2025, AccountingStandard.TT71_2024, AccountingStandard.TT58_2026];
    private bool _isVoluntary;
    private List<AccountingStandard> _ntOptions =>
        (_allowedStandards ?? _ntStandards).Intersect(_ntStandards).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (TenantProvider.HasTenant)
        {
            try
            {
                var sel = await StandardSelection.GetAsync(new TenantId(TenantProvider.TenantId));
                _allowedStandards = sel.Allowed;
                if (sel.Effective is { } eff) selectedStandard = eff;
                _isVoluntary = sel.IsVoluntary;
            }
            catch { /* fallback TT99 + đủ option */ }
        }
        if (_allowedStandards is { Count: 0 })
        {
            loading = false;
            return;
        }
        await GenerateReport();
    }

    private async Task GenerateReport()
    {
        loading = true;
        errorMessage = null;
        try
        {
            if (!TenantProvider.HasTenant)
            {
                errorMessage = "Không xác định được tenant. Vui lòng đăng nhập lại.";
                return;
            }

            TenantId tenantId = new(TenantProvider.TenantId);
            var period = new AccountingPeriod(selectedYear, selectedMonth);
            report = await NotesService.GenerateAsync(tenantId, period, selectedStandard, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating B 09-DN Financial Statement Notes for period {Year}-{Month}", selectedYear, selectedMonth);
            errorMessage = "Không thể tạo Bản Thuyết Minh BCTC. Vui lòng thử lại.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ExportDocx()
    {
        if (report == null) return;
        await DownloadFile(async () =>
        {
            return await ExportService.ExportNotesToDocxAsync(AccountingFormLabels.ExportTitle(selectedStandard, "NT", "Bản Thuyết Minh BCTC"), $"Tháng {selectedMonth:D2}/{selectedYear}", report.Sections.ToList());
        }, $"FinancialStatementNotes_{selectedYear}_{selectedMonth:D2}.docx");
    }

    private async Task ExportXlsx()
    {
        if (report == null) return;
        await DownloadFile(async () =>
        {
            return await ExportService.ExportNotesToXlsxAsync(AccountingFormLabels.ExportTitle(selectedStandard, "NT", "Bản Thuyết Minh BCTC"), $"Tháng {selectedMonth:D2}/{selectedYear}", report.Sections.ToList());
        }, $"FinancialStatementNotes_{selectedYear}_{selectedMonth:D2}.xlsx");
    }

    private async Task DownloadFile(Func<Task<byte[]>> produce, string fileName)
    {
        exporting = true;
        try
        {
            byte[] bytes = await produce();
            string base64 = Convert.ToBase64String(bytes);
            string mime = fileName.EndsWith(".docx") ? "application/vnd.openxmlformats-officedocument.wordprocessingml.document" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            await JSRuntime.InvokeVoidAsync("vanAn.downloadFile", base64, mime, fileName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting B 09-DN to {FileName}", fileName);
            errorMessage = "Không thể xuất file. Vui lòng thử lại.";
        }
        finally
        {
            exporting = false;
        }
    }
}
