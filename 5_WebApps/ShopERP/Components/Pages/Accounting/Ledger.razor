@page "/accounting/ledger"
@rendermode InteractiveServer
@layout AccountingLayout
@attribute [Authorize(Policy = "AccountingFullAccess")]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.UI.Platform.Models
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using VanAn.CoreHub.Services.GeneralLedger
@inject IGeneralLedgerService GeneralLedgerService
@inject IThemeProvider ThemeProvider
@inject ITenantProvider TenantProvider
@inject IJSRuntime JSRuntime
@inject ILogger<Ledger> Logger

<div class="report-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Sổ Cái</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="PrintReport">
                🖨️ In báo cáo
            </VanAButton>
        </div>
    </header>

    @if (errorMessage != null)
    {
        <VanAAlert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = null" />
    }

    <VanACard Header="Kỳ báo cáo & tài khoản">
        <div class="period-picker-row">
            <label>Năm: <input type="number" min="2000" max="2100" @bind="selectedYear" /></label>
            <label>Tháng:
                <select @bind="selectedMonth">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </label>
            <label>Tài khoản:
                <select @bind="selectedAccountCode">
                    <option value="">— Chọn TK —</option>
                    @foreach (var acc in accounts)
                    {
                        <option value="@acc.AccountCode">@acc.AccountCode @(acc.AccountName is null ? "" : $" - {acc.AccountName}")</option>
                    }
                </select>
            </label>
            <VanAButton Variant="primary" Size="small" OnClick="LoadReport">Áp dụng</VanAButton>
            <VanAButton Variant="success" Size="small" OnClick="ExportExcel" Disabled="@(report == null)">📊 Xuất Excel</VanAButton>
        </div>
    </VanACard>

    @if (loading)
    {
        <VanACard Header="Đang tải">
            <p>Đang tải Sổ Cái...</p>
        </VanACard>
    }
    else if (report != null)
    {
        @* W4 (P1.3 — TT 152/2025): chỉ thị đỏ khi số dư cuối kỳ ÂM (âm quỹ/âm kho sổ sách). *@
        @if (report.ClosingBalance < 0)
        {
            <VanAAlert Variant="error"
                       Message="@($"⚠ ÂM SỐ DƯ: TK {report.AccountCode} dư cuối kỳ {report.ClosingBalance:N0} đ — kiểm tra lại phát sinh trong kỳ (âm quỹ/âm kho vi phạm nguyên tắc kế toán).")"
                       Dismissible="false" />
        }
        <VanACard Header="@LedgerHeader">
            <div class="totals-row">
                <strong>Dư đầu kỳ:</strong> <span>@report.OpeningBalance.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                <strong>PS Nợ:</strong> <span>@report.PeriodDebitTotal.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                <strong>PS Có:</strong> <span>@report.PeriodCreditTotal.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                <strong>Dư cuối kỳ:</strong> <span class="@(report.ClosingBalance < 0 ? "text-danger fw-bold" : "")">@report.ClosingBalance.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
            </div>
            <VanAnDataGrid TItem="LedgerRowDto" Items="@report.Rows" EmptyMessage="Không có phát sinh trong kỳ">
                <Columns>
                    <VanAnColumn TItem="LedgerRowDto" Title="Ngày" Width="2">
                        <Template Context="r">
                            <span>@r.EntryDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="LedgerRowDto" Title="Số CT" Width="2">
                        <Template Context="r">
                            <span>@r.JournalNo</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="LedgerRowDto" Title="Diễn giải" Width="4">
                        <Template Context="r">
                            <span>@r.Description</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="LedgerRowDto" Title="Nợ" Width="2">
                        <Template Context="r">
                            <span>@r.Debit.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="LedgerRowDto" Title="Có" Width="2">
                        <Template Context="r">
                            <span>@r.Credit.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="LedgerRowDto" Title="Số dư" Width="2">
                        <Template Context="r">
                            @* W4 (P1.3): số dư âm → đỏ *@
                            <span class="@(r.RunningBalance < 0 ? "text-danger fw-bold" : "")">@r.RunningBalance.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span>
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>
    }
</div>

@code {
    private List<AccountActivityDto> accounts = new();
    private LedgerReportDto? report;
    private bool loading = true;
    private string? errorMessage;

    private string LedgerHeader =>
        report == null ? "Sổ Cái" : $"Sổ cái tài khoản {report.AccountCode} {report.AccountName ?? ""}";

    private int selectedYear = DateTime.UtcNow.Year;
    private int selectedMonth = DateTime.UtcNow.Month;
    private string selectedAccountCode = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        if (accounts.Count > 0 && string.IsNullOrEmpty(selectedAccountCode))
        {
            selectedAccountCode = accounts[0].AccountCode;
        }
        await LoadReport();
    }

    private async Task LoadAccounts()
    {
        try
        {
            if (!TenantProvider.HasTenant) return;
            TenantId tenantId = new(TenantProvider.TenantId);
            accounts = (await GeneralLedgerService.GetAccountsAsync(tenantId, selectedYear, selectedMonth)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading accounts");
        }
    }

    private async Task LoadReport()
    {
        loading = true;
        errorMessage = null;
        report = null;
        try
        {
            if (!TenantProvider.HasTenant)
            {
                errorMessage = "Không xác định được tenant. Vui lòng đăng nhập lại.";
                return;
            }
            if (string.IsNullOrWhiteSpace(selectedAccountCode))
            {
                errorMessage = "Vui lòng chọn tài khoản.";
                return;
            }

            TenantId tenantId = new(TenantProvider.TenantId);
            report = await GeneralLedgerService.GetLedgerAsync(tenantId, selectedYear, selectedMonth, selectedAccountCode);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading ledger for {Year}-{Month} TK {Account}", selectedYear, selectedMonth, selectedAccountCode);
            errorMessage = $"Lỗi tải Sổ Cái: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task PrintReport() => await JSRuntime.InvokeVoidAsync("vananPrintBill");

    // TUÂN THỦ PHÁP LÝ P0.2-Đ1 (2026-10-16): Xuất Excel theo Mẫu S02c1-DN (MauSoCaiKeToan.docx)
    // — cột Ngày ghi sổ | Chứng từ (Số hiệu, Ngày tháng) | Diễn giải | TK đối ứng | Nợ/Có | Ghi chú
    // + dòng Số dư đầu kỳ / Cộng PS tháng / Số dư cuối kỳ / Cộng lũy kế từ đầu quý.
    private async Task ExportExcel()
    {
        if (report == null) return;
        try
        {
            if (!TenantProvider.HasTenant) return;
            TenantId tenantId = new(TenantProvider.TenantId);
            var tenantInfo = await GeneralLedgerService.GetTenantInfoAsync(tenantId);
            var quarter = await GeneralLedgerService.GetQuarterTotalsAsync(tenantId, selectedYear, selectedMonth, report.AccountCode);
            byte[] bytes = LedgerExcelExportService.ExportSoCaiExcel(report, selectedYear, selectedMonth, tenantInfo, quarter);
            string base64 = Convert.ToBase64String(bytes);
            string fileName = $"so-cai-{report.AccountCode}_{selectedYear}{selectedMonth:D2}.xlsx";
            await JSRuntime.InvokeVoidAsync("vanAn.downloadFile", base64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", fileName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting ledger to Excel");
        }
    }
}