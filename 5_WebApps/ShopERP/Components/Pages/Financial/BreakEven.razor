@page "/financial/break-even"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Web
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Authorization
@using VanAn.ShopERP.Services
@using VanAn.CoreHub.Services.FinancialIntelligence.Dtos
@using VanAn.Shared.Domain
@inject FinancialIntelligenceHttpService FiClient
@inject IThemeProvider ThemeProvider
@inject IJSRuntime JSRuntime
@inject ILogger<BreakEven> Logger

@attribute [Authorize(Policy = "SystemAdmin")]

<div class="tenant-management-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Phân tích điểm hòa vốn</h1>
        <div class="header-actions">
            <label>Kỳ: </label>
            <select @bind="_selectedMonth" @bind:after="ReloadAsync" class="form-input" style="width: 130px;">
                @for (int m = 1; m <= 12; m++) { <option value="@m">Tháng @m</option> }
            </select>
            <select @bind="_selectedYear" @bind:after="ReloadAsync" class="form-input" style="width: 100px;">
                @for (int y = DateTime.UtcNow.Year - 3; y <= DateTime.UtcNow.Year + 1; y++) { <option value="@y">@y</option> }
            </select>
            <VanAButton Variant="primary" Size="small" OnClick="ExportExcelAsync" Disabled="@_exporting">
                @if (_exporting) { <span>Đang xuất...</span> } else { <span>Xuất Excel</span> }
            </VanAButton>
        </div>
    </header>

    @if (_loading)
    {
        <p>Đang tải...</p>
    }
    else if (_profileMissing)
    {
        <VanAAlert Type="warning" Dismissible="false">
            <span>Chưa khai báo hồ sơ doanh nghiệp. <a href="/admin/business-profile">Khai báo ngay →</a></span>
        </VanAAlert>
    }
    else if (_insufficientData)
    {
        <VanAAlert Type="info" Dismissible="false"><span>Chưa có dữ liệu kế toán kỳ này.</span></VanAAlert>
    }
    else if (_single == null)
    {
        <VanAAlert Type="error" Dismissible="false"><span>Không tải được dữ liệu. Kiểm tra kết nối Gateway.</span></VanAAlert>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_single.WarningMessage))
        {
            <VanAAlert Type="@(_single.ContributionMarginRatio <= 0 ? "error" : "warning")" Dismissible="false">
                <span>@_single.WarningMessage</span>
            </VanAAlert>
        }

        <VanACard Header="Điểm hòa vốn (tổng hợp)" Hoverable="true" data-testid="card-breakeven-single">
            <div class="metrics-row">
                <VanAMetricsCard Title="Doanh thu hòa vốn" Value="@FormatVnd(_single.BreakEvenRevenue)" Icon="⚖️" Color="primary" />
                <VanAMetricsCard Title="Sản lượng hòa vốn" Value="@_single.BreakEvenUnits.ToString("N0")" Icon="📦" Color="secondary" />
                <VanAMetricsCard Title="Biên an toàn" Value="@FormatVnd(_single.MarginOfSafetyRevenue)" Icon="🛡️" Color="@(_single.Status == BreakEvenStatus.AboveBreakEven ? "success" : "warning")" />
                <VanAMetricsCard Title="Trạng thái" Value="@BreakEvenStatusLabel(_single.Status)" Icon="📊" Color="@BreakEvenColor()" />
            </div>

            <table class="table" data-testid="table-breakeven-detail">
                <thead>
                    <tr><th>Chỉ tiêu</th><th>Giá trị</th></tr>
                </thead>
                <tbody>
                    <tr><td>Tổng chi phí cố định</td><td>@FormatVnd(_single.TotalFixedCost)</td></tr>
                    <tr><td>Tổng doanh thu</td><td>@FormatVnd(_single.TotalRevenue)</td></tr>
                    <tr><td>Tổng chi phí biến đổi</td><td>@FormatVnd(_single.TotalVariableCost)</td></tr>
                    <tr><td>Tổng biên đóng góp</td><td>@FormatVnd(_single.TotalContributionMargin)</td></tr>
                    <tr><td>Tỷ lệ biên đóng góp</td><td>@FormatPercent(_single.ContributionMarginRatio)</td></tr>
                    <tr><td>Doanh thu hòa vốn</td><td><strong>@FormatVnd(_single.BreakEvenRevenue)</strong></td></tr>
                    <tr><td>Sản lượng hòa vốn</td><td><strong>@_single.BreakEvenUnits.ToString("N0")</strong></td></tr>
                    <tr><td>Biên an toàn (VND)</td><td>@FormatVnd(_single.MarginOfSafetyRevenue)</td></tr>
                    <tr><td>Biên an toàn (%)</td><td>@FormatPercent(_single.MarginOfSafetyPercent)</td></tr>
                    <tr><td>Phiên bản mô hình</td><td>@_single.ModelVersion</td></tr>
                </tbody>
            </table>

            <h3>So sánh doanh thu thực tế vs hòa vốn</h3>
            <div class="bar-chart" data-testid="chart-breakeven">
                <div class="bar-row">
                    <span class="bar-label">Doanh thu thực tế</span>
                    <div class="bar-track">
                        <div class="bar-fill bar-fill--actual" style="width:@BarWidth(_single.TotalRevenue, _single.BreakEvenRevenue)%"></div>
                    </div>
                    <span class="bar-value">@FormatVnd(_single.TotalRevenue)</span>
                </div>
                <div class="bar-row">
                    <span class="bar-label">Doanh thu hòa vốn</span>
                    <div class="bar-track">
                        <div class="bar-fill bar-fill--breakeven" style="width:100%"></div>
                    </div>
                    <span class="bar-value">@FormatVnd(_single.BreakEvenRevenue)</span>
                </div>
            </div>
        </VanACard>

        <VanACard Header="Điểm hòa vốn đa sản phẩm" Hoverable="true" data-testid="card-breakeven-multi">
            @if (_multi == null || _multi.ProductLines.Count == 0)
            {
                <p class="text-muted">Chưa có dữ liệu sản phẩm cho kỳ này.</p>
            }
            else
            {
                <div class="metrics-row">
                    <VanAMetricsCard Title="Biên đóng góp trung bình" Value="@FormatVnd(_multi.WeightedContributionMargin)" Icon="📊" Color="info" />
                    <VanAMetricsCard Title="Tỷ lệ biên đóng góp TB" Value="@FormatPercent(_multi.WeightedContributionMarginRatio)" Icon="📈" Color="info" />
                    <VanAMetricsCard Title="Doanh thu hòa vốn (đa SP)" Value="@FormatVnd(_multi.BreakEvenRevenue)" Icon="⚖️" Color="primary" />
                </div>

                <table class="table" data-testid="table-breakeven-multi">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th><th>Giá bán</th><th>Chi phí biến đổi</th>
                            <th>Biên đóng góp</th><th>Tỷ lệ BCM</th><th>Cơ cấu bán</th>
                            <th>SL bán kỳ</th><th>SL hòa vốn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _multi.ProductLines)
                        {
                            <tr>
                                <td>@line.ProductName</td>
                                <td>@FormatVnd(line.SellingPrice)</td>
                                <td>@FormatVnd(line.VariableCost)</td>
                                <td>@FormatVnd(line.ContributionMargin)</td>
                                <td>@FormatPercent(line.ContributionMarginRatio)</td>
                                <td>@FormatPercent(line.SalesMixPercent)</td>
                                <td>@line.UnitsSoldInPeriod.ToString("N0")</td>
                                <td>@line.ProductBreakEvenUnits.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </VanACard>
    }
</div>

@code {
    private bool _loading = true;
    private bool _exporting;
    private int _selectedMonth = DateTime.UtcNow.Month;
    private int _selectedYear = DateTime.UtcNow.Year;

    private BreakEvenAnalysisDto? _single;
    private MultiProductBreakEvenDto? _multi;

    private bool _profileMissing;
    private bool _insufficientData;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _profileMissing = false;
        _insufficientData = false;
        try
        {
            var period = new AccountingPeriod(_selectedYear, _selectedMonth);
            _single = await FiClient.GetBreakEvenAsync(period);
            _multi = await FiClient.GetMultiProductBreakEvenAsync(period);
            if (_single != null && _single.Status == BreakEvenStatus.InsufficientData)
            {
                if (_single.WarningMessage != null && _single.WarningMessage.Contains("PROFILE", StringComparison.OrdinalIgnoreCase))
                    _profileMissing = true;
                else
                    _insufficientData = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "BreakEven load failed");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportExcelAsync()
    {
        if (_single == null) return;
        _exporting = true;
        try
        {
            byte[] bytes = await FinancialExportService.ExportBreakEvenAsync(_single, _multi);
            string base64 = Convert.ToBase64String(bytes);
            string fileName = $"BreakEven_{_selectedYear}_{_selectedMonth:D2}.xlsx";
            await JSRuntime.InvokeVoidAsync("vanAn.downloadFile", base64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", fileName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "BreakEven export failed");
        }
        finally
        {
            _exporting = false;
        }
    }

    private string BarWidth(decimal actual, decimal breakeven)
    {
        if (breakeven <= 0) return "100";
        var pct = (double)(actual / breakeven * 100);
        return Math.Clamp(pct, 0, 100).ToString("F0");
    }

    private static string FormatVnd(decimal v) => v.ToString("N0") + " đ";
    private static string FormatPercent(decimal v) => v.ToString("N1") + "%";
    private static string BreakEvenStatusLabel(BreakEvenStatus s) => s switch
    {
        BreakEvenStatus.AboveBreakEven => "Vượt hòa vốn",
        BreakEvenStatus.AtBreakEven => "Đạt hòa vốn",
        BreakEvenStatus.BelowBreakEven => "Chưa đạt",
        BreakEvenStatus.InsufficientData => "Chưa đủ DL",
        _ => "—"
    };
    private static string BreakEvenColor() => "primary";
}
