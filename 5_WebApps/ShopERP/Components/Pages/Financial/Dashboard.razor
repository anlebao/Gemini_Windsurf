@page "/financial"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Web
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using Microsoft.AspNetCore.Authorization
@using VanAn.ShopERP.Services
@using VanAn.CoreHub.Services.FinancialIntelligence.Dtos
@using VanAn.Shared.Domain
@inject FinancialIntelligenceHttpService FiClient
@inject IThemeProvider ThemeProvider
@inject NavigationManager Navigation
@inject ILogger<Dashboard> Logger

@attribute [Authorize(Policy = "OwnerOnly")]

<div class="tenant-management-page @ThemeProvider.CurrentTheme">
    <header class="page-header">
        <h1>Dashboard tài chính</h1>
        <div class="header-actions">
            <label>Kỳ: </label>
            <select @bind="_selectedMonth" @bind:after="ReloadAsync" class="form-input" style="width: 130px;">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m">Tháng @m</option>
                }
            </select>
            <select @bind="_selectedYear" @bind:after="ReloadAsync" class="form-input" style="width: 100px;">
                @for (int y = DateTime.UtcNow.Year - 3; y <= DateTime.UtcNow.Year + 1; y++)
                {
                    <option value="@y">@y</option>
                }
            </select>
            <VanAButton Variant="secondary" Size="small" OnClick="ReloadAsync">Làm mới</VanAButton>
        </div>
    </header>

    @if (_loading)
    {
        <p>Đang tải dữ liệu kỳ @_selectedYear-@_selectedMonth.ToString("00")...</p>
    }
    else
    {
        @* Warning banners (P4.6) *@
        @if (_profileMissing)
        {
            <VanAAlert Type="warning" Dismissible="false">
                <span>
                    Chưa khai báo hồ sơ doanh nghiệp (chi phí cố định).
                    <a href="/admin/business-profile" data-testid="link-setup-profile">Khai báo ngay →</a>
                </span>
            </VanAAlert>
        }

        @if (_insufficientData)
        {
            <VanAAlert Type="info" Dismissible="false">
                <span>Chưa có dữ liệu kế toán kỳ này. Bảng kê số liệu sẽ có sau khi nhập doanh thu/chi phí.</span>
            </VanAAlert>
        }

        @if (_warningMessage != null)
        {
            <VanAAlert Type="@(_warningIsCritical ? "error" : "warning")" Dismissible="false">
                <span>@_warningMessage</span>
            </VanAAlert>
        }

        <div class="dashboard-grid">
            @* Widget 1: Profit Summary *@
            <VanAMetricsCard Title="Doanh thu kỳ" Value="@FormatVnd(_profit?.Revenue ?? 0)"
                             Icon="📈" Color="primary" data-testid="widget-revenue">
                <div class="metric-sub">
                    <div>Lợi nhuận ròng: <strong>@FormatVnd(_profit?.NetProfit ?? 0)</strong></div>
                    <div>Biên lợi nhuận: <strong>@FormatPercent(_profit?.NetMarginPercent ?? 0)</strong></div>
                    <div>Trạng thái: <strong>@ProfitStatusLabel(_profit?.Status)</strong></div>
                </div>
            </VanAMetricsCard>

            @* Widget 2: Break-even status *@
            <VanAMetricsCard Title="Điểm hòa vốn" Value="@FormatVnd(_breakEven?.BreakEvenRevenue ?? 0)"
                             Icon="⚖️" Color="@BreakEvenColor()" data-testid="widget-breakeven">
                <div class="metric-sub">
                    <div>Tổng chi phí cố định: <strong>@FormatVnd(_breakEven?.TotalFixedCost ?? 0)</strong></div>
                    <div>Biên an toàn: <strong>@FormatVnd(_breakEven?.MarginOfSafetyRevenue ?? 0)</strong> (@FormatPercent(_breakEven?.MarginOfSafetyPercent ?? 0))</div>
                    <div>Trạng thái: <strong>@BreakEvenStatusLabel(_breakEven?.Status)</strong></div>
                </div>
            </VanAMetricsCard>

            @* Widget 3: Top 5 products *@
            <VanACard Header="🏆 Top 5 sản phẩm (theo đóng góp lợi nhuận)" Hoverable="true" data-testid="widget-top5">
                @if (_topProducts.Count == 0)
                {
                    <p class="text-muted">Chưa có dữ liệu.</p>
                }
                else
                {
                    <table class="table">
                        <thead><tr><th>#</th><th>Sản phẩm</th><th>Đóng góp</th></tr></thead>
                        <tbody>
                            @for (int i = 0; i < _topProducts.Count; i++)
                            {
                                var p = _topProducts[i];
                                <tr><td>@(i + 1)</td><td>@p.ProductName</td><td>@FormatVnd(p.ProfitContribution)</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </VanACard>

            @* Widget 4: Bottom 5 products *@
            <VanACard Header="⚠️ 5 sản phẩm đóng góp thấp nhất" Hoverable="true" data-testid="widget-bottom5">
                @if (_bottomProducts.Count == 0)
                {
                    <p class="text-muted">Chưa có dữ liệu.</p>
                }
                else
                {
                    <table class="table">
                        <thead><tr><th>#</th><th>Sản phẩm</th><th>Đóng góp</th><th>Thiếu giá vốn</th></tr></thead>
                        <tbody>
                            @for (int i = 0; i < _bottomProducts.Count; i++)
                            {
                                var p = _bottomProducts[i];
                                <tr class="@(p.HasMissingCostPrice ? "row-warning" : "")">
                                    <td>@(i + 1)</td>
                                    <td>@p.ProductName</td>
                                    <td>@FormatVnd(p.ProfitContribution)</td>
                                    <td>@(p.HasMissingCostPrice ? "⚠️ Có" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </VanACard>

            @* Widget 5: Target Profit calculator *@
            <VanACard Header="🎯 Tính doanh thu cần thiết để đạt lợi nhuận mục tiêu" Hoverable="true" data-testid="widget-target-profit">
                <div class="target-profit-input">
                    <label for="target">Lợi nhuận mục tiêu (VND):</label>
                    <input id="target" type="number" min="0" step="100000" @bind="_targetProfit" class="form-input" />
                    <VanAButton Variant="primary" Size="small" OnClick="CalculateTargetAsync" Disabled="@_calculating">
                        @if (_calculating) { <span>Đang tính...</span> } else { <span>Tính</span> }
                    </VanAButton>
                </div>
                @if (_target != null)
                {
                    <div class="target-profit-result">
                        <p>Doanh thu cần thiết: <strong>@FormatVnd(_target.RequiredRevenue)</strong></p>
                        <p>Số lượng cần bán: <strong>@_target.RequiredUnits.ToString("N0")</strong> đơn vị</p>
                        <p>Doanh thu/ngày: <strong>@_target.RequiredDailyUnits.ToString("N0")</strong> đơn vị</p>
                        <p>
                            Khả thi: <strong class="@(_target.Feasible ? "text-success" : "text-danger")">
                                @(_target.Feasible ? "Đạt ✓" : "Vượt sức chứa ⚠️")
                            </strong>
                        </p>
                        @if (!string.IsNullOrEmpty(_target.FeasibilityWarning))
                        {
                            <VanAAlert Type="warning" Dismissible="false"><span>@_target.FeasibilityWarning</span></VanAAlert>
                        }
                    </div>
                }
            </VanACard>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _calculating;
    private int _selectedMonth = DateTime.UtcNow.Month;
    private int _selectedYear = DateTime.UtcNow.Year;

    private ProfitSummaryDto? _profit;
    private BreakEvenAnalysisDto? _breakEven;
    private UnitEconomicsReportDto? _unitEconomics;
    private TargetProfitAnalysisDto? _target;
    private List<UnitEconomicsLineDto> _topProducts = new();
    private List<UnitEconomicsLineDto> _bottomProducts = new();

    private bool _profileMissing;
    private bool _insufficientData;
    private string? _warningMessage;
    private bool _warningIsCritical;
    private decimal _targetProfit = 5_000_000m;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _profileMissing = false;
        _insufficientData = false;
        _warningMessage = null;
        _target = null;
        try
        {
            var period = new AccountingPeriod(_selectedYear, _selectedMonth);
            _profit = await FiClient.GetProfitSummaryAsync(period);
            _breakEven = await FiClient.GetBreakEvenAsync(period);
            _unitEconomics = await FiClient.GetUnitEconomicsAsync(period);
            ProcessWarnings();
            ProcessUnitEconomics();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dashboard load failed");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ProcessWarnings()
    {
        // Break-even warning is the canonical source (covers PROFILE_MISSING, INSUFFICIENT_DATA, CM, FIXED_COST_ZERO)
        if (_breakEven != null)
        {
            if (_breakEven.Status == BreakEvenStatus.InsufficientData)
            {
                if (_breakEven.WarningMessage != null && _breakEven.WarningMessage.Contains("PROFILE", StringComparison.OrdinalIgnoreCase))
                    _profileMissing = true;
                else
                    _insufficientData = true;
            }
            else if (!string.IsNullOrEmpty(_breakEven.WarningMessage))
            {
                _warningMessage = _breakEven.WarningMessage;
                _warningIsCritical = _breakEven.ContributionMarginRatio <= 0;
            }
        }
        if (_profit != null && _profit.Status == ProfitStatus.InsufficientData && !_profileMissing && !_insufficientData)
            _insufficientData = true;
    }

    private void ProcessUnitEconomics()
    {
        if (_unitEconomics?.Products == null) { _topProducts = new(); _bottomProducts = new(); return; }
        var ordered = _unitEconomics.Products.OrderByDescending(p => p.ProfitContribution).ToList();
        _topProducts = ordered.Take(5).ToList();
        _bottomProducts = ordered.AsEnumerable().Reverse().Take(5).Reverse().ToList();
    }

    private async Task CalculateTargetAsync()
    {
        _calculating = true;
        try
        {
            var period = new AccountingPeriod(_selectedYear, _selectedMonth);
            _target = await FiClient.AnalyzeTargetProfitAsync(period, AccountingStandard.TT99_2025, _targetProfit);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Target profit calc failed");
        }
        finally
        {
            _calculating = false;
        }
    }

    private static string FormatVnd(decimal v) => v.ToString("N0") + " đ";
    private static string FormatPercent(decimal v) => v.ToString("N1") + "%";
    private static string ProfitStatusLabel(ProfitStatus? s) => s switch
    {
        ProfitStatus.Profitable => "Có lãi",
        ProfitStatus.AtBreakEven => "Hòa vốn",
        ProfitStatus.Loss => "Lỗ",
        ProfitStatus.InsufficientData => "Chưa đủ dữ liệu",
        _ => "—"
    };
    private static string BreakEvenStatusLabel(BreakEvenStatus? s) => s switch
    {
        BreakEvenStatus.AboveBreakEven => "Vượt hòa vốn",
        BreakEvenStatus.AtBreakEven => "Đạt hòa vốn",
        BreakEvenStatus.BelowBreakEven => "Chưa đạt hòa vốn",
        BreakEvenStatus.InsufficientData => "Chưa đủ dữ liệu",
        _ => "—"
    };
    private string BreakEvenColor() => _breakEven?.Status switch
    {
        BreakEvenStatus.AboveBreakEven => "success",
        BreakEvenStatus.AtBreakEven => "info",
        BreakEvenStatus.BelowBreakEven => "warning",
        _ => "secondary"
    };
}
