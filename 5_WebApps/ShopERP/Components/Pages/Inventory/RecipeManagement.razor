@page "/inventory/recipes"
@rendermode InteractiveServer
@layout AdminLayout
@attribute [Authorize(Policy = "StoreManagement")]
@using Microsoft.AspNetCore.Authorization
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.CoreHub.Services.InventoryIntelligence
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@inject IRecipeService RecipeService
@inject ITenantProvider TenantProvider
@inject ILogger<RecipeManagement> Logger

<PageTitle>Công thức pha chế - Vạn An</PageTitle>

<div class="va-iie-recipe-page">
    <header class="page-header mb-4">
        <h1><i class="bi bi-cup-hot"></i> Công thức pha chế (Recipe)</h1>
        <div class="header-actions">
            <VanAButton Variant="secondary" Size="small" OnClick="ReloadAll">
                <i class="bi bi-arrow-clockwise"></i> Làm mới
            </VanAButton>
        </div>
    </header>

    @if (_loading)
    {
        <VanASpinner Text="Đang tải..." />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <VanAAlert Variant="error" Message="@_errorMessage" Dismissible="true" OnDismiss="() => _errorMessage = null" />
    }
    else
    {
        <div class="row g-3">
            <!-- Danh sách sản phẩm -->
            <div class="col-md-5">
                <VanACard Header="Sản phẩm">
                    <VanAnDataGrid TItem="Product" Items="@_products" EmptyMessage="Chưa có sản phẩm.">
                        <Columns>
                            <VanAnColumn TItem="Product" Title="Tên" Width="6">
                                <Template Context="p"><span>@p.Name</span></Template>
                            </VanAnColumn>
                            <VanAnColumn TItem="Product" Title="Recipe" Width="3">
                                <Template Context="p">
                                    @if (_activeVersionByProduct.TryGetValue(p.Id, out int v))
                                    {
                                        <span class="badge bg-success">v@v</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Chưa có</span>
                                    }
                                </Template>
                            </VanAnColumn>
                            <VanAnColumn TItem="Product" Title="" Width="3">
                                <Template Context="p">
                                    <VanAButton Variant="outline" Size="small" OnClick="() => SelectProduct(p.Id)">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </VanAButton>
                                </Template>
                            </VanAnColumn>
                        </Columns>
                    </VanAnDataGrid>
                </VanACard>
            </div>

            <!-- Editor recipe -->
            <div class="col-md-7">
                @if (_selectedProductId == Guid.Empty)
                {
                    <VanACard Header="Công thức">
                        <VanAAlert Variant="info" Dismissible="false">Chọn sản phẩm để xem/sửa công thức pha chế.</VanAAlert>
                    </VanACard>
                }
                else
                {
                    <VanACard Header="@($"Công thức: {_selectedProduct?.Name ?? string.Empty}")">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Yield (số lượng pha / lần)</label>
                                <VanAInput Id="recipe-yield" Type="number" Value="@_yield" ValueChanged="OnYieldChanged" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Waste factor (hao hụt chuẩn, %)</label>
                                <VanAInput Id="recipe-waste" Type="number" Value="@_wasteFactor" ValueChanged="OnWasteChanged" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <VanAButton Variant="primary" OnClick="SaveRecipe" Loading="@_saving">
                                    <i class="bi bi-plus-circle"></i> Lưu (publish version mới)
                                </VanAButton>
                            </div>
                        </div>

                        <VanAAlert Variant="info" Dismissible="false">
                            Mỗi lần lưu = <strong>publish version mới</strong> (SRS §3.2.3) — version cũ giữ nguyên để đối chiếu lịch sử.
                        </VanAAlert>

                        <h6 class="mt-3">Định mức nguyên liệu</h6>
                        @foreach (var line in _editLines)
                        {
                            <div class="row g-2 mb-2 align-items-end">
                                <div class="col-md-5">
                                    <VanASelect Id="@($"line-ing-{line.Id}")" Value="@line.IngredientId.ToString()"
                                                ValueChanged="(v) => OnLineIngredientChanged(line.Id, v)"
                                                Options="@_ingredientOptions" AriaLabel="Nguyên liệu" />
                                </div>
                                <div class="col-md-2">
                                    <VanAInput Id="@($"line-qty-{line.Id}")" Type="number" Value="@line.Quantity"
                                               ValueChanged="(v) => OnLineQuantityChanged(line.Id, v)" AriaLabel="Số lượng" />
                                </div>
                                <div class="col-md-3">
                                    <VanAInput Id="@($"line-unit-{line.Id}")" Value="@line.Unit"
                                               ValueChanged="(v) => OnLineUnitChanged(line.Id, v)" AriaLabel="Đơn vị" />
                                </div>
                                <div class="col-md-2">
                                    <VanAButton Variant="danger" Size="small" OnClick="() => RemoveLine(line.Id)">
                                        <i class="bi bi-trash"></i>
                                    </VanAButton>
                                </div>
                            </div>
                        }
                        <VanAButton Variant="secondary" Size="small" OnClick="AddLine">
                            <i class="bi bi-plus-lg"></i> Thêm nguyên liệu
                        </VanAButton>

                        <h6 class="mt-4">Lịch sử version</h6>
                        <VanAnDataGrid TItem="Recipe" Items="@_versions" EmptyMessage="Chưa có recipe nào.">
                            <Columns>
                                <VanAnColumn TItem="Recipe" Title="Version" Width="2">
                                    <Template Context="r"><span class="fw-bold">v@r.Version</span></Template>
                                </VanAnColumn>
                                <VanAnColumn TItem="Recipe" Title="Trạng thái" Width="2">
                                    <Template Context="r">
                                        <span class="badge @(r.IsActive ? "bg-success" : "bg-secondary")">@(r.IsActive ? "Active" : "Cũ")</span>
                                    </Template>
                                </VanAnColumn>
                                <VanAnColumn TItem="Recipe" Title="Hiệu lực từ" Width="3">
                                    <Template Context="r"><span>@r.EffectiveFrom.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></Template>
                                </VanAnColumn>
                                <VanAnColumn TItem="Recipe" Title="Số nguyên liệu" Width="3">
                                    <Template Context="r"><span>@r.Lines.Count</span></Template>
                                </VanAnColumn>
                                <VanAnColumn TItem="Recipe" Title="" Width="2">
                                    <Template Context="r">
                                        @if (!r.IsActive)
                                        {
                                            <VanAButton Variant="outline" Size="small" OnClick="() => ActivateVersion(r.Id)">
                                                <i class="bi bi-check2"></i> Kích hoạt
                                            </VanAButton>
                                        }
                                    </Template>
                                </VanAnColumn>
                            </Columns>
                        </VanAnDataGrid>
                    </VanACard>
                }
            </div>
        </div>
    }
</div>

@code {
    private sealed class EditableLine
    {
        public Guid Id { get; } = Guid.NewGuid();
        public Guid IngredientId { get; set; } = Guid.Empty;
        public string Quantity { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
    }

    private IReadOnlyList<Product> _products = [];
    private IReadOnlyList<Ingredient> _ingredients = [];
    private Dictionary<Guid, int> _activeVersionByProduct = [];
    private Product? _selectedProduct;
    private Guid _selectedProductId = Guid.Empty;
    private IReadOnlyList<Recipe> _versions = [];
    private List<EditableLine> _editLines = [];
    private string _yield = "1";
    private string _wasteFactor = "0";
    private TenantId _tenantId = null!;

    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    private List<VanASelect.SelectOption> _ingredientOptions => _ingredients
        .Select(i => new VanASelect.SelectOption(i.Id.ToString(), $"{i.Name} ({i.Unit})"))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!TenantProvider.HasTenant)
            {
                _errorMessage = "Không xác định được tenant. Vui lòng đăng nhập lại.";
                return;
            }
            _tenantId = new TenantId(TenantProvider.TenantId);
            await ReloadAll();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "VA-IIE: error loading recipe management");
            _errorMessage = "Lỗi tải dữ liệu. Vui lòng thử lại.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAll()
    {
        _products = await RecipeService.GetProductsAsync(_tenantId);
        _ingredients = await RecipeService.GetIngredientsAsync(_tenantId);

        _activeVersionByProduct = [];
        foreach (var product in _products)
        {
            var active = await RecipeService.GetActiveByProductIdAsync(product.Id);
            if (active != null)
            {
                _activeVersionByProduct[product.Id] = active.Version;
            }
        }

        if (_selectedProductId != Guid.Empty)
        {
            await SelectProduct(_selectedProductId);
        }
    }

    private async Task SelectProduct(Guid productId)
    {
        _selectedProductId = productId;
        _selectedProduct = _products.FirstOrDefault(p => p.Id == productId);
        _versions = await RecipeService.GetVersionsAsync(productId);

        _editLines = [];
        var active = await RecipeService.GetActiveByProductIdAsync(productId);
        if (active != null)
        {
            _yield = active.Yield.ToString("0.##");
            _wasteFactor = (active.WasteFactor * 100m).ToString("0.##");
            foreach (var line in active.Lines)
            {
                _editLines.Add(new EditableLine
                {
                    IngredientId = line.IngredientId,
                    Quantity = line.Quantity.ToString("0.####"),
                    Unit = line.Unit
                });
            }
        }
        else
        {
            _yield = "1";
            _wasteFactor = "0";
            _editLines.Add(new EditableLine());
        }
    }

    private void AddLine() => _editLines.Add(new EditableLine());

    private void RemoveLine(Guid lineId) => _editLines.RemoveAll(l => l.Id == lineId);

    private void OnLineIngredientChanged(Guid lineId, string value)
    {
        var line = _editLines.FirstOrDefault(l => l.Id == lineId);
        if (line == null)
        {
            return;
        }
        line.IngredientId = Guid.TryParse(value, out var id) ? id : Guid.Empty;
        // Tự động điền đơn vị cơ sở của nguyên liệu (Q3-C).
        var ingredient = _ingredients.FirstOrDefault(i => i.Id == line.IngredientId);
        if (ingredient != null && string.IsNullOrWhiteSpace(line.Unit))
        {
            line.Unit = ingredient.Unit;
        }
    }

    private void OnLineQuantityChanged(Guid lineId, string value)
    {
        var line = _editLines.FirstOrDefault(l => l.Id == lineId);
        if (line != null)
        {
            line.Quantity = value;
        }
    }

    private void OnLineUnitChanged(Guid lineId, string value)
    {
        var line = _editLines.FirstOrDefault(l => l.Id == lineId);
        if (line != null)
        {
            line.Unit = value;
        }
    }

    private void OnYieldChanged(string value) => _yield = value;

    private void OnWasteChanged(string value) => _wasteFactor = value;

    private async Task SaveRecipe()
    {
        if (_editLines.Count == 0 || _editLines.All(l => l.IngredientId == Guid.Empty))
        {
            _errorMessage = "Cần ít nhất 1 nguyên liệu trong công thức.";
            return;
        }

        if (!decimal.TryParse(_yield, out decimal yield) || yield <= 0)
        {
            _errorMessage = "Yield phải là số dương.";
            return;
        }
        if (!decimal.TryParse(_wasteFactor, out decimal wastePercent))
        {
            _errorMessage = "Waste factor phải là số.";
            return;
        }

        List<RecipeLineInput> lines = [];
        foreach (var line in _editLines)
        {
            if (line.IngredientId == Guid.Empty)
            {
                continue;
            }
            if (!decimal.TryParse(line.Quantity, out decimal qty) || qty <= 0)
            {
                _errorMessage = $"Số lượng nguyên liệu '{line.IngredientId}' không hợp lệ.";
                return;
            }
            lines.Add(new RecipeLineInput(line.IngredientId, qty, line.Unit));
        }

        _saving = true;
        _errorMessage = null;
        try
        {
            var tenantId = new TenantId(TenantProvider.TenantId);
            if (_versions.Count == 0)
            {
                await RecipeService.CreateAsync(tenantId, _selectedProductId, lines, yield, wastePercent / 100m);
            }
            else
            {
                await RecipeService.PublishNewVersionAsync(tenantId, _selectedProductId, lines, yield, wastePercent / 100m);
            }
            await ReloadAll();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "VA-IIE: error saving recipe");
            _errorMessage = "Không lưu được công thức. Vui lòng thử lại.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ActivateVersion(Guid recipeId)
    {
        try
        {
            await RecipeService.SetActiveAsync(recipeId, true);
            await ReloadAll();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "VA-IIE: error activating recipe version");
            _errorMessage = ex.Message;
        }
    }
}
