@page "/inventory/alerts"
@rendermode InteractiveServer
@layout AdminLayout
@attribute [Authorize(Policy = "InventoryAccess")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using VanAn.UI.Platform.Components
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Components.Data
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Common
@using AlertSeverity = VanAn.Shared.Domain.AlertSeverity
@using VanAn.CoreHub.Services.InventoryIntelligence
@inject VanAn.CoreHub.Infrastructure.IVanAnDbContext DbContext
@inject ITenantProvider TenantProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject IForecastService ForecastService
@inject ILogger<AlertCenter> Logger

<PageTitle>Cảnh báo - Vạn An</PageTitle>

<div class="va-iie-alert-page">
    <header class="page-header mb-4">
        <h1><i class="bi bi-bell"></i> Cảnh báo (Alert Center)</h1>
        <div class="header-actions">
            <AuthorizeView Roles="Owner">
                <Authorized>
                    <VanAButton Variant="outline" Size="small" OnClick="OpenNotificationConfig" Disabled="@(!TenantProvider.HasTenant)">
                        <i class="bi bi-telegram"></i> Cảnh báo Telegram/Zalo
                    </VanAButton>
                </Authorized>
            </AuthorizeView>
            <VanAButton Variant="secondary" Size="small" OnClick="LoadAlerts">
                <i class="bi bi-arrow-clockwise"></i> Làm mới
            </VanAButton>
        </div>
    </header>

    @if (_loading)
    {
        <VanASpinner Text="Đang tải..." />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <VanAAlert Variant="error" Message="@_errorMessage" Dismissible="true" OnDismiss="() => _errorMessage = null" />
    }
    else
    {
        <VanACard Header="Bộ lọc">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Mức độ</label>
                    <VanASelect Id="alert-severity" Value="@_severityFilter" ValueChanged="OnSeverityFilterChanged"
                                Options="@_severityOptions" AriaLabel="Mức độ" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <VanASelect Id="alert-status" Value="@_statusFilter" ValueChanged="OnStatusFilterChanged"
                                Options="@_statusOptions" AriaLabel="Trạng thái" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Tìm kiếm (mã / nội dung)</label>
                    <VanAInput Id="alert-search" Value="@_search" ValueChanged="OnSearchChanged" Placeholder="vd: STOCK_LOW, hao hụt..." AriaLabel="Tìm kiếm" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <VanAButton Variant="outline" Size="small" OnClick="ResetFilters">
                        <i class="bi bi-x-circle"></i> Xoá bộ lọc
                    </VanAButton>
                </div>
            </div>
        </VanACard>

        <VanACard Header="@($"Danh sách cảnh báo ({_filteredAlerts.Count})")">
            <VanAnDataGrid TItem="ShiftAlert" Items="@_filteredAlerts" EmptyMessage="Không có cảnh báo phù hợp.">
                <Columns>
                    <VanAnColumn TItem="ShiftAlert" Title="Mã" Width="2">
                        <Template Context="a"><span class="fw-bold">@a.AlertCode</span></Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="ShiftAlert" Title="Mức độ" Width="2">
                        <Template Context="a">
                            <span class="badge @(a.Severity == AlertSeverity.Critical ? "bg-danger" : "bg-warning text-dark")">@(a.Severity == AlertSeverity.Critical ? "Critical" : "Warning")</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="ShiftAlert" Title="Nội dung" Width="5">
                        <Template Context="a"><span>@a.Message</span></Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="ShiftAlert" Title="Thời gian" Width="3">
                        <Template Context="a"><span>@a.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span></Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="ShiftAlert" Title="Trạng thái" Width="2">
                        <Template Context="a">
                            <span class="badge @(a.IsResolved ? "bg-success" : "bg-secondary")">@(a.IsResolved ? "Đã xử lý" : "Chưa xử lý")</span>
                        </Template>
                    </VanAnColumn>
                    <VanAnColumn TItem="ShiftAlert" Title="" Width="2">
                        <Template Context="a">
                            @if (!a.IsResolved)
                            {
                                <VanAButton Variant="success" Size="small" OnClick="() => OpenResolveModal(a)">
                                    <i class="bi bi-check2-circle"></i> Xử lý
                                </VanAButton>
                            }
                        </Template>
                    </VanAnColumn>
                </Columns>
            </VanAnDataGrid>
        </VanACard>
    }
</div>

<!-- Modal resolve -->
<VanAnModal IsOpen="@_resolveModalOpen" Title="Xử lý cảnh báo" OnClose="CloseResolveModal" OnConfirm="ResolveAlert"
            ShowDefaultFooter="true" Closable="true">
    @if (_resolvingAlert != null)
    {
        <p class="small mb-2"><strong>[@_resolvingAlert.AlertCode]</strong> @_resolvingAlert.Message</p>
        <VanAInput Id="resolve-note" Value="@_resolveNote" ValueChanged="OnResolveNoteChanged"
                   Placeholder="Ghi chú xử lý (vd: đã kiểm lại kho, nhập thêm hàng...)" AriaLabel="Ghi chú xử lý" />
    }
</VanAnModal>

<!-- Modal cấu hình cảnh báo Telegram/Zalo (Phase 4 — config-only) -->
<VanAnModal IsOpen="@_notificationModalOpen" Title="Cảnh báo qua Telegram / Zalo" OnClose="CloseNotificationModal" OnConfirm="SaveNotificationConfig"
            ShowDefaultFooter="true" Closable="true">
    <VanAAlert Variant="info" Dismissible="false">
        Kênh ngoài (bot) chỉ gửi cảnh báo <strong>Critical</strong> sau khi đóng ca. Cảnh báo in-app vẫn luôn hoạt động.
        MVP hỗ trợ lưu cấu hình (config-only) — bot sẽ gửi khi token được kết nối.
    </VanAAlert>
    <hr />
    <h6><i class="bi bi-telegram"></i> Telegram</h6>
    <div class="form-check mb-2">
        <input type="checkbox" class="form-check-input" id="telegram-enabled" @bind="_telegramEnabled" aria-label="Bật Telegram" />
        <label class="form-check-label" for="telegram-enabled">Bật gửi qua Telegram</label>
    </div>
    <div class="mb-2">
        <label class="form-label">Bot Token</label>
        <input type="password" class="form-control" placeholder="123456:ABC-DEF..." @bind="_telegramBotToken" aria-label="Telegram bot token" />
    </div>
    <div class="mb-3">
        <label class="form-label">Chat ID</label>
        <input type="text" class="form-control" placeholder="-1001234567890" @bind="_telegramChatId" aria-label="Telegram chat id" />
    </div>
    <hr />
    <h6><i class="bi bi-chat-dots"></i> Zalo (ZNS)</h6>
    <div class="form-check mb-2">
        <input type="checkbox" class="form-check-input" id="zalo-enabled" @bind="_zaloEnabled" aria-label="Bật Zalo" />
        <label class="form-check-label" for="zalo-enabled">Bật gửi qua Zalo</label>
    </div>
    <div class="mb-2">
        <label class="form-label">Access Token (OA)</label>
        <input type="password" class="form-control" placeholder="..." @bind="_zaloAccessToken" aria-label="Zalo access token" />
    </div>
    <div class="mb-3">
        <label class="form-label">Người nhận (User ID)</label>
        <input type="text" class="form-control" placeholder="..." @bind="_zaloRecipientId" aria-label="Zalo recipient id" />
    </div>
    @if (!string.IsNullOrEmpty(_notificationError))
    {
        <VanAAlert Variant="error" Message="@_notificationError" Dismissible="true" OnDismiss="() => _notificationError = null" />
    }
</VanAnModal>

@code {
    private IReadOnlyList<ShiftAlert> _allAlerts = [];
    private IReadOnlyList<ShiftAlert> _filteredAlerts = [];

    private string _severityFilter = "all";
    private string _statusFilter = "unresolved";
    private string _search = string.Empty;

    private bool _loading = true;
    private string? _errorMessage;

    private ShiftAlert? _resolvingAlert;
    private bool _resolveModalOpen;
    private string _resolveNote = string.Empty;

    // Phase 4 — config notification (config-only): Telegram + Zalo.
    private bool _notificationModalOpen;
    private string? _notificationError;
    private bool _telegramEnabled;
    private string _telegramBotToken = string.Empty;
    private string _telegramChatId = string.Empty;
    private bool _zaloEnabled;
    private string _zaloAccessToken = string.Empty;
    private string _zaloRecipientId = string.Empty;

    private static readonly List<VanASelect.SelectOption> _severityOptions =
    [
        new("all", "Tất cả"), new("warning", "Warning"), new("critical", "Critical")
    ];

    private static readonly List<VanASelect.SelectOption> _statusOptions =
    [
        new("unresolved", "Chưa xử lý"), new("resolved", "Đã xử lý"), new("all", "Tất cả")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadAlerts();
    }

    private async Task LoadAlerts()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            if (!TenantProvider.HasTenant)
            {
                _errorMessage = "Không xác định được tenant. Vui lòng đăng nhập lại.";
                return;
            }
            TenantId tenantId = new(TenantProvider.TenantId);
            // Multi-tenancy: catalog chung 1 SQLite nhiều tenant — filter theo TenantId (RV 2026-10-04).
            _allAlerts = await DbContext.ShiftAlerts
                .Where(a => a.TenantId == tenantId)
                .OrderByDescending(a => a.CreatedAt)
                .Take(500)
                .ToListAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "VA-IIE: error loading alerts");
            _errorMessage = "Lỗi tải cảnh báo. Vui lòng thử lại.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<ShiftAlert> query = _allAlerts;

        if (_severityFilter == "warning")
        {
            query = query.Where(a => a.Severity == AlertSeverity.Warning);
        }
        else if (_severityFilter == "critical")
        {
            query = query.Where(a => a.Severity == AlertSeverity.Critical);
        }

        if (_statusFilter == "unresolved")
        {
            query = query.Where(a => !a.IsResolved);
        }
        else if (_statusFilter == "resolved")
        {
            query = query.Where(a => a.IsResolved);
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            string term = _search.Trim();
            query = query.Where(a => a.AlertCode.Contains(term, StringComparison.OrdinalIgnoreCase)
                                     || a.Message.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        _filteredAlerts = query.ToList();
    }

    private void OnSeverityFilterChanged(string value)
    {
        _severityFilter = value;
        ApplyFilters();
    }

    private void OnStatusFilterChanged(string value)
    {
        _statusFilter = value;
        ApplyFilters();
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        ApplyFilters();
    }

    private void ResetFilters()
    {
        _severityFilter = "all";
        _statusFilter = "unresolved";
        _search = string.Empty;
        ApplyFilters();
    }

    private void OpenResolveModal(ShiftAlert alert)
    {
        _resolvingAlert = alert;
        _resolveNote = string.Empty;
        _resolveModalOpen = true;
    }

    private void CloseResolveModal()
    {
        _resolveModalOpen = false;
        _resolvingAlert = null;
    }

    private async Task ResolveAlert()
    {
        if (_resolvingAlert == null)
        {
            return;
        }
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            Guid userId = Guid.TryParse(authState.User.FindFirst("sub")?.Value, out var uid)
                ? uid
                : throw new InvalidOperationException("Không xác định được người dùng.");

            _resolvingAlert.Resolve(userId, string.IsNullOrWhiteSpace(_resolveNote) ? "Đã xử lý" : _resolveNote);
            _ = await DbContext.SaveChangesAsync();

            CloseResolveModal();
            await LoadAlerts();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "VA-IIE: error resolving alert");
            _errorMessage = "Không xử lý được cảnh báo. Vui lòng thử lại.";
        }
    }

    private void OnResolveNoteChanged(string value) => _resolveNote = value;

    // ── Phase 4: config notification (config-only) ─────────────────────────────

    private async Task OpenNotificationConfig()
    {
        _notificationError = null;
        try
        {
            TenantId tenantId = new(TenantProvider.TenantId);
            VaIIeTenantConfig config = await ForecastService.GetConfigAsync(tenantId);
            _telegramEnabled = config.TelegramEnabled;
            _telegramBotToken = config.TelegramBotToken ?? string.Empty;
            _telegramChatId = config.TelegramChatId ?? string.Empty;
            _zaloEnabled = config.ZaloEnabled;
            _zaloAccessToken = config.ZaloAccessToken ?? string.Empty;
            _zaloRecipientId = config.ZaloRecipientId ?? string.Empty;
            _notificationModalOpen = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "VA-IIE: error loading notification config");
            _errorMessage = "Lỗi tải cấu hình cảnh báo. Vui lòng thử lại.";
        }
    }

    private void CloseNotificationModal() => _notificationModalOpen = false;

    private async Task SaveNotificationConfig()
    {
        _notificationError = null;
        try
        {
            TenantId tenantId = new(TenantProvider.TenantId);
            await ForecastService.UpdateNotificationConfigAsync(
                tenantId,
                _telegramEnabled,
                string.IsNullOrWhiteSpace(_telegramBotToken) ? null : _telegramBotToken,
                string.IsNullOrWhiteSpace(_telegramChatId) ? null : _telegramChatId,
                _zaloEnabled,
                string.IsNullOrWhiteSpace(_zaloAccessToken) ? null : _zaloAccessToken,
                string.IsNullOrWhiteSpace(_zaloRecipientId) ? null : _zaloRecipientId);
            _notificationModalOpen = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "VA-IIE: error saving notification config");
            _notificationError = "Lưu cấu hình thất bại. Vui lòng thử lại.";
        }
    }
}
