    // ── Q3-C: "số + chọn đơn vị" — đơn vị cơ sở + quy đổi SI (kg → g ×1000) ──

    private List<VanASelect.SelectOption> UnitOptionsFor(Guid ingredientId)
    {
        var ingredient = _ingredients.FirstOrDefault(i => i.Id == ingredientId);
        if (ingredient == null)
        {
            return [new("g", "g")];
        }
        // Đơn vị cơ sở khối lượng = g → cho nhập kg (×1000). Phi-SI giữ nguyên (Q3-C).
        if (ingredient.Unit == "g")
        {
            return [new("g", "g"), new("kg", "kg")];
        }
        return [new(ingredient.Unit, ingredient.Unit)];
    }

    private string DefaultUnitFor(Guid ingredientId)
    {
        var ingredient = _ingredients.FirstOrDefault(i => i.Id == ingredientId);
        return ingredient?.Unit ?? "g";
    }

    private (string Unit, decimal Factor) ResolveUnit(Guid ingredientId, string selected)
    {
        var ingredient = _ingredients.FirstOrDefault(i => i.Id == ingredientId);
        string baseUnit = ingredient?.Unit ?? "g";

        // Quy đổi SI: kg → g (×1000). Phi-SI giữ nguyên (Q3-C).
        if (baseUnit == "g" && selected == "kg")
        {
            return ("g", 1000m);
        }
        return (baseUnit, 1m);
    }

