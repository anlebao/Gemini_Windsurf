@implements IAsyncDisposable
@using VanAn.ShopERP.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using VanAn.Shared.Domain
@using VanAn.Shared.Services
@using VanAn.CoreHub.Services
@using VanAn.CoreHub.Hubs
@using VanAn.UI.Platform.Models
@using VanAn.UI.Platform.Components
@using VanAn.Shared.Models
@using System.Collections.ObjectModel
@using System.Security.Claims
@inject IOrderManagementService OrderService
@inject IRealtimeDashboardService DashboardService
@inject IThemeProvider ThemeProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<VanADashboard> Logger
@inject NavigationManager NavigationManager
@inject IErrorNotificationService ErrorNotification
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory

<div class="vanan-dashboard @ThemeProvider.CurrentTheme">
    <VanALayout>
        <Sidebar>
            <VanANavigation MenuItems="@GetDashboardMenu()" />
        </Sidebar>
        <ChildContent>
            <!-- Header -->
            <header class="dashboard-header">
                <h1>ShopERP Dashboard</h1>
                <VanAButton 
                    Variant="primary" 
                    OnClick="RefreshData"
                    Disabled="@isRefreshing">
                    @if (isRefreshing) {
                        <VanAnSpinner Size="small" />
                    } else {
                        <span>🔄 Refresh</span>
                    }
                </VanAButton>
            </header>
            
            <!-- Metrics Grid -->
            <section class="metrics-section">
                <div class="metrics-grid">
                    <VanAMetricsCard 
                        Title="Today's Orders" 
                        Value="@Metrics.TodayOrderCount.ToString()" 
                        Icon="clipboard-data" 
                        Trend="+12%" 
                        Color="primary" />
                    <VanAMetricsCard 
                        Title="Revenue" 
                        Value="@Metrics.TodayRevenue.ToString()" 
                        Icon="currency-dollar" 
                        Trend="+8%" 
                        Color="success" />
                    <VanAMetricsCard 
                        Title="Pending Orders" 
                        Value="@Metrics.PendingOrders.ToString()" 
                        Icon="hourglass-split" 
                        Trend="-5%" 
                        Color="warning" />
                    <VanAMetricsCard 
                        Title="Processing" 
                        Value="@Metrics.ProcessingOrders.ToString()" 
                        Icon="fire" 
                        Trend="+15%" 
                        Color="info" />
                </div>
            </section>
            
            <!-- Orders Section -->
            <section class="orders-section">
                <div class="section-header">
                    <h2>Recent Orders</h2>
                    <VanAButton 
                        Variant="secondary" 
                        OnClick="ShowAllOrders">
                        View All Orders
                    </VanAButton>
                </div>
                
                <VanAOrderTable 
                    Orders="@Orders" 
                    OnAssignStaff="HandleStaffAssignment"
                    OnUpdateStatus="HandleStatusUpdate"
                    OnViewDetails="HandleViewDetails" />
            </section>
        </ChildContent>
    </VanALayout>
</div>

<!-- Staff Assignment Modal -->
@if (showStaffModal)
{
    <VanAModal 
        Title="Assign Staff"
        OnClose="CloseStaffModal"
        OnConfirm="ConfirmStaffAssignment">
        <p>Staff assignment for order @selectedOrderId</p>
    </VanAModal>
}

<!-- Status Update Modal -->
@if (showStatusModal)
{
    <VanAModal 
        Title="Update Order Status"
        OnClose="CloseStatusModal"
        OnConfirm="ConfirmStatusUpdate">
        <p>Status update for order @selectedOrderId (current: @currentStatus)</p>
    </VanAModal>
}

@code {
    private OrderDashboardData Metrics = new();
    // P2: Split loading state — isRefreshing shows spinner on manual Refresh button,
    // backgroundRefreshing is silent (poll timer + SignalR). initialLoading gates first render.
    private bool initialLoading = true;
    private bool isRefreshing = false;
    private bool backgroundRefreshing;
    private bool showStaffModal = false;
    private bool showStatusModal = false;
    private Guid selectedOrderId;
    private string currentStatus = string.Empty;

    // ✅ FIXED: Deep architecture - Prerendering awareness
    private bool _isInitialized = false;
    private bool _isPrerendered = false;
    private bool _isClientSide = false;
    
    // ✅ FIXED: Deep architecture - Thread-safe collection
    private ObservableCollection<Order> _orders = new();
    private List<Order> Orders => _orders.ToList();
    
    // ✅ FIXED: Track subscriptions properly
    private IDisposable? _orderUpdatesSubscription;
    private IDisposable? _metricsUpdatesSubscription;
    private System.Threading.Timer? _pollTimer;
    private HubConnection? _hubConnection;
    
    // ✅ FIXED: Authentication state management
    private ClaimsPrincipal? _currentUser;
    private Guid _tenantId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // ✅ FIXED: Only load authentication state (no API calls)
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentUser = authState.User;
            
            // ✅ FIXED: Check if we're in prerender mode
            _isPrerendered = OperatingSystem.IsBrowser() == false;
            _isClientSide = OperatingSystem.IsBrowser();
            
            Logger.LogDebug("Component initialized. Prerendered: {Prerendered}, ClientSide: {ClientSide}", 
                _isPrerendered, _isClientSide);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in OnInitializedAsync");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _isInitialized) return;
        
        try
        {
            _isInitialized = true;
            
            // ✅ FIXED: Only run data loading on client-side, first render only
            if (_isClientSide && !_isPrerendered)
            {
                Logger.LogDebug("Starting client-side initialization");
                
                // ✅ FIXED: Validate authentication first
                if (_currentUser?.Identity?.IsAuthenticated == true)
                {
                    var tenantClaim = _currentUser.FindFirst("TenantId")?.Value;
                    if (Guid.TryParse(tenantClaim, out var tenantId))
                    {
                        _tenantId = tenantId;
                        await LoadData();
                        await SetupRealtimeSubscriptions();
                        
                        Logger.LogDebug("Client-side initialization completed for tenant {TenantId}", _tenantId);
                    }
                    else
                    {
                        await HandleAuthenticationError("Invalid tenant ID format");
                    }
                }
                else
                {
                    await HandleAuthenticationError("User not authenticated");
                }
            }
            else if (_isPrerendered)
            {
                Logger.LogDebug("Skipping data loading in prerender mode");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in OnAfterRenderAsync");
            await ErrorNotification.ShowError("Failed to initialize dashboard");
        }
    }

    private async Task SetupRealtimeSubscriptions()
    {
        try
        {
            // ✅ FIXED: Only subscribe on client-side
            if (!_isClientSide) return;
            
            Logger.LogDebug("Setting up real-time subscriptions");

            // P2: SignalR is now primary real-time channel for dashboard metrics.
            // Poll timer is fallback only — increased 10s → 60s (dashboard stats don't need sub-minute freshness).
            await StartSignalRConnection();

            _pollTimer = new System.Threading.Timer(
                async _ => await InvokeAsync(async () => await LoadData(isBackground: true)),
                null,
                TimeSpan.FromSeconds(60),
                TimeSpan.FromSeconds(60));
            Logger.LogDebug("Polling timer started (60s fallback interval)");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error setting up real-time subscriptions");
        }
    }

    private async Task StartSignalRConnection()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/orderHub"))
                .WithAutomaticReconnect()
                .Build();

            // P2: Any order event → re-query dashboard stats (counts/revenue change).
            _hubConnection.On<Guid, Guid>("OrderCreated",
                async (orderId, tenantId) =>
                {
                    await InvokeAsync(async () => await LoadData(isBackground: true));
                });

            _hubConnection.On<Guid, Guid, string, string>("OrderStatusChanged",
                async (orderId, tenantId, oldStatus, newStatus) =>
                {
                    await InvokeAsync(async () => await LoadData(isBackground: true));
                });

            _hubConnection.On<Guid, Guid, string>("PaymentConfirmed",
                async (orderId, tenantId, transactionId) =>
                {
                    await InvokeAsync(async () => await LoadData(isBackground: true));
                });

            await _hubConnection.StartAsync();
            Logger.LogDebug("VanADashboard: SignalR connected to /orderHub");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "VanADashboard: SignalR connection failed — 60s poll fallback active");
        }
    }

    private async Task HandleOrderUpdate(Order order)
    {
        if (!_isClientSide) return;
        
        try
        {
            await InvokeAsync(() =>
            {
                // ✅ FIXED: Thread-safe collection mutation
                var existingIndex = _orders.ToList().FindIndex(o => o.Id == order.Id);
                
                if (existingIndex >= 0)
                {
                    // ✅ FIXED: Atomic operations
                    _orders.RemoveAt(existingIndex);
                    _orders.Insert(0, order);
                    
                    Logger.LogDebug("Updated existing order {OrderId}", order.Id);
                }
                else
                {
                    _orders.Insert(0, order);
                    Logger.LogDebug("Added new order {OrderId}", order.Id);
                }
                
                // StateHasChanged automatically called by ObservableCollection
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling order update for {OrderId}", order.Id);
        }
    }

    private async Task HandleMetricsUpdate(OrderDashboardData metrics)
    {
        if (!_isClientSide) return;
        
        try
        {
            await InvokeAsync(() =>
            {
                Metrics = metrics;
                StateHasChanged();
                Logger.LogDebug("Metrics updated");
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling metrics update");
        }
    }

    private async Task LoadData() => await LoadData(isBackground: false);

    private async Task LoadData(bool isBackground)
    {
        if (!_isClientSide || _tenantId == Guid.Empty) return;
        
        // P2: Silent refresh — isRefreshing (spinner on Refresh button) only for manual clicks.
        // Background reloads (poll, SignalR) update silently without flickering metrics cards.
        if (isBackground)
            backgroundRefreshing = true;
        else
            isRefreshing = true;
        // C: Fresh DI scope per load — avoids Blazor Server circuit-scoped DbContext stale reads.
        using var scope = ScopeFactory.CreateScope();
        var scopedOrderService = scope.ServiceProvider.GetRequiredService<IOrderManagementService>();
        try
        {
            Logger.LogDebug("Loading dashboard data for tenant {TenantId}", _tenantId);
            
            // ✅ FIXED: Load metrics
            var newMetrics = await scopedOrderService.GetDashboardDataAsync(_tenantId);
            
            // ✅ FIXED: Load orders with atomic collection update
            var orders = await scopedOrderService.GetOrdersByDateRangeAsync(
                DateTime.Today, 
                DateTime.Today.AddDays(1));
            
            var newOrders = orders.OrderByDescending(o => o.CreatedAt).ToList();

            // P2: Diff check — only update if metrics or order list actually changed.
            // Prevents re-render on 60s poll when nothing changed.
            bool metricsChanged = !MetricsEquals(Metrics, newMetrics);
            bool ordersChanged = !OrdersListEquals(_orders.ToList(), newOrders);

            if (metricsChanged)
            {
                Metrics = newMetrics;
            }

            if (ordersChanged)
            {
                _orders.Clear();
                foreach (var order in newOrders)
                {
                    _orders.Add(order);
                }
            }
            
            Logger.LogDebug("Loaded {Count} orders and metrics (changed: metrics={M}, orders={O})",
                _orders.Count, metricsChanged, ordersChanged);
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogError(ex, "Unauthorized access to dashboard data for tenant {TenantId}", _tenantId);
            await ErrorNotification.ShowError("Access denied. Please check your permissions.");
            await HandleAuthenticationError("Unauthorized access");
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Network error loading dashboard data");
            await ErrorNotification.ShowError("Network error. Please check your connection.");
        }
        catch (TimeoutException ex)
        {
            Logger.LogError(ex, "Timeout loading dashboard data");
            await ErrorNotification.ShowError("Request timed out. Please try again.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error loading dashboard data");
            await ErrorNotification.ShowError("An unexpected error occurred. Please try again later.");
        }
        finally
        {
            if (isBackground)
                backgroundRefreshing = false;
            else
                isRefreshing = false;
            initialLoading = false;
            StateHasChanged();
        }
    }

    // P2: Diff for metrics — compares the 4 displayed counters.
    private static bool MetricsEquals(OrderDashboardData a, OrderDashboardData b)
    {
        return a.TodayOrderCount == b.TodayOrderCount
            && a.TodayRevenue == b.TodayRevenue
            && a.PendingOrders == b.PendingOrders
            && a.ProcessingOrders == b.ProcessingOrders;
    }

    // P2: Diff for orders list — compares count + Id + Status for each order.
    private static bool OrdersListEquals(List<Order> a, List<Order> b)
    {
        if (a.Count != b.Count) return false;
        for (int i = 0; i < a.Count; i++)
        {
            if (a[i].Id != b[i].Id) return false;
            if (a[i].Status?.Value != b[i].Status?.Value) return false;
        }
        return true;
    }

    private async Task RefreshData()
    {
        await LoadData(isBackground: false);
    }

    private void HandleStaffAssignment(Order order)
    {
        selectedOrderId = order.Id;
        showStaffModal = true;
    }

    private void HandleStatusUpdate(Order order)
    {
        selectedOrderId = order.Id;
        currentStatus = order.Status.Value;
        showStatusModal = true;
    }

    private void HandleViewDetails(Order order)
    {
        NavigationManager.NavigateTo($"/orders/{order.Id}");
    }

    private void CloseStaffModal()
    {
        showStaffModal = false;
        selectedOrderId = Guid.Empty;
    }

    private void CloseStatusModal()
    {
        showStatusModal = false;
        selectedOrderId = Guid.Empty;
        currentStatus = string.Empty;
    }

    private async Task ConfirmStaffAssignment()
    {
        CloseStaffModal();
        await LoadData(isBackground: false);
    }

    private async Task ConfirmStatusUpdate()
    {
        CloseStatusModal();
        await LoadData(isBackground: false);
    }

    private List<NavigationItem> GetDashboardMenu()
    {
        return new List<NavigationItem>
        {
            new() { Title = "Dashboard", Icon = "speedometer2", Url = "/dashboard", IsActive = true },
            new() { Title = "Orders", Icon = "clipboard-data", Url = "/orders" },
            new() { Title = "Staff", Icon = "people", Url = "/staff" },
            new() { Title = "Accounting", Icon = "calculator", Url = "/accounting" },
            new() { Title = "Reports", Icon = "graph-up", Url = "/reports" },
            new() { Title = "Settings", Icon = "gear", Url = "/settings" }
        };
    }

    private void ShowAllOrders()
    {
        NavigationManager.NavigateTo("/orders");
    }

    // ✅ FIXED: Proper tenant ID retrieval
    private Guid GetTenantId()
    {
        if (_tenantId == Guid.Empty)
        {
            Logger.LogWarning("Tenant ID not available");
            throw new InvalidOperationException("Tenant ID not properly initialized");
        }
        return _tenantId;
    }

    // ✅ FIXED: Authentication error handling
    private async Task HandleAuthenticationError(string errorMessage)
    {
        Logger.LogError("Authentication error: {ErrorMessage}", errorMessage);
        
        if (_isClientSide)
        {
            NavigationManager.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString(NavigationManager.Uri));
        }
    }

    // ✅ FIXED: Proper disposal
    public async ValueTask DisposeAsync()
    {
        try
        {
            _pollTimer?.Dispose();
            _orderUpdatesSubscription?.Dispose();
            _metricsUpdatesSubscription?.Dispose();
            if (_hubConnection is not null)
            {
                try
                {
                    await _hubConnection.DisposeAsync();
                }
                catch { /* ignore disposal errors */ }
            }
            
            // ✅ FIXED: Cleanup ObservableCollection
            _orders.CollectionChanged -= null;
            _orders.Clear();
            
            Logger.LogDebug("VanADashboard disposed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error disposing VanADashboard");
        }
    }
}
