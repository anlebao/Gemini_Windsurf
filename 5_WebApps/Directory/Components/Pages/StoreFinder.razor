@page "/stores"
@page "/store-finder"
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        // Issue #160 DRY: Directory StoreFinder is a duplicate of KhachLink StoreFinder.
        // Redirect to KhachLink's full-featured store finder (voice search, PWA geolocation).
        Navigation.NavigateTo("https://khachvip.online/stores", forceLoad: true);
    }
}
