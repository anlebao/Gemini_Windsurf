@page "/stores"
@page "/store-finder"
@using VanAn.Directory.Services
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Services
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject SearchCorrectionStore Corrections

@* W2-3 (FR-U4, 2026-11-14): on-domain store finder — thay redirect sang khachvip.online.
   Port tối thiểu: keyword search + nearby theo vị trí + Leaflet map (directory-map.js)
   + danh sách cửa hàng. Voice search là nợ kỹ thuật (Home đã có — có thể port sau). *@

<PageTitle>Tìm cửa hàng — Shop AI</PageTitle>

<div class="container py-4">
    <div class="text-center mb-4">
        <i class="bi bi-geo-alt-fill text-primary" style="font-size: 2.5rem;"></i>
        <h3 class="mt-2 mb-1">Tìm cửa hàng &amp; sản phẩm gần bạn</h3>
        <p class="text-muted mb-0">Nhập tên, nói bằng giọng nói, hoặc bật vị trí để xem cửa hàng trong bán kính 5–20 km</p>
    </div>

    <VanAnCard CssClass="mb-4 py-4">
        @* W3-2d: VanAnPublicSearchBar (UI.Platform) — mic voice + clear + enterkeyhint=search *@
        <VanAnPublicSearchBar @bind-Value="_keyword"
                              Pill="true"
                              Placeholder="@(_listening ? "Đang nghe..." : "Tên cửa hàng, sản phẩm, dịch vụ...")"
                              AriaLabel="Tìm cửa hàng"
                              SearchText="Tìm kiếm"
                              Loading="_loading"
                              ShowVoiceButton="_speechSupported"
                              IsListening="_listening"
                              OnVoiceToggle="ToggleVoiceAsync"
                              OnSearch="SearchAsync"
                              OnCleared="ClearSearch" />
        @if (_listening)
        {
            <div class="text-danger small mt-2">
                <span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>
                Đang nghe... nói tên cửa hàng hoặc sản phẩm
            </div>
        }
        @if (_voiceError is not null)
        {
            <div class="text-danger small mt-2">@_voiceError</div>
        }
        <VanAnDidYouMeanChip Suggestion="@_didYouMean" OnApply="SearchWithKeyword" />
        @* Personalized DidYouMean W2 (tenant scope): auto-resolve — báo rõ + Hoàn tác *@
        @if (_resolvedFrom is not null)
        {
            <VanAnAlert Variant="AlertVariant.Info" CssClass="mb-3 search-learned-note">
                <i class="bi bi-lightbulb me-1"></i>
                Đang tìm "<b>@_resolvedName</b>" — đã học từ cách bạn nhập "<i>@_resolvedFrom</i>"
                <button type="button" class="btn btn-sm btn-outline-secondary ms-2 search-learned-undo" @onclick="UndoResolvedAsync">Hoàn tác</button>
            </VanAnAlert>
        }

        <div class="d-flex flex-wrap gap-2 mt-3 align-items-center">
            <VanAnButton Variant="ButtonVariant.Outline" OnClick="UseMyLocationAsync" Disabled="@_loading">
                <i class="bi bi-geo-alt me-1"></i> Dùng vị trí của tôi
            </VanAnButton>
            @* Bán kính tìm kiếm — user chọn rõ 5/10/20km quanh vị trí *@
            <div class="btn-group btn-group-sm" role="group" aria-label="Bán kính tìm kiếm">
                @foreach (var r in new[] { 5, 10, 20 })
                {
                    <button type="button"
                            class="btn @(_radiusKm == r ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SetRadiusAsync(r)">
                        @r km
                    </button>
                }
            </div>
            @if (!string.IsNullOrEmpty(_keyword))
            {
                <VanAnButton Variant="ButtonVariant.Secondary" OnClick="ClearSearch">
                    <i class="bi bi-x-circle me-1"></i> Xóa
                </VanAnButton>
            }
        </div>
        @if (_searchedByLocation)
        {
            <p class="text-muted small mt-2 mb-0">
                <i class="bi bi-signpost"></i> Hiển thị cửa hàng trong bán kính <strong>@_radiusKm km</strong> quanh vị trí của bạn — gần nhất trước
            </p>
        }
        @if (_geoError is not null)
        {
            <div class="text-danger small mt-2">@_geoError</div>
        }
    </VanAnCard>

    @if (_loading)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Đang tải...</p>
        </div>
    }
    else if (_searched && _stores.Count == 0)
    {
        <div class="text-center py-4 text-muted">
            <i class="bi bi-inbox" style="font-size: 2rem;"></i>
            <p class="mt-2">Không tìm thấy cửa hàng nào.</p>
            <VanAnButton Variant="ButtonVariant.Outline" OnClick="ClearSearch">Tìm kiếm lại</VanAnButton>
        </div>
    }
    else if (_stores.Count > 0)
    {
        @if (!string.IsNullOrWhiteSpace(_keyword))
        {
            <p class="text-muted small mb-2">@_stores.Count cửa hàng phù hợp với "@_keyword"</p>
        }

        <!-- Map (Leaflet qua directory-map.js — đã load trong App.razor) -->
        <div id="store-finder-map" class="store-map mb-3"></div>

        <div class="row g-3">
            @foreach (var store in _stores)
            {
                <div class="col-md-6 col-lg-4">
                    <VanAnCard CssClass="h-100 store-card">
                        <div class="d-flex align-items-start gap-3">
                            @if (!store.IsPending && !string.IsNullOrEmpty(store.LogoUrl))
                            {
                                <img src="@store.LogoUrl" alt="@store.Name" class="store-logo-sm" />
                            }
                            else
                            {
                                <i class="bi @(store.IsPending ? "bi-hourglass-split text-warning" : "bi-shop text-primary")" style="font-size: 2rem;"></i>
                            }
                            <div class="flex-grow-1">
                                <h5 class="mb-1">@store.Name</h5>
                                @if (store.IsPending)
                                {
                                    <span class="badge bg-warning text-dark mb-2">Chờ xác minh</span>
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(store.Address))
                                    {
                                        <p class="small text-muted mb-1"><i class="bi bi-geo-alt"></i> @store.Address</p>
                                    }
                                    @if (!string.IsNullOrEmpty(store.Phone))
                                    {
                                        <p class="small mb-1"><a href="tel:@store.Phone" class="text-decoration-none"><i class="bi bi-telephone"></i> @store.Phone</a></p>
                                    }
                                    @if (store.DistanceKm.HasValue)
                                    {
                                        <p class="small text-primary mb-1"><i class="bi bi-signpost"></i> @store.DistanceKm.Value.ToString("F1") km</p>
                                    }
                                    @if (!string.IsNullOrEmpty(store.Slug))
                                    {
                                        <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary" OnClick="@(() => NavigateToStore(store))">
                                            <i class="bi bi-shop me-1"></i> Xem trang cửa hàng
                                        </VanAnButton>
                                    }
                                    @* W3-1 (FR-V10): contextual entries — tenant flag ON → nút AI/Gọi *@
                                    @if (!string.IsNullOrEmpty(store.Slug) && store.AiChatEnabled)
                                    {
                                        <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => NavigateToStore(store, "ai"))">
                                            <i class="bi bi-robot me-1"></i> Hỏi AI
                                        </VanAnButton>
                                    }
                                    @if (!string.IsNullOrEmpty(store.Slug) && store.VoiceCallEnabled)
                                    {
                                        <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => NavigateToStore(store, "human"))">
                                            <i class="bi bi-telephone me-1"></i> Gọi cửa hàng
                                        </VanAnButton>
                                    }
                                }
                            </div>
                        </div>
                    </VanAnCard>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted">
            <i class="bi bi-search" style="font-size: 2rem;"></i>
            <p class="mt-2">Nhập tên cửa hàng hoặc bấm "Dùng vị trí của tôi" để tìm gần bạn.</p>
        </div>
    }
</div>

<style>
.store-logo-sm { width: 48px; height: 48px; border-radius: 8px; object-fit: cover; flex-shrink: 0; }
.store-card { transition: transform 0.2s; }
.store-card:hover { transform: translateY(-2px); }
.store-map { height: 320px; border-radius: 12px; overflow: hidden; }
</style>

@implements IAsyncDisposable

@code {
    /// <summary>W3-2 (FR-U6): footer category links → /stores?q={category} prefill + auto-search.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    private string _keyword = "";
    private bool _queryApplied;
    private List<TenantStoreDto> _stores = new();
    private bool _loading;
    private bool _searched;
    private bool _searchedByLocation;
    private string? _geoError;
    private double? _userLat;
    private double? _userLng;
    private bool _mapRendered;
    private int _radiusKm = 10;
    private string? _didYouMean;
    private string? _resolvedFrom;      // câu gốc user nhập khi auto-resolve active
    private string? _resolvedName;      // tên đã học (display) — render note
    private string? _didYouMeanRaw;     // câu gốc tại thời điểm search (record khi accept)
    private bool _lastInputWasVoice;    // OnVoiceFinal → tag source cho record
    private bool _lastSearchWasVoice;

    // Voice input state (vananVoiceInput — script loaded via App.razor, giống Home.razor)
    private bool _speechSupported;
    private bool _listening;
    private string? _voiceError;
    private DotNetObjectReference<StoreFinder>? _voiceRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // SF-W3: voice mic — platform page (no tenant flag); browser-gated only.
        try
        {
            _speechSupported = await JSRuntime.InvokeAsync<bool>("vananVoiceInput.isSupported");
            if (_speechSupported) StateHasChanged();
        }
        catch
        {
            _speechSupported = false; // script not loaded — mic hidden
        }

        // W3-2 (FR-U6): áp dụng ?q= một lần sau first render (InteractiveServer —
        // SupplyParameterFromQuery set trong OnInitialized, search cần sau render).
        if (!_queryApplied && !string.IsNullOrWhiteSpace(Q))
        {
            _queryApplied = true;
            _keyword = Q;
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        _loading = true;
        _searched = true;
        _searchedByLocation = false;
        // Personalized DidYouMean W2 (tenant scope): Level 0 — correction đã học
        // rewrite query trước khi gọi API (localStorage, backend không đổi).
        var keyword = _keyword?.Trim() ?? "";
        _didYouMeanRaw = keyword;
        _lastSearchWasVoice = _lastInputWasVoice;
        _lastInputWasVoice = false;
        if (keyword.Length > 0)
        {
            try
            {
                var learned = await Corrections.ResolveAsync(SearchCorrectionStore.ScopeTenant, keyword);
                if (!string.IsNullOrWhiteSpace(learned)
                    && !string.Equals(learned, keyword, StringComparison.OrdinalIgnoreCase))
                {
                    _resolvedFrom = keyword;
                    _resolvedName = learned.Trim();
                    keyword = _resolvedName;
                    _keyword = keyword;
                }
                else
                {
                    _resolvedFrom = null;
                    _resolvedName = null;
                }
            }
            catch { _resolvedFrom = null; _resolvedName = null; }
        }
        var result = await CatalogService.SearchStoresAsync(keyword);
        _stores = result.Results;
        _didYouMean = result.DidYouMean;
        _loading = false;
        await RenderMapAsync();
    }

    /// <summary>Issue #166 comment: search với gợi ý "Ý bạn là: X?".
    /// W2: học cặp (câu gốc → suggestion) trước khi re-search — fail-open.</summary>
    private async Task SearchWithKeyword(string keyword)
    {
        try
        {
            await Corrections.RecordAsync(SearchCorrectionStore.ScopeTenant,
                _didYouMeanRaw ?? _keyword, keyword, _lastSearchWasVoice ? "voice" : "typed");
        }
        catch { /* storage lỗi → vẫn re-search bình thường */ }
        _keyword = keyword;
        await SearchAsync();
    }

    /// <summary>Undo auto-resolve: xóa correction đã học + re-search câu gốc.</summary>
    private async Task UndoResolvedAsync()
    {
        var raw = _resolvedFrom;
        _resolvedFrom = null;
        _resolvedName = null;
        try { await Corrections.ForgetAsync(SearchCorrectionStore.ScopeTenant, raw); }
        catch { /* fail-open */ }
        _keyword = raw ?? _keyword;
        await SearchAsync();
    }

    private async Task SetRadiusAsync(int radiusKm)
    {
        _radiusKm = radiusKm;
        // Đã có vị trí user → refetch ngay với bán kính mới.
        if (_searchedByLocation && _userLat.HasValue && _userLng.HasValue)
        {
            await LoadNearbyAsync();
            await RenderMapAsync();
        }
    }

    private async Task LoadNearbyAsync()
    {
        _stores = await CatalogService.GetNearbyStoresAsync(_userLat!.Value, _userLng!.Value, _radiusKm);
        // Sort client-side theo khoảng cách — gần nhất trước.
        _stores = _stores.OrderBy(s => s.DistanceKm ?? double.MaxValue).ToList();
        _searched = true;
        _searchedByLocation = true;
        _didYouMean = null;
    }

    private async Task UseMyLocationAsync()
    {
        _geoError = null;
        _loading = true;
        try
        {
            var pos = await JSRuntime.InvokeAsync<GeoPositionResult>("directoryMap.getUserLocation");
            _userLat = pos.Lat;
            _userLng = pos.Lng;
            await LoadNearbyAsync();
        }
        catch (Exception ex)
        {
            _geoError = "Không lấy được vị trí. Hãy cấp quyền vị trí cho trình duyệt rồi thử lại.";
            System.Console.WriteLine($"[StoreFinder] geolocation failed: {ex.Message}");
        }
        finally
        {
            _loading = false;
            await RenderMapAsync();
        }
    }

    private void ClearSearch()
    {
        _keyword = "";
        _searched = false;
        _searchedByLocation = false;
        _stores = new();
        _mapRendered = false;
        _didYouMean = null;
        _resolvedFrom = null;
        _resolvedName = null;
    }

    // ── Voice input (port từ Home.razor — vananVoiceInput vi-VN) ──────────────

    private async Task ToggleVoiceAsync()
    {
        _voiceError = null;
        try
        {
            if (_listening)
            {
                _listening = false; // JS onend → OnVoiceEnd re-confirms
                await JSRuntime.InvokeVoidAsync("vananVoiceInput.stop");
            }
            else
            {
                _voiceRef ??= DotNetObjectReference.Create(this);
                // V2b: targetId → interim fill DOM trực tiếp — mỗi interim qua
                // SignalR + full render trước đây gây backlog "treo" trên SSR
                _listening = await JSRuntime.InvokeAsync<bool>(
                    "vananVoiceInput.start", _voiceRef, "vanan-public-search-input");
            }
        }
        catch
        {
            _listening = false;
        }
    }

    /// <summary>Live transcript while speaking — fills the input in real time.</summary>
    [JSInvokable]
    public void OnVoiceInterim(string text)
    {
        _keyword = text;
        StateHasChanged();
    }

    /// <summary>Silence/manual stop → final transcript → auto-submit the search.</summary>
    [JSInvokable]
    public async Task OnVoiceFinal(string text)
    {
        _keyword = text;
        _lastInputWasVoice = true;
        _listening = false;
        await SearchAsync();
    }

    [JSInvokable]
    public void OnVoiceError(string message)
    {
        _listening = false;
        _voiceError = message;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceEnd()
    {
        _listening = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_listening) await JSRuntime.InvokeVoidAsync("vananVoiceInput.stop");
        }
        catch { /* JS gone during teardown */ }
        _voiceRef?.Dispose();
    }

    /// <summary>Render Leaflet map sau khi có kết quả (chỉ 1 lần / kết quả mới).</summary>
    private async Task RenderMapAsync()
    {
        if (_stores.Count == 0) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("directoryMap.render", "store-finder-map", _stores, _userLat, _userLng);
            _mapRendered = true;
        }
        catch (Exception ex)
        {
            // Map là enhancement — list vẫn dùng được nếu Leaflet/JS lỗi.
            System.Console.WriteLine($"[StoreFinder] map render failed: {ex.Message}");
        }
    }

    private async Task NavigateToStore(TenantStoreDto store, string? chatMode = null)
    {
        if (string.IsNullOrEmpty(store.Slug)) return;
        var domain = !string.IsNullOrEmpty(store.KhachLinkDomain)
            ? store.KhachLinkDomain
            : (Configuration["KhachLink:DefaultDomain"] ?? "khachvip.online");
        // W3-1: contextual deep-link — ?chat=ai|human mở chat panel trên storefront.
        var chatQuery = string.IsNullOrEmpty(chatMode) ? string.Empty : $"?chat={chatMode}";
        // New tab — directory giữ nguyên, storefront mở song song (window.open).
        await JSRuntime.InvokeVoidAsync("open", $"https://{domain}/store/{store.Slug}{chatQuery}", "_blank");
    }

    private sealed class GeoPositionResult
    {
        public double Lat { get; set; }
        public double Lng { get; set; }
    }
}
