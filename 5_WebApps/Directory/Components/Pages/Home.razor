@page "/"
@using VanAn.Directory.Services
@using VanAn.Shared.Domain.Common
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Tokens
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject IMeteringClient Metering
@implements IAsyncDisposable

<PageTitle>Danh bạ Vạn An — Tìm cửa hàng gần bạn</PageTitle>

<div class="container py-4">
        <!-- Hero -->
        <div class="text-center mb-4">
            <i class="bi bi-geo-alt-fill text-primary" style="font-size: 2.5rem;"></i>
            <h3 class="mt-2 mb-1">Tìm cửa hàng gần bạn</h3>
            <p class="text-muted mb-0">Tìm theo tên, sản phẩm, hoặc vị trí</p>
        </div>

        <!-- Search box -->
        <VanAnCard CssClass="mb-4 py-4">
            <!-- Tab toggle: Tìm cửa hàng | Tìm sản phẩm (open-closed: existing store search kept, product search added) -->
            <div class="mb-3">
                <button type="button" class="btn btn-sm @(_searchMode == "store" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => SetSearchMode("store"))">
                    <i class="bi bi-shop"></i> Tìm cửa hàng
                </button>
                <button type="button" class="btn btn-sm @(_searchMode == "product" ? "btn-primary" : "btn-outline-primary") ms-1" @onclick="@(() => SetSearchMode("product"))">
                    <i class="bi bi-bag"></i> Tìm sản phẩm
                </button>
            </div>
            <div class="input-group input-group-lg">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-primary"></i>
                </span>
                <input type="text" class="form-control border-start-0 border-end-0"
                       @bind="_searchKeyword"
                       @bind:event="oninput"
                       @onkeyup="OnSearchKeyUp"
                       placeholder="@(_listening ? "Đang nghe..." : (_searchMode == "product" ? "Tìm theo tên sản phẩm, dịch vụ..." : "Tìm theo tên cửa hàng, sản phẩm, dịch vụ..."))"
                       aria-label="@(_searchMode == "product" ? "Tìm sản phẩm" : "Tìm cửa hàng")" />
                @* SF-W3 (2026-11-08): voice input — nói thay vì gõ (vananVoiceInput, browser-gated). *@
                @if (_speechSupported)
                {
                    <button type="button" class="btn btn-outline-primary @(_listening ? "text-danger" : "")"
                            @onclick="ToggleVoiceAsync" disabled="@_loading"
                            title="@(_listening ? "Dừng nói" : "Nói để tìm kiếm")"
                            aria-label="Tìm kiếm bằng giọng nói">
                        <i class="bi @(_listening ? "bi-mic-fill" : "bi-mic")"></i>
                    </button>
                }
                @if (!string.IsNullOrWhiteSpace(_searchKeyword))
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                        <i class="bi bi-x-circle"></i>
                    </button>
                }
            </div>
            @if (_listening)
            {
                <div class="text-danger small mt-2">
                    <span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>
                    Đang nghe... nói tên cửa hàng hoặc sản phẩm
                </div>
            }
            @if (_voiceError is not null)
            {
                <div class="text-danger small mt-2">@_voiceError</div>
            }
            <div class="d-flex gap-2 mt-3">
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="SearchStores">
                    <i class="bi bi-search me-1"></i> Tìm kiếm
                </VanAnButton>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="GoToStoreFinder">
                    <i class="bi bi-geo-alt me-1"></i> Dùng vị trí của tôi
                </VanAnButton>
            </div>
        </VanAnCard>

        @* Self-Serve Onboarding P2 (FR-20): CTA đăng ký — tự ẩn theo flags *@
        <OnboardCta Src="directory" />

        @if (!string.IsNullOrEmpty(_pendingAlert))
        {
            <VanAnAlert Variant="AlertVariant.Warning" Message="@_pendingAlert" CssClass="mb-3" />
        }

        <!-- Issue #166 comment: Suggested keywords when no direct match -->
        @if (_hasSearched && !_loading && _suggestedKeywords.Count > 0)
        {
            <VanAnAlert Variant="AlertVariant.Info" CssClass="mb-3">
                <div>
                    <i class="bi bi-lightbulb me-1"></i>
                    Không tìm thấy kết quả chính xác cho "@_searchKeyword". Có phải bạn muốn tìm:
                    @foreach (var kw in _suggestedKeywords)
                    {
                        <button class="btn btn-sm btn-outline-primary ms-1 my-1" @onclick="@(() => SearchWithKeyword(kw))">
                            @kw
                        </button>
                    }
                </div>
            </VanAnAlert>
        }

        <!-- Results -->
        @if (_loading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2">Đang tải...</p>
            </div>
        }
        else if (!_hasSearched)
        {
            @* W2-3 (FR-U1): below-fold retention — recent searches + category chips + featured stores *@
            <div class="below-fold">
                @if (_recentKeywords.Count > 0)
                {
                    <div class="mb-3">
                        <div class="text-muted small mb-2"><i class="bi bi-clock-history me-1"></i>Tìm gần đây</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var kw in _recentKeywords)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => SearchWithKeyword(kw))">@kw</button>
                            }
                        </div>
                    </div>
                }
                <div class="mb-3">
                    <div class="text-muted small mb-2"><i class="bi bi-grid me-1"></i>Duyệt theo ngành</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var cat in _categoryChips)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="@(() => SearchCategory(cat))">@cat</button>
                        }
                    </div>
                </div>
                <div>
                    <div class="text-muted small mb-2"><i class="bi bi-star me-1"></i>Cửa hàng nổi bật</div>
                    @if (_featuredLoading)
                    {
                        <div class="row g-3">
                            @for (var i = 0; i < 3; i++)
                            {
                                <div class="col-md-6 col-lg-4"><div class="vanan-skeleton" style="height:110px;border-radius:12px;"></div></div>
                            }
                        </div>
                    }
                    else if (_featuredStores.Count == 0)
                    {
                        <p class="text-muted small mb-0">Chưa có cửa hàng nổi bật — hãy là người đầu tiên khám phá!</p>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var store in _featuredStores)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <VanAnCard CssClass="h-100 store-card">
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(store.LogoUrl))
                                            {
                                                <img src="@store.LogoUrl" alt="@store.Name" class="store-logo-sm" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-shop text-primary" style="font-size: 2rem;"></i>
                                            }
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@store.Name</h6>
                                                @if (!string.IsNullOrEmpty(store.Address))
                                                {
                                                    <p class="small text-muted mb-1"><i class="bi bi-geo-alt"></i> @store.Address</p>
                                                }
                                                @if (store.DistanceKm.HasValue)
                                                {
                                                    <p class="small text-primary mb-1"><i class="bi bi-signpost"></i> @store.DistanceKm.Value.ToString("F1") km</p>
                                                }
                                                @if (!string.IsNullOrEmpty(store.Slug))
                                                {
                                                    <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary" OnClick="@(() => NavigateToStore(store.Slug, store.KhachLinkDomain, store.Id))">
                                                        <i class="bi bi-shop me-1"></i> Xem trang cửa hàng
                                                    </VanAnButton>
                                                }
                                            </div>
                                        </div>
                                    </VanAnCard>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (_searchMode == "product" && _products.Count == 0)
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                <p class="mt-2">Không tìm thấy sản phẩm nào phù hợp với "@_searchKeyword".</p>
            </div>
        }
        else if (_searchMode == "product")
        {
            <p class="text-muted small mb-3">@_products.Count sản phẩm phù hợp với "@_searchKeyword"</p>
            <div class="row g-3">
                @foreach (var product in _products)
                {
                    <div class="col-md-6 col-lg-4">
                        <VanAnCard CssClass="h-100 product-card">
                            <div class="d-flex align-items-start gap-3">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.DisplayName" style="width:60px;height:60px;object-fit:cover;border-radius:0.375rem;" />
                                }
                                else
                                {
                                    <i class="bi bi-bag text-primary" style="font-size: 2rem;"></i>
                                }
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@product.DisplayName</h6>
                                    @if (!string.IsNullOrEmpty(product.TenantName))
                                    {
                                        <p class="small text-muted mb-1"><i class="bi bi-shop"></i> @product.TenantName</p>
                                    }
                                    @if (!string.IsNullOrEmpty(product.Description))
                                    {
                                        <p class="small text-muted mb-1">@product.Description</p>
                                    }
                                    <p class="small text-primary fw-bold mb-0">
                                        @if (product.DisplayPrice == 0)
                                        {
                                            <span class="badge bg-success">Miễn phí</span>
                                        }
                                        else
                                        {
                                            <span>@product.DisplayPrice.ToString("N0") VNĐ</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </VanAnCard>
                    </div>
                }
            </div>
        }
        else if (_stores.Count == 0)
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                <p class="mt-2">Không tìm thấy cửa hàng nào.</p>
            </div>
        }
        else
        {
            @* Issue #166 comment: show hint when results are suggested (not direct match) *@
            @if (_matchStrategy is "token" or "prefix" or "suggested")
            {
                <p class="text-muted small mb-2">
                    <i class="bi bi-info-circle"></i> Hiển thị kết quả gần giống nhất với "@_searchKeyword".
                </p>
            }
            <div class="row g-3">
                @foreach (var store in _stores)
                {
                    <div class="col-md-6 col-lg-4">
                        <VanAnCard CssClass="h-100 store-card">
                            <div class="d-flex align-items-start gap-3">
                                @if (!store.IsPending && !string.IsNullOrEmpty(store.LogoUrl))
                                {
                                    <img src="@store.LogoUrl" alt="@store.Name" class="store-logo-sm" />
                                }
                                else
                                {
                                    <i class="bi @(store.IsPending ? "bi-hourglass-split text-warning" : "bi-shop text-primary")" style="font-size: 2rem;"></i>
                                }
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">@store.Name</h5>
                                    @if (store.IsPending)
                                    {
                                        <span class="badge bg-warning text-dark mb-2">
                                            <i class="bi bi-hourglass-split"></i> Chờ xác minh
                                        </span>
                                        <p class="small text-muted mb-2">Thông tin doanh nghiệp đang chờ xác minh từ chủ sở hữu.</p>
                                        <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => ShowPendingMessage(store.Name))">
                                            <i class="bi bi-info-circle me-1"></i> Xem thông tin
                                        </VanAnButton>
                                    }
                                    else
                                    {
                                        @if (!string.IsNullOrEmpty(store.Address))
                                        {
                                            <p class="small text-muted mb-1">
                                                <i class="bi bi-geo-alt"></i> @store.Address
                                            </p>
                                        }
                                        @if (!string.IsNullOrEmpty(store.Phone))
                                        {
                                            <p class="small mb-1">
                                                <a href="tel:@store.Phone" class="text-decoration-none">
                                                    <i class="bi bi-telephone"></i> @store.Phone
                                                </a>
                                            </p>
                                        }
                                        @if (store.DistanceKm.HasValue)
                                        {
                                            <p class="small text-primary mb-0">
                                                <i class="bi bi-signpost"></i> @store.DistanceKm.Value.ToString("F1") km
                                            </p>
                                        }
                                        @if (!string.IsNullOrEmpty(store.Slug))
                                        {
                                            <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary" OnClick="@(() => NavigateToStore(store.Slug, store.KhachLinkDomain, store.Id))">
                                                <i class="bi bi-shop me-1"></i> Xem trang cửa hàng
                                            </VanAnButton>
                                        }
                                    }
                                </div>
                            </div>
                        </VanAnCard>
                    </div>
                }
            </div>
        }
    </div>

<style>
.store-logo-sm {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
}
.store-card { transition: transform 0.2s; }
.store-card:hover { transform: translateY(-2px); }
</style>

@code {
    private string _searchKeyword = "";
    private string _searchMode = "store"; // "store" (default, existing) | "product" (new)
    private List<TenantStoreDto> _stores = new();
    private List<ProductSearchItem> _products = new();
    private List<string> _suggestedKeywords = new();
    private string _matchStrategy = "all";
    private bool _loading;
    private bool _hasSearched;

    // SF-W3 (2026-11-08): voice input state (vananVoiceInput — script loaded via App.razor).
    private bool _speechSupported;
    private bool _listening;
    private string? _voiceError;
    private DotNetObjectReference<Home>? _voiceRef;

    // W2-3 (FR-U1): below-fold retention state
    private static readonly string[] _categoryChips =
        ["Quán ăn", "Cà phê", "Sửa xe", "Spa", "Tạp hoá", "Thời trang", "Tiệm nail", "Gym"];
    private List<string> _recentKeywords = new();
    private List<TenantStoreDto> _featuredStores = new();
    private bool _featuredLoading = true;
    private const string RecentSearchesKey = "directory_recent_searches";

    protected override async Task OnInitializedAsync()
    {
        // Issue #157 point 2: don't load tenant list on page entry for SEARCH,
        // nhưng W2-3: featured stores (top 6) load sẵn cho below-fold section.
        await LoadFeaturedStoresAsync();
    }

    private async Task LoadFeaturedStoresAsync()
    {
        try
        {
            var result = await CatalogService.SearchStoresAsync(null);
            _featuredStores = result.Results.Take(6).ToList();
        }
        catch
        {
            _featuredStores = new();
        }
        finally
        {
            _featuredLoading = false;
        }
    }

    private async Task SearchStores()
    {
        _loading = true;
        _hasSearched = true;
        if (_searchMode == "product")
        {
            // Product search — calls /api/catalog/search?q=
            var result = await CatalogService.SearchProductsAsync(_searchKeyword);
            _products = result?.Products ?? new();
            _stores = new();
            _suggestedKeywords = new();
            _matchStrategy = "all";
        }
        else
        {
            // Store search — existing behavior (unchanged)
            var result = await CatalogService.SearchStoresAsync(_searchKeyword);
            _stores = result.Results;
            _suggestedKeywords = result.SuggestedKeywords;
            _matchStrategy = result.MatchStrategy;
            _products = new();
        }
        _loading = false;
        await SaveRecentKeywordAsync();

        // Phí nền tảng P4 (hook c): directory.search — platform tenant, kw hashed (privacy),
        // fire-and-forget (G9). Unique key per action — distinct searches each count.
        if (Guid.TryParse(Configuration["Metering:PlatformTenantId"], out var platformTenant))
        {
            var kwHash = Convert.ToHexString(
                System.Security.Cryptography.SHA256.HashData(
                    System.Text.Encoding.UTF8.GetBytes(_searchKeyword ?? "")))[..8];
            _ = Metering.RecordUsageAsync(new MeteringUsageEvent(
                platformTenant, "directory.search", 1, "search", DateTime.UtcNow,
                $"dir-search:{Guid.NewGuid()}",
                MetadataJson: $"{{\"mode\":\"{_searchMode}\",\"results\":{(_searchMode == "product" ? _products.Count : _stores.Count)},\"kw\":\"{kwHash}\"}}"));
        }
    }

    /// <summary>Toggle search mode: "store" (default, existing) | "product" (new).
    /// Open-closed: existing store search behavior unchanged when mode="store".</summary>
    private void SetSearchMode(string mode)
    {
        _searchMode = mode == "product" ? "product" : "store";
        // Clear results when switching mode — avoid showing stale results from other mode
        _hasSearched = false;
        _stores = new();
        _products = new();
        _suggestedKeywords = new();
    }

    /// <summary>Issue #166 comment: search with a suggested keyword (clicking "Did you mean...?").</summary>
    private async Task SearchWithKeyword(string keyword)
    {
        _searchKeyword = keyword;
        await SearchStores();
    }

    /// <summary>W2-3: category chip → store-mode search với keyword ngành.</summary>
    private async Task SearchCategory(string category)
    {
        _searchMode = "store";
        _searchKeyword = category;
        await SearchStores();
    }

    /// <summary>W2-3: load last-5 search keywords từ localStorage (sau first render — JS interop).</summary>
    private async Task LoadRecentKeywordsAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", RecentSearchesKey);
            if (!string.IsNullOrEmpty(json))
                _recentKeywords = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new();
        }
        catch { /* localStorage unavailable — recent chips ẩn */ }
    }

    /// <summary>W2-3: persist keyword vừa search (dedupe + max 5, mới nhất đầu).</summary>
    private async Task SaveRecentKeywordAsync()
    {
        try
        {
            var kw = _searchKeyword?.Trim();
            if (string.IsNullOrEmpty(kw)) return;
            _recentKeywords.RemoveAll(k => string.Equals(k, kw, StringComparison.OrdinalIgnoreCase));
            _recentKeywords.Insert(0, kw);
            if (_recentKeywords.Count > 5) _recentKeywords.RemoveRange(5, _recentKeywords.Count - 5);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", RecentSearchesKey,
                System.Text.Json.JsonSerializer.Serialize(_recentKeywords));
        }
        catch { /* non-critical */ }
    }

    private async Task OnSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchStores();
    }

    private void ClearSearch()
    {
        _searchKeyword = "";
        _hasSearched = false;
        _stores = new();
        _suggestedKeywords = new();
        _matchStrategy = "all";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // SF-W3: voice mic — platform page (no tenant flag); browser-gated only.
            try
            {
                _speechSupported = await JSRuntime.InvokeAsync<bool>("vananVoiceInput.isSupported");
                if (_speechSupported) StateHasChanged();
            }
            catch
            {
                _speechSupported = false; // script not loaded — mic hidden
            }

            // W2-3: recent searches cần JS interop → load sau first render
            await LoadRecentKeywordsAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleVoiceAsync()
    {
        _voiceError = null;
        try
        {
            if (_listening)
            {
                _listening = false; // JS onend → OnVoiceEnd re-confirms
                await JSRuntime.InvokeVoidAsync("vananVoiceInput.stop");
            }
            else
            {
                _voiceRef ??= DotNetObjectReference.Create(this);
                _listening = await JSRuntime.InvokeAsync<bool>("vananVoiceInput.start", _voiceRef);
            }
        }
        catch
        {
            _listening = false;
        }
    }

    /// <summary>SF-W3: live transcript while speaking — fills the input in real time.</summary>
    [JSInvokable]
    public void OnVoiceInterim(string text)
    {
        _searchKeyword = text;
        StateHasChanged();
    }

    /// <summary>SF-W3: silence/manual stop → final transcript → auto-submit the search.</summary>
    [JSInvokable]
    public async Task OnVoiceFinal(string text)
    {
        _searchKeyword = text;
        _listening = false;
        await SearchStores();
    }

    [JSInvokable]
    public void OnVoiceError(string message)
    {
        _listening = false;
        _voiceError = message;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceEnd()
    {
        _listening = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_listening) await JSRuntime.InvokeVoidAsync("vananVoiceInput.stop");
        }
        catch { /* JS gone during teardown */ }
        _voiceRef?.Dispose();
    }

    private void GoToStoreFinder()
    {
        // W2-3 (FR-U4): giữ traffic on-domain — StoreFinder nội bộ thay vì redirect khachvip.online
        Navigation.NavigateTo("/stores");
    }

    private void ShowPendingMessage(string storeName)
    {
        // Show alert instead of redirecting to tenant profile
        _pendingAlert = $"{storeName} đang chờ xác minh thông tin từ chủ doanh nghiệp. Vui lòng quay lại sau.";
    }

    private void NavigateToStore(string slug, string? khachLinkDomain, Guid tenantId)
    {
        // Phí nền tảng P4 (hook c): directory.redirect — tenant-facing click-through,
        // fire-and-forget before navigation (G9).
        _ = Metering.RecordUsageAsync(new MeteringUsageEvent(
            tenantId, "directory.redirect", 1, "redirect", DateTime.UtcNow,
            $"dir-redirect:{tenantId}:{Guid.NewGuid()}",
            MetadataJson: $"{{\"slug\":\"{slug}\"}}"));

        if (!string.IsNullOrEmpty(khachLinkDomain))
        {
            // Redirect to tenant's own KhachLink domain
            Navigation.NavigateTo($"https://{khachLinkDomain}/store/{slug}", forceLoad: true);
        }
        else
        {
            // Issue #166: Fallback to configured default KhachLink commerce domain.
            // Previously hardcoded "khachvip.online" (Directory domain — no /store/ route → site unreachable).
            // Default domain hosts the /store/{slug} route for tenants without their own KhachLinkInstance.
            var defaultDomain = Configuration["KhachLink:DefaultDomain"];
            if (string.IsNullOrWhiteSpace(defaultDomain))
                defaultDomain = "khachvip.online"; // ultimate fallback if config missing
            Navigation.NavigateTo($"https://{defaultDomain}/store/{slug}", forceLoad: true);
        }
    }

    private string? _pendingAlert;
}
