@page "/c/{trackingCode}"
@model VanAn.KhachLink.Pages.CampaignModel
@using VanAn.KhachLink.Models

@{
    Layout = null; // Full page layout for tracking pages
    string keyframes = "fade-in";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Campaign.CampaignName - KhachLink</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        .hero-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 80px 0;
        }
        .campaign-badge {
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
        }
        .product-card {
            transition: transform 0.3s ease;
        }
        .product-card:hover {
            transform: translateY(-5px);
        }
        .pulse-animation {
            animation: keyframes 2s infinite;
        }
        @keyframes keyframes {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    @if (Model.Campaign != null)
    {
        <!-- Campaign Header -->
        <div class="hero-section">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <div class="campaign-badge rounded p-3 mb-4">
                            <h1 class="h2 mb-2">
                                <i class="fas fa-bolt"></i> @Model.Campaign.CampaignName
                            </h1>
                            <p class="mb-0">Khuyến mãi đặc biệt từ Vạn An Group</p>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-6">
                                <div class="text-center">
                                    <div class="h3 mb-0 pulse-animation">@Model.Campaign.TotalClicks</div>
                                    <small>Lượt truy cập</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center">
                                    <div class="h3 mb-0">@Model.Campaign.ConvertedOrders</div>
                                    <small>Đơn hàng thành công</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="text-center">
                            <img src="/images/campaign-hero.jpg" class="img-fluid rounded" alt="Campaign">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Section -->
        <div class="container py-5">
            <div class="text-center mb-5">
                <h2 class="h3">🍵 Sản Phẩm Khuyến Mãi</h2>
                <p class="text-muted">Chọn sản phẩm bạn yêu thích và nhận ưu đãi đặc biệt!</p>
            </div>

            <div class="row">
                @foreach (var item in Model.Products)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card product-card h-100 shadow">
                            <div class="position-relative">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? $"https://placehold.co/400x300?text={Uri.EscapeDataString(item.Name)}" : item.ImageUrl)" 
                                     class="card-img-top" 
                                     alt="@item.Name" 
                                     onerror="this.onerror=null; this.src='https://placehold.co/400x300?text=' + encodeURIComponent('@item.Name');">
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">@item.Name</h5>
                                <p class="card-text">@item.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="h5 text-danger">@item.Price.ToString("N0")đ</span>
                                    </div>
                                    <button class="btn btn-primary" onclick="orderProduct('@item.ProductId', @item.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                                        <i class="fas fa-shopping-cart"></i> Đặt ngay
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Footer -->
        <footer class="bg-dark text-white py-4">
            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <h5>🍵 Vạn An Group</h5>
                        <p class="text-muted">Trà sữa cao cấp - Trải nghiệm đẳng cấp</p>
                    </div>
                    <div class="col-md-6">
                        <h5>Liên hệ</h5>
                        <p class="text-muted mb-0">
                            <i class="fas fa-phone"></i> 1900-1234<br>
                            <i class="fas fa-envelope"></i> info@vanan.vn
                        </p>
                    </div>
                </div>
            </div>
        </footer>
    }
    else
    {
        <!-- Campaign Not Found -->
        <div class="container vh-100 d-flex align-items-center justify-content-center">
            <div class="text-center">
                <i class="fas fa-exclamation-triangle fa-4x text-warning mb-3"></i>
                <h2>Chiến dịch không tồn tại</h2>
                <p class="text-muted">Chiến dịch bạn tìm kiếm không có hoặc đã kết thúc.</p>
                <a href="/" class="btn btn-primary">
                    <i class="fas fa-home"></i> Về trang chủ
                </a>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let trackingCode = '@Model.TrackingCode';
        let customerId = getCustomerId();

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            recordClick();
        });

        function getCustomerId() {
            let customerId = localStorage.getItem('customer_device_id');
            if (!customerId) {
                customerId = 'device_' + Math.random().toString(36).substring(2, 15);
                localStorage.setItem('customer_device_id', customerId);
            }
            return customerId;
        }

        async function recordClick() {
            try {
                const response = await fetch(`/api/campaigns/click/${trackingCode}`, {
                    method: 'POST'
                });
                
                if (response.ok) {
                    console.log('Click recorded for tracking code:', trackingCode);
                    sessionStorage.setItem('tracking_code', trackingCode);
                    updateClickCount();
                }
            } catch (error) {
                console.error('Error recording click:', error);
            }
        }

        function updateClickCount() {
            const clickElement = document.querySelector('.pulse-animation');
            if (clickElement) {
                const currentCount = parseInt(clickElement.textContent);
                clickElement.textContent = currentCount + 1;
            }
        }

        async function orderProduct(productId, unitPrice) {
            const trackingCode = sessionStorage.getItem('tracking_code');
            
            const orderData = {
                trackingCode: trackingCode,
                productId: productId,
                unitPrice: unitPrice,
                quantity: 1,
                customerDeviceId: customerId
            };

            try {
                showNotification('Đang xử lý đơn hàng...', 'info');
                const response = await fetch('/api/public/orders', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(orderData)
                });

                if (response.ok) {
                    const result = await response.json();
                    showNotification('Đơn hàng đã được tạo! Cảm ơn bạn.', 'success');
                    updateClickCount();
                } else {
                    const error = await response.text();
                    console.error('Order creation failed:', error);
                    showNotification('Không thể tạo đơn hàng. Vui lòng thử lại.', 'error');
                }
            } catch (error) {
                console.error('Error creating order:', error);
                showNotification('Lỗi kết nối. Vui lòng thử lại.', 'error');
            }
        }

        function showNotification(message, type) {
            const alertClass = type === 'success' ? 'alert-success' : 
                             type === 'error' ? 'alert-danger' : 'alert-info';
            
            const notification = document.createElement('div');
            notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 1050; max-width: 300px;';
            notification.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 5000);
        }
    </script>
</body>
</html>
