@page "/profile"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.PWA
@using VanAn.KhachLink.Services.Http
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject PWAService PWA
@inject CommunityHttpService CommunityHttp

<PageTitle>Tài khoản của tôi</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width:600px;">
        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
            </div>
        }
        else if (!_isLoggedIn)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-person-circle text-muted" style="font-size:4rem;"></i>
                <h5 class="mt-3">Chưa đăng nhập</h5>
                <p class="text-muted">Đăng nhập để xem điểm thưởng và lịch sử đơn hàng.</p>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToLogin">Đăng nhập ngay</VanAnButton>
            </VanAnCard>
        }
        else
        {
            <VanAnCard Shadow="true" CssClass="mb-4">
                <div class="d-flex align-items-center gap-3 p-2">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                         style="width:64px;height:64px;font-size:1.8rem;">
                        @(_customerName?.FirstOrDefault() ?? 'K')
                    </div>
                    <div>
                        <h5 class="mb-0">@_customerName</h5>
                        @if (!string.IsNullOrWhiteSpace(_phoneNumber))
                        {
                            <div class="text-muted small mt-1">
                                <i class="bi bi-telephone me-1"></i>@_phoneNumber
                            </div>
                        }
                        <div class="mt-1">
                            <span class="badge @GetTierBadgeClass()">@_tier</span>
                            <span class="ms-2 text-muted small">@_pointBalance điểm</span>
                            @* Tiered Auth Phase 3: IdentityLevel badge *@
                            <span class="ms-2 badge @GetIdentityLevelBadgeClass()" data-testid="identity-level-badge">
                                <i class="@GetIdentityLevelIcon() me-1"></i>@GetIdentityLevelLabel()
                            </span>
                        </div>
                    </div>
                </div>
            </VanAnCard>

            <div class="list-group mb-4">
                <a class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                   @onclick='() => Navigation.NavigateTo("/my-loyalty")'>
                    <i class="bi bi-gem text-warning"></i>
                    <span>Điểm thưởng &amp; Ưu đãi</span>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </a>
                <a class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                   @onclick='() => Navigation.NavigateTo("/my-orders")'>
                    <i class="bi bi-bag text-primary"></i>
                    <span>Lịch sử đơn hàng</span>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </a>
                <a class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                   @onclick='() => Navigation.NavigateTo("/stores")'>
                    <i class="bi bi-geo-alt text-success"></i>
                    <span>Tìm cửa hàng gần bạn</span>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </a>
            </div>

            @* Phase 5: Push notification toggle *@
            <VanAnCard Shadow="true" CssClass="mb-4">
                <div class="d-flex align-items-center justify-content-between p-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bell-fill text-primary"></i>
                        <div>
                            <div class="fw-medium">Thông báo đẩy</div>
                            <div class="text-muted small">Nhận push khi đơn hàng đổi trạng thái, điểm thưởng biến động.</div>
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="pushToggle" checked="@_pushEnabled"
                               disabled="@_pushToggling"
                               @onchange="TogglePushAsync" />
                        <label class="form-check-label" for="pushToggle">@( _pushToggling ? "..." : (_pushEnabled ? "Bật" : "Tắt") )</label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_pushStatusMessage))
                {
                    <div class="px-2 pb-2">
                        <VanAnAlert Variant="@_pushAlertVariant" Message="@_pushStatusMessage" />
                    </div>
                }
            </VanAnCard>

            @* Loyalty-C WS-B: Birthday input — triggers BirthdayEntry mission (one-time reward) *@
            <VanAnCard Shadow="true" CssClass="mb-4">
                <div class="p-2">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-cake2 text-danger"></i>
                        <div>
                            <div class="fw-medium">Ngày sinh</div>
                            <div class="text-muted small">Nhập ngày sinh để nhận điểm thưởng sinh nhật hàng năm.</div>
                        </div>
                    </div>
                    @if (_birthday.HasValue)
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-muted">Đã đặt: <strong>@_birthday.Value.ToString("dd/MM/yyyy")</strong></span>
                            @if (_birthdaySaved)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Đã nhận điểm</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2 align-items-center">
                            <input type="date" class="form-control" @bind="_birthdayInput" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" min="1900-01-01" />
                            <VanAnButton Variant="ButtonVariant.Primary" OnClick="SaveBirthdayAsync" Disabled="@_birthdaySaving">
                                @if (_birthdaySaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    @:Lưu
                                }
                            </VanAnButton>
                        </div>
                        @if (_birthdayError != null)
                        {
                            <div class="text-danger small mt-1">@_birthdayError</div>
                        }
                        @if (_birthdaySuccess != null)
                        {
                            <div class="text-success small mt-1">@_birthdaySuccess</div>
                        }
                    }
                </div>
            </VanAnCard>

            @* Tiered Auth Phase 3: Upgrade button for Social customers *@
            @if (NeedsUpgrade)
            {
                <VanAnAlert Variant="AlertVariant.Info"
                            Message="Tài khoản Social — nâng cấp qua OTP để đổi điểm thưởng."
                            CssClass="mb-3" />
                <VanAnButton Variant="ButtonVariant.Primary"
                             FullWidth="true"
                             CssClass="mb-3"
                             OnClick="NavigateToLoyaltyUpgrade"
                             TestId="btn-upgrade-identity">
                    <i class="fas fa-shield-alt me-1"></i> Nâng cấp xác thực
                </VanAnButton>
            }

            @* CC-S6 (Sprint 6): Community roles + fraud flags section *@
            @if (_communityRoles.Count > 0)
            {
                <VanAnCard CssClass="mb-3">
                    <h5 class="mb-3"><i class="bi bi-people-fill me-2"></i>Vai trò cộng tác viên</h5>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var role in _communityRoles)
                        {
                            <span class="badge @(role.IsActive ? "bg-success" : "bg-secondary")">
                                @role.RoleType @(role.IsActive ? "(Active)" : "(Inactive)")
                                @if (!string.IsNullOrEmpty(role.SalesmanCode))
                                {
                                    @:— Code: @role.SalesmanCode
                                }
                            </span>
                        }
                    </div>
                </VanAnCard>
            }

            @if (_myFraudFlags.Count > 0)
            {
                <VanAnCard CssClass="mb-3">
                    <h5 class="mb-3"><i class="bi bi-shield-exclamation me-2"></i>Fraud Flags</h5>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Loại</th>
                                    <th>Risk Score</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày tạo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var flag in _myFraudFlags)
                                {
                                    <tr>
                                        <td>@flag.EntityType</td>
                                        <td>@flag.RiskScore</td>
                                        <td><span class="badge bg-@(flag.Status == "Confirmed" ? "danger" : flag.Status == "Pending" ? "warning" : "secondary")">@flag.Status</span></td>
                                        <td>@flag.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </VanAnCard>
            }

            @* Device info section — Sprint 7 gap fix (doc 07-customer §2.3) *@
            <VanAnCard Shadow="true" CssClass="mb-4">
                <div class="p-2">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-phone text-info"></i>
                        <div>
                            <div class="fw-medium">Thiết bị đang sử dụng</div>
                            <div class="text-muted small">Tối đa 3 thiết bị/tài khoản. Thiết bị thứ 4 cần admin duyệt.</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_deviceToken))
                    {
                        <div class="text-muted small">
                            <i class="bi bi-key me-1"></i> Device Token: <code>@_deviceToken[..12]...</code>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">Chưa đăng ký thiết bị.</div>
                    }
                    <div class="text-muted small mt-2">
                        <i class="bi bi-info-circle me-1"></i> Để đăng xuất thiết bị khác, liên hệ admin.
                    </div>
                </div>
            </VanAnCard>

            <VanAnButton Variant="ButtonVariant.Outline" FullWidth="true" OnClick="Logout">
                <i class="bi bi-box-arrow-right"></i> Đăng xuất
            </VanAnButton>
        }
    </div>
</KhachLinkLayout>

@code {
    private bool _loading = true;
    private bool _isLoggedIn = false;
    private string? _customerName;
    private string? _phoneNumber;
    private string _tier = "Bronze";
    private int _pointBalance = 0;
    private string _identityLevel = "Social";

    // Phase 5: Push notification toggle state
    private bool _pushEnabled;
    private bool _pushToggling;
    private string? _pushStatusMessage;
    private AlertVariant _pushAlertVariant = AlertVariant.Info;

    // Loyalty-C WS-B: Birthday input state
    private DateTime? _birthday;
    private DateTime? _birthdayInput;
    private bool _birthdaySaved;
    private bool _birthdaySaving;
    private string? _birthdayError;
    private string? _birthdaySuccess;

    // Tiered Auth Phase 3: IdentityLevel helpers
    private bool NeedsUpgrade => _identityLevel is "Social" or "Guest";

    // CC-S6 (Sprint 6): Community roles + fraud flags
    private List<CommunityRoleDto> _communityRoles = new();
    private List<MyFraudFlagDto> _myFraudFlags = new();

    // Sprint 7 gap fix: Device info
    private string? _deviceToken;

    private string GetIdentityLevelLabel() => _identityLevel switch
    {
        "Verified" => "Đã xác thực",
        "Full"     => "Xác thực đầy đủ",
        "Social"   => "Tài khoản Social",
        _          => "Khách"
    };

    private string GetIdentityLevelBadgeClass() => _identityLevel switch
    {
        "Verified" or "Full" => "bg-success",
        "Social"             => "bg-info text-dark",
        _                    => "bg-secondary"
    };

    private string GetIdentityLevelIcon() => _identityLevel switch
    {
        "Verified" or "Full" => "bi bi-shield-check-fill",
        "Social"             => "bi bi-google",
        _                    => "bi bi-person"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadProfile();
            StateHasChanged();
        }
    }

    private async Task LoadProfile()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (string.IsNullOrEmpty(token))
            {
                _isLoggedIn = false;
                return;
            }

            // Sprint 7 gap fix: Load device token from localStorage
            _deviceToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "device_token");

            var client = HttpClientFactory.CreateClient("gateway");
            var reqMsg = new HttpRequestMessage(HttpMethod.Get, "/api/customers/me");
            reqMsg.Headers.Add("X-Customer-Token", token);
            var resp = await client.SendAsync(reqMsg);

            if (resp.IsSuccessStatusCode)
            {
                var contentType = resp.Content.Headers.ContentType?.MediaType ?? "";
                if (contentType.Contains("json"))
                {
                    var profile = await resp.Content.ReadFromJsonAsync<CustomerProfile>();
                    if (profile != null)
                    {
                        _isLoggedIn = true;
                        _customerName = profile.FullName;
                        _phoneNumber = profile.PhoneNumber;
                        _tier = profile.Tier;
                        _pointBalance = profile.PointBalance;
                        _identityLevel = profile.IdentityLevel ?? "Social";
                        // Issue 3: Load birthday from server so it persists across page reloads
                        _birthday = profile.Birthday;
                        _birthdaySaved = profile.Birthday.HasValue;

                        // Bug 3 fix: Load push notification toggle state from server
                        try
                        {
                            var statusReq = new HttpRequestMessage(HttpMethod.Get, "/api/notifications/push/status");
                            statusReq.Headers.Add("X-Customer-Token", token);
                            var statusResp = await client.SendAsync(statusReq);
                            if (statusResp.IsSuccessStatusCode)
                            {
                                var pushStatus = await statusResp.Content.ReadFromJsonAsync<PushStatusResponse>();
                                _pushEnabled = pushStatus?.Enabled ?? false;
                            }
                        }
                        catch { /* non-critical — default to off */ }

                        // CC-S6 (Sprint 6): Load community roles + fraud flags
                        try
                        {
                            _communityRoles = await CommunityHttp.GetMyRolesAsync(token);
                            _myFraudFlags = await CommunityHttp.GetMyFraudFlagsAsync(token);
                        }
                        catch { /* non-critical — hide community sections */ }
                    }
                }
                else
                {
                    // Non-JSON response (e.g., HTML fallback) — token likely invalid
                    await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "customer_token");
                    _isLoggedIn = false;
                }
            }
            else
            {
                // Token expired or invalid
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "customer_token");
                _isLoggedIn = false;
            }
        }
        finally { _loading = false; }
    }

    private void GoToLogin() => Navigation.NavigateTo("/login");

    private void NavigateToLoyaltyUpgrade() => Navigation.NavigateTo("/my-loyalty");

    // Phase 5: Push notification toggle
    private async Task TogglePushAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (_pushToggling) return;
        _pushToggling = true;
        _pushStatusMessage = null;
        StateHasChanged();

        try
        {
            bool enable = (bool)e.Value;
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (string.IsNullOrEmpty(token))
            {
                _pushStatusMessage = "Vui lòng đăng nhập để sử dụng thông báo đẩy.";
                _pushAlertVariant = AlertVariant.Warning;
                _pushToggling = false;
                StateHasChanged();
                return;
            }

            if (enable)
            {
                // 1. Request notification permission
                bool granted = await PWA.RequestNotificationPermissionAsync();
                if (!granted)
                {
                    _pushStatusMessage = "Bạn cần cấp quyền thông báo trong trình duyệt để bật tính năng này.";
                    _pushAlertVariant = AlertVariant.Warning;
                    _pushEnabled = false;
                    _pushToggling = false;
                    StateHasChanged();
                    return;
                }

                // 2. Subscribe to push via SW (creates PushSubscription in browser)
                string? subscriptionJson = await PWA.SubscribeToPushAsync();
                if (string.IsNullOrEmpty(subscriptionJson))
                {
                    _pushStatusMessage = "Không thể đăng ký thông báo đẩy. Trình duyệt có thể không hỗ trợ.";
                    _pushAlertVariant = AlertVariant.Error;
                    _pushEnabled = false;
                    _pushToggling = false;
                    StateHasChanged();
                    return;
                }

                // 3. Send subscription to server (Gateway → ShopERP)
                var client = HttpClientFactory.CreateClient("gateway");
                var pushReq = new HttpRequestMessage(HttpMethod.Post, "/api/notifications/push/subscribe");
                pushReq.Headers.Add("X-Customer-Token", token);
                pushReq.Content = new System.Net.Http.StringContent(subscriptionJson, System.Text.Encoding.UTF8, "application/json");
                var resp = await client.SendAsync(pushReq);

                if (resp.IsSuccessStatusCode)
                {
                    _pushEnabled = true;
                    _pushStatusMessage = "Đã bật thông báo đẩy. Bạn sẽ nhận được push khi có cập nhật.";
                    _pushAlertVariant = AlertVariant.Success;
                }
                else
                {
                    _pushStatusMessage = "Lỗi khi đăng ký với máy chủ. Vui lòng thử lại.";
                    _pushAlertVariant = AlertVariant.Error;
                    _pushEnabled = false;
                }
            }
            else
            {
                // Unsubscribe: 1. Browser unsubscribe via SW, 2. Server DELETE
                await PWA.UnsubscribeFromPushAsync();

                var client = HttpClientFactory.CreateClient("gateway");
                var delReq = new HttpRequestMessage(HttpMethod.Delete, "/api/notifications/push/subscribe");
                delReq.Headers.Add("X-Customer-Token", token);
                var resp = await client.SendAsync(delReq);

                if (resp.IsSuccessStatusCode)
                {
                    _pushEnabled = false;
                    _pushStatusMessage = "Đã tắt thông báo đẩy.";
                    _pushAlertVariant = AlertVariant.Info;
                }
                else
                {
                    _pushStatusMessage = "Lỗi khi hủy đăng ký. Vui lòng thử lại.";
                    _pushAlertVariant = AlertVariant.Error;
                }
            }
        }
        catch (Exception ex)
        {
            _pushStatusMessage = $"Lỗi: {ex.Message}";
            _pushAlertVariant = AlertVariant.Error;
        }
        finally
        {
            _pushToggling = false;
            StateHasChanged();
        }
    }

    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "customer_token");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "customer_id");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "customer_name");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "login_provider");
        _isLoggedIn = false;
        _customerName = null;
        _phoneNumber = null;
    }

    // Loyalty-C WS-B: Save birthday → triggers BirthdayEntry mission (one-time reward)
    private async Task SaveBirthdayAsync()
    {
        _birthdayError = null;
        _birthdaySuccess = null;

        if (!_birthdayInput.HasValue)
        {
            _birthdayError = "Vui lòng chọn ngày sinh.";
            return;
        }

        if (_birthdayInput.Value.Date > DateTime.UtcNow.Date)
        {
            _birthdayError = "Ngày sinh không thể ở tương lai.";
            return;
        }

        _birthdaySaving = true;
        try
        {
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (string.IsNullOrEmpty(token))
            {
                _birthdayError = "Vui lòng đăng nhập lại.";
                return;
            }

            var client = HttpClientFactory.CreateClient("gateway");
            var req = new System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, "/api/customer-profile/birthday");
            req.Headers.Add("X-Customer-Token", token);
            req.Content = System.Net.Http.Json.JsonContent.Create(new { Birthday = _birthdayInput.Value });

            var resp = await client.SendAsync(req);

            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<BirthdayResponse>();
                _birthday = _birthdayInput;
                _birthdaySaved = result?.PointsAwarded > 0;
                _birthdaySuccess = result?.PointsAwarded > 0
                    ? $"Đã lưu ngày sinh. +{result.PointsAwarded} điểm thưởng!"
                    : "Đã lưu ngày sinh.";
                _pointBalance += result?.PointsAwarded ?? 0;
            }
            else
            {
                _birthdayError = "Không thể lưu ngày sinh. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            _birthdayError = $"Lỗi: {ex.Message}";
        }
        finally
        {
            _birthdaySaving = false;
            StateHasChanged();
        }
    }

    private string GetTierBadgeClass() => _tier switch
    {
        "Platinum" => "bg-info text-dark",
        "Gold"     => "bg-warning text-dark",
        "Silver"   => "bg-secondary",
        _          => "bg-warning"  // Bronze
    };

    private class CustomerProfile
    {
        public string FullName { get; set; } = string.Empty;
        public string? PhoneNumber { get; set; }
        public string Tier { get; set; } = "Bronze";
        public int PointBalance { get; set; }
        public string? IdentityLevel { get; set; }
        public DateTime? Birthday { get; set; }
    }

    private class BirthdayResponse
    {
        public bool Success { get; set; }
        public string Birthday { get; set; } = string.Empty;
        public int PointsAwarded { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    private class PushStatusResponse
    {
        public bool Enabled { get; set; }
        public int Count { get; set; }
    }
}
