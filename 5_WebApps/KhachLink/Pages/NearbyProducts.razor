@page "/community/nearby-products"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject CommunityHttpService CommunityHttp

<PageTitle>Sản phẩm giới thiệu</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width:700px;">
        <h3 class="mb-3">
            <i class="bi bi-shop text-primary"></i> Sản phẩm giới thiệu gần bạn
        </h3>

        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div>
            </div>
        }
        else if (!_isLoggedIn)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-lock text-muted" style="font-size:3rem;"></i>
                <h5 class="mt-3">Đăng nhập để xem sản phẩm</h5>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToLogin">Đăng nhập</VanAnButton>
            </VanAnCard>
        }
        else if (_deniedRole)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-shield-x text-warning" style="font-size:3rem;"></i>
                <h5 class="mt-3">@_errorMessage</h5>
                <p class="text-muted small">Tài khoản của bạn chưa được cấp quyền Salesman.</p>
            </VanAnCard>
        }
        else if (_gpsError)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-geo-alt text-warning" style="font-size:3rem;"></i>
                <h5 class="mt-3">Không lấy được vị trí GPS</h5>
                <p class="text-muted small">@_errorMessage</p>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="RetryGps">Thử lại</VanAnButton>
            </VanAnCard>
        }
        else if (_products.Count == 0)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-inbox text-muted" style="font-size:3rem;"></i>
                <p class="mt-3 text-muted">Không có sản phẩm nào trong bán kính @(_radiusKm)km.</p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button class="btn btn-sm btn-outline-primary" @onclick="IncreaseRadius">Tăng bán kính</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RetryGps">Cập nhật vị trí</button>
                </div>
            </VanAnCard>
        }
        else
        {
            <p class="text-muted small mb-3">@_products.Count sản phẩm trong bán kính @(_radiusKm)km</p>
            <div class="d-flex flex-column gap-3">
                @foreach (var product in _products)
                {
                    <VanAnCard Shadow="true" CssClass="p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="mb-1">@product.Name</h6>
                                <p class="text-muted small mb-1"><i class="bi bi-shop"></i> @product.ShopName</p>
                                <p class="text-muted small mb-1"><i class="bi bi-geo-alt"></i> @product.DistanceKm km</p>
                                <p class="mb-1"><strong>@product.Price.ToString("N0") đ</strong></p>
                                @if (product.HasReferralConfig)
                                {
                                    <div class="mt-2">
                                        <span class="badge bg-success">Hoa hồng: @((product.CommissionRate ?? 0).ToString("P1"))</span>
                                        @if ((product.AppInstallBonus ?? 0) > 0)
                                        {
                                            <span class="badge bg-info ms-1">Bonus cài app: @product.AppInstallBonus?.ToString("N0") đ</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary mt-2">Chưa thiết lập referral</span>
                                }
                            </div>
                            <div class="d-flex flex-column gap-2">
                                @if (product.HasReferralConfig)
                                {
                                    <VanAnButton Variant="ButtonVariant.Primary" OnClick="@(() => GenerateQr(product.ProductId))">
                                        <i class="bi bi-qr-code"></i> Tạo QR
                                    </VanAnButton>
                                }
                            </div>
                        </div>
                    </VanAnCard>
                }
            </div>
            <div class="text-center mt-3">
                <button class="btn btn-sm btn-outline-primary" @onclick="IncreaseRadius">Tăng bán kính</button>
            </div>
        }
    </div>
</KhachLinkLayout>

@code {
    private bool _loading = true;
    private bool _isLoggedIn = false;
    private bool _deniedRole = false;
    private bool _gpsError = false;
    private string _errorMessage = "";
    private string _customerToken = "";
    private int _radiusKm = 10;
    private List<NearbyProductDto> _products = new();

    protected override async Task OnInitializedAsync()
    {
        _customerToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "customerToken") ?? "";
        _isLoggedIn = !string.IsNullOrEmpty(_customerToken);

        if (!_isLoggedIn)
        {
            _loading = false;
            return;
        }

        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _loading = true;
        _gpsError = false;
        _deniedRole = false;

        try
        {
            var pos = await JSRuntime.InvokeAsync<GpsPosition>("vananPWA.getCurrentPosition");
            if (pos == null)
            {
                _gpsError = true;
                _errorMessage = "Không thể lấy vị trí GPS.";
                _loading = false;
                return;
            }

            _products = await CommunityHttp.GetNearbyProductsAsync(_customerToken, pos.Lat, pos.Lng, _radiusKm);
        }
        catch (Exception ex)
        {
            _gpsError = true;
            _errorMessage = ex.Message;
        }

        _loading = false;
    }

    private async Task RetryGps() => await LoadProductsAsync();

    private Task IncreaseRadius()
    {
        _radiusKm += 5;
        return LoadProductsAsync();
    }

    private void GenerateQr(Guid productId)
    {
        Navigation.NavigateTo($"/community/salesman-qr?productId={productId}");
    }

    private void GoToLogin() => Navigation.NavigateTo("/login");

    private class GpsPosition
    {
        public double Lat { get; set; }
        public double Lng { get; set; }
    }
}
