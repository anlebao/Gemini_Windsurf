@page "/products"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Components.Composite
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Components.Shared
@using VanAn.KhachLink.Services.Http
@using VanAn.UI.Platform.Services
@using VanAn.KhachLink.Models
@inject CatalogHttpService CatalogHttp
@inject CartService CartService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ShopFeatureSettingsHttpService FeatureSettings
@inject SearchCorrectionStore Corrections
@implements IAsyncDisposable

<PageTitle>Tìm sản phẩm</PageTitle>

<KhachLinkLayout>
    <div class="container py-4">
        <h3 class="mb-3">
            <i class="bi bi-bag-search text-primary"></i> Tìm sản phẩm / dịch vụ
        </h3>

        <!-- Search box — Search Unification v2: VanAnPublicSearchBar (Pattern A pill,
             enterkeyhint=search, mic/clear trong group) + DidYouMean chip (Pattern B). -->
        <VanAnCard CssClass="mb-3 p-3">
            <div class="product-search-box">
                <VanAnPublicSearchBar @bind-Value="_keyword"
                                      Pill="true"
                                      InputId="product-search-input"
                                      Placeholder="@(_listening ? "Đang nghe..." : "Nhập tên sản phẩm, dịch vụ...")"
                                      AriaLabel="Tìm sản phẩm"
                                      SearchText="Tìm"
                                      Loading="_loading"
                                      ShowVoiceButton="@(_voiceEnabled && _speechSupported)"
                                      IsListening="_listening"
                                      OnVoiceToggle="ToggleVoiceAsync"
                                      OnSearch="Search" />
            </div>
            @* Search Unification v2 (Pattern B): fuzzy → "Ý bạn là: X?" 1-tap *@
            <VanAnDidYouMeanChip Suggestion="@_didYouMean" OnApply="ApplyDidYouMean" />
            @* Personalized DidYouMean (SRS v1.1): Level 0 auto-resolve — báo rõ + Hoàn tác *@
            @if (_resolvedFrom is not null)
            {
                <VanAnAlert Variant="AlertVariant.Info" CssClass="mb-3 search-learned-note">
                    <i class="bi bi-lightbulb me-1"></i>
                    Đang tìm "<b>@_keyword</b>" — đã học từ cách bạn nhập "<i>@_resolvedFrom</i>"
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-2 search-learned-undo" @onclick="UndoResolvedAsync">Hoàn tác</button>
                </VanAnAlert>
            }
            @if (_listening)
            {
                <div class="text-danger small mt-2">
                    <span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>
                    Đang nghe... nói tên sản phẩm hoặc dịch vụ
                </div>
            }
            @if (_voiceError is not null)
            {
                <div class="text-danger small mt-2">@_voiceError</div>
            }
            <div class="mt-2 d-flex gap-2">
                <VanAnButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="GoToStoreSearch">
                    <i class="bi bi-shop me-1"></i> Tìm theo tên cửa hàng
                </VanAnButton>
            </div>
        </VanAnCard>

        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div>
                <p class="mt-2 text-muted">Đang tìm sản phẩm...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <VanAnAlert Variant="AlertVariant.Info" Message="@_errorMessage" />
        }
        else if (_hasSearched && _products.Count == 0)
        {
            <VanAnCard CssClass="text-center p-5">
                <i class="bi bi-inbox text-muted" style="font-size:3rem;"></i>
                <p class="mt-3 text-muted">Không tìm thấy sản phẩm nào phù hợp với "@_keyword".</p>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="GoToStoreSearch">
                    <i class="bi bi-shop me-1"></i> Thử tìm theo tên cửa hàng
                </VanAnButton>
            </VanAnCard>
        }
        else if (_products.Count > 0)
        {
            <p class="text-muted small mb-3">@_products.Count sản phẩm phù hợp với "@_keyword"</p>
            <div class="row g-3">
                @foreach (var product in _products)
                {
                    var imgId = $"product-img-{product.ProductId:N}";
                    <div class="col-md-4 mb-3">
                        <VanAnCard Shadow="true" CssClass="product-card h-100">
                            <div class="product-image">
                                <img id="@imgId"
                                     src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder-product.svg" : product.ImageUrl)"
                                     class="card-img-top"
                                     alt="@product.DisplayName"
                                     style="height: 180px; object-fit: cover;" />
                            </div>
                            <div class="product-info p-2">
                                <h6 class="mb-1">@product.DisplayName</h6>
                                @if (!string.IsNullOrEmpty(product.TenantName))
                                {
                                    <p class="text-muted small mb-1"><i class="bi bi-shop"></i> @product.TenantName</p>
                                }
                                @if (!string.IsNullOrEmpty(product.Description))
                                {
                                    <p class="text-muted small mb-2">@product.Description</p>
                                }
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    @if (product.IsFree)
                                    {
                                        <span class="badge bg-success">Miễn phí</span>
                                    }
                                    else
                                    {
                                        <span class="text-primary fw-bold">@CurrencyHelper.FormatVND(product.DisplayPrice)</span>
                                    }
                                    <VanAnButton Size="ButtonSize.Small" Icon="cart-plus" OnClick="@(() => AddToCart(product, imgId))">
                                        Mua
                                    </VanAnButton>
                                </div>
                            </div>
                        </VanAnCard>
                    </div>
                }
            </div>
        }
        else
        {
            <VanAnCard CssClass="text-center p-5">
                <i class="bi bi-bag text-muted" style="font-size:3rem;"></i>
                <p class="mt-3 text-muted">Nhập từ khóa để tìm sản phẩm, dịch vụ từ các cửa hàng.</p>
            </VanAnCard>
        }
    </div>
</KhachLinkLayout>

@code {
    private string _keyword = "";
    private bool _loading = false;
    private bool _hasSearched = false;
    private string _errorMessage = "";
    private List<RecommendedCatalogItem> _products = new();
    // Search Unification v2 (Pattern B): fuzzy "Ý bạn là: X?" — null khi không gợi ý.
    private string? _didYouMean;
    // Personalized DidYouMean (SRS v1.1): Level 0 — correction đã học rewrite query.
    private string? _resolvedFrom;    // câu gốc user nhập khi auto-resolve đang active
    private string? _didYouMeanRaw;   // câu gốc của search gần nhất — raw để record accept
    private bool _lastInputWasVoice;  // query trong ô input đến từ voice
    private bool _lastSearchWasVoice; // query của search gần nhất đến từ voice

    // SF-W3 (2026-11-08): voice input state (vananVoiceInput — script đã load qua index.html).
    private bool _voiceEnabled;
    private bool _speechSupported;
    private bool _listening;
    private string? _voiceError;
    private DotNetObjectReference<ProductSearchResults>? _voiceRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Read keyword from query string (?q=...)
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (System.Web.HttpUtility.ParseQueryString(uri.Query).Get("q") is { } q && !string.IsNullOrWhiteSpace(q))
            {
                _keyword = q;
                await Search();
            }

            // SF-W3: voice mic — global Voice_Note_Enabled flag + browser support
            // (same pattern as Home/StoreFinder voice search).
            try
            {
                _voiceEnabled = await FeatureSettings.IsEnabledAsync(
                    new Guid("00000000-0000-0000-0000-000000000001"),
                    nameof(ShopFeatureSettingsDto.Voice_Note_Enabled));
                if (_voiceEnabled)
                {
                    // V1d lazy-race: voice JS inject sau window.load — đợi script sẵn
                    // sàng (≤4s) trước khi check support; fail-open → check luôn.
                    try
                    {
                        using var lazyCts = new CancellationTokenSource(TimeSpan.FromSeconds(4));
                        await JSRuntime.InvokeAsync<bool>("vananWhenLazyReady", lazyCts.Token);
                    }
                    catch { /* script chưa sẵn sàng — isSupported vẫn fail-open */ }
                    _speechSupported = await JSRuntime.InvokeAsync<bool>("vananVoiceInput.isSupported");
                    StateHasChanged();
                }
            }
            catch
            {
                _voiceEnabled = false; // non-critical — mic hidden
            }
        }
    }

    private async Task ToggleVoiceAsync()
    {
        _voiceError = null;
        try
        {
            if (_listening)
            {
                _listening = false; // JS onend → OnVoiceEnd re-confirms
                await JSRuntime.InvokeVoidAsync("vananVoiceInput.stop");
            }
            else
            {
                _voiceRef ??= DotNetObjectReference.Create(this);
                // V2b: targetId → interim fill DOM trực tiếp (0 .NET roundtrip/sự kiện)
                _listening = await JSRuntime.InvokeAsync<bool>(
                    "vananVoiceInput.start", _voiceRef, "product-search-input");
            }
        }
        catch
        {
            _listening = false;
        }
    }

    /// <summary>SF-W3: live transcript while speaking — fills the input in real time.</summary>
    [JSInvokable]
    public void OnVoiceInterim(string text)
    {
        _keyword = text;
        StateHasChanged();
    }

    /// <summary>SF-W3: silence/manual stop → final transcript → auto-submit the search.</summary>
    [JSInvokable]
    public async Task OnVoiceFinal(string text)
    {
        _keyword = text;
        _listening = false;
        _lastInputWasVoice = true; // Personalized DidYouMean: tag source=voice cho record
        await Search();
        StateHasChanged(); // JSInvokable không auto-render — xem Dir Home.OnVoiceFinal
    }

    [JSInvokable]
    public void OnVoiceError(string message)
    {
        _listening = false;
        _voiceError = message;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceEnd()
    {
        _listening = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_listening) await JSRuntime.InvokeVoidAsync("vananVoiceInput.stop");
        }
        catch { /* JS gone during teardown */ }
        _voiceRef?.Dispose();
    }

    private async Task Search()
    {
        var keyword = _keyword?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(keyword))
        {
            _products = new();
            _hasSearched = false;
            _didYouMean = null;
            _resolvedFrom = null;
            return;
        }

        // Personalized DidYouMean (SRS v1.1): Level 0 — correction đã học rewrite
        // query trước khi gọi API (client-side localStorage, backend không đổi).
        _didYouMeanRaw = keyword;
        _lastSearchWasVoice = _lastInputWasVoice;
        _lastInputWasVoice = false;
        try
        {
            var learned = await Corrections.ResolveAsync(SearchCorrectionStore.ScopeProduct, keyword);
            if (!string.IsNullOrWhiteSpace(learned)
                && !string.Equals(learned, keyword, StringComparison.OrdinalIgnoreCase))
            {
                _resolvedFrom = keyword;
                keyword = learned.Trim();
                _keyword = learned.Trim();
            }
            else
            {
                _resolvedFrom = null;
            }
        }
        catch { _resolvedFrom = null; }

        _loading = true;
        _hasSearched = true;
        _errorMessage = "";
        StateHasChanged();

        try
        {
            var result = await CatalogHttp.SearchProductsAsync(keyword);
            _products = result?.Products ?? new();
            _didYouMean = result?.DidYouMean;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi tìm kiếm: {ex.Message}";
            _products = new();
            _didYouMean = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>Search Unification v2 (Pattern B): chip "Ý bạn là: X?" → re-search 1-tap.
    /// Personalized (SRS v1.1): học cặp (câu gốc → suggestion) trước khi re-search —
    /// fail-open, lỗi storage không chặn re-search.</summary>
    private async Task ApplyDidYouMean(string suggestion)
    {
        try
        {
            await Corrections.RecordAsync(SearchCorrectionStore.ScopeProduct,
                _didYouMeanRaw ?? _keyword, suggestion, _lastSearchWasVoice ? "voice" : "typed");
        }
        catch { /* storage lỗi → vẫn re-search bình thường */ }
        _keyword = suggestion;
        _didYouMean = null;
        await Search();
    }

    /// <summary>SRS v1.1: undo auto-resolve — xóa correction đã học → re-search câu gốc
    /// (rơi lại flow DidYouMean thường).</summary>
    private async Task UndoResolvedAsync()
    {
        var raw = _resolvedFrom;
        if (raw is null) return;
        _resolvedFrom = null;
        try { await Corrections.ForgetAsync(SearchCorrectionStore.ScopeProduct, raw); }
        catch { /* fail-open */ }
        _keyword = raw;
        await Search();
    }

    private async Task AddToCart(RecommendedCatalogItem item, string? imgElementId = null)
    {
        // Fly-to-cart animation (same as Home.razor — vananFlyToCart in cart-animation.js)
        if (!string.IsNullOrEmpty(imgElementId))
        {
            try { await JSRuntime.InvokeVoidAsync("vananFlyToCart", imgElementId); }
            catch { /* ignore animation errors */ }
        }

        var product = new ProductDto
        {
            ProductId = item.ProductId,
            TenantId = item.TenantId,
            Name = item.DisplayName,
            Description = item.Description ?? string.Empty,
            Price = item.DisplayPrice,
            VatRate = item.VatRate,
            ImageUrl = item.ImageUrl,
            TenantName = item.TenantName ?? string.Empty,
            IsActive = true,
            ProductType = item.ProductType
        };
        await CartService.AddItemAsync(product, 1);

        // Toast notification (vananShowCartToast delegates to shared vananShowToast)
        await JSRuntime.InvokeVoidAsync("vananShowCartToast", $"Đã thêm {item.DisplayName} vào giỏ hàng!");
    }

    private void GoToStoreSearch()
    {
        var keyword = _keyword?.Trim() ?? "";
        var url = string.IsNullOrWhiteSpace(keyword) ? "/stores" : $"/stores?q={Uri.EscapeDataString(keyword)}";
        Navigation.NavigateTo(url);
    }
}
