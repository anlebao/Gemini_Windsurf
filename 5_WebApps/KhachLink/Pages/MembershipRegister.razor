@page "/membership/register/{HtxTenantId:guid}"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject MembershipHttpService MembershipService
@inject ImageUploadService ImageUpload
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<MembershipRegister> Logger

<PageTitle>Đăng ký thành viên HTX — Vạn An</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width: 640px;">
        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
                <p class="mt-3 text-muted">Đang tải thông tin HTX...</p>
            </div>
        }
        else if (_profile is null)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-exclamation-circle text-warning" style="font-size:3rem;"></i>
                <h4 class="mt-3">HTX chưa mở đăng ký</h4>
                <p class="text-muted">Hợp tác xã này chưa tham gia nền tảng đăng ký thành viên Vạn An.</p>
            </VanAnCard>
        }
        else if (_submitted)
        {
            <VanAnCard Shadow="true" CssClass="p-4">
                <div class="text-center mb-3">
                    <i class="bi bi-check-circle text-success" style="font-size:3rem;"></i>
                    <h4 class="mt-2">Hồ sơ đã nộp thành công!</h4>
                    <p class="text-muted mb-0">HTX sẽ xem xét hồ sơ của bạn. Theo dõi trạng thái trong phần hồ sơ của mình.</p>
                </div>

                <hr />

                <h6><i class="bi bi-pen me-1"></i> Xác nhận đồng tham gia HTX</h6>
                <p class="text-muted small">Nếu bạn chưa ký online, bạn có thể in form đăng ký ra giấy, ký tay rồi tải ảnh/scan lên đây (SRS §26-27).</p>

                @if (!string.IsNullOrEmpty(_paperFormStatus))
                {
                    <VanAnAlert Variant="@(_paperFormStatus.StartsWith("✅") ? AlertVariant.Success : AlertVariant.Error)" Message="@_paperFormStatus" CssClass="mb-3" />
                }

                <div class="d-flex gap-2 flex-wrap mb-3">
                    <VanAnButton Variant="ButtonVariant.Secondary" OnClick="PrintForm">
                        <i class="bi bi-printer me-1"></i> In form đăng ký
                    </VanAnButton>
                    <InputFile OnChange="OnPaperFormSelected" accept=".jpg,.jpeg,.png,.webp" hidden id="paper-form-file" />
                    <label for="paper-form-file" class="btn btn-outline-primary mb-0">
                        <i class="bi bi-upload me-1"></i> Tải lên bản ký tay
                    </label>
                </div>

                <VanAnButton Variant="ButtonVariant.Primary" OnClick="@(() => Navigation.NavigateTo("/"))">
                    <i class="bi bi-house me-1"></i> Về trang chủ
                </VanAnButton>
            </VanAnCard>
        }
        else
        {
            <h3 class="mb-1">
                <i class="bi bi-people text-primary"></i> Đăng ký thành viên
            </h3>
            <p class="text-muted mb-4">
                Tham gia hợp tác xã theo Điều lệ <strong>@_profile.CharterVersion</strong>.
                Hồ sơ sẽ được HTX xét duyệt — nộp đơn không tự động trở thành thành viên.
            </p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <VanAnAlert Variant="AlertVariant.Error" Message="@_errorMessage" CssClass="mb-3" />
            }

            <EditForm Model="_form" OnValidSubmit="@SubmitAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                    <InputText @bind-Value="_form.FullName" class="form-control" placeholder="Nguyễn Văn A" />
                    <ValidationMessage For="@(() => _form.FullName)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                    <InputText @bind-Value="_form.PhoneNumber" class="form-control" placeholder="09xx xxx xxx" />
                    <ValidationMessage For="@(() => _form.PhoneNumber)" class="text-danger small" />
                    <div class="form-text">SĐT phải khớp với số đã xác thực trên tài khoản của bạn.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Khu vực</label>
                    <InputText @bind-Value="_form.Region" class="form-control" placeholder="VD: Quận 1, TP.HCM" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Vai trò dự kiến <span class="text-danger">*</span></label>
                    <InputSelect @bind-Value="_form.ExpectedRole" class="form-select">
                        <option value="">-- Chọn vai trò --</option>
                        <option value="Seller">Người bán</option>
                        <option value="Ctv">CTV/Sales</option>
                        <option value="Shipper">Shipper</option>
                        <option value="Supplier">Nhà cung cấp</option>
                        <option value="Customer">Khách hàng</option>
                        <option value="Other">Khác</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => _form.ExpectedRole)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Loại thành viên <span class="text-danger">*</span></label>
                    <InputSelect @bind-Value="_form.MembershipType" class="form-select">
                        <option value="OfficialMember">Thành viên chính thức</option>
                        <option value="LinkedCapitalMember">Thành viên liên kết góp vốn</option>
                        <option value="LinkedNonCapitalMember">Thành viên liên kết không góp vốn</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => _form.MembershipType)" class="text-danger small" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox @bind-Value="_form.AcceptedCharter" class="form-check-input" id="accepted-charter" />
                    <label class="form-check-label" for="accepted-charter">
                        Tôi đã đọc và đồng ý với <strong>Điều lệ v@(_profile.CharterVersion)</strong>
                        và điều kiện gia nhập của HTX <span class="text-danger">*</span>
                    </label>
                    <ValidationMessage For="@(() => _form.AcceptedCharter)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Ký tên online (tùy chọn — lưu làm bằng chứng)</label>
                    <div class="border rounded p-1" style="background:#fff;">
                        <canvas id="signature-canvas" style="width:100%;height:120px;touch-action:none;cursor:crosshair;"></canvas>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <small class="text-muted">Vẽ chữ ký bằng ngón tay/chuột. Có thể in form giấy ký tay sau khi nộp.</small>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSignature">
                            <i class="bi bi-eraser me-1"></i> Xóa
                        </button>
                    </div>
                </div>

                <VanAnButton Variant="ButtonVariant.Primary" IsSubmit="true" IsDisabled="_saving" CssClass="w-100">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Gửi hồ sơ
                </VanAnButton>
            </EditForm>
        }
    </div>

    @* In form giấy: section chỉ hiển thị khi in *@
    <div id="print-form-section" style="display:none;">
        <h3>ĐƠN XIN GIA NHẬP HỢP TÁC XÃ</h3>
        <p><strong>Họ và tên:</strong> @_form.FullName</p>
        <p><strong>Số điện thoại:</strong> @_form.PhoneNumber</p>
        <p><strong>Khu vực:</strong> @_form.Region</p>
        <p><strong>Vai trò dự kiến:</strong> @_form.ExpectedRole</p>
        <p><strong>Loại thành viên:</strong> @_form.MembershipType</p>
        <p><strong>Điều lệ đồng ý:</strong> v@(_profile?.CharterVersion)</p>
        <p><strong>Ngày:</strong> @DateTime.Now.ToString("dd/MM/yyyy")</p>
        <p style="margin-top:80px;">Chữ ký người xin gia nhập: _________________________</p>
    </div>
</KhachLinkLayout>

<style>
    @@media print {
        body * { visibility: hidden; }
        #print-form-section, #print-form-section * { visibility: visible; }
        #print-form-section { display: block !important; position: absolute; left: 0; top: 0; width: 100%; }
    }
</style>

@code {
    [Parameter] public Guid HtxTenantId { get; set; }

    private HtxProfileDto? _profile;
    private bool _loading = true;
    private bool _saving;
    private bool _submitted;
    private string? _errorMessage;
    private string? _paperFormStatus;
    private Guid? _applicationId;

    private IJSObjectReference? _sigModule;
    private readonly RegisterForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await MembershipService.GetHtxProfileAsync(HtxTenantId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Load HTX profile failed for {HtxId}", HtxTenantId);
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _profile is not null)
        {
            try
            {
                _sigModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/membership-signature.js");
                await _sigModule.InvokeVoidAsync("init", "signature-canvas");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Signature pad init failed (non-blocking)");
            }
        }
    }

    private async Task ClearSignature()
    {
        if (_sigModule is not null)
        {
            try { await _sigModule.InvokeVoidAsync("clear"); } catch { /* non-blocking */ }
        }
    }

    private async Task SubmitAsync()
    {
        if (_profile is null) return;

        _saving = true;
        _errorMessage = null;
        try
        {
            var customerToken = await JS.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (string.IsNullOrEmpty(customerToken))
            {
                _errorMessage = "Bạn cần đăng nhập để đăng ký thành viên.";
                return;
            }

            var request = new CreateMembershipApplicationRequestDto(
                HtxTenantId: HtxTenantId,
                MembershipType: _form.MembershipType,
                FullName: _form.FullName,
                PhoneNumber: _form.PhoneNumber,
                Email: null,
                Region: string.IsNullOrWhiteSpace(_form.Region) ? null : _form.Region,
                ExpectedRole: _form.ExpectedRole,
                CharterVersion: _profile.CharterVersion,
                ConsentVersion: _profile.TermsVersion);

            // 1. Consent Điều lệ + tạo hồ sơ Draft
            var (applicationId, error) = await MembershipService.CreateApplicationAndConsentAsync(
                customerToken, request, _profile.CharterVersion);

            if (applicationId is null)
            {
                _errorMessage = error ?? "Không thể tạo hồ sơ. Vui lòng thử lại.";
                return;
            }
            _applicationId = applicationId;

            // 2. Chữ ký online (tùy chọn) — upload + đính kèm evidence
            if (_sigModule is not null)
            {
                var hasInk = false;
                try { hasInk = await _sigModule.InvokeAsync<bool>("hasInk"); } catch { }
                if (hasInk)
                {
                    var dataUrl = await _sigModule.InvokeAsync<string>("toDataUrl");
                    if (!string.IsNullOrEmpty(dataUrl) && dataUrl.Contains(','))
                    {
                        try
                        {
                            var bytes = Convert.FromBase64String(dataUrl.Split(',')[1]);
                            var upload = await ImageUpload.UploadBytesAsync(bytes, "signature.png", "membership-signatures");
                            if (upload.Success && !string.IsNullOrEmpty(upload.Url))
                            {
                                await MembershipService.AttachDocumentAsync(
                                    customerToken, applicationId.Value, "Signature", _profile.CharterVersion, upload.Url);
                            }
                            else
                            {
                                Logger.LogWarning("Signature upload failed (non-blocking): {Error}", upload.Error);
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Signature attach failed (non-blocking)");
                        }
                    }
                }
            }

            // 3. Nộp hồ sơ (Draft → Submitted)
            var (submitted, submitError) = await MembershipService.SubmitApplicationAsync(
                customerToken, applicationId.Value);
            if (!submitted)
            {
                _errorMessage = submitError ?? "Hồ sơ đã tạo nhưng chưa nộp được. Vui lòng thử lại.";
                return;
            }

            _submitted = true;
            Logger.LogInformation("Membership application {ApplicationId} submitted by customer", applicationId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Submit membership application failed");
            _errorMessage = "Có lỗi xảy ra khi gửi hồ sơ. Vui lòng thử lại.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PrintForm()
    {
        try { await JS.InvokeVoidAsync("print"); } catch { /* non-blocking */ }
    }

    private async Task OnPaperFormSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _paperFormStatus = null;
        if (_applicationId is null || string.IsNullOrEmpty(await JS.InvokeAsync<string?>("localStorage.getItem", "customer_token")))
        {
            _paperFormStatus = "❌ Không xác định được hồ sơ hoặc phiên đăng nhập.";
            return;
        }

        try
        {
            var upload = await ImageUpload.UploadGpkdAsync(file, "membership-paper-forms");
            if (!upload.Success || string.IsNullOrEmpty(upload.Url))
            {
                _paperFormStatus = $"❌ {upload.Error ?? "Upload thất bại."}";
                return;
            }

            var customerToken = await JS.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            var (attached, attachError) = await MembershipService.AttachDocumentAsync(
                customerToken!, _applicationId.Value, "PaperApplication", _profile?.CharterVersion ?? "v1", upload.Url);

            _paperFormStatus = attached
                ? "✅ Đã nhận bản ký tay. HTX sẽ xem xét cùng hồ sơ."
                : $"❌ {attachError ?? "Không đính kèm được bản ký tay."}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Paper form upload failed");
            _paperFormStatus = "❌ Có lỗi khi tải bản ký tay. Vui lòng thử lại.";
        }
    }

    private sealed class RegisterForm
    {
        [Required(ErrorMessage = "Vui lòng nhập họ tên.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập số điện thoại.")]
        public string PhoneNumber { get; set; } = string.Empty;

        public string? Region { get; set; }

        [Required(ErrorMessage = "Vui lòng chọn vai trò dự kiến.")]
        public string ExpectedRole { get; set; } = string.Empty;

        public string MembershipType { get; set; } = "OfficialMember";

        [Range(typeof(bool), "true", "true", ErrorMessage = "Bạn cần đồng ý với Điều lệ để tiếp tục.")]
        public bool AcceptedCharter { get; set; }
    }
}
