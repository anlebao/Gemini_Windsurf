@page "/missions"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http.Json

<PageTitle>Nhiệm vụ thưởng điểm</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width:600px;">
        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div>
            </div>
        }
        else if (!_isLoggedIn)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-trophy text-warning" style="font-size:3rem;"></i>
                <h5 class="mt-3">Đăng nhập để làm nhiệm vụ</h5>
                <p class="text-muted">Hoàn thành nhiệm vụ để nhận điểm thưởng miễn phí.</p>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToLogin">Đăng nhập</VanAnButton>
            </VanAnCard>
        }
        else if (_missions.Count == 0)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-inbox text-muted" style="font-size:3rem;"></i>
                <h5 class="mt-3">Hiện chưa có nhiệm vụ</h5>
                <p class="text-muted">Vui lòng quay lại sau.</p>
            </VanAnCard>
        }
        else
        {
            <h4 class="mb-3"><i class="bi bi-trophy-fill text-warning"></i> Nhiệm vụ thưởng điểm</h4>
            <p class="text-muted small mb-3">Hoàn thành nhiệm vụ để nhận điểm thưởng. Số dư: <strong>@_pointBalance.ToString("N0")</strong> điểm</p>

            @if (_error != null)
            {
                <VanAnAlert Variant="AlertVariant.Error" Message="@_error" CssClass="mb-3" />
            }
            @if (_success != null)
            {
                <VanAnAlert Variant="AlertVariant.Success" Message="@_success" CssClass="mb-3" />
            }

            <div class="row g-3">
                @foreach (var mission in _missions)
                {
                    <div class="col-12">
                        <VanAnCard Shadow="true" CssClass="h-100">
                            <div class="p-3 d-flex align-items-center">
                                <div class="me-3" style="font-size:2rem;">
                                    @GetMissionIcon(mission.MissionType)
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@mission.Title</h6>
                                    <p class="text-muted small mb-2">@(mission.Description ?? "")</p>
                                    <div class="d-flex gap-2 align-items-center flex-wrap">
                                        <span class="badge bg-success">+@mission.PointsReward.ToString("N0") điểm</span>
                                        @if (mission.IsOneTime)
                                        {
                                            <span class="badge bg-info text-dark">Một lần</span>
                                        }
                                        else if (mission.DailyCap.HasValue)
                                        {
                                            <span class="badge bg-info text-dark">Tối đa @mission.DailyCap lần/ngày</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">Không giới hạn</span>
                                        }
                                        @if (mission.IsCompleted)
                                        {
                                            <span class="badge bg-secondary">Đã hoàn thành</span>
                                        }
                                        else if (mission.CompletionCount > 0)
                                        {
                                            <span class="badge bg-light text-dark">Đã làm @mission.CompletionCount lần</span>
                                        }
                                    </div>
                                </div>
                                <div class="ms-2">
                                    @if (mission.IsCompleted)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" style="font-size:1.5rem;"></i>
                                    }
                                    else if (mission.MissionType is "BirthdayEntry" or "OtpVerify")
                                    {
                                        <VanAnButton Variant="ButtonVariant.Primary" OnClick="@(() => Navigation.NavigateTo("/profile"))" CssClass="btn-sm">
                                            @(mission.MissionType == "BirthdayEntry" ? "Nhập ngày sinh" : "Xác thực")
                                        </VanAnButton>
                                    }
                                    else if (mission.MissionType is "FacebookShare" or "TikTokShare")
                                    {
                                        <VanAnButton Variant="ButtonVariant.Primary" OnClick="@(() => OpenShareModal(mission.MissionType))" CssClass="btn-sm">
                                            Chia sẻ
                                        </VanAnButton>
                                    }
                                    else if (mission.MissionType == "PWAInstall")
                                    {
                                        <VanAnButton Variant="ButtonVariant.Primary" OnClick="InstallPwaAsync" CssClass="btn-sm">
                                            Cài app
                                        </VanAnButton>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted">Làm nhiệm vụ</span>
                                    }
                                </div>
                            </div>
                        </VanAnCard>
                    </div>
                }
            </div>

            @if (_showShareModal)
            {
                <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title"><i class="bi bi-share-fill"></i> Chia sẻ để nhận điểm</h5>
                                <button type="button" class="btn-close" @onclick="CloseShareModal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="small">Dán link bài chia sẻ của bạn (phải thuộc facebook.com hoặc tiktok.com):</p>
                                <input type="url" class="form-control mb-2" placeholder="https://www.facebook.com/..." @bind="_shareUrl" />
                                @if (_shareError != null)
                                {
                                    <div class="text-danger small">@_shareError</div>
                                }
                            </div>
                            <div class="modal-footer">
                                <VanAnButton Variant="ButtonVariant.Secondary" OnClick="CloseShareModal">Hủy</VanAnButton>
                                <VanAnButton Variant="ButtonVariant.Primary" OnClick="SubmitShareAsync" Disabled="@_shareSubmitting">
                                    @if (_shareSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        @:Gửi
                                    }
                                </VanAnButton>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* WS-1.2 SC16: MissionCompletion history section (AF-P1-T3: paginated 20/page + "Xem thêm") *@
            <div class="mt-4">
                <h5 class="mb-3"><i class="bi bi-clock-history"></i> Nhiệm vụ đã hoàn thành</h5>
                @if (_completions.Count == 0)
                {
                    <VanAnCard Shadow="true" CssClass="text-center p-4">
                        <i class="bi bi-clipboard-check text-muted" style="font-size:2rem;"></i>
                        <p class="text-muted small mt-2 mb-0">Chưa hoàn thành nhiệm vụ nào.</p>
                    </VanAnCard>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var c in _completions)
                        {
                            <div class="list-group-item d-flex align-items-center">
                                <div class="me-3" style="font-size:1.5rem;">@GetMissionIcon(c.MissionType)</div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@c.MissionTitle</div>
                                    <div class="text-muted small">
                                        +@c.PointsAwarded.ToString("N0") điểm • @c.CompletedAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                    @if (!string.IsNullOrEmpty(c.Metadata))
                                    {
                                        <div class="text-muted small text-truncate" style="max-width:300px;" title="@c.Metadata">
                                            <i class="bi bi-link-45deg"></i> @c.Metadata
                                        </div>
                                    }
                                </div>
                                <i class="bi bi-check-circle-fill text-success"></i>
                            </div>
                        }
                    </div>
                    @if (_completionsHasMore)
                    {
                        <div class="text-center mt-3">
                            <VanAnButton Variant="ButtonVariant.Secondary" OnClick="LoadMoreCompletionsAsync" Disabled="@_completionsLoadingMore" CssClass="btn-sm">
                                @if (_completionsLoadingMore)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    @:Xem thêm
                                }
                            </VanAnButton>
                        </div>
                    }
                }
            </div>
        }
    </div>
</KhachLinkLayout>

@code {
    private bool _loading = true;
    private bool _isLoggedIn;
    private int _pointBalance;
    private string? _error;
    private string? _success;
    private List<MissionProgressDto> _missions = new();
    private List<MissionCompletionDto> _completions = new();

    // AF-P1-T3: Pagination state for completions
    private int _completionsPage = 1;
    private bool _completionsHasMore;
    private int _completionsTotal;
    private bool _completionsLoadingMore;
    private const int CompletionsPageSize = 20;

    // Share modal state
    private bool _showShareModal;
    private string _shareUrl = string.Empty;
    private string? _shareError;
    private bool _shareSubmitting;
    private string _pendingShareType = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
        _isLoggedIn = !string.IsNullOrEmpty(token);
        if (!_isLoggedIn)
        {
            _loading = false;
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("gateway");

            // Load missions progress + loyalty balance + completions in parallel
            // AF-P1-T3: completions now paginated (page=1, pageSize=20)
            var progressTask = SendWithTokenAsync(client, "/api/missions/my/progress", token);
            var loyaltyTask = SendWithTokenAsync(client, "/api/loyalty/my", token);
            var completionsTask = SendWithTokenAsync(client, $"/api/missions/my/completions?page=1&pageSize={CompletionsPageSize}", token);

            await Task.WhenAll(progressTask, loyaltyTask, completionsTask);

            var progressResp = await progressTask;
            if (progressResp.IsSuccessStatusCode)
            {
                _missions = await progressResp.Content.ReadFromJsonAsync<List<MissionProgressDto>>() ?? new();
            }

            var loyaltyResp = await loyaltyTask;
            if (loyaltyResp.IsSuccessStatusCode)
            {
                var loyalty = await loyaltyResp.Content.ReadFromJsonAsync<LoyaltyMyResponse>();
                _pointBalance = loyalty?.PointBalance ?? 0;
            }

            var completionsResp = await completionsTask;
            if (completionsResp.IsSuccessStatusCode)
            {
                var paged = await completionsResp.Content.ReadFromJsonAsync<PaginatedCompletionsResponse>();
                _completions = paged?.items ?? new();
                _completionsPage = 1;
                _completionsHasMore = paged?.hasMore ?? false;
                _completionsTotal = paged?.total ?? 0;
            }
        }
        catch (Exception ex)
        {
            _error = $"Lỗi tải dữ liệu: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static async Task<HttpResponseMessage> SendWithTokenAsync(HttpClient client, string url, string? token)
    {
        var req = new HttpRequestMessage(HttpMethod.Get, url);
        if (!string.IsNullOrEmpty(token))
            req.Headers.Add("X-Customer-Token", token);
        return await client.SendAsync(req);
    }

    private void GoToLogin() => Navigation.NavigateTo("/login");

    private static string GetMissionIcon(string missionType) => missionType switch
    {
        "PWAInstall" => "📱",
        "OtpVerify" => "✅",
        "BirthdayEntry" => "🎂",
        "FacebookShare" => "📘",
        "TikTokShare" => "🎵",
        "Custom" => "🎁",
        _ => "🎯"
    };

    private async Task InstallPwaAsync()
    {
        try
        {
            _ = await JSRuntime.InvokeAsync<bool>("vananPWA.showInstallPrompt");
        }
        catch
        {
            _error = "Tính năng cài đặt PWA không khả dụng trên trình duyệt này.";
        }
    }

    private void OpenShareModal(string missionType)
    {
        _pendingShareType = missionType;
        _shareUrl = string.Empty;
        _shareError = null;
        _showShareModal = true;
    }

    private void CloseShareModal()
    {
        _showShareModal = false;
        _shareError = null;
    }

    // AF-P1-T3: Load next page of completions and append to existing list
    private async Task LoadMoreCompletionsAsync()
    {
        if (_completionsLoadingMore || !_completionsHasMore) return;

        _completionsLoadingMore = true;
        try
        {
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (string.IsNullOrEmpty(token)) return;

            var client = HttpClientFactory.CreateClient("gateway");
            var nextPage = _completionsPage + 1;
            var resp = await SendWithTokenAsync(client, $"/api/missions/my/completions?page={nextPage}&pageSize={CompletionsPageSize}", token);

            if (resp.IsSuccessStatusCode)
            {
                var paged = await resp.Content.ReadFromJsonAsync<PaginatedCompletionsResponse>();
                if (paged?.items != null && paged.items.Count > 0)
                {
                    _completions.AddRange(paged.items);
                    _completionsPage = nextPage;
                    _completionsHasMore = paged.hasMore;
                }
            }
        }
        catch
        {
            // Best-effort — silent failure on "load more" (user can retry)
        }
        finally
        {
            _completionsLoadingMore = false;
        }
    }

    private async Task SubmitShareAsync()
    {
        _shareError = null;
        if (string.IsNullOrWhiteSpace(_shareUrl))
        {
            _shareError = "Vui lòng dán link chia sẻ.";
            return;
        }

        _shareSubmitting = true;
        try
        {
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (string.IsNullOrEmpty(token))
            {
                _shareError = "Vui lòng đăng nhập lại.";
                return;
            }

            var client = HttpClientFactory.CreateClient("gateway");
            var req = new HttpRequestMessage(HttpMethod.Post, "/api/customer-profile/share");
            req.Headers.Add("X-Customer-Token", token);
            req.Content = JsonContent.Create(new { ShareUrl = _shareUrl });

            var resp = await client.SendAsync(req);

            if (resp.IsSuccessStatusCode)
            {
                _showShareModal = false;
                _success = "Chia sẻ thành công! Điểm đã được cộng.";
                _error = null;
                await OnInitializedAsync(); // Reload progress
            }
            else
            {
                _shareError = "Không thể ghi nhận chia sẻ. Vui lòng kiểm tra link và thử lại.";
            }
        }
        catch (Exception ex)
        {
            _shareError = $"Lỗi: {ex.Message}";
        }
        finally
        {
            _shareSubmitting = false;
        }
    }

    // DTOs
    private class MissionProgressDto
    {
        public Guid MissionId { get; set; }
        public string MissionType { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int PointsReward { get; set; }
        public bool IsOneTime { get; set; }
        public int? DailyCap { get; set; }
        public int CompletionCount { get; set; }
        public DateTime? LastCompletedAt { get; set; }
        public bool IsCompleted { get; set; }
    }

    private class LoyaltyMyResponse
    {
        public int PointBalance { get; set; }
    }

    private class MissionCompletionDto
    {
        public Guid Id { get; set; }
        public string MissionType { get; set; } = string.Empty;
        public string MissionTitle { get; set; } = string.Empty;
        public int PointsAwarded { get; set; }
        public DateTime CompletedAt { get; set; }
        public string? Metadata { get; set; }
    }

    // AF-P1-T3: Paginated response wrapper for /api/missions/my/completions
    private class PaginatedCompletionsResponse
    {
        public List<MissionCompletionDto> items { get; set; } = new();
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public bool hasMore { get; set; }
    }
}
