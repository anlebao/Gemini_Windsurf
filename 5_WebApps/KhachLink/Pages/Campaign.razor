@page "/c/{trackingCode}"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@using VanAn.Shared.Domain
@inject ISocialCampaignService CampaignService
@inject ProductHttpService ProductService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>@(CampaignData?.CampaignName ?? "Khuyến mãi")</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width:900px;">
        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
                <p class="mt-2">Đang tải khuyến mãi...</p>
            </div>
        }
        else if (_notFound)
        {
            <VanAnAlert Variant="AlertVariant.Warning" Message="Không tìm thấy khuyến mãi." />
            <div class="text-center mt-3">
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoHome">Về trang chủ</VanAnButton>
            </div>
        }
        else if (CampaignData != null)
        {
            <div class="campaign-detail">
                @if (!string.IsNullOrEmpty(CampaignData.ImageUrl))
                {
                    <img src="@CampaignData.ImageUrl" alt="@CampaignData.CampaignName" class="img-fluid rounded mb-3" style="max-height:300px;object-fit:cover;width:100%;" />
                }
                <h2 class="mb-3">@CampaignData.CampaignName</h2>

                @if (Products.Count > 0)
                {
                    <h4 class="mb-3">Sản phẩm khuyến mãi</h4>
                    <div class="row g-3">
                        @foreach (var product in Products)
                        {
                            <div class="col-md-4 col-sm-6">
                                <div class="card h-100">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height:180px;object-fit:cover;" />
                                    }
                                    <div class="card-body">
                                        <h6 class="card-title">@product.Name</h6>
                                        <p class="card-text text-primary fw-bold">@product.Price.ToString("N0") đ</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</KhachLinkLayout>

@code {
    [Parameter] public string TrackingCode { get; set; } = string.Empty;

    private SocialCampaign? CampaignData;
    private List<ProductDto> Products = new();
    private bool _loading = true;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(TrackingCode))
        {
            _notFound = true;
            _loading = false;
            return;
        }

        try
        {
            CampaignData = await CampaignService.GetCampaignByTrackingCodeAsync(TrackingCode);
            if (CampaignData == null)
            {
                _notFound = true;
            }
            else
            {
                // Record click for campaign analytics (fire-and-forget, non-blocking)
                _ = CampaignService.RecordClickAsync(TrackingCode);
                // Store tracking code for checkout conversion tracking
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "campaign_tracking_code", TrackingCode);
                Guid tenantId = CampaignData.TenantId.Value;
                Products = await ProductService.GetProductsAsync(tenantId);
            }
        }
        catch
        {
            _notFound = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoHome() => Navigation.NavigateTo("/");
}
