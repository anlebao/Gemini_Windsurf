@page "/community/salesman-qr"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject CommunityHttpService CommunityHttp

<PageTitle>Mã QR giới thiệu</PageTitle>

<KhachLinkLayout>
    <div class="container py-4">
        <h3 class="mb-3">
            <i class="bi bi-qr-code text-primary"></i> Mã QR giới thiệu
        </h3>

        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div>
            </div>
        }
        else if (!_isLoggedIn)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-lock text-muted" style="font-size:3rem;"></i>
                <h5 class="mt-3">Đăng nhập để tạo mã QR</h5>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToLogin">Đăng nhập</VanAnButton>
            </VanAnCard>
        }
        else if (_qr != null)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-4">
                <div class="qr-canvas-wrap mb-3">
                    <canvas id="qrCanvas"></canvas>
                </div>
                <div class="mb-3">
                    <p class="text-muted small mb-1">Mã composite:</p>
                    <p class="font-monospace fs-5 qr-composite-code"><strong>@_qr.CompositeCode</strong></p>
                </div>
                <div class="mb-3 text-muted small">
                    <p class="mb-1">Mã salesman: <strong>@_qr.SalesmanCode</strong></p>
                    <p class="mb-1">Mã sản phẩm: <strong>@_qr.ProductShortCode</strong></p>
                </div>
                <div class="d-flex gap-2 justify-content-center">
                    <VanAnButton Variant="ButtonVariant.Primary" OnClick="DownloadQr">
                        <i class="bi bi-download"></i> Tải QR
                    </VanAnButton>
                    <VanAnButton Variant="ButtonVariant.Outline" OnClick="GoBack">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </VanAnButton>
                </div>
            </VanAnCard>
        }
        else if (_noProduct)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-shop text-primary" style="font-size:3rem;"></i>
                <h5 class="mt-3">Chọn sản phẩm để tạo mã QR</h5>
                <p class="text-muted small">Mã QR giới thiệu được tạo cho từng sản phẩm. Vui lòng chọn một sản phẩm từ danh sách.</p>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoBack">
                    <i class="bi bi-shop"></i> Xem sản phẩm giới thiệu
                </VanAnButton>
            </VanAnCard>
        }
        else
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-exclamation-triangle text-warning" style="font-size:3rem;"></i>
                <h5 class="mt-3">@_errorMessage</h5>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="GoBack">Quay lại</VanAnButton>
            </VanAnCard>
        }
    </div>
</KhachLinkLayout>

<style>
    /* The QR canvas is generated at ~268px (JS sets width/height attributes). On a narrow phone
       (360px viewport) a fixed 300px canvas + card padding overflowed the frame. Make it fluid:
       cap the size, keep the square aspect ratio, and centre it. */
    .qr-canvas-wrap {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .qr-canvas-wrap canvas#qrCanvas {
        display: block;
        width: 100%;
        max-width: 260px;
        height: auto;
        aspect-ratio: 1 / 1;
        margin: 0 auto;
    }

    /* Composite code can be long ("DL9ZMQ|COMRV1") — never let it push the card wider than the screen. */
    .qr-composite-code {
        word-break: break-all;
    }

    @@media (max-width: 400px) {
        .qr-canvas-wrap canvas#qrCanvas {
            max-width: 200px;
        }
    }
</style>

@code {
    private bool _loading = true;
    private bool _isLoggedIn = false;
    private bool _noProduct = false;
    private bool _qrRendered = false;
    private string _customerToken = "";
    private string _errorMessage = "Không thể tạo mã QR.";
    private CompositeSalesmanQrDto? _qr;
    private Guid _productId;

    protected override async Task OnInitializedAsync()
    {
        _customerToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "customer_token") ?? "";
        _isLoggedIn = !string.IsNullOrEmpty(_customerToken);

        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        var productIdStr = query["productId"];
        if (Guid.TryParse(productIdStr, out var productId))
        {
            _productId = productId;
        }

        if (!_isLoggedIn)
        {
            _loading = false;
            return;
        }

        // Issue #175: no productId (e.g. the "Mã QR của tôi" nav link) is NOT an error —
        // guide the user to pick a product instead of showing the misleading "Không thể tạo mã QR".
        if (_productId == Guid.Empty)
        {
            _noProduct = true;
            _loading = false;
            return;
        }

        await LoadQrAsync();
    }

    private async Task LoadQrAsync()
    {
        try
        {
            // Pass THIS instance's host so the QR points at the domain the customer will use
            // (previously hardcoded to diemthuong.khachvip.online → wrong site on every other instance).
            _qr = await CommunityHttp.GetSalesmanQrAsync(_customerToken, _productId, new Uri(Navigation.Uri).Host);
        }
        catch (Exception)
        {
            _qr = null;
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // _qr is loaded asynchronously, so firstRender fires while the loading spinner is shown
        // (canvas not yet in the DOM). Render the QR on the first render where the canvas exists.
        if (_qr != null && !_qrRendered)
        {
            _qrRendered = true;
            await JSRuntime.InvokeVoidAsync("vananQR.generate", "qrCanvas", _qr.QrUrl, 300, 300);
        }
    }

    private async Task DownloadQr()
    {
        if (_qr != null)
        {
            await JSRuntime.InvokeVoidAsync("vananQR.download", "qrCanvas", $"qr_{_qr.CompositeCode}.png");
        }
    }

    private void GoBack() => Navigation.NavigateTo("/community/nearby-products");
    private void GoToLogin() => Navigation.NavigateTo("/login");
}
