@page "/store/{Slug}/claim"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@inject TenantProfileHttpService TenantProfileService
@inject ImageUploadService ImageUpload
@inject ClaimHttpService ClaimService
@inject NavigationManager Navigation
@inject ILogger<Claim> Logger

<PageTitle>Xác nhận doanh nghiệp — KhachLink</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width:600px;">
        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
                <p class="mt-3 text-muted">Đang tải thông tin doanh nghiệp...</p>
            </div>
        }
        else if (_store is null)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-exclamation-circle text-warning" style="font-size:3rem;"></i>
                <h4 class="mt-3">Không tìm thấy doanh nghiệp</h4>
                <p class="text-muted">Doanh nghiệp bạn tìm không tồn tại hoặc đã được xác thực.</p>
                <VanAnButton Variant="ButtonVariant.Secondary" OnClick="@(() => Navigation.NavigateTo("/store-finder"))">
                    Tìm cửa hàng khác
                </VanAnButton>
            </VanAnCard>
        }
        else if (!_store.IsPending)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-check-circle text-success" style="font-size:3rem;"></i>
                <h4 class="mt-3">Doanh nghiệp đã được xác thực</h4>
                <p class="text-muted">Doanh nghiệp "@_store.Name" đã có chủ sở hữu xác nhận.</p>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="@(() => Navigation.NavigateTo($"/store/{Slug}"))">
                    <i class="bi bi-shop me-1"></i> Xem cửa hàng
                </VanAnButton>
            </VanAnCard>
        }
        else if (_submitted)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-check-circle text-success" style="font-size:3rem;"></i>
                <h4 class="mt-3">Yêu cầu đã gửi thành công!</h4>
                <p class="text-muted">@_submitMessage</p>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="@(() => Navigation.NavigateTo($"/store/{Slug}"))">
                    <i class="bi bi-arrow-left me-1"></i> Về trang cửa hàng
                </VanAnButton>
            </VanAnCard>
        }
        else
        {
            <h3 class="mb-3">
                <i class="bi bi-shield-check text-primary"></i> Xác nhận sở hữu doanh nghiệp
            </h3>
            <p class="text-muted mb-4">
                Bạn đang xác nhận sở hữu <strong>@_store.Name</strong>.
                Vui lòng cung cấp thông tin và tải ảnh Giấy phép kinh doanh (GPKD)
                để đội ngũ Vạn An xác nhận.
            </p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <VanAnAlert Variant="AlertVariant.Error" Message="@_errorMessage" CssClass="mb-3" />
            }

            <EditForm Model="@_form" OnValidSubmit="@SubmitClaim">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                    <InputText @bind-Value="_form.ClaimantName" class="form-control" placeholder="Nguyễn Văn A" />
                    <ValidationMessage For="@(() => _form.ClaimantName)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                    <InputText @bind-Value="_form.ClaimantPhone" class="form-control" placeholder="09xx xxx xxx" />
                    <ValidationMessage For="@(() => _form.ClaimantPhone)" class="text-danger small" />
                    <div class="form-text">SĐT này sẽ được dùng để liên hệ sau khi xác nhận thành công.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email <span class="text-muted">(tùy chọn)</span></label>
                    <InputText @bind-Value="_form.ClaimantEmail" class="form-control" placeholder="email@example.com" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Mã số thuế <span class="text-danger">*</span></label>
                    <InputText @bind-Value="_form.TaxCodeSubmitted" class="form-control" placeholder="0106463914" />
                    <ValidationMessage For="@(() => _form.TaxCodeSubmitted)" class="text-danger small" />
                    <div class="form-text">Phải khớp với MST trên GPKD. Có thể chỉnh sửa nếu sai.</div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Ảnh Giấy phép kinh doanh (GPKD) <span class="text-danger">*</span></label>
                    <InputFile OnChange="@OnFileSelected" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">JPG/PNG/WebP, tối đa 5MB. Ảnh rõ nét, toàn bộ GPKD.</div>
                    @if (!string.IsNullOrEmpty(_uploadedImageUrl))
                    {
                        <div class="mt-2 text-success small">
                            <i class="bi bi-check-circle-fill"></i> Đã tải lên thành công.
                        </div>
                    }
                    else if (_uploading)
                    {
                        <div class="mt-2 text-info small">
                            <span class="spinner-border spinner-border-sm"></span> Đang tải ảnh...
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_fileError))
                    {
                        <div class="mt-2 text-danger small">@_fileError</div>
                    }
                </div>

                <div class="d-grid gap-2">
                    <VanAnButton Variant="ButtonVariant.Primary" Size="ButtonSize.Large" FullWidth="true">
                        <i class="bi bi-send me-1"></i> Gửi yêu cầu xác nhận
                    </VanAnButton>
                    <VanAnButton Variant="ButtonVariant.Secondary" type="button" OnClick="@(() => Navigation.NavigateTo($"/store/{Slug}"))">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </VanAnButton>
                </div>
            </EditForm>
        }
    </div>
</KhachLinkLayout>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _uploading;
    private bool _submitted;
    private string? _errorMessage;
    private string? _fileError;
    private string? _uploadedImageUrl;
    private string _submitMessage = string.Empty;
    private ShopDto? _store;
    private ClaimForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _store = await TenantProfileService.GetBySlugAsync(Slug);
            if (_store is not null && _store.IsPending)
            {
                // Pre-fill tax code from store data if available (read-only display, editable).
                _form.TaxCodeSubmitted = ExtractTaxCodeFromSlug(Slug);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Claim page for slug '{Slug}'", Slug);
            _store = null;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Extract tax code from pending slug format: pending-{taxCode}-{random4}</summary>
    private static string ExtractTaxCodeFromSlug(string slug)
    {
        if (slug.StartsWith("pending-", StringComparison.OrdinalIgnoreCase))
        {
            var rest = slug["pending-".Length..];
            var lastDash = rest.LastIndexOf('-');
            if (lastDash > 0)
                return rest[..lastDash];
            return rest;
        }
        return string.Empty;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _fileError = null;
        _uploadedImageUrl = null;

        if (e.FileCount == 0)
            return;

        var file = e.File;
        _uploading = true;
        try
        {
            var outcome = await ImageUpload.UploadGpkdAsync(file);
            if (outcome.Success)
            {
                _uploadedImageUrl = outcome.Url;
            }
            else
            {
                _fileError = outcome.Error;
            }
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task SubmitClaim()
    {
        _errorMessage = null;

        // Validate required fields
        if (string.IsNullOrWhiteSpace(_form.ClaimantName))
        {
            _errorMessage = "Vui lòng nhập họ và tên.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.ClaimantPhone))
        {
            _errorMessage = "Vui lòng nhập số điện thoại.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.TaxCodeSubmitted))
        {
            _errorMessage = "Vui lòng nhập mã số thuế.";
            return;
        }
        if (string.IsNullOrEmpty(_uploadedImageUrl))
        {
            _errorMessage = "Vui lòng tải lên ảnh Giấy phép kinh doanh.";
            return;
        }

        try
        {
            var request = new SubmitClaimRequestDto(
                _form.ClaimantName.Trim(),
                _form.ClaimantPhone.Trim(),
                string.IsNullOrWhiteSpace(_form.ClaimantEmail) ? null : _form.ClaimantEmail.Trim(),
                _uploadedImageUrl,
                _form.TaxCodeSubmitted.Trim());

            var outcome = await ClaimService.SubmitClaimAsync(_store!.Id, request);
            if (outcome.Success)
            {
                _submitted = true;
                _submitMessage = outcome.Message ?? "Cảm ơn! Yêu cầu xác nhận đã gửi.";
            }
            else
            {
                _errorMessage = outcome.Error;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Claim submit exception for slug '{Slug}'", Slug);
            _errorMessage = "Lỗi không xác định khi gửi yêu cầu. Vui lòng thử lại.";
        }
    }

    private sealed class ClaimForm
    {
        public string ClaimantName { get; set; } = string.Empty;
        public string ClaimantPhone { get; set; } = string.Empty;
        public string? ClaimantEmail { get; set; }
        public string TaxCodeSubmitted { get; set; } = string.Empty;
    }
}
