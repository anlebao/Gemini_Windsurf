@page "/qr-info"
@using VanAn.KhachLink.Components.Layout

<PageTitle>Quét Mã QR - KhachLink</PageTitle>

<KhachLinkLayout>
    <VanAnCard CssClass="my-4">
        <div class="card-body text-center py-5">
            <h1 class="display-5 fw-bold mb-4">
                <i class="bi bi-qr-code text-primary"></i> Quét Mã QR
            </h1>
            <p class="lead mb-4">
                Quét mã QR sản phẩm để thêm nhanh vào giỏ hàng
            </p>
        </div>
    </VanAnCard>

    <VanAnCard CssClass="mb-4">
        <div class="card-body">
            <h5><i class="bi bi-info-circle text-primary"></i> Cách sử dụng</h5>
            <ol class="mt-3">
                <li class="mb-2">Mở ứng dụng camera trên điện thoại hoặc ứng dụng quét mã QR bất kỳ</li>
                <li class="mb-2">Quét mã QR được hiển thị tại cửa hàng</li>
                <li class="mb-2">Trình duyệt sẽ tự động mở KhachLink với sản phẩm đã được thêm vào giỏ hàng</li>
                <li class="mb-2">Kiểm tra giỏ hàng và tiến hành thanh toán</li>
            </ol>
        </div>
    </VanAnCard>

    <VanAnCard CssClass="mb-4">
        <div class="card-body">
            <h5><i class="bi bi-lightbulb text-warning"></i> Mẹo</h5>
            <ul class="mt-3">
                <li class="mb-2">Đảm bảo ánh sáng tốt khi quét mã QR</li>
                <li class="mb-2">Giữ điện thoại cách mã QR khoảng 10-20cm</li>
                <li class="mb-2">Nếu đã cài đặt KhachLink PWA, ứng dụng sẽ tự động mở</li>
                <li class="mb-2">Bạn có thể quét nhiều mã QR để thêm nhiều sản phẩm cùng lúc</li>
            </ul>
        </div>
    </VanAnCard>

    <VanAnCard CssClass="mb-4">
        <div class="card-body text-center">
            <h5><i class="bi bi-phone text-primary"></i> Chưa có ứng dụng?</h5>
            <p class="mt-2">Cài đặt KhachLink PWA để trải nghiệm tốt nhất</p>
            <VanAnButton Variant="ButtonVariant.Primary" Icon="download" OnClick="@(() => ShowPwaInstallPrompt())">
                Cài Đặt Ứng Dụng
            </VanAnButton>
        </div>
    </VanAnCard>
</KhachLinkLayout>

@code {
    private void ShowPwaInstallPrompt()
    {
        // This would trigger the PWA install prompt
        // For now, just navigate to home
        // In a real implementation, this would call the PWA install API
    }
}