@code {
    private VanAn.KhachLink.Services.CartState cartState = new();
    private bool _vatDisplayEnabled = true;

    protected override async Task OnInitializedAsync()
    {
        cartState = CartService.GetCartState();
        CartService.OnCartChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JSRuntime is only available after hydration (not during static prerender).
            // Load cart from localStorage here so items added on other pages persist.
            await CartService.LoadCartFromStorageAsync();
            // RC-7: Load VAT display toggle from shop settings.
            Guid tenantId = TenantService.GetCurrentTenantId();
            if (tenantId != Guid.Empty)
            {
                _vatDisplayEnabled = await FeatureSettings.IsEnabledAsync(tenantId, nameof(ShopFeatureSettingsDto.VAT_Display_Enabled));
            }
            StateHasChanged();
        }
    }

    private async Task UpdateQuantity(Guid productId, int quantity)
    {
        await CartService.UpdateQuantityAsync(productId, quantity);
    }

    private async Task RemoveItem(Guid productId)
    {
        await CartService.RemoveItemAsync(productId);
    }

    private async Task ClearCart()
    {
        await CartService.ClearCartAsync();
    }

    private void ProceedToCheckout()
    {
        Navigation.NavigateTo("/checkout");
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }
}
