@page "/disputes"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject SecurityHttpService SecurityHttp

<PageTitle>Khiếu nại &amp; tranh chấp</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width: 640px;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="mb-0"><i class="bi bi-chat-square-text text-primary"></i> Khiếu nại</h3>
            <VanAnButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small" OnClick="GoToNew">Tạo khiếu nại</VanAnButton>
        </div>
        <p class="text-muted small mb-4">
            Gửi khiếu nại về điểm thưởng, quyền lợi hoặc giao dịch. Đội ngũ sẽ xem xét và phản hồi qua trạng thái khiếu nại.
        </p>

        @if (_loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        }
        else if (!_isLoggedIn)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-lock text-muted" style="font-size:3rem;"></i>
                <h5 class="mt-3">Đăng nhập để xem khiếu nại</h5>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToLogin">Đăng nhập</VanAnButton>
            </VanAnCard>
        }
        else if (_cases is null)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-wifi-off text-muted" style="font-size:3rem;"></i>
                <h5 class="mt-3">Không tải được danh sách</h5>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="LoadAsync">Thử lại</VanAnButton>
            </VanAnCard>
        }
        else if (_cases.Count == 0)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-inbox text-muted" style="font-size:3rem;"></i>
                <h5 class="mt-3">Chưa có khiếu nại nào</h5>
                <p class="text-muted small">Khiếu nại về điểm thưởng hoặc quyền lợi sẽ xuất hiện ở đây.</p>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToNew">Tạo khiếu nại đầu tiên</VanAnButton>
            </VanAnCard>
        }
        else
        {
            var open = _cases.Where(c => !IsTerminal(c.Status)).ToList();
            var closed = _cases.Where(c => IsTerminal(c.Status)).ToList();

            @if (open.Count > 0)
            {
                <div class="fw-semibold text-muted small text-uppercase mb-2">Đang xử lý</div>
                @foreach (var c in open)
                {
                    @CaseCard(c)
                }
            }
            @if (closed.Count > 0)
            {
                <div class="fw-semibold text-muted small text-uppercase mb-2 mt-4">Đã kết thúc</div>
                @foreach (var c in closed)
                {
                    @CaseCard(c)
                }
            }
        }
    </div>
</KhachLinkLayout>

@code {
    private bool _loading = true;
    private bool _isLoggedIn;
    private string? _customerToken;
    private List<SecurityHttpService.DisputeCaseSummaryDto>? _cases;

    protected override async Task OnInitializedAsync()
    {
        _customerToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
        _isLoggedIn = !string.IsNullOrEmpty(_customerToken);
        if (_isLoggedIn)
            await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var items = await SecurityHttp.ListDisputesAsync(_customerToken!);
        _cases = items?.ToList();
        _loading = false;
    }

    private RenderFragment CaseCard(SecurityHttpService.DisputeCaseSummaryDto c) => __builder =>
    {
        <div class="card mb-2" @key="c.Id">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-semibold">@CaseTypeLabel(c.CaseType)</div>
                        <div class="text-muted small text-truncate" style="max-width: 320px;">@c.ClaimedIssue</div>
                        <div class="text-muted small">@c.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="text-end">
                        <span class="badge @StatusBadge(c.Status)">@StatusLabel(c.Status)</span>
                        <div><a href="/disputes/@c.Id" class="small">Chi tiết <i class="bi bi-chevron-right"></i></a></div>
                    </div>
                </div>
            </div>
        </div>
    };

    internal static bool IsTerminal(string status) => status is "RESOLVED" or "REJECTED" or "CLOSED";

    private void GoToNew() => Navigation.NavigateTo("/disputes/new");
    private void GoToLogin() => Navigation.NavigateTo("/login");

    internal static string CaseTypeLabel(string type) => type switch
    {
        "POINTS_MISSING" => "Thiếu điểm thưởng",
        "POINTS_EXCESS" => "Điểm thưởng bất thường",
        "POINTS_WRONG" => "Điểm thưởng sai",
        "WALLET_BENEFIT_WRONG" => "Quyền lợi/ví sai",
        "TRANSACTION_DENIED" => "Giao dịch bị từ chối",
        "POINTS_ADJUST_REFUND" => "Điều chỉnh/hoàn điểm",
        "ACCOUNT_TAKEOVER" => "Chiếm đoạt tài khoản",
        "LOST_DEVICE" => "Mất thiết bị",
        "OWNERSHIP_DISPUTE" => "Tranh chấp quyền sở hữu",
        "SYSTEM_DISCREPANCY" => "Sai lệch hệ thống",
        _ => type
    };

    internal static string StatusLabel(string status) => status switch
    {
        "OPEN" => "Mới",
        "TRIAGE" => "Đang phân loại",
        "WAITING_FOR_USER" => "Chờ bạn bổ sung",
        "UNDER_REVIEW" => "Đang xem xét",
        "WAITING_FOR_EXTERNAL_EVIDENCE" => "Chờ bằng chứng",
        "DECIDED" => "Đã có quyết định",
        "RESOLVED" => "Đã giải quyết",
        "REJECTED" => "Bị từ chối",
        "CLOSED" => "Đã đóng",
        _ => status
    };

    internal static string StatusBadge(string status) => status switch
    {
        "RESOLVED" => "text-bg-success",
        "REJECTED" or "CLOSED" => "text-bg-secondary",
        "WAITING_FOR_USER" or "WAITING_FOR_EXTERNAL_EVIDENCE" => "text-bg-warning",
        "UNDER_REVIEW" or "DECIDED" => "text-bg-info",
        _ => "text-bg-primary"
    };
}
