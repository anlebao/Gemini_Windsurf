@page "/order-tracking/{OrderId:guid}"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@using VanAn.KhachLink.Components
@using Microsoft.AspNetCore.SignalR.Client
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject CommunityHttpService CommunityHttp
@implements IAsyncDisposable

<PageTitle>Theo dõi đơn hàng</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width:700px;">
        <h3 class="mb-3">
            <i class="bi bi-geo-alt text-primary"></i> Theo dõi đơn hàng #@OrderId.ToString()[..8]
        </h3>

        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div>
            </div>
        }
        else if (_error != null)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-4">
                <i class="bi bi-exclamation-triangle text-warning" style="font-size:3rem;"></i>
                <h5 class="mt-3">@_error</h5>
            </VanAnCard>
        }
        else
        {
            <!-- Order status card (from PG source of truth) -->
            <VanAnCard Shadow="true" CssClass="mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Trạng thái đơn hàng</div>
                        <div class="fw-bold fs-5">
                            <span class="badge @GetOrderStatusBadgeClass(_orderStatus)">@GetOrderStatusText(_orderStatus)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(_tenantName))
                        {
                            <div class="text-muted small mt-1"><i class="bi bi-shop"></i> @_tenantName</div>
                        }
                    </div>
                    <div class="text-end">
                        @if (_isLiveTracking)
                        {
                            <div class="text-success small">
                                <span class="spinner-border spinner-border-sm"></span> Realtime
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">
                                <i class="bi bi-clock"></i> Cập nhật @_lastUpdate?.ToString("HH:mm:ss")
                            </div>
                        }
                    </div>
                </div>
                <!-- Progress timeline -->
                <div class="order-timeline mt-3">
                    @foreach (var step in _statusSteps)
                    {
                        <div class="timeline-step @(step.IsActive ? "active" : "") @(step.IsDone ? "done" : "")">
                            <div class="timeline-dot">
                                @if (step.IsDone) { <i class="bi bi-check-lg"></i> }
                                else if (step.IsActive) { <span class="spinner-border spinner-border-sm"></span> }
                                else { <i class="@step.Icon"></i> }
                            </div>
                            <div class="timeline-label">@step.Label</div>
                        </div>
                    }
                </div>
            </VanAnCard>

            <!-- #99-3: Loyalty points banner — shows when order completed/delivered + points awarded -->
            @if ((_orderStatus == "completed" || _orderStatus == "delivered") && _pointsAwarded > 0)
            {
                <VanAnCard Shadow="true" CssClass="mb-3 loyalty-points-banner" data-testid="loyalty-points-banner">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-gift-fill text-success fs-2 me-3"></i>
                        <div>
                            <div class="fw-bold text-success">Bạn đã nhận được @_pointsAwarded điểm thưởng!</div>
                            <div class="text-muted small">Điểm thưởng từ đơn hàng này đã được tích vào tài khoản của bạn.</div>
                        </div>
                        <a href="/my-loyalty" class="btn btn-sm btn-outline-success ms-auto">
                            <i class="bi bi-wallet2"></i> Xem điểm
                        </a>
                    </div>
                </VanAnCard>
            }

            <!-- Payment status card -->
            <VanAnCard Shadow="true" CssClass="mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Thanh toán</div>
                        <div class="fw-bold fs-5">
                            <span class="badge @GetPaymentBadgeClass(_paymentStatus)">@GetPaymentText(_paymentStatus)</span>
                        </div>
                    </div>
                    @if (_paymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase) ||
                         _paymentStatus.Equals("Confirmed", StringComparison.OrdinalIgnoreCase))
                    {
                        <i class="bi bi-check-circle-fill text-success" style="font-size:1.5rem;"></i>
                    }
                    else
                    {
                        <i class="bi bi-clock text-muted" style="font-size:1.5rem;"></i>
                    }
                </div>
            </VanAnCard>

            <!-- Delivery status card (from SignalR — shipper GPS) -->
            @if (_deliveryStatus != "Unknown" && _deliveryStatus != "Pending")
            {
                <VanAnCard Shadow="true" CssClass="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Trạng thái giao hàng</div>
                            <div class="fw-bold fs-5">
                                <span class="badge @GetDeliveryBadgeClass(_deliveryStatus)">@GetDeliveryText(_deliveryStatus)</span>
                            </div>
                        </div>
                        @if (_isLiveTracking)
                        {
                            <div class="text-success small">
                                <span class="spinner-border spinner-border-sm"></span> Đang theo dõi trực tiếp
                            </div>
                        }
                    </div>
                </VanAnCard>
            }

            <!-- Map -->
            @if (_showMap)
            {
                <VanAnCard Shadow="true" CssClass="mb-3 p-0 overflow-hidden">
                    <LeafletMap MapElementId="customer-tracking-map"
                                Height="400px"
                                CenterLat="_centerLat"
                                CenterLng="_centerLng"
                                Zoom="14"
                                ShopLat="_shopLat"
                                ShopLng="_shopLng"
                                CustomerLat="_customerLat"
                                CustomerLng="_customerLng"
                                ShipperLat="_shipperLat"
                                ShipperLng="_shipperLng" />
                </VanAnCard>
            }

            <!-- Order details -->
            <VanAnCard Shadow="true" CssClass="mb-3">
                @if (_orderTotal > 0)
                {
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-muted">Tổng tiền</span>
                        <span class="fw-bold text-primary">@FormatVND(_orderTotal)</span>
                    </div>
                }
                @if (_orderItemCount > 0)
                {
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-muted">Số sản phẩm</span>
                        <span>@_orderItemCount</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_deliveryAddress))
                {
                    <div class="mb-2"><i class="bi bi-geo-alt text-muted"></i> @_deliveryAddress</div>
                }
                @if (_lastUpdate != null)
                {
                    <div class="small text-muted">Cập nhật lần cuối: @_lastUpdate.Value.ToString("HH:mm:ss")</div>
                }
            </VanAnCard>

            <!-- Chat panel (CC-S3) -->
            @if (_customerId.HasValue)
            {
                <div class="mt-3">
                    <ChatPanel OrderId="OrderId" CurrentUserId="_customerId.Value" CustomerToken="_customerToken" ScrollContainerId="order-chat-scroll" />
                </div>
            }
        }
    </div>
</KhachLinkLayout>

<style>
    .order-timeline {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .timeline-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        min-width: 80px;
        opacity: 0.4;
        transition: opacity 0.3s;
    }
    .timeline-step.done, .timeline-step.active {
        opacity: 1;
    }
    .timeline-dot {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e9ecef;
        color: #6c757d;
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }
    .timeline-step.done .timeline-dot {
        background: #198754;
        color: white;
    }
    .timeline-step.active .timeline-dot {
        background: #0d6efd;
        color: white;
    }
    .timeline-label {
        font-size: 0.75rem;
        text-align: center;
        color: #6c757d;
    }
    .timeline-step.done .timeline-label, .timeline-step.active .timeline-label {
        color: #212529;
        font-weight: 500;
    }
</style>

@code {
    [Parameter] public Guid OrderId { get; set; }

    private bool _loading = true;
    private string? _error;
    private string? _customerToken;
    private Guid? _customerId;

    // Order status (from PG via polling — covers pending/preparing/ready/delivering/completed/cancelled)
    private string _orderStatus = "pending";
    private string _paymentStatus = "pending";
    private string _tenantName = string.Empty;
    // #99-3: Loyalty points awarded (from PublicOrderTrackingDto.PointsAwarded)
    private int? _pointsAwarded;
    private bool _loyaltyEnabled = true;
    private decimal _orderTotal;
    private int _orderItemCount;
    private string? _deliveryAddress;
    private DateTime? _lastUpdate;

    // Delivery status (from SignalR — covers shipper PickedUp/OutForDelivery/Delivered/Failed)
    private string _deliveryStatus = "Unknown";

    // Map state
    private bool _showMap = false;
    private bool _isLiveTracking = false;
    private double _centerLat = 10.8;
    private double _centerLng = 106.7;
    private double? _shopLat;
    private double? _shopLng;
    private double? _customerLat;
    private double? _customerLng;
    private double? _shipperLat;
    private double? _shipperLng;

    private HubConnection? _hubConnection;
    private System.Threading.CancellationTokenSource? _pollingCts;

    // Status timeline steps
    private List<StatusStep> _statusSteps = new();

    protected override async Task OnInitializedAsync()
    {
        // FIX: Use canonical localStorage key "customer_token" (matches Login.razor)
        _customerToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");

        // Load CustomerId for ChatPanel
        if (!string.IsNullOrEmpty(_customerToken))
            _customerId = await CommunityHttp.GetCustomerIdAsync(_customerToken);

        try
        {
            await LoadOrderStatusAsync();
            await LoadOrderInfoAsync();
            await StartSignalRConnectionAsync();
            StartPolling();
        }
        catch (Exception)
        {
            if (_orderStatus == "pending" && string.IsNullOrEmpty(_tenantName))
                _error = "Không thể tải thông tin đơn hàng.";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Fetch order status from Gateway PG (source of truth) via GET /api/public/orders/{id}.
    /// No auth required — customer knows their own order ID.
    /// </summary>
    private async Task LoadOrderStatusAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("gateway");
            var resp = await client.GetAsync($"/api/public/orders/{OrderId}");
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<PublicOrderTrackingDto>();
                if (dto != null)
                {
                    _orderStatus = dto.Status ?? "pending";
                    _paymentStatus = (dto.PaymentStatus ?? "pending");
                    _tenantName = dto.TenantName ?? string.Empty;
                    _orderTotal = dto.TotalPrice;
                    _orderItemCount = dto.ItemCount;
                    // #99-3: Parse loyalty points awarded + tenant loyalty flag
                    _pointsAwarded = dto.PointsAwarded;
                    _loyaltyEnabled = dto.LoyaltyEnabled;
                    _lastUpdate = DateTime.Now;
                    UpdateStatusSteps();
                    StateHasChanged();
                }
            }
        }
        catch
        {
            // Non-fatal — polling will retry
        }
    }

    private async Task LoadOrderInfoAsync()
    {
        // Load delivery-specific info (GPS coordinates, address) from nearby orders
        if (string.IsNullOrEmpty(_customerToken))
            return;

        try
        {
            var pos = await JSRuntime.InvokeAsync<GeoPosition?>("vananPWA.getCurrentPosition");
            if (pos == null) return;

            var result = await CommunityHttp.GetNearbyOrdersAsync(_customerToken, pos.Lat, pos.Lng, 50);
            if (result.Success)
            {
                var order = result.Orders.FirstOrDefault(o => o.OrderId == OrderId);
                if (order != null)
                {
                    _deliveryAddress = order.DeliveryAddress;
                    _shopLat = order.ShopLat;
                    _shopLng = order.ShopLng;
                    _customerLat = order.DeliveryLat;
                    _customerLng = order.DeliveryLng;
                    _centerLat = _shopLat ?? pos.Lat;
                    _centerLng = _shopLng ?? pos.Lng;
                    _showMap = true;
                }
            }
        }
        catch
        {
            // GPS/delivery info is optional — order status still works
        }
    }

    private async Task StartSignalRConnectionAsync()
    {
        if (string.IsNullOrEmpty(_customerToken)) return;

        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var hubUrl = $"{baseUrl}/hubs/location?customerToken={_customerToken}";

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<string, double, double, string>("LocationUpdate", (taskId, lat, lng, recordedAt) =>
            {
                _shipperLat = lat;
                _shipperLng = lng;
                _isLiveTracking = true;
                _lastUpdate = DateTime.Now;
                StateHasChanged();
            });

            _hubConnection.On<string, string, string>("DeliveryStatusUpdate", (orderId, status, timestamp) =>
            {
                _deliveryStatus = status;
                _lastUpdate = DateTime.Now;
                if (status == "Delivered" || status == "Failed")
                    _isLiveTracking = false;
                StateHasChanged();
            });

            // #98 fix: Listen for order status updates pushed from Gateway OrderNotificationService
            // (was previously only updated via 15s polling — caused "stale status" flicker for customers)
            _hubConnection.On<object>("OrderStatusUpdated", (payload) =>
            {
                try
                {
                    // Payload is anonymous object { orderId, oldStatus, newStatus, timestamp }
                    var json = System.Text.Json.JsonSerializer.Serialize(payload);
                    var dto = System.Text.Json.JsonSerializer.Deserialize<OrderStatusUpdatePayload>(json);
                    if (dto != null && !string.IsNullOrEmpty(dto.newStatus))
                    {
                        _orderStatus = dto.newStatus;
                        _lastUpdate = DateTime.Now;
                        UpdateStatusSteps();
                        StateHasChanged();
                    }
                }
                catch { /* ignore malformed payload */ }
            });

            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("JoinOrderTracking", OrderId.ToString());
            _isLiveTracking = true;
        }
        catch (Exception)
        {
            // SignalR connection failure is non-fatal — polling covers order status
        }
    }

    /// <summary>
    /// Poll order status every 15 seconds as realtime fallback.
    /// Covers shop owner status changes (confirm/preparing/ready) that SignalR DeliveryStatusUpdate doesn't emit.
    /// </summary>
    private void StartPolling()
    {
        _pollingCts = new System.Threading.CancellationTokenSource();
        var token = _pollingCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(15), token);
                    await LoadOrderStatusAsync();
                }
                catch (TaskCanceledException) { break; }
                catch { /* continue polling */ }
            }
        }, token);
    }

    private void UpdateStatusSteps()
    {
        var steps = new List<(string Key, string Label, string Icon)>
        {
            ("pending", "Đã đặt", "bi-bag-check"),
            ("preparing", "Đang làm", "bi-fire"),
            ("ready", "Sẵn sàng", "bi-bag"),
            ("delivering", "Đang giao", "bi-truck"),
            ("completed", "Hoàn thành", "bi-check-circle"),
        };

        var orderSteps = new List<StatusStep>();
        var foundActive = false;
        foreach (var (key, label, icon) in steps)
        {
            var isDone = IsStatusDone(_orderStatus, key);
            var isActive = !isDone && !foundActive && IsStatusActiveOrPast(_orderStatus, key);
            if (isActive) foundActive = true;
            orderSteps.Add(new StatusStep { Label = label, Icon = icon, IsDone = isDone, IsActive = isActive });
        }

        // Cancelled overrides all
        if (_orderStatus == "cancelled")
        {
            orderSteps.Clear();
            orderSteps.Add(new StatusStep { Label = "Đã hủy", Icon = "bi-x-circle", IsDone = true, IsActive = false });
        }

        _statusSteps = orderSteps;
    }

    private static bool IsStatusDone(string current, string step) =>
        current == "completed" && step != "completed" ? true :
        StatusOrder(current) > StatusOrder(step) && current != "cancelled";

    private static bool IsStatusActiveOrPast(string current, string step) =>
        StatusOrder(current) >= StatusOrder(step) && current != "cancelled";

    private static int StatusOrder(string s) => s switch
    {
        "pending" => 0,
        "preparing" => 1,
        "ready" => 2,
        "delivering" => 3,
        "completed" => 4,
        "cancelled" => -1,
        _ => 0
    };

    public async ValueTask DisposeAsync()
    {
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();

        if (_hubConnection != null)
        {
            try
            {
                await _hubConnection.InvokeAsync("LeaveOrderTracking", OrderId.ToString());
                await _hubConnection.DisposeAsync();
            }
            catch { }
        }
    }

    private string GetOrderStatusBadgeClass(string status) => status switch
    {
        "pending" => "bg-warning text-dark",
        "preparing" => "bg-info text-dark",
        "ready" => "bg-primary",
        "delivering" => "bg-primary",
        "completed" => "bg-success",
        "cancelled" => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetOrderStatusText(string status) => status switch
    {
        "pending" => "Đang chờ xử lý",
        "preparing" => "Đang chuẩn bị",
        "ready" => "Sẵn sàng giao",
        "delivering" => "Đang giao hàng",
        "completed" => "Hoàn thành",
        "cancelled" => "Đã hủy",
        _ => "Đang chờ"
    };

    private string GetDeliveryBadgeClass(string status) => status switch
    {
        "Assigned" => "bg-secondary",
        "PickedUp" => "bg-info text-dark",
        "OutForDelivery" => "bg-primary",
        "Delivered" => "bg-success",
        "Failed" => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetDeliveryText(string status) => status switch
    {
        "Assigned" => "Shipper đã nhận đơn",
        "PickedUp" => "Đã lấy hàng",
        "OutForDelivery" => "Đang giao hàng",
        "Delivered" => "Đã giao thành công",
        "Failed" => "Giao thất bại",
        _ => "Đang chờ"
    };

    private string GetPaymentBadgeClass(string status) => status?.ToLowerInvariant() switch
    {
        "paid" => "bg-success",
        "confirmed" => "bg-success",
        "pending" => "bg-warning text-dark",
        "failed" => "bg-danger",
        "refunded" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private string GetPaymentText(string status) => status?.ToLowerInvariant() switch
    {
        "paid" => "Đã thanh toán",
        "confirmed" => "Đã thanh toán",
        "pending" => "Chờ thanh toán",
        "failed" => "Thanh toán thất bại",
        "refunded" => "Đã hoàn tiền",
        _ => "Chờ thanh toán"
    };

    private static string FormatVND(decimal amount) => $"{amount:N0} ₫";

    private class GeoPosition
    {
        public double Lat { get; set; }
        public double Lng { get; set; }
    }

    private class StatusStep
    {
        public string Label { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool IsDone { get; set; }
        public bool IsActive { get; set; }
    }

    // #98 fix: Payload from Gateway OrderNotificationService.NotifyOrderStatusChangedAsync
    // (broadcast via LocationHub "OrderStatusUpdated" event)
    private class OrderStatusUpdatePayload
    {
        public Guid orderId { get; set; }
        public string? oldStatus { get; set; }
        public string? newStatus { get; set; }
        public DateTime timestamp { get; set; }
    }

    private class PublicOrderTrackingDto
    {
        public Guid OrderId { get; set; }
        public string Status { get; set; } = "pending";
        public string PaymentStatus { get; set; } = "pending";
        public DateTime CreatedAt { get; set; }
        public decimal TotalPrice { get; set; }
        public decimal SubTotal { get; set; }
        public decimal TotalVatAmount { get; set; }
        public int ItemCount { get; set; }
        public Guid TenantId { get; set; }
        public string TenantName { get; set; } = "";
        // #99-3: Loyalty points awarded + tenant loyalty enabled flag
        public int? PointsAwarded { get; set; }
        public bool LoyaltyEnabled { get; set; } = true;
    }
}
