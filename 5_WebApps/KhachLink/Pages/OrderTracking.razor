@page "/order-tracking/{orderId:guid}"
@using VanAn.Shared.DTOs
@using VanAn.KhachLink.Components
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>KhachLink - Theo dõi đơn hàng</PageTitle>

<!-- Identity Upgrade Modal — only shown when order is delivered (end of order flow) -->
<IdentityUpgradeModal ShowModal="@_showUpgradeModal"
                      ShopConfig="@null"
                      OnDismiss="@DismissUpgradeModal"
                      OnUpgrade="@GoToLogin" />

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }
    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }
    .timeline-marker {
        position: absolute;
        left: -30px;
        top: 5px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        background: white;
        border: 2px solid #dee2e6;
    }
    .timeline-content {
        margin-left: 10px;
    }
    .timeline-item.completed .timeline-marker {
        background: #28a745;
        border-color: #28a745;
        color: white;
    }
    .timeline-item.pending .timeline-marker {
        background: #6c757d;
        border-color: #6c757d;
        color: white;
    }
    .order-info {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        font-size: 14px;
    }
</style>

<!-- T-02d: .order-tracking container — required by E2E spec selector contract -->
<div class="container order-tracking" data-testid="order-tracking-container">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (isLoading)
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="mt-3">Đang tải thông tin đơn hàng...</p>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="card">
                    <div class="card-body">
                        <div class="alert alert-warning not-found" data-testid="order-tracking-not-found">
                            <h5>❌ Không tìm thấy đơn hàng</h5>
                            <p>Mã đơn hàng <strong>@orderId.ToString()[..8]…</strong> không tồn tại trong hệ thống.</p>
                            <p class="text-muted small">@errorMessage</p>
                            <a href="/home" class="btn btn-primary" data-testid="order-tracking-btn-back-home">Quay lại trang chủ</a>
                        </div>
                    </div>
                </div>
            }
            else if (_publicOrder != null)
            {
                <div class="card">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h4 class="mb-0" data-testid="order-tracking-heading">📋 Theo dõi đơn hàng #@orderId.ToString()[..8]</h4>
                        @if (isPolling && isTabVisible)
                        {
                            <div class="spinner-border spinner-border-sm text-light" role="status" title="Đang cập nhật...">
                                <span class="visually-hidden">Đang cập nhật...</span>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <h5>Trạng thái đơn hàng</h5>

                                <!-- Status Timeline -->
                                <div class="timeline status-timeline" data-testid="order-tracking-timeline">
                                    @foreach (var step in statusTimeline)
                                    {
                                        <div class="timeline-item @(step.IsCompleted ? "completed" : "pending")">
                                            <div class="timeline-marker">
                                                @if (step.IsCompleted)
                                                {
                                                    <span>✅</span>
                                                }
                                                else
                                                {
                                                    <span>⏳</span>
                                                }
                                            </div>
                                            <div class="timeline-content">
                                                <h6>@step.DisplayName</h6>
                                                @if (step.Timestamp.HasValue)
                                                {
                                                    <small class="text-muted">@step.Timestamp.Value.ToString("HH:mm dd/MM/yyyy")</small>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-md-4">
                                <h5>Thông tin đơn hàng</h5>
                                <div class="order-info">
                                    <p><strong>Mã đơn:</strong> #@_publicOrder.OrderId.ToString()[..8]</p>
                                    <p><strong>Trạng thái:</strong>
                                        <span class="badge bg-@GetStatusColor(_publicOrder.Status ?? "")" data-testid="order-tracking-status">
                                            @(_publicOrder.Status ?? "—")
                                        </span>
                                    </p>
                                    <p><strong>Ngày đặt:</strong> @_publicOrder.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                    <p><strong>Tổng tiền:</strong> @_publicOrder.TotalPrice.ToString("N0")đ</p>
                                </div>

                                <div class="mt-3">
                                    <h6>Chi tiết đơn hàng</h6>
                                    <ul class="list-group">
                                        @foreach (var item in _publicOrder.Items)
                                        {
                                            <li class="list-group-item d-flex justify-content-between">
                                                <span>@item.Quantity × @item.UnitPrice.ToString("N0")đ</span>
                                                <span class="text-muted">@item.TotalPrice.ToString("N0")đ</span>
                                            </li>
                                        }
                                    </ul>
                                </div>

                                <div class="mt-3">
                                    <a href="/home" class="btn btn-outline-primary w-100" data-testid="order-tracking-btn-back-home-success">
                                        Quay lại trang chủ
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body">
                        <div class="alert alert-warning not-found">
                            <h5>❌ Không tìm thấy đơn hàng</h5>
                            <p>Đơn hàng không tồn tại hoặc đã bị xóa.</p>
                            <a href="/home" class="btn btn-primary">Quay lại trang chủ</a>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@code {
    [Parameter] public Guid orderId { get; set; }

    private PublicOrderTrackingDto? _publicOrder;
    private List<TrackingStep> statusTimeline = new();
    private bool isLoading = true;
    private string? errorMessage;
    
    // Wave 9/W4: Polling infrastructure for real-time order status updates
    // W4: Replaced PeriodicTimer with Task.Delay loop for adaptive interval control
    private CancellationTokenSource? _pollingCts;
    private bool isPolling = false;
    private bool isTabVisible = true;
    private bool _pollingStopped = false; // W4: stops polling when order reaches final state

    // IdentityUpgradeModal — only shown when order reaches "delivered" status
    private bool _showUpgradeModal = false;
    private bool _hasShownUpgradeModal = false;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        await LoadOrderFromGateway();
        BuildStatusTimeline();
        isLoading = false;

        // Check if order is already delivered on initial load
        CheckOrderDelivered();
        
        // Wave 9: Start polling after initial load
        StartPolling();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // No additional setup needed - visibility is checked in polling loop
        await Task.CompletedTask;
    }

    // Wave 9: IAsyncDisposable implementation for proper cleanup
    public async ValueTask DisposeAsync()
    {
        StopPolling();
        if (_pollingCts != null)
        {
            await _pollingCts.CancelAsync();
            _pollingCts.Dispose();
        }
    }

    // T-02d: Call Gateway public API (no auth required) — W6/Bucket D
    private async Task LoadOrderFromGateway()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("gateway");
            var response = await httpClient.GetAsync($"api/public/orders/{orderId}");

            if (response.IsSuccessStatusCode)
            {
                _publicOrder = await response.Content.ReadFromJsonAsync<PublicOrderTrackingDto>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = $"Order {orderId} not found (404)";
            }
            else
            {
                errorMessage = $"Lỗi tải đơn hàng: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể kết nối đến máy chủ: {ex.Message}";
        }
    }

    private void BuildStatusTimeline()
    {
        var allSteps = new[]
        {
            new { Id = "pending",    DisplayName = "Chờ xác nhận",  Sequence = 1 },
            new { Id = "confirmed",  DisplayName = "Đã xác nhận",   Sequence = 2 },
            new { Id = "processing", DisplayName = "Đang pha chế",  Sequence = 3 },
            new { Id = "ready",      DisplayName = "Sẵn sàng",      Sequence = 4 },
            new { Id = "delivered",  DisplayName = "Đã giao",       Sequence = 5 },
        };

        string currentStatusId = _publicOrder?.Status ?? "pending";
        int currentSeq = Array.FindIndex(allSteps, s => s.Id == currentStatusId) + 1;
        if (currentSeq == 0) currentSeq = 1;

        statusTimeline = allSteps.Select(s => new TrackingStep
        {
            Id          = s.Id,
            DisplayName = s.DisplayName,
            IsCompleted = s.Sequence <= currentSeq,
            Timestamp   = s.Sequence <= currentSeq ? DateTime.UtcNow.AddMinutes(-(currentSeq - s.Sequence) * 5) : null,
        }).ToList();
    }

    private static string GetStatusColor(string status) => status switch
    {
        "pending"    => "warning",
        "confirmed"  => "info",
        "processing" => "primary",
        "ready"      => "success",
        "delivered"  => "success",
        "cancelled"  => "danger",
        _            => "secondary",
    };

    private record TrackingStep
    {
        public string Id          { get; init; } = "";
        public string DisplayName { get; init; } = "";
        public bool   IsCompleted { get; init; }
        public DateTime? Timestamp { get; init; }
    }

    // Wave 9/W4: Polling methods for real-time order status updates
    private void StartPolling()
    {
        if (_pollingCts != null) return; // Prevent duplicate polling loops

        _pollingCts = new CancellationTokenSource();
        _pollingStopped = false;
        isPolling = true;

        _ = Task.Run(async () => await PollingLoopAsync(_pollingCts.Token));
    }

    private void StopPolling()
    {
        isPolling = false;
        _pollingCts?.Cancel();
    }

    /// <summary>
    /// W4: Adaptive polling loop — interval changes based on order status.
    /// pending/ready = 5s (need fast updates), confirmed/preparing = 10s (stable),
    /// completed/delivered/cancelled = STOP (no more requests).
    /// </summary>
    private async Task PollingLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested && !_pollingStopped)
            {
                // W4: Adaptive interval based on current order status
                int intervalSeconds = GetPollingInterval(_publicOrder?.Status);

                if (intervalSeconds == 0)
                {
                    // Final state reached — stop polling entirely
                    _pollingStopped = true;
                    isPolling = false;
                    break;
                }

                await Task.Delay(TimeSpan.FromSeconds(intervalSeconds), cancellationToken);

                if (cancellationToken.IsCancellationRequested || _pollingStopped) break;

                // Check visibility using JS interop for battery-friendly polling
                var isVisible = await CheckTabVisibilityAsync();
                if (!isVisible) continue; // Skip polling when tab is hidden

                await InvokeAsync(async () =>
                {
                    await PollOrderStatusAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Expected during shutdown
        }
        catch (Exception ex)
        {
            // Log polling errors but don't crash the component
            Console.WriteLine($"Polling error: {ex.Message}");
        }
    }

    /// <summary>
    /// W4: Adaptive polling interval — poll faster when status is about to change, slower when stable.
    /// Returns 0 to signal "stop polling" for final states.
    /// </summary>
    private static int GetPollingInterval(string? status) => status switch
    {
        "pending"   => 5,   // Chờ xác nhận — khách đang chờ, cần update nhanh
        "confirmed" => 10,  // Đã xác nhận — đang chuẩn bị, ít thay đổi
        "preparing" => 10,  // Đang làm — ít thay đổi
        "processing" => 10, // Đang pha chế — ít thay đổi
        "ready"     => 5,   // Sẵn sàng — khách cần biết ngay
        "completed" => 0,   // Hoàn thành — STOP polling
        "delivered" => 0,   // Đã giao — STOP polling
        "cancelled" => 0,   // Đã hủy — STOP polling
        _           => 5    // Unknown — default 5s
    };

    private async Task<bool> CheckTabVisibilityAsync()
    {
        try
        {
            var isVisible = await JS.InvokeAsync<bool>("eval", "document.visibilityState === 'visible'");
            return isVisible;
        }
        catch
        {
            // Fallback to assuming visible if JS interop fails
            return true;
        }
    }

    private async Task PollOrderStatusAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("gateway");
            // W6/Bucket D: Poll the public tracking endpoint (no auth required).
            var response = await httpClient.GetAsync($"api/public/orders/{orderId}");

            if (response.IsSuccessStatusCode)
            {
                var freshOrder = await response.Content.ReadFromJsonAsync<PublicOrderTrackingDto>();
                if (freshOrder != null && _publicOrder != null && _publicOrder.Status != freshOrder.Status)
                {
                    // Status changed, reload full order data
                    _publicOrder = freshOrder;
                    BuildStatusTimeline();

                    // Show IdentityUpgradeModal when order is delivered (end of order flow)
                    CheckOrderDelivered();

                    // W4: Stop polling when order reaches final state
                    if (freshOrder.Status is "completed" or "delivered" or "cancelled")
                    {
                        _pollingStopped = true;
                        isPolling = false;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            // Silent fail for polling errors - don't disrupt user experience
            Console.WriteLine($"Polling order status error: {ex.Message}");
        }
    }

    /// <summary>
    /// Show IdentityUpgradeModal only when order reaches "delivered" status.
    /// This ensures the modal does NOT block the order flow — it appears at the very end.
    /// </summary>
    private void CheckOrderDelivered()
    {
        if (_publicOrder?.Status == "delivered" && !_hasShownUpgradeModal)
        {
            _showUpgradeModal = true;
            _hasShownUpgradeModal = true;
        }
    }

    private void DismissUpgradeModal()
    {
        _showUpgradeModal = false;
    }

    private void GoToLogin()
    {
        _showUpgradeModal = false;
        Navigation.NavigateTo("/login");
    }
}

