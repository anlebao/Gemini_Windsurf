@page "/order-tracking/{orderId:guid}"
@using VanAn.Shared.Domain
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>KhachLink - Theo dõi đơn hàng</PageTitle>

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }
    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }
    .timeline-marker {
        position: absolute;
        left: -30px;
        top: 5px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        background: white;
        border: 2px solid #dee2e6;
    }
    .timeline-content {
        margin-left: 10px;
    }
    .timeline-item.completed .timeline-marker {
        background: #28a745;
        border-color: #28a745;
        color: white;
    }
    .timeline-item.pending .timeline-marker {
        background: #6c757d;
        border-color: #6c757d;
        color: white;
    }
    .order-info {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        font-size: 14px;
    }
</style>

<!-- T-02d: .order-tracking container — required by E2E spec selector contract -->
<div class="container order-tracking">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (isLoading)
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="mt-3">Đang tải thông tin đơn hàng...</p>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="card">
                    <div class="card-body">
                        <div class="alert alert-warning not-found">
                            <h5>❌ Không tìm thấy đơn hàng</h5>
                            <p>Mã đơn hàng <strong>@orderId.ToString()[..8]…</strong> không tồn tại trong hệ thống.</p>
                            <p class="text-muted small">@errorMessage</p>
                            <a href="/home" class="btn btn-primary">Quay lại trang chủ</a>
                        </div>
                    </div>
                </div>
            }
            else if (order != null)
            {
                <div class="card">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">📋 Theo dõi đơn hàng #@orderId.ToString()[..8]</h4>
                        @if (isPolling && isTabVisible)
                        {
                            <div class="spinner-border spinner-border-sm text-light" role="status" title="Đang cập nhật...">
                                <span class="visually-hidden">Đang cập nhật...</span>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <h5>Trạng thái đơn hàng</h5>

                                <!-- Status Timeline -->
                                <div class="timeline status-timeline">
                                    @foreach (var step in statusTimeline)
                                    {
                                        <div class="timeline-item @(step.IsCompleted ? "completed" : "pending")">
                                            <div class="timeline-marker">
                                                @if (step.IsCompleted)
                                                {
                                                    <span>✅</span>
                                                }
                                                else
                                                {
                                                    <span>⏳</span>
                                                }
                                            </div>
                                            <div class="timeline-content">
                                                <h6>@step.DisplayName</h6>
                                                @if (step.Timestamp.HasValue)
                                                {
                                                    <small class="text-muted">@step.Timestamp.Value.ToString("HH:mm dd/MM/yyyy")</small>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-md-4">
                                <h5>Thông tin đơn hàng</h5>
                                <div class="order-info">
                                    <p><strong>Mã đơn:</strong> #@order.Id.ToString()[..8]</p>
                                    <p><strong>Trạng thái:</strong>
                                        <span class="badge bg-@GetStatusColor(order.Status?.Value ?? "")">
                                            @(order.Status?.Value ?? "—")
                                        </span>
                                    </p>
                                    <p><strong>Ngày đặt:</strong> @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                    <p><strong>Tổng tiền:</strong> @order.TotalPrice.ToString("N0")đ</p>
                                </div>

                                <div class="mt-3">
                                    <h6>Chi tiết đơn hàng</h6>
                                    <ul class="list-group">
                                        @foreach (var item in order.Items)
                                        {
                                            <li class="list-group-item d-flex justify-content-between">
                                                <span>@item.Quantity × @item.UnitPrice.ToString("N0")đ</span>
                                                <span class="text-muted">@item.TotalPrice.ToString("N0")đ</span>
                                            </li>
                                        }
                                    </ul>
                                </div>

                                <div class="mt-3">
                                    <a href="/home" class="btn btn-outline-primary w-100">
                                        Quay lại trang chủ
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body">
                        <div class="alert alert-warning not-found">
                            <h5>❌ Không tìm thấy đơn hàng</h5>
                            <p>Đơn hàng không tồn tại hoặc đã bị xóa.</p>
                            <a href="/home" class="btn btn-primary">Quay lại trang chủ</a>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@code {
    [Parameter] public Guid orderId { get; set; }

    private Order? order;
    private List<TrackingStep> statusTimeline = new();
    private bool isLoading = true;
    private string? errorMessage;
    
    // Wave 9: Polling infrastructure for real-time order status updates
    private PeriodicTimer? _pollingTimer;
    private CancellationTokenSource? _pollingCts;
    private bool isPolling = false;
    private bool isTabVisible = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        await LoadOrderFromGateway();
        BuildStatusTimeline();
        isLoading = false;
        
        // Wave 9: Start polling after initial load
        StartPolling();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // No additional setup needed - visibility is checked in polling loop
        await Task.CompletedTask;
    }

    // Wave 9: IAsyncDisposable implementation for proper cleanup
    public async ValueTask DisposeAsync()
    {
        StopPolling();
        if (_pollingCts != null)
        {
            await _pollingCts.CancelAsync();
            _pollingCts.Dispose();
        }
        _pollingTimer?.Dispose();
    }

    // T-02d: Call Gateway API instead of simulated data
    private async Task LoadOrderFromGateway()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("gateway");
            var response = await httpClient.GetAsync($"api/orders/{orderId}");

            if (response.IsSuccessStatusCode)
            {
                order = await response.Content.ReadFromJsonAsync<Order>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = $"Order {orderId} not found (404)";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                  || response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                // Auth not set up on KhachLink — show order not found gracefully
                errorMessage = $"Không thể xác thực yêu cầu (status {(int)response.StatusCode})";
            }
            else
            {
                errorMessage = $"Lỗi tải đơn hàng: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể kết nối đến máy chủ: {ex.Message}";
        }
    }

    private void BuildStatusTimeline()
    {
        var allSteps = new[]
        {
            new { Id = "pending",    DisplayName = "Chờ xác nhận",  Sequence = 1 },
            new { Id = "confirmed",  DisplayName = "Đã xác nhận",   Sequence = 2 },
            new { Id = "processing", DisplayName = "Đang pha chế",  Sequence = 3 },
            new { Id = "ready",      DisplayName = "Sẵn sàng",      Sequence = 4 },
            new { Id = "delivered",  DisplayName = "Đã giao",       Sequence = 5 },
        };

        string currentStatusId = order?.Status?.Value ?? "pending";
        int currentSeq = Array.FindIndex(allSteps, s => s.Id == currentStatusId) + 1;
        if (currentSeq == 0) currentSeq = 1;

        statusTimeline = allSteps.Select(s => new TrackingStep
        {
            Id          = s.Id,
            DisplayName = s.DisplayName,
            IsCompleted = s.Sequence <= currentSeq,
            Timestamp   = s.Sequence <= currentSeq ? DateTime.UtcNow.AddMinutes(-(currentSeq - s.Sequence) * 5) : null,
        }).ToList();
    }

    private static string GetStatusColor(string status) => status switch
    {
        "pending"    => "warning",
        "confirmed"  => "info",
        "processing" => "primary",
        "ready"      => "success",
        "delivered"  => "success",
        "cancelled"  => "danger",
        _            => "secondary",
    };

    private record TrackingStep
    {
        public string Id          { get; init; } = "";
        public string DisplayName { get; init; } = "";
        public bool   IsCompleted { get; init; }
        public DateTime? Timestamp { get; init; }
    }

    // Wave 9: Polling methods for real-time order status updates
    private void StartPolling()
    {
        if (_pollingTimer != null) return; // Prevent duplicate timers
        
        _pollingCts = new CancellationTokenSource();
        _pollingTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        isPolling = true;
        
        _ = Task.Run(async () => await PollingLoopAsync(_pollingCts.Token));
    }

    private void StopPolling()
    {
        isPolling = false;
        _pollingCts?.Cancel();
        _pollingTimer?.Dispose();
        _pollingTimer = null;
    }

    private async Task PollingLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _pollingTimer!.WaitForNextTickAsync(cancellationToken))
            {
                // Check visibility using JS interop for battery-friendly polling
                var isVisible = await CheckTabVisibilityAsync();
                if (!isVisible) continue; // Skip polling when tab is hidden
                
                await InvokeAsync(async () => 
                {
                    await PollOrderStatusAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Expected during shutdown
        }
        catch (Exception ex)
        {
            // Log polling errors but don't crash the component
            Console.WriteLine($"Polling error: {ex.Message}");
        }
    }

    private async Task<bool> CheckTabVisibilityAsync()
    {
        try
        {
            var isVisible = await JS.InvokeAsync<bool>("eval", "document.visibilityState === 'visible'");
            return isVisible;
        }
        catch
        {
            // Fallback to assuming visible if JS interop fails
            return true;
        }
    }

    private async Task PollOrderStatusAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("gateway");
            var response = await httpClient.GetAsync($"api/customerorders/{orderId}/status");

            if (response.IsSuccessStatusCode)
            {
                var statusData = await response.Content.ReadFromJsonAsync<OrderStatusDto>();
                if (statusData != null && order != null && order.Status?.Value != statusData.Status)
                {
                    // Status changed, reload full order data
                    await LoadOrderFromGateway();
                    BuildStatusTimeline();
                }
            }
        }
        catch (Exception ex)
        {
            // Silent fail for polling errors - don't disrupt user experience
            Console.WriteLine($"Polling order status error: {ex.Message}");
        }
    }

    private record OrderStatusDto
    {
        public Guid OrderId { get; init; }
        public string Status { get; init; } = string.Empty;
    }
}
