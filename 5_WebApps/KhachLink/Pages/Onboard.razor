@page "/onboard"
@implements IAsyncDisposable
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@using VanAn.Shared.Domain
@using Microsoft.JSInterop
@inject MerchantSignupHttpService SignupService
@inject ImageUploadService ImageUpload
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Onboard> Logger

<PageTitle>Đăng ký cửa hàng — Vạn An</PageTitle>

<KhachLinkLayout>
<div class="onboard-wizard">
    @if (_closed)
    {
        <VanAnCard Shadow="true" CssClass="text-center p-5">
            <i class="bi bi-shop-window text-muted" style="font-size:3rem;"></i>
            <h4 class="mt-3">Đăng ký tự phục vụ tạm đóng</h4>
            <p class="text-muted">Kênh đăng ký trực tuyến đang tạm ngưng. Vui lòng liên hệ đội ngũ Vạn An để được hỗ trợ.</p>
            <VanAnButton Variant="ButtonVariant.Primary" OnClick="@(() => Navigation.NavigateTo("/"))">
                <i class="bi bi-house me-1"></i> Về trang chủ
            </VanAnButton>
        </VanAnCard>
    }
    else
    {
        <!-- Stepper -->
        <div class="ocr-wizard-steps">
            <span class="@StepClass(0)">1. Loại hình</span>
            <span class="ocr-step-sep">→</span>
            <span class="@StepClass(1)">2. Giấy tờ</span>
            <span class="ocr-step-sep">→</span>
            <span class="@StepClass(2)">3. Biển hiệu + Menu</span>
            <span class="ocr-step-sep">→</span>
            <span class="@StepClass(3)">4. Vị trí</span>
            <span class="ocr-step-sep">→</span>
            <span class="@StepClass(4)">5. Tài khoản</span>
            <span class="ocr-step-sep">→</span>
            <span class="@StepClass(5)">6. Xác nhận</span>
        </div>

        @if (!string.IsNullOrEmpty(_alertMessage))
        {
            <VanAnAlert Variant="@AlertVariant" Message="@_alertMessage" Dismissible="true" />
        }

        @switch (_step)
        {
            case 0:
                <div class="ocr-case-cards">
                    <button type="button" class="ocr-case-card @(_case == MerchantSignupCase.CompanyWithLicense ? "selected" : "")"
                            @onclick="() => SelectCase(MerchantSignupCase.CompanyWithLicense)">
                        <div class="ocr-case-title">📄 Tôi có giấy phép kinh doanh</div>
                        <div class="ocr-case-desc">Chụp giấy phép kinh doanh để hệ thống điền thông tin tự động — nhanh và chính xác nhất.</div>
                    </button>
                    <button type="button" class="ocr-case-card @(_case == MerchantSignupCase.SmallShopNoLicense ? "selected" : "")"
                            @onclick="() => SelectCase(MerchantSignupCase.SmallShopNoLicense)">
                        <div class="ocr-case-title">🏪 Tôi có cửa hàng, chưa có giấy phép</div>
                        <div class="ocr-case-desc">Chụp biển hiệu + menu — điền tên, địa chỉ và chọn nhóm thuế (đội ngũ sẽ xác nhận khi duyệt).</div>
                    </button>
                    <button type="button" class="ocr-case-card @(_case == MerchantSignupCase.StreetVendorUnregistered ? "selected" : "")"
                            @onclick="() => SelectCase(MerchantSignupCase.StreetVendorUnregistered)">
                        <div class="ocr-case-title">🛒 Tôi bán hàng rong / chưa đăng ký kinh doanh</div>
                        <div class="ocr-case-desc">Chỉ cần tên + menu. Hệ thống ghi nhận là hộ kinh doanh nhóm miễn thuế — đội ngũ sẽ hướng dẫn đăng ký sau.</div>
                    </button>
                </div>
                <div class="ocr-wizard-actions">
                    <VanAnButton Variant="ButtonVariant.Primary" OnClick="NextFromCase" Disabled="@(_case is null)" Loading="@_isUploadingPhotos">Tiếp theo</VanAnButton>
                </div>
                break;

            case 1:
                @if (_case == MerchantSignupCase.CompanyWithLicense)
                {
                    <div class="ocr-section">
                        <h4>📷 Ảnh giấy phép kinh doanh</h4>
                        <div class="ocr-capture-row">
                            <input type="file" accept="image/*" capture="environment" class="ocr-file-input form-control"
                                   onchange="vananOnboardingWizard.processFile(this.files[0], 'extractGpdk')" />
                            <VanAnButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="OpenCameraGpdk">📷 Chụp trực tiếp</VanAnButton>
                        </div>
                        <div class="ocr-hint">Chụp thẳng góc, đủ sáng, tránh bóng đổ. Ảnh sẽ được lưu để đội ngũ xác minh.</div>

                        @if (_isOcrBusy) { <div class="ocr-busy">⏳ Đang đọc ảnh giấy phép…</div> }
                        @if (_isUploadingPhotos) { <div class="ocr-busy">⏳ Đang tải ảnh lên…</div> }

                        <div class="ocr-form">
                            <label>Mã số thuế <span class="ocr-req">*</span>
                                <input class="form-control" @bind="_gpdkMst" placeholder="10 hoặc 13 chữ số" />
                                @ConfidenceBadge("MST", _gpdkMstConf)
                            </label>
                            <label>Tên doanh nghiệp / hộ kinh doanh <span class="ocr-req">*</span>
                                <input class="form-control" @bind="_tenantName" />
                                @ConfidenceBadge("Tên", _gpdkNameConf)
                            </label>
                            <label>Địa chỉ
                                <input class="form-control" @bind="_address" />
                                @ConfidenceBadge("Địa chỉ", _gpdkAddressConf)
                            </label>
                            <label>Loại hình
                                <select class="form-select" @bind="_gpdkLegalForm">
                                    <option value="">— Chọn —</option>
                                    <option value="HKD">Hộ kinh doanh</option>
                                    <option value="TNHH">Công ty TNHH</option>
                                    <option value="Cổ phần">Công ty cổ phần</option>
                                    <option value="DNTN">Doanh nghiệp tư nhân</option>
                                    <option value="HTX">Hợp tác xã</option>
                                </select>
                            </label>
                            <label>Người đại diện / chủ hộ
                                <input class="form-control" @bind="_gpdkOwner" />
                            </label>
                        </div>
                        @if (_gpdkLegalForm == "HKD")
                        {
                            <HkdGroupHelper @bind-HkdGroup="_hkdGroup" />
                        }
                    </div>
                }
                else
                {
                    <div class="ocr-section">
                        <h4>🏪 Thông tin cửa hàng</h4>
                        <div class="ocr-form">
                            <label>Tên cửa hàng / tên hiệu <span class="ocr-req">*</span> <span class="ocr-hint">(sẽ tự điền từ biển hiệu ở bước 3)</span>
                                <input class="form-control" @bind="_tenantName" placeholder="VD: Cà Phê ABC" />
                            </label>
                            <label>Địa chỉ @if (_case != MerchantSignupCase.StreetVendorUnregistered) { <span class="ocr-req">*</span> }
                                <input class="form-control" @bind="_address" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" />
                                @if (_case == MerchantSignupCase.StreetVendorUnregistered)
                                {
                                    <span class="ocr-hint">Không bắt buộc nếu bạn bán rong.</span>
                                }
                            </label>
                        </div>
                        @if (_case == MerchantSignupCase.SmallShopNoLicense)
                        {
                            <HkdGroupHelper @bind-HkdGroup="_hkdGroup" Required="true" />
                        }
                        else if (_case == MerchantSignupCase.StreetVendorUnregistered)
                        {
                            <div class="ocr-hint">ℹ️ Hộ kinh doanh nhóm nhỏ nhất (không phải nộp thuế GTGT/TNCN) — đội ngũ sẽ xác nhận và hướng dẫn đăng ký khi duyệt.</div>
                        }
                    </div>
                }
                <div class="ocr-wizard-actions">
                    <VanAnButton Variant="ButtonVariant.Secondary" OnClick="BackToCaseSelect">← Quay lại</VanAnButton>
                    <VanAnButton Variant="ButtonVariant.Primary" OnClick="NextFromDocs">Tiếp theo</VanAnButton>
                </div>
                break;

            case 2:
                <div class="ocr-section">
                    <h4>📷 Biển hiệu cửa hàng</h4>
                    <div class="ocr-capture-row">
                        <input type="file" accept="image/*" capture="environment" class="ocr-file-input form-control"
                               onchange="vananOnboardingWizard.processFile(this.files[0], 'extractSignName')" />
                        <VanAnButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="OpenCameraSign">📷 Chụp trực tiếp</VanAnButton>
                    </div>
                    @if (_isOcrBusy) { <div class="ocr-busy">⏳ Đang đọc biển hiệu…</div> }
                    <label>Tên trên biển hiệu
                        <input class="form-control" @bind="_signName" placeholder="Tên cửa hàng của bạn" />
                        @ConfidenceBadge("Biển hiệu", _signNameConf)
                        @if (_showCloudOcrBtn && _case != MerchantSignupCase.CompanyWithLicense)
                        {
                            <div class="ocr-cloud-ocr">
                                <VanAnButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="CloudOcrAsync" Loading="@_isCloudOcrBusy">
                                    ✨ Nhận diện nâng cao (đám mây)
                                </VanAnButton>
                                <span class="ocr-hint">Ảnh sẽ gửi tới dịch vụ nhận diện — chỉ dùng khi bạn đồng ý.</span>
                            </div>
                        }
                    </label>
                </div>

                <div class="ocr-section">
                    <h4>📷 Menu / danh sách sản phẩm (1..n ảnh)</h4>
                    <div class="ocr-capture-row">
                        <input type="file" accept="image/*" capture="environment" multiple class="ocr-file-input form-control"
                               onchange="vananOnboardingWizard.processMenuFiles(this.files)" />
                        <VanAnButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="OpenCameraMenu">📷 Chụp trực tiếp</VanAnButton>
                    </div>
                    @if (_isMenuBusy) { <div class="ocr-busy">⏳ Đang đọc menu…</div> }
                    @if (_isUploadingPhotos) { <div class="ocr-busy">⏳ Đang tải ảnh lên… (@_photos.Count đã tải)</div> }

                    @if (_productRows.Count > 0)
                    {
                        <table class="ocr-product-table">
                            <thead><tr><th>#</th><th>Tên sản phẩm</th><th>Giá (₫)</th><th></th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < _productRows.Count; i++)
                                {
                                    var row = _productRows[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td><input class="form-control" @bind="row.Name" /></td>
                                        <td><input class="form-control ocr-price" type="number" min="0" step="1000" @bind="row.Price" /></td>
                                        <td><button type="button" class="ocr-remove-btn" @onclick="() => RemoveProductRow(i)">✕</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <VanAnButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="AddProductRow">+ Thêm dòng</VanAnButton>
                    }
                    else
                    {
                        <div class="ocr-hint">Chưa có sản phẩm — bạn có thể bỏ qua và tự thêm sau khi cửa hàng được duyệt.</div>
                    }
                </div>

                <div class="ocr-wizard-actions">
                    <VanAnButton Variant="ButtonVariant.Secondary" OnClick="BackToDocs">← Quay lại</VanAnButton>
                    <VanAnButton Variant="ButtonVariant.Primary" OnClick="NextFromSignMenu">Tiếp theo</VanAnButton>
                </div>
                break;

            case 3:
                <div class="ocr-section">
                    <h4>📍 Vị trí cửa hàng</h4>
                    <VanAnButton Variant="ButtonVariant.Primary" OnClick="GetLocationAsync" Loading="@_isGpsBusy" Disabled="@_isGpsBusy">
                        📡 Lấy vị trí hiện tại
                    </VanAnButton>
                    @if (_lat is not null && _lng is not null)
                    {
                        <div class="ocr-gps-info">
                            <strong>@_lat.Value.ToString("F6"), @_lng.Value.ToString("F6")</strong>
                            @if (_accuracy > 0) { <span> · chính xác ±@Math.Round(_accuracy)m</span> }
                        </div>
                        <div id="onboardMap" class="ocr-map"></div>
                    }
                    <div class="ocr-form">
                        <label>Vĩ độ (lat) <span class="ocr-hint">— nhập tay nếu không dùng GPS được</span>
                            <input class="form-control" type="number" step="0.000001" min="-90" max="90" @bind="_lat" @bind:event="oninput" />
                        </label>
                        <label>Kinh độ (lng)
                            <input class="form-control" type="number" step="0.000001" min="-180" max="180" @bind="_lng" @bind:event="oninput" />
                        </label>
                    </div>
                    @if (_lat is null || _lng is null)
                    {
                        <div class="ocr-hint">Bạn vẫn có thể tiếp tục — đội ngũ sẽ xác nhận vị trí khi duyệt. (Bán rong có thể bỏ trống.)</div>
                    }
                </div>
                <div class="ocr-wizard-actions">
                    <VanAnButton Variant="ButtonVariant.Secondary" OnClick="BackToSignMenu">← Quay lại</VanAnButton>
                    <VanAnButton Variant="ButtonVariant.Primary" OnClick="NextFromLocation">Tiếp theo</VanAnButton>
                </div>
                break;

            case 4:
                <div class="ocr-section">
                    <h4>👤 Tài khoản đăng nhập</h4>
                    <p class="ocr-hint">Đây là tài khoản bạn sẽ dùng để quản lý cửa hàng sau khi được duyệt. <strong>Hãy ghi nhớ mật khẩu — hệ thống không hiển thị lại.</strong></p>
                    <div class="ocr-form">
                        <label>Họ và tên người liên hệ <span class="ocr-req">*</span>
                            <input class="form-control" @bind="_contactName" placeholder="Nguyễn Văn A" />
                        </label>
                        <label>Số điện thoại <span class="ocr-req">*</span>
                            <input class="form-control" @bind="_contactPhone" placeholder="09xx xxx xxx" />
                        </label>
                        <label>Email <span class="ocr-hint">(tùy chọn)</span>
                            <input class="form-control" type="email" @bind="_contactEmail" placeholder="email@example.com" />
                        </label>
                    </div>
                </div>
                <div class="ocr-section">
                    <h4>🔑 Tên đăng nhập + mật khẩu</h4>
                    <div class="ocr-form">
                        <label>Tên đăng nhập <span class="ocr-req">*</span>
                            <input class="form-control" @bind="_ownerUsername" @bind:event="oninput" placeholder="ten_cua_hang" />
                            <span class="ocr-hint">Chữ thường, số, dấu chấm/gạch dưới/gạch ngang (3-30 ký tự). @UsernameStatusText</span>
                        </label>
                        <label>Mật khẩu <span class="ocr-req">*</span> <span class="ocr-hint">tối thiểu 8 ký tự</span>
                            <input class="form-control" type="password" @bind="_ownerPassword" @bind:event="oninput" autocomplete="new-password" />
                        </label>
                        <label>Nhập lại mật khẩu <span class="ocr-req">*</span>
                            <input class="form-control" type="password" @bind="_ownerPasswordConfirm" @bind:event="oninput" autocomplete="new-password" />
                            @if (!string.IsNullOrEmpty(_ownerPasswordConfirm) && _ownerPassword != _ownerPasswordConfirm)
                            {
                                <span class="ocr-hint text-danger">Mật khẩu nhập lại không khớp.</span>
                            }
                        </label>
                    </div>
                </div>
                <div class="ocr-wizard-actions">
                    <VanAnButton Variant="ButtonVariant.Secondary" OnClick="BackToLocation">← Quay lại</VanAnButton>
                    <VanAnButton Variant="ButtonVariant.Primary" OnClick="NextFromAccount">Tiếp theo</VanAnButton>
                </div>
                break;

            case 5:
                <div class="ocr-section">
                    <h4>✅ Xem lại thông tin đăng ký</h4>
                    <table class="ocr-review-table">
                        <tbody>
                            <tr><td>Loại hình</td><td>@CaseLabel</td></tr>
                            <tr><td>Tên cửa hàng</td><td><strong>@_tenantName</strong></td></tr>
                            @if (_case == MerchantSignupCase.CompanyWithLicense)
                            {
                                <tr><td>Mã số thuế</td><td>@_gpdkMst</td></tr>
                                <tr><td>Loại hình pháp lý</td><td>@_gpdkLegalForm</td></tr>
                            }
                            @if (!string.IsNullOrWhiteSpace(_address))
                            {
                                <tr><td>Địa chỉ</td><td>@_address</td></tr>
                            }
                            @if (_hkdGroupDisplay is not null)
                            {
                                <tr><td>Nhóm thuế (gợi ý — đội ngũ xác nhận khi duyệt)</td><td>@_hkdGroupDisplay</td></tr>
                            }
                            @if (!string.IsNullOrWhiteSpace(_signName))
                            {
                                <tr><td>Tên hiệu</td><td>@_signName</td></tr>
                            }
                            @if (_lat is not null && _lng is not null)
                            {
                                <tr><td>Vị trí</td><td>@_lat.Value.ToString("F6"), @_lng.Value.ToString("F6")</td></tr>
                            }
                            <tr><td>Số sản phẩm từ menu</td><td>@_productRows.Count(r => !string.IsNullOrWhiteSpace(r.Name))</td></tr>
                            <tr><td>Ảnh giấy tờ/menu đã tải</td><td>@_photos.Count</td></tr>
                            <tr><td>Người liên hệ</td><td>@_contactName — @_contactPhone</td></tr>
                            <tr><td>Tên đăng nhập</td><td><code>@_ownerUsername</code></td></tr>
                        </tbody>
                    </table>

                    @if (_photos.Count > 0)
                    {
                        <div class="ocr-photo-grid">
                            @foreach (var p in _photos)
                            {
                                <figure class="ocr-photo-thumb">
                                    <img src="@p.Url" alt="@p.Kind" loading="lazy" />
                                    <figcaption>@PhotoKindLabel(p.Kind)</figcaption>
                                </figure>
                            }
                        </div>
                    }

                    @* Honeypot — hidden từ người dùng, bot tự điền → server silent reject *@
                    <div style="display:none;" aria-hidden="true">
                        <label>Đừng điền mục này</label>
                        <input class="form-control" @bind="_honeypot" tabindex="-1" autocomplete="off" />
                    </div>

                    <div id="turnstile-container"></div>
                </div>
                <div class="ocr-wizard-actions">
                    <VanAnButton Variant="ButtonVariant.Secondary" OnClick="BackToAccount">← Quay lại</VanAnButton>
                    <VanAnButton Variant="ButtonVariant.Success" OnClick="SubmitAsync" Loading="@_isSubmitting" Disabled="@_isSubmitting">
                        🚀 Gửi đăng ký
                    </VanAnButton>
                </div>
                break;

            case 6:
                <VanAnCard Shadow="true" CssClass="text-center p-5">
                    <i class="bi bi-check-circle text-success" style="font-size:3rem;"></i>
                    <h4 class="mt-3">Đã ghi nhận hồ sơ đăng ký!</h4>
                    <p class="text-muted">@_submitMessage</p>
                    @if (_signupId is not null)
                    {
                        <p class="small text-muted">Mã đăng ký: <code>@_signupId</code></p>
                        <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToStatus">
                            <i class="bi bi-search me-1"></i> Kiểm tra trạng thái đăng ký
                        </VanAnButton>
                    }
                    <div class="mt-3">
                        <VanAnButton Variant="ButtonVariant.Secondary" OnClick="ResetWizard">+ Đăng ký cửa hàng khác</VanAnButton>
                    </div>
                </VanAnCard>
                break;
        }
    }
</div>

<!-- Draft restore prompt -->
@if (_draft is not null && _step == 0)
{
    <div class="ocr-camera-overlay">
        <div class="ocr-camera-modal" style="width:min(420px,100%);">
            <div class="ocr-camera-header"><strong>Tiếp tục hồ sơ đang nhập?</strong></div>
            <p style="color:#cbd5e1;font-size:0.9rem;">Chúng tôi tìm thấy bản nháp đăng ký trên thiết bị này.</p>
            <div class="ocr-camera-actions">
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="RestoreDraftAsync">Tiếp tục</VanAnButton>
                <VanAnButton Variant="ButtonVariant.Error" OnClick="DiscardDraftAsync">Bắt đầu mới</VanAnButton>
            </div>
        </div>
    </div>
}

<!-- Camera scan modal -->
@if (_showCameraModal)
{
    <div class="ocr-camera-overlay">
        <div class="ocr-camera-modal">
            <div class="ocr-camera-header">
                <strong>@CameraTitle</strong>
                @if (_cameraMode == "menu")
                {
                    <span class="ocr-camera-count">Đã chụp: @_menuShotCount</span>
                }
                <button type="button" class="ocr-camera-close" @onclick="CloseCameraAsync">✕</button>
            </div>
            <video id="ocrCameraVideo" class="ocr-camera-video" autoplay playsinline muted></video>
            <div class="ocr-camera-actions">
                @if (_cameraMode == "menu")
                {
                    <VanAnButton Variant="ButtonVariant.Primary" OnClick="CaptureMenuShotAsync">📸 Chụp</VanAnButton>
                    <VanAnButton Variant="ButtonVariant.Success" OnClick="FinishMenuCaptureAsync">✅ Xong + Nhận diện (@_menuShotCount ảnh)</VanAnButton>
                }
                else
                {
                    <VanAnButton Variant="ButtonVariant.Primary" OnClick="CaptureAndOcrAsync">📸 Chụp + Nhận diện</VanAnButton>
                }
                <VanAnButton Variant="ButtonVariant.Error" OnClick="CloseCameraAsync">✕ Đóng</VanAnButton>
            </div>
        </div>
    </div>
}
</KhachLinkLayout>

@code {
    private const string DraftKey = "onboard-draft";
    private const string FlagsKey = "onboard-flags";
    private const string LastSignupKey = "last-signup-id";
    private const string CloudOcrConsentKey = "consentCloudOcr";

    // ── State ──────────────────────────────────────────────────────────
    private int _step;
    private MerchantSignupCase? _case;
    private bool _closed;
    private OnboardingFlagsInfo _flags = new(true, true, true, true);
    private string _alertMessage = string.Empty;
    private string _alertVariant = "info";

    // Case A GPKD
    private string _gpdkMst = string.Empty;
    private string _gpdkLegalForm = string.Empty;
    private string _gpdkOwner = string.Empty;
    private double _gpdkMstConf, _gpdkNameConf, _gpdkAddressConf, _gpdkLegalFormConf;

    // Chung
    private string _tenantName = string.Empty;
    private string _address = string.Empty;
    private string? _hkdGroup; // "1"|"2"|"3"
    private string? _signName;
    private double _signNameConf;
    private readonly List<ProductRow> _productRows = [];
    private readonly List<OnboardPhoto> _photos = [];
    private double? _lat, _lng;
    private double _accuracy;
    private double? _lastMapLat, _lastMapLng;

    // Account
    private string _contactName = string.Empty;
    private string _contactPhone = string.Empty;
    private string _contactEmail = string.Empty;
    private string _ownerUsername = string.Empty;
    private string _ownerPassword = string.Empty;
    private string _ownerPasswordConfirm = string.Empty;
