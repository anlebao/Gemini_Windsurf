    // ── Draft autosave (localStorage — WASM reload/mất điện thoại vẫn giữ) ──
    private void SaveDraft()
    {
        if (_step == 6 || _closed) return; // đã submit xong → không lưu
        _saveDebounce?.Cancel();
        _saveDebounce = new CancellationTokenSource();
        var ct = _saveDebounce.Token;
        _ = Task.Delay(500, ct).ContinueWith(async _ =>
        {
            if (ct.IsCancellationRequested) return;
            try
            {
                var draft = BuildDraft();
                var json = System.Text.Json.JsonSerializer.Serialize(draft);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", DraftKey, json);
            }
            catch { /* draft là best-effort */ }
        }, TaskScheduler.Default);
    }

    private OnboardDraft BuildDraft() => new()
    {
        Step = _step,
        Case = _case?.ToString(),
        GpdkMst = _gpdkMst, TenantName = _tenantName, Address = _address,
        GpdkLegalForm = _gpdkLegalForm, GpdkOwner = _gpdkOwner,
        HkdGroup = _hkdGroup, SignName = _signName,
        ProductRows = _productRows.Select(r => new DraftProductRow { Name = r.Name, Price = r.Price }).ToList(),
        PhotoUrls = _photos.Select(p => new DraftPhoto { Kind = p.Kind, Url = p.Url, FileName = p.FileName }).ToList(),
        Lat = _lat, Lng = _lng,
        ContactName = _contactName, ContactPhone = _contactPhone, ContactEmail = _contactEmail,
        OwnerUsername = _ownerUsername,
        Src = _src
        // Password + Turnstile token KHÔNG lưu draft (bảo mật)
    };

    private async Task RestoreDraftAsync()
    {
        var d = _draft;
        _draft = null;
        if (d is null) return;

        if (Enum.TryParse<MerchantSignupCase>(d.Case, out var c)) _case = c;
        _step = Math.Clamp(d.Step, 0, 5);
        _gpdkMst = d.GpdkMst ?? string.Empty;
        _tenantName = d.TenantName ?? string.Empty;
        _address = d.Address ?? string.Empty;
        _gpdkLegalForm = d.GpdkLegalForm ?? string.Empty;
        _gpdkOwner = d.GpdkOwner ?? string.Empty;
        _hkdGroup = d.HkdGroup;
        _signName = d.SignName;
        _productRows.Clear();
        _productRows.AddRange((d.ProductRows ?? []).Select(r => new ProductRow { Name = r.Name ?? string.Empty, Price = r.Price }));
        _photos.Clear();
        _photoUrlByKind.Clear();
        foreach (var p in d.PhotoUrls ?? [])
        {
            if (!string.IsNullOrEmpty(p.Url))
            {
                _photos.Add(new OnboardPhoto { Kind = p.Kind ?? "doc", Url = p.Url, FileName = p.FileName });
                _photoUrlByKind.TryAdd(p.Kind ?? "doc", p.Url);
            }
        }
        _lat = d.Lat; _lng = d.Lng;
        _contactName = d.ContactName ?? string.Empty;
        _contactPhone = d.ContactPhone ?? string.Empty;
        _contactEmail = d.ContactEmail ?? string.Empty;
        _ownerUsername = d.OwnerUsername ?? string.Empty;
        _src = d.Src;
        await Task.CompletedTask;
    }

    private async Task DiscardDraftAsync()
    {
        _draft = null;
        try { await JSRuntime.InvokeVoidAsync("localStorage.removeItem", DraftKey); } catch { }
    }

    private async Task ClearDraftAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("localStorage.removeItem", DraftKey); } catch { }
    }

    // ── Submit ─────────────────────────────────────────────────────────
    private async Task SubmitAsync()
    {
        if (_case is null || string.IsNullOrWhiteSpace(_tenantName))
        {
            ShowAlert("Thiếu thông tin bắt buộc — quay lại kiểm tra.", "warning");
            return;
        }

        var phone = new string((_contactPhone ?? "").Where(char.IsDigit).ToArray());
        var businessType = ResolveBusinessType();
        var hkdGroup = ResolveHkdGroup(businessType);

        _isSubmitting = true;
        ShowAlert(string.Empty);
        try
        {
            string? turnstileToken = null;
            try { turnstileToken = await JSRuntime.InvokeAsync<string>("vanan.getTurnstileToken"); }
            catch { /* dev mode — token rỗng */ }

            var request = new MerchantSignupSubmitRequest(
                Case: _case.Value,
                Name: _tenantName.Trim(),
                Address: string.IsNullOrWhiteSpace(_address) ? null : _address.Trim(),
                BusinessType: businessType,
                HkdGroup: hkdGroup,
                GpdkInfo: _case == MerchantSignupCase.CompanyWithLicense
                    ? new GpdkInfoInput(_gpdkMst, _tenantName, _address, _gpdkLegalForm, _gpdkOwner)
                    : null,
                SignName: string.IsNullOrWhiteSpace(_signName) ? null : _signName.Trim(),
                Latitude: _lat,
                Longitude: _lng,
                PhotoUrls: _photos.Count > 0 ? _photos.Select(p => p.Url).ToList() : null,
                ProductLines: _productRows
                    .Where(r => !string.IsNullOrWhiteSpace(r.Name))
                    .Select((r, i) => new OcrProductLineInput(r.Name.Trim(), r.Price, i + 1))
                    .ToList(),
                ContactName: _contactName.Trim(),
                ContactPhone: phone,
                ContactEmail: string.IsNullOrWhiteSpace(_contactEmail) ? null : _contactEmail.Trim(),
                OwnerUsername: _ownerUsername.Trim().ToLowerInvariant(),
                OwnerPassword: _ownerPassword,
                TurnstileToken: turnstileToken,
                HoneypotWebsite: string.IsNullOrWhiteSpace(_honeypot) ? null : _honeypot.Trim(),
                Src: _src ?? "direct");

            var outcome = await SignupService.SubmitAsync(request);
            if (outcome.Success)
            {
                _signupId = outcome.SignupId;
                _submitMessage = outcome.Message ?? "Đăng ký thành công!";
                _step = 6;
                await ClearDraftAsync();
                try
                {
                    if (_signupId is not null)
                        await JSRuntime.InvokeVoidAsync("localStorage.setItem", LastSignupKey, _signupId.Value.ToString());
                }
                catch { }
            }
            else
            {
                ShowAlert(outcome.Error ?? "Gửi đăng ký thất bại.", "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Merchant signup submit exception");
            ShowAlert("Lỗi không xác định khi gửi đăng ký. Vui lòng thử lại.", "error");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private BusinessType ResolveBusinessType()
    {
        if (_case == MerchantSignupCase.CompanyWithLicense)
            return string.Equals(_gpdkLegalForm, "HKD", StringComparison.OrdinalIgnoreCase)
                ? BusinessType.HouseholdBusiness : BusinessType.Company;
        return BusinessType.HouseholdBusiness; // Case B + Rong luôn HKD
    }

    private HKDGroup? ResolveHkdGroup(BusinessType businessType)
    {
        if (businessType != BusinessType.HouseholdBusiness) return null;
        if (_case == MerchantSignupCase.StreetVendorUnregistered) return null; // server force Group1
        return int.TryParse(_hkdGroup, out var g) ? (HKDGroup)g : null;
    }

    private void GoToStatus()
    {
        if (_signupId is not null)
            Navigation.NavigateTo($"/onboard/status?signupId={_signupId}&phone={Uri.EscapeDataString(_contactPhone)}");
        else
            Navigation.NavigateTo("/onboard/status");
    }

    private async Task ResetWizard()
    {
        _step = 0;
        _case = null;
        _closed = false;
        _tenantName = _address = _contactName = _contactPhone = _contactEmail = string.Empty;
        _gpdkMst = _gpdkLegalForm = _gpdkOwner = string.Empty;
        _gpdkMstConf = _gpdkNameConf = _gpdkAddressConf = _gpdkLegalFormConf = 0;
        _signName = null;
        _signNameConf = 0;
        _productRows.Clear();
        _photos.Clear();
        _photoUrlByKind.Clear();
        _lat = _lng = null;
        _accuracy = 0;
        _lastMapLat = _lastMapLng = null;
        _ownerUsername = _ownerPassword = _ownerPasswordConfirm = string.Empty;
        _honeypot = string.Empty;
        _src = null;
        _signupId = null;
        _submitMessage = string.Empty;
        _showCameraModal = false;
        _cameraMode = string.Empty;
        _menuShotCount = 0;
        _cameraPendingOpen = false;
        _turnstileRendered = false;
        _showCloudOcrBtn = false;
        _draft = null;
        _alertMessage = string.Empty;
        try { await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.closeCamera"); } catch { }
        await ClearDraftAsync();
    }

    private static bool IsValidMst(string mst)
    {
        var digits = mst.Replace("-", "").Trim();
        return (digits.Length == 10 || digits.Length == 13) && digits.All(char.IsDigit);
    }

    private string PhotoKindLabel(string kind) => kind switch
    {
        "gpdk" => "Giấy phép",
        "sign" => "Biển hiệu",
        "menu" => "Menu",
        _ => "Ảnh"
    };

    private async Task RenderTurnstileAsync()
    {
        try
        {
            var siteKey = await JSRuntime.InvokeAsync<string>("vanan.getTurnstileSiteKey");
            if (!string.IsNullOrEmpty(siteKey))
                await JSRuntime.InvokeVoidAsync("vanan.renderTurnstile", "turnstile-container", siteKey);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Turnstile render failed — submit without token");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("vananOnboardingOcr.unload"); } catch { }
        _saveDebounce?.Cancel();
        GC.SuppressFinalize(this);
    }

    // ── Confidence badge (port từ OcrOnboardingWizard) ─────────────────
    private RenderFragment ConfidenceBadge(string label, double confidence)
        => builder =>
        {
            if (confidence <= 0) return;
            var css = confidence >= 70 ? "ocr-conf-high" : "ocr-conf-low";
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"ocr-conf {css}");
            builder.AddContent(2, $"{label}: {confidence:F0}%");
            builder.CloseElement();
        };

