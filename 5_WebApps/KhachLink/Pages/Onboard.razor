    // ── Init: flags + deep-link + draft ─────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Flags: sessionStorage cache (per-session) → fallback fetch (fail-open = mở)
        try
        {
            var cached = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", FlagsKey);
            if (!string.IsNullOrEmpty(cached))
            {
                _flags = System.Text.Json.JsonSerializer.Deserialize<OnboardingFlagsInfo>(cached)
                    ?? new OnboardingFlagsInfo(true, true, true, true);
            }
            else
            {
                var fetched = await SignupService.GetOnboardingFlagsAsync();
                if (fetched is not null)
                {
                    _flags = fetched;
                    await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", FlagsKey,
                        System.Text.Json.JsonSerializer.Serialize(fetched));
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Onboarding flags load failed — default open");
        }

        if (!_flags.SelfServeEnabled)
        {
            _closed = true;
            return;
        }

        // Deep-link params (FR-19) — chỉ khi deeplinkPrefill bật
        if (_flags.DeeplinkPrefill)
            ApplyDeepLink();

        // Draft autosave restore prompt
        try
        {
            var draftJson = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", DraftKey);
            if (!string.IsNullOrEmpty(draftJson))
                _draft = System.Text.Json.JsonSerializer.Deserialize<OnboardDraft>(draftJson);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Draft load failed");
        }
    }

    private void ApplyDeepLink()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var src = (query["src"] ?? "").Trim().ToLowerInvariant();
        _src = src is "directory" or "audit" or "qr" or "zalo" or "other" or "direct" ? src : "other";

        // case: a|company → Case A · b|shop → Case B · rong|c → Case Rong
        var caseParam = (query["case"] ?? "").Trim().ToLowerInvariant();
        _case = caseParam switch
        {
            "a" or "company" or "gpdk" => MerchantSignupCase.CompanyWithLicense,
            "rong" or "c" or "vendor" => MerchantSignupCase.StreetVendorUnregistered,
            "b" or "shop" or "small" => MerchantSignupCase.SmallShopNoLicense,
            _ => null
        };

        var name = (query["name"] ?? "").Trim();
        if (name.Length > 200) name = name[..200];
        if (!string.IsNullOrEmpty(name)) _tenantName = name;

        var address = (query["address"] ?? "").Trim();
        if (address.Length > 200) address = address[..200];
        if (!string.IsNullOrEmpty(address)) _address = address;

        if (double.TryParse(query["lat"], System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var lat)
            && lat is >= -90 and <= 90)
            _lat = lat;
        if (double.TryParse(query["lng"], System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var lng)
            && lng is >= -180 and <= 180)
            _lng = lng;
    }

