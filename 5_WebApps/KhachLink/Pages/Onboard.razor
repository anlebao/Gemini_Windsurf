    private void NextFromDocs()
    {
        if (_case == MerchantSignupCase.CompanyWithLicense)
        {
            if (string.IsNullOrWhiteSpace(_gpdkMst))
            {
                ShowAlert("Mã số thuế bắt buộc — OCR không đọc được thì nhập tay.", "warning");
                return;
            }
            if (!IsValidMst(_gpdkMst))
            {
                ShowAlert("Mã số thuế phải 10 hoặc 13 chữ số.", "warning");
                return;
            }
            if (string.IsNullOrWhiteSpace(_tenantName))
            {
                ShowAlert("Tên doanh nghiệp/hộ kinh doanh bắt buộc.", "warning");
                return;
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_tenantName))
            {
                ShowAlert("Tên cửa hàng bắt buộc — chụp biển hiệu ở bước sau hoặc nhập tay.", "warning");
                return;
            }
            if (_case == MerchantSignupCase.SmallShopNoLicense && string.IsNullOrWhiteSpace(_hkdGroup))
            {
                ShowAlert("Vui lòng chọn nhóm thuế (gợi ý bên dưới) — đội ngũ sẽ xác nhận khi duyệt.", "warning");
                return;
            }
            if (_case != MerchantSignupCase.StreetVendorUnregistered && string.IsNullOrWhiteSpace(_address))
            {
                ShowAlert("Vui lòng nhập địa chỉ cửa hàng.", "warning");
                return;
            }
        }
        _step = 2;
        SaveDraft();
    }

    private void NextFromSignMenu()
    {
        if (!string.IsNullOrWhiteSpace(_signName) && _case != MerchantSignupCase.CompanyWithLicense
            && string.IsNullOrWhiteSpace(_tenantName))
        {
            _tenantName = _signName;
        }
        if (string.IsNullOrWhiteSpace(_tenantName))
        {
            ShowAlert("Tên cửa hàng chưa có — nhập tay hoặc chụp biển hiệu.", "warning");
            return;
        }
        _step = 3;
        SaveDraft();
    }

    private void NextFromLocation()
    {
        _step = 4;
        SaveDraft();
    }

    private void NextFromAccount()
    {
        if (string.IsNullOrWhiteSpace(_contactName)) { ShowAlert("Vui lòng nhập họ và tên người liên hệ.", "warning"); return; }
        var phone = new string((_contactPhone ?? "").Where(char.IsDigit).ToArray());
        if (phone.Length < 9) { ShowAlert("Số điện thoại không hợp lệ.", "warning"); return; }
        var u = _ownerUsername.Trim().ToLowerInvariant();
        if (!System.Text.RegularExpressions.Regex.IsMatch(u, "^[a-z0-9._-]{3,30}$"))
        {
            ShowAlert("Tên đăng nhập chỉ gồm chữ thường, số, dấu chấm/gạch dưới/gạch ngang (3-30 ký tự).", "warning");
            return;
        }
        if (string.IsNullOrEmpty(_ownerPassword) || _ownerPassword.Length < 8)
        {
            ShowAlert("Mật khẩu tối thiểu 8 ký tự.", "warning");
            return;
        }
        if (_ownerPassword != _ownerPasswordConfirm)
        {
            ShowAlert("Mật khẩu nhập lại không khớp.", "warning");
            return;
        }
        _step = 5;
        SaveDraft();
    }

    // ── OCR + camera callbacks ─────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_jsRegistered && !_closed)
        {
            _jsRegistered = true;
            await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.register", DotNetObjectReference.Create(this));
        }
        // Map chỉ init khi step=3 + coords đổi (RV fix pattern — tránh L.map re-init crash)
        if (_step == 3 && _lat is not null && _lng is not null
            && (_lat != _lastMapLat || _lng != _lastMapLng))
        {
            _lastMapLat = _lat;
            _lastMapLng = _lng;
            await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.initMap", "onboardMap", _lat.Value, _lng.Value, _accuracy);
        }
        if (_cameraPendingOpen)
        {
            _cameraPendingOpen = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("vananOnboardingWizard.openCamera", "ocrCameraVideo");
            }
            catch (Exception ex)
            {
                ShowAlert($"Không mở được camera: {ex.Message}", "error");
                _showCameraModal = false;
            }
        }
        // Turnstile render khi vào step review
        if (_step == 5 && !_turnstileRendered)
        {
            _turnstileRendered = true;
            await RenderTurnstileAsync();
        }
    }

