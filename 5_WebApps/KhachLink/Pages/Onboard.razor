    /// <summary>JS gửi bytes ảnh (file input hoặc camera) → upload R2 folder "onboarding".</summary>
    [JSInvokable]
    public async Task OnPhotoFile(string kind, byte[] bytes, string fileName, string contentType)
    {
        if (bytes is null || bytes.Length == 0) return;
        _isUploadingPhotos = true;
        try
        {
            var outcome = await ImageUpload.UploadImageBytesAsync(
                bytes, string.IsNullOrWhiteSpace(fileName) ? "photo.jpg" : fileName,
                "onboarding", contentType);
            if (outcome.Success && !string.IsNullOrEmpty(outcome.Url))
            {
                // Dedupe theo URL (ảnh chụp lại cùng nội dung vẫn có URL khác — giữ cả 2, sysadmin xem được)
                if (!_photos.Any(p => p.Url == outcome.Url))
                {
                    _photos.Add(new OnboardPhoto { Kind = kind, Url = outcome.Url, FileName = fileName });
                    _photoUrlByKind[kind] = outcome.Url;
                }
            }
            else
            {
                ShowAlert($"Ảnh {kind} tải lên thất bại: {outcome.Error} — bạn vẫn có thể gửi đăng ký.", "warning");
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "OnPhotoFile upload fail ({Kind})", kind);
        }
        finally
        {
            _isUploadingPhotos = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnOcrResult(string method, string json)
    {
        try
        {
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            switch (method)
            {
                case "extractGpdk":
                {
                    _isOcrBusy = false;
                    _ = CloseCameraAsync();
                    var r = System.Text.Json.JsonSerializer.Deserialize<GpdkOcrResult>(json, options);
                    if (r is null) break;
                    if (!string.IsNullOrWhiteSpace(r.Mst)) _gpdkMst = r.Mst;
                    if (!string.IsNullOrWhiteSpace(r.Name)) _tenantName = r.Name;
                    if (!string.IsNullOrWhiteSpace(r.Address)) _address = r.Address;
                    if (!string.IsNullOrWhiteSpace(r.LegalForm)) _gpdkLegalForm = r.LegalForm;
                    if (!string.IsNullOrWhiteSpace(r.Owner)) _gpdkOwner = r.Owner;
                    _gpdkMstConf = r.Confidence?.GetValueOrDefault("mst") ?? 0;
                    _gpdkNameConf = r.Confidence?.GetValueOrDefault("name") ?? 0;
                    _gpdkAddressConf = r.Confidence?.GetValueOrDefault("address") ?? 0;
                    _gpdkLegalFormConf = r.Confidence?.GetValueOrDefault("legalForm") ?? 0;
                    MaybeShowCloudOcr(r.Confidence?.GetValueOrDefault("name") ?? 0);
                    if (r.Warnings is { Count: > 0 }) ShowAlert(string.Join(" · ", r.Warnings), "warning");
                    else ShowAlert("Đã đọc giấy phép — kiểm tra lại các trường trước khi tiếp tục.", "success");
                    break;
                }
                case "extractSignName":
                {
                    _isOcrBusy = false;
                    _ = CloseCameraAsync();
                    var r = System.Text.Json.JsonSerializer.Deserialize<SignOcrResult>(json, options);
                    if (r?.Value is not null)
                    {
                        _signName = r.Value;
                        _signNameConf = r.Confidence;
                        if (string.IsNullOrWhiteSpace(_tenantName) && _case != MerchantSignupCase.CompanyWithLicense)
                            _tenantName = r.Value;
                    }
                    MaybeShowCloudOcr(r?.Confidence ?? 0);
                    break;
                }
                case "extractMenu":
                {
                    _isMenuBusy = false;
                    var r = System.Text.Json.JsonSerializer.Deserialize<MenuOcrResult>(json, options);
                    if (r?.ProductLines is not null)
                    {
                        _productRows.Clear();
                        _productRows.AddRange(r.ProductLines
                            .Where(p => !string.IsNullOrWhiteSpace(p.Name))
                            .Select(p => new ProductRow { Name = p.Name!, Price = p.Price }));
                        ShowAlert($"Đã đọc {_productRows.Count} sản phẩm từ menu — rà soát giá và tên.", "success");
                    }
                    if (r?.Warnings is { Count: > 0 })
                        ShowAlert(string.Join(" · ", r.Warnings), "warning");
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OCR result parse fail ({Method})", method);
            ShowAlert($"Lỗi xử lý kết quả OCR: {ex.Message}", "error");
        }
        SaveDraft();
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnOcrError(string method, string message)
    {
        _isOcrBusy = false;
        _isMenuBusy = false;
        ShowAlert($"OCR thất bại ({method}): {message} — nhập tay.", "error");
        StateHasChanged();
        return Task.CompletedTask;
    }

    // ── OCR cloud-assist hook (P6 — tolerant, ẩn khi endpoint chưa có) ────
    private void MaybeShowCloudOcr(double confidence)
    {
        // Chỉ gợi ý khi confidence thấp + user đã consent trước đó (hoặc chưa từ chối)
        _showCloudOcrBtn = confidence > 0 && confidence < 70;
    }

    private async Task CloudOcrAsync()
    {
        var consent = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", CloudOcrConsentKey);
        if (consent != "yes")
        {
            var ok = await JSRuntime.InvokeAsync<bool>("confirm",
                "Gửi ảnh giấy tờ/menu tới dịch vụ nhận diện đám mây để đọc chính xác hơn? (Dữ liệu chỉ dùng cho đăng ký này)");
            if (!ok) return;
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", CloudOcrConsentKey, "yes");
        }

        var imageUrl = _photoUrlByKind.GetValueOrDefault("gpdk")
            ?? _photoUrlByKind.GetValueOrDefault("sign")
            ?? _photoUrlByKind.GetValueOrDefault("menu");
        if (string.IsNullOrEmpty(imageUrl))
        {
            ShowAlert("Chưa có ảnh nào được tải lên — thử lại sau khi ảnh upload xong.", "warning");
            return;
        }

        _isCloudOcrBusy = true;
        try
        {
            var result = await SignupService.OcrAssistAsync(imageUrl, _case == MerchantSignupCase.CompanyWithLicense ? "gpdk" : "sign");
            if (result is null)
            {
                _showCloudOcrBtn = false; // endpoint chưa có (P6) — ẩn luôn
                ShowAlert("Nhận diện nâng cao chưa khả dụng — vui lòng nhập tay.", "warning");
                return;
            }
            if (!string.IsNullOrWhiteSpace(result.Mst)) _gpdkMst = result.Mst;
            if (!string.IsNullOrWhiteSpace(result.Name)) _tenantName = result.Name;
            if (!string.IsNullOrWhiteSpace(result.Address)) _address = result.Address;
            if (!string.IsNullOrWhiteSpace(result.LegalForm)) _gpdkLegalForm = result.LegalForm;
            if (!string.IsNullOrWhiteSpace(result.SignName)) _signName = result.SignName;
            ShowAlert("Đã nhận diện nâng cao — kiểm tra lại các trường.", "success");
        }
        finally
        {
            _isCloudOcrBusy = false;
        }
    }

