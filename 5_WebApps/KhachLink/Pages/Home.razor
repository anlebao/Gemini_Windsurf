    private async Task AddToCart(ProductDto product, string? imgElementId = null)
    {
        // Fly-to-cart animation
        if (!string.IsNullOrEmpty(imgElementId))
        {
            try { await JSRuntime.InvokeVoidAsync("vananFlyToCart", imgElementId); }
            catch { /* ignore animation errors */ }
        }

        await CartService.AddItemAsync(product, 1);

        // Track product view
        await RecentlyViewedService.AddToRecentlyViewedAsync(product);
        recentlyViewed = await RecentlyViewedService.GetRecentlyViewedAsync();

        // Show notification
        await ShowNotification($"Đã thêm {product.Name} vào giỏ hàng!", "success");
    }

    /// <summary>
    /// Add a Featured product (from Catalog API) directly to cart.
    /// Featured products have full snapshot: ProductId + TenantId + DisplayName + DisplayPrice + VatRate.
    /// No QR scan needed — admin curated the display info + VAT when creating the featured product.
    /// </summary>
    private async Task AddFeaturedToCart(RecommendedCatalogItem item, string? imgElementId = null)
    {
        // Fly-to-cart animation
        if (!string.IsNullOrEmpty(imgElementId))
        {
            try { await JSRuntime.InvokeVoidAsync("vananFlyToCart", imgElementId); }
            catch { /* ignore animation errors */ }
        }

        var product = new ProductDto
        {
            ProductId = item.ProductId,
            TenantId = item.TenantId,
            Name = item.DisplayName,
            Description = item.Description ?? string.Empty,
            Price = item.DisplayPrice,
            VatRate = item.VatRate,
            ImageUrl = item.ImageUrl,
            TenantName = item.TenantName ?? string.Empty,
            IsActive = true
        };
        await CartService.AddItemAsync(product, 1);
        await RecentlyViewedService.AddToRecentlyViewedAsync(product);
        recentlyViewed = await RecentlyViewedService.GetRecentlyViewedAsync();

        // Track last interaction tenantId for Home page personalization
        await LastInteractionService.RecordInteractionAsync(item.TenantId);

        // Refresh campaigns + store section if tenant changed
        if (!_lastTenantId.HasValue || _lastTenantId.Value != item.TenantId)
        {
            await LoadLastTenantDataAsync();
        }

        await ShowNotification($"Đã thêm {item.DisplayName} vào giỏ hàng!", "success");
    }

    private async Task ShowNotification(string message, string type)
    {
        // Simple notification - could be enhanced with a proper toast library
        await Task.Delay(100);
    }

