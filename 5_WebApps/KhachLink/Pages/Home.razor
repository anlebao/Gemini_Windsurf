@using VanAn.KhachLink.Components.Layout
@using Microsoft.AspNetCore.Components.Web
@using VanAn.Shared.Domain
@using VanAn.Shared.DTOs
@using VanAn.KhachLink.Components.Shared
@using VanAn.KhachLink.Models
@using VanAn.KhachLink.Components
@using VanAn.KhachLink.Services.Http
@page "/home"
@page "/"
@inject VanAn.KhachLink.Services.CartService CartService
@inject NavigationManager Navigation
@inject IThemeProvider ThemeProvider
@inject ITenantService TenantService
@inject VanAn.KhachLink.Services.Http.ProductHttpService ProductService
@inject VanAn.KhachLink.Services.Http.CatalogHttpService CatalogService
@inject VanAn.KhachLink.Services.Http.ShopConfigHttpService ShopConfigService
@inject VanAn.KhachLink.Services.Http.ShopFeatureSettingsHttpService FeatureSettings
@inject VanAn.KhachLink.Services.Http.KhachLinkHomeSettingsHttpService HomeSettingsService
@inject VanAn.KhachLink.Services.Http.CommunityHttpService CommunityHttp
@inject VanAn.KhachLink.Services.RecentlyViewedService RecentlyViewedService
@inject VanAn.KhachLink.Services.LastInteractionService LastInteractionService
@inject ISocialCampaignService CampaignService
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>KhachLink - Cỗ Máy Giữ Khách Vạn An</PageTitle>

<!-- Cart Drawer Component -->
<CartDrawer
    CartItems="@cartState.Items"
    TotalAmount="@cartState.TotalAmount"
    TotalVatAmount="@cartState.TotalVatAmount"
    VatDisplayEnabled="@_vatDisplayEnabled"
    RemoveFromCart="async (productId) => await CartService.RemoveItemAsync(productId)"
    Checkout="async () => await GoToCheckout()" />

<KhachLinkLayout>
    <!-- Sprint 7: Commerce Mode badge — shows Marketplace/Reseller mode -->
    @if (_commerceModeLoaded && _isReseller)
    {
        <div class="container mt-2" style="max-width:1000px;">
            <div class="alert alert-info py-2 mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle"></i>
                <small><strong>Mô hình Reseller</strong> — Vạn An mua bán, giá đã bao gồm phí nền tảng.</small>
            </div>
        </div>
    }

    <!-- Issue #142: Store Finder search box — Google Maps style.
         Text input + mic icon (voice input). Submit (Enter) or voice transcript
         navigates to /stores?q=<keyword> for full search results. -->
    <VanAnCard CssClass="store-finder-cta mb-4 py-4">
        <div class="text-center mb-3">
            <i class="bi bi-geo-alt-fill text-primary" style="font-size: 2.5rem;"></i>
            <h3 class="mt-2 mb-1">Tìm cửa hàng gần bạn</h3>
            <p class="text-muted mb-0">Tìm theo tên, sản phẩm, hoặc vị trí — có hỗ trợ tìm bằng giọng nói</p>
        </div>
        <div class="home-search-box-wrapper">
            <div class="input-group input-group-lg home-search-box">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-primary"></i>
                </span>
                <input type="text" class="form-control border-start-0 border-end-0"
                       id="home-search-input"
                       @bind="_homeSearchKeyword"
                       @onkeyup="OnHomeSearchKeyUp"
                       placeholder="Tìm theo tên cửa hàng, sản phẩm, dịch vụ..."
                       aria-label="Tìm cửa hàng" />
                @if (_homeVoiceEnabled && _homeSpeechSupported)
                {
                    <button type="button"
                            class="btn btn-outline-primary home-voice-mic-btn @(_homeVoiceRecording ? "recording" : "")"
                            OnClick="ToggleHomeVoiceSearch"
                            title="@(_homeVoiceRecording ? "Dừng ghi âm" : "Nói để tìm kiếm")"
                            aria-label="Tìm kiếm bằng giọng nói">
                        @if (_homeVoiceRecording)
                        {
                            <span class="recording-pulse">⏹️</span>
                        }
                        else
                        {
                            <span>🎤</span>
                        }
                    </button>
                }
                <button type="button" class="btn btn-primary home-search-go-btn" OnClick="SubmitHomeSearch">
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
            @if (_homeVoiceRecording)
            {
                <div class="voice-recording-hint text-danger small mt-2 text-center">
                    <span class="recording-dot-inline"></span> Đang ghi âm... nói tên cửa hàng hoặc sản phẩm
                </div>
            }
            @if (!string.IsNullOrEmpty(_homeVoiceError))
            {
                <div class="text-danger small mt-2 text-center">@_homeVoiceError</div>
            }
        </div>
    </VanAnCard>

    <!-- Issue 5a: Hide Campaign + Store sections for new customers (no _lastTenantId yet).
         New users see only the catalog/featured products + scan CTA. Once they scan QR or
         order from a tenant, _lastTenantId is set and these sections appear. -->
    @if (_lastTenantId.HasValue && _lastTenantId.Value != Guid.Empty)
    {
        <!-- Campaign Section (replaces Hero) — filtered by last interaction tenantId -->
        @if (_homeCampaignEnabled)
        {
        <VanAnCard CssClass="campaign-section mb-4">
            <div class="container">
                <h2 class="mb-3">
                    <i class="bi bi-megaphone-fill text-primary"></i> Khuyến Mãi Cửa Hàng
                </h2>

                @if (_campaignLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="mt-2 text-muted">Đang tải khuyến mãi...</p>
                    </div>
                }
                else if (_campaigns.Count > 0)
                {
                    <div class="row g-3">
                        @foreach (var campaign in _campaigns.Take(4))
                        {
                            <div class="col-12 col-md-6">
                                <VanAnCard Shadow="true" CssClass="h-100 campaign-card">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="campaign-media">
                                            @if (!string.IsNullOrEmpty(campaign.ImageUrl))
                                            {
                                                <img src="@campaign.ImageUrl" alt="@campaign.CampaignName" class="campaign-img" />
                                            }
                                            else if (!string.IsNullOrEmpty(campaign.VideoUrl))
                                            {
                                                <div class="campaign-video-thumb" onclick="@(() => OpenCampaign(campaign.TrackingCode))">
                                                    <i class="bi bi-play-circle-fill text-primary" style="font-size:2rem;"></i>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="campaign-icon">
                                                    <i class="bi bi-tag-fill text-danger" style="font-size:2rem;"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <h5 class="mb-1">@campaign.CampaignName</h5>
                                            @if (!string.IsNullOrEmpty(campaign.UtmSource))
                                            {
                                                <p class="text-muted small mb-2">
                                                    <i class="bi bi-share"></i> @campaign.UtmSource
                                                </p>
                                            }
                                            <div class="d-flex gap-3 small text-muted mb-3">
                                                <span>
                                                    <i class="bi bi-mouse"></i> @campaign.TotalClicks lượt click
                                                </span>
                                                <span>
                                                    <i class="bi bi-bag-check"></i> @campaign.ConvertedOrders đơn
                                                </span>
                                            </div>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary" OnClick="@(() => OpenCampaign(campaign.TrackingCode))">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i> Xem khuyến mãi
                                                </VanAnButton>
                                                @if (!string.IsNullOrEmpty(campaign.VideoUrl))
                                                {
                                                    <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => OpenVideo(campaign.VideoUrl))">
                                                        <i class="bi bi-play-circle me-1"></i> Xem video
                                                    </VanAnButton>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </VanAnCard>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <VanAnAlert Variant="AlertVariant.Info" Message="Cửa hàng hiện chưa có chương trình khuyến mãi nào. Vui lòng quay lại sau!" />
                }
            </div>
        </VanAnCard>
        }

        <!-- StoreFinder Section (replaces Stats) — show store info for last interaction tenantId -->
        @if (_homeStoreEnabled)
        {
        <VanAnCard CssClass="store-section mb-4">
            <div class="container">
                <h2 class="mb-3">
                    <i class="bi bi-geo-alt-fill text-primary"></i> Cửa Hàng Của Bạn
                </h2>

                @if (_storeLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="mt-2 text-muted">Đang tải thông tin cửa hàng...</p>
                    </div>
                }
                else if (_store != null)
                {
                    <VanAnCard Shadow="true">
                        <div class="d-flex align-items-start gap-3">
                            <div class="store-icon">
                                <i class="bi bi-shop text-primary" style="font-size:2rem;"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="mb-1">@_store.Name</h5>
                                @if (!string.IsNullOrEmpty(_store.Address))
                                {
                                    <p class="text-muted small mb-1">
                                        <i class="bi bi-geo-alt"></i> @_store.Address
                                    </p>
                                }
                                @if (!string.IsNullOrEmpty(_store.Phone))
                                {
                                    <p class="mb-1">
                                        <a href="tel:@_store.Phone" class="text-decoration-none">
                                            <i class="bi bi-telephone"></i> @_store.Phone
                                        </a>
                                    </p>
                                }
                                @if (_store.Latitude.HasValue && _store.Longitude.HasValue)
                                {
                                    <div class="mt-2">
                                        <a href="https://maps.google.com/?q=@_store.Latitude,@_store.Longitude"
                                           target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-map"></i> Chỉ đường
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </VanAnCard>
                }
                else
                {
                    <VanAnAlert Variant="AlertVariant.Info" Message="Không tìm thấy thông tin cửa hàng. Cửa hàng có thể chưa được cấu hình." />
                }
            </div>
        </VanAnCard>
        }
    }

    <!-- Phase 6: Recommended Catalog — Featured products + customer history (replaces multi-VPS product browse) -->
    @if (_homeFeaturedEnabled)
    {
    <VanAnCard CssClass="products-section mb-4">
        <div class="container">
            <h2 class="text-center mb-4">
                <i class="bi bi-star-fill text-warning"></i> Sản Phẩm Nổi Bật
            </h2>
            @if (_catalogLoading)
            {
                <div class="text-center py-4">
                    <VanAnAlert Variant="AlertVariant.Info" Message="Đang tải sản phẩm nổi bật..." />
                </div>
            }
            else if (_catalog != null && _catalog.Products.Any(p => p.Source == "Featured"))
            {
                <div class="row">
                    @foreach (var item in _catalog.Products.Where(p => p.Source == "Featured").Take(8))
                    {
                        var imgId = $"featured-img-{item.ProductId:N}";
                        <div class="col-md-3 mb-3 feature-card">
                            <VanAnCard CssClass="product-card h-100">
                                <div class="product-image">
                                    <img id="@imgId"
                                         src="@(string.IsNullOrEmpty(item.ImageUrl) ? $"https://placehold.co/400x300?text={System.Uri.EscapeDataString(item.DisplayName)}" : item.ImageUrl)"
                                         class="card-img-top"
                                         alt="@item.DisplayName"
                                         style="height: 200px; object-fit: cover;" />
                                </div>
                                <div class="product-info">
                                    <h5>@item.DisplayName</h5>
                                    @if (!string.IsNullOrEmpty(item.TenantName))
                                    {
                                        <p class="text-muted small mb-1"><i class="bi bi-shop"></i> @item.TenantName</p>
                                    }
                                    <p class="text-muted small">@item.Description</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="h5 text-primary mb-0">@CurrencyHelper.FormatVND(item.DisplayPrice)</span>
                                        <VanAnButton Size="ButtonSize.Small" Icon="cart-plus" OnClick="@(() => AddFeaturedToCart(item, imgId))">
                                            Mua
                                        </VanAnButton>
                                    </div>
                                </div>
                            </VanAnCard>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="col-12 text-center">
                    <VanAnAlert Variant="AlertVariant.Info" Message="Chưa có sản phẩm nổi bật. Vui lòng quay lại sau." />
                </div>
            }
        </div>
    </VanAnCard>

    <!-- Phase 6: Customer History Section (only shown if logged in + has history) -->
    @if (_catalog != null && _catalog.Products.Any(p => p.Source == "History"))
    {
        <VanAnCard CssClass="recommendations-section mb-4">
            <div class="container">
                <h2 class="text-center mb-4">
                    <i class="bi bi-clock-history text-info"></i> Gợi Ý Dựa Trên Lịch Sử Mua Hàng
                </h2>
                <div class="row">
                    @foreach (var item in _catalog.Products.Where(p => p.Source == "History").Take(4))
                    {
                        <div class="col-md-3 mb-3">
                            <VanAnCard CssClass="product-card h-100">
                                <div class="product-image">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? $"https://placehold.co/400x300?text={System.Uri.EscapeDataString(item.DisplayName)}" : item.ImageUrl)"
                                         class="card-img-top"
                                         alt="@item.DisplayName"
                                         style="height: 180px; object-fit: cover;" />
                                </div>
                                <div class="product-info">
                                    <h6>@item.DisplayName</h6>
                                    @if (!string.IsNullOrEmpty(item.TenantName))
                                    {
                                        <small class="text-muted d-block mb-1"><i class="bi bi-shop"></i> @item.TenantName</small>
                                    }
                                    <small class="text-muted">Mua lần cuối: @(item.LastOrderedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</small>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="text-primary fw-bold">@CurrencyHelper.FormatVND(item.DisplayPrice)</span>
                                        <VanAnButton Size="ButtonSize.Small" Icon="qr-code-scan" OnClick="@(() => Navigation.NavigateTo("/scan"))">
                                            Mua lại
                                        </VanAnButton>
                                    </div>
                                </div>
                            </VanAnCard>
                        </div>
                    }
                </div>
            </div>
        </VanAnCard>
    }

    <!-- Recently Viewed Section -->
    @if (recentlyViewed != null && recentlyViewed.Any())
    {
        <VanAnCard CssClass="recently-viewed-section mb-4">
            <div class="container">
                <h2 class="text-center mb-4">
                    <i class="bi bi-clock-history text-info"></i> Đã Xem Gần Đây
                </h2>
                <div class="row">
                    @foreach (var item in recentlyViewed.Take(4))
                    {
                        <div class="col-md-3 mb-3">
                            <VanAnCard CssClass="product-card h-100">
                                <div class="product-image">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? $"https://placehold.co/400x300?text={System.Uri.EscapeDataString(item.Name)}" : item.ImageUrl)" 
                                         class="card-img-top" 
                                         alt="@item.Name" 
                                         style="height: 180px; object-fit: cover;" />
                                </div>
                                <div class="product-info">
                                    <h6>@item.Name</h6>
                                    @if (!string.IsNullOrEmpty(item.TenantName))
                                    {
                                        <small class="text-muted d-block mb-1"><i class="bi bi-shop"></i> @item.TenantName</small>
                                    }
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="text-primary fw-bold">@item.Price.ToString("N0")đ</span>
                                        <VanAnButton Size="ButtonSize.Small" Icon="qr-code-scan" OnClick="@(() => Navigation.NavigateTo("/scan"))">
                                            Scan QR để mua
                                        </VanAnButton>
                                    </div>
                                </div>
                            </VanAnCard>
                        </div>
                    }
                </div>
            </div>
        </VanAnCard>
    }
    }

    <!-- Social Hub: render real shop social links from ShopConfig (Phase 3 wire-up) -->
    @if (_homeSocialHubEnabled)
    {
    <SocialHub ShopConfig="@_shopConfig" />
    }
</KhachLinkLayout>

<style>
    .campaign-media { flex-shrink: 0; width: 100px; height: 100px; overflow: hidden; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: #f8f9fa; }
    .campaign-img { width: 100%; height: 100%; object-fit: cover; }
    .campaign-video-thumb { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; cursor: pointer; background: linear-gradient(135deg, #e9ecef, #dee2e6); }
    .campaign-icon { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #fff3f3; border-radius: 8px; }
    .store-finder-cta { border-radius: 16px; }
    /* Issue #142: Home search box — Google Maps style */
    .home-search-box-wrapper { max-width: 640px; margin: 0 auto; }
    .home-search-box { border-radius: 9999px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .home-search-box .form-control:focus { box-shadow: none; }
    .home-voice-mic-btn { border-radius: 0; }
    .home-voice-mic-btn.recording { animation: mic-pulse 1s infinite; }
    .home-search-go-btn { border-radius: 0 9999px 9999px 0; }
    @@keyframes mic-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
</style>

@code {
    private VanAn.KhachLink.Services.CartState cartState = null!;
    private List<ProductDto> products = new();
    private List<RecommendedProductDto> recommendedProducts = new();
    private List<ProductDto> recentlyViewed = new();
    private ShopConfig? _shopConfig;
    private bool _isLoggedIn = false;
    private bool _vatDisplayEnabled = true;
    // #100.2: Home section toggles (loaded from feature settings)
    private bool _homeCampaignEnabled = true;
    private bool _homeStoreEnabled = true;
    private bool _homeFeaturedEnabled = true;
    private bool _homeSocialHubEnabled = true;

    // Phase 6: Catalog recommended (Featured + History) — replaces multi-VPS product browse
    private RecommendedCatalogResponse? _catalog;
    private bool _catalogLoading = true;
    private Guid? _customerId;

    // Campaign + Store sections (replace Hero + Stats) — personalized by last interaction tenantId
    private List<SocialCampaign> _campaigns = new();
    private bool _campaignLoading = true;
    private StoreInfoDto? _store;
    private bool _storeLoading = true;
    private Guid? _lastTenantId;

    // Sprint 7: Commerce Mode badge
    private bool _commerceModeLoaded = false;
    private bool _isReseller = false;

    // Issue #142: Home voice search box — Google Maps style
    private string _homeSearchKeyword = "";
    private bool _homeVoiceEnabled = false;
    private bool _homeSpeechSupported = false;
    private bool _homeVoiceRecording = false;
    private string? _homeVoiceError;
    private DotNetObjectReference<Home>? _homeVoiceDotNetRef;

    public class StoreInfoDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        cartState = CartService.GetCartState();
        CartService.OnCartChanged += StateHasChanged;
        // Phase 1 (fast, localStorage): cart + recently viewed — no HTTP, runs in parallel
        await Task.WhenAll(
            CartService.LoadCartFromStorageAsync(),
            LoadRecentlyViewedAsync()
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if user is logged in (customer_token in localStorage)
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            _isLoggedIn = !string.IsNullOrEmpty(token);

            // Phase 6: Load customerId from localStorage if logged in
            if (_isLoggedIn)
            {
                var cidStr = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_id");
                if (Guid.TryParse(cidStr, out var cid) && cid != Guid.Empty)
                    _customerId = cid;
            }

            // Phase 2 (parallel HTTP): products + catalog + campaigns/store + VAT toggle + commerce mode + store finder
            // All 6 HTTP calls run concurrently → total wait = slowest call (not sum of all)
            var productsTask = LoadProductsAsync();
            var catalogTask = LoadCatalogAsync();
            var tenantDataTask = LoadLastTenantDataAsync();
            var commerceModeTask = LoadCommerceModeAsync(token);

            // Store Finder: do NOT auto-load stores on home page.
            // Only show search box / location-share prompt — user must explicitly trigger search.
            // (Issue fix: home page was showing full store list on load — should only show search box.)

            // VAT toggle (needs tenantId — fast, may fail silently)
            Guid tenantId = TenantService.GetCurrentTenantId();
            Task vatTask = Task.CompletedTask;
            if (tenantId != Guid.Empty)
            {
                vatTask = FeatureSettings.IsEnabledAsync(tenantId, nameof(VanAn.Shared.Services.ShopFeatureSettingsDto.VAT_Display_Enabled))
                    .ContinueWith(t =>
                    {
                        if (t.IsCompletedSuccessfully) _vatDisplayEnabled = t.Result;
                    }, TaskScheduler.Default);
            }

            // #100: Home section toggles — GLOBAL (no tenantId needed, always load)
            Task homeTogglesTask = LoadHomeSectionTogglesAsync();

            await Task.WhenAll(productsTask, catalogTask, tenantDataTask, vatTask, homeTogglesTask, commerceModeTask);

            // Phase 3 (dependent): ShopConfig needs products list (derived from product TenantIds)
            await LoadShopConfigAsync();

            // Issue #142: init voice search on home (reuses wwwroot/js/voice-note.js)
            await InitHomeVoiceSearchAsync();

            StateHasChanged();
        }
    }

    /// <summary>
    /// Issue #142: Initialize voice search for the home search box.
    /// Reuses voice-note.js (loaded via index.html). targetId = null → JS won't fill
    /// any element; transcript is delivered via SetTranscriptionText JSInvokable.
    /// </summary>
    private async Task InitHomeVoiceSearchAsync()
    {
        try
        {
            _homeVoiceEnabled = await FeatureSettings.IsEnabledAsync(
                new Guid("00000000-0000-0000-0000-000000000001"),
                nameof(VanAn.Shared.Services.ShopFeatureSettingsDto.Voice_Note_Enabled));
            if (_homeVoiceEnabled)
            {
                _homeSpeechSupported = await JSRuntime.InvokeAsync<bool>("isSpeechRecognitionSupported");
                if (_homeSpeechSupported)
                {
                    _homeVoiceDotNetRef = DotNetObjectReference.Create(this);
                    // targetId = null: JS dispatches transcript via SetTranscriptionText only
                    await JSRuntime.InvokeVoidAsync("initializeSpeechRecognition", _homeVoiceDotNetRef, null);
                }
            }
        }
        catch
        {
            // Non-critical — voice mic hidden if feature flag off or speech unsupported
        }
    }

    /// <summary>Issue #142: Submit home search → navigate to /stores?q=keyword</summary>
    private void SubmitHomeSearch()
    {
        var keyword = _homeSearchKeyword?.Trim() ?? "";
        var url = string.IsNullOrWhiteSpace(keyword) ? "/stores" : $"/stores?q={Uri.EscapeDataString(keyword)}";
        Navigation.NavigateTo(url);
    }

    /// <summary>Issue #142: Enter key on home search input → submit</summary>
    private void OnHomeSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SubmitHomeSearch();
        }
    }

    /// <summary>Issue #142: Toggle voice recording on home search box</summary>
    private async Task ToggleHomeVoiceSearch()
    {
        _homeVoiceError = null;
        if (_homeVoiceRecording)
        {
            _homeVoiceRecording = false;
            await JSRuntime.InvokeVoidAsync("stopRecording");
        }
        else
        {
            _homeSearchKeyword = "";
            _homeVoiceRecording = true;
            await JSRuntime.InvokeVoidAsync("startRecording");
        }
        StateHasChanged();
    }

    /// <summary>Issue #142: JSInvokable — receives voice transcript → navigate to /stores</summary>
    [JSInvokable]
    public void SetTranscriptionText(string transcript)
    {
        _homeSearchKeyword = transcript ?? "";
        _homeVoiceRecording = false;
        var keyword = _homeSearchKeyword.Trim();
        var url = string.IsNullOrWhiteSpace(keyword) ? "/stores" : $"/stores?q={Uri.EscapeDataString(keyword)}";
        Navigation.NavigateTo(url);
    }

    /// <summary>Issue #142: JSInvokable — recording ended (matches voice-note.js callback)</summary>
    [JSInvokable]
    public void OnRecordingEnd()
    {
        _homeVoiceRecording = false;
        StateHasChanged();
    }

    /// <summary>Issue #142: JSInvokable — voice error</summary>
    [JSInvokable]
    public void OnVoiceError(string errorMessage)
    {
        _homeVoiceRecording = false;
        _homeVoiceError = errorMessage;
        StateHasChanged();
    }

    /// <summary>
    /// #100: Load home section toggles from GLOBAL settings (not per-tenant).
    /// SystemAdmin configures these globally via Gateway API — no tenant context needed.
    /// Silent failure — defaults to ON (all sections visible).
    /// </summary>
    private async Task LoadHomeSectionTogglesAsync()
    {
        try
        {
            var settings = await HomeSettingsService.GetSettingsAsync();
            if (settings != null)
            {
                _homeCampaignEnabled = settings.Home_CampaignSection_Enabled;
                _homeStoreEnabled = settings.Home_StoreSection_Enabled;
                _homeFeaturedEnabled = settings.Home_FeaturedSection_Enabled;
                _homeSocialHubEnabled = settings.Home_SocialHub_Enabled;
            }
        }
        catch
        {
            // Defaults: all sections visible
        }
    }

    /// <summary>
    /// Load campaigns + store info for the tenant the customer most recently interacted with.
    /// Sprint 7: Load commerce mode (Marketplace/Reseller) for UI badge.
    /// Silent failure — badge just doesn't show if API unavailable.
    /// </summary>
    private async Task LoadCommerceModeAsync(string? token)
    {
        try
        {
            if (string.IsNullOrEmpty(token)) return;
            var result = await CommunityHttp.GetCommerceModeAsync(token);
            if (result.Success)
            {
                _isReseller = result.IsReseller;
                _commerceModeLoaded = true;
            }
        }
        catch { /* silent — badge is optional */ }
    }

    /// <summary>
    /// Falls back to empty state with CTA if no interaction recorded (new user).
    /// </summary>
    private async Task LoadLastTenantDataAsync()
    {
        _lastTenantId = await LastInteractionService.GetLastTenantIdAsync();

        if (_lastTenantId.HasValue && _lastTenantId.Value != Guid.Empty)
        {
            // Parallel load: campaigns + store info
            var campaignTask = LoadCampaignsAsync(_lastTenantId.Value);
            var storeTask = LoadStoreInfoAsync(_lastTenantId.Value);
            await Task.WhenAll(campaignTask, storeTask);
        }
        else
        {
            // New user — no interaction yet. Show empty state with CTA.
            _campaignLoading = false;
            _storeLoading = false;
        }
    }

    private async Task LoadCampaignsAsync(Guid tenantId)
    {
        _campaignLoading = true;
        try
        {
            _campaigns = await CampaignService.GetCampaignsByTenantAsync(tenantId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading campaigns for tenant {tenantId}: {ex.Message}");
            _campaigns = new();
        }
        finally
        {
            _campaignLoading = false;
        }
    }

    private async Task LoadStoreInfoAsync(Guid tenantId)
    {
        _storeLoading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("gateway");
            var response = await client.GetAsync($"/api/tenants/{tenantId}/store-info");
            if (response.IsSuccessStatusCode)
            {
                _store = await response.Content.ReadFromJsonAsync<StoreInfoDto>();
            }
            else
            {
                _store = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading store info for tenant {tenantId}: {ex.Message}");
            _store = null;
        }
        finally
        {
            _storeLoading = false;
        }
    }

    private async Task LoadProductsAsync()
    {
        // Bug 3: Load products grouped by tenant (top 5 tenants, 1-2 products each)
        // Phase 6: Still used for ShopConfig derivation (branding). Catalog display uses _catalog.
        try
        {
            products = await ProductService.GetProductsGroupedByTenantAsync();
