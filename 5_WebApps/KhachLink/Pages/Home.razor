@using VanAn.KhachLink.Components.Layout
@using VanAn.Shared.Domain
@using VanAn.Shared.DTOs
@using VanAn.KhachLink.Models
@using VanAn.KhachLink.Components
@using VanAn.KhachLink.Services.Http
@page "/home"
@page "/"
@inject VanAn.KhachLink.Services.CartService CartService
@inject NavigationManager Navigation
@inject IThemeProvider ThemeProvider
@inject ITenantService TenantService
@inject VanAn.KhachLink.Services.Http.ProductHttpService ProductService
@inject VanAn.KhachLink.Services.Http.ShopConfigHttpService ShopConfigService
@inject VanAn.KhachLink.Services.RecentlyViewedService RecentlyViewedService
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<Home> HomeLogger
@implements IDisposable

<PageTitle>KhachLink - Cỗ Máy Giữ Khách Vạn An</PageTitle>

<!-- Toast Notification -->
@if (_toastMessage != null)
{
    <div class="vanan-toast vanan-toast-@(_toastType ?? "success")">
        <i class="bi bi-check-circle-fill"></i>
        <span>@_toastMessage</span>
    </div>
}

<!-- Cart Drawer Component -->
<CartDrawer
    CartItems="@cartState.Items"
    TotalAmount="@cartState.TotalAmount"
    RemoveFromCart="async (productId) => await CartService.RemoveItemAsync(productId)"
    Checkout="async () => await GoToCheckout()" />

<KhachLinkLayout>
    <!-- Hero Section -->
    <VanAnCard CssClass="hero-section text-center py-5 mb-4">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">
                <i class="bi bi-link-45deg"></i> KhachLink
            </h1>
            <p class="lead mb-4">Cỗ máy O2O Flywheel - Giữ khách & Tăng doanh thu</p>
            <div class="d-flex justify-content-center gap-3">
                <VanAnButton Icon="cart" OnClick="@(() => Navigation.NavigateTo("/cart"))" data-testid="home-btn-cart">
                    Xem Giỏ Hàng
                </VanAnButton>
                <VanAnButton Variant="ButtonVariant.Outline" Icon="qr-code-scan" OnClick="@(() => Navigation.NavigateTo("/scan"))" data-testid="home-btn-scan">
                    Quét QR
                </VanAnButton>
                <VanAnButton Variant="ButtonVariant.Outline" Icon="phone" OnClick="@(() => Navigation.NavigateTo("/contact"))" data-testid="home-btn-contact">
                    Liên Hệ
                </VanAnButton>
            </div>
        </div>
    </VanAnCard>

    <!-- Stats Section (Phase 4 wire-up: real data from GET /api/dashboard/shop-metrics/{shopId}) -->
    <VanAnCard CssClass="stats-section mb-4">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-3">
                    <div class="stat-item">
                        <i class="bi bi-people text-primary fs-1"></i>
                        <h3>@(_shopStats?.TotalCustomers.ToString("N0") ?? "—")</h3>
                        <p>Khách hàng</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <i class="bi bi-cart text-success fs-1"></i>
                        <h3>@(_shopStats?.TotalOrders.ToString("N0") ?? "—")</h3>
                        <p>Đơn hàng</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <i class="bi bi-star text-warning fs-1"></i>
                        <h3>@(_shopStats is not null && _shopStats.AverageRating > 0 ? _shopStats.AverageRating.ToString("F1") : "—")</h3>
                        <p>Đánh giá</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <i class="bi bi-coin text-info fs-1"></i>
                        <h3>@cartState.GetTotalItems()</h3>
                        <p>Sản phẩm</p>
                    </div>
                </div>
            </div>
        </div>
    </VanAnCard>

    <!-- Product Showcase -->
    <VanAnCard CssClass="products-section mb-4">
        <div class="container">
            <h2 class="text-center mb-4">Sản Phẩm Nổi Bật</h2>
            <div class="row">
                @if (products != null && products.Any())
                {
                    @foreach (var item in products)
                    {
                        <!-- feature-card: E2E selector alias (T-02) -->
                        <div class="col-md-4 mb-3 feature-card" data-testid="home-product-card">
                            <VanAnCard CssClass="product-card h-100">
                                <div class="product-image">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? $"https://placehold.co/400x300?text={System.Uri.EscapeDataString(item.Name)}" : item.ImageUrl)" 
                                         class="card-img-top" 
                                         alt="@item.Name" 
                                         style="height: 200px; object-fit: cover;" />
                                </div>
                                <div class="product-info">
                                    <h5>@item.Name</h5>
                                    <p class="text-muted">@item.Description</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="h5 text-primary mb-0">@item.Price.ToString("N0")đ</span>
                                                    <br />
                                                    <small class="text-muted">VAT: @(item.VatRate * 100)%</small>
                                                </div>
                                                <VanAnButton Size="ButtonSize.Small" Icon="cart-plus" OnClick="@(() => AddToCart(item))" data-testid="home-btn-add-to-cart">
                                                    Đặt ngay
                                                </VanAnButton>
                                            </div>
                                </div>
                            </VanAnCard>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center">
                        <VanAnAlert Variant="AlertVariant.Info" Message="Đang tải sản phẩm..." />
                    </div>
                }
            </div>
        </div>
    </VanAnCard>

    <!-- Frequently Bought Section -->
    @if (recommendedProducts != null && recommendedProducts.Any())
    {
        <VanAnCard CssClass="recommendations-section mb-4">
            <div class="container">
                <h2 class="text-center mb-4">
                    <i class="bi bi-star-fill text-warning"></i> Gợi Ý Dựa Trên Lịch Sử Mua Hàng
                </h2>
                <div class="row">
                    @foreach (var item in recommendedProducts.Take(4))
                    {
                        <div class="col-md-3 mb-3">
                            <VanAnCard CssClass="product-card h-100">
                                <div class="product-image">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? $"https://placehold.co/400x300?text={System.Uri.EscapeDataString(item.Name)}" : item.ImageUrl)" 
                                         class="card-img-top" 
                                         alt="@item.Name" 
                                         style="height: 180px; object-fit: cover;" />
                                </div>
                                <div class="product-info">
                                    <h6>@item.Name</h6>
                                    <small class="text-muted">@item.RecommendationReason</small>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="text-primary fw-bold">@item.Price.ToString("N0")đ</span>
                                        <VanAnButton Size="ButtonSize.Small" Icon="cart-plus" OnClick="@(() => AddToCart(item))">
                                            Mua
                                        </VanAnButton>
                                    </div>
                                </div>
                            </VanAnCard>
                        </div>
                    }
                </div>
            </div>
        </VanAnCard>
    }

    <!-- Recently Viewed Section -->
    @if (recentlyViewed != null && recentlyViewed.Any())
    {
        <VanAnCard CssClass="recently-viewed-section mb-4">
            <div class="container">
                <h2 class="text-center mb-4">
                    <i class="bi bi-clock-history text-info"></i> Đã Xem Gần Đây
                </h2>
                <div class="row">
                    @foreach (var item in recentlyViewed.Take(4))
                    {
                        <div class="col-md-3 mb-3">
                            <VanAnCard CssClass="product-card h-100">
                                <div class="product-image">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? $"https://placehold.co/400x300?text={System.Uri.EscapeDataString(item.Name)}" : item.ImageUrl)" 
                                         class="card-img-top" 
                                         alt="@item.Name" 
                                         style="height: 180px; object-fit: cover;" />
                                </div>
                                <div class="product-info">
                                    <h6>@item.Name</h6>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="text-primary fw-bold">@item.Price.ToString("N0")đ</span>
                                        <VanAnButton Size="ButtonSize.Small" Icon="cart-plus" OnClick="@(() => AddToCart(item))">
                                            Mua
                                        </VanAnButton>
                                    </div>
                                </div>
                            </VanAnCard>
                        </div>
                    }
                </div>
            </div>
        </VanAnCard>
    }

    <!-- Social Hub: render real shop social links from ShopConfig (Phase 3 wire-up) -->
    <SocialHub ShopConfig="@_shopConfig" />
</KhachLinkLayout>

<style>
    /* Toast notification — slides in from top, auto-dismisses */
    .vanan-toast {
        position: fixed;
        top: 80px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        animation: vanan-toast-in 0.3s ease-out forwards;
        max-width: 90vw;
    }
    .vanan-toast-success {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
    }
    .vanan-toast-error {
        background: linear-gradient(135deg, #dc3545, #c82333);
        color: white;
    }
    .vanan-toast i {
        font-size: 1.3rem;
    }

    @@keyframes vanan-toast-in {
        0%   { opacity: 0; transform: translateX(-50%) translateY(-30px) scale(0.9); }
        100% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
    }

    /* Button click animation — bounce effect on "Đặt ngay" */
    .product-card :deep(.vanan-btn) {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .product-card :deep(.vanan-btn):active {
        transform: scale(0.92);
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    /* Cart badge pulse when item added */
    .cart-badge-pulse {
        animation: vanan-badge-pulse 0.5s ease-out;
    }
    @@keyframes vanan-badge-pulse {
        0%   { transform: scale(1); }
        50%  { transform: scale(1.4); }
        100% { transform: scale(1); }
    }
</style>

@code {
    private VanAn.KhachLink.Services.CartState cartState = null!;
    private List<ProductDto> products = new();
    private List<RecommendedProductDto> recommendedProducts = new();
    private List<ProductDto> recentlyViewed = new();
    private ShopConfig? _shopConfig;
    private ShopStatsDto? _shopStats;
    private string? _toastMessage;
    private string? _toastType;

    protected override async Task OnInitializedAsync()
    {
        cartState = CartService.GetCartState();
        CartService.OnCartChanged += StateHasChanged;
        await LoadProductsAsync();
        await LoadShopConfigAsync();
        await LoadRecommendedProductsAsync();
        await LoadRecentlyViewedAsync();
        await LoadShopStatsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JSRuntime is only available after hydration (not during static prerender).
            // Load cart from localStorage here, then refresh so the cart count badge updates.
            await CartService.LoadCartFromStorageAsync();
            StateHasChanged();
        }
    }

    private async Task LoadProductsAsync()
    {
        products = await ProductService.GetProductsAsync();
    }

    // Phase 3: derive ShopConfig from products (Approach 2 — product-based TenantId).
    // Anonymous visitors get correct branding without login. Falls back to DefaultShopConfig
    // when no products or any API error (handled inside ShopConfigHttpService).
    private async Task LoadShopConfigAsync()
    {
        _shopConfig = await ShopConfigService.GetShopConfigFromProductsAsync(products);
    }

    // Phase 4 wire-up: fetch real shop totals from Gateway → ShopERP /api/dashboard/shop-metrics/{shopId}.
    // Same endpoint as RealTimeDashboard.razor (staff dashboard), but here we only consume the
    // TotalCustomers / TotalOrders / AverageRating fields for the customer-facing home stats.
    // Failures are non-fatal — UI renders "—" placeholders when _shopStats is null.
    private async Task LoadShopStatsAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("gateway");
            var shopId = TenantService.GetCurrentTenantId();
            var response = await httpClient.GetAsync($"api/dashboard/shop-metrics/{shopId}");
            if (response.IsSuccessStatusCode)
            {
                _shopStats = await response.Content.ReadFromJsonAsync<ShopStatsDto>();
            }
            else
            {
                HomeLogger.LogWarning("Shop stats API returned {Status}: keeping placeholders", response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            HomeLogger.LogWarning(ex, "Failed to load shop stats — UI will show placeholders");
        }
    }

    // Minimal DTO matching only the fields Home page needs from ShopDashboardMetrics.
    // Full DTO lives in RealTimeDashboard.razor (staff) — keeping this one lean on purpose.
    private class ShopStatsDto
    {
        public int TotalCustomers { get; set; }
        public int TotalOrders { get; set; }
        public double AverageRating { get; set; }
    }

    private async Task LoadRecommendedProductsAsync()
    {
        try
        {
            // For MVP, we'll use a dummy customer ID. In production, this would come from authentication
            var customerId = Guid.Parse("00000000-0000-0000-0000-000000000001");
            var tenantId = TenantService.GetCurrentTenantId();
            recommendedProducts = await ProductService.GetRecommendedProductsAsync(customerId, tenantId, 4);
        }
        catch (Exception ex)
        {
            // Silently fail - recommendations are optional
            Console.WriteLine($"Error loading recommended products: {ex.Message}");
        }
    }

    private async Task LoadRecentlyViewedAsync()
    {
        try
        {
            recentlyViewed = await RecentlyViewedService.GetRecentlyViewedAsync();
        }
        catch (Exception ex)
        {
            // Silently fail - recently viewed is optional
            Console.WriteLine($"Error loading recently viewed: {ex.Message}");
        }
    }

    private async Task AddToCart(ProductDto product)
    {
        await CartService.AddItemAsync(product, 1);

        // Track product view
        await RecentlyViewedService.AddToRecentlyViewedAsync(product);
        recentlyViewed = await RecentlyViewedService.GetRecentlyViewedAsync();

        // Show toast notification with animation
        await ShowNotification($"Đã thêm \"{product.Name}\" vào giỏ hàng!", "success");
    }

    private async Task ShowNotification(string message, string type)
    {
        _toastMessage = message;
        _toastType = type;
        StateHasChanged();
        // Auto-dismiss after 2.5 seconds
        await Task.Delay(2500);
        _toastMessage = null;
        StateHasChanged();
    }

    private void GoToCart()
    {
        Navigation.NavigateTo("/cart");
    }

    private async Task GoToCheckout()
    {
        Navigation.NavigateTo("/checkout");
        await Task.Delay(100);
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }
}
