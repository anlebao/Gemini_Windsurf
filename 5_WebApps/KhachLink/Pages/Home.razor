        }
    }

    // Phase 3: derive ShopConfig from products (Approach 2 — product-based TenantId).
    // Anonymous visitors get correct branding without login. Falls back to DefaultShopConfig
    // when no products or any API error (handled inside ShopConfigHttpService).
    private async Task LoadShopConfigAsync()
    {
        _shopConfig = await ShopConfigService.GetShopConfigFromProductsAsync(products);
    }

