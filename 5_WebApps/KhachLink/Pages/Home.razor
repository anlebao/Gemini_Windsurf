@using VanAn.KhachLink.Components.Layout
@using VanAn.Shared.Domain
@using VanAn.Shared.DTOs
@using VanAn.KhachLink.Models
@using VanAn.KhachLink.Components
@using VanAn.KhachLink.Services.Http
@page "/home"
@page "/"
@rendermode InteractiveServer
@inject VanAn.KhachLink.Services.CartService CartService
@inject NavigationManager Navigation
@inject IThemeProvider ThemeProvider
@inject ITenantService TenantService
@inject VanAn.KhachLink.Services.Http.ProductHttpService ProductService
@inject VanAn.KhachLink.Services.Http.ShopConfigHttpService ShopConfigService
@inject VanAn.KhachLink.Services.RecentlyViewedService RecentlyViewedService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>KhachLink - Cỗ Máy Giữ Khách Vạn An</PageTitle>

<!-- Cart Drawer Component -->
<CartDrawer 
    CartItems="@cartState.Items"
    TotalAmount="@cartState.TotalAmount"
    RemoveFromCart="async (productId) => await CartService.RemoveItemAsync(productId)"
    Checkout="async () => await GoToCheckout()" />

<KhachLinkLayout>
    <!-- Hero Section -->
    <VanAnCard CssClass="hero-section text-center py-5 mb-4">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">
                <i class="bi bi-link-45deg"></i> KhachLink
            </h1>
            <p class="lead mb-4">Cỗ máy O2O Flywheel - Giữ khách & Tăng doanh thu</p>
            <div class="d-flex justify-content-center gap-3">
                <VanAnButton Icon="cart" OnClick="@(() => Navigation.NavigateTo("/cart"))">
                    Xem Giỏ Hàng
                </VanAnButton>
                <VanAnButton Variant="ButtonVariant.Outline" Icon="qr-code-scan" OnClick="@(() => Navigation.NavigateTo("/scan"))">
                    Quét QR
                </VanAnButton>
                <VanAnButton Variant="ButtonVariant.Outline" Icon="phone" OnClick="@(() => Navigation.NavigateTo("/contact"))">
                    Liên Hệ
                </VanAnButton>
            </div>
        </div>
    </VanAnCard>

    <!-- Stats Section -->
    <VanAnCard CssClass="stats-section mb-4">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-3">
                    <div class="stat-item">
                        <i class="bi bi-people text-primary fs-1"></i>
                        <h3>1,234</h3>
                        <p>Khách hàng</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <i class="bi bi-cart text-success fs-1"></i>
                        <h3>567</h3>
                        <p>Đơn hàng</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <i class="bi bi-star text-warning fs-1"></i>
                        <h3>4.8</h3>
                        <p>Đánh giá</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <i class="bi bi-coin text-info fs-1"></i>
                        <h3>@cartState.GetTotalItems()</h3>
                        <p>Sản phẩm</p>
                    </div>
                </div>
            </div>
        </div>
    </VanAnCard>

    <!-- Product Showcase -->
    <VanAnCard CssClass="products-section mb-4">
        <div class="container">
            <h2 class="text-center mb-4">Sản Phẩm Nổi Bật</h2>
            <div class="row">
                @if (products != null && products.Any())
                {
                    @foreach (var item in products)
                    {
                        <!-- feature-card: E2E selector alias (T-02) -->
                        <div class="col-md-4 mb-3 feature-card">
                            <VanAnCard CssClass="product-card h-100">
                                <div class="product-image">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? $"https://placehold.co/400x300?text={System.Uri.EscapeDataString(item.Name)}" : item.ImageUrl)" 
                                         class="card-img-top" 
                                         alt="@item.Name" 
                                         style="height: 200px; object-fit: cover;" />
                                </div>
                                <div class="product-info">
                                    <h5>@item.Name</h5>
                                    <p class="text-muted">@item.Description</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="h5 text-primary mb-0">@item.Price.ToString("N0")đ</span>
                                                    <br />
                                                    <small class="text-muted">VAT: @(item.VatRate * 100)%</small>
                                                </div>
                                                <VanAnButton Size="ButtonSize.Small" Icon="cart-plus" OnClick="@(() => AddToCart(item))">
                                                    Đặt ngay
                                                </VanAnButton>
                                            </div>
                                </div>
                            </VanAnCard>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center">
                        <VanAnAlert Variant="AlertVariant.Info" Message="Đang tải sản phẩm..." />
                    </div>
                }
            </div>
        </div>
    </VanAnCard>

    <!-- Frequently Bought Section -->
    @if (recommendedProducts != null && recommendedProducts.Any())
    {
        <VanAnCard CssClass="recommendations-section mb-4">
            <div class="container">
                <h2 class="text-center mb-4">
                    <i class="bi bi-star-fill text-warning"></i> Gợi Ý Dựa Trên Lịch Sử Mua Hàng
                </h2>
                <div class="row">
                    @foreach (var item in recommendedProducts.Take(4))
                    {
                        <div class="col-md-3 mb-3">
                            <VanAnCard CssClass="product-card h-100">
                                <div class="product-image">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? $"https://placehold.co/400x300?text={System.Uri.EscapeDataString(item.Name)}" : item.ImageUrl)" 
                                         class="card-img-top" 
                                         alt="@item.Name" 
                                         style="height: 180px; object-fit: cover;" />
                                </div>
                                <div class="product-info">
                                    <h6>@item.Name</h6>
                                    <small class="text-muted">@item.RecommendationReason</small>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="text-primary fw-bold">@item.Price.ToString("N0")đ</span>
                                        <VanAnButton Size="ButtonSize.Small" Icon="cart-plus" OnClick="@(() => AddToCart(item))">
                                            Mua
                                        </VanAnButton>
                                    </div>
                                </div>
                            </VanAnCard>
                        </div>
                    }
                </div>
            </div>
        </VanAnCard>
    }

    <!-- Recently Viewed Section -->
    @if (recentlyViewed != null && recentlyViewed.Any())
    {
        <VanAnCard CssClass="recently-viewed-section mb-4">
            <div class="container">
                <h2 class="text-center mb-4">
                    <i class="bi bi-clock-history text-info"></i> Đã Xem Gần Đây
                </h2>
                <div class="row">
                    @foreach (var item in recentlyViewed.Take(4))
                    {
                        <div class="col-md-3 mb-3">
                            <VanAnCard CssClass="product-card h-100">
                                <div class="product-image">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? $"https://placehold.co/400x300?text={System.Uri.EscapeDataString(item.Name)}" : item.ImageUrl)" 
                                         class="card-img-top" 
                                         alt="@item.Name" 
                                         style="height: 180px; object-fit: cover;" />
                                </div>
                                <div class="product-info">
                                    <h6>@item.Name</h6>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="text-primary fw-bold">@item.Price.ToString("N0")đ</span>
                                        <VanAnButton Size="ButtonSize.Small" Icon="cart-plus" OnClick="@(() => AddToCart(item))">
                                            Mua
                                        </VanAnButton>
                                    </div>
                                </div>
                            </VanAnCard>
                        </div>
                    }
                </div>
            </div>
        </VanAnCard>
    }

    <!-- Social Hub: render real shop social links from ShopConfig (Phase 3 wire-up) -->
    <SocialHub ShopConfig="@_shopConfig" />

    <!-- FIX-BATCH-5: Wire IdentityUpgradeModal — show after first cart add when anonymous -->
    <IdentityUpgradeModal ShowModal="@_showUpgradeModal"
                          ShopConfig="@_shopConfig"
                          OnDismiss="@DismissUpgradeModal"
                          OnUpgrade="@GoToLogin" />
</KhachLinkLayout>

@code {
    private VanAn.KhachLink.Services.CartState cartState = null!;
    private List<ProductDto> products = new();
    private List<RecommendedProductDto> recommendedProducts = new();
    private List<ProductDto> recentlyViewed = new();
    private ShopConfig? _shopConfig;
    private bool _showUpgradeModal = false;
    private bool _isLoggedIn = false;
    private bool _hasShownUpgradeModal = false;

    protected override async Task OnInitializedAsync()
    {
        cartState = CartService.GetCartState();
        CartService.OnCartChanged += StateHasChanged;
        await CartService.LoadCartFromStorageAsync();
        await LoadProductsAsync();
        await LoadShopConfigAsync();
        await LoadRecommendedProductsAsync();
        await LoadRecentlyViewedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if user is logged in (customer_token in localStorage)
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            _isLoggedIn = !string.IsNullOrEmpty(token);
            StateHasChanged();
        }
    }

    private async Task LoadProductsAsync()
    {
        products = await ProductService.GetProductsAsync();
    }

    // Phase 3: derive ShopConfig from products (Approach 2 — product-based TenantId).
    // Anonymous visitors get correct branding without login. Falls back to DefaultShopConfig
    // when no products or any API error (handled inside ShopConfigHttpService).
    private async Task LoadShopConfigAsync()
    {
        _shopConfig = await ShopConfigService.GetShopConfigFromProductsAsync(products);
    }

    private async Task LoadRecommendedProductsAsync()
    {
        try
        {
            // For MVP, we'll use a dummy customer ID. In production, this would come from authentication
            var customerId = Guid.Parse("00000000-0000-0000-0000-000000000001");
            var tenantId = TenantService.GetCurrentTenantId();
            recommendedProducts = await ProductService.GetRecommendedProductsAsync(customerId, tenantId, 4);
        }
        catch (Exception ex)
        {
            // Silently fail - recommendations are optional
            Console.WriteLine($"Error loading recommended products: {ex.Message}");
        }
    }

    private async Task LoadRecentlyViewedAsync()
    {
        try
        {
            recentlyViewed = await RecentlyViewedService.GetRecentlyViewedAsync();
        }
        catch (Exception ex)
        {
            // Silently fail - recently viewed is optional
            Console.WriteLine($"Error loading recently viewed: {ex.Message}");
        }
    }

    private async Task AddToCart(ProductDto product)
    {
        await CartService.AddItemAsync(product, 1);
        
        // Track product view
        await RecentlyViewedService.AddToRecentlyViewedAsync(product);
        recentlyViewed = await RecentlyViewedService.GetRecentlyViewedAsync();
        
        // Show notification
        await ShowNotification($"Đã thêm {product.Name} vào giỏ hàng!", "success");

        // FIX-BATCH-5: Show identity upgrade modal after first add-to-cart if anonymous
        if (!_isLoggedIn && !_hasShownUpgradeModal)
        {
            _showUpgradeModal = true;
            _hasShownUpgradeModal = true;
            StateHasChanged();
        }
    }

    private async Task ShowNotification(string message, string type)
    {
        // Simple notification - could be enhanced with a proper toast library
        await Task.Delay(100);
    }

    private void GoToCart()
    {
        Navigation.NavigateTo("/cart");
    }

    private async Task GoToCheckout()
    {
        Navigation.NavigateTo("/checkout");
        await Task.Delay(100);
    }

    // FIX-BATCH-5: IdentityUpgradeModal handlers
    private void DismissUpgradeModal()
    {
        _showUpgradeModal = false;
    }

    private void GoToLogin()
    {
        _showUpgradeModal = false;
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }
}
