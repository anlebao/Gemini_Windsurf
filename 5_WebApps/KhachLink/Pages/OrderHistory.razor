@page "/my-orders"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ShopFeatureSettingsHttpService FeatureSettings

<PageTitle>Lá»‹ch sá»­ Ä‘Æ¡n hÃ ng</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width:700px;">
        <h3 class="mb-4">
            <i class="bi bi-bag text-primary"></i> ÄÆ¡n hÃ ng cá»§a tÃ´i
        </h3>

        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Äang táº£i...</span></div>
            </div>
        }
        else if (!_isLoggedIn)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-bag text-muted" style="font-size:3rem;"></i>
                <h5 class="mt-3">ÄÄƒng nháº­p Ä‘á»ƒ xem Ä‘Æ¡n hÃ ng</h5>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToLogin">ÄÄƒng nháº­p</VanAnButton>
            </VanAnCard>
        }
        else
        {
            <!-- Filter tabs -->
            <div class="d-flex gap-2 mb-4 flex-wrap">
                @foreach (var tab in _statusTabs)
                {
                    <button class="btn btn-sm @(tab.Value == _activeStatus ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetStatus(tab.Value)">
                        @tab.Label
                    </button>
                }
            </div>

            @if (_orders.Count == 0)
            {
                <VanAnCard Shadow="true" CssClass="text-center p-5">
                    <i class="bi bi-bag-x text-muted" style="font-size:3rem;"></i>
                    <p class="mt-3 text-muted">KhÃ´ng cÃ³ Ä‘Æ¡n hÃ ng nÃ o.</p>
                </VanAnCard>
            }
            else
            {
                @foreach (var order in _orders)
                {
                    <VanAnCard Shadow="true" CssClass="mb-3 order-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold mb-1">ÄÆ¡n #@order.OrderId.ToString()[^8..]</div>
                                <div class="text-muted small">@order.CreatedAt.ToVietnamString()</div>
                                <div class="text-muted small">@order.ItemCount sáº£n pháº©m</div>
                            </div>
                            <div class="text-end">
                                <span class="badge @GetStatusClass(order.Status) mb-1 d-block">@GetStatusLabel(order.Status)</span>
                                <div class="fw-bold text-primary">@FormatVND(order.TotalPrice)</div>
                                @if (_vatDisplayEnabled && order.TotalVatAmount > 0)
                                {
                                    <small class="text-muted">VAT: @FormatVND(order.TotalVatAmount)</small>
                                }
                            </div>
                        </div>
                        <div class="mt-2">
                            <a href="/order-tracking/@order.OrderId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-search"></i> Theo dÃµi
                            </a>
                        </div>
                    </VanAnCard>
                }

                <!-- Pagination -->
                @if (_totalPages > 1)
                {
                    <div class="d-flex justify-content-center gap-2 mt-3">
                        <VanAnButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                     OnClick="PrevPage">
                            <i class="bi bi-chevron-left"></i>
                        </VanAnButton>
                        <span class="align-self-center text-muted small">@_currentPage / @_totalPages</span>
                        <VanAnButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                     OnClick="NextPage">
                            <i class="bi bi-chevron-right"></i>
                        </VanAnButton>
                    </div>
                }
            }
        }
    </div>
</KhachLinkLayout>

@code {
    private void GoToLogin() => Navigation.NavigateTo("/login");

    private bool _loading = true;
    private bool _isLoggedIn = false;
    private List<OrderDto> _orders = new();
    private int _currentPage = 1;
    private int _totalPages = 1;
    private int _totalCount = 0;
    private const int PageSize = 10;
    private string? _activeStatus = null;
    private bool _vatDisplayEnabled = true;

    private static readonly List<(string Label, string? Value)> _statusTabs = new()
    {
        ("Táº¥t cáº£", null),
        ("Chá» xá»­ lÃ½", "pending"),
        ("Äang lÃ m", "processing"),
        ("HoÃ n thÃ nh", "completed"),
        ("ÄÃ£ há»§y", "cancelled")
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadOrders();
            // RC-7: Load VAT display toggle after orders are loaded.
            // Uses customer token to fetch shop settings â€” tenant is resolved server-side.
            try
            {
                var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
                if (!string.IsNullOrEmpty(token))
                {
                    // Fetch customer profile to get tenantId for feature toggle lookup.
                    var client = HttpClientFactory.CreateClient("gateway");
                    client.DefaultRequestHeaders.Add("X-Customer-Token", token);
                    var profileResp = await client.GetAsync("/api/customers/me");
                    if (profileResp.IsSuccessStatusCode)
                    {
                        var profile = await profileResp.Content.ReadFromJsonAsync<CustomerProfileLite>();
                        if (profile != null && profile.TenantId != Guid.Empty)
                        {
                            _vatDisplayEnabled = await FeatureSettings.IsEnabledAsync(
                                profile.TenantId, nameof(ShopFeatureSettingsDto.VAT_Display_Enabled));
                        }
                    }
                }
            }
            catch { /* non-critical â€” default to true */ }
            StateHasChanged();
        }
    }

    private async Task SetStatus(string? status)
    {
        _activeStatus = status;
        _currentPage = 1;
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        _loading = true;
        try
        {
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (string.IsNullOrEmpty(token)) { _isLoggedIn = false; return; }

            // Issue 10 fix: Also send device ID so guest checkout orders are included
            var deviceId = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_device_id");

            var client = HttpClientFactory.CreateClient("gateway");
            client.DefaultRequestHeaders.Add("X-Customer-Token", token);
            if (!string.IsNullOrEmpty(deviceId))
                client.DefaultRequestHeaders.Add("X-Customer-Device-Id", deviceId);
            var url = $"/api/customerorders?page={_currentPage}&pageSize={PageSize}";
            if (!string.IsNullOrEmpty(_activeStatus)) url += $"&status={_activeStatus}";

            var resp = await client.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<OrdersResult>();
                if (result != null)
                {
                    _orders = result.Orders;
                    _totalCount = result.Total;
                    _totalPages = (int)Math.Ceiling((double)_totalCount / PageSize);
                }
                _isLoggedIn = true;
            }
            else { _isLoggedIn = false; }
        }
        finally { _loading = false; }
    }

    private async Task PrevPage()
    {
        if (_currentPage > 1) { _currentPage--; await LoadOrders(); }
    }

    private async Task NextPage()
    {
        if (_currentPage < _totalPages) { _currentPage++; await LoadOrders(); }
    }

    private static string GetStatusClass(string status) => status switch
    {
        "completed"  => "bg-success",
        "cancelled"  => "bg-danger",
        "processing" => "bg-primary",
        _            => "bg-warning text-dark"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "completed"  => "HoÃ n thÃ nh",
        "cancelled"  => "ÄÃ£ há»§y",
        "processing" => "Äang lÃ m",
        "pending"    => "Chá» xá»­ lÃ½",
        _            => status
    };

    private static string FormatVND(decimal amount) => $"{amount:N0} â‚«";

    private class OrderDto
    {
        public Guid OrderId { get; set; }
        public Guid TenantId { get; set; }
        public string Status { get; set; } = string.Empty;
        public decimal TotalPrice { get; set; }
        public decimal TotalVatAmount { get; set; }
        public DateTime CreatedAt { get; set; }
        public int ItemCount { get; set; }
    }

    // RC-7: Lightweight profile DTO for fetching TenantId to load VAT display toggle.
    private class CustomerProfileLite
    {
        public Guid CustomerId { get; set; }
        public Guid TenantId { get; set; }
        public string FullName { get; set; } = string.Empty;
    }

    private class OrdersResult
    {
        public int Total { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public List<OrderDto> Orders { get; set; } = new();
    }
}
