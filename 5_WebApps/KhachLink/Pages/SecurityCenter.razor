@page "/security"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject SecurityHttpService SecurityHttp

<PageTitle>Bảo mật tài khoản</PageTitle>

<KhachLinkLayout>
    <div class="container py-4">
        <h3 class="mb-2">
            <i class="bi bi-shield-lock text-primary"></i> Bảo mật tài khoản
        </h3>
        <p class="text-muted small mb-4">
            Quản lý passkey, thiết bị và mã khôi phục. Mức bảo vệ không phải là chứng minh danh tính pháp lý.
        </p>

        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div>
            </div>
        }
        else if (!_isLoggedIn)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-lock text-muted" style="font-size:3rem;"></i>
                <h5 class="mt-3">Đăng nhập để xem bảo mật tài khoản</h5>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToLogin">Đăng nhập</VanAnButton>
            </VanAnCard>
        }
        else
        {
            @* U01 onboarding prompt — chỉ khi BASIC và chưa dismiss *@
            @if (_showSetupPrompt)
            {
                <VanAnAlert Variant="AlertVariant.Info" CssClass="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Bạn chưa thiết lập biện pháp bảo vệ nào. <a href="/security/setup">Xem hướng dẫn thiết lập</a></span>
                        <button class="btn btn-sm btn-link" @onclick="DismissSetupPrompt">Ẩn</button>
                    </div>
                </VanAnAlert>
            }

            <VanAnCard Shadow="true" CssClass="mb-3">
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Trạng thái bảo vệ</div>
                            <div class="fs-5 fw-semibold">@_assuranceLabel</div>
                        </div>
                        <span class="badge @_assuranceBadgeClass fs-6">@_assuranceState</span>
                    </div>
                    <div class="row text-center mt-3 g-2">
                        <div class="col-4">
                            <div class="fs-4 fw-bold">@_me?.ActivePasskeyCount</div>
                            <div class="text-muted small">Passkey</div>
                        </div>
                        <div class="col-4">
                            <div class="fs-4 fw-bold">@_me?.ActiveDeviceCount</div>
                            <div class="text-muted small">Thiết bị</div>
                        </div>
                        <div class="col-4">
                            <div class="fs-4 fw-bold">@(_me?.HasRecoveryCodes == true ? "Có" : "Chưa")</div>
                            <div class="text-muted small">Mã khôi phục</div>
                        </div>
                    </div>
                </div>
            </VanAnCard>

            @* ===== Passkey (U03) ===== *@
            <VanAnCard Shadow="true" CssClass="mb-3">
                <div class="card-header bg-transparent fw-semibold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-fingerprint me-2"></i>Passkey</span>
                    <VanAnButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small" OnClick="RegisterPasskey" Disabled="_passkeyBusy">
                        @(_passkeyBusy ? "Đang tạo..." : "Tạo passkey")
                    </VanAnButton>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        Passkey giúp xác thực nhanh và an toàn trên thiết bị này. Passkey có thể được đồng bộ
                        qua nền tảng (Google/Apple) nên không khẳng định chỉ tồn tại trên một thiết bị vật lý.
                    </p>
                    @if (!_webauthnSupported)
                    {
                        <VanAnAlert Message="Thiết bị/trình duyệt của bạn hiện không hỗ trợ passkey. Bạn vẫn có thể dùng mã khôi phục." Variant="AlertVariant.Warning" />
                    }
                    @if (_credentials is { Count: > 0 })
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var cred in _credentials)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <div>Passkey · tạo @cred.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                        <div class="text-muted small">
                                            @(cred.BackupEligible == true ? "Có thể đồng bộ" : "Gắn thiết bị") · dùng gần nhất @(cred.LastUsedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "chưa dùng")
                                        </div>
                                    </div>
                                    <VanAnButton Variant="ButtonVariant.Error" Size="ButtonSize.Small" OnClick="() => RevokePasskey(cred.Id)" Disabled="_actionBusy">Thu hồi</VanAnButton>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted small">Chưa có passkey nào.</div>
                    }
                    @if (_passkeyError is not null)
                    {
                        <VanAnAlert Message="@_passkeyError" Variant="AlertVariant.Error" CssClass="mt-2" />
                    }
                </div>
            </VanAnCard>

            @* ===== Recovery codes (U05) ===== *@
            <VanAnCard Shadow="true" CssClass="mb-3">
                <div class="card-header bg-transparent fw-semibold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-key me-2"></i>Mã khôi phục</span>
                    <VanAnButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small" OnClick="GenerateRecoveryCodes" Disabled="_actionBusy">
                        @(_recoveryStatus?.HasActiveSet == true ? "Tạo lại" : "Tạo mã")
                    </VanAnButton>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        Mỗi mã dùng được một lần khi bạn mất quyền truy cập. Lưu ở nơi riêng tư, không chia sẻ.
                    </p>
                    @if (_recoveryStatus?.HasActiveSet == true)
                    {
                        <div class="text-muted small">
                            Đã tạo ngày @(_recoveryStatus.GeneratedAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—") ·
                            còn <strong>@_recoveryStatus.RemainingCount</strong> mã chưa dùng.
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">Chưa có mã khôi phục.</div>
                    }

                    @if (_newRecoveryCodes is { Count: > 0 })
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            <div class="fw-semibold mb-1">Mã khôi phục mới — chỉ hiển thị lần này, hãy lưu lại:</div>
                            <div class="recovery-code-grid">
                                @foreach (var recoveryCode in _newRecoveryCodes)
                                {
                                    <span class="recovery-code-chip">@recoveryCode</span>
                                }
                            </div>
                            <div class="mt-2 small">Mã cũ (nếu có) đã bị vô hiệu hóa.</div>
                        </div>
                    }
                    @if (_stepUpRequiredMessage is not null)
                    {
                        <VanAnAlert Message="@_stepUpRequiredMessage" Variant="AlertVariant.Warning" CssClass="mt-2" />
                    }
                </div>
            </VanAnCard>

            @* ===== Devices (U07/U08) ===== *@
            <VanAnCard Shadow="true" CssClass="mb-3">
                <div class="card-header bg-transparent fw-semibold">
                    <span><i class="bi bi-phone me-2"></i>Thiết bị</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        ID thiết bị chỉ là tín hiệu rủi ro nội bộ, không phải chứng minh danh tính.
                    </p>
                    @if (_devices is { Count: > 0 })
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var device in _devices)
                            {
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-semibold">@(device.FriendlyName ?? "Thiết bị")</div>
                                            <div class="text-muted small">
                                                @device.DeviceType · @(device.Platform ?? "Không xác định") · thấy lần cuối @device.LastSeenAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                            <div class="text-muted small">
                                                Trạng thái: <span class="badge @DeviceStatusBadge(device.Status)">@DeviceStatusLabel(device.Status)</span>
                                                @(device.ActiveCredentialCount > 0 ? $" · {device.ActiveCredentialCount} passkey" : "")
                                            </div>
                                        </div>
                                        @if (device.Status != "REVOKED")
                                        {
                                            <VanAnButton Variant="ButtonVariant.Error" Size="ButtonSize.Small" OnClick="() => RevokeDevice(device.Id)" Disabled="_actionBusy">Thu hồi</VanAnButton>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted small">Chưa có thiết bị nào được ghi nhận.</div>
                    }
                    @if (_deviceError is not null)
                    {
                        <VanAnAlert Message="@_deviceError" Variant="AlertVariant.Error" CssClass="mt-2" />
                    }
                </div>
            </VanAnCard>

            @* ===== Wave 4 entries (U01/U02/U11) ===== *@
            <VanAnCard Shadow="true" CssClass="mb-3">
                <div class="card-body">
                    <div class="d-flex flex-column gap-2">
                        <a href="/security/setup" class="text-decoration-none">
                            <i class="bi bi-rocket-takeoff me-2 text-primary"></i>Hướng dẫn thiết lập bảo mật
                        </a>
                        <a href="/security/profile" class="text-decoration-none">
                            <i class="bi bi-person-vcard me-2 text-primary"></i>Thông tin cá nhân hỗ trợ
                        </a>
                        <a href="/disputes" class="text-decoration-none">
                            <i class="bi bi-chat-square-text me-2 text-primary"></i>Khiếu nại &amp; tranh chấp
                        </a>
                    </div>
                </div>
            </VanAnCard>

            @* ===== Recovery entry (U06) ===== *@
            <VanAnCard Shadow="true" CssClass="mb-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">Mất quyền truy cập?</div>
                        <div class="text-muted small">Bắt đầu quy trình khôi phục tài khoản.</div>
                    </div>
                    <VanAnButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="GoToRecovery">Bắt đầu</VanAnButton>
                </div>
            </VanAnCard>
        }
    </div>
</KhachLinkLayout>

<style>
    .recovery-code-grid { display: flex; flex-wrap: wrap; gap: 6px; }
    .recovery-code-chip {
        background: #fff; border: 1px solid #dee2e6; border-radius: 6px;
        padding: 2px 8px; font-size: 0.85rem; font-weight: 600;
    }
</style>

@code {
    private bool _loading = true;
    private bool _isLoggedIn = false;
    private string? _customerToken;
    private bool _webauthnSupported = false;

    private SecurityHttpService.TrustProfileSummaryDto? _me;
    private SecurityHttpService.RecoveryCodesStatusDto? _recoveryStatus;
    private List<SecurityHttpService.DeviceCredentialSummaryDto>? _credentials;
    private List<SecurityHttpService.UserDeviceSummaryDto>? _devices;

    private string? _passkeyError;
    private string? _deviceError;
    private string? _stepUpRequiredMessage;
    private IReadOnlyList<string>? _newRecoveryCodes;

    private bool _passkeyBusy;
    private bool _actionBusy;
    private string? _stepUpToken;
    private bool _showSetupPrompt;

    private string _assuranceState => _me?.AssuranceState ?? "BASIC";
    private string _assuranceLabel => _assuranceState switch
    {
        "RECOVERY_READY" => "Đã tăng cường",
        "PROTECTED" => "Cơ bản",
        _ => "Chưa thiết lập"
    };
    private string _assuranceBadgeClass => _assuranceState switch
    {
        "RECOVERY_READY" => "text-bg-success",
        "PROTECTED" => "text-bg-info",
        _ => "text-bg-secondary"
    };

    protected override async Task OnInitializedAsync()
    {
        _customerToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
        _isLoggedIn = !string.IsNullOrEmpty(_customerToken);
        if (!_isLoggedIn)
        {
            _loading = false;
            return;
        }
        _webauthnSupported = await JSRuntime.InvokeAsync<bool>("vananWebAuthn.isSupported");

        await LoadAllAsync();
        var dismissed = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "atrs_setup_dismissed");
        _showSetupPrompt = dismissed is null && _me?.AssuranceState == "BASIC";
        _loading = false;
    }

    private async Task DismissSetupPrompt()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "atrs_setup_dismissed", "1");
        _showSetupPrompt = false;
    }

    private async Task LoadAllAsync()
    {
        _me = await SecurityHttp.GetMeAsync(_customerToken!);
        _recoveryStatus = await SecurityHttp.GetRecoveryCodesStatusAsync(_customerToken!);
        _credentials = (await SecurityHttp.GetCredentialsAsync(_customerToken!))?.ToList();
        _devices = (await SecurityHttp.GetDevicesAsync(_customerToken!))?.ToList();
        StateHasChanged();
    }

    // ===== Passkey (U03) =====
    private async Task RegisterPasskey()
    {
        _passkeyBusy = true;
        _passkeyError = null;
        try
        {
            var fullOrigin = await JSRuntime.InvokeAsync<string>("vananWebAuthn.getOrigin");
            var rpId = DeriveRpId(fullOrigin);

            var begin = await SecurityHttp.BeginRegistrationAsync(_customerToken!, fullOrigin, rpId, null);
            if (begin is null)
            {
                _passkeyError = "Không thể bắt đầu đăng ký passkey. Vui lòng thử lại.";
                return;
            }

            var attestation = await WebAuthnJs.CreateCredentialAsync(JSRuntime, begin.Options);
            if (attestation is null)
            {
                _passkeyError = "Không hoàn tất tạo passkey (hủy bỏ hoặc thiết bị không hỗ trợ).";
                return;
            }

            var finish = await SecurityHttp.FinishRegistrationAsync(_customerToken!, begin.Challenge, fullOrigin, rpId, attestation.Value, null);
            if (finish?.Success != true)
            {
                _passkeyError = finish?.Reason switch
                {
                    "DuplicateCredential" => "Passkey này đã được đăng ký.",
                    "InvalidAttestation" => "Dữ liệu passkey không hợp lệ.",
                    _ => "Không thể lưu passkey. Vui lòng thử lại."
                };
                return;
            }

            await LoadAllAsync();
        }
        finally
        {
            _passkeyBusy = false;
        }
    }

    private async Task RevokePasskey(Guid credentialId)
    {
        _passkeyError = null;
        if (string.IsNullOrEmpty(_stepUpToken))
        {
            _stepUpToken = await PerformPasskeyStepUp();
            if (_stepUpToken is null)
            {
                _passkeyError = "Cần xác thực passkey gần đây để thu hồi. Vui lòng thử lại.";
                return;
            }
        }
        var ok = await SecurityHttp.RevokeCredentialAsync(_customerToken!, _stepUpToken, credentialId);
        if (!ok)
            _passkeyError = "Không thể thu hồi passkey.";
        else
            await LoadAllAsync();
    }

    /// <summary>Step-up: begin → navigator.credentials.get → finish → lấy StepUpToken (amr=passkey).</summary>
    private async Task<string?> PerformPasskeyStepUp()
    {
        _actionBusy = true;
        try
        {
            var fullOrigin = await JSRuntime.InvokeAsync<string>("vananWebAuthn.getOrigin");
            var rpId = DeriveRpId(fullOrigin);
            var begin = await SecurityHttp.BeginAuthenticationAsync(_customerToken!, fullOrigin, rpId);
            if (begin is null) return null;

            var assertion = await WebAuthnJs.GetAssertionAsync(JSRuntime, begin.Options);
            if (assertion is null) return null;

            var finish = await SecurityHttp.FinishAuthenticationAsync(_customerToken!, begin.Challenge, fullOrigin, rpId, assertion.Value);
            return finish?.Success == true ? finish.StepUpToken : null;
        }
        finally
        {
            _actionBusy = false;
        }
    }

    // ===== Recovery codes (U05) =====
    private async Task GenerateRecoveryCodes()
    {
        _stepUpRequiredMessage = null;
        _newRecoveryCodes = null;
        if (string.IsNullOrEmpty(_stepUpToken))
        {
            _stepUpToken = await PerformPasskeyStepUp();
            if (_stepUpToken is null)
            {
                _stepUpRequiredMessage = "Cần xác thực passkey gần đây để tạo mã khôi phục (bảo vệ tài khoản của bạn).";
                return;
            }
        }
        var result = await SecurityHttp.GenerateRecoveryCodesAsync(_customerToken!, _stepUpToken);
        if (result is null)
        {
            _stepUpRequiredMessage = "Không thể tạo mã khôi phục. Vui lòng thử lại.";
            return;
        }
        _newRecoveryCodes = result.Codes;
        await LoadAllAsync();
    }

    // ===== Devices (U07/U08) =====
    private async Task RevokeDevice(Guid deviceId)
    {
        _deviceError = null;
        if (string.IsNullOrEmpty(_stepUpToken))
        {
            _stepUpToken = await PerformPasskeyStepUp();
            if (_stepUpToken is null)
            {
                _deviceError = "Cần xác thực passkey gần đây để thu hồi thiết bị.";
                return;
            }
        }
        var ok = await SecurityHttp.RevokeDeviceAsync(_customerToken!, _stepUpToken, deviceId);
        if (!ok)
            _deviceError = "Không thể thu hồi thiết bị.";
        else
            await LoadAllAsync();
    }

    private void GoToRecovery() => Navigation.NavigateTo("/recovery");
    private void GoToLogin() => Navigation.NavigateTo("/login");

    /// <summary>RP ID = registrable domain của origin (config server-side quyết định; client derive cho consistency).</summary>
    private static string DeriveRpId(string origin)
    {
        if (Uri.TryCreate(origin, UriKind.Absolute, out var uri))
        {
            var host = uri.Host;
            if (host == "localhost" || host.EndsWith(".localhost", StringComparison.OrdinalIgnoreCase))
                return "localhost";
            var parts = host.Split('.');
            return parts.Length >= 2 ? string.Join('.', parts[^2..]) : host;
        }
        return "timlathay.com";
    }

    private static string DeviceStatusLabel(string status) => status switch
    {
        "ACTIVE" => "Hoạt động",
        "REVOKED" => "Đã thu hồi",
        "LOST" => "Đã báo mất",
        "SUSPICIOUS" => "Nghi ngờ",
        _ => "Chờ xác minh"
    };

    private static string DeviceStatusBadge(string status) => status switch
    {
        "ACTIVE" => "text-bg-success",
        "REVOKED" => "text-bg-secondary",
        "LOST" => "text-bg-danger",
        "SUSPICIOUS" => "text-bg-warning",
        _ => "text-bg-light"
    };
}