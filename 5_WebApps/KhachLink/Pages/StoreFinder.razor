<PageTitle>TÃ¬m cá»­a hÃ ng gáº§n báº¡n â€” KhachLink</PageTitle>

<KhachLinkLayout>
    <div class="container py-4 store-finder-page">
        <!-- Hero header -->
        <div class="store-finder-hero text-center mb-4">
            <h1 class="display-5 fw-bold mb-2">
                <i class="bi bi-geo-alt-fill"></i> TÃ¬m cá»­a hÃ ng gáº§n báº¡n
            </h1>
            <p class="text-muted mb-0">KhÃ¡m phÃ¡ cÃ¡c cá»­a hÃ ng trong khu vá»±c cá»§a báº¡n</p>
        </div>

        <!-- Search box -->
        <div class="search-box-wrapper mb-4">
            <div class="search-box-card">
                <div class="input-group input-group-lg">
                    <button type="button" class="input-group-text bg-white border-end-0 btn-search-icon"
                            @onclick="LoadStores" aria-label="TÃ¬m kiáº¿m" title="TÃ¬m kiáº¿m">
