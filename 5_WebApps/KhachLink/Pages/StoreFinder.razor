        else if (_error != null)
        {
            <VanAnAlert Variant="AlertVariant.Warning" Message="@_error" />
            <div class="text-center mt-3">
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="LoadStores">Thá»­ láº¡i</VanAnButton>
            </div>
        }
        else if (_stores.Count == 0)
        {
            <VanAnCard Shadow="true" CssClass="text-center py-5 empty-state-card">
                <i class="bi bi-emoji-frown text-muted mb-3 d-block" style="font-size: 4rem;"></i>
                <h4 class="text-muted">KhÃ´ng tÃ¬m tháº¥y cá»­a hÃ ng nÃ o</h4>
                <p class="text-muted mb-3">
                    @if (!string.IsNullOrWhiteSpace(_searchKeyword))
                    {
                        <span>KhÃ´ng cÃ³ cá»­a hÃ ng phÃ¹ há»£p vá»›i "<strong>@_searchKeyword</strong>".</span>
                    }
                    else if (_userLat.HasValue)
                    {
                        <span>KhÃ´ng cÃ³ cá»­a hÃ ng trong bÃ¡n kÃ­nh @_radiusKm km.</span>
                    }
                    else
                    {
                        <span>ChÆ°a cÃ³ cá»­a hÃ ng nÃ o Ä‘Äƒng kÃ½. HÃ£y quay láº¡i sau!</span>
                    }
                </p>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="LoadAllStores">
                    <i class="bi bi-list me-1"></i> Xem táº¥t cáº£ cá»­a hÃ ng
                </VanAnButton>
            </VanAnCard>
        }
        else
        {
            <p class="text-muted mb-3">
                TÃ¬m tháº¥y <strong>@_stores.Count</strong> cá»­a hÃ ng
                @if (_userLat.HasValue)
                {
                    <span> trong bÃ¡n kÃ­nh @_radiusKm km</span>
                }
                @if (!string.IsNullOrWhiteSpace(_searchKeyword))
                {
                    <span> phÃ¹ há»£p "<strong>@_searchKeyword</strong>"</span>
                }
            </p>
            <div class="row g-3">
                @foreach (var store in _stores)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <VanAnCard Shadow="true" CssClass="h-100 store-card-hover">
