@page "/stores"
@page "/store-finder"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Components.Composite
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Components.Shared
@using VanAn.KhachLink.Services.Http
@using VanAn.UI.Platform.Services
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ShopFeatureSettingsHttpService FeatureSettings
@inject SearchCorrectionStore Corrections
@inject SearchResultCache ResultCache
@implements IDisposable

<PageTitle>Tìm cửa hàng gần bạn — KhachLink</PageTitle>

<KhachLinkLayout>
    @* W3-2 (FR-V4): đồng nhất enforcement — ShowStores=false → redirect + toast *@
    <ProfileGuard RequiredFlag="ShowStores" FeatureName="Cửa hàng">
    <div class="container py-4 store-finder-page">
        <!-- Hero header — W3-2d Pattern A: compact hơn (display-5 → h4) -->
        <div class="store-finder-hero text-center mb-3">
            <h4 class="fw-bold mb-1">
                <i class="bi bi-geo-alt-fill"></i> Tìm cửa hàng gần bạn
            </h4>
            <p class="text-muted small mb-0">Khám phá các cửa hàng trong khu vực của bạn</p>
        </div>

        <!-- Search box — W3-2d: VanAnPublicSearchBar (Pattern A mobile-first + Pattern B DidYouMean) -->
        <div class="search-box-wrapper mb-4">
            <div class="search-box-card">
                <VanAnPublicSearchBar @bind-Value="_searchKeyword"
                                      Pill="true"
                                      Placeholder="Tìm theo tên cửa hàng, sản phẩm, dịch vụ..."
                                      AriaLabel="Tìm cửa hàng"
                                      InputId="search-input"
                                      SearchText="Tìm kiếm"
                                      Loading="_loading"
                                      ShowVoiceButton="@(_voiceSearchEnabled && _speechSupported)"
                                      IsListening="isRecording"
                                      OnVoiceToggle="ToggleVoiceSearch"
                                      OnSearch="OnSearchSubmit"
                                      OnValueChanged="OnSearchValueChanged"
                                      OnCleared="ClearSearch" />
                @if (isRecording)
                {
                    <div class="voice-recording-hint text-danger small mt-2">
                        <span class="recording-dot-inline"></span> Đang ghi âm... nói tên cửa hàng hoặc sản phẩm
                    </div>
                }
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary" OnClick="UseMyLocation">
                        <i class="bi bi-geo-alt me-1"></i> Dùng vị trí của tôi
                    </VanAnButton>
                    <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="LoadAllStores">
                        <i class="bi bi-list me-1"></i> Tất cả cửa hàng
                    </VanAnButton>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <label class="small text-muted mb-0">Bán kính:</label>
                        <select class="form-select form-select-sm" style="width: auto;" value="@_radiusKm" @onchange="OnRadiusChanged">
                            <option value="2">2 km</option>
                            <option value="5">5 km</option>
                            <option value="10">10 km</option>
                            <option value="25">25 km</option>
                            <option value="50">50 km</option>
                            <option value="100">100 km</option>
                        </select>
                    </div>
                </div>
            </div>
            @* W3-2d (Pattern B): fuzzy suggestion chip — backend /api/tenants/search trả didYouMean *@
            <VanAnDidYouMeanChip Suggestion="@_didYouMean" OnApply="ApplyDidYouMean" />
            @* Personalized DidYouMean W2 (tenant scope): auto-resolve — báo rõ + Hoàn tác *@
            @if (_resolvedFrom is not null)
            {
                <VanAnAlert Variant="AlertVariant.Info" CssClass="mb-3 search-learned-note">
                    <i class="bi bi-lightbulb me-1"></i>
                    Đang tìm "<b>@_resolvedName</b>" — đã học từ cách bạn nhập "<i>@_resolvedFrom</i>"
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-2 search-learned-undo" @onclick="UndoResolvedAsync">Hoàn tác</button>
                </VanAnAlert>
            }
        </div>

        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
                <p class="mt-3 text-muted">Đang tìm cửa hàng...</p>
            </div>
        }
        else if (_error != null)
        {
            <VanAnAlert Variant="AlertVariant.Warning" Message="@_error" />
            <div class="text-center mt-3">
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="LoadStores">Thử lại</VanAnButton>
            </div>
        }
        else if (_stores.Count == 0)
        {
            <VanAnCard Shadow="true" CssClass="text-center py-5 empty-state-card">
                <i class="bi bi-emoji-frown text-muted mb-3 d-block" style="font-size: 4rem;"></i>
                <h4 class="text-muted">Không tìm thấy cửa hàng nào</h4>
                <p class="text-muted mb-3">
                    @if (!string.IsNullOrWhiteSpace(_searchKeyword))
                    {
                        <span>Không có cửa hàng phù hợp với "<strong>@_searchKeyword</strong>".</span>
                    }
                    else if (_userLat.HasValue)
                    {
                        <span>Không có cửa hàng trong bán kính @_radiusKm km.</span>
                    }
                    else
                    {
                        <span>Chưa có cửa hàng nào đăng ký. Hãy quay lại sau!</span>
                    }
                </p>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="LoadAllStores">
                    <i class="bi bi-list me-1"></i> Xem tất cả cửa hàng
                </VanAnButton>
            </VanAnCard>
        }
        else
        {
            <p class="text-muted mb-3">
                Tìm thấy <strong>@_stores.Count</strong> cửa hàng
                @if (_userLat.HasValue)
                {
                    <span> trong bán kính @_radiusKm km</span>
                }
                @if (!string.IsNullOrWhiteSpace(_searchKeyword))
                {
                    <span> phù hợp "<strong>@_searchKeyword</strong>"</span>
                }
            </p>
            <div class="row g-3">
                @foreach (var store in _stores)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <VanAnCard Shadow="true" CssClass="h-100 store-card-hover">
                            <div class="d-flex align-items-start gap-3">
                                <div class="store-icon-wrap">
                                    <i class="bi bi-shop-fill" style="font-size: 2rem;"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-1 fw-bold">@store.Name</h5>
                                    @if (!string.IsNullOrEmpty(store.Address))
                                    {
                                        <p class="text-muted small mb-1">
                                            <i class="bi bi-geo-alt"></i> @store.Address
                                        </p>
                                    }
                                    @if (!string.IsNullOrEmpty(store.Phone))
                                    {
                                        <p class="mb-1">
                                            <a href="tel:@store.Phone" class="text-decoration-none">
                                                <i class="bi bi-telephone"></i> @store.Phone
                                            </a>
                                        </p>
                                    }
                                    <div class="d-flex gap-2 align-items-center flex-wrap mt-2">
                                        @if (store.DistanceKm.HasValue)
                                        {
                                            <span class="badge bg-primary rounded-pill">
                                                <i class="bi bi-compass"></i> @store.DistanceKm.Value.ToString("F1") km
                                            </span>
                                        }
                                        @if (store.Latitude.HasValue && store.Longitude.HasValue)
                                        {
                                            <a href="https://maps.google.com/?q=@store.Latitude,@store.Longitude"
                                               target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-map"></i> Chỉ đường
                                            </a>
                                        }
                                    </div>
                                    <div class="mt-2 d-flex gap-2 flex-wrap">
                                        @* Store-context Fix-1 (2026-11-28): same-origin luôn là đường chính —
                                           storefront render mọi tenant trên domain này, ghi context đúng portal
                                           khách đang dùng ("Cửa Hàng Của Bạn" hiện được). Cross-domain chỉ là
                                           option phụ vì localStorage không qua được origin khác. *@
                                        <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary"
                                                     OnClick="@(() => Navigation.NavigateTo(
                                                         !string.IsNullOrEmpty(store.Slug)
                                                             ? $"/store/{store.Slug}"
                                                             : $"/store/by-id/{store.Id}"))">
                                            <i class="bi bi-shop me-1"></i> Xem trang cửa hàng
                                        </VanAnButton>
                                        @if (!string.IsNullOrEmpty(store.KhachLinkDomain))
                                        {
                                            <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                                                         OnClick="@(() => Navigation.NavigateTo(
                                                             $"https://{store.KhachLinkDomain}/store/{store.Slug ?? store.Id.ToString()}",
                                                             forceLoad: true))">
                                                <i class="bi bi-box-arrow-up-right me-1"></i> Portal riêng
                                            </VanAnButton>
                                        }
                                    </div>
                                    @* W3-1/W3-2 (FR-V10): contextual entries — same-origin deep-link,
                                       ?chat=ai mở AI bubble, ?chat=human mở human chat (chứa nút Gọi). *@
                                    @if (store.AiChatEnabled || store.VoiceCallEnabled)
                                    {
                                        <div class="mt-2 d-flex gap-2">
                                            @if (store.AiChatEnabled)
                                            {
                                                <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                                                             OnClick="@(() => GoToStoreChat(store, "ai"))">
                                                    <i class="bi bi-robot me-1"></i> Hỏi AI
                                                </VanAnButton>
                                            }
                                            @if (store.VoiceCallEnabled)
                                            {
                                                <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                                                             OnClick="@(() => GoToStoreChat(store, "human"))">
                                                    <i class="bi bi-telephone me-1"></i> Gọi
                                                </VanAnButton>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </VanAnCard>
                    </div>
                }
            </div>
        }
    </div>
    </ProfileGuard>
</KhachLinkLayout>

<style>
    .store-finder-page { max-width: 1200px; margin: 0 auto; }
    .store-finder-hero h1 { color: var(--bs-primary, #0d6efd); }
    .search-box-wrapper { max-width: 700px; margin: 0 auto; }
    .search-box-card {
        background: white;
        border-radius: 16px;
        padding: 1.25rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }
    .btn-search-icon {
        cursor: pointer;
        border: 1px solid #dee2e6;
        background: #fff;
    }
    .btn-search-icon:hover { background: #f8f9fa; }
    .btn-search-icon:focus { outline: none; box-shadow: none; }
    .store-card-hover { transition: transform 0.2s, box-shadow 0.2s; }
    .store-card-hover:hover { transform: translateY(-4px); box-shadow: 0 8px 32px rgba(0,0,0,0.12) !important; }
    .store-icon-wrap {
        width: 56px; height: 56px;
        background: linear-gradient(135deg, #fff3cd, #ffe5b4);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        color: #d97706;
        flex-shrink: 0;
    }
    .empty-state-card { border-radius: 16px; }
    /* Search Unification v2: pill mic (.listening pulse) lives in
       VanAnPublicSearchBar — .voice-mic-btn dead rules removed.
       voice-pulse keyframe kept for .recording-dot-inline hint. */
    @@keyframes voice-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.1); }
    }
    .recording-dot-inline {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: #dc3545;
        border-radius: 50%;
        margin-right: 4px;
        animation: voice-pulse 1s infinite;
    }
    .voice-recording-hint {
        display: flex;
        align-items: center;
        gap: 2px;
    }
</style>

@code {
    private List<StoreDto> _stores = new();
    private bool _loading = true;
    private string? _error;
    private double _radiusKm = 10.0;
    private double? _userLat;
    private double? _userLng;
    private string _searchKeyword = "";
    private string? _didYouMean;
    private string? _resolvedFrom;      // câu gốc user nhập khi auto-resolve tenant active
    private string? _resolvedName;      // tên đã học (display) — chỉ để render note
    private string? _didYouMeanRaw;     // câu gốc tại thời điểm search (record khi accept)
    private bool _lastInputWasVoice;    // set khi bắt đầu ghi âm → tag source cho record
    private bool _lastSearchWasVoice;
    private System.Threading.CancellationTokenSource? _searchDebounce;
    private System.Threading.CancellationTokenSource? _loadCts;
    // Voice search — reuses wwwroot/js/voice-note.js (loaded via index.html)
    private bool _voiceSearchEnabled = false;
    private bool _speechSupported = false;
    private bool isRecording = false;
    private DotNetObjectReference<StoreFinder>? _voiceDotNetRef;

    protected override async Task OnInitializedAsync()
    {
        // Issue #142: pre-fill search keyword from query string (e.g. /stores?q=cafe)
        // Home page search box navigates here with ?q=<keyword> (text or voice transcript)
        try
        {
            var query = new Uri(Navigation.Uri).Query?.TrimStart('?');
            if (!string.IsNullOrEmpty(query))
            {
                foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
                {
                    var kv = pair.Split('=', 2);
                    if (kv.Length == 2 && kv[0] == "q")
                    {
                        var val = Uri.UnescapeDataString(kv[1]).Trim();
                        if (!string.IsNullOrEmpty(val)) _searchKeyword = val;
                        break;
                    }
                }
            }
        }
        catch { /* non-critical — empty keyword falls back to default load */ }
        await LoadStores();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // vananPWA.getCurrentPosition returns { lat, lng } — property names must match (lat↔Lat).
                var location = await JSRuntime.InvokeAsync<GpsPosition>("vananPWA.getCurrentPosition");
                if (location != null)
                {
                    _userLat = location.Lat;
                    _userLng = location.Lng;
                    await LoadStores();
                    StateHasChanged();
                }
            }
            catch
            {
                // User denied geolocation or not supported — show all stores
            }

            // Voice search: check feature flag + browser support, init speech recognition
            try
            {
                _voiceSearchEnabled = await FeatureSettings.IsEnabledAsync(
                    new Guid("00000000-0000-0000-0000-000000000001"),
                    nameof(ShopFeatureSettingsDto.Voice_Note_Enabled));
                if (_voiceSearchEnabled)
                {
                    _speechSupported = await JSRuntime.InvokeAsync<bool>("isSpeechRecognitionSupported");
                    if (_speechSupported)
                    {
                        _voiceDotNetRef = DotNetObjectReference.Create(this);
                        // targetId = "search-input" → transcript fills the search box directly
                        await JSRuntime.InvokeVoidAsync("initializeSpeechRecognition", _voiceDotNetRef, "search-input");
                    }
                }
                StateHasChanged();
            }
            catch
            {
                // Non-critical — voice search disabled if feature settings fetch fails
            }
        }
    }

    private async Task ToggleVoiceSearch()
    {
        if (isRecording)
        {
            isRecording = false;
            await JSRuntime.InvokeVoidAsync("stopRecording");
        }
        else
        {
            // Clear previous keyword before recording so transcript starts fresh
            _searchKeyword = "";
            _lastInputWasVoice = true;
            isRecording = true;
            await JSRuntime.InvokeVoidAsync("startRecording");
        }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnVoiceRecordingEnd()
    {
        isRecording = false;
        // Trigger search with the transcribed keyword
        await LoadStores();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceError(string errorMessage)
    {
        isRecording = false;
        _error = errorMessage;
        StateHasChanged();
    }

    public void Dispose()
    {
        _voiceDotNetRef?.Dispose();
        _searchDebounce?.Dispose();
        _loadCts?.Dispose();
    }

    // W3-2d: OnValueChanged = debounce gõ phím (giữ behavior cũ 300ms);
    // OnSearch = Enter/button → search ngay (cancel debounce).
    public async Task OnSearchValueChanged(string? value)
    {
        _searchKeyword = value ?? "";
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = new System.Threading.CancellationTokenSource();
        try
        {
            await Task.Delay(300, _searchDebounce.Token);
            await LoadStores(_searchDebounce.Token);
        }
        catch (TaskCanceledException) { /* debounce */ }
    }

    private async Task OnSearchSubmit()
    {
        _searchDebounce?.Cancel();
        await LoadStores();
    }

    /// <summary>W3-2d (Pattern B): 1-tap "Ý bạn là?" → re-search với suggestion.
    /// W2: học cặp (câu gốc → suggestion) trước khi re-search — fail-open.</summary>
    private async Task ApplyDidYouMean(string suggestion)
    {
        try
        {
            await Corrections.RecordAsync(SearchCorrectionStore.ScopeTenant,
                _didYouMeanRaw ?? _searchKeyword, suggestion, _lastSearchWasVoice ? "voice" : "typed");
        }
        catch { /* storage lỗi → vẫn re-search bình thường */ }
        _searchKeyword = suggestion;
        _didYouMean = null;
        await LoadStores();
    }

    /// <summary>Undo auto-resolve: xóa correction đã học + re-search câu gốc →
    /// rơi lại DidYouMean thường.</summary>
    private async Task UndoResolvedAsync()
    {
        var raw = _resolvedFrom;
        _resolvedFrom = null;
        _resolvedName = null;
        try { await Corrections.ForgetAsync(SearchCorrectionStore.ScopeTenant, raw); }
        catch { /* fail-open */ }
        _searchKeyword = raw ?? _searchKeyword;
        await LoadStores();
    }

    private async Task ClearSearch()
    {
        _searchKeyword = "";
        _didYouMean = null;
        _resolvedFrom = null;
        _resolvedName = null;
        await LoadStores();
    }

    private async Task OnRadiusChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var r))
        {
            _radiusKm = r;
        }
        await LoadStores();
    }

    private async Task UseMyLocation()
    {
        try
        {
            var location = await JSRuntime.InvokeAsync<GpsPosition>("vananPWA.getCurrentPosition");
            if (location != null)
            {
                _userLat = location.Lat;
                _userLng = location.Lng;
                await LoadStores();
            }
        }
        catch
        {
            _error = "Không lấy được vị trí. Trình duyệt có thể chặn geolocation.";
        }
    }

    private async Task LoadStores() => await LoadStores(CancellationToken.None);

    private async Task LoadStores(CancellationToken callerCt)
    {
        // A1 (load hardening): request mới cancel in-flight request cũ; caller CT
        // (debounce) linked vào — keystroke mới abort cả HTTP đang chạy.
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = CancellationTokenSource.CreateLinkedTokenSource(callerCt);
        var ct = _loadCts.Token;
        _lastSearchWasVoice = _lastInputWasVoice;
        _lastInputWasVoice = false;
        _loading = true;
        _error = null;
        try
        {
            var client = HttpClientFactory.CreateClient("gateway");
            string url;
            var keyword = _searchKeyword.Trim();
            if (keyword.Length == 1)
            {
                // A2: min-length ≥2 — 1 ký tự không đáng 1 round-trip; giữ list hiện tại.
                _loading = false;
                return;
            }
            if (keyword.Length > 0)
            {
                // Personalized DidYouMean W2 (tenant scope): Level 0 — correction đã
                // học rewrite query trước khi gọi API (localStorage, backend không đổi).
                _didYouMeanRaw = keyword;
                try
                {
                    var learned = await Corrections.ResolveAsync(SearchCorrectionStore.ScopeTenant, keyword, ct);
                    if (!string.IsNullOrWhiteSpace(learned)
                        && !string.Equals(learned, keyword, StringComparison.OrdinalIgnoreCase))
                    {
                        _resolvedFrom = keyword;
                        _resolvedName = learned.Trim();
                        keyword = _resolvedName;
                        _searchKeyword = keyword;
                    }
                    else
                    {
                        _resolvedFrom = null;
                        _resolvedName = null;
                    }
                }
                catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
                catch { _resolvedFrom = null; _resolvedName = null; }

                // A3: client cache 60s — gõ rồi xóa rồi gõ lại không gọi API lần 2.
                if (ResultCache.TryGet<SearchResultDto>("tenant", keyword, out var cached) && cached is not null)
                {
                    _stores = cached.Results;
                    _didYouMean = cached.DidYouMean;
                    _loading = false;
                    return;
                }
                url = $"/api/tenants/search?name={Uri.EscapeDataString(keyword)}";
            }
            else if (_userLat.HasValue && _userLng.HasValue)
            {
                _resolvedFrom = null;
                _resolvedName = null;
                url = $"/api/tenants/nearby?lat={_userLat}&lng={_userLng}&radiusKm={_radiusKm}";
            }
            else
            {
                _resolvedFrom = null;
                _resolvedName = null;
                // No location + no keyword — list all active tenants via search with empty name
                url = "/api/tenants/search";
            }

            var response = await client.GetAsync(url, ct);
            if (response.IsSuccessStatusCode)
            {
                // Issue #166 comment: Gateway now returns TenantSearchResultDto wrapper
                // (Results + SuggestedKeywords + MatchStrategy) instead of bare List<StoreDto>.
                var result = await response.Content.ReadFromJsonAsync<SearchResultDto>(ct);
                _stores = result?.Results ?? new();
                _didYouMean = result?.DidYouMean;
                if (result is not null && keyword.Length > 0)
                    ResultCache.Set("tenant", keyword, result);
            }
            else
            {
                _error = "Không thể tải danh sách cửa hàng. Vui lòng thử lại.";
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Stale request bị abort — không set _error, không động list.
        }
        catch (Exception ex)
        {
            _error = $"Lỗi kết nối: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>W3-1: contextual deep-link — same-origin /store route + ?chat=ai|human.</summary>
    private void GoToStoreChat(StoreDto store, string chatMode)
    {
        var path = !string.IsNullOrEmpty(store.Slug) ? $"/store/{store.Slug}" : $"/store/by-id/{store.Id}";
        Navigation.NavigateTo($"{path}?chat={chatMode}");
    }

    private async Task LoadAllStores()
    {
        _userLat = null;
        _userLng = null;
        _searchKeyword = "";
        _didYouMean = null;
        await LoadStores();
    }

    public class StoreDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public double? DistanceKm { get; set; }
        public string? Slug { get; set; }
        public string? KhachLinkDomain { get; set; }
        // W3-1 (FR-V8): flagship toggles từ Gateway TenantStoreDto — render "Hỏi AI"/"Gọi".
        public bool AiChatEnabled { get; set; }
        public bool VoiceCallEnabled { get; set; }
    }

    /// <summary>Issue #166 comment: Wrapper matching Gateway TenantSearchResultDto.</summary>
    public class SearchResultDto
