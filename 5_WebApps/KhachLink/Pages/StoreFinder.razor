@page "/stores"
@page "/store-finder"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ShopFeatureSettingsHttpService FeatureSettings
@implements IDisposable

<PageTitle>Tìm cửa hàng gần bạn — KhachLink</PageTitle>

<KhachLinkLayout>
    <div class="container py-4 store-finder-page">
        <!-- Hero header -->
        <div class="store-finder-hero text-center mb-4">
            <h1 class="display-5 fw-bold mb-2">
                <i class="bi bi-geo-alt-fill"></i> Tìm cửa hàng gần bạn
            </h1>
            <p class="text-muted mb-0">Khám phá các cửa hàng trong khu vực của bạn</p>
        </div>

        <!-- Search box -->
        <div class="search-box-wrapper mb-4">
            <div class="search-box-card">
                <div class="input-group input-group-lg">
                    <button type="button" class="input-group-text bg-white border-end-0 btn-search-icon"
                            @onclick="LoadStores" aria-label="Tìm kiếm" title="Tìm kiếm">
                        <i class="bi bi-search text-primary"></i>
                    </button>
                    <input type="text" class="form-control border-start-0 ps-0"
                           id="search-input"
                           @bind="_searchKeyword"
                           @oninput="OnSearchInput"
                           @onkeyup="OnSearchKeyUp"
                           placeholder="Tìm theo tên cửa hàng, sản phẩm, dịch vụ..."
                           aria-label="Tìm cửa hàng" />
                    @if (_voiceSearchEnabled && _speechSupported)
                    {
                        <button type="button" class="btn btn-outline-primary voice-mic-btn @(isRecording ? "recording" : "")"
                                OnClick="ToggleVoiceSearch" data-testid="storefinder-btn-voice-mic"
                                title="@(isRecording ? "Dừng ghi âm" : "Nói để tìm kiếm")"
                                aria-label="Tìm kiếm bằng giọng nói">
                            @if (isRecording)
                            {
                                <span class="recording-pulse">⏹️</span>
                            }
                            else
                            {
                                <span>🎤</span>
                            }
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(_searchKeyword))
                    {
                        <button class="btn btn-outline-secondary" type="button" OnClick="ClearSearch">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    }
                </div>
                @if (isRecording)
                {
                    <div class="voice-recording-hint text-danger small mt-2">
                        <span class="recording-dot-inline"></span> Đang ghi âm... nói tên cửa hàng hoặc sản phẩm
                    </div>
                }
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary" OnClick="UseMyLocation">
                        <i class="bi bi-geo-alt me-1"></i> Dùng vị trí của tôi
                    </VanAnButton>
                    <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="LoadAllStores">
                        <i class="bi bi-list me-1"></i> Tất cả cửa hàng
                    </VanAnButton>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <label class="small text-muted mb-0">Bán kính:</label>
                        <select class="form-select form-select-sm" style="width: auto;" value="@_radiusKm" @onchange="OnRadiusChanged">
                            <option value="2">2 km</option>
                            <option value="5">5 km</option>
                            <option value="10">10 km</option>
                            <option value="25">25 km</option>
                            <option value="50">50 km</option>
                            <option value="100">100 km</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
                <p class="mt-3 text-muted">Đang tìm cửa hàng...</p>
            </div>
        }
        else if (_error != null)
        {
            <VanAnAlert Variant="AlertVariant.Warning" Message="@_error" />
            <div class="text-center mt-3">
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="LoadStores">Thử lại</VanAnButton>
            </div>
        }
        else if (_stores.Count == 0)
        {
            <VanAnCard Shadow="true" CssClass="text-center py-5 empty-state-card">
                <i class="bi bi-emoji-frown text-muted mb-3 d-block" style="font-size: 4rem;"></i>
                <h4 class="text-muted">Không tìm thấy cửa hàng nào</h4>
                <p class="text-muted mb-3">
                    @if (!string.IsNullOrWhiteSpace(_searchKeyword))
                    {
                        <span>Không có cửa hàng phù hợp với "<strong>@_searchKeyword</strong>".</span>
                    }
                    else if (_userLat.HasValue)
                    {
                        <span>Không có cửa hàng trong bán kính @_radiusKm km.</span>
                    }
                    else
                    {
                        <span>Chưa có cửa hàng nào đăng ký. Hãy quay lại sau!</span>
                    }
                </p>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="LoadAllStores">
                    <i class="bi bi-list me-1"></i> Xem tất cả cửa hàng
                </VanAnButton>
            </VanAnCard>
        }
        else
        {
            <p class="text-muted mb-3">
                Tìm thấy <strong>@_stores.Count</strong> cửa hàng
                @if (_userLat.HasValue)
                {
                    <span> trong bán kính @_radiusKm km</span>
                }
                @if (!string.IsNullOrWhiteSpace(_searchKeyword))
                {
                    <span> phù hợp "<strong>@_searchKeyword</strong>"</span>
                }
            </p>
            <div class="row g-3">
                @foreach (var store in _stores)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <VanAnCard Shadow="true" CssClass="h-100 store-card-hover">
                            <div class="d-flex align-items-start gap-3">
                                <div class="store-icon-wrap">
                                    <i class="bi bi-shop-fill" style="font-size: 2rem;"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-1 fw-bold">@store.Name</h5>
                                    @if (!string.IsNullOrEmpty(store.Address))
                                    {
                                        <p class="text-muted small mb-1">
                                            <i class="bi bi-geo-alt"></i> @store.Address
                                        </p>
                                    }
                                    @if (!string.IsNullOrEmpty(store.Phone))
                                    {
                                        <p class="mb-1">
                                            <a href="tel:@store.Phone" class="text-decoration-none">
                                                <i class="bi bi-telephone"></i> @store.Phone
                                            </a>
                                        </p>
                                    }
                                    <div class="d-flex gap-2 align-items-center flex-wrap mt-2">
                                        @if (store.DistanceKm.HasValue)
                                        {
                                            <span class="badge bg-primary rounded-pill">
                                                <i class="bi bi-compass"></i> @store.DistanceKm.Value.ToString("F1") km
                                            </span>
                                        }
                                        @if (store.Latitude.HasValue && store.Longitude.HasValue)
                                        {
                                            <a href="https://maps.google.com/?q=@store.Latitude,@store.Longitude"
                                               target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-map"></i> Chỉ đường
                                            </a>
                                        }
                                    </div>
                                    <div class="mt-2 d-flex gap-2">
                                        @if (!string.IsNullOrEmpty(store.Slug))
                                        {
                                            <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary"
                                                         OnClick="@(() => Navigation.NavigateTo($"/store/{store.Slug}"))">
                                                <i class="bi bi-shop me-1"></i> Xem trang cửa hàng
                                            </VanAnButton>
                                        }
                                        else
                                        {
                                            <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                                                         OnClick="@(() => Navigation.NavigateTo($"/store/by-id/{store.Id}"))">
                                                <i class="bi bi-eye me-1"></i> Xem trang cửa hàng
                                            </VanAnButton>
                                        }
                                        @if (!string.IsNullOrEmpty(store.KhachLinkDomain))
                                        {
                                            <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary"
                                                         OnClick="@(() => Navigation.NavigateTo(
                                                             $"https://{store.KhachLinkDomain}/store/{store.Slug ?? store.Id.ToString()}",
                                                             forceLoad: true))">
                                                <i class="bi bi-box-arrow-up-right me-1"></i> Tìm hiểu
                                            </VanAnButton>
                                        }
                                    </div>
                                </div>
                            </div>
                        </VanAnCard>
                    </div>
                }
            </div>
        }
    </div>
</KhachLinkLayout>

<style>
    .store-finder-page { max-width: 1200px; margin: 0 auto; }
    .store-finder-hero h1 { color: var(--bs-primary, #0d6efd); }
    .search-box-wrapper { max-width: 700px; margin: 0 auto; }
    .search-box-card {
        background: white;
        border-radius: 16px;
        padding: 1.25rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }
    .search-box-card .input-group-text { border-radius: 12px 0 0 12px; }
    .search-box-card .form-control { border-radius: 0 12px 12px 0; }
    .search-box-card .form-control:focus { box-shadow: none; border-color: #dee2e6; }
    .btn-search-icon {
        cursor: pointer;
        border: 1px solid #dee2e6;
        background: #fff;
    }
    .btn-search-icon:hover { background: #f8f9fa; }
    .btn-search-icon:focus { outline: none; box-shadow: none; }
    .store-card-hover { transition: transform 0.2s, box-shadow 0.2s; }
    .store-card-hover:hover { transform: translateY(-4px); box-shadow: 0 8px 32px rgba(0,0,0,0.12) !important; }
    .store-icon-wrap {
        width: 56px; height: 56px;
        background: linear-gradient(135deg, #fff3cd, #ffe5b4);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        color: #d97706;
        flex-shrink: 0;
    }
    .empty-state-card { border-radius: 16px; }
    /* Voice mic button — inline in search input group */
    .voice-mic-btn {
        border-radius: 0;
        width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: all 0.2s ease;
    }
    .voice-mic-btn.recording {
        background: #dc3545;
        color: white;
        border-color: #dc3545;
        animation: voice-pulse 1s infinite;
    }
    .voice-mic-btn .recording-pulse {
        animation: voice-pulse 0.8s infinite;
    }
    @@keyframes voice-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.1); }
    }
    .recording-dot-inline {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: #dc3545;
        border-radius: 50%;
        margin-right: 4px;
        animation: voice-pulse 1s infinite;
    }
    .voice-recording-hint {
        display: flex;
        align-items: center;
        gap: 2px;
    }
</style>

@code {
    private List<StoreDto> _stores = new();
    private bool _loading = true;
    private string? _error;
    private double _radiusKm = 10.0;
    private double? _userLat;
    private double? _userLng;
    private string _searchKeyword = "";
    private System.Threading.CancellationTokenSource? _searchDebounce;
    // Voice search — reuses wwwroot/js/voice-note.js (loaded via index.html)
    private bool _voiceSearchEnabled = false;
    private bool _speechSupported = false;
    private bool isRecording = false;
    private DotNetObjectReference<StoreFinder>? _voiceDotNetRef;

    protected override async Task OnInitializedAsync()
    {
        // Issue #142: pre-fill search keyword from query string (e.g. /stores?q=cafe)
        // Home page search box navigates here with ?q=<keyword> (text or voice transcript)
        try
        {
            var query = new Uri(Navigation.Uri).Query?.TrimStart('?');
            if (!string.IsNullOrEmpty(query))
            {
                foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
                {
                    var kv = pair.Split('=', 2);
                    if (kv.Length == 2 && kv[0] == "q")
                    {
                        var val = Uri.UnescapeDataString(kv[1]).Trim();
                        if (!string.IsNullOrEmpty(val)) _searchKeyword = val;
                        break;
                    }
                }
            }
        }
        catch { /* non-critical — empty keyword falls back to default load */ }
        await LoadStores();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var location = await JSRuntime.InvokeAsync<GeolocationResult>("vananPWA.getCurrentPosition");
                if (location != null)
                {
                    _userLat = location.Latitude;
                    _userLng = location.Longitude;
                    await LoadStores();
                    StateHasChanged();
                }
            }
            catch
            {
                // User denied geolocation or not supported — show all stores
            }

            // Voice search: check feature flag + browser support, init speech recognition
            try
            {
                _voiceSearchEnabled = await FeatureSettings.IsEnabledAsync(
                    new Guid("00000000-0000-0000-0000-000000000001"),
                    nameof(ShopFeatureSettingsDto.Voice_Note_Enabled));
                if (_voiceSearchEnabled)
                {
                    _speechSupported = await JSRuntime.InvokeAsync<bool>("isSpeechRecognitionSupported");
                    if (_speechSupported)
                    {
                        _voiceDotNetRef = DotNetObjectReference.Create(this);
                        // targetId = "search-input" → transcript fills the search box directly
                        await JSRuntime.InvokeVoidAsync("initializeSpeechRecognition", _voiceDotNetRef, "search-input");
                    }
                }
                StateHasChanged();
            }
            catch
            {
                // Non-critical — voice search disabled if feature settings fetch fails
            }
        }
    }

    private async Task ToggleVoiceSearch()
    {
        if (isRecording)
        {
            isRecording = false;
            await JSRuntime.InvokeVoidAsync("stopRecording");
        }
        else
        {
            // Clear previous keyword before recording so transcript starts fresh
            _searchKeyword = "";
            isRecording = true;
            await JSRuntime.InvokeVoidAsync("startRecording");
        }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnVoiceRecordingEnd()
    {
        isRecording = false;
        // Trigger search with the transcribed keyword
        await LoadStores();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceError(string errorMessage)
    {
        isRecording = false;
        _error = errorMessage;
        StateHasChanged();
    }

    public void Dispose()
    {
        _voiceDotNetRef?.Dispose();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchKeyword = e.Value?.ToString() ?? "";
        _searchDebounce?.Cancel();
        _searchDebounce = new System.Threading.CancellationTokenSource();
        try
        {
            await Task.Delay(300, _searchDebounce.Token);
            await LoadStores();
        }
        catch (TaskCanceledException) { /* debounce */ }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _searchDebounce?.Cancel();
            await LoadStores();
        }
    }

    private async Task ClearSearch()
    {
        _searchKeyword = "";
        await LoadStores();
    }

    private async Task OnRadiusChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var r))
        {
            _radiusKm = r;
        }
        await LoadStores();
    }

    private async Task UseMyLocation()
    {
        try
        {
            var location = await JSRuntime.InvokeAsync<GeolocationResult>("vananPWA.getCurrentPosition");
            if (location != null)
            {
                _userLat = location.Latitude;
                _userLng = location.Longitude;
                await LoadStores();
            }
        }
        catch
        {
            _error = "Không lấy được vị trí. Trình duyệt có thể chặn geolocation.";
        }
    }

    private async Task LoadStores()
    {
        _loading = true;
        _error = null;
        try
        {
            var client = HttpClientFactory.CreateClient("gateway");
            string url;
            if (!string.IsNullOrWhiteSpace(_searchKeyword))
            {
                // Keyword search — calls /api/tenants/search?name={keyword}
                url = $"/api/tenants/search?name={Uri.EscapeDataString(_searchKeyword)}";
            }
            else if (_userLat.HasValue && _userLng.HasValue)
            {
                url = $"/api/tenants/nearby?lat={_userLat}&lng={_userLng}&radiusKm={_radiusKm}";
            }
            else
            {
                // No location + no keyword — list all active tenants via search with empty name
                url = "/api/tenants/search";
            }

            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                _stores = await response.Content.ReadFromJsonAsync<List<StoreDto>>() ?? new();
            }
            else
            {
                _error = "Không thể tải danh sách cửa hàng. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Lỗi kết nối: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAllStores()
    {
        _userLat = null;
        _userLng = null;
        _searchKeyword = "";
        await LoadStores();
    }

    public class StoreDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public double? DistanceKm { get; set; }
        public string? Slug { get; set; }
        public string? KhachLinkDomain { get; set; }
    }

    public class GeolocationResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }
}
