@page "/checkout"
@using VanAn.KhachLink.Components
@using VanAn.KhachLink.Models
@inject VanAn.KhachLink.Services.CartService CartService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@implements IDisposable

<PageTitle>KhachLink - Thanh toán đơn hàng</PageTitle>

<h3>📱 Thanh toán đơn hàng</h3>

@if (isProcessing)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Đang xử lý...</span>
        </div>
        <p class="mt-2">Đang tạo đơn hàng và mã QR thanh toán...</p>
    </div>
}
else if (orderCreated && !string.IsNullOrEmpty(createdOrderId))
{
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>📋 Chi tiết đơn hàng</h5>
                </div>
                <div class="card-body">
                    <p><strong>Mã đơn hàng:</strong> @createdOrderId</p>
                    <p><strong>Trạng thái:</strong> <span class="badge bg-warning">Chờ thanh toán</span></p>
                    <hr />

                    @foreach (var item in cartSnapshot)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span>@item.ProductName x @item.Quantity</span>
                            <span>@item.TotalPrice.ToString("N0") VNĐ</span>
                        </div>
                    }

                    <hr />
                    <div class="d-flex justify-content-between">
                        <h5 class="text-danger">Tổng cộng:</h5>
                        <h5 class="text-danger">@orderTotal.ToString("N0") VNĐ</h5>
                    </div>

                    <!-- T-03c: "Thanh toán QR" button — triggers #qrPaymentModal -->
                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-primary" @onclick="OpenQrModal" data-testid="checkout-btn-qr-payment">
                            📲 Thanh toán QR
                        </button>
                        <a href="/order-tracking/@createdOrderId" class="btn btn-outline-secondary" data-testid="checkout-link-tracking">
                            Theo dõi đơn hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(qrImageUrl))
        {
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>📱 Quét mã QR để thanh toán</h5>
                    </div>
                    <div class="card-body text-center">
                        <img src="@qrImageUrl" alt="VietQR Code" class="img-fluid" style="max-width: 300px;" />
                        <div class="alert alert-info mt-3">
                            <p class="mb-0">Mở ứng dụng ngân hàng và quét mã QR để thanh toán
                                <strong>@orderTotal.ToString("N0") VNĐ</strong>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* T-03c: QrPaymentModal integration *@
    <QrPaymentModal IsOpen="@showQrModal"
                    Amount="@orderTotal"
                    OrderId="@createdOrderId"
                    OnPaymentCompleted="CloseQrModal" />
}
else
{
    <div class="alert alert-warning">
        <p>Không thể tạo đơn hàng. Vui lòng thử lại.</p>
        <a href="/cart" class="btn btn-primary">Quay lại giỏ hàng</a>
    </div>
}

@code {
    private VanAn.KhachLink.Services.CartState cartState = new();
    private bool isProcessing;
    private bool orderCreated;
    private bool showQrModal;
    private string createdOrderId = string.Empty;
    private string? qrImageUrl;
    private decimal orderTotal;
    private List<CartItem> cartSnapshot = new();

    protected override async Task OnInitializedAsync()
    {
        cartState = CartService.GetCartState();
        CartService.OnCartChanged += StateHasChanged;
        await CartService.LoadCartFromStorageAsync();

        if (cartState.GetTotalItems() == 0)
        {
            NavigationManager.NavigateTo("/cart");
            return;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && cartState.GetTotalItems() > 0 && !orderCreated && !isProcessing)
        {
            await CreateOrder();
        }
    }

    private async Task CreateOrder()
    {
        isProcessing = true;
        StateHasChanged();

        // Snapshot cart before clearing
        cartSnapshot = cartState.Items.ToList();
        orderTotal   = cartState.TotalAmount;

        try
        {
            var orderRequest = new
            {
                CustomerDeviceId = "web-client",
                OrderType        = "TAKEAWAY",
                Items            = cartState.Items.Select(i => new
                {
                    ProductId = i.ProductId,
                    Quantity  = i.Quantity,
                    UnitPrice = i.UnitPrice,
                    Notes     = "",
                }).ToList(),
                CustomerNotes = "Đặt hàng từ web KhachLink",
            };

            var http     = HttpClientFactory.CreateClient("gateway");
            var response = await http.PostAsJsonAsync("api/orders", orderRequest);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<OrderCreatedResult>();
                createdOrderId = result?.OrderId ?? string.Empty;
                qrImageUrl     = result?.QrImageUrl;
                orderCreated   = true;

                await CartService.ClearCartAsync();

                // T-02c + T-03c: Navigate to tracking page; QR modal available via button
                if (!string.IsNullOrEmpty(createdOrderId))
                {
                    NavigationManager.NavigateTo($"/order-tracking/{createdOrderId}");
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception creating order: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void OpenQrModal()  => showQrModal = true;
    private void CloseQrModal() => showQrModal = false;

    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }

    private record OrderCreatedResult(
        string  OrderId,
        string? QrImageUrl,
        string? PaymentUrl,
        decimal Amount
    );
}
