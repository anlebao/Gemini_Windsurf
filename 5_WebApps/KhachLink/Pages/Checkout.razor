@page "/checkout"
@rendermode InteractiveServer
@using VanAn.KhachLink.Components
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Models
@using VanAn.UI.Platform.Components
@inject VanAn.KhachLink.Services.CartService CartService
@inject VanAn.KhachLink.Services.CheckoutFlowState CheckoutFlow
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@implements IDisposable

@* W1-T1: Payment method — "cash" shows ProcessingBar, "transfer" shows QR modal. *@

<PageTitle>KhachLink - Thanh toán đơn hàng</PageTitle>

<KhachLinkLayout>
    <div class="container py-4">
        <h3 class="mb-4">📱 Thanh toán đơn hàng</h3>

        @if (isProcessing)
        {
            <VanAnCard>
                <div class="text-center">
                    <VanASpinner Label="Đang tạo đơn hàng và mã QR thanh toán..." />
                </div>
            </VanAnCard>
        }
        else if (orderCreated && !string.IsNullOrEmpty(createdOrderId))
        {
            <div class="row">
                <div class="col-md-6">
                    <VanAnCard Header="📋 Chi tiết đơn hàng">
                        <div class="order-success alert-success" role="status">
                            <p><strong>✅ Đặt hàng thành công!</strong></p>
                            <p>Mã đơn hàng: <span class="order-id">@createdOrderId</span></p>
                            <p>Trạng thái: <span class="badge bg-warning">Chờ thanh toán</span></p>
                        </div>
                        <hr />

                        @foreach (var item in cartSnapshot)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@item.ProductName x @item.Quantity</span>
                                <span>@item.TotalPrice.ToString("N0") VNĐ</span>
                            </div>
                        }

                        <hr />
                        <div class="d-flex justify-content-between">
                            <h5 class="text-danger">Tổng cộng:</h5>
                            <h5 class="text-danger">@orderTotal.ToString("N0") VNĐ</h5>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <VanAnButton Variant="ButtonVariant.Primary" OnClick="OpenQrModal" data-testid="checkout-btn-qr-payment">
                                📲 Thanh toán QR
                            </VanAnButton>
                            <VanAnButton Variant="ButtonVariant.Outline" OnClick="@(() => NavigationManager.NavigateTo($"/order-tracking/{createdOrderId}"))" data-testid="checkout-link-tracking">
                                Theo dõi đơn hàng
                            </VanAnButton>
                        </div>
                    </VanAnCard>
                </div>

                @if (!string.IsNullOrEmpty(qrImageUrl))
                {
                    <div class="col-md-6">
                        <VanAnCard Header="📱 Quét mã QR để thanh toán">
                            <div class="text-center">
                                <img src="@qrImageUrl" alt="VietQR Code" class="img-fluid" style="max-width: 300px;" />
                                <VanAnAlert Variant="AlertVariant.Info" Message="@($"Mở ứng dụng ngân hàng và quét mã QR để thanh toán {orderTotal:N0} VNĐ")" Dismissible="false" />
                            </div>
                        </VanAnCard>
                    </div>
                }
            </div>

            <QrPaymentModal IsOpen="@showQrModal"
                            Amount="@orderTotal"
                            OrderId="@createdOrderId"
                            OnPaymentCompleted="CloseQrModal" />
        }
        else if (showGuestForm)
        {
            <div class="row">
                <div class="col-md-7">
                    <VanAnCard Header="📝 Thông tin khách hàng">
                        <div class="mb-3">
                            <label for="guest-name" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                            <input id="guest-name" type="text" class="form-control" @bind="guestName" @bind:event="oninput" placeholder="Nhập họ và tên" required aria-label="Họ và tên" name="name" data-testid="checkout-input-name" />
                        </div>

                        <div class="mb-3">
                            <label for="guest-phone" class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <input id="guest-phone" type="tel" class="form-control" @bind="guestPhone" @bind:event="oninput" placeholder="Nhập số điện thoại" required aria-label="Số điện thoại" name="phone" data-testid="checkout-input-phone" />
                        </div>

                        <div class="mb-3">
                            <label for="guest-address" class="form-label">Địa chỉ giao hàng</label>
                            <input id="guest-address" type="text" class="form-control" @bind="guestAddress" @bind:event="oninput" placeholder="Nhập địa chỉ giao hàng" aria-label="Địa chỉ giao hàng" name="address" data-testid="checkout-input-address" />
                        </div>

                        @if (!string.IsNullOrEmpty(formError))
                        {
                            <VanAnAlert Variant="AlertVariant.Error" Message="@formError" Dismissible="false" />
                        }

                        <!-- W1-T1: Payment method selector -->
                        <div class="mb-3" data-testid="payment-method-selector">
                            <label class="form-label fw-bold">Hình thức thanh toán</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input id="payment-cash" type="radio" name="paymentMethod" value="cash"
                                           class="form-check-input" checked="@(selectedPaymentMethod == "cash")"
                                           @onchange="@(() => selectedPaymentMethod = "cash")"
                                           data-testid="payment-option-cash" />
                                    <label for="payment-cash" class="form-check-label">💵 Tiền mặt</label>
                                </div>
                                <div class="form-check">
                                    <input id="payment-transfer" type="radio" name="paymentMethod" value="transfer"
                                           class="form-check-input" checked="@(selectedPaymentMethod == "transfer")"
                                           @onchange="@(() => selectedPaymentMethod = "transfer")"
                                           data-testid="payment-option-transfer" />
                                    <label for="payment-transfer" class="form-check-label">🏦 Chuyển khoản (VietQR)</label>
                                </div>
                            </div>
                        </div>

                        <!-- W1-T2: ProcessingBar shown during cash order submission -->
                        <ProcessingBar IsVisible="@isSendingCash" />

                        <VanAnButton Variant="ButtonVariant.Success" FullWidth="true" OnClick="SubmitGuestOrder" data-testid="checkout-btn-place-order" disabled="@isSendingCash">
                            @(selectedPaymentMethod == "cash" ? "Đặt hàng (Tiền mặt)" : "Đặt hàng (Chuyển khoản)")
                        </VanAnButton>
                    </VanAnCard>
                </div>

                <div class="col-md-5">
                    <VanAnCard Header="🛒 Tóm tắt đơn hàng">
                        @foreach (var item in cartSnapshot)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@item.ProductName x @item.Quantity</span>
                                <span>@item.TotalPrice.ToString("N0") VNĐ</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between">
                            <h5 class="text-danger">Tổng cộng:</h5>
                            <h5 class="text-danger">@orderTotal.ToString("N0") VNĐ</h5>
                        </div>
                    </VanAnCard>
                </div>
            </div>
        }
        else
        {
            <VanAnAlert Variant="AlertVariant.Warning" Message="Không thể tạo đơn hàng. Vui lòng thử lại." Dismissible="false" />
            <div class="text-center mt-3">
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="@(() => NavigationManager.NavigateTo("/cart"))" data-testid="checkout-btn-back-cart">
                    Quay lại giỏ hàng
                </VanAnButton>
            </div>
        }
    </div>

    <!-- Post-checkout: offer loyalty points signup for anonymous customers -->
    <IdentityUpgradeModal ShowModal="@_showLoyaltySignupModal"
                          OnDismiss="@DismissLoyaltySignup"
                          OnUpgradeComplete="@OnLoyaltySignupComplete" />
</KhachLinkLayout>

@code {
    private VanAn.KhachLink.Services.CartState cartState = new();
    private bool isProcessing;
    private bool orderCreated;
    private bool showQrModal;
    private bool showGuestForm;
    private string createdOrderId = string.Empty;
    private string? qrImageUrl;
    private decimal orderTotal;
    private List<CartItem> cartSnapshot = new();

    // Guest form fields
    private string guestName = string.Empty;
    private string guestPhone = string.Empty;
    private string guestAddress = string.Empty;
    private string? formError;
    // W1-T1: Payment method — "cash" or "transfer" (default: transfer for QR flow)
    private string selectedPaymentMethod = "transfer";
    // W1-T2: Cash flow processing state
    private bool isSendingCash;

    // Post-checkout loyalty signup: show IdentityUpgradeModal after order success for anonymous users
    private bool _showLoyaltySignupModal = false;
    private bool _isLoggedIn = false;

    protected override async Task OnInitializedAsync()
    {
        cartState = CartService.GetCartState();
        CartService.OnCartChanged += StateHasChanged;
        await CartService.LoadCartFromStorageAsync();

        // Check if customer is logged in (has customer_token in localStorage)
        var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
        _isLoggedIn = !string.IsNullOrEmpty(token);

        if (cartState.GetTotalItems() == 0)
        {
            NavigationManager.NavigateTo("/cart");
            return;
        }

        // Snapshot cart for display + show guest form (no auto-create).
        // Bucket A feature (approved 2026-07-07): guest fills form before order creation.
        cartSnapshot = cartState.Items.ToList();
        orderTotal = cartState.TotalAmount;
        showGuestForm = true;
    }

    private async Task SubmitGuestOrder()
    {
        // Validate required fields
        if (string.IsNullOrWhiteSpace(guestName))
        {
            formError = "Vui lòng nhập họ và tên.";
            return;
        }
        if (string.IsNullOrWhiteSpace(guestPhone))
        {
            formError = "Vui lòng nhập số điện thoại.";
            return;
        }

        formError = null;
        isProcessing = true;
        // W1-T2: Cash flow uses ProcessingBar instead of QR spinner
        if (selectedPaymentMethod == "cash")
            isSendingCash = true;
        showGuestForm = false;
        StateHasChanged();

        try
        {
            // Persist guest info + payment method to CheckoutFlowState (scoped state machine)
            CheckoutFlow.CustomerName = guestName;
            CheckoutFlow.CustomerPhone = guestPhone;
            CheckoutFlow.CustomerAddress = guestAddress;
            CheckoutFlow.PaymentMethod = selectedPaymentMethod;

            var orderRequest = new
            {
                CustomerDeviceId = "web-client",
                OrderType = "TAKEAWAY",
                Items = cartSnapshot.Select(i => new
                {
                    ProductId = i.ProductId,
                    Quantity = i.Quantity,
                    UnitPrice = i.UnitPrice,
                    Notes = "",
                }).ToList(),
                CustomerNotes = "Đặt hàng từ web KhachLink",
                CustomerName = guestName,
                CustomerPhone = guestPhone,
                CustomerAddress = guestAddress
            };

            var http = HttpClientFactory.CreateClient("gateway");
            var response = await http.PostAsJsonAsync("api/public/orders/checkout", orderRequest);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<OrderCreatedResult>();
                createdOrderId = result?.OrderId ?? string.Empty;
                qrImageUrl = result?.QrImageUrl;
                orderCreated = true;

                await CartService.ClearCartAsync();

                // Post-checkout: show loyalty signup modal for anonymous customers
                // so they can authenticate and earn points on this order.
                if (!_isLoggedIn)
                {
                    _showLoyaltySignupModal = true;
                }

                // W1-T1: Cash flow → redirect to OrderTracking immediately (no QR modal)
                if (selectedPaymentMethod == "cash" && !string.IsNullOrEmpty(createdOrderId))
                {
                    NavigationManager.NavigateTo($"/order-tracking/{createdOrderId}");
                    return;
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Checkout API error: {response.StatusCode} — {errorContent}");
                formError = $"Lỗi tạo đơn hàng ({response.StatusCode}). Vui lòng thử lại hoặc liên hệ quán.";
                showGuestForm = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception creating order: {ex.Message}");
            formError = $"Lỗi kết nối: {ex.Message}";
            showGuestForm = true;
        }
        finally
        {
            isProcessing = false;
            isSendingCash = false;
            StateHasChanged();
        }
    }

    private void OpenQrModal() => showQrModal = true;
    private void CloseQrModal() => showQrModal = false;

    // Post-checkout loyalty signup handlers
    private void DismissLoyaltySignup()
    {
        _showLoyaltySignupModal = false;
    }

    private void OnLoyaltySignupComplete()
    {
        _showLoyaltySignupModal = false;
        _isLoggedIn = true;
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }

    private record OrderCreatedResult(
        string OrderId,
        string? QrImageUrl,
        string? PaymentUrl,
        decimal Amount
    );
}
