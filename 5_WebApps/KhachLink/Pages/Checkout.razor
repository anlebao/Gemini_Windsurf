@page "/checkout"
@rendermode InteractiveServer
@using VanAn.KhachLink.Components
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Models
@using VanAn.UI.Platform.Components
@using VanAn.KhachLink.Services.Http
@using VanAn.CoreHub.Services
@inject VanAn.KhachLink.Services.CartService CartService
@inject VanAn.KhachLink.Services.CheckoutFlowState CheckoutFlow
@inject VanAn.KhachLink.Services.Http.ShopConfigHttpService ShopConfigHttp
@inject ShopFeatureSettingsHttpService FeatureSettings
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@implements IDisposable

@* W1-T1: Payment method — "cash" shows ProcessingBar, "transfer" shows QR modal. *@

<PageTitle>KhachLink - Thanh toán đơn hàng</PageTitle>

<KhachLinkLayout>
    <div class="container py-4">
        <h3 class="mb-4">📱 Thanh toán đơn hàng</h3>

        @if (isProcessing)
        {
            <VanAnCard>
                <div class="text-center">
                    <VanASpinner Label="Đang tạo đơn hàng và mã QR thanh toán..." />
                </div>
            </VanAnCard>
        }
        else if (orderCreated && _createdOrders.Count > 0)
        {
            <div class="row">
                <div class="col-md-6">
                    <VanAnCard Header="📋 Chi tiết đơn hàng">
                        <div class="order-success alert-success" role="status">
                            <p><strong>✅ Đặt hàng thành công!</strong></p>
                            <p>Đã tạo <strong>@_createdOrders.Count</strong> đơn hàng từ giỏ hàng của bạn.</p>
                        </div>
                        <hr />

                        @foreach (var order in _createdOrders)
                        {
                            <div class="mb-3 p-2 border rounded">
                                <p><strong>Đơn hàng:</strong> <span class="order-id">@order.OrderId</span></p>
                                <p><strong>Cửa hàng:</strong> @(string.IsNullOrEmpty(order.TenantName) ? order.TenantId.ToString() : order.TenantName)</p>
                                @if (_vatDisplayEnabled && order.SubTotal > 0)
                                {
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>Tạm tính (chưa VAT):</span>
                                        <span>@order.SubTotal.ToString("N0") VNĐ</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>VAT:</span>
                                        <span>@order.TotalVatAmount.ToString("N0") VNĐ</span>
                                    </div>
                                }
                                <div class="d-flex justify-content-between">
                                    <strong>Tổng:</strong>
                                    <strong>@order.Amount.ToString("N0") VNĐ</strong>
                                </div>
                                <div class="mt-2">
                                    <VanAnButton Variant="ButtonVariant.Outline" OnClick="@(() => NavigationManager.NavigateTo($"/order-tracking/{order.OrderId}"))">
                                        Theo dõi đơn hàng
                                    </VanAnButton>
                                </div>
                            </div>
                        }

                        <hr />
                        <div class="d-flex justify-content-between">
                            <h5 class="text-danger">Tổng tất cả:</h5>
                            <h5 class="text-danger">@orderTotal.ToString("N0") VNĐ</h5>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <VanAnButton Variant="ButtonVariant.Primary" OnClick="OpenQrModal" data-testid="checkout-btn-qr-payment">
                                📲 Thanh toán QR
                            </VanAnButton>
                            <VanAnButton Variant="ButtonVariant.Outline" OnClick="@(() => NavigationManager.NavigateTo($"/order-tracking/{_createdOrders[0].OrderId}"))" data-testid="checkout-link-tracking">
                                Theo dõi đơn hàng đầu tiên
                            </VanAnButton>
                        </div>
                    </VanAnCard>
                </div>

                @if (_checkoutErrors.Count > 0)
                {
                    <div class="col-md-6">
                        <VanAnCard Header="⚠️ Đơn hàng thất bại">
                            <VanAnAlert Variant="AlertVariant.Warning"
                                        Message="@($"Một số đơn hàng không thể tạo ({_checkoutErrors.Count} thất bại). Các sản phẩm liên quan vẫn còn trong giỏ hàng để bạn thử lại.")"
                                        Dismissible="false" />
                            @foreach (var err in _checkoutErrors)
                            {
                                <div class="mb-2 p-2 border rounded">
                                    <p><strong>Cửa hàng:</strong> @(string.IsNullOrEmpty(err.TenantName) ? err.TenantId.ToString() : err.TenantName)</p>
                                    <p class="text-danger">@err.Error</p>
                                </div>
                            }
                        </VanAnCard>
                    </div>
                }
                else if (!string.IsNullOrEmpty(qrImageUrl))
                {
                    <div class="col-md-6">
                        <VanAnCard Header="📱 Quét mã QR để thanh toán">
                            <div class="text-center">
                                <img src="@qrImageUrl" alt="VietQR Code" class="img-fluid" style="max-width: 300px;" />
                                <VanAnAlert Variant="AlertVariant.Info" Message="@($"Mở ứng dụng ngân hàng và quét mã QR để thanh toán {orderTotal:N0} VNĐ")" Dismissible="false" />
                            </div>
                        </VanAnCard>
                    </div>
                }
            </div>

            <QrPaymentModal IsOpen="@showQrModal"
                            Amount="@orderTotal"
                            OrderId="@(_createdOrders.Count > 0 ? _createdOrders[0].OrderId : string.Empty)"
                            TenantId="@(_createdOrders.Count > 0 ? _createdOrders[0].TenantId : Guid.Empty)"
                            OnPaymentCompleted="CloseQrModal" />
        }
        else if (showGuestForm)
        {
            <div class="row">
                <div class="col-md-7">
                    <VanAnCard Header="@(_isLoggedIn ? "📝 Xác nhận thông tin giao hàng" : "📝 Thông tin khách hàng")">
                        @if (_isLoggedIn)
                        {
                            <VanAnAlert Variant="AlertVariant.Info"
                                        Message="Thông tin đã được điền sẵn từ tài khoản của bạn. Vui lòng kiểm tra và chỉnh sửa nếu cần."
                                        Dismissible="false" CssClass="mb-3" />
                        }
                        <div class="mb-3">
                            <label for="guest-name" class="form-label">Họ và tên @if (selectedPaymentMethod == "transfer") { <span class="text-danger">*</span> }</label>
                            <input id="guest-name" type="text" class="form-control" @bind="guestName" @bind:event="oninput" placeholder="Nhập họ và tên" aria-label="Họ và tên" name="name" data-testid="checkout-input-name" />
                        </div>

                        <div class="mb-3">
                            <label for="guest-phone" class="form-label">Số điện thoại @if (selectedPaymentMethod == "transfer") { <span class="text-danger">*</span> }</label>
                            <input id="guest-phone" type="tel" class="form-control" @bind="guestPhone" @bind:event="oninput" placeholder="Nhập số điện thoại" aria-label="Số điện thoại" name="phone" data-testid="checkout-input-phone" />
                        </div>

                        <div class="mb-3">
                            <label for="guest-address" class="form-label">Địa chỉ giao hàng</label>
                            <input id="guest-address" type="text" class="form-control" @bind="guestAddress" @bind:event="oninput" placeholder="Nhập địa chỉ giao hàng" aria-label="Địa chỉ giao hàng" name="address" data-testid="checkout-input-address" />
                        </div>

                        @if (selectedPaymentMethod == "transfer")
                        {
                            <VanAnAlert Variant="AlertVariant.Info" Message="Vui lòng nhập họ tên để đối soát giao dịch chuyển khoản." Dismissible="false" />
                        }

                        @if (!string.IsNullOrEmpty(formError))
                        {
                            <VanAnAlert Variant="AlertVariant.Error" Message="@formError" Dismissible="false" />
                        }

                        <!-- W1-T1: Payment method selector -->
                        <div class="mb-3" data-testid="payment-method-selector">
                            <label class="form-label fw-bold">Hình thức thanh toán</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input id="payment-cash" type="radio" name="paymentMethod" value="cash"
                                           class="form-check-input" checked="@(selectedPaymentMethod == "cash")"
                                           @onchange="@(() => selectedPaymentMethod = "cash")"
                                           data-testid="payment-option-cash" />
                                    <label for="payment-cash" class="form-check-label">💵 Tiền mặt</label>
                                </div>
                                <div class="form-check">
                                    <input id="payment-transfer" type="radio" name="paymentMethod" value="transfer"
                                           class="form-check-input" checked="@(selectedPaymentMethod == "transfer")"
                                           @onchange="@(() => selectedPaymentMethod = "transfer")"
                                           data-testid="payment-option-transfer" />
                                    <label for="payment-transfer" class="form-check-label">🏦 Chuyển khoản (VietQR)</label>
                                </div>
                            </div>
                        </div>

                        <!-- W1-T2: ProcessingBar shown during cash order submission -->
                        <ProcessingBar IsVisible="@isSendingCash" />

                        <VanAnButton Variant="ButtonVariant.Success" FullWidth="true" OnClick="SubmitGuestOrder" data-testid="checkout-btn-place-order" disabled="@isSendingCash">
                            @(selectedPaymentMethod == "cash" ? "Đặt hàng (Tiền mặt)" : "Đặt hàng (Chuyển khoản)")
                        </VanAnButton>
                    </VanAnCard>
                </div>

                <div class="col-md-5">
                    <VanAnCard Header="🛒 Tóm tắt đơn hàng">
                        @foreach (var item in cartSnapshot)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@item.ProductName x @item.Quantity</span>
                                <span>@item.TotalPrice.ToString("N0") VNĐ</span>
                            </div>
                        }
                        <hr />
                        @if (_vatDisplayEnabled)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tạm tính (chưa VAT):</span>
                                <span>@cartState.NetSubTotal.ToString("N0") VNĐ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>VAT:</span>
                                <span>@cartState.TotalVatAmount.ToString("N0") VNĐ</span>
                            </div>
                            <hr />
                        }
                        <div class="d-flex justify-content-between">
                            <h5 class="text-danger">Tổng cộng:</h5>
                            <h5 class="text-danger">@orderTotal.ToString("N0") VNĐ</h5>
                        </div>
                    </VanAnCard>
                </div>
            </div>
        }
        else
        {
            <VanAnAlert Variant="AlertVariant.Warning" Message="Không thể tạo đơn hàng. Vui lòng thử lại." Dismissible="false" />
            <div class="text-center mt-3">
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="@(() => NavigationManager.NavigateTo("/cart"))" data-testid="checkout-btn-back-cart">
                    Quay lại giỏ hàng
                </VanAnButton>
            </div>
        }
    </div>

    <!-- Post-checkout: offer loyalty points signup for anonymous customers -->
    <IdentityUpgradeModal ShowModal="@_showLoyaltySignupModal"
                          OnDismiss="@DismissLoyaltySignup"
                          OnUpgradeComplete="@OnLoyaltySignupComplete" />
</KhachLinkLayout>

@code {
    private VanAn.KhachLink.Services.CartState cartState = new();
    private bool isProcessing;
    private bool orderCreated;
    private bool showQrModal;
    private bool showGuestForm;
    private string? qrImageUrl;
    private decimal orderTotal;
    private string? shopName;
    private List<CartItem> cartSnapshot = new();
    private bool _vatDisplayEnabled = true;

    // Phase 5: Multi-tenant checkout — multiple orders from one cart.
    private List<CreatedOrderItem> _createdOrders = new();
    private List<CheckoutErrorItem> _checkoutErrors = new();

    // Guest form fields
    private string guestName = string.Empty;
    private string guestPhone = string.Empty;
    private string guestAddress = string.Empty;
    private string? formError;
    // W1-T1: Payment method — "cash" or "transfer" (default: transfer for QR flow)
    private string selectedPaymentMethod = "transfer";
    // W1-T2: Cash flow processing state
    private bool isSendingCash;

    // Post-checkout loyalty signup: show IdentityUpgradeModal after order success for anonymous users
    private bool _showLoyaltySignupModal = false;
    private bool _isLoggedIn = false;
    // Logged-in customer ID (from localStorage "customer_id") — sent with checkout request
    // so the created order is linked to the Customer entity and appears in order history.
    private Guid? _customerId = null;

    protected override async Task OnInitializedAsync()
    {
        cartState = CartService.GetCartState();
        CartService.OnCartChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JSRuntime is only available after hydration (not during static prerender).
            await CartService.LoadCartFromStorageAsync();

            // Check if customer is logged in (has customer_token in localStorage)
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            _isLoggedIn = !string.IsNullOrEmpty(token);

            // Load customerId from localStorage (saved at login by Login.razor / Google callback)
            var customerIdStr = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_id");
            if (Guid.TryParse(customerIdStr, out var parsedId))
                _customerId = parsedId;

            if (cartState.GetTotalItems() == 0)
            {
                NavigationManager.NavigateTo("/cart");
                return;
            }

            // Snapshot cart for display + show guest form (no auto-create).
            // Bucket A feature (approved 2026-07-07): guest fills form before order creation.
            cartSnapshot = cartState.Items.ToList();
            orderTotal = cartState.TotalAmount;
            showGuestForm = true;

            // Pre-fill name/phone from customer profile when logged in so the user
            // does not have to re-enter their info on every checkout.
            if (_isLoggedIn && !string.IsNullOrEmpty(token))
            {
                try
                {
                    var profileClient = HttpClientFactory.CreateClient("gateway");
                    profileClient.DefaultRequestHeaders.Add("X-Customer-Token", token);
                    var profileResp = await profileClient.GetAsync("/api/customers/me");
                    if (profileResp.IsSuccessStatusCode)
                    {
                        var profile = await profileResp.Content.ReadFromJsonAsync<CustomerProfileDto>();
                        if (profile != null)
                        {
                            if (!string.IsNullOrWhiteSpace(profile.FullName))
                                guestName = profile.FullName;
                            if (!string.IsNullOrWhiteSpace(profile.PhoneNumber))
                                guestPhone = profile.PhoneNumber;
                        }
                    }
                }
                catch { /* non-critical — pre-fill is a convenience, not a hard requirement */ }
            }

            StateHasChanged();
        }
    }

    private async Task SubmitGuestOrder()
    {
        // Bug 2: Conditional validation — transfer requires name+phone for reconciliation, cash does not
        if (selectedPaymentMethod == "transfer")
        {
            if (string.IsNullOrWhiteSpace(guestName))
            {
                formError = "Vui lòng nhập họ và tên để đối soát giao dịch chuyển khoản.";
                return;
            }
            if (string.IsNullOrWhiteSpace(guestPhone))
            {
                formError = "Vui lòng nhập số điện thoại để đối soát giao dịch chuyển khoản.";
                return;
            }
        }

        formError = null;
        isProcessing = true;
        // W1-T2: Cash flow uses ProcessingBar instead of QR spinner
        if (selectedPaymentMethod == "cash")
            isSendingCash = true;
        showGuestForm = false;
        StateHasChanged();

        try
        {
            // Persist guest info + payment method to CheckoutFlowState (scoped state machine)
            CheckoutFlow.CustomerName = guestName;
            CheckoutFlow.CustomerPhone = guestPhone;
            CheckoutFlow.CustomerAddress = guestAddress;
            CheckoutFlow.PaymentMethod = selectedPaymentMethod;

            // Bug 1a fix: Use real device ID from localStorage (not hardcoded "web-client")
            // so order history can filter by device ID for both guest and logged-in users.
            var deviceId = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_device_id");
            if (string.IsNullOrEmpty(deviceId))
            {
                // Generate + persist a stable device ID for this browser
                deviceId = Guid.NewGuid().ToString();
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "customer_device_id", deviceId);
            }

            // Bug 1a fix: Don't pass CustomerId if no Customer entity exists in DB.
            // FK constraint requires Customer to exist. Since Customers table may be empty,
            // passing an invalid CustomerId causes FK violation → checkout fails.
            // Instead, rely on CustomerDeviceId for order history linking.
            Guid? customerIdForOrder = null;
            if (_isLoggedIn && _customerId.HasValue)
            {
                // Validate Customer exists before passing CustomerId
                try
                {
                    var checkClient = HttpClientFactory.CreateClient("gateway");
                    checkClient.DefaultRequestHeaders.Add("X-Customer-Token", 
                        await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token") ?? "");
                    var checkResp = await checkClient.GetAsync("/api/customers/me");
                    if (checkResp.IsSuccessStatusCode)
                        customerIdForOrder = _customerId;
                    else
                        _isLoggedIn = false; // token invalid — treat as guest
                }
                catch { /* if check fails, proceed as guest */ }
            }

            var orderRequest = new
            {
                CustomerDeviceId = deviceId,
                OrderType = "TAKEAWAY",
                Items = cartSnapshot.Select(i => new
                {
                    ProductId = i.ProductId,
                    TenantId = i.TenantId,
                    ProductName = i.ProductName,
                    VatRate = i.VatRate,
                    Quantity = i.Quantity,
                    UnitPrice = i.UnitPrice,
                    Notes = "",
                }).ToList(),
                CustomerNotes = "Đặt hàng từ web KhachLink",
                CustomerName = guestName,
                CustomerPhone = guestPhone,
                CustomerAddress = guestAddress,
                // Bug 1a fix: Only pass CustomerId if validated (Customer exists in DB)
                CustomerId = customerIdForOrder
            };

            var http = HttpClientFactory.CreateClient("gateway");
            var response = await http.PostAsJsonAsync("api/public/orders/checkout", orderRequest);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CheckoutResponseResult>();
                _createdOrders = result?.Orders ?? new();
                _checkoutErrors = result?.Errors ?? new();
                orderTotal = _createdOrders.Sum(o => o.Amount);
                orderCreated = _createdOrders.Count > 0;

                // Phase 5: Load VAT display toggle from the first successful tenant.
                if (_createdOrders.Count > 0)
                {
                    var firstTenantId = _createdOrders[0].TenantId;
                    try
                    {
                        _vatDisplayEnabled = await FeatureSettings.IsEnabledAsync(firstTenantId, nameof(ShopFeatureSettingsDto.VAT_Display_Enabled));
                    }
                    catch { /* non-critical — default to true */ }

                    try
                    {
                        var shopConfig = await ShopConfigHttp.GetShopConfigByTenantIdAsync(firstTenantId);
                        shopName = shopConfig?.ShopName;
                    }
                    catch { /* non-critical — shop name is optional display */ }
                }

                // Phase 5: Store created_orders in localStorage for OrderHistory.
                if (_createdOrders.Count > 0)
                {
                    var ordersForStorage = _createdOrders.Select(o => new
                    {
                        orderId = o.OrderId.ToString(),
                        tenantId = o.TenantId.ToString(),
                        amount = o.Amount
                    }).ToList();
                    var ordersJson = System.Text.Json.JsonSerializer.Serialize(ordersForStorage);
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "created_orders", ordersJson);
                }

                // Phase 5: Partial cart clear — only remove items belonging to successful tenants.
                var successfulTenantIds = _createdOrders.Select(o => o.TenantId).ToHashSet();
                var itemsToKeep = cartState.Items.Where(i => !successfulTenantIds.Contains(i.TenantId)).ToList();
                if (itemsToKeep.Count == 0)
                {
                    await CartService.ClearCartAsync();
                }
                else
                {
                    // Clear and re-add only failed-tenant items (so customer can retry).
                    await CartService.ClearCartAsync();
                    var state = CartService.GetCartState();
                    state.Items.AddRange(itemsToKeep);
                    // SaveCartToStorageAsync is called by ClearCartAsync; we need to persist the re-added items.
                    // CartService doesn't expose a public Save method for direct item manipulation,
                    // so we trigger a save by calling UpdateQuantityAsync on a kept item (no-op if single item).
                    // This is a workaround — a proper fix would add CartService.PersistAsync().
                    if (itemsToKeep.Count > 0)
                    {
                        await CartService.UpdateQuantityAsync(itemsToKeep[0].ProductId, itemsToKeep[0].Quantity);
                    }
                }

                // Post-checkout: show loyalty signup modal for anonymous customers
                if (!_isLoggedIn && orderCreated)
                {
                    _showLoyaltySignupModal = true;
                }

                // W1-T1: Cash flow with single successful order → redirect to OrderTracking immediately.
                if (selectedPaymentMethod == "cash" && _createdOrders.Count == 1 && _checkoutErrors.Count == 0)
                {
                    NavigationManager.NavigateTo($"/order-tracking/{_createdOrders[0].OrderId}");
                    return;
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Checkout API error: {response.StatusCode} — {errorContent}");
                formError = $"Lỗi tạo đơn hàng ({response.StatusCode}). Vui lòng thử lại hoặc liên hệ quán.";
                showGuestForm = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception creating order: {ex.Message}");
            formError = $"Lỗi kết nối: {ex.Message}";
            showGuestForm = true;
        }
        finally
        {
            isProcessing = false;
            isSendingCash = false;
            StateHasChanged();
        }
    }

    private void OpenQrModal() => showQrModal = true;
    private void CloseQrModal() => showQrModal = false;

    // Post-checkout loyalty signup handlers
    private void DismissLoyaltySignup()
    {
        _showLoyaltySignupModal = false;
    }

    private void OnLoyaltySignupComplete()
    {
        _showLoyaltySignupModal = false;
        _isLoggedIn = true;
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }

    // Phase 5: CheckoutResponse shape (matches Gateway CheckoutResponse DTO).
    private class CheckoutResponseResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("orders")]
        public List<CreatedOrderItem> Orders { get; set; } = new();
        [System.Text.Json.Serialization.JsonPropertyName("successCount")]
        public int SuccessCount { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("failureCount")]
        public int FailureCount { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("errors")]
        public List<CheckoutErrorItem> Errors { get; set; } = new();
    }

    private class CreatedOrderItem
    {
        [System.Text.Json.Serialization.JsonPropertyName("orderId")]
        public string OrderId { get; set; } = string.Empty;
        [System.Text.Json.Serialization.JsonPropertyName("tenantId")]
        public Guid TenantId { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("tenantName")]
        public string TenantName { get; set; } = string.Empty;
        [System.Text.Json.Serialization.JsonPropertyName("amount")]
        public decimal Amount { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("subTotal")]
        public decimal SubTotal { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("totalVatAmount")]
        public decimal TotalVatAmount { get; set; }
    }

    private class CheckoutErrorItem
    {
        [System.Text.Json.Serialization.JsonPropertyName("tenantId")]
        public Guid TenantId { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("tenantName")]
        public string TenantName { get; set; } = string.Empty;
        [System.Text.Json.Serialization.JsonPropertyName("error")]
        public string Error { get; set; } = string.Empty;
    }

    // Profile DTO for pre-filling checkout form when customer is logged in.
    // Matches ShopERP CustomerIdentityController.GetMe response shape.
    private class CustomerProfileDto
    {
        public Guid CustomerId { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string CustomerToken { get; set; } = string.Empty;
        public string Tier { get; set; } = "Bronze";
        public int PointBalance { get; set; }
        public string? IdentityLevel { get; set; }
    }
}
