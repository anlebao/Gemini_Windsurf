@page "/community/wallet"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Services.Http
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject WalletHttpService WalletHttp

<PageTitle>Ví cộng tác viên</PageTitle>

<KhachLinkLayout>
    <div class="container py-4">
        <h3 class="mb-3">
            <i class="bi bi-wallet2 text-primary"></i> Ví cộng tác viên
        </h3>

        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div>
            </div>
        }
        else if (!_isLoggedIn)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-lock text-muted" style="font-size:3rem;"></i>
                <h5 class="mt-3">Đăng nhập để xem ví</h5>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToLogin">Đăng nhập</VanAnButton>
            </VanAnCard>
        }
        else
        {
            <!-- Balance card -->
            <VanAnCard Shadow="true" CssClass="mb-3 text-center p-4">
                <div class="text-muted small">Số dư hiện tại</div>
                <div class="display-6 fw-bold @(_balance >= 0 ? "text-success" : "text-danger")">
                    @_balance.ToString("N0")đ
                </div>
                @if (_codHeld > 0)
                {
                    <div class="small text-warning mt-2">
                        <i class="bi bi-hourglass-split"></i> Đang giữ hộ COD: @_codHeld.ToString("N0")đ
                    </div>
                    <div class="small text-muted">Khả dụng rút: @_availableBalance.ToString("N0")đ</div>
                }
            </VanAnCard>

            @if (!string.IsNullOrEmpty(_walletMessage))
            {
                <div class="alert @(_walletMessageIsError ? "alert-danger" : "alert-success") py-2">@_walletMessage</div>
            }

            <!-- Pending remittances (shipper view) — COD đã thu chưa nộp -->
            @if (_pendingRemittances.Any())
            {
                <VanAnCard Shadow="true" CssClass="mb-3">
                    <h6 class="mb-3"><i class="bi bi-cash-stack text-warning"></i> COD đang giữ hộ — cần nộp</h6>
                    @foreach (var rem in _pendingRemittances)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div>
                                <div class="small text-muted">Đơn #@rem.OrderId.ToString()[..8]</div>
                                <div class="fw-bold">@rem.Amount.ToString("N0")đ</div>
                                <div class="small text-muted">Thu lúc @rem.CollectedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <VanAnButton Variant="ButtonVariant.Primary" OnClick="() => RemitCod(rem.OrderId)">
                                <i class="bi bi-send"></i> Nộp tiền
                            </VanAnButton>
                        </div>
                    }
                </VanAnCard>
            }

            <!-- Withdrawal (TC-09) -->
            <VanAnCard Shadow="true" CssClass="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0"><i class="bi bi-bank text-primary"></i> Rút tiền</h6>
                    <VanAnButton Variant="ButtonVariant.Outline" OnClick="() => _showWithdrawModal = true">
                        <i class="bi bi-arrow-down-circle"></i> Yêu cầu rút
                    </VanAnButton>
                </div>
                <div class="small text-muted mb-2">Tối thiểu 500.000đ — admin duyệt rồi chuyển khoản.</div>
                @if (_withdrawals.Any())
                {
                    @foreach (var w in _withdrawals)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div>
                                <div class="fw-bold">@w.Amount.ToString("N0")đ <span class="badge @GetWithdrawalBadge(w.Status)">@GetWithdrawalStatusText(w.Status)</span></div>
                                <div class="small text-muted">@w.RequestedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                @if (!string.IsNullOrEmpty(w.BankReference))
                                {
                                    <div class="small text-muted">Ref: @w.BankReference</div>
                                }
                                @if (!string.IsNullOrEmpty(w.RejectReason))
                                {
                                    <div class="small text-danger">@w.RejectReason</div>
                                }
                            </div>
                            @if (w.Status == "Pending")
                            {
                                <VanAnButton Variant="ButtonVariant.Secondary" OnClick="() => CancelWithdrawal(w.Id)">Huỷ</VanAnButton>
                            }
                        </div>
                    }
                }
            </VanAnCard>

            <!-- Pending advances (shop owner view) -->
            @if (_pendingAdvances.Any())
            {
                <VanAnCard Shadow="true" CssClass="mb-3">
                    <h6 class="mb-3"><i class="bi bi-clock-history text-warning"></i> Ứng tiền chờ xác nhận</h6>
                    @foreach (var adv in _pendingAdvances)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div>
                                <div class="small text-muted">Đơn #@adv.OrderId.ToString()[..8]</div>
                                <div class="fw-bold">@adv.Amount.ToString("N0")đ</div>
                                <div class="small text-muted">@adv.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <VanAnButton Variant="ButtonVariant.Success" OnClick="() => ConfirmAdvanceReceived(adv.TransactionId)">
                                <i class="bi bi-check-circle"></i> Đã nhận
                            </VanAnButton>
                        </div>
                    }
                </VanAnCard>
            }

            <!-- Transaction history -->
            <VanAnCard Shadow="true" CssClass="mb-3">
                <h6 class="mb-3">Lịch sử giao dịch</h6>
                @if (_transactions.Any())
                {
                    @foreach (var tx in _transactions)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div class="flex-grow-1">
                                <div class="fw-bold">
                                    <i class="@GetTxIcon(tx.Type)"></i> @GetTxTypeText(tx.Type)
                                </div>
                                <div class="small text-muted">@tx.Description</div>
                                <div class="small text-muted">@tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold @(tx.Amount >= 0 ? "text-success" : "text-danger")">
                                    @(tx.Amount >= 0 ? "+" : "")@tx.Amount.ToString("N0")đ
                                </div>
                                <div class="small text-muted">Số dư: @tx.BalanceAfter.ToString("N0")đ</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox" style="font-size:2rem;"></i>
                        <div class="mt-2">Chưa có giao dịch</div>
                    </div>
                }
            </VanAnCard>
        }
    </div>
</KhachLinkLayout>

<!-- Withdraw request modal (TC-09) -->
@if (_showWithdrawModal)
{
    <VanAnModal IsOpen="true"
                Title="Yêu cầu rút tiền"
                OnClose="() => _showWithdrawModal = false"
                Closable="true">
        <ChildContent>
            <div class="mb-3">
                <label class="form-label">Số tiền (VND)</label>
                @* Issue #187: trước đây @bind:event="oninput" → re-render toàn bộ modal sau MỖI phím gõ
                   → trên mobile browser scroll/focus bị đẩy → textbox "nhảy xuống dưới cùng".
                   Chuyển về onchange mặc định (giá trị vẫn được nạp trước khi click "Gửi yêu cầu" —
                   blur input kích hoạt change, rồi click handler chạy sau). *@
                <input type="number" class="form-control" min="500000" step="1000"
                       @bind="_withdrawAmount" />
                <small class="text-muted">Tối thiểu 500.000đ — khả dụng: @_availableBalance.ToString("N0")đ</small>
            </div>
        </ChildContent>
        <Footer>
            <VanAnButton Variant="ButtonVariant.Secondary" OnClick="() => _showWithdrawModal = false">Huỷ</VanAnButton>
            <VanAnButton Variant="ButtonVariant.Primary" OnClick="RequestWithdrawal">Gửi yêu cầu</VanAnButton>
        </Footer>
    </VanAnModal>
}

@code {
    private bool _loading = true;
    private bool _isLoggedIn = false;
    private string? _customerToken;
    private decimal _balance;
    private decimal _codHeld;
    private decimal _availableBalance;
    private string? _walletMessage;
    private bool _walletMessageIsError;
    private bool _showWithdrawModal;
    private decimal _withdrawAmount;
    private List<WalletHttpService.WalletTransactionResponse> _transactions = new();
    private List<WalletHttpService.PendingAdvanceResponse> _pendingAdvances = new();
    private List<WalletHttpService.PendingRemittanceResponse> _pendingRemittances = new();
    private List<WalletHttpService.WithdrawalItemResponse> _withdrawals = new();

    protected override async Task OnInitializedAsync()
    {
        _customerToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
        if (string.IsNullOrEmpty(_customerToken))
        {
            _isLoggedIn = false;
            _loading = false;
            return;
        }
        _isLoggedIn = true;

        await LoadWalletAsync();
        await LoadPendingAdvancesAsync();
        await LoadPendingRemittancesAsync();
        await LoadWithdrawalsAsync();
        _loading = false;
    }

    private async Task LoadWalletAsync()
    {
        var result = await WalletHttp.GetWalletAsync(_customerToken!);
        if (result.Success)
        {
            _balance = result.Balance;
            _codHeld = result.CodHeld;
            _availableBalance = result.AvailableBalance;
            _transactions = result.Transactions;
        }
        else
        {
            // 2026-09-25: surface load failures — previously the page silently rendered a 0đ
            // wallet on API error, which users reported as "ví không cập nhật".
            _walletMessage = $"Không tải được ví: {result.ErrorMessage}";
            _walletMessageIsError = true;
        }
    }

    private async Task LoadPendingRemittancesAsync()
    {
        var result = await WalletHttp.GetPendingRemittancesAsync(_customerToken!);
        if (result.Success)
            _pendingRemittances = result.Items;
    }

    private async Task LoadWithdrawalsAsync()
    {
        var result = await WalletHttp.GetWithdrawalsAsync(_customerToken!);
        if (result.Success)
            _withdrawals = result.Items;
    }

    private async Task RemitCod(Guid orderId)
    {
        _walletMessage = null;
        var result = await WalletHttp.RemitCodAsync(_customerToken!, orderId);
        if (result.Success)
        {
            _walletMessage = "Đã ghi nhận nộp tiền COD.";
            _walletMessageIsError = false;
        }
        else
        {
            _walletMessage = $"Không nộp được: {result.ErrorMessage}";
            _walletMessageIsError = true;
        }
        await LoadWalletAsync();
        await LoadPendingRemittancesAsync();
    }

    private async Task RequestWithdrawal()
    {
        _walletMessage = null;
        var result = await WalletHttp.RequestWithdrawalAsync(_customerToken!, _withdrawAmount);
        if (result.Success)
        {
            _walletMessage = "Đã gửi yêu cầu rút tiền — chờ admin duyệt.";
            _walletMessageIsError = false;
            _showWithdrawModal = false;
            _withdrawAmount = 0;
        }
        else
        {
            _walletMessage = $"Không gửi được: {result.ErrorMessage}";
            _walletMessageIsError = true;
            _showWithdrawModal = false;
        }
        await LoadWalletAsync();
        await LoadWithdrawalsAsync();
    }

    private async Task CancelWithdrawal(Guid requestId)
    {
        _walletMessage = null;
        var result = await WalletHttp.CancelWithdrawalAsync(_customerToken!, requestId);
        if (result.Success)
        {
            _walletMessage = "Đã huỷ yêu cầu rút tiền.";
            _walletMessageIsError = false;
        }
        else
        {
            _walletMessage = $"Không huỷ được: {result.ErrorMessage}";
            _walletMessageIsError = true;
        }
        await LoadWalletAsync();
        await LoadWithdrawalsAsync();
    }

    private static string GetWithdrawalStatusText(string status) => status switch
    {
        "Pending" => "Chờ duyệt",
        "Approved" => "Đã duyệt",
        "Rejected" => "Bị từ chối",
        "Paid" => "Đã chuyển khoản",
        "Cancelled" => "Đã huỷ",
        _ => status
    };

    private static string GetWithdrawalBadge(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Approved" => "bg-info",
        "Rejected" => "bg-danger",
        "Paid" => "bg-success",
        "Cancelled" => "bg-secondary",
        _ => "bg-secondary"
    };

    private async Task LoadPendingAdvancesAsync()
    {
        var result = await WalletHttp.GetPendingAdvancesAsync(_customerToken!);
        if (result.Success)
        {
            _pendingAdvances = result.Advances;
        }
    }

    private async Task ConfirmAdvanceReceived(Guid advanceTxId)
    {
        var result = await WalletHttp.ConfirmAdvanceReceivedAsync(_customerToken!, advanceTxId);
        if (result.Success)
        {
            await LoadWalletAsync();
            await LoadPendingAdvancesAsync();
        }
    }

    private void GoToLogin() => _ = JSRuntime.InvokeAsync<object>("localStorage.setItem", "redirectAfterLogin", "/community/wallet");

    private static string GetTxIcon(string type) => type switch
    {
        "CODCollection" => "bi bi-cash-coin text-success",
        "AdvancePayment" => "bi bi-arrow-up-circle text-warning",
        "Commission" => "bi bi-award text-primary",
        "Withdrawal" => "bi bi-arrow-down-circle text-danger",
        "Settlement" => "bi bi-arrow-left-right text-info",
        "Reversal" => "bi bi-arrow-counterclockwise text-danger",
        "Remittance" => "bi bi-send text-primary",
        _ => "bi bi-circle text-muted"
    };

    private static string GetTxTypeText(string type) => type switch
    {
        "CODCollection" => "Thu COD",
        "AdvancePayment" => "Ứng tiền",
        "Commission" => "Hoa hồng",
        "Withdrawal" => "Rút tiền",
        "Settlement" => "Thanh toán",
        "Reversal" => "Hoàn giao dịch",
        "Remittance" => "Nộp tiền COD",
        _ => type
    };
}
