@page "/scan"
@using VanAn.KhachLink.Components
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Components.Shared
@using VanAn.Shared.DTOs
@inject NavigationManager Navigation
@inject VanAn.KhachLink.Services.CartService CartService
@inject VanAn.KhachLink.Services.Http.ProductHttpService ProductService
@inject VanAn.KhachLink.Services.Http.CommunityHttpService CommunityHttp
@inject VanAn.KhachLink.Services.LastInteractionService LastInteractionService
@inject IJSRuntime JSRuntime

<PageTitle>Quét Mã QR - KhachLink</PageTitle>

<KhachLinkLayout>
  <ProfileGuard RequiredFlag="ShowScan" FeatureName="Quét QR">
    <div class="container-fluid scan-page-container py-2 px-2">
        <div class="row justify-content-center g-0">
            <div class="col-12 col-md-8 col-lg-6">
                <h3 class="text-center mb-2 scan-page-title">
                    <i class="bi bi-qr-code-scan text-primary"></i> Quét Mã QR
                </h3>

                <QRScanner OnQRCodeDetected="HandleQRCodeDetected" />

                @if (!string.IsNullOrEmpty(_referralMessage))
                {
                    <VanAnAlert Variant="AlertVariant.Success"
                               Message="@_referralMessage"
                               class="mt-2"
                               data-testid="referral-applied-banner" />
                }

                @if (_scannedProduct != null)
                {
                    <VanAnAlert Variant="AlertVariant.Success"
                               Message="Đã thêm sản phẩm vào giỏ hàng!"
                               class="mt-2" />

                    @if (!string.IsNullOrEmpty(_tableNumber))
                    {
                        <VanAnAlert Variant="AlertVariant.Info"
                                   Message="@($"Bàn số: {_tableNumber}")"
                                   class="mt-2"
                                   data-testid="table-number-display" />
                    }

                    <VanAnCard CssClass="mt-2 product-result-card">
                        <div class="card-body">
                            <div class="scan-product-row">
                                <div class="scan-product-image">
                                    <img src="@GetProductImageUrl(_scannedProduct)"
                                         alt="@_scannedProduct.Name"
                                         class="rounded"
                                         style="width: 80px; height: 80px; object-fit: cover;"
                                         onerror="this.onerror=null; this.src='https://placehold.co/100x100?text=@(System.Uri.EscapeDataString(_scannedProduct.Name))';" />
                                </div>
                                <div class="scan-product-info">
                                    <h5 class="mb-1 scan-product-name">@_scannedProduct.Name</h5>
                                    <p class="text-muted small mb-2 scan-product-desc">@_scannedProduct.Description</p>
                                    <div class="scan-product-bottom">
                                        <span class="h5 text-primary mb-0 scan-product-price">@_scannedProduct.Price.ToString("N0")đ</span>
                                        <div class="scan-product-actions">
                                            <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                                                       OnClick="@(() => { _scannedProduct = null; StateHasChanged(); })">
                                                Quét Tiếp
                                            </VanAnButton>
                                            @if (_scannedProduct.TenantId != Guid.Empty)
                                            {
                                                <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                                                           Icon="list"
                                                           OnClick="@(() => Navigation.NavigateTo($"/store/by-id/{_scannedProduct.TenantId}"))">
                                                    Xem Menu
                                                </VanAnButton>
                                            }
                                            <VanAnButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary" Icon="cart-plus"
                                                       OnClick="@(() => Navigation.NavigateTo("/cart"))">
                                                Đặt hàng
                                            </VanAnButton>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </VanAnCard>
                }

                @if (_errorMessage != null)
                {
                    <VanAnAlert Variant="AlertVariant.Error" Message="@_errorMessage" class="mt-2" />

                    <div class="text-center mt-2">
                        <VanAnButton Variant="ButtonVariant.Outline" OnClick="@(() => Navigation.NavigateTo("/"))">
                            Về Trang Chủ
                        </VanAnButton>
                    </div>
                }
            </div>
        </div>
    </div>
  </ProfileGuard>
</KhachLinkLayout>

<style>
    /* Mobile-first responsive Scan page */
    .scan-page-container {
        max-width: 100%;
    }

    .scan-page-card {
        width: 100%;
        border-radius: 12px;
    }

    .scan-page-title {
        font-size: 1.25rem;
    }

    /* Product result row — flex row on desktop, stacked on mobile */
    .scan-product-row {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .scan-product-image {
        flex-shrink: 0;
    }

    .scan-product-info {
        flex: 1 1 auto;
        min-width: 0; /* prevent flex overflow on mobile */
    }

    .scan-product-name {
        font-size: 1rem;
        word-break: break-word;
    }

    .scan-product-desc {
        font-size: 0.85rem;
        word-break: break-word;
    }

    .scan-product-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .scan-product-price {
        font-size: 1.1rem;
        white-space: nowrap;
    }

    .scan-product-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    /* Mobile breakpoint — stack product card vertically */
    @@media (max-width: 576px) {
        .scan-product-row {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .scan-product-image {
            margin-bottom: 0.5rem;
        }

        .scan-product-bottom {
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
        }

        .scan-product-actions {
            justify-content: center;
            width: 100%;
        }

        .scan-product-actions > * {
            flex: 1 1 auto;
        }

        .scan-page-title {
            font-size: 1.1rem;
        }
    }

    /* Tablet breakpoint — keep row but tighten spacing */
    @@media (max-width: 768px) {
        .scan-page-container {
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }
    }
</style>

@code {
    private ProductDto? _scannedProduct = null;
    private string? _errorMessage = null;
    private string? _tableNumber = null;
    private string? _referralMessage = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Bug 2b: When Zalo scans QR, it opens the URL https://.../scan?data={base64}
        // The page loads with the query param — parse it directly instead of waiting for camera scan
        if (firstRender)
        {
            var uri = Navigation.Uri;
            // R-GUARD-QR: If URL points to /qr/claim, redirect there (guard QR, not product QR)
            if (uri.Contains("/qr/claim", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo(uri);
                return;
            }
            if (uri.Contains("?data=") || uri.Contains("&data="))
            {
                var parsed = QRCodePayload.FromJson(Navigation.Uri);
                if (parsed != null)
                {
                    await ProcessQrPayload(parsed);
                }
            }

            // CC-S4 fix: referral QR opened by a phone camera → /scan?ref={compositeCode}
            // (the QR used to point at a non-existent /r/ route on a hardcoded domain).
            var refCode = GetReferralCodeFromUrl(uri);
            if (!string.IsNullOrEmpty(refCode))
            {
                await ProcessReferralCodeAsync(refCode);
            }
        }
    }

    /// <summary>Extract the composite referral code from a scanned referral QR URL (?ref=...).</summary>
    private string? GetReferralCodeFromUrl(string uri)
    {
        try
        {
            var query = System.Web.HttpUtility.ParseQueryString(new Uri(uri).Query);
            var refCode = query["ref"];
            if (!string.IsNullOrWhiteSpace(refCode) && refCode.Contains('|'))
                return refCode.Trim();

            // Backward compat: older printed QRs used /r/{salesmanCode}|{productShortCode}
            var idx = uri.IndexOf("/r/", StringComparison.OrdinalIgnoreCase);
            if (idx >= 0)
            {
                var code = uri.Substring(idx + 3);
                var cut = code.IndexOfAny(new[] { '?', '#' });
                if (cut >= 0) code = code.Substring(0, cut);
                code = Uri.UnescapeDataString(code);
                if (code.Contains('|')) return code.Trim();
            }
        }
        catch { /* malformed URL — ignore */ }
        return null;
    }

    /// <summary>
    /// CC-S4 fix: customer scanned a salesman referral QR → resolve the referred product, add it to
    /// the cart and remember the referral code so checkout links the order to the salesman
    /// (commission is created when the order completes). Mirrors the product-QR scan flow.
    /// </summary>
    private async Task ProcessReferralCodeAsync(string compositeCode)
    {
        _errorMessage = null;
        _referralMessage = null;

        // Remember the code so Checkout.razor sends it (Order.SalesmanId + ReferralProductId).
        await JSRuntime.InvokeAsync<bool>("vananAppInstall.saveReferralCode", new object[] { compositeCode });

        var resolved = await CommunityHttp.ResolveReferralAsync(compositeCode);
        if (resolved == null)
        {
            _errorMessage = "Mã QR giới thiệu không hợp lệ hoặc sản phẩm không còn bán.";
            StateHasChanged();
            return;
        }

        var product = new ProductDto
        {
            ProductId = resolved.ProductId,
            TenantId = resolved.TenantId,
            Name = resolved.Name,
            Price = resolved.Price,
            VatRate = resolved.VatRate,
            ImageUrl = resolved.ImageUrl,
            Description = resolved.Description,
            IsActive = true
        };

        await CartService.AddItemAsync(product, 1);
        await LastInteractionService.RecordInteractionAsync(product.TenantId);

        _scannedProduct = product;
        _referralMessage = string.IsNullOrEmpty(resolved.SalesmanCode)
            ? "Đã thêm sản phẩm giới thiệu vào giỏ hàng."
            : $"Đã thêm sản phẩm giới thiệu vào giỏ hàng. Salesman {resolved.SalesmanCode} sẽ được ghi nhận hoa hồng khi bạn đặt hàng thành công.";
        StateHasChanged();
    }

    private async Task HandleQRCodeDetected(string qrCodeText)
    {
        try
        {
            _errorMessage = null;
            _scannedProduct = null;
            _tableNumber = null;
            StateHasChanged();

            // R-GUARD-QR: If QR URL points to /qr/claim, redirect there instead of parsing as product QR.
            // Guard QR payload is {"t":"...","tn":"..."} — no Timestamp field → would show "hết hạn".
            if (qrCodeText.Contains("/qr/claim", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo(qrCodeText);
                return;
            }

            // CC-S4 fix: composite referral QR (new /scan?ref={code} format + legacy /r/{code}).
            // Resolves the referred product, adds it to the cart, and remembers the referral code.
            var referralCode = GetReferralCodeFromUrl(qrCodeText);
            if (!string.IsNullOrEmpty(referralCode))
            {
                await ProcessReferralCodeAsync(referralCode);
                return;
            }

            var qrPayload = QRCodePayload.FromJson(qrCodeText);

            if (qrPayload == null)
            {
                _errorMessage = "Mã QR không hợp lệ. Vui lòng quét mã QR sản phẩm của Vạn An.";
                StateHasChanged();
                return;
            }

            await ProcessQrPayload(qrPayload);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi khi xử lý mã QR: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ProcessQrPayload(QRCodePayload qrPayload)
    {
        _tableNumber = qrPayload.TableNumber;

        // Validate QR code timestamp (prevent old QR codes from being used)
        var qrTimestamp = DateTimeOffset.FromUnixTimeSeconds(qrPayload.Timestamp);
        var maxAge = TimeSpan.FromDays(30);

        if (DateTimeOffset.UtcNow - qrTimestamp > maxAge)
        {
            _errorMessage = "Mã QR đã hết hạn. Vui lòng yêu cầu mã QR mới.";
            StateHasChanged();
            return;
        }

        // Phase 5: Fast path — if QR has price + tenantId (new QR codes printed after Phase 5),
        // add to cart directly WITHOUT an API call. Much faster for the customer.
        if (qrPayload.UnitPrice > 0 && qrPayload.TenantId != Guid.Empty)
        {
            _scannedProduct = new ProductDto
            {
                ProductId = qrPayload.ProductId,
                TenantId = qrPayload.TenantId,
                Name = qrPayload.ProductName ?? "Sản phẩm",
                Price = qrPayload.UnitPrice,
                VatRate = qrPayload.VatRate,
                ImageUrl = qrPayload.ImageUrl,
                Description = null,
                IsActive = true
            };
            await CartService.AddItemAsync(_scannedProduct, 1);
            // Track last interaction tenantId for Home page personalization
            await LastInteractionService.RecordInteractionAsync(_scannedProduct.TenantId);
            StateHasChanged();
            return;
        }

        // Legacy path: old QR codes (no price/VAT/name in payload) → fetch product from API.
        // Shop entity removed 2026-07-21 — prefer TenantId; fall back to legacy ShopId (which was the tenantId).
        Guid legacyTenantId = qrPayload.TenantId != Guid.Empty ? qrPayload.TenantId : qrPayload.ShopId;
        var products = await ProductService.GetProductsAsync(legacyTenantId);
        _scannedProduct = products.FirstOrDefault(p => p.ProductId == qrPayload.ProductId);

        if (_scannedProduct == null)
        {
            _errorMessage = "Không tìm thấy sản phẩm từ mã QR. Sản phẩm có thể đã bị xóa hoặc không tồn tại.";
            StateHasChanged();
            return;
        }

        // Add to cart
        await CartService.AddItemAsync(_scannedProduct, 1);
        // Track last interaction tenantId for Home page personalization
        await LastInteractionService.RecordInteractionAsync(_scannedProduct.TenantId);
        StateHasChanged();
    }

    /// <summary>
    /// Resolve product image URL — handles absolute URLs, relative paths (prefix with gateway base),
    /// and null/empty (fallback to placeholder with product name).
    /// </summary>
    private string GetProductImageUrl(ProductDto product)
    {
        if (product == null || string.IsNullOrWhiteSpace(product.ImageUrl))
            return $"https://placehold.co/100x100?text={System.Uri.EscapeDataString(product?.Name ?? "Sản phẩm")}";

        string url = product.ImageUrl;
        // Already absolute URL (http/https) → use as-is
        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return url;

        // Relative path → prefix with gateway base URL
        // (ShopERP serves product images under /api/products/{id}/image or /uploads/...)
        string baseUri = Navigation.BaseUri.TrimEnd('/');
        return $"{baseUri}/{url.TrimStart('/')}";
    }
}