    @* W3-T1: Voice note toggle ON â€” show STT UI *@
    <div class="voice-note-container" data-testid="voice-note-container">
        <div class="voice-header">
            <h2 data-testid="voice-note-header">ðŸŽ¤ Ghi chÃº giá»ng nÃ³i</h2>
