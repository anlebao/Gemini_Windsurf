@code {
    [Parameter] public string? OrderId { get; set; }

    private bool isRecording = false;
    private string transcriptionText = "";
    private string? _successMessage;
    private string? _errorMessage;
    private DotNetObjectReference<VoiceNote>? dotNetRef;
    // W3-T1: Voice note toggle â€” default OFF (per seed default)
    private bool voiceNoteEnabled = false;

    private HttpClient Http => HttpClientFactory.CreateClient("gateway");

    protected override async Task OnInitializedAsync()
    {
        // W3-T1: Load voice note toggle from shop feature settings
        try
        {
            // TenantId from query string or default â€” VoiceNote page is customer-facing
            // For now, use the default tenant (00000000-...001) since customer hasn't logged in
            voiceNoteEnabled = await FeatureSettings.IsEnabledAsync(
                new Guid("00000000-0000-0000-0000-000000000001"),
                nameof(ShopFeatureSettingsDto.Voice_Note_Enabled));
        }
        catch
        {
            voiceNoteEnabled = false; // Default to OFF if fetch fails
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && voiceNoteEnabled) // W3-T1: Only init STT if toggle ON
        {
            dotNetRef = DotNetObjectReference.Create(this);
            JSRuntime.InvokeVoidAsync("initializeSpeechRecognition", dotNetRef);
        }
    }

    private async Task ToggleRecording()
    {
        if (!isRecording)
        {
            isRecording = true;
            await JSRuntime.InvokeVoidAsync("startRecording");
        }
        else
        {
            isRecording = false;
            await JSRuntime.InvokeVoidAsync("stopRecording");
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void SetTranscriptionText(string text)
    {
        transcriptionText = text;
        StateHasChanged();
    }

    private void ClearRecording()
    {
        transcriptionText = "";
        _successMessage = null;
        _errorMessage = null;
        StateHasChanged();
    }

    private async Task SubmitVoiceNote()
    {
        if (string.IsNullOrEmpty(transcriptionText)) return;
        try
        {
            var payload = new
            {
                CommandText = transcriptionText,
                OrderId = OrderId ?? string.Empty,
                Parameters = "voice_note"
            };
            var response = await Http.PostAsJsonAsync("/api/v1/voicecommand/text-command", payload);
            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Ghi chÃº Ä‘Ã£ Ä‘Æ°á»£c gá»­i thÃ nh cÃ´ng!";
                _errorMessage = null;
                StateHasChanged();
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                _errorMessage = $"Lá»—i khi gá»­i ghi chÃº (HTTP {(int)response.StatusCode}). Vui lÃ²ng thá»­ láº¡i.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Lá»—i káº¿t ná»‘i. Vui lÃ²ng thá»­ láº¡i.";
            Console.WriteLine($"VoiceNote submit error: {ex.Message}");
            StateHasChanged();
        }
    }

    private void Cancel() => NavigationManager.NavigateTo("/");

    public void Dispose() => dotNetRef?.Dispose();
}

<script>
    // ðŸŽ¤ NATIVE BROWSER SPEECH RECOGNITION API (ZERO-COST)
    let recognition = null;
    let dotNetRef = null;

    function initializeSpeechRecognition(dotNetReference) {
        dotNetRef = dotNetReference;

        // Check browser support
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

        if (!SpeechRecognition) {
            alert('TrÃ¬nh duyá»‡t cá»§a báº¡n khÃ´ng há»— trá»£ nháº­n dáº¡ng giá»ng nÃ³i. Vui lÃ²ng sá»­ dá»¥ng Chrome.');
            return;
        }

        recognition = new SpeechRecognition();
        recognition.lang = 'vi-VN'; // ðŸ‡»ðŸ‡³ Vietnamese language
        recognition.continuous = false;
        recognition.interimResults = false;
        recognition.maxAlternatives = 1;

        recognition.onresult = function(event) {
            const transcript = event.results[0][0].transcript;
            console.log('Transcription:', transcript);
            dotNetRef.invokeMethodAsync('SetTranscriptionText', transcript);
        };

        recognition.onerror = function(event) {
            console.error('Speech recognition error:', event.error);
            let errorMessage = 'Lá»—i nháº­n dáº¡ng giá»ng nÃ³i.';

            switch(event.error) {
                case 'no-speech':
                    errorMessage = 'KhÃ´ng phÃ¡t hiá»‡n giá»ng nÃ³i. Vui lÃ²ng thá»­ láº¡i.';
                    break;
                case 'audio-capture':
                    errorMessage = 'KhÃ´ng thá»ƒ truy cáº­p micro. Vui lÃ²ng cáº¥p quyá»n micro.';
                    break;
                case 'not-allowed':
                    errorMessage = 'Quyá»n truy cáº­p micro bá»‹ tá»« chá»‘i.';
                    break;
                case 'network':
                    errorMessage = 'Lá»—i máº¡ng. Vui lÃ²ng kiá»ƒm tra káº¿t ná»‘i.';
                    break;
            }

            alert(errorMessage);
        };

        recognition.onend = function() {
            // Auto-stop recording when done
            if (window.isRecording) {
                window.isRecording = false;
                // Update UI via Blazor
                dotNetRef.invokeMethodAsync('SetTranscriptionText',
                    document.getElementById('transcription-text')?.value || '');
            }
        };
    }

    function startRecording() {
        if (recognition) {
            window.isRecording = true;
            recognition.start();
            console.log('Started recording in Vietnamese...');
        }
    }

    function stopRecording() {
        if (recognition && window.isRecording) {
            window.isRecording = false;
            recognition.stop();
            console.log('Stopped recording...');
        }
    }
</script>

<style>
    .voice-note-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 2rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .voice-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .voice-header h2 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .voice-header p {
        color: #7f8c8d;
        margin: 0;
    }

    .voice-controls {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .record-btn {
        background: #e74c3c;
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 50px;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .record-btn:hover:not(:disabled) {
        background: #c0392b;
        transform: scale(1.05);
    }

    .record-btn:disabled {
        background: #95a5a6;
        cursor: not-allowed;
        transform: none;
    }

    .clear-btn {
        background: #95a5a6;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .clear-btn:hover:not(:disabled) {
        background: #7f8c8d;
        transform: scale(1.05);
    }

    .voice-status {
        background: #ecf0f1;
        padding: 1.5rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        min-height: 100px;
    }

    .recording-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: #e74c3c;
        font-weight: bold;
    }

    .recording-dot {
        width: 12px;
        height: 12px;
        background: #e74c3c;
        border-radius: 50%;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }

    .transcription-result {
        margin-top: 1rem;
    }

    .transcription-result h4 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .transcription-result p {
        background: white;
