@page "/voice-note"
@page "/voice-note/{OrderId}"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Tokens
@using VanAn.KhachLink.Services.Http
@using VanAn.Shared.DTOs
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ShopFeatureSettingsHttpService FeatureSettings
@implements IDisposable

<PageTitle>Voice Note - Vạn An</PageTitle>

@* Alerts thay thế alert() native *@
@if (!string.IsNullOrEmpty(_successMessage))
{
    <VanAnAlert Variant="AlertVariant.Success" Message="@_successMessage" />
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <VanAnAlert Variant="AlertVariant.Error" Message="@_errorMessage" />
}

@if (!voiceNoteEnabled)
{
    @* W3-T1: Voice note toggle OFF — show text-only note input *@
    <div class="voice-note-container" data-testid="voice-note-disabled">
        <div class="voice-header">
            <h2>📝 Ghi chú đơn hàng</h2>
            <p>Ghi chú giọng nói đã tắt — vui lòng nhập văn bản</p>
        </div>
        @if (string.IsNullOrEmpty(OrderId))
        {
            <VanAnAlert Variant="AlertVariant.Warning" Message="Không xác định được đơn hàng. Vui lòng quay lại giỏ hàng để thêm ghi chú." />
        }
        else
        {
            <textarea class="form-control" rows="3" placeholder="Nhập ghi chú cho đơn hàng..."
                      @bind="transcriptionText" data-testid="text-note-input"></textarea>
            <div class="voice-actions mt-3">
                <VanAnButton OnClick="SubmitVoiceNote" Disabled="@string.IsNullOrEmpty(transcriptionText)">
                    📤 Gửi ghi chú
                </VanAnButton>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="Cancel">
                    ❌ Hủy
                </VanAnButton>
            </div>
        }
    </div>
}
else
{
    @* W3-T1: Voice note toggle ON — show STT UI *@
    <div class="voice-note-container" data-testid="voice-note-container">
        <div class="voice-header">
            <h2 data-testid="voice-note-header">🎤 Ghi chú giọng nói</h2>
            <p>Thêm ghi chú giọng nói cho đơn hàng của bạn</p>
        </div>

        @if (string.IsNullOrEmpty(OrderId))
        {
            <VanAnAlert Variant="AlertVariant.Warning" Message="Không xác định được đơn hàng. Vui lòng quay lại giỏ hàng để thêm ghi chú." />
        }
        else
        {
            <div class="voice-controls">
                <VanAnButton OnClick="ToggleRecording" Disabled="@isRecording">
                    @(isRecording ? "⏹️ Dừng ghi âm" : "🎤 Bắt đầu ghi âm")
                </VanAnButton>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="ClearRecording" Disabled="@isRecording">
                    🗑️ Xóa
                </VanAnButton>
            </div>

            <div class="voice-status">
                @if (isRecording)
                {
                    <div class="recording-indicator">
                        <span class="recording-dot"></span>
                        <span>Đang ghi âm...</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(transcriptionText))
                {
                    <div class="transcription-result">
                        <h4>Văn bản chuyển đổi:</h4>
                        <p data-testid="transcription-text">@transcriptionText</p>
                    </div>
                }
            </div>

            <div class="voice-actions">
                <VanAnButton OnClick="SubmitVoiceNote" Disabled="@string.IsNullOrEmpty(transcriptionText)">
                    📤 Gửi ghi chú
                </VanAnButton>
                <VanAnButton Variant="ButtonVariant.Outline" OnClick="Cancel">
                    ❌ Hủy
                </VanAnButton>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string? OrderId { get; set; }

    private bool isRecording = false;
    private string transcriptionText = "";
    private string? _successMessage;
    private string? _errorMessage;
    private DotNetObjectReference<VoiceNote>? dotNetRef;
    // W3-T1: Voice note toggle — default OFF (per seed default)
    private bool voiceNoteEnabled = false;

    private HttpClient Http => HttpClientFactory.CreateClient("gateway");

    protected override async Task OnInitializedAsync()
    {
        // W3-T1: Load voice note toggle from shop feature settings
        try
        {
            // TenantId from query string or default — VoiceNote page is customer-facing
            // For now, use the default tenant (00000000-...001) since customer hasn't logged in
            voiceNoteEnabled = await FeatureSettings.IsEnabledAsync(
                new Guid("00000000-0000-0000-0000-000000000001"),
                nameof(ShopFeatureSettingsDto.Voice_Note_Enabled));
        }
        catch
        {
            voiceNoteEnabled = false; // Default to OFF if fetch fails
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && voiceNoteEnabled) // W3-T1: Only init STT if toggle ON
        {
            dotNetRef = DotNetObjectReference.Create(this);
            JSRuntime.InvokeVoidAsync("initializeSpeechRecognition", dotNetRef);
        }
    }

    private async Task ToggleRecording()
    {
        if (!isRecording)
        {
            isRecording = true;
            await JSRuntime.InvokeVoidAsync("startRecording");
        }
        else
        {
            isRecording = false;
            await JSRuntime.InvokeVoidAsync("stopRecording");
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void SetTranscriptionText(string text)
    {
        transcriptionText = text;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVoiceError(string errorMessage)
    {
        _errorMessage = errorMessage;
        isRecording = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnRecordingEnd()
    {
        isRecording = false;
        StateHasChanged();
    }

    private void ClearRecording()
    {
        transcriptionText = "";
        _successMessage = null;
        _errorMessage = null;
        StateHasChanged();
    }

    private async Task SubmitVoiceNote()
    {
        if (string.IsNullOrEmpty(transcriptionText)) return;

        // Validate OrderId — required to attach note to a specific order
        if (string.IsNullOrEmpty(OrderId) || !Guid.TryParse(OrderId, out _))
        {
            _errorMessage = "Không xác định được đơn hàng. Vui lòng quay lại giỏ hàng và thử lại.";
            StateHasChanged();
            return;
        }

        try
        {
            // Call the correct endpoint: PUT /api/v1/orders/{orderId}/note
            // This calls OrderService.UpdateOrderVoiceNoteAsync which saves to Order.VoiceNoteText
            var payload = new { Note = transcriptionText };
            var response = await Http.PutAsJsonAsync($"/api/v1/orders/{OrderId}/note", payload);
            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Ghi chú đã được gửi thành công!";
                _errorMessage = null;
                StateHasChanged();
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                _errorMessage = $"Lỗi khi gửi ghi chú (HTTP {(int)response.StatusCode}). Vui lòng thử lại.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi kết nối. Vui lòng thử lại.";
            Console.WriteLine($"VoiceNote submit error: {ex.Message}");
            StateHasChanged();
        }
    }

    private void Cancel() => NavigationManager.NavigateTo("/");

    public void Dispose() => dotNetRef?.Dispose();
}

<style>
    .voice-note-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 2rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .voice-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .voice-header h2 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .voice-header p {
        color: #7f8c8d;
        margin: 0;
    }

    .voice-controls {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .record-btn {
        background: #e74c3c;
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 50px;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .record-btn:hover:not(:disabled) {
        background: #c0392b;
        transform: scale(1.05);
    }

    .record-btn:disabled {
        background: #95a5a6;
        cursor: not-allowed;
        transform: none;
    }

    .clear-btn {
        background: #95a5a6;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .clear-btn:hover:not(:disabled) {
        background: #7f8c8d;
        transform: scale(1.05);
    }

    .voice-status {
        background: #ecf0f1;
        padding: 1.5rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        min-height: 100px;
    }

    .recording-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: #e74c3c;
        font-weight: bold;
    }

    .recording-dot {
        width: 12px;
        height: 12px;
        background: #e74c3c;
        border-radius: 50%;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }

    .transcription-result {
        margin-top: 1rem;
    }

    .transcription-result h4 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .transcription-result p {
        background: white;
        padding: 1rem;
        border-radius: 5px;
        border-left: 4px solid #27ae60;
        margin: 0;
        font-size: 1.1rem;
        line-height: 1.5;
    }

    .voice-actions {
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .submit-btn {
        background: #27ae60;
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 25px;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .submit-btn:hover:not(:disabled) {
        background: #219a52;
        transform: scale(1.05);
    }

    .submit-btn:disabled {
        background: #95a5a6;
        cursor: not-allowed;
        transform: none;
    }

    .cancel-btn {
        background: #e74c3c;
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 25px;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .cancel-btn:hover {
        background: #c0392b;
        transform: scale(1.05);
    }

    @@media (max-width: 768px) {
        .voice-note-container {
            padding: 1rem;
        }

        .voice-controls {
            flex-direction: column;
            align-items: center;
        }

        .record-btn, .clear-btn, .submit-btn, .cancel-btn {
            width: 100%;
            max-width: 300px;
        }
    }
</style>
