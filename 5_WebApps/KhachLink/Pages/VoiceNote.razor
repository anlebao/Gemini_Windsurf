    <div class="voice-note-container" data-testid="voice-note-disabled">
        <div class="voice-header">
            <h2>ðŸ“ Ghi chÃº Ä‘Æ¡n hÃ ng</h2>
            <p>Ghi chÃº giá»ng nÃ³i Ä‘Ã£ táº¯t â€” vui lÃ²ng nháº­p vÄƒn báº£n</p>
        </div>
        <textarea class="form-control" rows="3" placeholder="Nháº­p ghi chÃº cho Ä‘Æ¡n hÃ ng..."
                  @bind="transcriptionText" data-testid="text-note-input"></textarea>
        <div class="voice-actions mt-3">
            <VanAnButton OnClick="SubmitVoiceNote" Disabled="@string.IsNullOrEmpty(transcriptionText)">
