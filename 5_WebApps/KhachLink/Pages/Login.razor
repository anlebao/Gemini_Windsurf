@page "/login"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ILogger<Login> _logger

<PageTitle>Đăng nhập</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width:480px;">
        <VanAnCard Shadow="true" CssClass="p-4">
            <h3 class="text-center mb-4">
                <i class="bi bi-person-circle text-primary"></i> Đăng nhập
            </h3>

            @if (_step == LoginStep.Phone)
            {
                <!-- Tiered Auth Phase 3: Google Social Login button (free, no OTP cost) -->
                <VanAnButton Variant="ButtonVariant.Outline"
                             FullWidth="true"
                             CssClass="mb-3 d-flex align-items-center justify-content-center gap-2"
                             OnClick="LoginWithGoogle"
                             TestId="btn-google-login">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z" fill="#EA4335"/>
                    </svg>
                    Đăng nhập với Google
                </VanAnButton>

                <div class="text-center text-muted my-3" style="font-size:0.85rem;">
                    <span style="background:var(--bs-body-bg); padding:0 8px; position:relative; z-index:1;">hoặc</span>
                    <hr class="mt-n3" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Số điện thoại</label>
                    <input type="tel" class="form-control form-control-lg"
                           placeholder="0901234567"
                           @bind="_phone" @bind:event="oninput"
                           @onkeyup="OnPhoneKeyUp" />
                </div>
                @if (_error != null)
                {
                    <VanAnAlert Variant="AlertVariant.Error" Message="@_error" />
                }
                <VanAnButton Variant="ButtonVariant.Primary"
                             FullWidth="true"
                             OnClick="SendOtp">
                    @(_loading ? "Đang gửi..." : "Gửi mã OTP")
                </VanAnButton>
            }
            else if (_step == LoginStep.Otp)
            {
                <p class="text-muted text-center mb-3">
                    Nhập mã OTP đã gửi đến <strong>@_phone</strong>
                </p>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mã OTP (6 chữ số)</label>
                    <input type="number" class="form-control form-control-lg text-center"
                           placeholder="123456" maxlength="6"
                           @bind="_otp" @bind:event="oninput"
                           @onkeyup="OnOtpKeyUp" />
                </div>
                @if (_error != null)
                {
                    <VanAnAlert Variant="AlertVariant.Error" Message="@_error" />
                }
                <VanAnButton Variant="ButtonVariant.Primary"
                             FullWidth="true"
                             OnClick="VerifyOtp">
                    @(_loading ? "Đang xác nhận..." : "Xác nhận")
                </VanAnButton>
                <div class="text-center mt-2">
                    <button class="btn btn-link btn-sm" @onclick="() => { _step = LoginStep.Phone; _error = null; }">
                        Đổi số điện thoại
                    </button>
                </div>
            }
            else if (_step == LoginStep.Success)
            {
                <div class="text-center py-3">
                    <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
                    <h5 class="mt-2">Đăng nhập thành công!</h5>
                    <p class="text-muted">Chào mừng bạn trở lại.</p>
                </div>
            }
        </VanAnCard>
    </div>
</KhachLinkLayout>

@code {
    private enum LoginStep { Phone, Otp, Success }
    private LoginStep _step = LoginStep.Phone;
    private string _phone = "";
    private string _otp = "";
    private bool _loading = false;
    private string? _error;

    private async Task OnPhoneKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendOtp();
    }

    private async Task OnOtpKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await VerifyOtp();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Tiered Auth Phase 3: Check for OAuth callback token in URL query param
            // Google OAuth flow: Login → Google consent → ShopERP callback → redirect here with ?token=...&provider=google
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var callbackToken = query["token"];
            var callbackProvider = query["provider"];
            var callbackCustomerId = query["customerId"];
            var callbackError = query["error"];

            if (!string.IsNullOrEmpty(callbackError))
            {
                _error = callbackError == "auth_failed"
                    ? "Đăng nhập Google thất bại. Vui lòng thử lại."
                    : $"Lỗi: {callbackError}";
                _step = LoginStep.Phone;
                StateHasChanged();
                // Clean URL
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            if (!string.IsNullOrEmpty(callbackToken))
            {
                // Store token from OAuth callback
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "customer_token", callbackToken);
                if (!string.IsNullOrEmpty(callbackProvider))
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "login_provider", callbackProvider);
                // Store customerId so checkout can link orders to this customer
                if (!string.IsNullOrEmpty(callbackCustomerId))
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "customer_id", callbackCustomerId);

                _step = LoginStep.Success;
                StateHasChanged();
                // CC-S0-T3: Register device fingerprint after Google OAuth login success
                _ = RegisterDeviceFingerprintAsync(callbackToken);
                await Task.Delay(1500);
                Navigation.NavigateTo("/profile");
                return;
            }

            // If already logged in, redirect to profile
            var existingToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (!string.IsNullOrEmpty(existingToken))
                Navigation.NavigateTo("/profile");
        }
    }

    /// <summary>Tiered Auth Phase 3: Redirect to Google OAuth login via Gateway.</summary>
    private void LoginWithGoogle()
    {
        // Gateway (5001) forwards /api/auth/* to ShopERP (5003)
        // ShopERP redirects to Google consent → callback → redirect back to KhachLink /login?token=...
        var gatewayBase = HttpClientFactory.CreateClient("gateway").BaseAddress;
        Navigation.NavigateTo($"{gatewayBase}api/auth/google/login", forceLoad: true);
    }

    private async Task SendOtp()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_phone))
        {
            _error = "Vui lòng nhập số điện thoại.";
            return;
        }
        _loading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("gateway");
            var resp = await client.PostAsJsonAsync("/api/customers/otp/send", new { phoneNumber = _phone });
            if (resp.IsSuccessStatusCode)
            {
                _step = LoginStep.Otp;
            }
            else
            {
                _error = "Không thể gửi OTP. Vui lòng thử lại.";
            }
        }
        catch { _error = "Lỗi kết nối. Vui lòng thử lại."; }
        finally { _loading = false; }
    }

    private async Task VerifyOtp()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_otp))
        {
            _error = "Vui lòng nhập mã OTP.";
            return;
        }
        _loading = true;
        try
        {
            var deviceId = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "device_id");
            var client = HttpClientFactory.CreateClient("gateway");
            var resp = await client.PostAsJsonAsync("/api/customers/otp/verify", new
            {
                phoneNumber = _phone,
                otp = _otp,
                deviceId = deviceId
            });

            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<CustomerIdentityResult>();
                if (result != null)
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "customer_token", result.CustomerToken);
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "customer_id", result.CustomerId.ToString());
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "customer_name", result.FullName);
                }
                _step = LoginStep.Success;
                // CC-S0-T3: Register device fingerprint after OTP login success
                if (result != null)
                    _ = RegisterDeviceFingerprintAsync(result.CustomerToken);
                await Task.Delay(1500);
                Navigation.NavigateTo("/profile");
            }
            else
            {
                _error = "OTP không đúng hoặc đã hết hạn.";
            }
        }
        catch { _error = "Lỗi kết nối. Vui lòng thử lại."; }
        finally { _loading = false; }
    }

    /// <summary>
    /// CC-S0-T3 (Sprint 0.5): Collect browser fingerprint + register device via Gateway.
    /// Fire-and-forget (non-blocking) — fingerprint failure should NOT block login.
    /// Called after both Google OAuth + OTP login success.
    /// </summary>
    private async Task RegisterDeviceFingerprintAsync(string customerToken)
    {
        try
        {
            // 1. Collect fingerprint via JS interop (window.fingerprint.collect)
            var fp = await JSRuntime.InvokeAsync<FingerprintResult>("window.fingerprint.collect");
            if (fp == null || string.IsNullOrEmpty(fp.Hash))
            {
                _logger?.LogDebug("Fingerprint collection returned empty result — skipping device registration.");
                return;
            }

            // 2. Generate or reuse device token (UUID, persisted in localStorage)
            var deviceToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "device_token");
            if (string.IsNullOrEmpty(deviceToken))
            {
                deviceToken = Guid.NewGuid().ToString("N");
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "device_token", deviceToken);
            }

            // 3. POST to Gateway /api/customer-identity/device/register
            var client = HttpClientFactory.CreateClient("gateway");
            client.DefaultRequestHeaders.Clear();
            client.DefaultRequestHeaders.Add("X-Customer-Token", customerToken);
            var resp = await client.PostAsJsonAsync("/api/customer-identity/device/register", new
            {
                deviceToken = deviceToken,
                fingerprintHash = fp.Hash,
                fingerprintSignals = fp.Signals ?? "{}",
                userAgent = fp.UserAgent ?? "",
                platform = fp.Platform ?? ""
            });

            if (resp.IsSuccessStatusCode)
                _logger?.LogInformation("Device fingerprint registered successfully (hash={Hash})", fp.Hash);
            else
                _logger?.LogWarning("Device fingerprint registration failed: {StatusCode}", resp.StatusCode);
        }
        catch (Exception ex)
        {
            // Non-blocking — fingerprint failure should NOT affect login
            _logger?.LogWarning(ex, "Device fingerprint registration error (non-blocking)");
        }
    }

    private class FingerprintResult
    {
        public string Hash { get; set; } = string.Empty;
        public string? Signals { get; set; }
        public string? UserAgent { get; set; }
        public string? Platform { get; set; }
    }

    private class CustomerIdentityResult
    {
        public Guid CustomerId { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string CustomerToken { get; set; } = string.Empty;
        public string Tier { get; set; } = "Bronze";
        public int PointBalance { get; set; }
    }
}
