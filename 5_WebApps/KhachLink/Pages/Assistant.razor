@page "/a/{Slug}"
@using VanAn.KhachLink.Services.Http
@using VanAn.UI.Platform.Components.Ai
@using VanAn.UI.Platform.Components.Realtime
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject CommunityHttpService CommunityHttp

@* UNIVERSAL AI ASSISTANT W1 (2026-11-22): hosted AI Link page — /a/{slug}.
   Khách quét QR/dán link → trang chat full với assistant của shop.
   Flow: resolve slug → tenantId (server-side, slug là capability duy nhất)
   → tái dùng IAiChatClient + public tenant-ai endpoints (cùng code path
   storefront — không duplicate chat logic).
   Human handoff: guest device id (localStorage customer_device_id — cùng
   cơ chế Store.razor F8) → anonymous visitor chat được với chủ quán.
   Product card "Thêm vào giỏ" → deep-link về storefront /store/by-id/{tid}
   (giỏ hàng sống ở storefront context, không phải trang link). *@

<PageTitle>Trợ lý AI</PageTitle>

<div class="assistant-page">
    @if (_loading)
    {
        <div class="assistant-status">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Đang kết nối trợ lý…</p>
        </div>
    }
    else if (_resolveFailed)
    {
        <div class="assistant-status">
            <i class="bi bi-emoji-frown fs-1"></i>
            <h5>Trợ lý không khả dụng</h5>
            <p>Link này không tồn tại hoặc shop đã tắt trợ lý AI.</p>
        </div>
    }
    else if (_tenantId.HasValue)
    {
        <div class="assistant-header">
            <i class="bi bi-robot"></i>
            <div>
                <h1>Trợ lý AI</h1>
                <p>Hỏi đáp nhanh về sản phẩm, giá cả và cửa hàng</p>
            </div>
        </div>

        @* OpenPanel consume-once: field reset về false sau lần đầu → user đóng
           được. SessionStorageKey per-slug: nhiều shop cùng domain KhachLink
           không share session id. *@
        <AiChatWidget TenantId="_tenantId.Value"
                      Locale="vi"
                      OpenPanel="_openPanel"
                      OpenPanelChanged="v => _openPanel = v"
                      SessionStorageKey="@($"vanan_ai_session_{Slug}")"
                      HumanChatAvailable="_handoffAvailable"
                      OnAddToCart="OnAddToCartAsync"
                      OnDraftRequest="OnAiEscalateDraft"
                      @bind-OpenHumanPanel="_openHumanPanel"
                      ExternalCallState="_humanCallState">
            <HumanContent>
                @if (ChatIdentity.HasValue)
                {
                    <RealtimeChatPanel SubjectType="Shop"
                                       SubjectId="_tenantId.Value"
                                       CurrentUserId="ChatIdentity.Value"
                                       CustomerToken="@_customerToken"
                                       CustomerDeviceId="@_customerDeviceId"
                                       ScrollContainerId="ai-widget-human-scroll"
                                       ShowHeader="false"
                                       HeaderTitle="Chủ quán"
                                       InitialDraft="@_humanDraft"
                                       VoiceCallStateChanged="OnHumanCallStateChanged" />
                }
            </HumanContent>
        </AiChatWidget>
    }
</div>

<style>
    .assistant-page {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        background: var(--vanan-color-bg, #f6f7f9);
    }
    .assistant-status {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .75rem;
        color: var(--vanan-color-text-muted, #6c757d);
        padding: 2rem;
        text-align: center;
    }
    .assistant-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: 1rem 1.25rem;
        background: var(--vanan-color-surface, #fff);
        border-bottom: 1px solid var(--vanan-color-border, #e9ecef);
    }
    .assistant-header i { font-size: 1.75rem; color: var(--vanan-color-primary, #0d6efd); }
    .assistant-header h1 { font-size: 1.15rem; margin: 0; }
    .assistant-header p { margin: 0; font-size: .8rem; color: var(--vanan-color-text-muted, #6c757d); }
</style>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _resolveFailed;
    private bool _openPanel = true;
    private Guid? _tenantId;

    // ── Human handoff (guest device id — pattern Store.razor F8) ──────────
    private string? _customerToken;
    private Guid? _customerId;
    private Guid? _customerDeviceId;
    private Guid? ChatIdentity => _customerId ?? _customerDeviceId;
    private bool _handoffAvailable;
    private string? _humanDraft;
    private string? _humanCallState;
    private bool _openHumanPanel;

    protected override async Task OnInitializedAsync()
    {
        // Guest/customer identity cho human chat — localStorage keys giống Store/Checkout.
        _customerToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
        var deviceIdStr = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_device_id");
        if (string.IsNullOrEmpty(deviceIdStr))
        {
            deviceIdStr = Guid.NewGuid().ToString();
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "customer_device_id", deviceIdStr);
        }
        if (Guid.TryParse(deviceIdStr, out var deviceId) && deviceId != Guid.Empty)
            _customerDeviceId = deviceId;

        if (!string.IsNullOrEmpty(_customerToken))
        {
            try
            {
                _customerId = await CommunityHttp.GetCustomerIdAsync(_customerToken);
            }
            catch { /* token invalid — fall back to guest chat */ }
            if (_customerId == null)
                _customerToken = null;
        }
        _handoffAvailable = ChatIdentity.HasValue;

        try
        {
            var http = HttpClientFactory.CreateClient("gateway");
            var resp = await http.GetAsync(
                $"api/public/assistant-link/{Uri.EscapeDataString(Slug)}/resolve");
            if (!resp.IsSuccessStatusCode)
            {
                _resolveFailed = true;
                return;
            }
            var dto = await resp.Content.ReadFromJsonAsync<ResolveDto>();
            // aiEnabled=false (flag off / forwarder chưa cấu hình) → trang unavailable,
            // không render widget rỗng.
            if (dto?.TenantId is Guid tid && tid != Guid.Empty && dto.AiEnabled)
                _tenantId = tid;
            else
                _resolveFailed = true;
        }
        catch
        {
            _resolveFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>AI refuse → "Hỏi chủ quán" draft → human panel (pattern Store.razor).</summary>
    private void OnAiEscalateDraft(string? draft) => _humanDraft = draft;

    private void OnHumanCallStateChanged(string state) => _humanCallState = state;

    /// <summary>Product card trên trang link không có cart context → đưa khách về
    /// storefront của shop để thêm giỏ (route /store/by-id/{tenantId} đã có sẵn).</summary>
    private Task OnAddToCartAsync(AiProductCardItem product)
        => _tenantId.HasValue
            ? Task.Run(() => Nav.NavigateTo($"/store/by-id/{_tenantId.Value}"))
            : Task.CompletedTask;

    private sealed class ResolveDto
    {
        public Guid? TenantId { get; set; }
        public string? Slug { get; set; }
        public bool AiEnabled { get; set; }
    }
}
