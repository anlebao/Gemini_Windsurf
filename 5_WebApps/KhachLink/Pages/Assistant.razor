@page "/a/{Slug}"
@using VanAn.KhachLink.Services.Http
@using VanAn.KhachLink.Models
@using VanAn.UI.Platform.Components.Ai
@using VanAn.UI.Platform.Components.Realtime
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject CommunityHttpService CommunityHttp
@inject TenantProfileHttpService TenantProfileService

@* UNIVERSAL AI ASSISTANT W1 (2026-11-22): hosted AI Link page — /a/{slug}.
   Khách quét QR/dán link → trang chat full với assistant của shop.
   Flow: resolve slug → tenantId (server-side, slug là capability duy nhất)
   → tái dùng IAiChatClient + public tenant-ai endpoints (cùng code path
   storefront — không duplicate chat logic).
   Human handoff: guest device id (localStorage customer_device_id — cùng
   cơ chế Store.razor F8) → anonymous visitor chat được với chủ quán.
   Product card "Thêm vào giỏ" → deep-link về storefront /store/by-id/{tid}
   (giỏ hàng sống ở storefront context, không phải trang link). *@

<PageTitle>Trợ lý AI</PageTitle>

<div class="assistant-page @(_embed ? "embed" : null)">
    @if (_loading)
    {
        <div class="assistant-status">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Đang kết nối trợ lý…</p>
        </div>
    }
    else if (_resolveFailed)
    {
        <div class="assistant-status">
            <i class="bi bi-emoji-frown fs-1"></i>
            <h5>Trợ lý không khả dụng</h5>
            <p>Link này không tồn tại hoặc shop đã tắt trợ lý AI.</p>
        </div>
    }
    else if (_tenantId.HasValue)
    {
        @* UX v1.0 (M1/M5): branded sticky header — tên shop + logo + accent color
           từ store-info (FR-077); workspace layout: cột giữa tối đa 520px. *@
        @if (!_embed)
        {
            <header class="assistant-header" style="@HeaderStyle">
                @if (!string.IsNullOrWhiteSpace(_shop?.LogoUrl))
                {
                    <img class="assistant-logo" src="@_shop!.LogoUrl" alt="" />
                }
                else
                {
                    <i class="bi bi-robot"></i>
                }
                <div>
                    <h1>@(_shop?.Name ?? "Trợ lý AI")</h1>
                    <p>Trợ lý AI — hỏi đáp nhanh về sản phẩm, giá cả và cửa hàng</p>
                </div>
            </header>
        }

        @* In-app browser banner (Zalo/Messenger/...): WebView thiếu mic/STT
           permission → gợi ý mở trình duyệt ngoài. Chỉ hiện khi detect UA
           in-app + chưa dismiss; embed mode ẩn (iframe đã là external context). *@
        @if (!_embed && _inAppBrowser)
        {
            <div class="assistant-inapp-banner" role="alert">
                <i class="bi bi-box-arrow-up-right"></i>
                <div class="assistant-inapp-text">
                    <strong>Đang mở trong @_inAppName</strong>
                    @if (_inAppIsAndroid)
                    {
                        <span> — mic/loa hoạt động tốt hơn trên trình duyệt ngoài.</span>
                    }
                    else
                    {
                        <span> — nhấn <strong>⋯ → Mở trong Safari/Chrome</strong> để dùng đầy đủ mic &amp; loa.</span>
                    }
                </div>
                @if (_inAppIsAndroid)
                {
                    <button type="button" class="assistant-inapp-open"
                            @onclick="OpenExternalBrowserAsync">Mở ngoài</button>
                }
                <button type="button" class="assistant-inapp-close" aria-label="Đóng gợi ý"
                        @onclick="() => _inAppBrowser = false">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }

        <main class="assistant-main">
        @* OpenPanel consume-once: field reset về false sau lần đầu → user đóng
           được. SessionStorageKey per-slug: nhiều shop cùng domain KhachLink
           không share session id. *@
        <AiChatWidget TenantId="_tenantId.Value"
                      Locale="vi"
                      Channel="ai_link"
                      OpenPanel="_openPanel"
                      OpenPanelChanged="v => _openPanel = v"
                      SessionStorageKey="@($"vanan_ai_session_{Slug}")"
                      HumanChatAvailable="_handoffAvailable"
                      VoiceEnabled="_features.Voice_Note_Enabled"
                      OnAddToCart="OnAddToCartAsync"
                      OnDraftRequest="OnAiEscalateDraft"
                      @bind-OpenHumanPanel="_openHumanPanel"
                      ExternalCallState="_humanCallState"
                      WorkspaceMode="@(!_embed)">
            <HumanContent>
                @if (ChatIdentity.HasValue)
                {
                    <RealtimeChatPanel SubjectType="Shop"
                                       SubjectId="_tenantId.Value"
                                       CurrentUserId="ChatIdentity.Value"
                                       CustomerToken="@_customerToken"
                                       CustomerDeviceId="@_customerDeviceId"
                                       ScrollContainerId="ai-widget-human-scroll"
                                       ShowHeader="false"
                                       HeaderTitle="Cửa hàng"
                                       InitialDraft="@_humanDraft"
                                       VoiceCallStateChanged="OnHumanCallStateChanged" />
                }
            </HumanContent>
        </AiChatWidget>
        </main>
    }
</div>

<style>
    .assistant-page {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        background: var(--vanan-color-bg, #f6f7f9);
    }
    /* UX v2.0 polish: workspace cần height xác định cho flex chain
       (widget → panel → messages scroll độc lập); embed giữ min-height. */
    .assistant-page:not(.embed) {
        height: 100dvh;
        overflow: hidden;
    }
    .assistant-status {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .75rem;
        color: var(--vanan-color-text-muted, #6c757d);
        padding: 2rem;
        text-align: center;
    }
    .assistant-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: calc(.9rem + env(safe-area-inset-top, 0px))
                 calc(1.25rem + env(safe-area-inset-right, 0px))
                 .9rem
                 calc(1.25rem + env(safe-area-inset-left, 0px));
        background: var(--vanan-color-surface, #fff);
        border-bottom: 1px solid var(--vanan-color-border, #e9ecef);
        position: sticky;
        top: 0;
        z-index: 10;
        box-shadow: 0 1px 4px rgba(0, 0, 0, .05);
    }
    .assistant-logo {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
    }
    .assistant-header i { font-size: 1.75rem; color: var(--assistant-accent, var(--vanan-color-primary, #0d6efd)); }
    .assistant-main {
        flex: 1;
        min-height: 0;
        width: 100%;
        /* UX v2.0 polish: workspace column rộng hơn (spec §5 chat area linh hoạt). */
        max-width: min(760px, 100%);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
    }
    .assistant-page.embed .assistant-main {
        max-width: none;
    }
    .assistant-page.embed {
        min-height: 0;
        height: 100%;
    }
    .assistant-header h1 { font-size: 1.15rem; margin: 0; color: var(--assistant-accent, inherit); }
    .assistant-header p { margin: 0; font-size: .8rem; color: var(--vanan-color-text-muted, #6c757d); }

    /* In-app browser banner — Zalo/Messenger WebView thiếu mic/STT. */
    .assistant-inapp-banner {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .55rem .9rem;
        background: #fff8e6;
        border-bottom: 1px solid #f0d98c;
        font-size: .82rem;
        color: #5c4a00;
    }
    .assistant-inapp-banner > i { color: #b8860b; font-size: 1rem; flex-shrink: 0; }
    .assistant-inapp-text { flex: 1; min-width: 0; line-height: 1.35; }
    .assistant-inapp-open {
        flex-shrink: 0;
        border: 1px solid #b8860b;
        background: #fff;
        color: #8a6d00;
        border-radius: 999px;
        padding: .25rem .8rem;
        font-size: .78rem;
        font-weight: 600;
        cursor: pointer;
    }
    .assistant-inapp-open:active { background: #f5e6b8; }
    .assistant-inapp-close {
        flex-shrink: 0;
        border: none;
        background: transparent;
        color: #8a6d00;
        padding: .2rem .35rem;
        font-size: 1rem;
        line-height: 1;
        cursor: pointer;
    }
</style>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    /// <summary>W2a iframe embed mode — ?embed=1 hides page chrome (header),
    /// leaving only the floating AiChatWidget for embedding on external sites.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "embed")]
    public string? EmbedParam { get; set; }
    private bool _embed => EmbedParam is "1" or "true";

    private bool _loading = true;
    private bool _resolveFailed;
    private bool _openPanel = true;
    private Guid? _tenantId;
    private ShopDto? _shop;

    /// <summary>UX v1.0 M1: accent color từ store-info HeaderColor (null → default).</summary>
    private string? HeaderStyle =>
        !string.IsNullOrWhiteSpace(_shop?.HeaderColor) && _shop!.HeaderColor!.StartsWith('#')
            ? $"--assistant-accent:{_shop.HeaderColor};"
            : null;

    // ── Human handoff (guest device id — pattern Store.razor F8) ──────────
    private string? _customerToken;
    private Guid? _customerId;
    private Guid? _customerDeviceId;
    private Guid? ChatIdentity => _customerId ?? _customerDeviceId;
    private bool _handoffAvailable;
    private TenantFeatureSettingsDto _features = new();
    private string? _humanDraft;
    private string? _humanCallState;
    private bool _openHumanPanel;

    // ── In-app browser detection (Zalo/Messenger/TikTok...) ──────────────
    private bool _inAppBrowser;
    private string? _inAppName;
    private bool _inAppIsAndroid;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _embed || _inAppBrowser) return;
        try
        {
            var info = await JSRuntime.InvokeAsync<InAppInfo?>(
                "vananInAppBrowser.detect");
            if (info?.InApp == true)
            {
                _inAppBrowser = true;
                _inAppName = info.App;
                _inAppIsAndroid = info.IsAndroid;
                StateHasChanged();
            }
        }
        catch { /* JS chưa load / interop lỗi → không hiện banner */ }
    }

    private async Task OpenExternalBrowserAsync()
    {
        try
        {
            var url = Nav.Uri;
            await JSRuntime.InvokeVoidAsync("vananInAppBrowser.openExternal", url);
        }
        catch { /* best-effort */ }
    }

    private sealed class InAppInfo
    {
        public bool InApp { get; set; }
        public string? App { get; set; }
        public bool IsAndroid { get; set; }
        public bool IsIos { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Guest/customer identity cho human chat — localStorage keys giống Store/Checkout.
        _customerToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
        var deviceIdStr = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_device_id");
        if (string.IsNullOrEmpty(deviceIdStr))
        {
            deviceIdStr = Guid.NewGuid().ToString();
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "customer_device_id", deviceIdStr);
        }
        if (Guid.TryParse(deviceIdStr, out var deviceId) && deviceId != Guid.Empty)
            _customerDeviceId = deviceId;

        if (!string.IsNullOrEmpty(_customerToken))
        {
            try
            {
                _customerId = await CommunityHttp.GetCustomerIdAsync(_customerToken);
            }
            catch { /* token invalid — fall back to guest chat */ }
            if (_customerId == null)
                _customerToken = null;
        }
        _handoffAvailable = ChatIdentity.HasValue;

        try
        {
            var http = HttpClientFactory.CreateClient("gateway");
            var resp = await http.GetAsync(
                $"api/public/assistant-link/{Uri.EscapeDataString(Slug)}/resolve");
            if (!resp.IsSuccessStatusCode)
            {
                _resolveFailed = true;
                return;
            }
            var dto = await resp.Content.ReadFromJsonAsync<ResolveDto>();
            // aiEnabled=false (flag off / forwarder chưa cấu hình) → trang unavailable,
            // không render widget rỗng.
            if (dto?.TenantId is Guid tid && tid != Guid.Empty && dto.AiEnabled)
            {
                _tenantId = tid;
                // W3d: voice flag (Voice_Note_Enabled) — service trả defaults khi lỗi,
                // nên mic/TTS degrade graceful, không break trang.
                _features = await TenantProfileService.GetFeatureSettingsAsync(tid);

                // UX v1.0 M1 (FR-077): branding shop cho header — fail → header generic.
                try
                {
                    var shopResp = await http.GetAsync($"api/tenants/{tid}/store-info");
                    if (shopResp.IsSuccessStatusCode)
                        // ShopDto.Theme là enum serialize string → cần JsonStringEnumConverter
                        // (giống GatewayJsonOptions trong TenantProfileHttpService).
                        _shop = await shopResp.Content.ReadFromJsonAsync<ShopDto>(StoreInfoJsonOptions);
                }
                catch { /* branding optional — never block the page */ }
            }
            else
            {
                _resolveFailed = true;
            }
        }
        catch
        {
            _resolveFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>AI refuse → "Hỏi chủ quán" draft → human panel (pattern Store.razor).</summary>
    private void OnAiEscalateDraft(string? draft) => _humanDraft = draft;

    private void OnHumanCallStateChanged(string state) => _humanCallState = state;

    /// <summary>Product card trên trang link không có cart context → đưa khách về
    /// storefront của shop để thêm giỏ (route /store/by-id/{tenantId} đã có sẵn).</summary>
    private Task OnAddToCartAsync(AiProductCardItem product)
        => _tenantId.HasValue
            ? Task.Run(() => Nav.NavigateTo($"/store/by-id/{_tenantId.Value}"))
            : Task.CompletedTask;

    private static readonly JsonSerializerOptions StoreInfoJsonOptions = new(JsonSerializerDefaults.Web)
    {
        Converters = { new JsonStringEnumConverter() }
    };

    private sealed class ResolveDto
    {
        public Guid? TenantId { get; set; }
        public string? Slug { get; set; }
        public bool AiEnabled { get; set; }
    }
}
