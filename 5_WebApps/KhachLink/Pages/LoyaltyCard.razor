@page "/my-loyalty"
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Components
@using VanAn.KhachLink.Services.Http
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject SocialAuthHttpService SocialAuthHttp
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Điểm thưởng của tôi</PageTitle>

<KhachLinkLayout>
    <div class="container py-4" style="max-width:600px;">
        @if (_loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div>
            </div>
        }
        else if (!_isLoggedIn)
        {
            <VanAnCard Shadow="true" CssClass="text-center p-5">
                <i class="bi bi-gem text-warning" style="font-size:3rem;"></i>
                <h5 class="mt-3">Đăng nhập để xem điểm thưởng</h5>
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="GoToLogin">Đăng nhập</VanAnButton>
            </VanAnCard>
        }
        else if (_loyalty != null)
        {
            <!-- Tier Card -->
            <VanAnCard Shadow="true" CssClass="loyalty-tier-card mb-4">
                <div class="text-center p-4">
                    <div class="tier-badge @GetTierBadgeClass() mb-3">@_loyalty.Tier</div>
                    <h2 class="points-display">@_loyalty.PointBalance.ToString("N0") điểm</h2>
                    @if (_loyalty.NextTierThreshold > 0)
                    {
                        <p class="text-muted small mb-2">
                            Còn @(_loyalty.NextTierThreshold - _loyalty.PointBalance).ToString("N0") điểm để lên hạng tiếp theo
                        </p>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-warning" style="width:@_loyalty.ProgressPercent%;"></div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">Bạn đang ở hạng cao nhất!</p>
                    }
                </div>
            </VanAnCard>

            @* Tiered Auth Phase 3: Redeem section with verification gate *@
            <VanAnCard Shadow="true" CssClass="mb-4">
                <h5 class="mb-3">Đổi điểm thưởng</h5>
                <div class="mb-2">
                    <label class="form-label small">Số điểm muốn đổi</label>
                    <input type="number" class="form-control"
                           placeholder="100" min="1" max="@_loyalty.PointBalance"
                           @bind="_redeemPoints" @bind:event="oninput" />
                </div>
                @if (_redeemError != null)
                {
                    <VanAnAlert Variant="AlertVariant.Error" Message="@_redeemError" CssClass="mb-2" />
                }
                @if (_redeemSuccess != null)
                {
                    <VanAnAlert Variant="AlertVariant.Success" Message="@_redeemSuccess" CssClass="mb-2" />
                }
                <VanAnButton Variant="ButtonVariant.Primary"
                             FullWidth="true"
                             OnClick="RedeemPoints"
                             Disabled="@_redeeming"
                             TestId="btn-redeem-points">
                    @(_redeeming ? "Đang xử lý..." : "Đổi điểm")
                </VanAnButton>
            </VanAnCard>

            <!-- Tier Info -->
            <VanAnCard Shadow="true" CssClass="mb-4">
                <h5 class="mb-3">Quyền lợi theo hạng</h5>
                <div class="tier-table">
                    @foreach (var tier in _tiers)
                    {
                        <div class="tier-row @(tier.Name == _loyalty.Tier ? "active-tier" : "")">
                            <span class="badge @tier.BadgeClass me-2">@tier.Name</span>
                            <span class="text-muted small">@tier.Threshold điểm</span>
                            <span class="ms-auto small">@tier.Benefit</span>
                        </div>
                    }
                </div>
            </VanAnCard>

            <!-- History -->
            @if (_loyalty.History?.Count > 0)
            {
                <VanAnCard Shadow="true">
                    <h5 class="mb-3">Lịch sử tích điểm</h5>
                    @foreach (var item in _loyalty.History)
                    {
                        <div class="history-item d-flex align-items-center py-2 border-bottom">
                            <div class="me-3">
                                <i class="bi @(item.Points > 0 ? "bi-plus-circle-fill text-success" : "bi-dash-circle-fill text-danger")"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="small fw-semibold">@item.Reason</div>
                                <div class="text-muted" style="font-size:0.75rem;">@item.Timestamp.ToVietnamString()</div>
                            </div>
                            <div class="@(item.Points > 0 ? "text-success" : "text-danger") fw-bold">
                                @(item.Points > 0 ? "+" : "")@item.Points
                            </div>
                        </div>
                    }
                </VanAnCard>
            }
        }
    </div>

    @* Tiered Auth Phase 3: Upgrade modal — shown when redeem returns 403 *@
    <IdentityUpgradeModal ShowModal="_showUpgradeModal"
                          OnDismiss="OnUpgradeModalDismiss"
                          OnUpgradeComplete="OnUpgradeComplete" />
</KhachLinkLayout>

<style>
.loyalty-tier-card { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
.tier-badge { display: inline-block; padding: 6px 20px; border-radius: 20px; font-weight: bold; font-size: 1.1rem; background: rgba(255,255,255,0.25); }
.points-display { font-size: 2.5rem; font-weight: 900; color: white; }
.tier-row { display: flex; align-items: center; padding: 8px 0; border-bottom: 1px solid #f0f0f0; }
.active-tier { background: #fff8e1; border-radius: 6px; padding: 8px; }
</style>

@code {
    private bool _loading = true;
    private bool _isLoggedIn = false;
    private LoyaltyData? _loyalty;

    // Tiered Auth Phase 3: Redeem state
    private int _redeemPoints;
    private string? _redeemError;
    private string? _redeemSuccess;
    private bool _redeeming;
    private bool _showUpgradeModal;

    private static readonly List<TierInfo> _tiers = new()
    {
        new("Bronze",   "bg-warning",           "0",      "5% ưu đãi"),
        new("Silver",   "bg-secondary",          "1.000",  "8% ưu đãi + giao hàng miễn phí"),
        new("Gold",     "bg-warning text-dark",  "5.000",  "12% ưu đãi + quà sinh nhật"),
        new("Platinum", "bg-info text-dark",     "20.000", "15% ưu đãi + VIP hotline")
    };

    private void GoToLogin() => Navigation.NavigateTo("/login");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadLoyalty();
            StateHasChanged();
        }
    }

    private async Task LoadLoyalty()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (string.IsNullOrEmpty(token)) { _isLoggedIn = false; return; }

            var client = HttpClientFactory.CreateClient("gateway");
            client.DefaultRequestHeaders.Add("X-Customer-Token", token);
            var resp = await client.GetAsync("/api/loyalty/my");

            if (resp.IsSuccessStatusCode)
            {
                _loyalty = await resp.Content.ReadFromJsonAsync<LoyaltyData>();
                _isLoggedIn = true;
            }
            else { _isLoggedIn = false; }
        }
        finally { _loading = false; }
    }

    /// <summary>Tiered Auth Phase 3: Redeem points — calls POST /api/loyalty/redeem.</summary>
    private async Task RedeemPoints()
    {
        _redeemError = null;
        _redeemSuccess = null;

        if (_redeemPoints <= 0)
        {
            _redeemError = "Vui lòng nhập số điểm hợp lệ.";
            return;
        }

        _redeeming = true;
        try
        {
            var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (string.IsNullOrEmpty(token))
            {
                _redeemError = "Vui lòng đăng nhập để đổi điểm.";
                return;
            }

            var result = await SocialAuthHttp.RedeemPointsAsync(token, _redeemPoints, "Redeem from KhachLink");

            if (result.Success)
            {
                _redeemSuccess = $"Đổi thành công {result.PointsRedeemed} điểm. Số dư mới: {result.NewBalance:N0} điểm.";
                _redeemPoints = 0;
                // Refresh loyalty data
                await LoadLoyalty();
            }
            else if (result.RequiresUpgrade)
            {
                // Show upgrade modal — customer needs OTP verification to redeem
                _showUpgradeModal = true;
            }
            else
            {
                _redeemError = result.Message;
            }
        }
        finally { _redeeming = false; }
    }

    private void OnUpgradeModalDismiss()
    {
        _showUpgradeModal = false;
    }

    private async Task OnUpgradeComplete()
    {
        _showUpgradeModal = false;
        _redeemError = null;
        _redeemSuccess = "Nâng cấp thành công! Bạn có thể đổi điểm ngay bây giờ.";
        // Refresh loyalty data to reflect any changes
        await LoadLoyalty();
    }

    private string GetTierBadgeClass() => _loyalty?.Tier switch
    {
        "Platinum" => "bg-info text-dark",
        "Gold"     => "bg-warning text-dark",
        "Silver"   => "bg-secondary",
        _          => "bg-warning"
    };

    private record TierInfo(string Name, string BadgeClass, string Threshold, string Benefit);

    private class LoyaltyData
    {
        public string Tier { get; set; } = "Bronze";
        public int PointBalance { get; set; }
        public int NextTierThreshold { get; set; }
        public int ProgressPercent { get; set; }
        public List<HistoryItem>? History { get; set; }
    }

    private class HistoryItem
    {
        public int Points { get; set; }
        public string Reason { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; }
    }
}
