@using VanAn.KhachLink.Components.Layout
@using VanAn.KhachLink.Components
@using VanAn.KhachLink.Components.Shared
@using VanAn.KhachLink.Models
@using VanAn.KhachLink.Services.Http
@using VanAn.Shared.Domain
@page "/store/{Slug}"
@page "/store/by-id/{TenantId}"
@implements IDisposable
@inject TenantProfileHttpService TenantProfileService
@inject ShopConfigHttpService ShopConfigService
@inject ProductHttpService ProductService
@inject ISocialCampaignService CampaignService
@inject NavigationManager Navigation
@inject ILogger<Store> Logger
@inject VanAn.KhachLink.Services.CartService CartService

<PageTitle>@(_store?.Name ?? "Cửa hàng") — KhachLink</PageTitle>

<!-- Cart Drawer Component -->
<CartDrawer
    CartItems="@_cartState.Items"
    TotalAmount="@_cartState.TotalAmount"
    TotalVatAmount="@_cartState.TotalVatAmount"
    VatDisplayEnabled="@_vatDisplayEnabled"
    RemoveFromCart="async (productId) => await CartService.RemoveItemAsync(productId)"
    Checkout="@GoToCheckout" />

@if (_loading)
{
    <div class="store-loading">
        <div class="spinner-border text-light" role="status" style="width: 3.5rem; height: 3.5rem;">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <p class="mt-3">Đang tải thông tin cửa hàng...</p>
    </div>
}
else if (_store is null)
{
    <div class="store-not-found">
        <div class="not-found-card">
            <i class="bi bi-shop"></i>
            <h2>Không tìm thấy cửa hàng</h2>
            <p>Trang bạn tìm không tồn tại hoặc đã bị gỡ.</p>
            <button class="btn-cta" OnClick="@(() => Navigation.NavigateTo("/store-finder"))">
                <i class="bi bi-search me-1"></i> Tìm cửa hàng khác
            </button>
        </div>
    </div>
}
else
{
    <div class="store-page theme-@GetThemeClass()">
    <!-- ════════════════════════════════════════════════════════════════════
         HERO SECTION — full-width banner with brand name + story
         (inspired by tocotocotea.com hero)
    ════════════════════════════════════════════════════════════════════ -->
    <section class="store-hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            @if (!string.IsNullOrWhiteSpace(_store.LogoUrl))
            {
                <img src="@_store.LogoUrl" alt="@_store.Name" class="hero-logo" />
            }
            else
            {
                <div class="hero-logo-placeholder">
                    <i class="bi bi-shop"></i>
                </div>
            }
            <h1 class="hero-title">@_store.Name</h1>
            @if (!string.IsNullOrWhiteSpace(_store.BrandStory))
            {
                <p class="hero-story">@_store.BrandStory</p>
            }
            <div class="hero-meta">
                @if (!string.IsNullOrWhiteSpace(_store.Address))
                {
                    <span><i class="bi bi-geo-alt-fill"></i> @_store.Address</span>
                }
                @if (!string.IsNullOrWhiteSpace(_store.Phone))
                {
                    <span><i class="bi bi-telephone-fill"></i> <a href="tel:@_store.Phone">@_store.Phone</a></span>
                }
                @if (!string.IsNullOrWhiteSpace(_store.Email))
                {
                    <span><i class="bi bi-envelope-fill"></i> <a href="mailto:@_store.Email">@_store.Email</a></span>
                }
            </div>
            <div class="hero-cta-group">
                @if (_features.GoogleMap_Section_Enabled && _store.Latitude.HasValue && _store.Longitude.HasValue)
                {
                    <a href="https://maps.google.com/?q=@_store.Latitude,@_store.Longitude" target="_blank" class="btn-cta">
                    <i class="bi bi-compass"></i> Chỉ đường
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(_store.SocialLinksFb))
                {
                    <a href="@_store.SocialLinksFb" target="_blank" class="btn-cta-outline">
                        <i class="bi bi-facebook"></i> Facebook
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(_store.SocialLinksTiktok))
                {
                    <a href="@_store.SocialLinksTiktok" target="_blank" class="btn-cta-outline">
                        <i class="bi bi-tiktok"></i> TikTok
                    </a>
                }
            </div>
        </div>
    </section>

    <div class="store-body">

        <!-- ════════════════════════════════════════════════════════════════
             CAMPAIGN SECTION — promotions as beautiful cards
        ════════════════════════════════════════════════════════════════ -->
        @if (_features.Campaign_Section_Enabled)
        {
            <section class="store-section" id="campaigns">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="section-icon"><i class="bi bi-megaphone-fill"></i></span>
                        Khuyến Mãi Nổi Bật
                    </h2>
                    <div class="section-divider"></div>
                </div>
                @if (_campaignLoading)
                {
                    <div class="section-loading">
                        <div class="spinner-border text-primary"></div>
                        <p>Đang tải khuyến mãi...</p>
                    </div>
                }
                else if (_campaigns.Count > 0)
                {
                    <div class="campaign-grid">
                        @foreach (var campaign in _campaigns.Take(6))
                        {
                            <article class="campaign-card" onclick="@(() => OpenCampaign(campaign.TrackingCode))">
                                <div class="campaign-media">
                                    @if (!string.IsNullOrEmpty(campaign.ImageUrl))
                                    {
                                        <img src="@campaign.ImageUrl" alt="@campaign.CampaignName" loading="lazy" />
                                    }
                                    else if (!string.IsNullOrEmpty(campaign.VideoUrl))
                                    {
                                        <div class="campaign-video-thumb">
                                            <i class="bi bi-play-circle-fill"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="campaign-icon-fallback">
                                            <i class="bi bi-tag-fill"></i>
                                        </div>
                                    }
                                </div>
                                <div class="campaign-body">
                                    <h5>@campaign.CampaignName</h5>
                                    <div class="campaign-stats">
                                        <span><i class="bi bi-mouse"></i> @campaign.TotalClicks</span>
                                        <span><i class="bi bi-bag-check"></i> @campaign.ConvertedOrders</span>
                                    </div>
                                    <span class="campaign-cta">Xem khuyến mãi <i class="bi bi-arrow-right"></i></span>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="section-empty">Cửa hàng hiện chưa có chương trình khuyến mãi nào.</p>
                }
            </section>
        }

        <!-- ════════════════════════════════════════════════════════════════
             VIBE SHOWCASE — product gallery (display only, not for sale)
        ════════════════════════════════════════════════════════════════ -->
        @if (_addedToCartFeedback)
        {
            <div class="cart-feedback-toast">
                <i class="bi bi-check-circle-fill"></i> Đã thêm vào giỏ hàng!
            </div>
        }

        @if (_features.VibeShowcase_Section_Enabled)
        {
            <section class="store-section" id="products">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="section-icon"><i class="bi bi-grid-fill"></i></span>
                        Bộ Sưu Tập Sản Phẩm
                    </h2>
                    <div class="section-divider"></div>
                </div>
                <VibeShowcase Config="@_shopConfig" Products="@_products" AddToCart="@AddToCartSync" />
            </section>
        }

        <!-- ════════════════════════════════════════════════════════════════
             GOOGLE MAP SECTION
        ════════════════════════════════════════════════════════════════ -->
        @if (_features.GoogleMap_Section_Enabled)
        {
            <section class="store-section" id="location">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="section-icon"><i class="bi bi-geo-alt-fill"></i></span>
                        Vị Trí Cửa Hàng
                    </h2>
                    <div class="section-divider"></div>
                </div>
                <GoogleMaps ShopConfig="@_shopConfig" />
            </section>
        }

        <!-- ════════════════════════════════════════════════════════════════
             SOCIAL HUB — Facebook + TikTok embeds
        ════════════════════════════════════════════════════════════════ -->
        @if (_features.SocialHub_Section_Enabled)
        {
            <section class="store-section" id="social">
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="section-icon"><i class="bi bi-share-fill"></i></span>
                        Kết Nối Mạng Xã Hội
                    </h2>
                    <div class="section-divider"></div>
                </div>
                <SocialHub ShopConfig="@_shopConfig" />
            </section>
        }

        <!-- ════════════════════════════════════════════════════════════════
             AI CHATBOX placeholder (Phase 4-5 — deferred)
        ════════════════════════════════════════════════════════════════ -->
        @if (_features.AIChat_Enabled)
        {
            <section class="store-section">
                <div class="ai-chat-placeholder">
                    <i class="bi bi-robot"></i>
                    <h3>AI Chatbox sắp ra mắt</h3>
                    <p>Tính năng này đang được phát triển — sẽ có trong sprint tới.</p>
                </div>
            </section>
        }

        <!-- ════════════════════════════════════════════════════════════════
             FOOTER
        ════════════════════════════════════════════════════════════════ -->
        <footer class="store-footer">
            <p>&copy; @DateTime.UtcNow.Year @_store.Name. All rights reserved.</p>
            <p class="powered-by">Powered by <strong>KhachLink</strong></p>
        </footer>
    </div>
    </div>
}

<style>
    /* ════════════════════════════════════════════════════════════════════
         STORE PROFILE PAGE — Showcase layout (not e-commerce)
         Inspired by tocotocotea.com: warm gradients, big hero, gallery feel
    ════════════════════════════════════════════════════════════════════ */

    /* Loading state */
    .store-loading {
        min-height: 100vh;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    /* Not found state */
    .store-not-found {
        min-height: 100vh;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 2rem;
    }
    .not-found-card {
        background: white; padding: 3rem; border-radius: 24px;
        text-align: center; max-width: 480px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }
    .not-found-card i { font-size: 5rem; color: #d97706; }
    .not-found-card h2 { margin: 1rem 0 0.5rem; font-weight: 700; }
    .not-found-card p { color: #6b7280; margin-bottom: 1.5rem; }

    /* ── HERO ─────────────────────────────────────────────────────────── */
    .store-hero {
        position: relative;
        min-height: 70vh;
        display: flex; align-items: center; justify-content: center;
        text-align: center;
        background: var(--store-hero-gradient, linear-gradient(135deg, #ff9966 0%, #ff5e62 100%));
        color: white;
        padding: 4rem 1.5rem;
        overflow: hidden;
    }
    .hero-overlay {
        position: absolute; inset: 0;
        background: radial-gradient(circle at 50% 50%, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.4) 100%);
    }
    .hero-content {
        position: relative; z-index: 2;
        max-width: 900px;
        animation: fadeUp 0.8s ease-out;
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .hero-logo, .hero-logo-placeholder {
        width: 120px; height: 120px;
        border-radius: 50%;
        object-fit: cover;
        margin: 0 auto 1.5rem;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
        border: 3px solid rgba(255,255,255,0.5);
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }
    .hero-logo-placeholder i { font-size: 3rem; color: white; }
    .hero-title {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 800;
        margin-bottom: 1rem;
        text-shadow: 0 2px 20px rgba(0,0,0,0.3);
        letter-spacing: -0.02em;
    }
    .hero-story {
        font-size: clamp(1rem, 2vw, 1.25rem);
        max-width: 700px;
        margin: 0 auto 2rem;
        line-height: 1.7;
        opacity: 0.95;
        font-style: italic;
    }
    .hero-meta {
        display: flex; flex-wrap: wrap; justify-content: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
        font-size: 0.95rem;
    }
    .hero-meta span { display: inline-flex; align-items: center; gap: 0.5rem; }
    .hero-meta a { color: white; text-decoration: underline; }
    .hero-cta-group {
        display: flex; flex-wrap: wrap; justify-content: center;
        gap: 1rem;
    }

    /* ── BUTTONS ─────────────────────────────────────────────────────── */
    .btn-cta, .btn-cta-outline {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.75rem 1.75rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        cursor: pointer;
        border: none;
        transition: all 0.25s ease;
    }
    .btn-cta {
        background: white;
        color: var(--store-accent-color, #ff5e62);
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    }
    .btn-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(0,0,0,0.3);
    }
    .btn-cta-outline {
        background: rgba(255,255,255,0.15);
        color: white;
        border: 2px solid rgba(255,255,255,0.6);
        backdrop-filter: blur(10px);
    }
    .btn-cta-outline:hover {
        background: rgba(255,255,255,0.25);
        border-color: white;
    }

    /* ── BODY CONTAINER ──────────────────────────────────────────────── */
    .store-body {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 1.5rem;
    }

    /* ── SECTIONS ────────────────────────────────────────────────────── */
    .store-section { margin-bottom: 5rem; }
    .section-header { text-align: center; margin-bottom: 3rem; }
    .section-title {
        display: inline-flex; align-items: center; gap: 0.75rem;
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        font-weight: 700;
        color: #1f2937;
        margin: 0;
    }
    .section-icon {
        display: inline-flex; align-items: center; justify-content: center;
        width: 48px; height: 48px;
        background: var(--store-accent-gradient, linear-gradient(135deg, #ff9966, #ff5e62));
        color: white;
        border-radius: 14px;
        font-size: 1.5rem;
    }
    .section-divider {
        width: 80px; height: 4px;
        background: var(--store-accent-gradient, linear-gradient(90deg, #ff9966, #ff5e62));
        border-radius: 2px;
        margin: 1rem auto 0;
    }

    /* ── CAMPAIGN GRID ───────────────────────────────────────────────── */
    .campaign-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }
    .campaign-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border: 1px solid #f3f4f6;
    }
    .campaign-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.15);
    }
    .campaign-media {
        width: 100%; height: 220px;
        overflow: hidden;
        background: linear-gradient(135deg, #fef3c7, #fde68a);
    }
    .campaign-media img {
        width: 100%; height: 100%; object-fit: cover;
        transition: transform 0.4s ease;
    }
    .campaign-card:hover .campaign-media img { transform: scale(1.05); }
    .campaign-video-thumb, .campaign-icon-fallback {
        width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        font-size: 3rem; color: #d97706;
    }
    .campaign-video-thumb { background: linear-gradient(135deg, #fde68a, #fbbf24); }
    .campaign-body { padding: 1.25rem; }
    .campaign-body h5 {
        font-size: 1.1rem; font-weight: 700;
        margin: 0 0 0.75rem;
        color: #1f2937;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .campaign-stats {
        display: flex; gap: 1rem;
        font-size: 0.85rem; color: #6b7280;
        margin-bottom: 0.75rem;
    }
    .campaign-cta {
        color: var(--store-accent-color, #ff5e62);
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-flex; align-items: center; gap: 0.4rem;
    }
    .campaign-cta i { transition: transform 0.2s; }
    .campaign-card:hover .campaign-cta i { transform: translateX(4px); }

    /* ── SECTION STATES ──────────────────────────────────────────────── */
    .section-loading {
        text-align: center; padding: 3rem;
        color: #6b7280;
    }
    .section-empty {
        text-align: center; padding: 2rem;
        color: #9ca3af;
        font-style: italic;
    }

    /* ── AI CHAT PLACEHOLDER ─────────────────────────────────────────── */
    .ai-chat-placeholder {
        text-align: center;
        padding: 3rem 2rem;
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        border-radius: 24px;
    }
    .ai-chat-placeholder i { font-size: 4rem; color: #6b7280; }
    .ai-chat-placeholder h3 { margin: 1rem 0 0.5rem; }
    .ai-chat-placeholder p { color: #6b7280; }

    /* ── FOOTER ──────────────────────────────────────────────────────── */
    .store-footer {
        text-align: center;
        padding: 3rem 1rem 2rem;
        border-top: 1px solid #e5e7eb;
        color: #6b7280;
    }
    .store-footer p { margin: 0.25rem 0; }
    .powered-by { font-size: 0.85rem; }
    .powered-by strong { color: var(--store-accent-color, #ff5e62); }

    /* ── THEME VARIABLES ─────────────────────────────────────────────── */
    /* Each theme defines gradient + accent color variables used by
       .store-hero, .section-icon, .section-divider, .btn-cta, .campaign-cta.
       Applied via .store-page wrapper class (set from _shopConfig.ActiveTheme). */
    .theme-classic {
        --store-hero-gradient: linear-gradient(135deg, #8B4513 0%, #D2691E 100%);
        --store-accent-gradient: linear-gradient(135deg, #8B4513, #D2691E);
        --store-accent-color: #8B4513;
    }
    .theme-modern {
        --store-hero-gradient: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        --store-accent-gradient: linear-gradient(135deg, #2c3e50, #3498db);
        --store-accent-color: #2c3e50;
    }
    .theme-teen {
        --store-hero-gradient: linear-gradient(135deg, #ff6b9d 0%, #c44dff 100%);
        --store-accent-gradient: linear-gradient(135deg, #ff6b9d, #c44dff);
        --store-accent-color: #c44dff;
    }
    .theme-lady {
        --store-hero-gradient: linear-gradient(135deg, #f8a5c2 0%, #fbc5d8 100%);
        --store-accent-gradient: linear-gradient(135deg, #f8a5c2, #fbc5d8);
        --store-accent-color: #d63384;
    }
    .theme-premium {
        --store-hero-gradient: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
        --store-accent-gradient: linear-gradient(135deg, #f0e68c, #daa520);
        --store-accent-color: #f0e68c;
    }

    /* ── RESPONSIVE ──────────────────────────────────────────────────── */
    @@media (max-width: 768px) {
        .store-hero { min-height: 60vh; padding: 3rem 1rem; }
        .store-body { padding: 3rem 1rem; }
        .campaign-grid { grid-template-columns: 1fr; }
        .hero-meta { flex-direction: column; gap: 0.75rem; }
    }

    /* ── CART FEEDBACK TOAST ─────────────────────────────────────────── */
    .cart-feedback-toast {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        background: #10b981;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
        font-weight: 600;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        animation: slideInRight 0.3s ease-out;
    }
    .cart-feedback-toast i { font-size: 1.2rem; }
    @@keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
</style>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [Parameter]
    public string TenantId { get; set; } = string.Empty;

    private bool _loading = true;
    private ShopDto? _store;
    private ShopConfig? _shopConfig;
    private TenantFeatureSettingsDto _features = new();
    private List<ProductDto> _products = new();
    private List<VanAn.Shared.Domain.SocialCampaign> _campaigns = new();
    private bool _campaignLoading = true;
    private VanAn.KhachLink.Services.CartState _cartState = null!;
    private bool _vatDisplayEnabled = true;
    private bool _addedToCartFeedback = false;

    private string GetThemeClass() => _shopConfig?.ActiveTheme switch
    {
        ThemeType.Modern => "modern",
        ThemeType.Teen => "teen",
        ThemeType.Lady => "lady",
        ThemeType.Premium => "premium",
        _ => "classic"
    };

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _cartState = CartService.GetCartState();
        CartService.OnCartChanged += StateHasChanged;
        await CartService.LoadCartFromStorageAsync();
        try
        {
            // Support two routes: /store/{slug} and /store/by-id/{tenantId}
            if (!string.IsNullOrWhiteSpace(TenantId))
            {
                // by-id fallback — load store-info by tenant GUID
                _store = await LoadStoreByTenantIdAsync(TenantId);
            }
            else
            {
                _store = await TenantProfileService.GetBySlugAsync(Slug);
            }

            if (_store is null)
            {
                _loading = false;
                return;
            }

            // Build ShopConfig from tenant store data
            _shopConfig = await ShopConfigService.GetShopConfigByTenantIdAsync(_store.Id);

            // Load feature settings (section toggles)
            _features = await TenantProfileService.GetFeatureSettingsAsync(_store.Id);

            // Parallel load: products + campaigns
            var productsTask = LoadProductsAsync(_store.Id);
            var campaignsTask = LoadCampaignsAsync(_store.Id);
            await Task.WhenAll(productsTask, campaignsTask);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Store page for slug '{Slug}' / tenantId '{TenantId}'", Slug, TenantId);
            _store = null;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Fallback for tenants without a slug: load store-info by tenant GUID.
    /// Calls GET /api/tenants/{tenantId}/store-info directly.
    /// </summary>
    private async Task<ShopDto?> LoadStoreByTenantIdAsync(string tenantIdStr)
    {
        if (!Guid.TryParse(tenantIdStr, out var tenantId) || tenantId == Guid.Empty)
        {
            return null;
        }
        // Reuse ShopConfigHttpService's endpoint via direct HTTP — but we need a separate
        // call here because TenantProfileHttpService only has GetBySlugAsync. We use the
        // store-info endpoint through ShopConfigService and reconstruct the ShopDto from
        // the resulting ShopConfig. Simpler: just use ShopConfigService and build a
        // minimal ShopDto from it.
        try
        {
            _shopConfig = await ShopConfigService.GetShopConfigByTenantIdAsync(tenantId);
            // ShopConfig has all the fields we need — build a ShopDto from it
            return new ShopDto
            {
                Id = _shopConfig.TenantId,
                Name = _shopConfig.ShopName,
                Address = _shopConfig.Address,
                Phone = _shopConfig.Phone,
                Email = _shopConfig.Email,
                Latitude = _shopConfig.Latitude,
                Longitude = _shopConfig.Longitude,
                SocialLinksFb = _shopConfig.SocialLinksFb,
                SocialLinksTiktok = _shopConfig.SocialLinksTiktok,
                LogoUrl = _shopConfig.LogoUrl?.ToString()
            };
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LoadStoreByTenantIdAsync failed for {TenantId}", tenantId);
            return null;
        }
    }

    private async Task LoadProductsAsync(Guid tenantId)
    {
        try
        {
            _products = await ProductService.GetProductsAsync(tenantId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load products for tenant {TenantId}", tenantId);
            _products = new();
        }
    }

    private async Task LoadCampaignsAsync(Guid tenantId)
    {
        _campaignLoading = true;
        try
        {
            _campaigns = await CampaignService.GetCampaignsByTenantAsync(tenantId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load campaigns for tenant {TenantId}", tenantId);
            _campaigns = new();
        }
        finally
        {
            _campaignLoading = false;
        }
    }

    private async Task AddToCart(ProductDto product)
    {
        await CartService.AddItemAsync(product, 1);
        _addedToCartFeedback = true;
        StateHasChanged();
        await Task.Delay(1500);
        _addedToCartFeedback = false;
        StateHasChanged();
    }

    private void AddToCartSync(ProductDto product) => _ = AddToCart(product);

    private async Task GoToCheckout()
    {
        Navigation.NavigateTo("/checkout");
        await Task.Delay(100);
    }

    private void OpenCampaign(string trackingCode)
    {
        if (!string.IsNullOrEmpty(trackingCode))
        {
            Navigation.NavigateTo($"/campaign/{trackingCode}", forceLoad: true);
        }
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }
}
