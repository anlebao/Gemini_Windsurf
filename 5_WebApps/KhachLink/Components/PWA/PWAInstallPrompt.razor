@using VanAn.KhachLink.Services.PWA
@inject PWAService PWAService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="pwa-install-prompt" style="@GetDisplayStyle()">
    <div class="pwa-install-content">
        <div class="pwa-install-icon">
            <img src="/icons/icon-192x192.png" alt="Vạn An App" />
        </div>
        <div class="pwa-install-text">
            <h3>Cài đặt Vạn An App</h3>
            <p>@(_isIOS ? "Thêm app vào màn hình chính để truy cập nhanh! (Cần internet để đặt hàng)" : "Trải nghiệm nhanh hơn với app Vạn An! (Cần internet để đặt hàng)")</p>
        </div>
        <div class="pwa-install-actions">
            <button class="btn btn-primary" @onclick="InstallApp">
                <i class="fas fa-download"></i> @(_isIOS ? "Hướng dẫn" : "Cài đặt")
            </button>
            <button class="btn btn-secondary" @onclick="DismissPrompt">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
</div>

@if (ShowOfflineIndicator)
{
    <div class="offline-indicator @(IsOnline ? "online" : "offline")">
        <div class="offline-content">
            <i class="fas @(IsOnline ? "fa-wifi" : "fa-wifi-slash")"></i>
            <span>@(IsOnline ? "Đã kết nối" : "Ngoại tuyến")</span>
        </div>
    </div>
}

<style>
    .pwa-install-prompt {
        position: fixed;
        bottom: 20px;
        left: 20px;
        right: 20px;
        background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
        color: white;
        padding: 16px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        z-index: 1000;
        transform: translateY(0);
        transition: all 0.3s ease;
        max-width: 400px;
        margin: 0 auto;
    }

    .pwa-install-prompt:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(0,0,0,0.3);
    }

    .pwa-install-content {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .pwa-install-icon img {
        width: 48px;
        height: 48px;
        border-radius: 8px;
    }

    .pwa-install-text {
        flex: 1;
    }

    .pwa-install-text h3 {
        margin: 0 0 4px 0;
        font-size: 16px;
        font-weight: 600;
    }

    .pwa-install-text p {
        margin: 0;
        font-size: 14px;
        opacity: 0.9;
    }

    .pwa-install-actions {
        display: flex;
        gap: 8px;
    }

    .pwa-install-actions .btn {
        padding: 8px 12px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s ease;
    }

    .pwa-install-actions .btn-primary {
        background: white;
        color: #8B4513;
        font-weight: 500;
    }

    .pwa-install-actions .btn-primary:hover {
        background: #f8f9fa;
        transform: scale(1.05);
    }

    .pwa-install-actions .btn-secondary {
        background: rgba(255,255,255,0.2);
        color: white;
        padding: 8px 10px;
    }

    .pwa-install-actions .btn-secondary:hover {
        background: rgba(255,255,255,0.3);
    }

    .offline-indicator {
        position: fixed;
        bottom: 20px;
        left: 20px;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        z-index: 1001;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .offline-indicator.online {
        background: #28a745;
        color: white;
    }

    .offline-indicator.offline {
        background: #dc3545;
        color: white;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    .offline-content {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* Mobile responsive */
    @@media (max-width: 768px) {
        .pwa-install-prompt {
            bottom: 10px;
            left: 10px;
            right: 10px;
            padding: 12px;
        }

        .pwa-install-content {
            flex-direction: column;
            text-align: center;
            gap: 8px;
        }

        .pwa-install-icon img {
            width: 40px;
            height: 40px;
        }

        .pwa-install-text h3 {
            font-size: 15px;
        }

        .pwa-install-text p {
            font-size: 13px;
        }

        .pwa-install-actions {
            width: 100%;
            justify-content: center;
        }

        .offline-indicator {
            bottom: 10px;
            left: 10px;
            font-size: 13px;
        }
    }

    /* Hide animations */
    .pwa-install-prompt.hidden {
        transform: translateY(120%);
        opacity: 0;
    }
</style>

@code {
    private bool _showInstallPrompt = false;
    private bool _dismissed = false;
    private bool _isOnline = true;
    private bool _showOfflineIndicator = false;
    private CancellationTokenSource _cts = new();
    private bool _isInitialized = false;
    private bool _isLoggedIn = false;
    private bool _isIOS = false;
    private bool _canInstallNative = false;

    public bool IsOnline => _isOnline;
    public bool ShowOfflineIndicator => _showOfflineIndicator;

    protected override void OnInitialized()
    {
        // Subscribe to events (no JS interop here)
        PWAService.OnInstallStateChanged += HandleInstallStateChanged;
        PWAService.OnOnlineStateChanged += HandleOnlineStateChanged;
        PWAService.OnBeforeInstallPromptFired += HandleBeforeInstallPromptFired;

        // Check initial state from PWA service (no JS interop)
        _isOnline = PWAService.IsOnline;
        _showOfflineIndicator = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;

            // Initialize PWA service (JS interop only after render)
            await PWAService.InitializeAsync();

            // Check if previously dismissed (persisted in localStorage)
            var dismissedFlag = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "pwa_dismissed");
            _dismissed = dismissedFlag == "true";

            // W2-T5: Check if user is logged in (customer_token in localStorage)
            var customerToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            _isLoggedIn = !string.IsNullOrEmpty(customerToken);

            // Detect iOS (no beforeinstallprompt support — show instructions instead)
            try
            {
                _isIOS = await JSRuntime.InvokeAsync<bool>("vananPWA.isIOS");
            }
            catch { /* ignore */ }

            // Check if beforeinstallprompt already fired before Blazor booted
            // (race condition: Chrome may fire it during page load before WASM is ready)
            try
            {
                _canInstallNative = await JSRuntime.InvokeAsync<bool>("vananPWA.canInstallNative");
            }
            catch { /* ignore */ }

            // Show install prompt ONLY when everything is ready:
            // - iOS: beforeinstallprompt never fires → show instructions immediately after delay
            // - Android/Desktop: only show when beforeinstallprompt has fired (CanInstallNative=true)
            if (!PWAService.IsInstalled && !_dismissed)
            {
                if (_isIOS)
                {
                    // iOS: show instructions prompt after a short delay
                    try
                    {
                        await Task.Delay(3000, _cts.Token);
                        _showInstallPrompt = true;
                        StateHasChanged();
                    }
                    catch (OperationCanceledException) { /* Component disposed */ }
                }
                else if (_canInstallNative)
                {
                    // beforeinstallprompt already fired before Blazor booted — show now
                    try
                    {
                        await Task.Delay(2000, _cts.Token);
                        _showInstallPrompt = true;
                        StateHasChanged();
                    }
                    catch (OperationCanceledException) { /* Component disposed */ }
                }
                // else: Android/Desktop without beforeinstallprompt yet — wait for
                // HandleBeforeInstallPromptFired callback (fired by pwa.js when event fires)
            }
        }
    }

    private string GetDisplayStyle()
    {
        // Show install prompt if not dismissed (logged-in users can still install PWA)
        if (!_showInstallPrompt || _dismissed) return "display: none;";
        return "";
    }

    private async Task InstallApp()
    {
        var success = await PWAService.ShowInstallPromptAsync();
        if (success)
        {
            _showInstallPrompt = false;
            await ShowNotificationAsync("Đã cài đặt thành công!", "Vạn An App đã được cài đặt trên thiết bị của bạn.");
        }
        else
        {
            // Bug 3: Show feedback when install prompt unavailable (e.g. already installed, iOS, or browser doesn't support)
            await ShowNotificationAsync("Không thể cài đặt tự động", "Trình duyệt không hỗ trợ cài đặt tự động. Trên iPhone/iPad: nhấn nút Share → 'Thêm vào Màn hình chính'. Trên Android: menu ⋮ → 'Cài đặt ứng dụng'.");
        }
    }

    private async Task DismissPrompt()
    {
        _dismissed = true;
        _showInstallPrompt = false;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "pwa_dismissed", "true");
    }

    private void HandleInstallStateChanged(bool installed)
    {
        _showInstallPrompt = false;
        StateHasChanged();
    }

    private void HandleOnlineStateChanged(bool online)
    {
        _isOnline = online;
        StateHasChanged();
    }

    private void HandleBeforeInstallPromptFired()
    {
        // Called by pwa.js when beforeinstallprompt fires — everything is ready now.
        // Show the install prompt (only if not dismissed/installed).
        _canInstallNative = true;
        if (!_dismissed && !PWAService.IsInstalled)
        {
            _showInstallPrompt = true;
            StateHasChanged();
        }
    }

    private async Task ShowNotificationAsync(string title, string message)
    {
        await PWAService.ShowNotificationAsync(title, message);
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        if (PWAService != null)
        {
            PWAService.OnInstallStateChanged -= HandleInstallStateChanged;
            PWAService.OnOnlineStateChanged -= HandleOnlineStateChanged;
            PWAService.OnBeforeInstallPromptFired -= HandleBeforeInstallPromptFired;
            await PWAService.DisposeAsync();
        }
    }
}
