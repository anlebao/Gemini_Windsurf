@using VanAn.Shared.Domain
@using VanAn.Shared.Extensions
@using VanAn.KhachLink.Models
@using VanAn.KhachLink.Components.Shared
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Tokens
@using System.Globalization

<VanAnCard CssClass="vibe-showcase-container" Shadow="false">
    <div class="container">
        @* Storefront content-neutral (2026-11-24): bỏ "Thực đơn đặc sắc" hardcode F&B —
           outer section ở Store.razor đã có title "Bộ Sưu Tập Sản Phẩm". *@
        
        @if (ShopConfig?.ActiveTheme != null)
        {
            var themeClass = ShopConfig.ActiveTheme.ToCssClass();
            switch (ShopConfig.ActiveTheme)
            {
                case ThemeType.Teen:
                    <div class="teen-vibe">
                        <div class="row g-4">
                            @foreach (var product in VisibleProducts)
                            {
                                <div class="col-6 col-md-6 col-lg-4 vibe-qv reveal-on-scroll" key="@product.ProductId"
                                     @onclick="() => NotifyProductClick(product)">
                                    <VanAnCard CssClass="teen-card" Shadow="true" Hoverable="true">
                                        <div class="teen-image">
                                            <img src="@(product?.ImageUrl ?? "/images/teen-product.jpg")" alt="@(product?.Name ?? "Sản phẩm")" loading="lazy" />
                                            <div class="teen-overlay">
                                                <span class="teen-badge">HOT</span>
                                            </div>
                                        </div>
                                        <div class="teen-content">
                                            <h4 class="neon-text">@(product?.Name ?? "Sản phẩm")</h4>
                                            <p class="teen-desc">@(product?.Description ?? "Mô tả sản phẩm")</p>
                                            <div class="teen-price">@CurrencyHelper.FormatVND(product?.Price ?? 0m)</div>
                                            <span @onclick:stopPropagation="true">
                                                <VanAnButton Variant="ButtonVariant.Primary"
                                                           Size="ButtonSize.Medium"
                                                           FullWidth="true"
                                                           OnClick="() => { if (product is not null) AddToCart?.Invoke(product); }">
                                                    @ProductCardCta
                                                </VanAnButton>
                                            </span>
                                        </div>
                                    </VanAnCard>
                                </div>
                            }
                        </div>
                    </div>
                    break;

                case ThemeType.Lady:
                    <div class="lady-vibe">
                        <div class="row g-4">
                            @foreach (var product in VisibleProducts)
                            {
                                <div class="col-6 col-md-6 col-lg-4 vibe-qv reveal-on-scroll" key="@product.ProductId"
                                     @onclick="() => NotifyProductClick(product)">
                                    <VanAnCard CssClass="lady-card" Shadow="true">
                                        @if (!string.IsNullOrEmpty(product?.ImageUrl))
                                        {
                                            <img class="vibe-thumb" src="@product!.ImageUrl" alt="@product.Name" loading="lazy" />
                                        }
                                        <div class="lady-header">
                                            <h4 class="elegant-title">@(product?.Name ?? "Sản phẩm")</h4>
                                            <div class="lady-icon">🌸</div>
                                        </div>
                                        <p class="lady-desc">@(product?.Description ?? "Mô tả sản phẩm")</p>
                                        <div class="lady-footer">
                                            <span class="lady-price">@CurrencyHelper.FormatVND(product?.Price ?? 0m)</span>
                                            <span @onclick:stopPropagation="true">
                                                <VanAnButton Variant="ButtonVariant.Secondary"
                                                           Size="ButtonSize.Small"
                                                           OnClick="() => { if (product is not null) AddToCart?.Invoke(product); }">
                                                    @ProductCardCta
                                                </VanAnButton>
                                            </span>
                                        </div>
                                    </VanAnCard>
                                </div>
                            }
                        </div>
                    </div>
                    break;

                case ThemeType.Classic:
                    <div class="classic-vibe">
                        <div class="row">
                            @foreach (var product in VisibleProducts)
                            {
                                <div class="col-6 col-md-6 mb-3 vibe-qv reveal-on-scroll" key="@product.ProductId"
                                     @onclick="() => NotifyProductClick(product)">
                                    <VanAnCard CssClass="classic-card" Shadow="true">
                                        <div class="classic-row">
                                            @if (!string.IsNullOrEmpty(product?.ImageUrl))
                                            {
                                                <img class="vibe-thumb-classic" src="@product!.ImageUrl" alt="@product.Name" loading="lazy" />
                                            }
                                            <div class="classic-info">
                                                <h4>@(product?.Name ?? "Sản phẩm")</h4>
                                                <p>@(product?.Description ?? "Mô tả sản phẩm")</p>
                                                <span class="classic-price">@CurrencyHelper.FormatVND(product?.Price ?? 0m)</span>
                                            </div>
                                            <span @onclick:stopPropagation="true">
                                                <VanAnButton Variant="ButtonVariant.Primary"
                                                           Size="ButtonSize.Small"
                                                           OnClick="() => { if (product is not null) AddToCart?.Invoke(product); }">
                                                    @ProductCardCta
                                                </VanAnButton>
                                            </span>
                                        </div>
                                    </VanAnCard>
                                </div>
                            }
                        </div>
                    </div>
                    break;

                case ThemeType.Premium:
                    <div class="premium-vibe">
                        @foreach (var product in VisibleProducts)
                        {
                            <div class="premium-card-wrapper mb-4 vibe-qv reveal-on-scroll" key="@product.ProductId"
                                 @onclick="() => NotifyProductClick(product)">
                                <VanAnCard CssClass="premium-card" Shadow="true">
                                    <div class="premium-layout">
                                        <div class="premium-image">
                                            <img src="@(product?.ImageUrl ?? "/images/premium-product.jpg")" alt="@(product?.Name ?? "Sản phẩm")" loading="lazy" />
                                        </div>
                                        <div class="premium-content">
                                            <div class="premium-header">
                                                <h3 class="premium-title">@(product?.Name ?? "Sản phẩm")</h3>
                                                <div class="premium-badge">PREMIUM</div>
                                            </div>
                                            <p class="premium-desc">@(product?.Description ?? "Mô tả sản phẩm")</p>
                                            <div class="premium-footer">
                                                <span class="premium-price">@CurrencyHelper.FormatVND(product?.Price ?? 0m)</span>
                                                <span @onclick:stopPropagation="true">
                                                    <VanAnButton Variant="ButtonVariant.Success"
                                                               Size="ButtonSize.Large"
                                                               OnClick="() => { if (product is not null) AddToCart?.Invoke(product); }">
                                                        @ProductCardCta
                                                    </VanAnButton>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </VanAnCard>
                            </div>
                        }
                    </div>
                    break;
            }
        }
        else
        {
            // Default fallback using UI Platform
            <div class="default-vibe">
                <div class="row">
                    @foreach (var product in VisibleProducts)
                    {
                        <div class="col-6 col-md-4 mb-3 vibe-qv reveal-on-scroll" key="@product.ProductId"
                             @onclick="() => NotifyProductClick(product)">
                            <VanAnCard CssClass="product-card" Shadow="true">
                                <div class="product-info">
                                    @if (!string.IsNullOrEmpty(product?.ImageUrl))
                                    {
                                        <img class="vibe-thumb" src="@product!.ImageUrl" alt="@product.Name" loading="lazy" />
                                    }
                                    <h5>@(product?.Name ?? "Sản phẩm")</h5>
                                    <p>@(product?.Description ?? "Mô tả sản phẩm")</p>
                                    <p class="product-price">@CurrencyHelper.FormatVND(product?.Price ?? 0m)</p>
                                    <span @onclick:stopPropagation="true">
                                        <VanAnButton Variant="ButtonVariant.Primary"
                                                   Size="ButtonSize.Medium"
                                                   FullWidth="true"
                                                   OnClick="() => { if (product is not null) AddToCart?.Invoke(product); }">
                                            @ProductCardCta
                                        </VanAnButton>
                                    </span>
                                </div>
                            </VanAnCard>
                        </div>
                    }
                </div>
            </div>
        }

        @* 2026-11-26: 8 sản phẩm/trang — tenant vài trăm SP không load hết một lần. *@
        @if (TotalPages > 1)
        {
            <div class="vibe-pager">
                <button type="button" class="vibe-pager-btn vibe-pager-prev" aria-label="Trang trước"
                        disabled="@(_page == 0)" @onclick="PrevPage">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span class="vibe-pager-info">@(_page + 1) / @TotalPages</span>
                <button type="button" class="vibe-pager-btn vibe-pager-next" aria-label="Trang sau"
                        disabled="@(_page >= TotalPages - 1)" @onclick="NextPage">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        }
    </div>
</VanAnCard>

<style>
    /* 2026-11-26: thumbnail + truncation + slim borders + pager */
    .vibe-thumb {
        width: 100%;
        height: 130px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: .5rem;
    }

    .vibe-thumb-classic {
        width: 72px;
        height: 72px;
        object-fit: cover;
        border-radius: 8px;
        flex-shrink: 0;
        align-self: center;
    }

    /* Truncate tên/mô tả dài — không tràn bể khung */
    .teen-card .neon-text, .lady-card .elegant-title, .classic-card h4,
    .premium-card .premium-title, .product-card h5 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .teen-card .teen-desc, .lady-card .lady-desc, .classic-card p,
    .premium-card .premium-desc, .product-card p:not(.product-price) {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Viền mảnh hơn, tinh tế hơn */
    .teen-card { border-width: 1px; }
    .classic-card { border-left-width: 2px; }
    .premium-card { border-color: rgba(255, 215, 0, .4); }
    .lady-card { box-shadow: 0 6px 18px rgba(0,0,0,.08); }
    .product-card { border: 1px solid #e9ecef; }

    /* Pager */
    .vibe-pager {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .75rem;
        margin-top: 1rem;
    }

    .vibe-pager-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid rgba(0,0,0,.15);
        background: rgba(255,255,255,.9);
        color: #333;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .vibe-pager-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(0,0,0,.15);
    }

    .vibe-pager-btn:disabled {
        opacity: .35;
        cursor: not-allowed;
    }

    .vibe-pager-info {
        font-size: .875rem;
        font-weight: 600;
        color: rgba(0,0,0,.65);
        min-width: 3.5rem;
        text-align: center;
    }

    /* Teen Theme Styles */
    .teen-vibe {
        background: linear-gradient(45deg, #ff006e, #8338ec, #3a86ff);
        padding: 2rem;
        border-radius: 20px;
    }
    
    .teen-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        overflow: hidden;
        border: 2px solid rgba(255, 255, 255, 0.2);
        transition: transform 0.3s ease;
    }
    
    .teen-card:hover {
        transform: translateY(-10px) scale(1.02);
    }
    
    .neon-text {
        color: #fff;
        text-shadow: 0 0 10px #ff006e, 0 0 20px #ff006e;
    }
    
    .teen-btn {
        background: linear-gradient(45deg, #ff006e, #8338ec);
        border: none;
        color: white;
        padding: 12px 24px;
        border-radius: 25px;
        font-weight: bold;
        transition: all 0.3s ease;
    }
    
    /* Lady Theme Styles */
    .lady-vibe {
        background: linear-gradient(135deg, #ffeaa7, #fdcb6e, #fab1a0);
        padding: 2rem;
        border-radius: 20px;
    }
    
    .lady-card {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        border: 1px solid rgba(255, 182, 193, 0.3);
    }
    
    .elegant-title {
        color: #d63031;
        font-family: 'Georgia', serif;
    }
    
    .lady-btn {
        background: linear-gradient(45deg, #ff7675, #fd79a8);
        border: none;
        color: white;
        padding: 10px 20px;
        border-radius: 20px;
        font-size: 0.9rem;
    }
    
    /* SF-W2 (B3): clickable card → quick-view (reveal-on-scroll armed by vananReveal JS) */
    .vibe-qv { cursor: pointer; }

    /* Classic Theme Styles */
    .classic-vibe {
        background: linear-gradient(135deg, #dfe6e9, #b2bec3, #636e72);
        padding: 2rem;
        border-radius: 15px;
    }
    
    .classic-card {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        border-left: 4px solid #8b4513;
    }
    
    .classic-btn {
        background: #8b4513;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
    }
    
    /* Premium Theme Styles */
    .premium-vibe {
        background: linear-gradient(135deg, #000000, #1a1a1a, #2d2d2d);
        padding: 2rem;
        border-radius: 20px;
    }
    
    .premium-card {
        background: linear-gradient(135deg, #1a1a1a, #2d2d2d);
        border-radius: 15px;
        overflow: hidden;
        border: 1px solid #ffd700;
        display: flex;
        align-items: center;
    }
    
    .premium-title {
        color: #ffd700;
        font-size: 1.5rem;
        font-weight: bold;
    }
    
    .premium-btn {
        background: linear-gradient(45deg, #ffd700, #ffed4e);
        color: #000;
        border: none;
        padding: 12px 24px;
        border-radius: 25px;
        font-weight: bold;
    }

    /* Mobile (≤576px): 2-col grid đã set bằng col-6 — thu gọn padding/border
       để card nhỏ gọn, nhiều sản phẩm hiển thị hơn. */
    @@media (max-width: 576px) {
        /* Giải phóng chiều ngang: padding lồng nhau (card-body + container +
           vibe + gutter) ăn ~90px mỗi bên → card col-6 chỉ còn ~135px. */
        .vibe-showcase-container .card-body { padding: 0.5rem; }
        .vibe-showcase-container .container { padding: 0; }
        .vibe-showcase-container .row { --bs-gutter-x: 0.5rem; }

        .teen-vibe, .lady-vibe, .classic-vibe, .premium-vibe, .default-vibe {
            padding: 0.5rem;
        }

        .classic-card {
            padding: .75rem;
            border-left-width: 3px;
        }

        .classic-row {
            flex-direction: column;
            align-items: stretch;
            gap: .5rem;
        }

        .classic-card p {
            display: none;
        }

        .classic-card h4 {
            font-size: 1rem;
            margin-bottom: .25rem;
        }

        .teen-card, .lady-card {
            padding: .75rem;
        }

        .teen-desc, .lady-desc {
            display: none;
        }

        .premium-content {
            padding: 1rem;
        }
    }
</style>

@code {
    [Parameter]
    public ShopConfig? Config { get; set; }
    
    [Parameter]
    public List<ProductDto>? Products { get; set; }
    
    private ShopConfig? ShopConfig => Config;
    
    [Parameter]
    public Action<ProductDto>? AddToCart { get; set; }

    /// <summary>SF-W2 (B3): optional card click → host opens the quick-view modal.</summary>
    [Parameter]
    public EventCallback<ProductDto> OnProductClick { get; set; }

    /// <summary>Storefront vertical (Phương án A): CTA label trên product card. Mặc định trung lập.</summary>
    [Parameter]
    public string ProductCardCta { get; set; } = "Thêm vào giỏ";

    // ---- 2026-11-26: pagination — 8 sản phẩm/trang ----
    private const int PageSize = 8;
    private int _page;

    private int TotalPages => Products is { Count: > 0 } p
        ? (int)Math.Ceiling(p.Count / (double)PageSize)
        : 0;

    private IEnumerable<ProductDto> VisibleProducts =>
        (Products ?? new List<ProductDto>()).Skip(_page * PageSize).Take(PageSize);

    protected override void OnParametersSet()
    {
        // Đổi dataset (search/filter) → về trang 1; clamp khi list thu nhỏ.
        if (_page >= TotalPages) _page = Math.Max(0, TotalPages - 1);
    }

    private void NextPage() { if (_page < TotalPages - 1) _page++; }
    private void PrevPage() { if (_page > 0) _page--; }

    private Task NotifyProductClick(ProductDto? product)
        => product is not null && OnProductClick.HasDelegate
            ? OnProductClick.InvokeAsync(product)
            : Task.CompletedTask;
}
