@* Realtime Platform P5 (F9): static shop map + distance. Map upgrade 2026-11-07:
   Google Maps Embed API iframe (embed/v1/place) — prettier + more reliable on VN
   networks than Leaflet raster tiles. Key in appsettings.json GoogleMaps:EmbedKey
   (public, referrer-restricted); empty → free output=embed fallback. *@
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Components.Realtime
@inject IJSRuntime JSRuntime
@inject IConfiguration Config

<VanAnCard CssClass="location-section" Shadow="true">
    <h3 class="text-center mb-4">Tìm chúng tôi</h3>

    @if (ShopConfig?.Latitude != null && ShopConfig?.Longitude != null)
    {
        <VanAnCard CssClass="map-container-card" Shadow="true">
            <iframe class="store-map-iframe" src="@MapUrl"
                    width="100%" height="400" style="border:0;border-radius:12px;"
                    allowfullscreen loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="@($"Bản đồ {ShopConfig.ShopName}")"></iframe>
        </VanAnCard>

        <div class="text-center mt-3">
            @if (_distanceKm.HasValue)
            {
                <span class="badge bg-success fs-6">
                    <i class="bi bi-signpost-split"></i> Cách bạn ~@_distanceKm.Value.ToString("0.#") km
                </span>
            }
            else if (_distanceError != null)
            {
                <span class="badge bg-secondary fs-6"><i class="bi bi-geo-alt"></i> @_distanceError</span>
            }
            <a class="btn btn-outline-primary btn-sm ms-2"
               href="https://maps.google.com/?q=@ShopConfig.Latitude,@ShopConfig.Longitude"
               target="_blank" rel="noopener">
                <i class="bi bi-compass"></i> Chỉ đường
            </a>
        </div>

        <VanAnCard CssClass="map-info-card mt-3" Shadow="false">
            <div class="text-center">
                <h3>@ShopConfig.ShopName</h3>
                <p class="mb-1"><i class="bi bi-geo-alt-fill"></i> @ShopConfig.Address</p>
                <p class="mb-1"><i class="bi bi-telephone-fill"></i> @ShopConfig.Phone</p>
                <p class="mb-0"><i class="bi bi-envelope-fill"></i> @ShopConfig.Email</p>
            </div>
        </VanAnCard>
    }
    else
    {
        <VanAnCard CssClass="no-gps-card" Shadow="true">
            <div class="text-center p-4">
                <i class="bi bi-map text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2 mb-0">Chưa cập nhật tọa độ GPS</p>
            </div>
        </VanAnCard>
    }
</VanAnCard>

@code {
    [Parameter]
    public ShopConfig? ShopConfig { get; set; }

    private double? _distanceKm;
    private string? _distanceError;

    /// <summary>Google Maps Embed URL — embed/v1/place khi có key, output=embed
    /// (free, không cần key) khi chưa cấu hình. Lat/lng invariant để tránh dấu
    /// phẩy decimal theo locale.</summary>
    private string MapUrl
    {
        get
        {
            var q = FormattableString.Invariant(
                $"{ShopConfig!.Latitude!.Value},{ShopConfig.Longitude!.Value}");
            var key = Config["GoogleMaps:EmbedKey"];
            return !string.IsNullOrWhiteSpace(key)
                ? $"https://www.google.com/maps/embed/v1/place?key={key}&q={q}&zoom=15&language=vi&region=VN"
                : $"https://maps.google.com/maps?q={q}&z=15&hl=vi&output=embed";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CalculateDistanceAsync();
    }

    /// <summary>
    /// P5: khoảng cách từ vị trí hiện tại của khách (GPS) tới shop — haversine, km.
    /// GPS bị từ chối/không có → chỉ hiện map tĩnh, không lỗi.
    /// </summary>
    private async Task CalculateDistanceAsync()
    {
        if (ShopConfig?.Latitude == null || ShopConfig?.Longitude == null)
            return;

        try
        {
            var pos = await JSRuntime.InvokeAsync<GeoPosition?>("vananRealtime.getCurrentPosition");
            if (pos != null)
                _distanceKm = HaversineKm(pos.Lat, pos.Lng, ShopConfig.Latitude.Value, ShopConfig.Longitude.Value);
        }
        catch
        {
            _distanceError = "Bật GPS để xem khoảng cách";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private static double HaversineKm(double lat1, double lng1, double lat2, double lng2)
    {
        const double earthRadiusKm = 6371.0;
        var dLat = (lat2 - lat1) * Math.PI / 180.0;
        var dLng = (lng2 - lng1) * Math.PI / 180.0;
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2)
              + Math.Cos(lat1 * Math.PI / 180.0) * Math.Cos(lat2 * Math.PI / 180.0)
              * Math.Sin(dLng / 2) * Math.Sin(dLng / 2);
        return earthRadiusKm * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    private class GeoPosition
    {
        public double Lat { get; set; }
        public double Lng { get; set; }
    }
}
