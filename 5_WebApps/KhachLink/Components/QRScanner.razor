@using VanAn.UI.Platform.Components.Atomic
@inject IJSRuntime JSRuntime

<div class="qr-scanner-wrap @(_floatingMode ? "qr-floating" : "qr-fullwidth")">
    @if (!_isScanning)
    {
        <div class="scanner-placeholder">
            <i class="bi bi-qr-code-scan display-3 text-primary mb-2"></i>
            <h5 class="mb-2">Quét mã QR</h5>

            @if (!_hasCameraPermission)
            {
                <VanAnAlert Variant="AlertVariant.Warning" Message="Cần quyền truy cập camera để quét mã QR" />
                <VanAnButton Variant="ButtonVariant.Primary" OnClick="@RequestCameraPermission">
                    Cấp Quyền Camera
                </VanAnButton>
            }
            else
            {
                <VanAnButton Variant="ButtonVariant.Primary" Icon="camera" OnClick="@StartScanning">
                    Quét
                </VanAnButton>
            }

            <div class="scan-mode-toggle mt-2">
                <button type="button" class="btn btn-sm btn-link text-muted p-1" @onclick="ToggleFloatingMode">
                    <i class="bi @(_floatingMode ? "bi-fullscreen" : "bi-fullscreen-exit")"></i>
                    @if (_floatingMode)
                    {
                        <span>Thoát dialog</span>
                    }
                    else
                    {
                        <span>Mở dialog</span>
                    }
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="scanner-active">
            <div id="qr-reader" class="qr-reader-container"></div>
            <div class="scan-controls">
                <VanAnButton Variant="ButtonVariant.Error" OnClick="@StopScanning">
                    Dừng Quét
                </VanAnButton>
            </div>
        </div>
    }

    @if (_errorMessage != null)
    {
        <VanAnAlert Variant="AlertVariant.Error" Message="@_errorMessage" class="mt-2" />
    }
</div>

@code {
    private bool _isScanning = false;
    private bool _hasCameraPermission = false;
    private bool _floatingMode = false;
    private string? _errorMessage = null;
    private DotNetObjectReference<QRScanner>? _dotNetRef;

    [Parameter]
    public EventCallback<string> OnQRCodeDetected { get; set; }

    [Parameter]
    public bool DefaultFloating { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _floatingMode = DefaultFloating;
            _dotNetRef = DotNetObjectReference.Create(this);
            await CheckCameraPermission();
            StateHasChanged();
        }
    }

    private async Task CheckCameraPermission()
    {
        try
        {
            var hasPermission = await JSRuntime.InvokeAsync<bool>("checkCameraPermission");
            _hasCameraPermission = hasPermission;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking camera permission: {ex.Message}");
        }
    }

    private async Task RequestCameraPermission()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("requestCameraPermission");
            await CheckCameraPermission();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Không thể cấp quyền camera: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task StartScanning()
    {
        try
        {
            _isScanning = true;
            _errorMessage = null;
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("startQRScanner", _dotNetRef);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Không thể khởi động camera: {ex.Message}";
            _isScanning = false;
            StateHasChanged();
        }
    }

    private async Task StopScanning()
    {
        try
        {
            _isScanning = false;
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("stopQRScanner");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi khi dừng quét: {ex.Message}";
            StateHasChanged();
        }
    }

    private void ToggleFloatingMode()
    {
        _floatingMode = !_floatingMode;
    }

    [JSInvokable]
    public async Task OnQRDetected(string qrCodeText)
    {
        await StopScanning();
        await OnQRCodeDetected.InvokeAsync(qrCodeText);
    }

    [JSInvokable]
    public void OnQRError(string errorMessage)
    {
        _errorMessage = $"Lỗi quét mã QR: {errorMessage}";
        _isScanning = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_isScanning)
        {
            try { await JSRuntime.InvokeVoidAsync("stopQRScanner"); } catch { }
        }
        _dotNetRef?.Dispose();
    }
}

<style>
    /* Full-width mode — scan frame fills container, button right below */
    .qr-scanner-wrap.qr-fullwidth {
        width: 100%;
        max-width: 100%;
        padding: 0;
    }

    .qr-scanner-wrap.qr-fullwidth .scanner-placeholder {
        text-align: center;
        padding: 1.5rem 0.5rem;
    }

    .qr-scanner-wrap.qr-fullwidth .scanner-active {
        padding: 0;
    }

    .qr-scanner-wrap.qr-fullwidth .qr-reader-container {
        width: 100%;
        height: 60vh;
        min-height: 350px;
        max-height: 80vh;
        border-radius: 8px;
        overflow: hidden;
        background: #000;
    }

    .qr-scanner-wrap.qr-fullwidth .scan-controls {
        margin-top: 8px;
        text-align: center;
    }

    /* Floating dialog mode — overlay center, large scan frame */
    .qr-scanner-wrap.qr-floating {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        z-index: 1050;
        background: rgba(0,0,0,0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .qr-scanner-wrap.qr-floating .scanner-placeholder {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        max-width: 400px;
        width: 100%;
    }

    .qr-scanner-wrap.qr-floating .scanner-active {
        background: white;
        border-radius: 12px;
        padding: 8px;
        max-width: 90vw;
        max-height: 90vh;
        width: 100%;
    }

    .qr-scanner-wrap.qr-floating .qr-reader-container {
        width: 100%;
        height: 70vh;
        max-height: 80vh;
        border-radius: 8px;
        overflow: hidden;
        background: #000;
    }

    .qr-scanner-wrap.qr-floating .scan-controls {
        margin-top: 8px;
        text-align: center;
    }

    /* Scan mode toggle button — subtle */
    .scan-mode-toggle {
        font-size: 0.8rem;
    }
    .scan-mode-toggle .btn-link {
        text-decoration: none;
        font-size: 0.8rem;
    }

    @@media (max-width: 768px) {
        .qr-scanner-wrap.qr-fullwidth .qr-reader-container {
            height: 70vh;
            min-height: 300px;
        }
    }
</style>
