@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Tokens
@using VanAn.Shared.Domain
@using VanAn.Shared.Domain.Aggregates.KhachLinkAggregate
@using VanAn.KhachLink.Services.Http
@using VanAn.KhachLink.Services.PWA
@using VanAn.KhachLink.Services
@using VanAn.KhachLink.Models
@using VanAn.KhachLink.Components.Shared
@inject IThemeProvider ThemeProvider
@inject ITenantService TenantService
@inject ShopConfigHttpService ShopConfigService
@inject PWAService PWAService
@inject KhachLinkInstanceHttpService InstanceHttp
@inject VanAn.KhachLink.Services.Http.CommunityHttpService CommunityHttp
@inject CartService CartSvc
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inherits VanAn.UI.Platform.Components.Base.BaseComponent

<HeadContent>
    <style>
        :root {
            --shop-primary: @(_shopConfig?.PrimaryColor ?? "#8B4513");
            --shop-secondary: @(_shopConfig?.SecondaryColor ?? "#D2691E");
            --shop-nav-color: @(_instanceStyle?.NavColor ?? _shopConfig?.NavColor ?? "#1a1a2e");
            --shop-header-color: @(_instanceStyle?.HeaderColor ?? _shopConfig?.HeaderColor ?? (_shopConfig?.PrimaryColor ?? "#8B4513"));
            --shop-footer-color: @(_instanceStyle?.FooterColor ?? _shopConfig?.FooterColor ?? "#f5f5f5");
        }
    </style>
</HeadContent>

@if (_isInstanceDisabled)
{
    <div class="khachlink-disabled-page">
        <div class="disabled-card">
            <i class="bi bi-pause-circle-fill disabled-icon"></i>
            <h1>Instance tạm ngưng</h1>
            <p>Instance KhachLink cho domain này hiện đang bị vô hiệu hoá.</p>
            <p class="text-muted">Vui lòng liên hệ quản trị viên để biết thêm chi tiết.</p>
        </div>
    </div>
}
else
{
<CascadingValue Value="_navFlags" Name="NavFlags">
<div class="khachlink-layout theme-@GetThemeClass() tenant-@_currentTenantId">
    <!-- Hero Header -->
    <header class="khachlink-hero-header">
        <div class="hero-content d-flex justify-content-between align-items-center px-3 py-2">
            <div class="d-flex align-items-center gap-2">
                @if (!string.IsNullOrEmpty(_instanceStyle?.LogoUrl))
                {
                    <img src="@_instanceStyle.LogoUrl" alt="@(_shopConfig?.ShopName ?? "Logo")" class="shop-logo" />
                }
                else if (_shopConfig?.LogoUrl != null)
                {
                    <img src="@_shopConfig.LogoUrl" alt="@_shopConfig.ShopName" class="shop-logo" />
                }
                else
                {
                    <i class="bi bi-shop text-white" style="font-size:1.5rem;"></i>
                }
                @* Issue 6: Hide shop-name text from header — logo/icon alone is enough branding *@
            </div>
            <div class="d-flex gap-2 align-items-center">
                @if (_showInstallButton)
                {
                    <button class="header-icon-btn" aria-label="Cài app" @onclick="InstallAppAsync" title="Cài đặt ứng dụng">
                        <i class="bi bi-download text-white"></i>
                    </button>
                }
                @if (_navFlags.ShowCart)
                {
                    <a href="/cart" id="nav-cart" class="header-icon-btn" aria-label="Giỏ hàng">
                        <i class="bi bi-cart3 text-white"></i>
                    </a>
                }
                @if (_navFlags.ShowRewards)
                {
                    <a href="/rewards" id="nav-rewards" class="header-icon-btn" aria-label="Đổi điểm" title="Đổi điểm thưởng">
                        <i class="bi bi-gift text-white"></i>
                    </a>
                }
                @if (_navFlags.ShowMissions)
                {
                    <a href="/missions" class="header-icon-btn" aria-label="Nhiệm vụ" title="Nhiệm vụ thưởng điểm">
                        <i class="bi bi-trophy text-white"></i>
                    </a>
                }
                @if (_navFlags.ShowLoyaltyHistory)
                {
                    <a href="/my-loyalty" class="header-icon-btn" aria-label="Lịch sử tích điểm" title="Lịch sử tích điểm">
                        <i class="bi bi-clock-history text-white"></i>
                    </a>
                }
                @if (_navFlags.ShowProfile)
                {
                    <a href="/profile" class="header-icon-btn" aria-label="Tài khoản">
                        <i class="bi bi-person text-white"></i>
                    </a>
                }
            </div>
        </div>
    </header>

    @* P4.1: Reseller badge global — moved from Home.razor, shows on all pages (not just Home) *@
    @if (_commerceModeLoaded && _isReseller)
    {
        <div class="container mt-2" style="max-width:1000px;">
            <div class="alert alert-info py-2 mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle"></i>
                <small><strong>Mô hình Reseller</strong> — Vạn An mua bán, giá đã bao gồm phí nền tảng.</small>
            </div>
        </div>
    }

    @* Sprint 2 P2.1: What's New banner — 1 lần khi detect profile change *@
    @if (_showWhatsNewBanner)
    {
        <WhatsNewBanner Direction="@_profileChangeDirection" />
    }

    @* Sprint 2 P3.2: Cart preservation modal — FullCommerce → Directory + cart has items *@
    <CartPreservationModal Visible="@_showCartPreservationModal"
                           ItemCount="@_cartItemCount"
                           OnDismissed="@(() => _showCartPreservationModal = false)" />

    @* Sprint 2 P3.1: Onboarding tour — Directory → FullCommerce/Reseller *@
    <OnboardingTour Direction="@_profileChangeDirection" NewProfile="@(_instanceStyle?.Profile ?? KhachLinkProfile.FullCommerce)" />

    <!-- Main Content -->
    <main class="khachlink-main">
        @ChildContent
    </main>

    <!-- Footer -->
    <footer class="khachlink-footer mt-4">
        <div class="text-center py-3 px-3">
            <div class="fw-semibold">@(_shopConfig?.ShopName ?? "Tích Điểm")</div>
            @if (!string.IsNullOrEmpty(_shopConfig?.Phone))
            {
                <div class="small"><a href="tel:@_shopConfig.Phone" class="footer-link">@_shopConfig.Phone</a></div>
            }
            @if (!string.IsNullOrEmpty(_shopConfig?.SocialLinksFb))
            {
                <a href="@_shopConfig.SocialLinksFb" target="_blank" class="footer-social me-2">
                    <i class="bi bi-facebook"></i>
                </a>
            }
            @if (!string.IsNullOrEmpty(_shopConfig?.SocialLinksTiktok))
            {
                <a href="@_shopConfig.SocialLinksTiktok" target="_blank" class="footer-social">
                    <i class="bi bi-tiktok"></i>
                </a>
            }
            <div class="mt-2 small">
                <a href="/privacy-policy.html" class="footer-link" target="_blank" rel="noopener">Chính sách Quyền riêng tư</a>
            </div>
            @* P2.2: Profile indicator — chỉ hiện khi khác FullCommerce (default ẩn) *@
            @if (_instanceStyle != null && _instanceStyle.Profile != KhachLinkProfile.FullCommerce)
            {
                <div class="profile-indicator mt-2 small text-muted">
                    <i class="bi bi-info-circle"></i> Chế độ: @GetProfileLabel(_instanceStyle.Profile)
                </div>
            }
            <!-- Add bottom padding for mobile tab bar -->
            <div style="height: 70px;" class="d-md-none"></div>
        </div>
    </footer>
</div>
</CascadingValue>
}

<style>
/* Hero header */
.khachlink-hero-header {
    background: var(--shop-header-color, var(--shop-primary, #8B4513));
    position: sticky;
    top: 0;
    z-index: 900;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}
.shop-logo {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    object-fit: cover;
}
.shop-name { font-size: 1.1rem; color: white; }
.header-icon-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    text-decoration: none;
    font-size: 1.2rem;
    transition: background 0.2s;
}
.header-icon-btn:hover { background: rgba(255,255,255,0.25); }

/* Layout */
.khachlink-layout { min-height: 100vh; background: var(--color-neutral-50, #f9f9f9); }
.khachlink-main { padding: var(--spacing-4, 1rem); }

/* Footer */
.khachlink-footer { background: var(--shop-footer-color, #f5f5f5); border-top: 1px solid #e0e0e0; color: #555; }
.footer-link { color: inherit; text-decoration: none; }
.footer-social { color: var(--shop-primary, #8B4513); font-size: 1.2rem; }
/* P2.2: Profile indicator */
.profile-indicator { font-size: 0.75rem; opacity: 0.7; }

/* Theme classes */
.theme-teen     { background: linear-gradient(135deg, #ffe0f0, #e0e7ff); }
.theme-lady     { background: linear-gradient(135deg, #fff8f9, #fce4ec); }
.theme-premium  { background: #0a0a0a; color: #f0e68c; }
.theme-modern   { background: #fafafa; }
.theme-classic  { background: #fdf6ec; }

/* #134: Disabled instance page */
.khachlink-disabled-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    padding: 1rem;
}
.disabled-card {
    text-align: center;
    background: white;
    border-radius: 12px;
    padding: 3rem 2rem;
    max-width: 400px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
}
.disabled-icon {
    font-size: 4rem;
    color: #6c757d;
    margin-bottom: 1rem;
}
.disabled-card h1 {
    font-size: 1.5rem;
    color: #333;
    margin-bottom: 0.5rem;
}
.disabled-card p {
    color: #555;
    margin-bottom: 0.25rem;
}
</style>

@code {
    private Guid _currentTenantId;
    private ShopConfig? _shopConfig;
    private bool _showInstallButton;
    private KhachLinkNavFlagsDto _navFlags = new(); // default: all true (FullCommerce fallback)
    /// <summary>#134: True when the KhachLink instance for this domain is disabled.</summary>
    private bool _isInstanceDisabled;
    /// <summary>Issue #143: Style override from KhachLinkInstance (null fields = inherit from ShopConfig).</summary>
    private KhachLinkInstanceConfig? _instanceStyle;
    /// <summary>P4.1: Commerce mode badge — moved from Home.razor, shows on all pages.</summary>
    private bool _commerceModeLoaded;
    private bool _isReseller;

    /// <summary>Sprint 2 P2.1: Profile change detection state.</summary>
    private ProfileChangeDirection _profileChangeDirection = ProfileChangeDirection.None;
    private bool _showWhatsNewBanner;
    private bool _showCartPreservationModal;
    private int _cartItemCount;

    protected override async Task OnInitializedAsync()
    {
        _currentTenantId = TenantService.GetCurrentTenantId();
        _shopConfig = await ShopConfigService.GetShopConfigByTenantIdAsync(_currentTenantId);

        // KhachLink Multi-Profile R1 Sprint 3: fetch instance config by current domain.
        // If feature flag OFF or domain not registered → returns null → _navFlags stays default (all true).
        // If instance found with OwnerTenantId → override current tenant (multi-domain routing).
        // #134-fix: If instance found but IsActive=false → show "disabled" page.
        try
        {
            var instanceConfig = await InstanceHttp.GetByCurrentDomainAsync();
            if (instanceConfig != null)
            {
                if (!instanceConfig.IsActive)
                {
                    _isInstanceDisabled = true;
                    return;
                }

                _navFlags = instanceConfig.NavFlags;
                // Issue #143: store instance config for style override (applied in CSS + logo)
                _instanceStyle = instanceConfig;
                if (instanceConfig.OwnerTenantId != null && instanceConfig.OwnerTenantId != Guid.Empty)
                {
                    TenantService.SetCurrentTenant(instanceConfig.OwnerTenantId.Value);
                    _currentTenantId = instanceConfig.OwnerTenantId.Value;
                    // Re-fetch shop config for the resolved tenant
                    _shopConfig = await ShopConfigService.GetShopConfigByTenantIdAsync(_currentTenantId);
                }

                // Sprint 2 P2.1: Detect profile change via UpdatedAt timestamp.
                // Compare instanceConfig.UpdatedAt with localStorage lastSeenProfileAt.
                // If newer → profile changed → show What's New banner + trigger cart preservation / onboarding.
                try
                {
                    var lastSeenTsStr = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "last_seen_profile_at");
                    var lastSeenProfileStr = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "last_seen_profile");

                    DateTime? lastSeenTs = null;
                    if (lastSeenTsStr != null && DateTime.TryParse(lastSeenTsStr, out var ts))
                        lastSeenTs = ts;

                    KhachLinkProfile? lastSeenProfile = null;
                    if (lastSeenProfileStr != null && Enum.TryParse<KhachLinkProfile>(lastSeenProfileStr, true, out var oldProfile))
                        lastSeenProfile = oldProfile;

                    // Check if banner was already dismissed for this change
                    var dismissed = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "whats_new_dismissed");

                    bool profileChanged = lastSeenTs == null
                        ? false  // First visit — no banner (no previous profile to compare)
                        : instanceConfig.UpdatedAt > lastSeenTs.Value;

                    if (profileChanged && dismissed != "true")
                    {
                        _profileChangeDirection = ProfileChangeDirectionHelper.Compute(lastSeenProfile, instanceConfig.Profile);
                        _showWhatsNewBanner = _profileChangeDirection != ProfileChangeDirection.None;

                        // Sprint 3 P5.1: Trigger SW update when profile change detected.
                        // SW checks for new version → next PWA launch gets fresh nav config.
                        if (_showWhatsNewBanner)
                        {
                            try
                            {
                                await JSRuntime.InvokeVoidAsync("vananTriggerSWUpdate");
                            }
                            catch { /* non-critical — SW update is enhancement */ }
                        }
                    }

                    // Cart preservation: FullCommerce → Directory + cart has items
                    if (_profileChangeDirection == ProfileChangeDirection.FullCommerceToDirectory)
                    {
                        _cartItemCount = await GetCartItemCountAsync();
                        _showCartPreservationModal = _cartItemCount > 0;
                    }

                    // Update localStorage: lastSeenProfileAt + lastSeenProfile (always — even if no change, to keep fresh)
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "last_seen_profile_at", instanceConfig.UpdatedAt.ToString("o"));
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "last_seen_profile", instanceConfig.Profile.ToString());
                    // Clear dismiss flag so next change shows banner again
                    if (profileChanged)
                        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "whats_new_dismissed");
                }
                catch (Exception ex)
                {
                    // Non-critical — profile change detection is enhancement, don't break layout
                    System.Console.WriteLine($"[KhachLinkLayout] Profile change detection failed: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            // Non-critical — fallback to FullCommerce defaults (all flags true)
            System.Console.WriteLine($"[KhachLinkLayout] Instance config fetch failed: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Bug 5: Must initialize PWA service first (registers beforeinstallprompt event listener)
            try
            {
                await PWAService.InitializeAsync();
                _showInstallButton = await PWAService.CanInstallAsync();
                StateHasChanged();
            }
            catch { /* PWA service not available — hide button */ }

            // P4.1: Load commerce mode badge (moved from Home.razor — global, shows on all pages)
            try
            {
                var token = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
                if (!string.IsNullOrEmpty(token))
                {
                    var result = await CommunityHttp.GetCommerceModeAsync(token);
                    if (result?.Success == true)
                    {
                        _isReseller = result.IsReseller;
                        _commerceModeLoaded = true;
                        StateHasChanged();
                    }
                }
            }
            catch { /* silent — badge is optional */ }
        }
    }

    private async Task InstallAppAsync()
    {
        var success = await PWAService.ShowInstallPromptAsync();
        // JS showInstallHelpToast() handles failure case with actionable toast + reload button.
        // No Blazor notification needed — avoids double notification.
        if (success)
        {
            _showInstallButton = false;
            StateHasChanged();
        }
    }

    private string GetThemeClass()
    {
        // Issue #143: instance style override takes precedence over tenant ShopConfig theme.
        // Instance theme is stored as string ("Classic", "Modern", etc.) — parse to ThemeType.
        if (!string.IsNullOrEmpty(_instanceStyle?.Theme)
            && Enum.TryParse<ThemeType>(_instanceStyle.Theme, true, out var instanceTheme))
        {
            return instanceTheme switch
            {
                ThemeType.Teen    => "teen",
                ThemeType.Lady    => "lady",
                ThemeType.Premium => "premium",
                ThemeType.Modern  => "modern",
                _                 => "classic"
            };
        }
        return (_shopConfig?.ActiveTheme ?? ThemeType.Classic) switch
        {
            ThemeType.Teen    => "teen",
            ThemeType.Lady    => "lady",
            ThemeType.Premium => "premium",
            ThemeType.Modern  => "modern",
            _                 => "classic"
        };
    }

    /// <summary>P2.2: Human-readable profile label for footer indicator.</summary>
    private static string GetProfileLabel(KhachLinkProfile profile) => profile switch
    {
        KhachLinkProfile.Directory    => "Danh bạ cửa hàng",
        KhachLinkProfile.Reseller      => "Đại lý Vạn An",
        KhachLinkProfile.Logistics     => "Logistics",
        KhachLinkProfile.JobMarket     => "Sàn việc",
        _                              => "Cửa hàng trực tiếp"
    };

    /// <summary>Sprint 2 P3.2: Get cart item count — CartService is Scoped (shared in circuit).
    /// Fallback: read localStorage vanan_cart if CartService not loaded yet.</summary>
    private async Task<int> GetCartItemCountAsync()
    {
        try
        {
            // CartService scoped — same instance as Cart page within circuit
            var state = CartSvc.GetCartState();
            if (state.Items.Count > 0)
                return state.Items.Count;

            // Fallback: read localStorage (cart may not be loaded into CartService yet on layout init)
            var cartJson = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "vanan_cart");
            if (!string.IsNullOrEmpty(cartJson))
            {
                using var doc = System.Text.Json.JsonDocument.Parse(cartJson);
                if (doc.RootElement.TryGetProperty("items", out var items) && items.ValueKind == System.Text.Json.JsonValueKind.Array)
                    return items.GetArrayLength();
            }
        }
        catch { /* non-critical */ }
        return 0;
    }
}
