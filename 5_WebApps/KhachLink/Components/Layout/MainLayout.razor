@using VanAn.UI.Platform.Components
@using VanAn.KhachLink.Services.Http
@using VanAn.KhachLink.Models
@using VanAn.Shared.Domain.Aggregates.KhachLinkAggregate
@inject KhachLinkHomeSettingsHttpService HomeSettingsService
@inject KhachLinkInstanceHttpService InstanceHttp
@inject NotificationHttpService NotificationHttp
@inject IJSRuntime JSRuntime
@implements IDisposable
@inherits LayoutComponentBase

@if (_isInstanceDisabled)
{
    <div class="khachlink-disabled-page">
        <div class="disabled-card">
            <i class="bi bi-pause-circle-fill disabled-icon"></i>
            <h1>Instance tạm ngưng</h1>
            <p>Instance KhachLink cho domain này hiện đang bị vô hiệu hoá.</p>
            <p class="text-muted">Vui lòng liên hệ quản trị viên để biết thêm chi tiết.</p>
        </div>
    </div>
}
else
{
<CascadingValue Value="_navFlags" Name="NavFlags">
<div class="khachlink-app-layout">
    <!-- Mobile-friendly header -->
    <header class="khachlink-app-header">
        <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <a href="/" class="app-brand">
                <i class="bi bi-shop"></i>
                <span class="fw-bold">Vạn An</span>
            </a>
            <div class="d-flex gap-2">
                @if (_navFlags.ShowCart)
                {
                    <a href="/cart" class="app-header-btn" aria-label="Giỏ hàng">
                        <i class="bi bi-cart3"></i>
                    </a>
                }
                @if (!string.IsNullOrEmpty(_customerToken))
                {
                    <a href="/notifications" class="app-header-btn notif-bell" aria-label="Thông báo" title="Thông báo">
                        <i class="bi bi-bell"></i>
                        @if (_unreadCount > 0)
                        {
                            <span class="notif-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
                        }
                    </a>
                }
                @if (_navFlags.ShowProfile)
                {
                    <a href="/profile" class="app-header-btn" aria-label="Tài khoản">
                        <i class="bi bi-person"></i>
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Desktop: sidebar + main content side-by-side. Mobile: main only (tab bar at bottom) -->
    <div class="khachlink-body">
        <!-- Desktop sidebar nav — #121.1.1: hidden when ShowNavMenu=false (system admin toggle) -->
        @if (_showNavMenu)
        {
            <div class="khachlink-sidebar d-none d-md-block">
                <NavMenu />
            </div>
        }

        <!-- Main content -->
        <main class="khachlink-app-main">
            @Body
        </main>
    </div>

    <!-- Mobile bottom tab bar (rendered after body, fixed at bottom) -->
    @if (_showNavMenu)
    {
        <div class="d-md-none">
            <NavMenu />
        </div>
    }
</div>
</CascadingValue>
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    .khachlink-app-layout {
        min-height: 100vh;
        background: #f9f9f9;
        display: flex;
        flex-direction: column;
    }
    .khachlink-app-header {
        background: #8B4513;
        position: sticky;
        top: 0;
        z-index: 900;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .app-brand {
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 1.1rem;
    }
    .app-brand:hover { color: #f0f0f0; }
    .app-header-btn {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        text-decoration: none;
        color: white;
        font-size: 1.2rem;
        transition: background 0.2s;
    }
    .app-header-btn:hover { background: rgba(255,255,255,0.25); color: white; }
    .notif-bell { position: relative; }
    .notif-badge {
        position: absolute; top: -3px; right: -3px; background: #dc3545; color: white;
        font-size: 0.62rem; font-weight: 700; min-width: 16px; height: 16px; line-height: 16px;
        text-align: center; border-radius: 8px; padding: 0 4px;
    }

    /* Body: sidebar + main side-by-side on desktop, stacked on mobile */
    .khachlink-body {
        display: flex;
        flex: 1;
        min-height: 0;
    }
    .khachlink-sidebar {
        width: 240px;
        flex-shrink: 0;
        position: sticky;
        top: 56px; /* header height */
        height: calc(100vh - 56px);
        overflow-y: auto;
    }
    .khachlink-app-main {
        flex: 1;
        padding: 1rem;
        padding-bottom: 80px; /* Space for mobile tab bar */
        min-width: 0;
    }
    @@media (min-width: 769px) {
        .khachlink-app-main {
            padding: 1.5rem;
            padding-bottom: 1.5rem; /* No mobile tab bar on desktop */
        }
    }

    /* #134: Disabled instance page */
    .khachlink-disabled-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f5f5;
        padding: 1rem;
    }
    .disabled-card {
        text-align: center;
        background: white;
        border-radius: 12px;
        padding: 3rem 2rem;
        max-width: 400px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }
    .disabled-icon {
        font-size: 4rem;
        color: #6c757d;
        margin-bottom: 1rem;
    }
    .disabled-card h1 {
        font-size: 1.5rem;
        color: #333;
        margin-bottom: 0.5rem;
    }
    .disabled-card p {
        color: #555;
        margin-bottom: 0.25rem;
    }
</style>

@code {
    // #121.1.1: System admin toggle — default true (show sidebar). Fetched from Gateway on init.
    private bool _showNavMenu = true;
    // #134: Instance disabled flag + nav flags — fetched from Gateway by-domain endpoint.
    // If instance is disabled, show "Instance tạm ngưng" page instead of @Body.
    private bool _isInstanceDisabled;
    private KhachLinkNavFlagsDto _navFlags = new(); // default: all true (FullCommerce fallback)

    // Notification Hub (2026-10-15): badge số thông báo chưa đọc (khách).
    private string? _customerToken;
    private int _unreadCount;
    private bool _disposed;
    private System.Threading.Timer? _notifTimer;

    protected override async Task OnInitializedAsync()
    {
        // #134: Fetch instance config first — if disabled, skip everything else
        try
        {
            var instanceConfig = await InstanceHttp.GetByCurrentDomainAsync();
            if (instanceConfig != null)
            {
                if (!instanceConfig.IsActive)
                {
                    _isInstanceDisabled = true;
                    return; // Skip rest of init — disabled page will render
                }
                _navFlags = instanceConfig.NavFlags;
            }
        }
        catch (Exception ex)
        {
            System.Console.WriteLine($"[MainLayout] Instance config fetch failed: {ex.Message}");
        }

        // Fetch home settings (nav menu toggle)
        try
        {
            var settings = await HomeSettingsService.GetSettingsAsync();
            if (settings != null)
            {
                _showNavMenu = settings.ShowNavMenu;
            }
        }
        catch
        {
            // Default to showing nav if fetch fails — don't break UX
        }

        // Notification badge — chỉ khi có customer token (đã đăng nhập).
        try
        {
            _customerToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
            if (!string.IsNullOrEmpty(_customerToken))
            {
                await RefreshUnreadAsync();
                _notifTimer = new System.Threading.Timer(async _ => await RefreshUnreadAsync(), null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
            }
        }
        catch
        {
            // Không đọc được token — bỏ badge.
        }
    }

    private async Task RefreshUnreadAsync()
    {
        if (_disposed || string.IsNullOrEmpty(_customerToken)) return;
        try
        {
            int count = await NotificationHttp.GetUnreadCountAsync(_customerToken);
            if (_unreadCount != count)
            {
                _unreadCount = count;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Giữ badge cũ — không làm hỏng layout.
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _notifTimer?.Dispose();
    }
}
