@using VanAn.UI.Platform.Components
@inherits LayoutComponentBase

<div class="khachlink-app-layout">
    <!-- Mobile-friendly header -->
    <header class="khachlink-app-header">
        <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <a href="/" class="app-brand">
                <i class="bi bi-shop"></i>
                <span class="fw-bold">Vạn An</span>
            </a>
            <div class="d-flex gap-2">
                <a href="/cart" class="app-header-btn" aria-label="Giỏ hàng">
                    <i class="bi bi-cart3"></i>
                </a>
                <a href="/profile" class="app-header-btn" aria-label="Tài khoản">
                    <i class="bi bi-person"></i>
                </a>
            </div>
        </div>
    </header>

    <!-- Main content -->
    <main class="khachlink-app-main">
        @Body
    </main>

    <!-- Mobile bottom tab bar -->
    <NavMenu />
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    .khachlink-app-layout {
        min-height: 100vh;
        background: #f9f9f9;
        display: flex;
        flex-direction: column;
    }
    .khachlink-app-header {
        background: #8B4513;
        position: sticky;
        top: 0;
        z-index: 900;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .app-brand {
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 1.1rem;
    }
    .app-brand:hover { color: #f0f0f0; }
    .app-header-btn {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        text-decoration: none;
        color: white;
        font-size: 1.2rem;
        transition: background 0.2s;
    }
    .app-header-btn:hover { background: rgba(255,255,255,0.25); color: white; }
    .khachlink-app-main {
        flex: 1;
        padding: 1rem;
        padding-bottom: 80px; /* Space for mobile tab bar */
    }
    @@media (min-width: 769px) {
        .khachlink-app-main {
            padding: 1.5rem;
        }
    }
</style>
