@* Realtime Platform P4 (UI-10): legacy shim — delegates to the UI Platform VanAnMap.
   Keeps the old parameter surface so the pages that use it don't change; the real implementation
   (IMapJsAdapter → window.vananMap.* in UI.Platform realtime.js) lives in
   UI.Platform/Components/Realtime/VanAnMap.razor. *@
@using VanAn.UI.Platform.Components.Realtime

<VanAnMap MapElementId="MapElementId"
          Height="Height"
          CenterLat="CenterLat"
          CenterLng="CenterLng"
          Zoom="Zoom"
          ShopLat="ShopLat"
          ShopLng="ShopLng"
          ShipperLat="ShipperLat"
          ShipperLng="ShipperLng"
          CustomerLat="CustomerLat"
          CustomerLng="CustomerLng" />

@code {
    [Parameter] public string MapElementId { get; set; } = "leaflet-map";
    [Parameter] public string Height { get; set; } = "400px";
    [Parameter] public double CenterLat { get; set; } = 10.8;
    [Parameter] public double CenterLng { get; set; } = 106.7;
    [Parameter] public int Zoom { get; set; } = 14;

    [Parameter] public double? ShopLat { get; set; }
    [Parameter] public double? ShopLng { get; set; }
    [Parameter] public double? ShipperLat { get; set; }
    [Parameter] public double? ShipperLng { get; set; }
    [Parameter] public double? CustomerLat { get; set; }
    [Parameter] public double? CustomerLng { get; set; }
}
