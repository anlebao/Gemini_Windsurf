@using VanAn.KhachLink.Components.PWA
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="VanAn.KhachLink.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="manifest" href="manifest.json" />
    <link rel="apple-touch-icon" href="icons/icon-192x192.png" />
    <meta name="theme-color" content="#8B4513" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Vạn An" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="description" content="Hệ thống đặt hàng thông minh của Vạn An Group" />
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"
            integrity="sha384-c9d8RFSL+u3exBOJ4Yp3HUJXS4znl9f+z66d1y54ig+ea249SpqR+w1wyvXz/lk+"
            crossorigin="anonymous"></script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <PWAInstallPrompt />
    <script src="_framework/blazor.web.js"></script>
    <script src="/js/pwa.js"></script>
    <script src="/js/qr-scanner.js"></script>
    <script src="/js/cart-animation.js"></script>
    <script>
        // Register service worker on app startup
        document.addEventListener('DOMContentLoaded', async () => {
            if (window.vananPWA && typeof window.vananPWA.registerServiceWorker === 'function') {
                try {
                    await window.vananPWA.registerServiceWorker();
                } catch (error) {
                    console.error('Service Worker registration failed:', error);
                }
            }
        });
    </script>
</body>

</html>
