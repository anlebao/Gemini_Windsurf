@using VanAn.KhachLink.Components.PWA
@using static Microsoft.AspNetCore.Components.Web.RenderMode
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"
            integrity="sha384-c9d8RFSL+u3exBOJ4Yp3HUJXS4znl9f+z66d1y54ig+ea249SpqR+w1wyvXz/lk+"
            crossorigin="anonymous"></script>
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <PWAInstallPrompt />
    <script src="_framework/blazor.web.js"></script>
    <script src="/js/pwa.js"></script>
    <script src="/js/qr-scanner.js"></script>
    <script>
        // Register service worker on app startup
        document.addEventListener('DOMContentLoaded', async () => {
            if (window.vananPWA && typeof window.vananPWA.registerServiceWorker === 'function') {
                try {
                    await window.vananPWA.registerServiceWorker();
                } catch (error) {
                    console.error('Service Worker registration failed:', error);
                }
            }
        });
    </script>
</body>

</html>
