@using VanAn.KhachLink.Components.PWA
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="VanAn.KhachLink.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <PWAInstallPrompt />
    <script src="_framework/blazor.web.js"></script>
    <script src="/js/pwa.js"></script>
    <script>
        // Register service worker on app startup
        document.addEventListener('DOMContentLoaded', async () => {
            if (window.vananPWA && typeof window.vananPWA.registerServiceWorker === 'function') {
                try {
                    await window.vananPWA.registerServiceWorker();
                } catch (error) {
                    console.error('Service Worker registration failed:', error);
                }
            }
        });
    </script>
</body>

</html>
