@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Tokens
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime

@* T-03b: Wrapper div with id="qrPaymentModal" â€” required by E2E selector contract.
   VanAnModal renders its own <div class="modal"> but doesn't expose an id param.
   Wrapping here ensures #qrPaymentModal is always in the DOM when IsOpen=true. *@
@if (IsOpen)
{
    <div id="qrPaymentModal">
        <VanAnModal IsOpen="true"
                    Title="Thanh toÃ¡n qua VietQR"
                    OnClose="HandleClose"
                    Closable="true">
            <ChildContent>
            <div class="qr-modal-content text-center">
                @if (IsLoading)
                {
                    <div class="loading-container">
                        <span class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Äang táº¡o mÃ£ QR...</span>
                        </span>
                        <p class="mt-3">Äang táº¡o mÃ£ QR thanh toÃ¡n...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(QrImageUrl))
                {
                    <VanAnCard CssClass="qr-info-card" Shadow="true">
                        <div class="qr-image-container">
                            <img src="@QrImageUrl" alt="VietQR Payment Code" class="qr-image" />
                        </div>
                        <div class="qr-info mt-3">
                            <h6>ThÃ´ng tin thanh toÃ¡n</h6>
                            <p class="mb-1"><strong>Sá»‘ tiá»n:</strong> @Amount.ToString("N0")Ä‘</p>
                            <p class="mb-1"><strong>MÃ£ Ä‘Æ¡n hÃ ng:</strong> @OrderId</p>
                            <p class="mb-1"><strong>NgÃ¢n hÃ ng:</strong> @BankName</p>
                            <p class="mb-0"><small class="text-muted">QuÃ©t mÃ£ QR báº±ng á»©ng dá»¥ng ngÃ¢n hÃ ng Ä‘á»ƒ thanh toÃ¡n</small></p>
                        </div>
                    </VanAnCard>

                    <!-- W1-T3: Dual status bars â€” order processing + payment status -->
                    <div class="dual-status-bars mt-3 text-start" data-testid="dual-status-bars">
                        <div class="status-bar mb-2">
                            <label class="fw-bold small">Xá»­ lÃ½ Ä‘Æ¡n hÃ ng</label>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @(_paymentConfirmed ? "bg-success" : "bg-info")"
                                     role="progressbar"
                                     style="width: @(_paymentConfirmed ? "100%" : "60%")"
                                     aria-valuenow="@(_paymentConfirmed ? 100 : 60)"
                                     aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <span class="small text-muted">@(_paymentConfirmed ? "ÄÃ£ xÃ¡c nháº­n" : "Äang xá»­ lÃ½...")</span>
                        </div>
                        <div class="status-bar mb-2">
                            <label class="fw-bold small">Chá» thanh toÃ¡n</label>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @(_paymentConfirmed ? "bg-success" : "bg-warning")"
                                     role="progressbar"
                                     style="width: @(_paymentConfirmed ? "100%" : "50%")"
                                     aria-valuenow="@(_paymentConfirmed ? 100 : 50)"
                                     aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <span class="small text-muted">@(_paymentConfirmed ? "ÄÃ£ thanh toÃ¡n" : "Chá» khÃ¡ch quÃ©t QR...")</span>
                        </div>
                    </div>
                }
                else if (Error != null)
                {
                    <VanAnCard CssClass="error-card" Shadow="true">
                        <div class="text-danger">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span class="ms-2">@Error</span>
                        </div>
                    </VanAnCard>
                }
            </div>
            </ChildContent>

            @* T-03b: FooterContent â†’ Footer (correct VanAnModal RenderFragment parameter name) *@
            <Footer>
                <VanAnButton Variant="ButtonVariant.Secondary"
                             OnClick="HandleClose"
                             data-testid="qr-modal-btn-close">
                    ÄÃ³ng
                </VanAnButton>
                @if (!string.IsNullOrEmpty(QrImageUrl))
                {
                    <VanAnButton Variant="ButtonVariant.Primary"
                                 Icon="download"
                                 OnClick="DownloadQr"
                                 data-testid="qr-modal-btn-download">
                        LÆ°u mÃ£ QR
                    </VanAnButton>
                    @* W3-T2: Self-confirm payment â€” KhachLink sends POST api/webhooks/payment *@
                    <VanAnButton Variant="ButtonVariant.Success"
                                 OnClick="ConfirmPayment"
                                 data-testid="btn-confirm-payment">
                        âœ… TÃ´i Ä‘Ã£ thanh toÃ¡n
                    </VanAnButton>
