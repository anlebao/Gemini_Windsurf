@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Components.Composite
@using VanAn.UI.Platform.Tokens
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime

@* T-03b: Wrapper div with id="qrPaymentModal" — required by E2E selector contract.
   VanAnModal renders its own <div class="modal"> but doesn't expose an id param.
   Wrapping here ensures #qrPaymentModal is always in the DOM when IsOpen=true. *@
@if (IsOpen)
{
    <div id="qrPaymentModal">
        <VanAnModal IsOpen="true"
                    Title="Thanh toán qua VietQR"
                    OnClose="HandleClose"
                    Closable="true">
            <ChildContent>
            <div class="qr-modal-content text-center">
                @if (IsLoading)
                {
                    <div class="loading-container">
                        <span class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tạo mã QR...</span>
                        </span>
                        <p class="mt-3">Đang tạo mã QR thanh toán...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(QrImageUrl))
                {
                    <VanAnCard CssClass="qr-info-card" Shadow="true">
                        <div class="qr-image-container">
                            <img src="@QrImageUrl" alt="VietQR Payment Code" class="qr-image" />
                        </div>
                        <div class="qr-info mt-3">
                            <h6>Thông tin thanh toán</h6>
                            <p class="mb-1"><strong>Số tiền:</strong> @Amount.ToString("N0")đ</p>
                            <p class="mb-1"><strong>Mã đơn hàng:</strong> @OrderId</p>
                            <p class="mb-1"><strong>Ngân hàng:</strong> @BankName</p>
                            <p class="mb-0"><small class="text-muted">Quét mã QR bằng ứng dụng ngân hàng để thanh toán</small></p>
                        </div>
                    </VanAnCard>
                }
                else if (Error != null)
                {
                    <VanAnCard CssClass="error-card" Shadow="true">
                        <div class="text-danger">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span class="ms-2">@Error</span>
                        </div>
                    </VanAnCard>
                }
            </div>
            </ChildContent>

            @* T-03b: FooterContent → Footer (correct VanAnModal RenderFragment parameter name) *@
            <Footer>
                <VanAnButton Variant="ButtonVariant.Secondary"
                             OnClick="HandleClose"
                             data-testid="qr-modal-btn-close">
                    Đóng
                </VanAnButton>
                @if (!string.IsNullOrEmpty(QrImageUrl))
                {
                    <VanAnButton Variant="ButtonVariant.Primary"
                                 Icon="download"
                                 OnClick="DownloadQr"
                                 data-testid="qr-modal-btn-download">
                        Lưu mã QR
                    </VanAnButton>
                    @* W3-T2: Self-confirm payment — KhachLink sends POST api/webhooks/payment *@
                    <VanAnButton Variant="ButtonVariant.Success"
                                 OnClick="ConfirmPayment"
                                 data-testid="btn-confirm-payment">
                        ✅ Tôi đã thanh toán
                    </VanAnButton>
                }
            </Footer>
        </VanAnModal>
    </div>
}

<style>
    .qr-modal-content {
        padding: 20px;
    }

    .loading-container {
        padding: 40px 20px;
    }

    .qr-image {
        max-width: 300px;
        max-height: 300px;
        border: 2px solid #e9ecef;
        border-radius: 8px;
    }

    .qr-info-card {
        background: #f8f9fa;
        padding: 20px;
    }

    .qr-info-card ::deep .card-body {
        padding: 0;
    }

    .error-card ::deep .card-body {
        padding: 20px;
        background: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 4px;
    }
</style>

@code {
    [Parameter] public decimal Amount     { get; set; }
    [Parameter] public string  OrderId   { get; set; } = string.Empty;
    // W3-T2: TenantId passed from parent (Checkout/OrderTracking) — from Order.TenantId.Value
    [Parameter] public Guid    TenantId  { get; set; }
    [Parameter] public bool    IsOpen    { get; set; }
    [Parameter] public EventCallback OnPaymentCompleted { get; set; }

    private bool    IsLoading  { get; set; }
    private string? QrImageUrl { get; set; }
    private string? BankName   { get; set; }
    private string? Error      { get; set; }
    private bool    _paymentConfirmed { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Amount > 0 && !string.IsNullOrEmpty(OrderId))
        {
            await GenerateQrCode();
        }
    }

    private async Task GenerateQrCode()
    {
        IsLoading  = true;
        Error      = null;
        QrImageUrl = null;

        try
        {
            // T-03b: use named client "gateway" instead of bare HttpClient
            var http = HttpClientFactory.CreateClient("gateway");

            var request = new
            {
                Amount           = Amount,
                OrderDescription = OrderId,
                BankConfig       = new
                {
                    BankId      = "970422",   // Vietcombank default
                    AccountNo   = "1234567890",
                    AccountName = "VAN AN COFFEE",
                },
            };

            var response = await http.PostAsJsonAsync("api/v1/vietqr/generate", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VietQrResult>();
                QrImageUrl = result?.QrImageUrl;
                BankName   = "Vietcombank";
            }
            else
            {
                Error = "Không thể tạo mã QR. Vui lòng thử lại.";
            }
        }
        catch (Exception)
        {
            Error = "Lỗi kết nối. Vui lòng kiểm tra mạng và thử lại.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleClose()
    {
        if (OnPaymentCompleted.HasDelegate)
            await OnPaymentCompleted.InvokeAsync();
    }

    private async Task DownloadQr()
    {
        if (!string.IsNullOrEmpty(QrImageUrl))
            await JSRuntime.InvokeVoidAsync("downloadImage", QrImageUrl, $"QR_{OrderId}.jpg");
    }

    /// <summary>
    /// W3-T2: KhachLink self-confirm payment via POST api/webhooks/payment.
    /// KhachLink has TenantId from Order.TenantId.Value (Order inherits from Product).
    /// After confirm → OrderService.ConfirmPaymentAsync → OrderHub.PaymentConfirmed broadcast (W0).
    /// </summary>
    private async Task ConfirmPayment()
    {
        if (_paymentConfirmed) return; // Idempotent UI guard
        if (TenantId == Guid.Empty)
        {
            Error = "Không xác định được cửa hàng (TenantId). Vui lòng liên hệ nhân viên.";
            return;
        }

        try
        {
            var http = HttpClientFactory.CreateClient("gateway");
            var request = new
            {
                OrderId = Guid.Parse(OrderId),
                TenantId = TenantId,
                TransactionId = $"KL_{OrderId}_{DateTime.UtcNow:yyyyMMddHHmmss}"
            };

            var response = await http.PostAsJsonAsync("api/webhooks/payment", request);

            if (response.IsSuccessStatusCode)
            {
                _paymentConfirmed = true;
                if (OnPaymentCompleted.HasDelegate)
                    await OnPaymentCompleted.InvokeAsync();
            }
            else
            {
                Error = $"Không thể xác nhận thanh toán: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Error = $"Lỗi kết nối: {ex.Message}";
        }
    }

    private record VietQrResult(
        string  QrImageUrl,
        string  PaymentUrl,
        decimal Amount,
        string  OrderId
    );
}
