@using VanAn.UI.Platform.Components.Atomic
@using VanAn.UI.Platform.Components.Composite
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject VanAn.KhachLink.Services.Http.SocialAuthHttpService SocialAuthHttp

@* CC-S1-T0c (v1.5): IdentityUpgradeModal — REWRITE from OTP flow to 3 buttons (Google + Facebook + Guest=skip).
   Shows after checkout success (Checkout.razor _showLoyaltySignupModal=true).
   Customer picks: Google/Facebook (login + link order to Customer) or "Bỏ qua" (Guest, order still valid, points via DeviceId fallback). *@
<VanAnModal IsOpen="ShowModal"
          Title="Nâng Cấp Tài Khoản"
          OnClose="OnDismiss"
          Closable="true">
    <div class="text-center">
        <div class="mb-4">
            <i class="fas fa-gift text-primary" style="font-size: 3rem;"></i>
        </div>
        <h4 class="text-primary mb-3">Tích điểm thưởng + xem lịch sử đơn hàng</h4>
        <p class="mb-3">
            Đăng nhập để tích điểm và đổi quà hấp dẫn.
        </p>
        <p class="text-muted small mb-4">
            <i class="fas fa-info-circle me-1"></i>
            Đơn hàng của bạn đã được đặt thành công. Đăng nhập để liên kết đơn hàng với tài khoản.
        </p>

        <div class="d-grid gap-2">
            <VanAnButton Variant="ButtonVariant.Outline"
                         FullWidth="true"
                         OnClick="LoginWithGoogle"
                         TestId="btn-upgrade-google">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-2">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z" fill="#EA4335"/>
                </svg>
                Đăng nhập với Google
            </VanAnButton>

            <VanAnButton Variant="ButtonVariant.Outline"
                         FullWidth="true"
                         OnClick="LoginWithFacebook"
                         TestId="btn-upgrade-facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2" xmlns="http://www.w3.org/2000/svg" class="me-2">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Đăng nhập với Facebook
            </VanAnButton>

            <VanAnButton Variant="ButtonVariant.Outline"
                         FullWidth="true"
                         OnClick="StartOtpUpgrade"
                         Disabled="@(_otpBusy || string.IsNullOrEmpty(CustomerToken))"
                         TestId="btn-upgrade-otp">
                <i class="bi bi-envelope-check me-2"></i>
                @(_otpBusy ? "Đang gửi mã..." : "Xác minh qua Email / SMS")
            </VanAnButton>

            <VanAnButton Variant="ButtonVariant.Secondary"
                         FullWidth="true"
                         OnClick="OnDismiss"
                         TestId="btn-upgrade-skip">
                <i class="bi bi-x-circle me-2"></i>
                Bỏ qua
            </VanAnButton>
        </div>

        @* OTP step: hiện sau khi send-otp thành công *@
        @if (_otpSent)
        {
            <div class="mt-4 p-3 border rounded text-start" data-testid="otp-step">
                <p class="mb-2 small">
                    <i class="bi bi-check-circle text-success me-1"></i>
                    Mã xác minh đã gửi đến <strong>@_otpChannelLabel @_otpContactSuffix</strong>.
                </p>
                <input class="form-control form-control-lg text-center mb-2"
                       type="text" inputmode="numeric" maxlength="6"
                       placeholder="Nhập mã 6 số"
                       @bind="_otpCode" data-testid="otp-code-input" />
                @if (!string.IsNullOrEmpty(_otpError))
                {
                    <div class="alert alert-danger py-2 small mb-2">@_otpError</div>
                }
                <div class="d-grid gap-2">
                    <VanAnButton Variant="ButtonVariant.Primary" FullWidth="true"
                                 OnClick="VerifyOtp" Disabled="@(_otpBusy || _otpCode.Length != 6)"
                                 TestId="btn-otp-verify">
                        @(_otpBusy ? "Đang xác minh..." : "Xác nhận nâng cấp")
                    </VanAnButton>
                    <VanAnButton Variant="ButtonVariant.Outline" FullWidth="true"
                                 OnClick="ResendOtp" Disabled="@_otpBusy"
                                 TestId="btn-otp-resend">
                        Gửi lại mã
                    </VanAnButton>
                </div>
            </div>
        }
    </div>
</VanAnModal>

@code {
    [Parameter]
    public bool ShowModal { get; set; }

    [Parameter]
    public ShopConfig? ShopConfig { get; set; }

    [Parameter]
    public EventCallback OnDismiss { get; set; }

    [Parameter]
    public EventCallback OnUpgrade { get; set; }

    /// <summary>Triggered when upgrade completes successfully (parent should refresh data).</summary>
    [Parameter]
    public EventCallback OnUpgradeComplete { get; set; }

    /// <summary>Customer token (localStorage customer_token) — required for OTP upgrade endpoints.</summary>
    [Parameter]
    public string? CustomerToken { get; set; }

    // OTP upgrade state (email-first, server picks channel)
    private bool _otpSent;
    private bool _otpBusy;
    private string _otpCode = "";
    private string? _otpError;
    private string _otpChannel = "";
    private string _otpContactSuffix = "";
    private string _otpChannelLabel => _otpChannel == "email" ? "email" : "SĐT";

    /// <summary>Gửi OTP nâng cấp — server tự chọn email-first rồi SMS.</summary>
    private async Task StartOtpUpgrade()
    {
        if (string.IsNullOrEmpty(CustomerToken)) return;
        _otpBusy = true; _otpError = null;
        try
        {
            var result = await SocialAuthHttp.SendUpgradeOtpAsync(CustomerToken);
            if (result.Success)
            {
                _otpSent = true;
                _otpChannel = result.Channel;
                _otpContactSuffix = result.ContactSuffix;
                _otpCode = "";
            }
            else _otpError = result.Message;
        }
        finally { _otpBusy = false; }
    }

    private Task ResendOtp() => StartOtpUpgrade();

    private async Task VerifyOtp()
    {
        if (string.IsNullOrEmpty(CustomerToken) || _otpCode.Length != 6) return;
        _otpBusy = true; _otpError = null;
        try
        {
            var result = await SocialAuthHttp.VerifyUpgradeOtpAsync(CustomerToken, _otpCode.Trim(), _otpChannel);
            if (result.Success)
                await OnUpgradeComplete.InvokeAsync();
            else
                _otpError = result.Message;
        }
        finally { _otpBusy = false; }
    }

    /// <summary>CC-S1-T0c (v1.5): Redirect to Google OAuth login via Gateway.</summary>
    private void LoginWithGoogle()
    {
        var gatewayBase = HttpClientFactory.CreateClient("gateway").BaseAddress;
        Navigation.NavigateTo($"{gatewayBase}api/auth/google/login", forceLoad: true);
    }

    /// <summary>CC-S1-T0c (v1.5): Redirect to Facebook OAuth login via Gateway (stub — Sprint 7+ real config).</summary>
    private void LoginWithFacebook()
    {
        var gatewayBase = HttpClientFactory.CreateClient("gateway").BaseAddress;
        Navigation.NavigateTo($"{gatewayBase}api/auth/facebook/login", forceLoad: true);
    }
}
