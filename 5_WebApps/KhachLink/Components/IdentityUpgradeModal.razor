@code {
    private enum UpgradeStep { Intro, OtpSent, Success }

    [Parameter]
    public bool ShowModal { get; set; }

    [Parameter]
    public ShopConfig? ShopConfig { get; set; }

    [Parameter]
    public EventCallback OnDismiss { get; set; }

    [Parameter]
    public EventCallback OnUpgrade { get; set; }

    /// <summary>Triggered when upgrade completes successfully (parent should refresh data).</summary>
    [Parameter]
    public EventCallback OnUpgradeComplete { get; set; }

    private UpgradeStep _upgradeStep = UpgradeStep.Intro;
    private string _otp = "";
    private string? _error;
    private string _phoneSuffix = "";
    private string _successMessage = "TÃ i khoáº£n Ä‘Ã£ Ä‘Æ°á»£c xÃ¡c thá»±c.";
    private bool _loading = false;
    private string? _cachedToken;

    protected override void OnParametersSet()
    {
        // Reset to intro step when modal is reopened
        if (ShowModal && _upgradeStep == UpgradeStep.Success)
        {
            _upgradeStep = UpgradeStep.Intro;
            _error = null;
            _otp = "";
        }
    }

    private async Task<string?> GetTokenAsync()
    {
        if (_cachedToken != null) return _cachedToken;
        _cachedToken = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "customer_token");
        return _cachedToken;
    }

    private async Task SendUpgradeOtp()
    {
        _error = null;
        _loading = true;
        try
        {
            var token = await GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                _error = "Vui lÃ²ng Ä‘Äƒng nháº­p trÆ°á»›c khi nÃ¢ng cáº¥p.";
                return;
            }

            var result = await SocialAuthHttp.SendUpgradeOtpAsync(token);
            if (result.Success)
            {
                _phoneSuffix = result.PhoneNumberSuffix;
                _upgradeStep = UpgradeStep.OtpSent;
            }
            else
            {
                _error = result.Message;
            }
        }
        finally { _loading = false; }
    }

    private async Task VerifyUpgradeOtp()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_otp))
        {
            _error = "Vui lÃ²ng nháº­p mÃ£ OTP.";
            return;
        }
        _loading = true;
        try
        {
            var token = await GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                _error = "PhiÃªn Ä‘Äƒng nháº­p háº¿t háº¡n. Vui lÃ²ng Ä‘Äƒng nháº­p láº¡i.";
                return;
            }

            var result = await SocialAuthHttp.VerifyUpgradeOtpAsync(token, _otp);
            if (result.Success)
            {
                _successMessage = result.Message;
                _upgradeStep = UpgradeStep.Success;
            }
            else
            {
                _error = result.Message;
            }
        }
        finally { _loading = false; }
    }

    private void BackToIntro()
    {
        _upgradeStep = UpgradeStep.Intro;
        _error = null;
        _otp = "";
    }

    private async Task OnOtpKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await VerifyUpgradeOtp();
    }

    private async Task HandleUpgradeComplete()
    {
        _upgradeStep = UpgradeStep.Intro;
        _otp = "";
        _error = null;
        await OnUpgradeComplete.InvokeAsync();
    }
}
