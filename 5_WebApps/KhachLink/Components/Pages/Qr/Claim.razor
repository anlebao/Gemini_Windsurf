@page "/qr/claim"
@rendermode InteractiveWebAssembly
@inject NavigationManager Nav

@* OCR Hub S1: /qr/claim redirects to /qr/wallet (merged page with 2 tabs).
   Backward compat: QR tickets printed with /qr/claim?data=... URL still work —
   query string preserved on redirect, wallet page auto-claims from deep link. *@

@code {
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Preserve query string (deep link from QR ticket: /qr/claim?data=...)
            var uri = Nav.Uri.Replace("/qr/claim", "/qr/wallet", StringComparison.OrdinalIgnoreCase);
            Nav.NavigateTo(uri, forceLoad: true);
        }
        return Task.CompletedTask;
    }
}
