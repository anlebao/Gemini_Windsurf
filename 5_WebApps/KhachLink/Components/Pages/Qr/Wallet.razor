@page "/qr/wallet"
@rendermode InteractiveWebAssembly
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Services.Http
@inject GuardQrApiClient GuardQrApi
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Ví QR gửi xe — Vạn An</PageTitle>

<div class="qr-wallet-page">
    @if (!string.IsNullOrEmpty(_error))
    {
        <VanAnAlert Variant="AlertVariant.Error" Message="@_error" />
    }

    <div class="qr-wallet-header">
        <h5>Ví QR gửi xe</h5>
        <VanAnButton Variant="ButtonVariant.Outline" Text="Nhận QR mới" OnClick="@GoClaim" />
    </div>

    @if (!_isLoggedIn)
    {
        <VanAnAlert Variant="AlertVariant.Warning" Message="Vui lòng đăng nhập để xem Ví QR." />
        <VanAnButton Variant="ButtonVariant.Primary" Text="Đăng nhập" OnClick="@GoLogin" />
    }
    else if (_loading)
    {
        <p class="text-center text-muted py-4">Đang tải...</p>
    }
    else if (_activeSessions.Count == 0)
    {
        <VanAnCard>
            <div class="text-center py-4">
                <i class="bi bi-qr-code" style="font-size: 3rem; color: #ccc;"></i>
                <p class="mt-3 text-muted">Chưa có vé QR nào trong ví.</p>
                <VanAnButton Variant="ButtonVariant.Primary" Text="Nhận QR gửi xe" OnClick="@GoClaim" />
            </div>
        </VanAnCard>
    }
    else
    {
        <div class="qr-wallet-list">
            @foreach (var s in _activeSessions)
            {
                <VanAnCard>
                    <div class="qr-wallet-card" @onclick="@(() => ShowFullscreenQr(s))">
                        <div class="qr-wallet-card-icon">
                            <i class="bi bi-car-front"></i>
                        </div>
                        <div class="qr-wallet-card-info">
                            <span class="qr-wallet-plate">@s.PlateNumber</span>
                            <span class="qr-wallet-time">Vào: @s.IssuedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</span>
                            @if (!string.IsNullOrEmpty(s.ShortCode) && string.IsNullOrEmpty(s.QrPayload))
                            {
                                <span class="qr-wallet-code">Mã: @s.ShortCode</span>
                            }
                        </div>
                        <div class="qr-wallet-card-arrow">
                            <i class="bi bi-chevron-right"></i>
                        </div>
                    </div>
                </VanAnCard>
            }
        </div>
    }
</div>

@* Fullscreen QR modal *@
@if (_showFullscreen && _fullscreenSession != null)
{
    <div class="qr-fullscreen-overlay">
        <button class="qr-fullscreen-close" @onclick="@CloseFullscreen">
            <i class="bi bi-x-circle-fill"></i>
        </button>
        <div class="qr-fullscreen-content">
            @if (!string.IsNullOrEmpty(_fullscreenSession.QrPayload))
            {
                <div class="qr-fullscreen-plate">@_fullscreenSession.PlateNumber</div>
                <canvas id="qr-fullscreen-canvas"></canvas>
                <p class="qr-fullscreen-hint">Đưa màn hình cho guard quét</p>
            }
            else
            {
                <div class="qr-fullscreen-plate">@_fullscreenSession.PlateNumber</div>
                <div class="qr-fullscreen-code-box">
                    <span class="qr-fullscreen-code">@_fullscreenSession.ShortCode</span>
                </div>
                <p class="qr-fullscreen-hint">Đưa mã 6 số này cho guard nhập</p>
            }
        </div>
    </div>
}

<style>
    .qr-wallet-page { max-width: 500px; margin: 0 auto; padding: 1rem; }
    .qr-wallet-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .qr-wallet-header h5 { margin: 0; }
    .qr-wallet-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .qr-wallet-card { display: flex; align-items: center; gap: 1rem; cursor: pointer; }
    .qr-wallet-card-icon { font-size: 1.8rem; color: #667eea; }
    .qr-wallet-card-info { flex: 1; display: flex; flex-direction: column; gap: 0.25rem; }
    .qr-wallet-plate { font-size: 1.3rem; font-weight: 700; }
    .qr-wallet-time { font-size: 0.85rem; color: #6b7280; }
    .qr-wallet-code { font-size: 0.85rem; color: #2563eb; font-family: monospace; }
    .qr-wallet-card-arrow { color: #ccc; }

    .qr-fullscreen-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: #000; z-index: 9999;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .qr-fullscreen-close {
        position: absolute; top: 1rem; right: 1rem;
        background: none; border: none; color: #fff; font-size: 2rem; cursor: pointer;
        padding: 0.5rem;
    }
    .qr-fullscreen-content { text-align: center; }
    .qr-fullscreen-plate { font-size: 2rem; font-weight: 700; color: #fff; margin-bottom: 1.5rem; }
    .qr-fullscreen-content canvas { background: #fff; border-radius: 12px; padding: 1rem; }
    .qr-fullscreen-hint { color: #ccc; margin-top: 1.5rem; font-size: 1rem; }
    .qr-fullscreen-code-box { background: #fff; border-radius: 12px; padding: 2rem 3rem; display: inline-block; }
    .qr-fullscreen-code { font-size: 4rem; font-weight: 700; letter-spacing: 0.5rem; font-family: monospace; }
</style>
