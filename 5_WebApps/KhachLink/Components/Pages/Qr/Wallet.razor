@page "/qr/wallet"
@rendermode InteractiveWebAssembly
@using VanAn.UI.Platform.Components.Atomic
@using VanAn.KhachLink.Services.Http
@inject GuardQrApiClient GuardQrApi
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Ví QR gửi xe — Vạn An</PageTitle>

<div class="qr-wallet-page">
    @if (!string.IsNullOrEmpty(_error))
    {
        <VanAnAlert Variant="AlertVariant.Error" Message="@_error" />
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <VanAnAlert Variant="AlertVariant.Success" Message="@_success" />
    }

    <div class="qr-wallet-header">
        <h5>Ví QR gửi xe</h5>
    </div>

    @* Tab navigation — 2 tabs in 1 page (S1: merge claim + wallet) *@
    <div class="qr-tab-nav">
        <button class="qr-tab-btn @(_activeTab == "wallet" ? "qr-tab-active" : "")"
                @onclick="@(() => SwitchTab("wallet"))">
            <i class="bi bi-wallet2"></i> Vé của tôi
            @if (_activeSessions.Count > 0)
            {
                <span class="qr-tab-badge">@_activeSessions.Count</span>
            }
        </button>
        <button class="qr-tab-btn @(_activeTab == "claim" ? "qr-tab-active" : "")"
                @onclick="@(() => SwitchTab("claim"))">
            <i class="bi bi-qr-code-scan"></i> Nhận QR mới
        </button>
    </div>

    @* Tab 1: Vé của tôi — wallet list (no login required) *@
    @if (_activeTab == "wallet")
    {
        @if (_showBackupWarning)
        {
            <VanAnAlert Variant="AlertVariant.Warning"
                        Message="⚠️ Đã lưu vé vào điện thoại. Vui lòng chụp màn hình để phòng mất vé nếu xóa dữ liệu trình duyệt." />
        }

        @if (_loading)
        {
            <p class="text-center text-muted py-4">Đang tải...</p>
        }
        else if (_activeSessions.Count == 0)
        {
            <VanAnCard>
                <div class="text-center py-4">
                    <i class="bi bi-qr-code" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="mt-3 text-muted">Chưa có vé QR nào trong ví.</p>
                    <VanAnButton Variant="ButtonVariant.Primary" Text="Nhận QR gửi xe" OnClick="@(() => SwitchTab("claim"))" />
                </div>
            </VanAnCard>
        }
        else
        {
            <div class="qr-wallet-list">
                @foreach (var s in _activeSessions)
                {
                    <VanAnCard>
                        <div class="qr-wallet-card" @onclick="@(() => ShowFullscreenQr(s))">
                            <div class="qr-wallet-card-icon">
                                <i class="bi bi-car-front"></i>
                            </div>
                            <div class="qr-wallet-card-info">
                                <span class="qr-wallet-plate">@(string.IsNullOrEmpty(s.PlateNumber) ? "Vé QR" : s.PlateNumber)</span>
                                <span class="qr-wallet-time">Vào: @s.IssuedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</span>
                                @if (!string.IsNullOrEmpty(s.ShortCode) && string.IsNullOrEmpty(s.QrPayload))
                                {
                                    <span class="qr-wallet-code">Mã: @s.ShortCode</span>
                                }
                            </div>
                            <div class="qr-wallet-card-arrow">
                                <i class="bi bi-chevron-right"></i>
                            </div>
                        </div>
                    </VanAnCard>
                }
            </div>
        }
    }

    @* Tab 2: Nhận QR mới — QRScanner + short code input (no login required) *@
    @if (_activeTab == "claim")
    {
        <VanAnCard>
            <div class="qr-claim-header">
                <p class="text-muted small">Quét mã QR trên màn hình guard hoặc trên vé giấy để lưu vào điện thoại.</p>
                <p class="text-muted small">Bạn có vé giấy? Quét mã QR trên vé để lưu vào điện thoại — chống mất, ướt, rách.</p>
            </div>

            @* Mode toggle *@
            <div class="qr-mode-toggle">
                <VanAnButton Variant="@(_mode == "camera" ? ButtonVariant.Primary : ButtonVariant.Outline)"
                             Text="📷 Quét QR" OnClick="@(() => SwitchMode("camera"))" />
                <VanAnButton Variant="@(_mode == "code" ? ButtonVariant.Primary : ButtonVariant.Outline)"
                             Text="⌨️ Nhập mã" OnClick="@(() => SwitchMode("code"))" />
            </div>

            @if (_mode == "camera")
            {
                <QRScanner OnQRCodeDetected="@OnQrDetected" />
            }
            else
            {
                <div class="qr-code-input-section">
                    <label class="form-label">Nhập mã 6 số trên vé</label>
                    <input class="form-control form-control-lg text-center"
                           style="font-size: 1.8rem; letter-spacing: 0.5rem; max-width: 280px; margin: 0 auto;"
                           @bind="_shortCodeInput"
                           maxlength="6"
                           placeholder="000000"
                           pattern="[0-9]{6}" />
                    <div class="mt-3 text-center">
                        <VanAnButton Variant="ButtonVariant.Primary" Text="Nhận QR"
                                     Disabled="@(_claiming || string.IsNullOrWhiteSpace(_shortCodeInput))"
                                     Loading="@_claiming"
                                     OnClick="@ClaimByCode" />
                    </div>
                </div>
            }
        </VanAnCard>
    }
</div>

@* Fullscreen QR modal — guard scans this when customer shows phone *@
@if (_showFullscreen && _fullscreenSession != null)
{
    <div class="qr-fullscreen-overlay">
        <button class="qr-fullscreen-close" @onclick="@CloseFullscreen">
            <i class="bi bi-x-circle-fill"></i>
        </button>
        <div class="qr-fullscreen-content">
            @if (!string.IsNullOrEmpty(_fullscreenSession.QrPayload))
            {
                <div class="qr-fullscreen-plate">@(_fullscreenSession.PlateNumber ?? "Vé QR")</div>
                @if (!string.IsNullOrEmpty(_qrImageDataUrl))
                {
                    <img src="@_qrImageDataUrl" alt="QR Code" class="qr-fullscreen-img" />
                }
                else
                {
                    <div class="qr-fullscreen-loading">Đang tạo mã QR...</div>
                }
                <p class="qr-fullscreen-hint">Đưa màn hình cho guard quét</p>
            }
            else if (!string.IsNullOrEmpty(_fullscreenSession.ShortCode))
            {
                <div class="qr-fullscreen-plate">@(_fullscreenSession.PlateNumber ?? "Vé QR")</div>
                <div class="qr-fullscreen-code-box">
                    <span class="qr-fullscreen-code">@_fullscreenSession.ShortCode</span>
                </div>
                <p class="qr-fullscreen-hint">Đưa mã 6 số này cho guard nhập</p>
            }
            else
            {
                <div class="qr-fullscreen-plate">Vé không hợp lệ</div>
                <p class="qr-fullscreen-hint">Vui lòng nhận QR mới</p>
            }
        </div>
    </div>
}

<style>
    .qr-wallet-page { max-width: 500px; margin: 0 auto; padding: 1rem; }
    .qr-wallet-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .qr-wallet-header h5 { margin: 0; }

    /* Tab navigation — S1: merge claim + wallet into 1 page */
    .qr-tab-nav {
        display: flex; gap: 0; margin-bottom: 1rem;
        border-bottom: 2px solid #e5e7eb;
    }
    .qr-tab-btn {
        flex: 1; padding: 0.75rem 0.5rem; border: none; background: none;
        font-size: 0.95rem; color: #6b7280; cursor: pointer;
        border-bottom: 3px solid transparent; margin-bottom: -2px;
        display: flex; align-items: center; justify-content: center; gap: 0.4rem;
        transition: all 0.2s;
    }
    .qr-tab-btn:hover { color: #333; }
    .qr-tab-btn.qr-tab-active {
        color: #2563eb; border-bottom-color: #2563eb; font-weight: 600;
    }
    .qr-tab-badge {
        background: #2563eb; color: #fff; font-size: 0.7rem;
        padding: 0.1rem 0.4rem; border-radius: 10px; font-weight: 600;
    }

    .qr-wallet-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .qr-wallet-card { display: flex; align-items: center; gap: 1rem; cursor: pointer; }
    .qr-wallet-card-icon { font-size: 1.8rem; color: #667eea; }
    .qr-wallet-card-info { flex: 1; display: flex; flex-direction: column; gap: 0.25rem; }
    .qr-wallet-plate { font-size: 1.3rem; font-weight: 700; }
    .qr-wallet-time { font-size: 0.85rem; color: #6b7280; }
    .qr-wallet-code { font-size: 0.85rem; color: #2563eb; font-family: monospace; }
    .qr-wallet-card-arrow { color: #ccc; }

    .qr-claim-header { margin-bottom: 0.75rem; }
    .qr-claim-header p { margin-bottom: 0.25rem; }
    .qr-mode-toggle { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
    .qr-code-input-section { display: flex; flex-direction: column; gap: 0.5rem; align-items: center; }

    .qr-fullscreen-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: #000; z-index: 9999;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .qr-fullscreen-close {
        position: absolute; top: 1rem; right: 1rem;
        background: none; border: none; color: #fff; font-size: 2rem; cursor: pointer;
        padding: 0.5rem;
    }
    .qr-fullscreen-content { text-align: center; }
    .qr-fullscreen-plate { font-size: 2rem; font-weight: 700; color: #fff; margin-bottom: 1.5rem; }
    .qr-fullscreen-content canvas { background: #fff; border-radius: 12px; padding: 1rem; }
    .qr-fullscreen-img { background: #fff; border-radius: 12px; padding: 1rem; max-width: 350px; width: 90vw; height: auto; }
    .qr-fullscreen-loading { color: #fff; font-size: 1.2rem; padding: 3rem; }
    .qr-fullscreen-hint { color: #ccc; margin-top: 1.5rem; font-size: 1rem; }
    .qr-fullscreen-code-box { background: #fff; border-radius: 12px; padding: 2rem 3rem; display: inline-block; }
    .qr-fullscreen-code { font-size: 4rem; font-weight: 700; letter-spacing: 0.5rem; font-family: monospace; }
</style>
