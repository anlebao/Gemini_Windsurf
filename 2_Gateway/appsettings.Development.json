{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=VanAnCoreHub;Username=vanan_admin;Password=VanAn@2024!"
  },
  "LoggingConfig": {
    "EnableFileLogging": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NATS": {
    "Url": "nats://localhost:4222"
  },
  "ShopERP": {
    "BaseUrl": "http://localhost:5003"
  },
  "ReverseProxy": {
    "Routes": {
      "khachlink-route": {
        "ClusterId": "khachlink-cluster",
        "Match": {
          "Path": "/khachlink/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/khachlink" }
        ]
      },
      "shoperp-route": {
        "ClusterId": "shoperp-cluster",
        "Match": {
          "Path": "/shoperp/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/shoperp" }
        ]
      },
      "social-auth-route": {
        "ClusterId": "shoperp-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Order": 100,
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "shoperp-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "khachlink-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  },
  "Jwt": {
    "Secret": "VanAn-Dev-Secret-Key-2026-@#$%^&*()",
    "Issuer": "VanAnShopERP",
    "Audience": "VanAnApi"
  }
}
