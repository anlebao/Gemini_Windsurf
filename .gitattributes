# Force text normalization and UTF-8 line handling
* text=auto eol=crlf

# Shell scripts MUST use LF (CRLF breaks busybox/ash in Docker containers)
*.sh      text eol=lf working-tree-encoding=UTF-8

# Source and markup files
*.cs       text eol=crlf working-tree-encoding=UTF-8
*.razor    text eol=crlf working-tree-encoding=UTF-8
*.cshtml   text eol=crlf working-tree-encoding=UTF-8
*.html     text eol=crlf working-tree-encoding=UTF-8
*.css      text eol=crlf working-tree-encoding=UTF-8
*.js       text eol=crlf working-tree-encoding=UTF-8
*.json     text eol=crlf working-tree-encoding=UTF-8
*.xml      text eol=crlf working-tree-encoding=UTF-8
*.props    text eol=crlf working-tree-encoding=UTF-8
*.targets  text eol=crlf working-tree-encoding=UTF-8
*.md       text eol=crlf working-tree-encoding=UTF-8
*.csproj   text eol=crlf working-tree-encoding=UTF-8
*.sln      text eol=crlf working-tree-encoding=UTF-8

# Binary files — never treat as text
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.svg      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
*.dll      binary
*.exe      binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.sqlite   binary
*.db       binary
