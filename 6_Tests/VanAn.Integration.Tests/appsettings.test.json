{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TestcontainersSqlite": "Data Source=:memory:;Cache=Shared;Mode=Memory",
    "TestcontainersPostgres": "Host=localhost;Port=5432;Database=vanan_test;Username=postgres;Password=postgres"
  },
  "Testcontainers": {
    "Enabled": false,
    "Note": "Testcontainers.Sqlite package does not exist on NuGet. Using SQLite in-memory mode with Cache=Shared for connection pooling as alternative.",
    "Sqlite": {
      "Image": "docker.io/nouchka/sqlite3:latest",
      "CleanUp": true
    },
    "Postgres": {
      "Image": "docker.io/postgres:15-alpine",
      "Database": "vanan_test",
      "Username": "postgres",
      "Password": "postgres",
      "Port": 5432
    }
  },
  "TestDataSeeding": {
    "Enabled": true,
    "DefaultTenantId": "12345678-1234-1234-1234-123456789abc",
    "DefaultUserId": "87654321-4321-4321-4321-cba987654321",
    "SeedAccountingEntries": true,
    "SeedTenants": true,
    "SeedUsers": true
  }
}
